        score += 0.35\n            matches.append(\'OPEN\')\n    \n    if \'short\' in cb_label.lower():\n        if \'short\' in raw_lower or \'短路\' in raw_text or \'bridge\' in raw_lower:\n            score += 0.35\n            matches.append(\'SHORT\')\n    \n    if \'cold solder\' in cb_label.lower() or \'solder\' in cb_label.lower():\n        if \'cold solder\' in raw_lower or \'虚焊\' in raw_text or \'少锡\' in raw_text or \\\n           \'浮高\' in raw_text or \'missing solder\' in raw_lower or \'solder\' in raw_lower:\n            score += 0.35\n            matches.append(\'SOLDER\')\n    \n    if \'fixture\' in cb_label.lower() and \'contact\' in cb_label.lower():\n        if \'fixture\' in raw_lower or \'pogo\' in raw_lower or \'probe\' in raw_lower or \\\n           \'reseat\' in raw_lower or \'接触不良\' in raw_text or \'探针\' in raw_text or \\\n           \'重插\' in raw_text or \'治具\' in raw_text or \'contact\' in raw_lower or \\\n           \'pin\' in raw_lower and \'contact\' in raw_lower:\n            score += 0.45\n            matches.append(\'FIXTURE_CONTACT\')\n    \n    if \'probe worn\' in cb_label.lower() or \'pin\' in cb_label.lower() and \'degrad\' in cb_label.lower():\n        if \'磨损\' in raw_text or \'worn\' in raw_lower or \'换针\' in raw_text or \'replace pin\' in raw_lower:\n            score += 0.45\n            matches.append(\'PROBE_WORN\')\n    \n    if \'program\' in cb_label.lower() or \'flash\' in cb_label.lower():\n        if \'program\' in raw_lower or \'flash\' in raw_lower or \'烧录\' in raw_text or \\\n           \'写入\' in raw_text or \'reflash\' in raw_lower or \'burn\' in raw_lower:\n            score += 0.40\n            matches.append(\'PROGRAMMING\')\n    \n    if \'verif\' in cb_label.lower() or \'crc\' in cb_label.lower():\n        if \'verif\' in raw_lower or \'crc\' in raw_lower or \'校验\' in raw_text or \'checksum\' in raw_lower:\n            score += 0.40\n            matches.append(\'VERIFICATION\')\n    \n    if \'current\' in cb_label.lower() and (\'high\' in cb_label.lower() or \'idle\' in cb_label.lower()):\n        if \'current\' in raw_lower or \'电流\' in raw_text or \'icc\' in raw_lower or \\\n           \'功耗\' in raw_text or \'consumption\' in raw_lower or \'idle\' in raw_lower:\n            score += 0.40\n            matches.append(\'CURRENT_HIGH\')\n    \n    if \'missing\' in cb_label.lower() and \'component\' in cb_label.lower():\n        if \'missing\' in raw_lower or \'少件\' in raw_text or \'no component\' in raw_lower:\n            score += 0.40\n            matches.append(\'MISSING_COMP\')\n    \n    # OS/Boot failure\n    if \'os\' in cb_label.lower() or \'boot\' in cb_label.lower() or \'start\' in cb_label.lower():\n        if \'os fail\' in raw_lower or \'启动\' in raw_text or \'boot\' in raw_lower or \'start\' in raw_lower:\n            score += 0.35\n            matches.append(\'OS_BOOT\')\n    \n    # Keyword matching (lower weight)\n    keyword_list = [k.strip() for k in cb_keywords.lower().split(\',\')]\n    for kw in keyword_list:\n        if kw and len(kw) > 2 and kw in raw_lower:\n            score += 0.05\n    \n    return score, matches\n\ndef segment_raw_text(raw_text):\n    segments = []\n    parts = re.split(r\'\\s*/\\s*|\\s*&\\s*\', raw_text)\n    \n    if len(parts) > 1:\n        for part in parts:\n            part = part.strip()\n            if len(part) > 3:\n                segments.append(part)\n    \n    if not segments:\n        segments = [raw_text.strip()]\n    \n    return segments\n\ndef find_best_match(segment, codebooks, product_id, station):\n    if product_id not in codebooks:\n        return None, 0.0, []\n    \n    best_score = 0.0\n    best_match = None\n    best_matches_detail = []\n    \n    for entry in codebooks[product_id]:\n        score, matches = calculate_match_score(segment, entry)\n        \n        # Station scope bonus\n        station_scope = entry[\'station_scope\'].upper()\n        if station.upper() in station_scope:\n        