Sending keys: ['cat >> solve_ed.py << \'EOF\'\n\n# Calculate cost\ntotal_cost = np.sum(c2 * Pg**2 + c1 * Pg + c0)\nprint(f"\\nTotal cost: ${total_cost:,.2f}/hr")\n\n# Calculate totals\ntotal_gen_P = np.sum(Pg[gen_status == 1])\ntotal_gen_Q = np.sum(Qg[gen_status == 1])\ntotal_load_P = np.sum(Pd)\ntotal_load_Q = np.sum(Qd)\ntotal_losses = total_gen_P - total_load_P\n\nprint(f"Generation: {total_gen_P:.2f} MW, {total_gen_Q:.2f} MVAr")\nprint(f"Load: {total_load_P:.2f} MW, {total_load_Q:.2f} MVAr")\nprint(f"Losses: {total_losses:.2f} MW")\n\n# Calculate branch flows\nprint("Calculating branch flows...")\nbranch_data = []\n\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    \n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    \n    Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V[f] * np.conj(V[f]) - (Ys / np.conj(tr)) * V[f] * np.conj(V[t])\n    St = (Ys + Ysh/2) * V[t] * np.conj(V[t]) - (Ys / tr) * V[t] * np.conj(V[f])\n    \n    Sf_MVA = np.abs(Sf) * baseMVA\n    St_MVA = np.abs(St) * baseMVA\n    limit_MVA = rate_a[i] if rate_a[i] > 0 else 9999.0\n    \n    loading_pct = (max(Sf_MVA, St_MVA) / limit_MVA * 100) if limit_MVA > 0 and limit_MVA < 9999 else 0\n    \n    branch_data.append({\n        \'from_bus\': int(fbus[i] + 1),\n        \'to_bus\': int(tbus[i] + 1),\n        \'loading_pct\': float(loading_pct),\n        \'flow_from_MVA\': float(Sf_MVA),\n        \'flow_to_MVA\': float(St_MVA),\n        \'limit_MVA\': float(limit_MVA)\n    })\n\nbranch_data.sort(key=lambda x: x[\'loading_pct\'], reverse=True)\nmost_loaded = branch_data[:10]\n\nif most_loaded:\n    print(f"Most loaded branch: {most_loaded[0][\'from_bus\']}-{most_loaded[0][\'to_bus\']} at {most_loaded[0][\'loading_pct\']:.2f}%")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
