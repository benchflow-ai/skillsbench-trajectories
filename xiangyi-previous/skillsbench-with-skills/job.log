Sending keys: ['cat > /app/solve_tpp.py << \'EOF\'\nimport sys\nsys.path.insert(0, \'/app/skills/pddl-skills\')\n\nfrom unified_planning.io import PDDLReader\nfrom unified_planning.shortcuts import OneshotPlanner\n\ndef load_problem(domain_file, problem_file):\n    reader = PDDLReader()\n    problem = reader.parse_problem(domain_file, problem_file)\n    return problem\n\ndef generate_plan(problem):\n    with OneshotPlanner(name="pyperplan") as planner:\n        result = planner.solve(problem)\n    return result.plan\n\ndef save_plan(plan, path):\n    with open(path, "w") as f:\n        for action in plan.actions:\n            f.write(str(action) + "\\n")\n    return path\n\n# Solve task01\nprint("Loading task01...")\nproblem1 = load_problem("tpp/domain.pddl", "tpp/task01.pddl")\nprint("Generating plan for task01...")\nplan1 = generate_plan(problem1)\nprint("Saving plan for task01...")\nsave_plan(plan1, "task01.txt")\nprint("Task01 completed!")\n\n# Solve task02\nprint("Loading task02...")\nproblem2 = load_problem("tpp/domain.pddl", "tpp/task02.pddl")\nprint("Generating plan for task02...")\nplan2 = generate_plan(problem2)\nprint("Saving plan for task02...")\nsave_plan(plan2, "task02.txt")\nprint("Task02 completed!")\n\nprint("All tasks solved successfully!")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
