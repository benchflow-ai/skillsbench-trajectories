Sending keys: ["cat << 'EOF' > calculate.py\nimport pandas as pd\nimport numpy as np\nfrom statsmodels.tsa.filters.hp_filter import hpfilter\nimport re\n\ndef get_data(file, col):\n    df = pd.read_excel(file, engine='xlrd')\n    ann, qtr, cur_y = {}, {}, None\n    for i in range(len(df)):\n        lbl = str(df.iloc[i, 0]).strip()\n        val = df.iloc[i, col]\n        m = re.search(r'(\\d{4})', lbl)\n        if m:\n            y = int(m.group(1))\n            if ':' in lbl:\n                cur_y = y\n                try: qtr.setdefault(y, []).append(float(val))\n                except: pass\n            elif lbl.endswith('.') or (len(lbl) == 4 and lbl.isdigit()):\n                try: ann[y] = float(val)\n                except: pass\n        elif lbl in ['I.', 'II.', 'III.', 'IV.', 'I p.', 'II p.', 'III p.', 'IV p.', 'II', 'III', 'IV']:\n            if cur_y is not None:\n                try: qtr.setdefault(cur_y, []).append(float(val))\n                except: pass\n    res = {}\n    for y in range(1973, 2025):\n        if y == 2024 and y in qtr: res[y] = np.mean(qtr[y])\n        elif y in ann: res[y] = ann[y]\n        elif y in qtr: res[y] = np.mean(qtr[y])\n    return pd.Series(res)\n\npce = get_data('ERP-2025-table10.xls', 1)\npfi = get_data('ERP-2025-table12.xls', 1)\ncpi = pd.read_excel('CPI.xlsx').set_index('Year')['CPI_2024']\n\nyears = range(1973, 2025)\ndata = pd.DataFrame({'pce': pce, 'pfi': pfi, 'cpi': cpi}).reindex(years)\n\nlog_rpce = np.log(data['pce'] / data['cpi'])\nlog_rpfi = np.log(data['pfi'] / data['cpi'])\n\ncyc_pce, _ = hpfilter(log_rpce, lamb=100)\ncyc_pfi, _ = hpfilter(log_rpfi, lamb=100)\n\ncorr = cyc_pce.corr(cyc_pfi)\nprint(f'{corr:.5f}')\nwith open('answer.txt', 'w') as f: f.write(f'{corr:.5f}\\n')\nEOF\npython3 calculate.py\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
