ew\n                if col in [\'Salary\', \'Years\', \'Score\']:\n                    try:\n                        out_old = float(str(old_val).replace(\',\', \'\'))\n                        out_new = float(new_val)\n                        if out_old == int(out_old): out_old = int(out_old)\n                        if out_new == int(out_new): out_new = int(out_new)\n                    except:\n                        pass\n                \n                modified_employees.append({\n                    "id": emp_id,\n                    "field": col,\n                    "old_value": out_old,\n                    "new_value": out_new\n                })\n\n    result = {\n        "deleted_employees": deleted_employees,\n        "modified_employees": modified_employees\n    }\n    \n    with open(\'/root/diff_report.json\', \'w\') as f:\n        json.dump(result, f, indent=2)\n    print("Report generated successfully")\n\nexcept Exception as e:\n    print(f"Error: {e}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
