Sending keys: ['cat >> solve_dcopf.py << \'EOF\'\n\ndef extract_results(prob, Pg, R, P_inj, m, PTDF, rate_a, active_lines, constraints, reserve_req):\n    """Extract results from solved problem"""\n    Pg_val = Pg.value\n    R_val = R.value\n    P_inj_val = P_inj.value\n    \n    n_bus, n_branch = m[\'n_bus\'], m[\'n_branch\']\n    \n    # Get power balance dual (constraint index 3)\n    lambda_p = constraints[3].dual_value\n    if lambda_p is None:\n        lambda_p = 0\n    \n    # Get line constraint duals\n    line_mu = {}\n    cidx = 5  # After gen constraints (3) + power balance (1) + reserve (1 at end)\n    for l in active_lines:\n        mu_pos = constraints[cidx].dual_value if constraints[cidx].dual_value else 0\n        mu_neg = constraints[cidx+1].dual_value if constraints[cidx+1].dual_value else 0\n        line_mu[l] = (mu_pos, mu_neg)\n        cidx += 2\n    \n    # Reserve dual\n    res_dual = constraints[cidx].dual_value if constraints[cidx].dual_value else 0\n    \n    # Compute LMPs\n    lmp = np.full(n_bus, lambda_p)\n    for l in active_lines:\n        mu_pos, mu_neg = line_mu[l]\n        for i in range(n_bus):\n            lmp[i] += (mu_pos - mu_neg) * PTDF[l, i]\n    \n    # Find binding lines (>= 99% loading)\n    binding = []\n    for l in range(n_branch):\n        if m[\'br_status\'][l] > 0 and rate_a[l] > 0:\n            flow = np.dot(PTDF[l, :], P_inj_val)\n            loading = abs(flow) / rate_a[l]\n            if loading >= 0.99:\n                binding.append({\n                    \'from\': int(m[\'f_bus\'][l]),\n                    \'to\': int(m[\'t_bus\'][l]),\n                    \'flow_MW\': round(abs(flow), 2),\n                    \'limit_MW\': round(rate_a[l], 2)\n                })\n    \n    lmp_by_bus = [{\'bus\': int(m[\'bus_ids\'][i]), \'lmp_dollars_per_MWh\': round(lmp[i], 4)}\n                  for i in range(n_bus)]\n    \n    return {\n        \'total_cost_dollars_per_hour\': round(prob.value, 2),\n        \'lmp_by_bus\': lmp_by_bus,\n        \'reserve_mcp_dollars_per_MWh\': round(abs(res_dual), 4),\n        \'binding_lines\': binding\n    }\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
