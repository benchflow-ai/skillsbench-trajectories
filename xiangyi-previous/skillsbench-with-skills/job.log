Sending keys: ['cat > run_control.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nimport sys\nsys.path.insert(0, \'/root\')\nfrom hvac_simulator import HVACSimulator\nimport numpy as np\n\n# Load controller gains\nwith open("tuned_gains.json", "r") as f:\n    gains = json.load(f)\n\nKp = gains["Kp"]\nKi = gains["Ki"]\nKd = gains["Kd"]\n\nprint(f"Controller gains: Kp={Kp}, Ki={Ki}, Kd={Kd}")\n\n# Initialize simulator\nsim = HVACSimulator()\nsetpoint = sim.get_setpoint()  # 22.0C\ndt = sim.get_dt()  # 0.5s\n\nprint(f"Setpoint: {setpoint}C")\nprint(f"Timestep: {dt}s")\n\n# Reset simulator\ninitial_temp = sim.reset()\nprint(f"Initial temperature: {initial_temp:.2f}C")\n\n# Control parameters\ncontrol_duration = 160.0  # Run for 160 seconds (>150s required)\nsteps = int(control_duration / dt)\n\n# PI controller state\nintegral = 0.0\nprev_error = 0.0\n\n# Anti-windup limits\nintegral_max = 100.0 / Ki if Ki > 0 else 1000.0  # Limit integral to max output\nintegral_min = -integral_max\n\n# Data logging\ndata = []\n\n# Control loop\nfor i in range(steps):\n    # Get current time (before this step)\n    current_time = i * dt\n    \n    # Use the measured temperature from previous step or initial\n    if i == 0:\n        measured_temp = initial_temp\n    else:\n        measured_temp = data[-1]["temperature"]\n    \n    # Calculate error\n    error = setpoint - measured_temp\n    \n    # PI controller with anti-windup\n    # Proportional term\n    P = Kp * error\n    \n    # Integral term with anti-windup\n    integral += error * dt\n    integral = np.clip(integral, integral_min, integral_max)\n    I = Ki * integral\n    \n    # Derivative term (on error)\n    if i > 0:\n        derivative = (error - prev_error) / dt\n    else:\n        derivative = 0.0\n    D = Kd * derivative\n    \n    prev_error = error\n    \n    # Calculate control output\n    heater_power = P + I + D\n    \n    # Clamp to valid range\n    heater_power = np.clip(heater_power, 0.0, 100.0)\n    \n    # Apply control and get result\n    result = sim.step(heater_power)\n    \n    # Log data\n    data.append({\n        "time": result["time"],\n        "temperature": result["temperature"],\n        "setpoint": setpoint,\n        "heater_power": result["heater_power"],\n        "error": round(setpoint - result["temperature"], 4)\n    })\n    \n    # Print progress every 20 seconds\n    if i % 40 == 0:\n        print(f"t={result[\'time\']:.1f}s: T={result[\'temperature\']:.2f}C, error={error:.2f}C, P={heater_power:.1f}%")\n\n# Save control log\ncontrol_log = {\n    "phase": "control",\n    "setpoint": setpoint,\n    "data": data\n}\n\nwith open("control_log.json", "w") as f:\n    json.dump(control_log, f, indent=2)\n\nprint(f"\\nControl complete. Saved {len(data)} data points to control_log.json")\n\n# Calculate metrics\ntemps = np.array([d["temperature"] for d in data])\ntimes = np.array([d["time"] for d in data])\n\n# Max temperature\nmax_temp = np.max(temps)\n\n# Rise time: time to first reach 90% of the way from initial to setpoint\nrise_target = initial_temp + 0.9 * (setpoint - initial_temp)\nrise_time = None\nfor i, t in enumerate(temps):\n    if t >= rise_target:\n        rise_time = times[i]\n        break\n\n# Overshoot: (max_temp - setpoint) / (setpoint - initial_temp) * 100%\nif max_temp > setpoint:\n    overshoot = (max_temp - setpoint) / (setpoint - initial_temp)\nelse:\n    overshoot = 0.0\n\n# Settling time: time after which temperature stays within 2% of setpoint\nsettling_band = 0.02 * abs(setpoint - initial_temp)  # 2% of step size = 0.08C\n# Use a larger band for practical purposes (0.5C as per spec)\nsettling_band = 0.5  # Use the spec requirement\n\nsettling_time = None\n# Find the last time the temperature was outside the settling band\nfor i in range(len(temps) - 1, -1, -1):\n    if abs(temps[i] - setpoint) > settling_band:\n        if i < len(temps) - 1:\n            settling_time = times[i + 1]\n        break\nelse:\n    settling_time = times[0]  # Always within band\n\n# If never settled, use the full duration\nif settling_time is None:\n    settling_time = times[-1]\n\n# Steady-state error: average error in last 20 seconds\nlast_20s_mask = times >= (times[-1] - 20.0)\nsteady_state_temps = temps[last_20s_mask]\nsteady_state_error = abs(np.mean(steady_state_temps) - setpoint)\n\nprint(f"\\nPerformance Metrics:")\nprint(f"  Rise time (90%): {rise_time:.1f}s" if rise_time else "  Rise time: N/A")\nprint(f"  Overshoot: {overshoot*100:.2f}%")\nprint(f"  Settling time (within 0.5C): {settling_time:.1f}s")\nprint(f"  Steady-state error: {steady_state_error:.3f}C")\nprint(f"  Max temperature: {max_temp:.2f}C")\n\n# Save metrics\nmetrics = {\n    "rise_time": round(rise_time, 2) if rise_time else None,\n    "overshoot": round(overshoot, 4),\n    "settling_time": round(settling_time, 2),\n    "steady_state_error": round(steady_state_error, 4),\n    "max_temp": round(max_temp, 2)\n}\n\nwith open("metrics.json", "w") as f:\n    json.dump(metrics, f, indent=2)\n\nprint(f"\\nSaved to metrics.json")\n\n# Check against requirements\nprint(f"\\nRequirements check:")\nprint(f"  Steady-state error < 0.5C: {\'PASS\' if steady_state_error < 0.5 else \'FAIL\'} ({steady_state_error:.3f}C)")\nprint(f"  Settling time < 120s: {\'PASS\' if settling_time < 120 else \'FAIL\'} ({settling_time:.1f}s)")\nprint(f"  Overshoot < 10%: {\'PASS\' if overshoot < 0.10 else \'FAIL\'} ({overshoot*100:.2f}%)")\nprint(f"  Control duration >= 150s: {\'PASS\' if times[-1] >= 150 else \'FAIL\'} ({times[-1]:.1f}s)")\nprint(f"  Max temperature < 30C: {\'PASS\' if max_temp < 30 else \'FAIL\'} ({max_temp:.2f}C)")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
