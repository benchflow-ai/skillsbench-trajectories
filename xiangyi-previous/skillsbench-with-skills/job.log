Sending keys: ['python3 << \'EOF\'\nimport openpyxl\n\nwb = openpyxl.load_workbook(\'/root/test-supply.xlsx\')\nws_prod = wb[\'Production\']\nws_inv = wb[\'Investment\']\n\nprint(\'Setting up Production Function section...\')\n\n# Step 1: K/Y ratio and extended K calculations (rows 60-75)\nprint(\'\\n1. Setting up K/Y ratio and extended K...\')\nws_prod.cell(row=60, column=1).value = \'Production Function Analysis\'\nws_prod.cell(row=61, column=1).value = \'Year\'\nws_prod.cell(row=61, column=2).value = \'K\'\nws_prod.cell(row=61, column=3).value = \'Y\'\nws_prod.cell(row=61, column=4).value = \'K/Y\'\nws_prod.cell(row=61, column=5).value = \'K_extended\'\nws_prod.cell(row=61, column=6).value = \'LnZ_trend\'\nws_prod.cell(row=61, column=7).value = \'Ystar_base\'\nws_prod.cell(row=61, column=8).value = \'Investment\'\nws_prod.cell(row=61, column=9).value = \'K_with\'\nws_prod.cell(row=61, column=10).value = \'Ystar_with\'\n\n# Populate years 2002-2043 (rows 62-83)\nfor row_offset, year in enumerate(range(2002, 2044), start=62):\n    ws_prod.cell(row=row_offset, column=1).value = year\n    \n    # K and Y for 2002-2025 (from earlier data)\n    if 2002 <= year <= 2025:\n        source_row = 6 + (year - 2002)\n        ws_prod.cell(row=row_offset, column=2).value = f\'=D{source_row}\'\n        ws_prod.cell(row=row_offset, column=3).value = f\'=E{source_row}\'\n    else:\n        # For 2026+, use WEO_Data for Y\n        for weo_row in range(8, 50):\n            weo_year = ws_prod.parent[\'WEO_Data\'].cell(row=weo_row, column=1).value\n            if weo_year == year:\n                ws_prod.cell(row=row_offset, column=3).value = f\'=WEO_Data!C{weo_row}\'\n                break\n    \n    # K/Y ratio (only for 2002-2023 to calculate anchor)\n    if 2002 <= year <= 2023:\n        ws_prod.cell(row=row_offset, column=4).value = f\'=IF(AND(B{row_offset}<>"",C{row_offset}<>""),B{row_offset}/C{row_offset},"")\'\n\nprint(\'Years and K/Y ratio formulas added\')\n\n# Step 2: Calculate average K/Y for last 9 years (2015-2023) as anchor\nprint(\'\\n2. Setting up K/Y anchor calculation...\')\nky_anchor_formula = \'=AVERAGE(D71:D79)\'  # Rows for 2015-2023\nws_prod.cell(row=59, column=4).value = \'K/Y Anchor (2015-2023)\'\nws_prod.cell(row=59, column=5).value = ky_anchor_formula\n\n# Step 3: Extended K using anchor\nprint(\'\\n3. Setting up extended K calculation...\')\nfor row_offset, year in enumerate(range(2002, 2044), start=62):\n    if year <= 2023:\n        # Use actual K\n        ws_prod.cell(row=row_offset, column=5).value = f\'=IF(B{row_offset}<>"",B{row_offset},"")\'\n    else:\n        # K_extended = K/Y_anchor * Y\n        ws_prod.cell(row=row_offset, column=5).value = f\'=IF(C{row_offset}<>"",E$59*C{row_offset},"")\'\n\nprint(\'Extended K formulas added\')\n\n# Step 4: Link LnZ_trend from HP Filter (column F)\nprint(\'\\n4. Linking LnZ_trend...\')\nfor row_offset, year in enumerate(range(2002, 2024), start=62):  # 2002-2023\n    hp_row = 37 + (year - 2002)\n    ws_prod.cell(row=row_offset, column=6).value = f\'=E{hp_row}\'\n\nprint(\'LnZ_trend linked\')\n\n# Step 5: Calculate Ystar_base = exp(LnZ_trend + alpha*ln(K))\nprint(\'\\n5. Setting up Ystar_base calculation...\')\nfor row_offset in range(62, 84):\n    ws_prod.cell(row=row_offset, column=7).value = f\'=IF(AND(F{row_offset}<>"",E{row_offset}<>""),EXP(F{row_offset}+$B$2*LN(E{row_offset})),"")\'\n\nprint(\'Ystar_base formulas added\')\n\n# Step 6: Link Investment from Investment sheet\nprint(\'\\n6. Linking Investment data...\')\nfor row_offset, year in enumerate(range(2002, 2044), start=62):\n    # Investment is in Investment sheet, rows 2-9 for years 2026-2033\n    if 2026 <= year <= 2033:\n        inv_row = 2 + (year - 2026)\n        ws_prod.cell(row=row_offset, column=8).value = f\'=IF(Investment!B{inv_row}={year},Investment!C{inv_row},0)\'\n    else:\n        ws_prod.cell(row=row_offset, column=8).value = 0\n\nprint(\'Investment data linked\')\n\n# Step 7: Calculate K_with (K with investment shock)\nprint(\'\\n7. Setting up K_with calculation...\')\nfor row_offset, year in enumerate(range(2002, 2044), start=62):\n    if year == 2002:\n        # Starting K_with = K_extended\n        ws_prod.cell(row=row_offset, column=9).value = f\'=E{row_offset}\'\n    else:\n        prev_row = row_offset - 1\n        # K_with(t) = K_with(t-1) * (1 - depreciation_rate) + Investment(t)\n        ws_prod.cell(row=row_offset, column=9).value = f\'=I{prev_row}*(1-$B$3)+H{row_offset}\'\n\nprint(\'K_with formulas added\')\n\n# Step 8: Calculate Ystar_with\nprint(\'\\n8. Setting up Ystar_with calculation...\')\nfor row_offset in range(62, 84):\n    ws_prod.cell(row=row_offset, column=10).value = f\'=IF(AND(F{row_offset}<>"",I{row_offset}<>""),EXP(F{row_offset}+$B$2*LN(I{row_offset})),"")\'\n\nprint(\'Ystar_with formulas added\')\n\nwb.save(\'/root/test-supply.xlsx\')\nprint(\'\\nProduction Function section setup complete!\')\n\nEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
