Sending keys: ['cat << \'EOF\' > /root/check_vol.py\nimport struct\nimport collections\n\ndef solve():\n    with open(\'/root/scan_data.stl\', \'rb\') as f:\n        f.read(84)\n        triangles = []\n        while True:\n            data = f.read(50)\n            if len(data) < 50: break\n            parts = struct.unpack(\'<ffffffffffffH\', data)\n            v1, v2, v3 = parts[3:6], parts[6:9], parts[9:12]\n            triangles.append({\'v1\': v1, \'v2\': v2, \'v3\': v3, \'attr\': parts[12]})\n\n    # Check components\n    vertex_to_triangles = collections.defaultdict(list)\n    for i, tri in enumerate(triangles):\n        for v in [tri[\'v1\'], tri[\'v2\'], tri[\'v3\']]:\n            vertex_to_triangles[tuple(v)].append(i)\n    adj = collections.defaultdict(set)\n    for tri_indices in vertex_to_triangles.values():\n        for i in tri_indices:\n            for j in tri_indices:\n                if i != j: adj[i].add(j)\n    visited = [False] * len(triangles)\n    components = []\n    for i in range(len(triangles)):\n        if not visited[i]:\n            comp = []; stack = [i]; visited[i] = True\n            while stack:\n                u = stack.pop(); comp.append(u)\n                for v in adj[u]:\n                    if not visited[v]: visited[v] = True; stack.append(v)\n            components.append(comp)\n\n    print(f"Number of components: {len(components)}")\n    for i, comp in enumerate(sorted(components, key=len, reverse=True)):\n        vol = 0\n        m_ids = []\n        for idx in comp:\n            tri = triangles[idx]\n            v1, v2, v3 = tri[\'v1\'], tri[\'v2\'], tri[\'v3\']\n            vol += (v1[0]*(v2[1]*v3[2]-v2[2]*v3[1]) + v1[1]*(v2[2]*v3[0]-v2[0]*v3[2]) + v1[2]*(v2[0]*v3[1]-v2[1]*v3[0])) / 6.0\n            m_ids.append(tri[\'attr\'])\n        print(f"Component {i}: triangles={len(comp)}, material={collections.Counter(m_ids).most_common(1)}, volume={vol}")\n\nsolve()\nEOF\npython3 /root/check_vol.py\n'] min_timeout_sec: 1.0 max