Sending keys: ['cat > mpc_controller.py << \'EOF\'\n#!/usr/bin/env python3\n"""MPC Controller for R2R Web Handling System"""\n\nimport json\nimport numpy as np\nfrom scipy import linalg\nfrom r2r_simulator import R2RSimulator\n\ndef compute_steady_state_velocities(T_ref, EA, L, v0):\n    n = len(T_ref)\n    v_ref = np.zeros(n)\n    v_p, T_p = v0, 0.0\n    for i in range(n):\n        v_ref[i] = (EA - T_p) / (EA - T_ref[i]) * v_p\n        v_p, T_p = v_ref[i], T_ref[i]\n    return v_ref\n\ndef linearize_system(T_ref, v_ref, EA, J, R, fb, L):\n    n = 6\n    A = np.zeros((12, 12))\n    B = np.zeros((12, 6))\n    \n    for i in range(n):\n        A[i, i] = -v_ref[i] / L\n        if i > 0:\n            A[i, i-1] = v_ref[i-1] / L\n        A[i, n + i] = (EA - T_ref[i]) / L\n        if i > 0:\n            A[i, n + i - 1] = -(EA - T_ref[i-1]) / L\n    \n    for i in range(n):\n        A[n + i, i] = -R**2 / J\n        if i < n - 1:\n            A[n + i, i + 1] = R**2 / J\n        A[n + i, n + i] = -fb / J\n        B[n + i, i] = R / J\n    \n    return A, B\n\ndef discretize_system(A, B, dt):\n    n = A.shape[0]\n    m = B.shape[1]\n    M = np.zeros((n + m, n + m))\n    M[:n, :n] = A * dt\n    M[:n, n:] = B * dt\n    expM = linalg.expm(M)\n    return expM[:n, :n], expM[:n, n:]\n\ndef compute_lqr_gain(A, B, Q, R):\n    P = linalg.solve_discrete_are(A, B, Q, R)\n    K = np.linalg.inv(R + B.T @ P @ B) @ B.T @ P @ A\n    return K\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
