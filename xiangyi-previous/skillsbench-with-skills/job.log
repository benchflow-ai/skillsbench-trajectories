Sending keys: ['cat >> /app/analysis_part5.py << \'EOF\'\n\ndef analyze_category(cat, intensive_df, extensive_df, survey_fe, feature_cols, anomaly_df, purchases_df, baseline_start, baseline_end, treatment_start, treatment_end):\n    """Analyze a single category"""\n    anomaly_row = anomaly_df[anomaly_df[\'Category\'] == cat].iloc[0]\n    anomaly_index = anomaly_row[\'Anomaly_Index\']\n    \n    # Get category purchases for statistics\n    cat_purchases = purchases_df[purchases_df[\'Category\'] == cat].copy()\n    baseline_purchases = cat_purchases[(cat_purchases[\'Order Date\'] >= baseline_start) & (cat_purchases[\'Order Date\'] <= baseline_end)]\n    treatment_purchases = cat_purchases[(cat_purchases[\'Order Date\'] >= treatment_start) & (cat_purchases[\'Order Date\'] <= treatment_end)]\n    \n    baseline_avg = baseline_purchases[\'Total_Spend\'].mean() if len(baseline_purchases) > 0 else 0\n    treatment_avg = treatment_purchases[\'Total_Spend\'].mean() if len(treatment_purchases) > 0 else 0\n    n_baseline = baseline_purchases[\'Survey ResponseID\'].nunique()\n    n_treatment = treatment_purchases[\'Survey ResponseID\'].nunique()\n    n_at_risk = len(survey_fe)\n    baseline_rate = n_baseline / n_at_risk if n_at_risk > 0 else 0\n    treatment_rate = n_treatment / n_at_risk if n_at_risk > 0 else 0\n    \n    # Intensive margin analysis\n    int_data = intensive_df[intensive_df[\'Category\'] == cat].merge(survey_fe, on=\'Survey ResponseID\', how=\'left\')\n    intensive_results = []\n    for feat in feature_cols:\n        if feat in int_data.columns:\n            coef, pval = run_univariate_did(int_data, feat, \'Total_Spend\')\n            if coef is not None:\n                intensive_results.append({\'feature\': feat, \'did_estimate\': round(coef, 4), \'p_value\': round(pval, 4), \'method\': \'Univariate DiD\'})\n    \n    # Extensive margin analysis\n    ext_data = extensive_df[extensive_df[\'Category\'] == cat].merge(survey_fe, on=\'Survey ResponseID\', how=\'left\')\n    extensive_results = []\n    for feat in feature_cols:\n        if feat in ext_data.columns:\n            coef, pval = run_univariate_did(ext_data, feat, \'Has_Purchase\')\n            if coef is not None:\n                extensive_results.append({\'feature\': feat, \'did_estimate\': round(coef, 6), \'p_value\': round(pval, 4), \'method\': \'Multivariate Heterogeneous DiD\'})\n    \n    return {\n        \'category\': cat,\n        \'anomaly_index\': round(anomaly_index, 2),\n        \'baseline_avg_spend\': round(baseline_avg, 2),\n        \'treatment_avg_spend\': round(treatment_avg, 2),\n        \'n_purchasers_baseline\': int(n_baseline),\n        \'n_purchasers_treatment\': int(n_treatment),\n        \'baseline_purchase_rate\': round(baseline_rate, 4),\n        \'treatment_purchase_rate\': round(treatment_rate, 4),\n        \'n_at_risk\': int(n_at_risk),\n        \'intensive_results\': intensive_results,\n        \'extensive_results\': extensive_results\n    }\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
