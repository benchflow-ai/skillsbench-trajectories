n_factor = 1/3.1  # mmol/L to mg/dL\n    elif feature == \'Albumin_Serum\':\n        if (col_data > 8).any():\n            conversion_factor = 1/10  # g/L to g/dL\n    elif feature == \'Total_Protein\':\n        if (col_data > 10).any():\n            conversion_factor = 1/10  # g/L to g/dL\n    elif feature == \'Hemoglobin\':\n        if (col_data > 20).any():\n            conversion_factor = 1/10  # g/L to g/dL\n        elif (col_data < 5).any() and (col_data > 0).any():\n            conversion_factor = 10  # mmol/L to g/dL\n    elif feature == \'Hematocrit\':\n        if (col_data > 60).any():\n            conversion_factor = 1/10\n    elif feature == \'Glucose\':\n        if (col_data > 1000).any():\n            conversion_factor = 1/18  # µmol/L to mg/dL\n    elif feature == \'Uric_Acid\':\n        if (col_data > 15).any():\n            conversion_factor = 1/59.48  # µmol/L to mg/dL\n    elif feature == \'Triglycerides\':\n        if (col_data > 1000).any():\n            conversion_factor = 1/100  # mg/L to mg/dL\n    elif feature == \'Total_Cholesterol\':\n        if (col_data > 1000).any():\n            conversion_factor = 1/100  # mg/L to mg/dL\n    elif feature == \'LDL_Cholesterol\':\n        if (col_data > 1000).any():\n            conversion_factor = 1/100  # mg/L to mg/dL\n    elif feature == \'HDL_Cholesterol\':\n        if (col_data > 1000).any():\n            conversion_factor = 1/100  # mg/L to mg/dL\n    elif feature == \'Ferritin\':\n        if (col_data > 500).any():\n            conversion_factor = 1/10  # µg/L to ng/mL\n    elif feature == \'Prealbumin\':\n        if (col_data > 50).any():\n            conversion_factor = 1/10  # mg/L to mg/dL\n    elif feature == \'pO2_Arterial\':\n        if (col_data > 200).any():\n            conversion_factor = 1/7.5  # kPa to mmHg\n    elif feature == \'Lactate\':\n        if (col_data > 10).any():\n            conversion_factor = 1/11.2  # mmol/L to mg/dL\n    elif feature == \'Beta2_Microglobulin\':\n   