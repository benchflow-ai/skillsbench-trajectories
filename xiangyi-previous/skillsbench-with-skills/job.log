me avoiding downtime\ndef get_available_start(machine, earliest, duration, downtime):\n    start = earliest\n    if machine not in downtime:\n        return start\n    \n    for _ in range(100):\n        end = start + duration\n        conflict = False\n        for ds, de in downtime[machine]:\n            if start < de and end > ds:\n                start = de\n                conflict = True\n                break\n        if not conflict:\n            return start\n    return start\n\njobs, num_machines = parse_instance(\'/app/data/instance.txt\')\ndowntime = parse_downtime(\'/app/data/downtime.csv\')\npolicy = parse_policy(\'/app/data/policy.json\')\nbaseline = parse_baseline(\'/app/data/baseline_solution.json\')\n\nprint(f"Jobs: {len(jobs)}, Machines: {num_machines}")\nfor j, ops in enumerate(jobs):\n    print(f"  Job {j}: {ops}")\nprint(f"Downtime: {downtime}")\n\n# Create baseline lookup\nbaseline_ops = {}\nfor op in baseline[\'schedule\']:\n    baseline_ops[(op[\'job\'], op[\'op\'])] = op\n\nfreeze_until = policy[\'freeze\'][\'freeze_until\']\nmax_machine_changes = policy[\'change_budget\'][\'max_machine_changes\']\nmax_start_shift = policy[\'change_budget\'][\'max_total_start_shift_L1\']\nmax_makespan = baseline[\'makespan\'] * policy[\'guards\'][\'max_makespan_ratio\']\n\nprint(f"\\nFreeze until: {freeze_until}")\nprint(f"Max machine changes: {max_machine_changes}")\nprint(f"Max start shift L1: {max_start_shift}")\nprint(f"Max makespan: {max_makespan}")\n\n# Identify frozen operations\nfrozen = set()\nfor key, op in baseline_ops.items():\n    if op[\'start\'] < freeze_until:\n        frozen.add(key)\n        print(f"Frozen: Job {key[0]} Op {key[1]} - machine {op[\'machine\']}, {op[\'start\']}-{op[\'end\']}")\n\n# Analyze baseline violations\nprint("\\nBaseline violations:")\nfor key, op in baseline_ops.items():\n    if overlaps_downtime(op[\'machine\'], op[\'start\'], op[\'end\'], downtime):\n        print(f"  Job {key[0]} Op {key[1]}: machine {op[\'machine\']}, {op[\'start\']}-{op[\'end\']}")\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
