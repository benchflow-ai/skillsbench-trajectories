Sending keys: ['cat <<EOF > solve_tasks.py\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\n# Enable x64 to match numpy default precision if needed\njax.config.update("jax_enable_x64", True)\n\ndef task_basic_reduce():\n    print("Running task: basic_reduce")\n    x = jnp.load("data/x.npy")\n    # Mean of each row\n    result = jnp.mean(x, axis=1)\n    np.save("basic_reduce.npy", result)\n\ndef task_map_square():\n    print("Running task: map_square")\n    x = jnp.load("data/x.npy")\n    # Square each element\n    result = jnp.square(x)\n    np.save("map_square.npy", result)\n\ndef task_grad_logistic():\n    print("Running task: grad_logistic")\n    data = np.load("data/logistic.npz")\n    x = jnp.array(data[\'x\'])\n    y = jnp.array(data[\'y\'])\n    w = jnp.array(data[\'w\'])\n\n    def loss_fn(w, x, y):\n        logits = jnp.dot(x, w)\n        # Logistic loss for labels {-1, 1}\n        # loss = log(1 + exp(-y * logits))\n        return jnp.mean(jnp.log1p(jnp.exp(-y * logits)))\n\n    grad_fn = jax.grad(loss_fn)\n    grads = grad_fn(w, x, y)\n    np.save("grad_logistic.npy", grads)\n\ndef task_scan_rnn():\n    print("Running task: scan_rnn")\n    data = np.load("data/seq.npz")\n    seq = jnp.array(data[\'seq\'])\n    init = jnp.array(data[\'init\'])\n    Wx = jnp.array(data[\'Wx\'])\n    Wh = jnp.array(data[\'Wh\'])\n    b = jnp.array(data[\'b\'])\n\n    def step_fn(h_prev, x_t):\n        # h_t = tanh(Wx @ x_t + Wh @ h_prev + b)\n        h_new = jnp.tanh(jnp.dot(Wx, x_t) + jnp.dot(Wh, h_prev) + b)\n        return h_new, h_new\n\n    final_h, states = jax.lax.scan(step_fn, init, seq)\n    np.save("scan_rnn.npy", states)\n\ndef task_jit_mlp():\n    print("Running task: jit_mlp")\n    data = np.load("data/mlp.npz")\n    X = jnp.array(data[\'X\'])\n    W1 = jnp.array(data[\'W1\'])\n    b1 = jnp.array(data[\'b1\'])\n    W2 = jnp.array(data[\'W2\'])\n    b2 = jnp.array(data[\'b2\'])\n\n    def mlp(X, W1, b1, W2, b2):\n        # Layer 1: ReLU(X @ W1 + b1)\n        h = jax.nn.relu(jnp.dot(X, W1) + b1)\n        # Layer 2: h @ W2 + b2\n        out = jnp.dot(h, W2) + b2\n        return out\n\n    jit_mlp_fn = jax.jit(mlp)\n    result = jit_mlp_fn(X, W1, b1, W2, b2)\n    # Ensure execution by converting to numpy (blocks until ready)\n    np.save("jit_mlp.npy", result)\n\nif __name__ == "__main__":\n    try:\n        task_basic_reduce()\n        task_map_square()\n        task_grad_logistic()\n        task_scan_rnn()\n        task_jit_mlp()\n        print("All tasks completed.")\n    except Exception as e:\n        print(f"An error occurred: {e}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
