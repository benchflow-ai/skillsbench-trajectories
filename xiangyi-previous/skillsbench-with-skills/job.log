Sending keys: ["cat > solve.py <<EOF\nimport seisbench.models as sbm\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom datetime import datetime\n\ndef solve():\n    print('Loading data...')\n    stream = obspy.read('/root/data/wave.mseed')\n    print(f'Loaded {len(stream)} traces')\n\n    print('Loading PhaseNet...')\n    model = sbm.PhaseNet.from_pretrained('stead')\n    \n    print('Picking phases...')\n    # Classify the stream. This returns a list of Pick objects.\n    # Using a lower threshold to capture more candidates, DBSCAN will filter noise.\n    picks = model.classify(stream, P_threshold=0.3, S_threshold=0.3)\n    print(f'Picked {len(picks)} phases')\n\n    # Organize picks by station\n    picks_by_station = {}\n    for p in picks:\n        # trace_id is usually NET.STA.LOC.CHA\n        # Group by NET.STA\n        net, sta = p.trace_id.split('.')[0:2]\n        key = f'{net}.{sta}'\n        if key not in picks_by_station:\n            picks_by_station[key] = []\n        picks_by_station[key].append(p)\n\n    origin_times = []\n    vp = 6.0\n    vs = vp / 1.75\n    r = vp / vs # 1.75\n\n    print('Associating...')\n    for sta, p_list in picks_by_station.items():\n        # Separate P and S\n        ps = [x for x in p_list if x.phase == 'P']\n        ss = [x for x in p_list if x.phase == 'S']\n        \n        # Simple association: P and S on same station within time window\n        for p_pick in ps:\n            for s_pick in ss:\n                # Check if S is after P\n                if s_pick.peak_time > p_pick.peak_time:\n                    dt = s_pick.peak_time - p_pick.peak_time\n                    # Assume local/regional events, S-P usually < 60s\n                    if dt < 60:\n                        # t0 = tP - (tS - tP) / (r - 1)\n                        t0_correction = dt / (r - 1)\n                        t0 = p_pick.peak_time - t0_correction\n                        origin_times.append(t0.datetime.timestamp())\n\n    if not origin_times:\n        print('No events associated.')\n        # Create empty file or handle error\n        pd.DataFrame(columns=['time']).to_csv('/root/results.csv', index=False)\n        return\n\n    print(f'Generated {len(origin_times)} candidate origin times')\n    \n    # Clustering\n    X = np.array(origin_times).reshape(-1, 1)\n    # eps=3 seconds (generous for P-S picking errors), min_samples=3 (need support from multiple stations/phases)\n    # Adjust min_samples based on data volume. If network is sparse, maybe 2.\n    # Let's try min_samples=3 first.\n    db = DBSCAN(eps=5, min_samples=3).fit(X)\n    labels = db.labels_\n\n    events = []\n    unique_labels = set(labels)\n    print(f'Found {len(unique_labels) - (1 if -1 in unique_labels else 0)} clusters')\n\n    for k in unique_labels:\n        if k == -1:\n            continue\n        \n        class_member_mask = (labels == k)\n        cluster_times = X[class_member_mask]\n        mean_time = np.mean(cluster_times)\n        \n        # Convert to ISO format\n        # SeisBench/Obspy uses UTC\n        t_iso = datetime.utcfromtimestamp(mean_time).isoformat(timespec='milliseconds')\n        events.append(t_iso)\n\n    # Sort events by time\n    events.sort()\n    \n    # Save\n    df = pd.DataFrame({'time': events})\n    df.to_csv('/root/results.csv', index=False)\n    print('Results saved to /root/results.csv')\n\nif __name__ == '__main__':\n    solve()\nEOF\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
