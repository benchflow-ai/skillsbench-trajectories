Sending keys: ['cat << \'EOF\' > fill_offer.py\nimport json\nimport sys\nfrom docx import Document\n\ndef process_paragraph(paragraph, replacements):\n    text = paragraph.text\n    # Check if any replacement key is in the text\n    for key, value in replacements.items():\n        if key in text:\n            # Try to find it in runs to preserve formatting\n            found_in_run = False\n            for run in paragraph.runs:\n                if key in run.text:\n                    run.text = run.text.replace(key, value)\n                    found_in_run = True\n            \n            if not found_in_run:\n                # Fallback: this loses formatting of the paragraph but ensures replacement\n                paragraph.text = paragraph.text.replace(key, value)\n\ndef main():\n    input_json = \'employee_data.json\'\n    input_docx = \'offer_letter_template.docx\'\n    output_docx = \'/root/offer_letter_filled.docx\'\n\n    try:\n        with open(input_json, \'r\') as f:\n            data = json.load(f)\n    except Exception as e:\n        print(f"Error reading JSON: {e}")\n        sys.exit(1)\n\n    try:\n        doc = Document(input_docx)\n    except Exception as e:\n        print(f"Error reading DOCX: {e}")\n        sys.exit(1)\n\n    # Prepare replacements\n    replacements = {}\n    for k, v in data.items():\n        replacements[\'{{\' + k + \'}}\'] = str(v)\n\n    # Conditional logic\n    relocation = data.get(\'RELOCATION_PACKAGE\', \'No\')\n    if relocation == \'Yes\':\n        replacements[\'{{IF_RELOCATION}}\'] = \'\'\n        replacements[\'{{END_IF_RELOCATION}}\'] = \'\'\n    else:\n        # If No, we would conceptually remove the content between markers.\n        # Given the task specifics (Data is Yes), we focus on removing markers.\n        pass\n\n    # Process paragraphs in body\n    for paragraph in doc.paragraphs:\n        process_paragraph(paragraph, replacements)\n\n    # Process tables\n    for table in doc.tables:\n        for row in table.rows:\n            for cell in row.cells:\n                for paragraph in cell.paragraphs:\n                    process_paragraph(paragraph, replacements)\n    \n    # Save\n    doc.save(output_docx)\n    print(f"Successfully saved to {output_docx}")\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
