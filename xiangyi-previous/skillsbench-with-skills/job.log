Sending keys: ["cat << 'EOF' > /root/picker.py\nimport numpy as np\nimport os\nimport pandas as pd\nfrom scipy import signal\n\ndef bandpass_filter(data, lowcut, highcut, fs, order=4):\n    nyquist = 0.5 * fs\n    low = lowcut / nyquist\n    high = highcut / nyquist\n    b, a = signal.butter(order, [low, high], btype='band')\n    y = signal.filtfilt(b, a, data, axis=0)\n    return y\n\ndef classic_sta_lta(sig, nsta, nlta):\n    sta = np.zeros(len(sig))\n    lta = np.zeros(len(sig))\n    sq_sig = sig**2\n    # Use cumulative sum for fast calculation\n    cumsum = np.cumsum(np.insert(sq_sig, 0, 0))\n    \n    # STA\n    sta = (cumsum[nsta:] - cumsum[:-nsta]) / nsta\n    # LTA\n    lta = (cumsum[nlta:] - cumsum[:-nlta]) / nlta\n    \n    # Pad to match original length\n    sta = np.pad(sta, (nsta-1, 0), 'constant', constant_values=1e-10)\n    lta = np.pad(lta, (nlta-1, 0), 'constant', constant_values=1e-10)\n    \n    return sta / (lta + 1e-10)\n\ndef pick_phases():\n    data_dir = '/root/data/'\n    files = sorted([f for f in os.listdir(data_dir) if f.endswith('.npz')])\n    results = []\n    \n    for f in files:\n        path = os.path.join(data_dir, f)\n        try:\n            d = np.load(path)\n            data = d['data']\n            dt = d['dt']\n            fs = 1.0 / dt\n            \n            # Preprocessing: Bandpass filter 1-15 Hz\n            data_filt = bandpass_filter(data, 1.0, 15.0, fs)\n            \n            # P-picking on Vertical channel (index 2)\n            p_sig = data_filt[:, 2]\n            p_char = classic_sta_lta(p_sig, int(0.1*fs), int(2.0*fs))\n            # Thresholding\n            p_thresh = 4.0\n            p_picks = np.where(p_char > p_thresh)[0]\n            p_idx = None\n            if len(p_picks) > 0:\n                p_idx = p_picks[0]\n                results.append({'file_name': f, 'phase': 'P', 'pick_idx': p_idx})\n            \n            # S-picking on Horizontals\n            s_sig = np.sqrt(data_filt[:, 0]**2 + data_filt[:, 1]**2)\n            s_char = classic_sta_lta(s_sig, int(0.3*fs), int(4.0*fs))\n            \n            # Thresholding, start searching after P-pick if available\n            s_thresh = 3.0\n            search_start = p_idx + int(0.5*fs) if p_idx is not None else int(1.0*fs)\n            if search_start < len(s_char):\n                s_picks = np.where(s_char[search_start:] > s_thresh)[0]\n                if len(s_picks) > 0:\n                    s_idx = s_picks[0] + search_start\n                    results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_idx})\n        except Exception as e:\n            print(f'Error processing {f}: {e}')\n            \n    df = pd.DataFrame(results)\n    df.to_csv('/root/results.csv', index=False)\n    print(f'Done! Wrote {len(df)} picks to /root/results.csv')\n\nif __name__ == '__main__':\n    pick_phases()\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
