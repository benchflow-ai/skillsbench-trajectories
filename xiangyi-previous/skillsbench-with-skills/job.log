Sending keys: ['cat > /app/solve.py << \'EOF\'\nimport json\nimport csv\n\ndef parse_instance(filename):\n    with open(filename, \'r\') as f:\n        lines = [l.strip() for l in f.readlines() if l.strip()]\n    first_line = lines[0].split()\n    num_jobs = int(first_line[0])\n    num_machines = int(first_line[1])\n    jobs = []\n    i = 1\n    for _ in range(num_jobs):\n        num_ops = int(lines[i])\n        i += 1\n        ops = []\n        for _ in range(num_ops):\n            parts = list(map(int, lines[i].split()))\n            i += 1\n            num_alts = parts[0]\n            alternatives = []\n            idx = 1\n            for _ in range(num_alts):\n                machine = parts[idx]\n                duration = parts[idx + 1]\n                alternatives.append((machine, duration))\n                idx += 2\n            ops.append(alternatives)\n        jobs.append(ops)\n    return jobs, num_machines\n\ndef parse_downtime(filename):\n    downtime = {}\n    with open(filename, \'r\') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            m = int(row[\'machine\'])\n            s = int(row[\'start\'])\n            e = int(row[\'end\'])\n            if m not in downtime:\n                downtime[m] = []\n            downtime[m].append((s, e))\n    return downtime\n\ndef parse_policy(filename):\n    with open(filename, \'r\') as f:\n        return json.load(f)\n\ndef parse_baseline(filename):\n    with open(filename, \'r\') as f:\n        return json.load(f)\n\ndef overlaps_downtime(machine, start, end, downtime):\n    if machine not in downtime:\n        return False\n    for ds, de in downtime[machine]:\n        if start < de and end > ds:\n            return True\n    return False\n\ndef get_available_start(machine, earliest, duration, downtime):\n    start = earliest\n    if machine not in downtime:\n        return start\n    for _ in range(100):\n        end = start + duration\n        conflict = False\n        for ds, de in sorted(downtime[machine]):\n            if start < de and end > ds:\n                start = de\n                conflict = True\n                break\n        if not conflict:\n            return start\n    return start\n\n# Load data\njobs, num_machines = parse_instance(\'/app/data/instance.txt\')\ndowntime = parse_downtime(\'/app/data/downtime.csv\')\npolicy = parse_policy(\'/app/data/policy.json\')\nbaseline = parse_baseline(\'/app/data/baseline_solution.json\')\n\nbaseline_ops = {}\nfor op in baseline[\'schedule\']:\n    baseline_ops[(op[\'job\'], op[\'op\'])] = op\n\nfreeze_until = policy[\'freeze\'][\'freeze_until\']\nmax_machine_changes = policy[\'change_budget\'][\'max_machine_changes\']\nmax_start_shift = policy[\'change_budget\'][\'max_total_start_shift_L1\']\n\n# Check which frozen ops have downtime violations - they must change machine\nfrozen_with_downtime = set()\nfor key, op in baseline_ops.items():\n    if op[\'start\'] < freeze_until:\n        if overlaps_downtime(op[\'machine\'], op[\'start\'], op[\'end\'], downtime):\n            frozen_with_downtime.add(key)\n            print(f"Frozen with downtime violation: Job {key[0]} Op {key[1]}")\n\ndef schedule_jobs(jobs, downtime, baseline_ops, freeze_until, num_machines, frozen_with_downtime):\n    machine_available = [0] * num_machines\n    schedule = []\n    machine_changes = 0\n    total_start_shift = 0\n    \n    pending = [(j, 0) for j in range(len(jobs))]\n    scheduled_ops = set()\n    \n    iteration = 0\n    max_iterations = 1000\n    \n    while pending and iteration < max_iterations:\n        iteration += 1\n        best = None\n        best_start = float(\'inf\')\n        best_machine = None\n        best_duration = None\n        \n        for j, op_idx in list(pending):\n            if (j, op_idx) in scheduled_ops:\n                continue\n            if op_idx > 0 and (j, op_idx - 1) not in scheduled_ops:\n                continue\n            \n            baseline_op = baseline_ops.get((j, op_idx))\n            is_frozen = baseline_op and baseline_op[\'start\'] < freeze_until\n            has_downtime_violation = (j, op_idx) in frozen_with_downtime\n            \n            alternatives = jobs[j][op_idx]\n            \n            for machine, duration in alternatives:\n                # If frozen with downtime violation, must change machine (skip original)\n                if is_frozen and has_downtime_violation and machine == baseline_op[\'machine\']:\n                    continue\n                \n                # If frozen without downtime violation, must keep same machine\n                if is_frozen and not has_downtime_violation and machine != baseline_op[\'machine\']:\n                    continue\n                \n                # Get previous op end time\n                prev_end = 0\n                if op_idx > 0:\n                    for s in schedule:\n                        if s[\'job\'] == j and s[\'op\'] == op_idx - 1:\n                            prev_end = s[\'end\']\n                            break\n                \n                earliest = max(machine_available[machine], prev_end)\n                start = get_available_start(machine, earliest, duration, downtime)\n                \n                if start < best_start:\n                    best = (j, op_idx)\n                    best_start = start\n                    best_machine = machine\n                    best_duration = duration\n        \n        if best is None:\n            # Debug: print what\'s pending\n            print(f"Cannot schedule. Pending: {pending}")\n            print(f"Scheduled: {scheduled_ops}")\n            for j, op_idx in pending:\n                if op_idx > 0 and (j, op_idx - 1) not in scheduled_ops:\n                    print(f"  Job {j} Op {op_idx} waiting for Op {op_idx-1}")\n                else:\n                    print(f"  Job {j} Op {op_idx} ready but no valid alternative")\n            break\n        \n        j, op_idx = best\n        baseline_op = baseline_ops.get((j, op_idx))\n        \n        if baseline_op:\n            if best_machine != baseline_op[\'machine\']:\n                machine_changes += 1\n            total_start_shift += abs(best_start - baseline_op[\'start\'])\n        \n        schedule.append({\n            \'job\': j,\n            \'op\': op_idx,\n            \'machine\': best_machine,\n            \'start\': best_start,\n            \'end\': best_start + best_duration,\n            \'dur\': best_duration\n        })\n        \n        machine_available[best_machine] = best_start + best_duration\n        scheduled_ops.add((j, op_idx))\n        \n        if op_idx + 1 < len(jobs[j]):\n            pending.append((j, op_idx + 1))\n        \n        pending = [(jj, oo) for jj, oo in pending if (jj, oo) not in scheduled_ops]\n    \n    return schedule, machine_changes, total_start_shift\n\nschedule, machine_changes, total_start_shift = schedule_jobs(\n    jobs, downtime, baseline_ops, freeze_until, num_machines, frozen_with_downtime\n)\n\nif len(schedule) != sum(len(ops) for ops in jobs):\n    print(f"ERROR: Only scheduled {len(schedule)} of {sum(len(ops) for ops in jobs)} operations!")\nelse:\n    makespan = max(op[\'end\'] for op in schedule)\n    \n    print(f"\\nSchedule generated:")\n    print(f"  Makespan: {makespan} (baseline: {baseline[\'makespan\']})")\n    print(f"  Machine changes: {machine_changes} (max: {max_machine_changes})")\n    print(f"  Total start shift: {total_start_shift} (max: {max_start_shift})")\n    \n    violations = 0\n    for op in schedule:\n        if overlaps_downtime(op[\'machine\'], op[\'start\'], op[\'end\'], downtime):\n            print(f"  VIOLATION: Job {op[\'job\']} Op {op[\'op\']} on machine {op[\'machine\']}, {op[\'start\']}-{op[\'end\']}")\n            violations += 1\n    \n    print(f"  Downtime violations: {violations}")\n    \n    schedule.sort(key=lambda x: (x[\'start\'], x[\'job\'], x[\'op\']))\n    \n    for op in schedule:\n        print(f"  Job {op[\'job\']} Op {op[\'op\']}: M{op[\'machine\']} [{op[\'start\']}-{op[\'end\']}] dur={op[\'dur\']}")\n    \n    if violations == 0 and machine_changes <= max_machine_changes and total_start_shift <= max_start_shift:\n        solution = {\n            "status": "FEASIBLE",\n            "makespan": makespan,\n            "schedule": schedule\n        }\n        \n        with open(\'/app/output/solution.json\', \'w\') as f:\n            json.dump(solution, f, indent=2)\n        \n        with open(\'/app/output/schedule.csv\', \'w\') as f:\n            f.write(\'job,op,machine,start,end,dur\\n\')\n            for op in schedule:\n                f.write(f"{op[\'job\']},{op[\'op\']},{op[\'machine\']},{op[\'start\']},{op[\'end\']},{op[\'dur\']}\\n")\n        \n        print("\\nSolution saved!")\n    else:\n        print("\\nSolution violates constraints!")\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
