Sending keys: ['cat << \'EOF\' > /root/workspace/parallel_solution.py\nimport math\nimport time\nimport multiprocessing\nfrom collections import defaultdict\nfrom dataclasses import dataclass, field\nfrom heapq import nlargest\nfrom sequential import TFIDFIndex, SearchResult, tokenize, compute_term_frequencies, STOP_WORDS, TOKEN_PATTERN\nfrom document_generator import Document\n\n@dataclass\nclass ParallelIndexingResult:\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\ndef _tokenize_docs_worker(docs):\n    results = []\n    for doc in docs:\n        text = doc.title + " " + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        results.append((doc.doc_id, tf))\n    return results\n\ndef _calculate_df_worker(args):\n    terms, doc_terms_list = args\n    df_chunk = {}\n    for term in terms:\n        count = 0\n        for dt in doc_terms_list:\n            if term in dt:\n                count += 1\n        df_chunk[term] = count\n    return df_chunk\n\ndef _build_inverted_index_worker(args):\n    terms, doc_term_freqs, idf = args\n    ii_chunk = {}\n    for term in terms:\n        posting_list = []\n        for doc_id, tf_dict in doc_term_freqs.items():\n            if term in tf_dict:\n                tf = tf_dict[term]\n                tfidf = tf * idf[term]\n                posting_list.append((doc_id, tfidf))\n        posting_list.sort(key=lambda x: x[1], reverse=True)\n        ii_chunk[term] = posting_list\n    return ii_chunk\n\ndef _build_doc_vectors_worker(args):\n    doc_ids_chunk, doc_term_freqs, idf = args\n    vectors_chunk = {}\n    norms_chunk = {}\n    for doc_id in doc_ids_chunk:\n        tf_dict = doc_term_freqs[doc_id]\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n        vectors_chunk[doc_id] = doc_vector\n        norms_chunk[doc_id] = math.sqrt(norm_squared)\n    return vectors_chunk, norms_chunk\n\ndef build_tfidf_index_parallel(documents, num_workers=None, chunk_size=500):\n    start_time = time.perf_counter()\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n\n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n\n    # Step 1: Tokenize documents and compute TF\n    pool = multiprocessing.Pool(processes=num_workers)\n    chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]\n    tokenized_results = pool.map(_tokenize_docs_worker, chunks)\n\n    doc_term_freqs = {}\n    doc_terms_list = [] # List of sets for DF calculation\n    for chunk_res in tokenized_results:\n        for doc_id, tf in chunk_res:\n            doc_term_freqs[doc_id] = tf\n            doc_terms_list.append(set(tf.keys()))\n            index.vocabulary.update(tf.keys())\n\n    # Step 2: Calculate document frequencies\n    vocabulary_list = list(index.vocabulary)\n    vocab_chunk_size = max(1, len(vocabulary_list) // num_workers)\n    vocab_chunks = [vocabulary_list[i:i + vocab_chunk_size] for i in range(0, len(vocabulary_list), vocab_chunk_size)]\n    \n    df_results = pool.map(_calculate_df_worker, [(chunk, doc_terms_list) for chunk in vocab_chunks])\n    for df_chunk in df_results:\n        index.document_frequencies.update(df_chunk)\n\n    # Step 3: Compute IDF scores\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n\n    # Step 4: Build inverted index\n    ii_results = pool.map(_build_inverted_index_worker, [(chunk, doc_term_freqs, index.idf) for chunk in vocab_chunks])\n    for ii_chunk in ii_results:\n        index.inverted_index.update(ii_chunk)\n\n    # Step 5: Build document vectors and compute norms\n    doc_ids = list(doc_term_freqs.keys())\n    doc_chunk_size = max(1, len(doc_ids) // num_workers)\n    doc_id_chunks = [doc_ids[i:i + doc_chunk_size] for i in range(0, len(doc_ids), doc_chunk_size)]\n    \n    vector_results = pool.map(_build_doc_vectors_worker, [(chunk, doc_term_freqs, index.idf) for chunk in doc_id_chunks])\n    for vectors_chunk, norms_chunk in vector_results:\n        index.doc_vectors.update(vectors_chunk)\n        index.doc_norms.update(norms_chunk)\n\n    pool.close()\n    pool.join()\n\n    elapsed = time.perf_counter() - start_time\n    return ParallelIndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\n\ndef _search_worker(args):\n    from sequential import search_sequential\n    query, index, top_k, documents = args\n    return search_sequential(query, index, top_k, documents)\n\ndef batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\n    start_time = time.perf_counter()\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n    \n    pool = multiprocessing.Pool(processes=num_workers)\n    search_args = [(query, index, top_k, documents) for query in queries]\n    results = pool.map(_search_worker, search_args)\n    pool.close()\n    pool.join()\n    \n    elapsed = time.perf_counter() - start_time\n    return results, elapsed\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
