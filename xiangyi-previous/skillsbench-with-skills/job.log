Sending keys: ['python3 << \'EOF\'\nimport urllib.request\nimport ssl\nimport re\n\nssl_context = ssl.create_default_context()\nssl_context.check_hostname = False\nssl_context.verify_mode = ssl.CERT_NONE\n\n# Search the main GDP page for SUT links\nurl = "https://www.geostat.ge/en/modules/categories/23/gross-domestic-product-gdp"\n\ntry:\n    req = urllib.request.Request(url, headers={\n        \'User-Agent\': \'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36\',\n        \'Accept\': \'text/html\'\n    })\n    with urllib.request.urlopen(req, context=ssl_context, timeout=30) as response:\n        html = response.read().decode(\'utf-8\')\n        \n        # Save for inspection\n        with open(\'gdp_page.html\', \'w\') as f:\n            f.write(html)\n        \n        # Search for supply, use, SUT in the text\n        # Find all links and their surrounding text\n        all_links = re.findall(r\'<a[^>]*href=["\\\']([^"\\\']+)["\\\'][^>]*>([^<]*)</a>\', html, re.IGNORECASE)\n        \n        print("Links with text containing supply/use/SUT:")\n        for link, text in all_links:\n            if \'supply\' in text.lower() or \'use\' in text.lower() or \'sut\' in text.lower() or \'input\' in text.lower() or \'output\' in text.lower():\n                print(f"  {text}: {link}")\n        \n        # Also check for subcategory links\n        print("\\nAll category links:")\n        cat_links = re.findall(r\'href=["\\\']([^"\\\']*categories/\\d+[^"\\\']*)["\\\']\', html)\n        for link in set(cat_links):\n            print(f"  {link}")\nexcept Exception as e:\n    print(f"Error: {e}")\nEOF\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
