Sending keys: ['cat > classify_papers.py << \'EOF\'\nimport os\nimport subprocess\nimport shutil\nfrom pathlib import Path\n\n# Define keywords for each category\nkeywords = {\n    \'LLM\': [\'language model\', \'llm\', \'transformer\', \'bert\', \'gpt\', \'attention\', \'nlp\', \'natural language\', \'embedding\', \'token\', \'large language model\'],\n    \'trapped_ion_and_qc\': [\'trapped ion\', \'quantum computing\', \'qubit\', \'quantum\', \'ion trap\', \'phonon\', \'quantum circuit\', \'quantum gate\'],\n    \'black_hole\': [\'black hole\', \'schwarzschild\', \'einstein\', \'gravity\', \'general relativity\', \'spacetime\', \'horizon\', \'weyl\', \'gravitational\'],\n    \'DNA\': [\'dna\', \'gene\', \'protein\', \'sequence\', \'nucleotide\', \'helix\', \'molecular\', \'chromosome\', \'base pair\', \'genetic\'],\n    \'music_history\': [\'music\', \'composer\', \'symphony\', \'classical\', \'harmony\', \'melody\', \'musical\', \'concert\', \'philharmonic\']\n}\n\nsource_dir = \'papers/all\'\ntarget_dirs = {\n    \'LLM\': \'papers/LLM\',\n    \'trapped_ion_and_qc\': \'papers/trapped_ion_and_qc\',\n    \'black_hole\': \'papers/black_hole\',\n    \'DNA\': \'papers/DNA\',\n    \'music_history\': \'papers/music_history\'\n}\n\ndef extract_text_from_pdf(pdf_path):\n    """Extract text from PDF using pdftotext"""\n    try:\n        result = subprocess.run([\'pdftotext\', pdf_path, \'-\'], \n                              capture_output=True, text=True, timeout=10)\n        return result.stdout.lower()\n    except:\n        return ""\n\ndef classify_paper(pdf_path):\n    """Classify a paper based on keyword matching"""\n    text = extract_text_from_pdf(pdf_path)\n    \n    if not text:\n        return \'music_history\'  # Default category\n    \n    scores = {}\n    for category, kw_list in keywords.items():\n        score = sum(text.count(kw) for kw in kw_list)\n        scores[category] = score\n    \n    # Return category with highest score\n    best_category = max(scores, key=scores.get)\n    return best_category if scores[best_category] > 0 else \'music_history\'\n\ndef main():\n    # Get all PDF files\n    pdf_files = sorted([f for f in os.listdir(source_dir) if f.endswith(\'.pdf\')])\n    \n    print(f"Found {len(pdf_files)} PDF files")\n    \n    classified = {cat: [] for cat in target_dirs.keys()}\n    \n    for i, pdf_file in enumerate(pdf_files):\n        pdf_path = os.path.join(source_dir, pdf_file)\n        print(f"[{i+1}/{len(pdf_files)}] Classifying {pdf_file}...", end=\' \')\n        \n        category = classify_paper(pdf_path)\n        classified[category].append(pdf_file)\n        \n        # Move file to appropriate folder\n        target_path = os.path.join(target_dirs[category], pdf_file)\n        shutil.move(pdf_path, target_path)\n        print(f"-> {category}")\n    \n    # Print summary\n    print("\\n=== Classification Summary ===")\n    for category, files in classified.items():\n        print(f"{category}: {len(files)} files")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
