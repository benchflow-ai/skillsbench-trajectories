Sending keys: ['cat <<\'PY\' > /root/workspace/solution.py\nfrom __future__ import annotations\n\nfrom typing import Any, Dict\nimport re\nfrom fractions import Fraction\n\nfrom pymatgen.core import Structure\nfrom pymatgen.symmetry.analyzer import SpacegroupAnalyzer\n\n\ndef _float_to_rational_str(x: float, max_den: int = 12) -> str:\n    """Convert float to rational string with denominator <= max_den."""\n    # wrap into [0,1)\n    x = x % 1.0\n    if abs(x) < 1e-8:\n        return "0"\n    frac = Fraction(x).limit_denominator(max_den)\n    # If frac is 1 (e.g., x very close to 1), represent as 0\n    if frac.numerator == frac.denominator:\n        return "0"\n    if frac.denominator == 1:\n        return str(frac.numerator)\n    return f"{frac.numerator}/{frac.denominator}"\n\n\ndef analyze_wyckoff_position_multiplicities_and_coordinates(\n    filepath: str,\n) -> Dict[str, Dict] | Dict[str, Any]:\n    """\n    Analyze Wyckoff position multiplicities and calculate approximate coordinates\n    for the first atom of each Wyckoff position.\n    """\n    # Read structure from CIF\n    structure = Structure.from_file(filepath)\n    # Symmetry analysis to get Wyckoff positions\n    sga = SpacegroupAnalyzer(structure, symprec=1e-3)\n    symm_structure = sga.get_symmetrized_structure()\n\n    wyckoff_multiplicity_dict: Dict[str, int] = {}\n    wyckoff_coordinates_dict: Dict[str, list] = {}\n\n    for symbol, sites in zip(symm_structure.wyckoff_symbols, symm_structure.equivalent_sites):\n        m = re.match(r"(\\d+)([A-Za-z]+)", symbol)\n        if not m:\n            continue\n        multiplicity = int(m.group(1))\n        letter = m.group(2)\n        # store multiplicity\n        wyckoff_multiplicity_dict[letter] = multiplicity\n        # first site\'s fractional coordinates\n        coords = sites[0].frac_coords\n        wyckoff_coordinates_dict[letter] = [\n            _float_to_rational_str(float(c)) for c in coords\n        ]\n\n    return {\n        "wyckoff_multiplicity_dict": wyckoff_multiplicity_dict,\n        "wyckoff_coordinates_dict": wyckoff_coordinates_dict,\n    }\n\n\nif __name__ == "__main__":\n    # simple manual test\n    import sys, json\n    if len(sys.argv) > 1:\n        print(json.dumps(analyze_wyckoff_position_multiplicities_and_coordinates(sys.argv[1]), indent=2))\nPY\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
