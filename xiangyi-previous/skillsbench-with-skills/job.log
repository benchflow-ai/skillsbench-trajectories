Sending keys: ["python3 - <<'SCRIPT' >/tmp/opt.log 2>&1 && cat /tmp/opt.log && cat /root/pareto_frontier.csv\nimport pandas as pd, numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom itertools import product\nprint('Loading data...')\ncs=pd.read_csv('/root/data/citsci_train.csv')[['file_rad','x','y']]\nex=pd.read_csv('/root/data/expert_train.csv')[['file_rad','x','y']]\nim=ex.file_rad.unique()\nprint(f'{len(im)} images, {len(cs)} citsci, {len(ex)} expert')\nid={i:(cs[cs.file_rad==i][['x','y']].values,ex[ex.file_rad==i][['x','y']].values) for i in im}\ndef f(c,e,ms,ep,sw):\n if not len(c):return 0,np.nan\n n=len(c);D=np.zeros((n,n))\n for i in range(n):\n  for j in range(i+1,n):D[i,j]=D[j,i]=((sw*(c[i,0]-c[j,0]))**2+((2-sw)*(c[i,1]-c[j,1]))**2)**.5\n l=DBSCAN(eps=ep,min_samples=ms,metric='precomputed').fit_predict(D);u=set(l)-{-1}\n if not u:return 0,np.nan\n ct=np.array([c[l==x].mean(0) for x in u]);d=cdist(ct,e);mc,me,uc,ue=[],[],set(),set()\n while 1:\n  md=d.copy()\n  for i in uc:md[i,:]=1e9\n  for j in ue:md[:,j]=1e9\n  if md.min()>100:break\n  i,j=np.unravel_index(md.argmin(),md.shape);mc+=[i];me+=[j];uc.add(i);ue.add(j)\n nm=len(mc)\n if not nm:return 0,np.nan\n p,r=nm/len(ct),nm/len(e)\n return 2*p*r/(p+r),np.mean([((ct[i]-e[j])**2).sum()**.5 for i,j in zip(mc,me)])\nprint('Running grid search...')\nrs=[]\nfor k,(ms,ep,sw) in enumerate(list(product(range(3,10),range(4,26,2),[.9+i*.1 for i in range(11)]))):\n if k%100==0:print(f'{k}/847')\n f1s,dts=[],[]\n for i in im:f1,dt=f(*id[i],ms,ep,sw);f1s+=[f1];dts+=[dt]if not np.isnan(dt)else[]\n rs+=[(np.mean(f1s),np.mean([x for x in dts if not np.isnan(x)])if any(not np.isnan(x)for x in dts)else np.nan,ms,ep,round(sw,1))]\nprint(f'Total results: {len(rs)}')\nft=[x for x in rs if x[0]>.5 and not np.isnan(x[1])]\nprint(f'Filtered (F1>0.5): {len(ft)}')\nif ft:\n cs=np.array([[x[0],x[1]]for x in ft])\n pr=[x for i,x in enumerate(ft)if not any(i!=j and cs[j,0]>=cs[i,0]and cs[j,1]<=cs[i,1]and(cs[j,0]>cs[i,0]or cs[j,1]<cs[i,1])for j in range(len(ft)))]\n pr.sort(reverse=1)\n print(f'Pareto optimal: {len(pr)}')\n with open('/root/pareto_frontier.csv','w')as f:\n  f.write('F1,delta,min_samples,epsilon,shape_weight\\\\n')\n  for x in pr:f.write(f'{x[0]:.5f},{x[1]:.5f},{x[2]},{x[3]},{x[4]:.1f}\\\\n')\n print('Done!')\nelse:print('No results with F1>0.5')\nSCRIPT\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
