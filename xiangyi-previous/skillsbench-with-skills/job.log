Sending keys: ['cat > /root/process_taxonomy_v5.py << \'EOFV5\'\nimport pandas as pd\nfrom collections import defaultdict, Counter\nimport re\nfrom typing import Dict, List, Set, Tuple\n\ndef normalize_text(text: str) -> str:\n    """Normalize text."""\n    text = text.strip().lower()\n    text = re.sub(r\'[&/]\', \' and \', text)\n    text = re.sub(r\'[^a-z0-9\\s]\', \'\', text)\n    text = re.sub(r\'\\s+\', \' \', text)\n    return text\n\ndef load_categories():\n    """Load all categories."""\n    all_data = []\n    for source, filepath in [(\'amazon\', \'/root/data/amazon_product_categories.csv\'),\n                             (\'facebook\', \'/root/data/fb_product_categories.csv\'),\n                             (\'google\', \'/root/data/google_shopping_product_categories.csv\')]:\n        df = pd.read_csv(filepath)\n        for path in df[\'category_path\']:\n            parts = [p.strip() for p in path.split(\'>\')]\n            all_data.append({\'source\': source, \'path\': path, \'parts\': parts, \'depth\': len(parts)})\n    return all_data\n\ndef build_unified_taxonomy(all_data: List[Dict]):\n    """Build unified taxonomy by analyzing hierarchy."""\n    unified = {}\n    \n    # Level 1: Top level categories\n    level1_counter = Counter()\n    level1_names = {}\n    for entry in all_data:\n        norm = normalize_text(entry[\'parts\'][0])\n        level1_counter[norm] += 1\n        if norm not in level1_names:\n            level1_names[norm] = entry[\'parts\'][0]\n    \n    # Keep top 18\n    level1_list = {}\n    for norm, _ in level1_counter.most_common(18):\n        level1_list[norm] = level1_names[norm]\n    unified[1] = level1_list\n    \n    # For levels 2-5, build hierarchically\n    for level in range(2, 6):\n        level_children = defaultdict(Counter)\n        level_names = defaultdict(str)\n        \n        for entry in all_data:\n            if level <= len(entry[\'parts\']):\n                parent_norm = normalize_text(entry[\'parts\'][level - 2])\n                child_norm = normalize_text(entry[\'parts\'][level - 1])\n                child_orig = entry[\'parts\'][level - 1]\n                \n                level_children[parent_norm][child_norm] += 1\n                if not level_names[child_norm]:\n                    level_names[child_norm] = child_orig\n        \n        # Build level items\n        level_items = {}\n        for parent_norm, children in level_children.items():\n            for child_norm, count in children.most_common(10):\n                if child_norm not in level_items:\n                    level_items[child_norm] = (level_names[child_norm], count)\n        \n        # Keep top items\n        sorted_items = sorted(level_items.items(), key=lambda x: x[1][1], reverse=True)\n        top_n = min(len(sorted_items), max(40, 12 * (6 - level)))\n        \n        level_unified = {}\n        for norm, (name, _) in sorted_items[:top_n]:\n            level_unified[norm] = name\n        unified[level] = level_unified\n    \n    return unified\n\ndef map_category(entry: Dict, unified: Dict) -> Dict:\n    """Map category to unified taxonomy."""\n    result = {\'source\': entry[\'source\'], \'category_path\': entry[\'path\'], \'depth\': entry[\'depth\']}\n    \n    for level in range(1, 6):\n        if level <= len(entry[\'parts\']):\n            part = entry[\'parts\'][level - 1]\n            norm = normalize_text(part)\n            \n            if norm in unified[level]:\n                result[f\'unified_level_{level}\'] = unified[level][norm]\n            else:\n                # Find best match\n                best_match = None\n                best_score = 0\n                norm_words = set(norm.split())\n                \n                for unified_norm, unified_name in unified[level].items():\n                    unified_words = set(unified_norm.split())\n                    overlap = len(norm_words & unified_words)\n                    if overlap > best_score:\n                        best_score = overlap\n                        best_match = unified_name\n                \n                result[f\'unified_level_{level}\'] = best_match if best_match else list(unified[level].values())[0] if unified[level] else None\n        else:\n            result[f\'unified_level_{level}\'] = None\n    \n    return result\n\ndef main():\n    print("Loading categories...")\n    all_data = load_categories()\n    print(f"Loaded {len(all_data)} categories")\n    \n    print("Building unified taxonomy...")\n    unified = build_unified_taxonomy(all_data)\n    \n    print("Mapping categories...")\n    results = []\n    for i, entry in enumerate(all_data):\n        if (i + 1) % 2000 == 0:\n            print(f"  Processed {i + 1}/{len(all_data)}")\n        results.append(map_category(entry, unified))\n    \n    df = pd.DataFrame(results)\n    df.to_csv(\'/root/output/unified_taxonomy_full.csv\', index=False)\n    print(f"Saved {len(df)} mappings")\n    \n    print("\\nStatistics:")\n    for level in range(1, 6):\n        print(f"Level {level}: {df[f\'unified_level_{level}\'].nunique()} categories")\n    \n    print("Building hierarchy...")\n    hierarchy = []\n    seen = set()\n    for _, row in df.iterrows():\n        key = tuple(row[f\'unified_level_{i}\'] for i in range(1, 6))\n        if key not in seen:\n            seen.add(key)\n            hierarchy.append({f\'unified_level_{i}\': key[i-1] for i in range(1, 6)})\n    \n    pd.DataFrame(hierarchy).to_csv(\'/root/output/unified_taxonomy_hierarchy.csv\', index=False)\n    print(f"Saved {len(hierarchy)} hierarchy paths")\n    print("Done!")\n\nif __name__ == \'__main__\':\n    main()\nEOFV5\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
