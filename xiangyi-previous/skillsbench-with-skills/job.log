Sending keys: ['python3 << \'EOF\'\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\nprint("Task 5: jit_mlp - CORRECTED with ReLU")\nmlp_data = np.load(\'data/mlp.npz\')\nX = jnp.array(mlp_data[\'X\'])\nW1 = jnp.array(mlp_data[\'W1\'])\nb1 = jnp.array(mlp_data[\'b1\'])\nW2 = jnp.array(mlp_data[\'W2\'])\nb2 = jnp.array(mlp_data[\'b2\'])\n\ndef mlp_forward(X, W1, b1, W2, b2):\n    h = jnp.maximum(0, X @ W1 + b1)  # ReLU activation\n    output = h @ W2 + b2\n    return output\n\nresult = jax.jit(mlp_forward)(X, W1, b1, W2, b2)\nprint(f"MLP output shape: {result.shape}")\nprint(f"Output values:\\n{result}")\nnp.save(\'jit_mlp.npy\', np.array(result))\nprint(f"Saved to jit_mlp.npy")\n\n# Verify it matches reference\nref = np.load(\'reference/jit_mlp.npy\')\nif np.allclose(result, ref, rtol=1e-5, atol=1e-6):\n    print("\\n✓ PERFECT MATCH with reference!")\nelse:\n    print(f"\\nMax difference: {np.max(np.abs(result - ref))}")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
Sending keys: ['cat > js/visualization.js << \'EOF\'\n// Global variables\nlet stockData = [];\nlet selectedTicker = null;\n\n// Format market cap for display\nfunction formatMarketCap(value) {\n    if (!value || value === \'\' || isNaN(value)) return \'N/A\';\n    const num = parseFloat(value);\n    if (num >= 1e12) return (num / 1e12).toFixed(2) + \'T\';\n    if (num >= 1e9) return (num / 1e9).toFixed(2) + \'B\';\n    if (num >= 1e6) return (num / 1e6).toFixed(2) + \'M\';\n    return num.toFixed(2);\n}\n\n// Load and process data\nd3.csv(\'data/stock-descriptions.csv\').then(data => {\n    // Process the data\n    stockData = data.map(d => ({\n        ticker: d.ticker,\n        sector: d.sector || \'Unknown\',\n        fullName: d[\'full name\'] || d.ticker,\n        marketCap: parseFloat(d.marketCap) || null,\n        country: d.country,\n        website: d.website\n    }));\n\n    // Create visualizations\n    createBubbleChart();\n    createTable();\n});\n\nfunction createBubbleChart() {\n    const width = 800;\n    const height = 700;\n    \n    // Get unique sectors and create color scale\n    const sectors = [...new Set(stockData.map(d => d.sector))];\n    const colorScale = d3.scaleOrdinal()\n        .domain(sectors)\n        .range(d3.schemeTableau10);\n    \n    // Create SVG\n    const svg = d3.select(\'#bubble-chart\')\n        .append(\'svg\')\n        .attr(\'width\', width)\n        .attr(\'height\', height);\n    \n    // Calculate bubble sizes\n    const marketCaps = stockData.filter(d => d.marketCap).map(d => d.marketCap);\n    const minMarketCap = d3.min(marketCaps);\n    const maxMarketCap = d3.max(marketCaps);\n    \n    const radiusScale = d3.scaleSqrt()\n        .domain([minMarketCap, maxMarketCap])\n        .range([15, 50]);\n    \n    // Add radius to data\n    stockData.forEach(d => {\n        d.radius = d.marketCap ? radiusScale(d.marketCap) : 20; // ETFs get uniform size\n    });\n    \n    // Create sector positions for clustering\n    const sectorPositions = {};\n    const numSectors = sectors.length;\n    const cols = Math.ceil(Math.sqrt(numSectors));\n    sectors.forEach((sector, i) => {\n        const col = i % cols;\n        const row = Math.floor(i / cols);\n        sectorPositions[sector] = {\n            x: (col + 0.5) * (width / cols),\n            y: (row + 0.5) * (height / Math.ceil(numSectors / cols))\n        };\n    });\n    \n    // Create force simulation\n    const simulation = d3.forceSimulation(stockData)\n        .force(\'charge\', d3.forceManyBody().strength(5))\n        .force(\'x\', d3.forceX(d => sectorPositions[d.sector].x).strength(0.3))\n        .force(\'y\', d3.forceY(d => sectorPositions[d.sector].y).strength(0.3))\n        .force(\'collide\', d3.forceCollide(d => d.radius + 2))\n        .force(\'center\', d3.forceCenter(width / 2, height / 2).strength(0.05));\n    \n    // Create bubbles\n    const bubbles = svg.selectAll(\'.bubble\')\n        .data(stockData)\n        .enter()\n        .append(\'circle\')\n        .attr(\'class\', \'bubble\')\n        .attr(\'r\', d => d.radius)\n        .attr(\'fill\', d => colorScale(d.sector))\n        .attr(\'stroke\', \'#fff\')\n        .attr(\'stroke-width\', 1.5)\n        .on(\'mouseover\', function(event, d) {\n            // Only show tooltip for non-ETF stocks (those with marketCap)\n            if (d.marketCap) {\n                const tooltip = d3.select(\'#tooltip\');\n                tooltip.html(`\n                    <strong>${d.ticker}</strong><br/>\n                    ${d.fullName}<br/>\n                    Sector: ${d.sector}\n                `)\n                .style(\'left\', (event.pageX + 10) + \'px\')\n                .style(\'top\', (event.pageY - 10) + \'px\')\n                .classed(\'visible\', true);\n            }\n        })\n        .on(\'mouseout\', function() {\n            d3.select(\'#tooltip\').classed(\'visible\', false);\n        })\n        .on(\'click\', function(event, d) {\n            selectStock(d.ticker);\n        });\n    \n    // Add labels\n    const labels = svg.selectAll(\'.bubble-label\')\n        .data(stockData)\n        .enter()\n        .append(\'text\')\n        .attr(\'class\', \'bubble-label\')\n        .text(d => d.ticker)\n        .style(\'font-size\', d => Math.min(d.radius / 3, 12) + \'px\');\n    \n    // Update positions on simulation tick\n    simulation.on(\'tick\', () => {\n        bubbles\n            .attr(\'cx\', d => d.x)\n            .attr(\'cy\', d => d.y);\n        \n        labels\n            .attr(\'x\', d => d.x)\n            .attr(\'y\', d => d.y);\n    });\n    \n    // Create legend\n    const legend = d3.select(\'#legend\');\n    sectors.forEach(sector => {\n        const item = legend.append(\'div\')\n            .attr(\'class\', \'legend-item\');\n        \n        item.append(\'div\')\n            .attr(\'class\', \'legend-color\')\n            .style(\'background-color\', colorScale(sector));\n        \n        item.append(\'span\')\n            .text(sector);\n    });\n}\n\nfunction createTable() {\n    const table = d3.select(\'#stock-table\')\n        .append(\'table\');\n    \n    // Create header\n    const thead = table.append(\'thead\');\n    thead.append(\'tr\')\n        .selectAll(\'th\')\n        .data([\'Ticker Symbol\', \'Full Company Name\', \'Sector\', \'Market Cap\'])\n        .enter()\n        .append(\'th\')\n        .text(d => d);\n    \n    // Create body\n    const tbody = table.append(\'tbody\');\n    const rows = tbody.selectAll(\'tr\')\n        .data(stockData)\n        .enter()\n        .append(\'tr\')\n        .attr(\'data-ticker\', d => d.ticker)\n        .on(\'click\', function(event, d) {\n            selectStock(d.ticker);\n        });\n    \n    rows.selectAll(\'td\')\n        .data(d => [\n            d.ticker,\n            d.fullName,\n            d.sector,\n            formatMarketCap(d.marketCap)\n        ])\n        .enter()\n        .append(\'td\')\n        .text(d => d);\n}\n\nfunction selectStock(ticker) {\n    selectedTicker = ticker;\n    \n    // Highlight bubble\n    d3.selectAll(\'.bubble\')\n        .attr(\'stroke\', d => d.ticker === ticker ? \'#ff6b6b\' : \'#fff\')\n        .attr(\'stroke-width\', d => d.ticker === ticker ? 3 : 1.5);\n    \n    // Highlight table row\n    d3.selectAll(\'#stock-table tbody tr\')\n        .classed(\'highlighted\', function() {\n            return d3.select(this).attr(\'data-ticker\') === ticker;\n        });\n    \n    // Scroll to highlighted row\n    const highlightedRow = d3.select(`#stock-table tbody tr[data-ticker="${ticker}"]`).node();\n    if (highlightedRow) {\n        highlightedRow.scrollIntoView({ behavior: \'smooth\', block: \'center\' });\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
