Sending keys: ['cat >> control_system_v2.py << \'EOF\'\n    \n    def estimate_parameters(self):\n        print(f"\\n=== PARAMETER ESTIMATION ===")\n        times = np.array([d["time"] for d in self.calibration_data])\n        temps = np.array([d["temperature"] for d in self.calibration_data])\n        heater_power = self.calibration_data[0]["heater_power"]\n        T_ambient = self.sim.get_ambient_temp()\n        T_initial = temps[0]\n        T_final = temps[-1]\n        delta_T = T_final - T_initial\n        u_norm = heater_power / 100.0\n        K_est = delta_T / u_norm\n        print(f"Initial T: {T_initial:.2f}C, Final T: {T_final:.2f}C, Delta T: {delta_T:.2f}C")\n        print(f"Heater power: {heater_power}%, Normalized u: {u_norm}")\n        print(f"Estimated K (from rise): {K_est:.6f}")\n        T_ss = T_ambient + K_est * u_norm\n        print(f"Predicted steady-state T: {T_ss:.2f}C")\n        def first_order_response(t, tau):\n            return T_initial + (T_ss - T_initial) * (1.0 - np.exp(-t / tau))\n        try:\n            popt, pcov = curve_fit(first_order_response, times, temps, p0=[40.0], maxfev=10000)\n            tau_est = popt[0]\n            y_pred = first_order_response(times, tau_est)\n            ss_res = np.sum((temps - y_pred) ** 2)\n            ss_tot = np.sum((temps - np.mean(temps)) ** 2)\n            r_squared = 1.0 - (ss_res / ss_tot) if ss_tot > 0 else 0.0\n            fitting_error = np.sqrt(ss_res / len(temps))\n            self.estimated_params = {"K": round(K_est, 6), "tau": round(tau_est, 2), "r_squared": round(r_squared, 4), "fitting_error": round(fitting_error, 4)}\n            print(f"Estimated tau: {tau_est:.2f}s, R²: {r_squared:.4f}")\n        except Exception as e:\n            print(f"Fitting error: {e}")\n            self.estimated_params = {"K": round(K_est, 6), "tau": 40.0, "r_squared": 0.0, "fitting_error": 0.0}\n        with open("estimated_params.json", "w") as f:\n            json.dump(self.estimated_params, f, indent=2)\n        print("Saved estimated_params.json")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
