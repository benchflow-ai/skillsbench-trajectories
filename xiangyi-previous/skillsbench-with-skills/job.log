Sending keys: ['cat << \'EOF\' > /root/workspace/test_solution.py\nimport time\nimport sys\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential, generate_corpus\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\ndef main():\n    num_docs = 2000\n    num_queries = 20\n    num_workers = 4\n\n    print(f"Generating {num_docs} documents...")\n    documents = generate_corpus(num_docs, seed=42)\n    \n    queries = ["machine learning algorithm", "distributed systems architecture", "data science research"] * 7\n    queries = queries[:num_queries]\n\n    print("\\n--- Sequential Version ---")\n    start_seq_idx = time.perf_counter()\n    seq_result = build_tfidf_index_sequential(documents)\n    seq_idx_time = seq_result.elapsed_time\n    print(f"Indexing time: {seq_idx_time:.4f}s")\n\n    start_seq_search = time.perf_counter()\n    seq_search_results = batch_search_sequential(queries, seq_result.index, documents=documents)\n    seq_search_time = time.perf_counter() - start_seq_search\n    print(f"Search time: {seq_search_time:.4f}s")\n\n    print("\\n--- Parallel Version ---")\n    par_result = build_tfidf_index_parallel(documents, num_workers=num_workers)\n    par_idx_time = par_result.elapsed_time\n    print(f"Indexing time: {par_idx_time:.4f}s")\n\n    par_search_results, par_search_time = batch_search_parallel(queries, par_result.index, num_workers=num_workers, documents=documents)\n    print(f"Search time: {par_search_time:.4f}s")\n\n    print("\\n--- Comparison ---")\n    idx_speedup = seq_idx_time / par_idx_time\n    search_speedup = seq_search_time / par_search_time\n    print(f"Indexing Speedup: {idx_speedup:.2f}x")\n    print(f"Search Speedup: {search_speedup:.2f}x")\n\n    # Correctness check\n    correct = True\n    if len(seq_search_results) != len(par_search_results):\n        correct = False\n    else:\n        for s_res, p_res in zip(seq_search_results, par_search_results):\n            if len(s_res) != len(p_res):\n                correct = False\n                break\n            for sr, pr in zip(s_res, p_res):\n                if sr.doc_id != pr.doc_id or abs(sr.score - pr.score) > 1e-9:\n                    correct = False\n                    break\n            if not correct: break\n\n    print(f"Results Correct: {correct}")\n\n    if not correct:\n        sys.exit(1)\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
