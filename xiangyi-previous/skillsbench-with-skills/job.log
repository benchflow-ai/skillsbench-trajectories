Y %): {round(d7_yoy, 2)}")\n\n# B9 (2021 Science % change) = (B10 - B9) / B9 * 100\n# where B9 is 2020 Science from Budget sheet\nb9_2020 = ws1[\'B9\'].value  # Just calculated\nb10_2021 = ws1[\'B10\'].value  # 7301\nb9_yoy = ((b10_2021 - b9_2020) / b9_2020) * 100\nws2[\'B9\'].value = round(b9_yoy, 2)\nprint(f"B9 (2021 Science YoY %): {round(b9_yoy, 2)}")\n\n# F9 (2021 Space Operations % change) = (F10 - F9) / F9 * 100\n# where F9 is 2020 Space Operations from Budget sheet\nf9_2020 = ws1[\'F9\'].value  # 3989\nf10_2021 = ws1[\'F10\'].value  # 3986\nf9_yoy = ((f10_2021 - f9_2020) / f9_2020) * 100\nws2[\'F9\'].value = round(f9_yoy, 2)\nprint(f"F9 (2021 Space Ops YoY %): {round(f9_yoy, 2)}")\n\nprint("\\nSheet 2 (YoY Changes) - COMPLETE")\n\n# Sheet 3: Directorate Shares (%)\nws3 = wb[\'Directorate Shares (%)\']\n\n# F5 (2016 Space Operations share) = (F5_budget / K5_budget) * 100\nf5_budget = ws1[\'F5\'].value  # 5029\nk5_budget = ws1[\'K5\'].value  # Just calculated\nf5_share = (f5_budget / k5_budget) * 100\nws3[\'F5\'].value = round(f5_share, 2)\nprint(f"F5 (2016 Space Ops share %): {round(f5_share, 2)}")\n\n# B10 (2021 Science share) = (B10_budget / K10_budget) * 100\nb10_budget = ws1[\'B10\'].value  # 7301\nk10_budget = ws1[\'K10\'].value  # Just calculated\nb10_share = (b10_budget / k10_budget) * 100\nws3[\'B10\'].value = round(b10_share, 2)\nprint(f"B10 (2021 Science share %): {round(b10_share, 2)}")\n\nprint("\\nSheet 3 (Directorate Shares) - COMPLETE")\n\n# Sheet 4: Growth Analysis\nws4 = wb[\'Growth Analysis\']\n\n# E5 (FY2019 Exploration Budget) - from Budget sheet\ne5_value = ws1[\'E8\'].value  # 5047 (2019 Exploration)\nws4[\'E5\'].value = e5_value\nprint(f"E5 (FY2019 Exploration): {e5_value}")\n\n# E4 (Exploration CAGR) = ((FY2024 / FY2019) ^ (1/5) - 1) * 100\ne6_value = ws1[\'E13\'].value  # 7618 (2024 Exploration)\ncagr_e = (((e6_value / e5_value) ** (1/5)) - 1) * 100\nws4[\'E4\'].value = round(cagr_e, 2)\nprint(f"E4 (Exploration CAGR %): {round(cagr_e, 2)}")\n\n# B7 (Science 5-Year Change) = FY2024 - FY2019\nb6_value = ws1[\'B13\'].value  # 8440 (2024 Science)\nb5_value = ws1[\'B8\'].value  # 6906 (2019 Science)\nb7_value = b6_value - b5_value\nws4[\'B7\'].value = b7_value\nprint(f"B7 (Science 5-Year Change): {b7_value}")\n\n# B8 (Science Avg Annual Budget) = average of B5:B10 from Budget sheet (2019-2024)\nscience_values = [ws1[f\'B{row}\'].value for row in range(8, 14)]  # rows 8-13 (2019-2024)\nb8_value = sum(science_values) / len(science_values)\nws4[\'B8\'].value = round(b8_value, 1)\nprint(f"B8 (Science Avg Annual Budget): {round(b8_value, 1)}")\n\nprint("\\nSheet 4 (Growth Analysis) - COMPLETE")\n\n# Save the workbook\nwb.save(\'nasa_budget_recovered.xlsx\')\nprint("\\n=== File saved as nasa_budget_recovered.xlsx ===")\n\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
