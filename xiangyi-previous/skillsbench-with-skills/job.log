Sending keys: ['cat >> analysis.py << \'ENDOFFILE\'\n\n# Step 3: Feature Engineering on Demographics\nprint("\\nStep 3: Feature engineering on demographic data...")\n\nsurvey_fe = survey.copy()\n\n# Create engineered features from survey data\nfeature_cols = []\n\ndef clean_column_name(text):\n    """Clean text for use in column names"""\n    import re\n    text = str(text)\n    text = re.sub(r\'[^a-zA-Z0-9_]\', \'_\', text)\n    text = re.sub(r\'_+\', \'_\', text)\n    text = text.strip(\'_\')\n    return text\n\n# Age groups\nfor age_group in survey_fe[\'Q-demos-age\'].dropna().unique():\n    col_name = \'age_\' + clean_column_name(age_group)\n    survey_fe[col_name] = (survey_fe[\'Q-demos-age\'] == age_group).astype(int)\n    feature_cols.append(col_name)\n\n# Hispanic\nfor val in survey_fe[\'Q-demos-hispanic\'].dropna().unique():\n    col_name = \'hispanic_\' + clean_column_name(val)\n    survey_fe[col_name] = (survey_fe[\'Q-demos-hispanic\'] == val).astype(int)\n    feature_cols.append(col_name)\n\n# Race\nfor race in survey_fe[\'Q-demos-race\'].dropna().unique():\n    col_name = \'race_\' + clean_column_name(race)\n    survey_fe[col_name] = (survey_fe[\'Q-demos-race\'] == race).astype(int)\n    feature_cols.append(col_name)\n\n# Education\nfor edu in survey_fe[\'Q-demos-education\'].dropna().unique():\n    col_name = \'education_\' + clean_column_name(edu)\n    survey_fe[col_name] = (survey_fe[\'Q-demos-education\'] == edu).astype(int)\n    feature_cols.append(col_name)\n\n# Income\nfor inc in survey_fe[\'Q-demos-income\'].dropna().unique():\n    col_name = \'income_\' + clean_column_name(inc)\n    survey_fe[col_name] = (survey_fe[\'Q-demos-income\'] == inc).astype(int)\n    feature_cols.append(col_name)\n\n# Gender\nfor gender in survey_fe[\'Q-demos-gender\'].dropna().unique():\n    col_name = \'gender_\' + clean_column_name(gender)\n    survey_fe[col_name] = (survey_fe[\'Q-demos-gender\'] == gender).astype(int)\n    feature_cols.append(col_name)\n\n# Sexual orientation\nfor orient in survey_fe[\'Q-sexual-orientation\'].dropna().unique():\n    col_name = \'orientation_\' + clean_column_name(orient)\n    survey_fe[col_name] = (survey_fe[\'Q-sexual-orientation\'] == orient).astype(int)\n    feature_cols.append(col_name)\n\n# State\nfor state in survey_fe[\'Q-demos-state\'].dropna().unique():\n    col_name = \'state_\' + clean_column_name(state)\n    survey_fe[col_name] = (survey_fe[\'Q-demos-state\'] == state).astype(int)\n    feature_cols.append(col_name)\n\n# Household size\nfor hh_size in survey_fe[\'Q-amazon-use-howmany\'].dropna().unique():\n    col_name = \'hh_size_\' + clean_column_name(hh_size)\n    survey_fe[col_name] = (survey_fe[\'Q-amazon-use-howmany\'] == hh_size).astype(int)\n    feature_cols.append(col_name)\n\n# Household members\nfor hh_mem in survey_fe[\'Q-amazon-use-hh-size\'].dropna().unique():\n    col_name = \'hh_members_\' + clean_column_name(hh_mem)\n    survey_fe[col_name] = (survey_fe[\'Q-amazon-use-hh-size\'] == hh_mem).astype(int)\n    feature_cols.append(col_name)\n\n# Purchase frequency\nfor freq in survey_fe[\'Q-amazon-use-how-oft\'].dropna().unique():\n    col_name = \'purchase_freq_\' + clean_column_name(freq)\n    survey_fe[col_name] = (survey_fe[\'Q-amazon-use-how-oft\'] == freq).astype(int)\n    feature_cols.append(col_name)\n\n# Substance use and health\nfor col in [\'Q-substance-use-cigarettes\', \'Q-substance-use-marijuana\', \'Q-substance-use-alcohol\', \n            \'Q-personal-diabetes\', \'Q-personal-wheelchair\']:\n    for val in survey_fe[col].dropna().unique():\n        col_name = col.replace(\'Q-\', \'\').replace(\'-\', \'_\') + \'_\' + clean_column_name(val)\n        survey_fe[col_name] = (survey_fe[col] == val).astype(int)\n        feature_cols.append(col_name)\n\n# Save feature engineered survey\nsurvey_fe_output = survey_fe[[\'Survey ResponseID\'] + feature_cols]\nsurvey_fe_output.to_csv(\'/app/output/survey_feature_engineered.csv\', index=False)\nprint(f"Feature engineering complete. {len(feature_cols)} features created.")\nENDOFFILE\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
