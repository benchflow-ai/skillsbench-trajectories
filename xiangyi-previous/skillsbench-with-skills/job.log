Sending keys: ['cat << \'EOF\' > check_folded.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt(\'/root/data/tess_lc.txt\')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\ndef check_p(p, wl_days):\n    flat = lc.flatten(window_length=int(wl_days/cadence)|1)\n    folded = flat.fold(period=p)\n    # Calculate SNR of the folded transit\n    # Use a simple depth/std approach\n    in_transit = np.abs(folded.time.value) < 0.05 # assume 0.1 day duration\n    depth = 1.0 - np.median(folded.flux[in_transit])\n    std = np.std(folded.flux[~in_transit])\n    snr = depth / (std / np.sqrt(np.sum(in_transit)))\n    return snr, depth\n\nfor p in [7.76599, 1.39582, 0.54648, 6.58052]:\n    snr, depth = check_p(p, 0.5)\n    print(f"Period {p:.5f}: SNR {snr:.2f}, Depth {depth:.5f}")\n\nEOF\npython3 check_folded.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
