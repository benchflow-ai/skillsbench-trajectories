Sending keys: ['python3 << \'ENDOFPYTHON\'\nimport json\nimport csv\nfrom copy import deepcopy\nimport itertools\n\n# Read all input files\nwith open(\'/app/data/instance.txt\', \'r\') as f:\n    lines = [l.strip() for l in f.readlines() if l.strip()]\n\nnum_jobs, num_ops_per_job = map(int, lines[0].split())\njobs = []\nidx = 1\nfor j in range(num_jobs):\n    num_ops = int(lines[idx])\n    idx += 1\n    ops = []\n    for o in range(num_ops):\n        parts = list(map(int, lines[idx].split()))\n        num_options = parts[0]\n        options = []\n        for i in range(num_options):\n            machine = parts[1 + i*2]\n            duration = parts[2 + i*2]\n            options.append({\'machine\': machine, \'duration\': duration})\n        ops.append(options)\n        idx += 1\n    jobs.append(ops)\n\nwith open(\'/app/data/downtime.csv\', \'r\') as f:\n    reader = csv.DictReader(f)\n    downtimes = [{\'machine\': int(row[\'machine\']), \'start\': int(row[\'start\']), \'end\': int(row[\'end\'])} for row in reader]\n\nwith open(\'/app/data/policy.json\', \'r\') as f:\n    policy = json.load(f)\n\nwith open(\'/app/data/baseline_solution.json\', \'r\') as f:\n    baseline = json.load(f)\n\nfreeze_until = policy[\'freeze\'][\'freeze_until\']\nmax_machine_changes = policy[\'change_budget\'][\'max_machine_changes\']\nmax_start_shift = policy[\'change_budget\'][\'max_total_start_shift_L1\']\nmax_makespan_ratio = policy[\'guards\'][\'max_makespan_ratio\']\n\ndef overlaps_downtime(machine, start, end, downtimes):\n    for dt in downtimes:\n        if dt[\'machine\'] == machine:\n            if not (end <= dt[\'start\'] or start >= dt[\'end\']):\n                return True\n    return False\n\ndef get_machine_end_time(schedule, machine):\n    max_end = 0\n    for op in schedule:\n        if op[\'machine\'] == machine and op[\'end\'] > max_end:\n            max_end = op[\'end\']\n    return max_end\n\ndef get_job_op_end(schedule, job, op):\n    for item in schedule:\n        if item[\'job\'] == job and item[\'op\'] == op:\n            return item[\'end\']\n    return 0\n\ndef find_earliest_valid_start(machine, duration, earliest_start, schedule, downtimes):\n    machine_available = get_machine_end_time(schedule, machine)\n    candidate_start = max(earliest_start, machine_available)\n    \n    max_iterations = 100\n    for _ in range(max_iterations):\n        candidate_end = candidate_start + duration\n        if not overlaps_downtime(machine, candidate_start, candidate_end, downtimes):\n            return candidate_start\n        \n        for dt in downtimes:\n            if dt[\'machine\'] == machine:\n                if not (candidate_end <= dt[\'start\'] or candidate_start >= dt[\'end\']):\n                    candidate_start = max(candidate_start, dt[\'end\'])\n                    machine_available = get_machine_end_time(schedule, machine)\n                    candidate_start = max(candidate_start, machine_available)\n                    break\n    \n    return candidate_start\n\n# Identify which operations need rescheduling\nbaseline_dict = {(op[\'job\'], op[\'op\']): op for op in baseline[\'schedule\']}\nops_to_change = []\n\nfor job in range(num_jobs):\n    for op in range(num_ops_per_job):\n        baseline_op = baseline_dict[(job, op)]\n        is_frozen = baseline_op[\'start\'] < freeze_until\n        violates = overlaps_downtime(baseline_op[\'machine\'], baseline_op[\'start\'], baseline_op[\'end\'], downtimes)\n        \n        if not (is_frozen and not violates):\n            ops_to_change.append((job, op))\n\nprint(f"Operations that can be changed: {len(ops_to_change)}")\nprint(f"Operations: {ops_to_change}")\n\n# For Job 2 Op 0 which is frozen but violates, we MUST change the machine\n# Let me try a specific strategy\nnew_schedule = []\nmachine_changes = 0\ntotal_start_shift = 0\n\nfor job in range(num_jobs):\n    for op in range(num_ops_per_job):\n        baseline_op = baseline_dict[(job, op)]\n        \n        if op == 0:\n            earliest_start = 0\n        else:\n            earliest_start = get_job_op_end(new_schedule, job, op - 1)\n        \n        is_frozen = baseline_op[\'start\'] < freeze_until\n        violates = overlaps_downtime(baseline_op[\'machine\'], baseline_op[\'start\'], baseline_op[\'end\'], downtimes)\n        \n        if is_frozen and not violates:\n            new_schedule.append(deepcopy(baseline_op))\n        else:\n            # Strategy: prefer same machine if possible, otherwise pick shortest duration alternative\n            options_with_times = []\n            \n            for opt in jobs[job][op]:\n                machine = opt[\'machine\']\n                duration = opt[\'duration\']\n                start = find_earliest_valid_start(machine, duration, earliest_start, new_schedule, downtimes)\n                \n                machine_changed = (machine != baseline_op[\'machine\'])\n                start_shift = abs(start - baseline_op[\'start\'])\n                \n                # Can we afford this machine change?\n                if machine_changed and machine_changes >= max_machine_changes:\n                    continue\n                \n                options_with_times.append({\n                    \'machine\': machine,\n                    \'duration\': duration,\n                    \'start\': start,\n                    \'end\': start + duration,\n                    \'machine_changed\': machine_changed,\n                    \'start_shift\': start_shift\n                })\n            \n            # Sort by: 1) same machine first, 2) earliest end time\n            options_with_times.sort(key=lambda x: (x[\'machine_changed\'], x[\'end\'], x[\'start_shift\']))\n            \n            if options_with_times:\n                chosen = options_with_times[0]\n                \n                if chosen[\'machine_changed\']:\n                    machine_changes += 1\n                total_start_shift += chosen[\'start_shift\']\n                \n                new_op = {\n                    \'job\': job,\n                    \'op\': op,\n                    \'machine\': chosen[\'machine\'],\n                    \'start\': chosen[\'start\'],\n                    \'end\': chosen[\'end\'],\n                    \'dur\': chosen[\'duration\']\n                }\n                new_schedule.append(new_op)\n                \n                if chosen[\'machine_changed\'] or chosen[\'start_shift\'] > 0:\n                    print(f"Job {job} Op {op}: M{chosen[\'machine\']} [{chosen[\'start\']}-{chosen[\'end\']}] (was M{baseline_op[\'machine\']} [{baseline_op[\'start\']}-{baseline_op[\'end\']}]) - MC:{chosen[\'machine_changed\']}, shift:{chosen[\'start_shift\']}")\n\nmakespan = max(op[\'end\'] for op in new_schedule)\nviolations = sum(1 for op in new_schedule if overlaps_downtime(op[\'machine\'], op[\'start\'], op[\'end\'], downtimes))\n\nprint(f"\\nMakespan: {makespan} (max: {int(36 * max_makespan_ratio)})")\nprint(f"Machine changes: {machine_changes} (max: {max_machine_changes})")\nprint(f"Total start shift: {total_start_shift} (max: {max_start_shift})")\nprint(f"Downtime violations: {violations}")\n\nif violations == 0 and machine_changes <= max_machine_changes and total_start_shift <= max_start_shift and makespan <= int(36 * max_makespan_ratio):\n    print("\\nSolution is FEASIBLE!")\n    \n    solution = {\n        \'status\': \'feasible\',\n        \'makespan\': makespan,\n        \'schedule\': sorted(new_schedule, key=lambda x: (x[\'start\'], x[\'job\'], x[\'op\']))\n    }\n    \n    with open(\'/app/output/solution.json\', \'w\') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open(\'/app/output/schedule.csv\', \'w\', newline=\'\') as f:\n        writer = csv.DictWriter(f, fieldnames=[\'job\', \'op\', \'machine\', \'start\', \'end\', \'dur\'])\n        writer.writeheader()\n        for op in solution[\'schedule\']:\n            writer.writerow(op)\n    \n    print("Solution saved!")\nelse:\n    print("\\nNeed better strategy...")\n\nENDOFPYTHON\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
