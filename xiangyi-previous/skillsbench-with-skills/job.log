ateTime(pick_time)\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'P\',\n            \'time\': pick_time,\n            \'trace_id\': trace_id\n        })\n\nfor pick in s_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split(\'.\')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'S\',\n            \'time\': pick_time,\n            \'trace_id\': trace_id\n        })\n\nprint(f"Total picks: {len(all_picks)}")\n\n# Group picks by station and phase\npicks_by_station = defaultdict(lambda: {\'P\': [], \'S\': []})\nfor pick in all_picks:\n    key = f"{pick[\'network\']}.{pick[\'station\']}"\n    picks_by_station[key][pick[\'phase\']].append(pick[\'time\'])\n\nprint(f"Picks organized at {len(picks_by_station)} stations")\n\n# Get all unique P times (potential event times)\nall_p_times = set()\nfor station, phases in picks_by_station.items():\n    for p_time in phases[\'P\']:\n        all_p_times.add(p_time)\n\nall_p_times = sorted(list(all_p_times))\nprint(f"Found {len(all_p_times)} unique P arrival times")\n\n# For each P time, try to find an event\nevents = []\n\nfor p_time in all_p_times:\n    # For this potential event time, find all picks that could belong to it\n    event_picks = {\'P\': {}, \'S\': {}}\n    \n    for station, phases in picks_by_station.items():\n        # Find P pick close to p_time\n        for p in phases[\'P\']:\n            if abs(float(p - p_time)) < 0.5:  # Within 0.5 seconds\n                event_picks[\'P\'][station] = p\n                break\n        \n        # Find S pick after the P pick\n        if station in event_picks[\'P\']:\n            p_pick = event_picks[\'P\'][station]\n            for s in phases[\'S\']:\n                if s > p_pick and abs(float(s - p_pick) - 3.0) < 1.5:  # Expected P-S around 3s\n                    event_picks[\'S\'][station] = s\n                    break\n    \n    # Only keep events with picks at multiple stations\n    num_stations = len(event_picks[\'P\'])\n    if num_stations >= 3:  # At least 3 stations\n        events.append({\n            \'time\': p_time,\n            \'num_stations\': num_stations,\n            \'picks\': event_picks\n        })\n\nprint(f"\\nFound {len(events)} potential events")\nprint("Sample events:")\nfor event in events[:5]:\n    print(f"  Time: {event[\'time\']}, Stations: {event[\'num_stations\']}")\n\nEOFPYTHON\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
