ot/segments.srt"\ninput_video = "/root/input.mp4"\noutput_audio = "/outputs/tts_segments/seg_0.wav"\noutput_video = "/outputs/dubbed.mp4"\nreport_path = "/outputs/report.json"\n\ntarget_text = parse_srt_text(target_text_path)\nsource_text = parse_srt_text(source_text_path)\nsegments = parse_segments(segments_path)\nseg_start, seg_end = segments[0]\ntarget_duration = seg_end - seg_start\n\nsubprocess.run(["edge-tts", "--voice", "ja-JP-NanamiNeural", "--text", target_text, "--write-media", "raw_tts.mp3"], check=True)\n\nraw_duration = get_duration("raw_tts.mp3")\nspeed_rate = raw_duration / target_duration\n\nfilter_complex = f"atempo={speed_rate},loudnorm=I=-23:LRA=7:tp=-1.0,aresample=48000"\ncmd_ffmpeg = ["ffmpeg", "-y", "-i", "raw_tts.mp3", "-af", filter_complex, "-ac", "1", output_audio]\nsubprocess.run(cmd_ffmpeg, check=True)\n\nfinal_duration = get_duration(output_audio)\nmeasured_lufs = get_lufs(output_audio)\n\ncmd_dub = ["ffmpeg", "-y", "-i", input_video, "-i", output_audio, "-c:v", "copy", "-c:a", "aac", "-map", "0:v:0", "-map", "1:a:0", "-shortest", output_video]\nsubprocess.run(cmd_dub, check=True)\n\nvideo_duration = get_duration(input_video)\nnew_video_duration = get_duration(output_video)\n\nreport = {\n  "source_language": "en",\n  "target_language": "ja",\n  "audio_sample_rate_hz": 48000,\n  "audio_channels": 1,\n  "original_duration_sec": video_duration,\n  "new_duration_sec": new_video_duration,\n  "measured_lufs": measured_lufs,\n  "speech_segments": [\n    {\n      "window_start_sec": seg_start,\n      "window_end_sec": seg_end,\n      "placed_start_sec": seg_start,\n      "placed_end_sec": seg_start + final_duration,\n      "source_text": source_text,\n      "target_text": target_text,\n      "window_duration_sec": target_duration,\n      "tts_duration_sec": final_duration,\n      "drift_sec": abs((seg_start + final_duration) - seg_end),\n      "duration_control": "rate_adjust"\n    }\n  ]\n}\n\nwith open(report_path, "w") as f:\n    json.dump(re