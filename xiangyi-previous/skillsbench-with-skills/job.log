Sending keys: ['cat > parallel_solution.py << \'EOF\'\n#!/usr/bin/env python3\n"""\nParallel TF-IDF Implementation\n\nThis module provides parallel implementations of:\n1. TF-IDF index building using multiprocessing\n2. Batch similarity search using multiprocessing\n"""\n\nimport math\nimport multiprocessing as mp\nimport time\nfrom collections import defaultdict\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Tuple\n\nfrom sequential import (\n    SearchResult,\n    TFIDFIndex,\n    compute_term_frequencies,\n    tokenize,\n)\n\n\n@dataclass\nclass ParallelIndexingResult:\n    """Result from parallel index building."""\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\n# ============================================================================\n# Parallel Index Building\n# ============================================================================\n\ndef _process_document_chunk(args):\n    """\n    Process a chunk of documents to extract term frequencies.\n    \n    Args:\n        args: Tuple of (documents_chunk, start_idx)\n    \n    Returns:\n        Tuple of (doc_tfs, doc_tokens_list, chunk_vocab)\n        - doc_tfs: dict mapping doc_id to term frequencies\n        - doc_tokens_list: list of (doc_id, tokens)\n        - chunk_vocab: set of unique terms in this chunk\n    """\n    documents_chunk, start_idx = args\n    \n    doc_tfs = {}\n    doc_tokens_list = []\n    chunk_vocab = set()\n    \n    for i, doc in enumerate(documents_chunk):\n        doc_id = start_idx + i\n        tokens = tokenize(doc.content)\n        doc_tokens_list.append((doc_id, tokens))\n        \n        if tokens:\n            tf = compute_term_frequencies(tokens)\n            doc_tfs[doc_id] = tf\n            chunk_vocab.update(tf.keys())\n    \n    return doc_tfs, doc_tokens_list, chunk_vocab\n\n\ndef _compute_document_frequencies(doc_tfs_list):\n    """\n    Compute document frequencies from partial results.\n    \n    Args:\n        doc_tfs_list: List of doc_tfs dictionaries from workers\n    \n    Returns:\n        Dictionary mapping terms to document frequencies\n    """\n    df = defaultdict(int)\n    \n    for doc_tfs in doc_tfs_list:\n        for doc_id, term_freqs in doc_tfs.items():\n            for term in term_freqs:\n                df[term] += 1\n    \n    return dict(df)\n\n\ndef build_tfidf_index_parallel(\n    documents,\n    num_workers: Optional[int] = None,\n    chunk_size: int = 500\n) -> ParallelIndexingResult:\n    """\n    Build TF-IDF index in parallel.\n    \n    Args:\n        documents: List of Document objects\n        num_workers: Number of worker processes (default: CPU count)\n        chunk_size: Number of documents per chunk\n    \n    Returns:\n        ParallelIndexingResult with TFIDFIndex and timing info\n    """\n    start_time = time.perf_counter()\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    num_docs = len(documents)\n    \n    # Split documents into chunks\n    chunks = []\n    for i in range(0, num_docs, chunk_size):\n        chunk = documents[i:i + chunk_size]\n        chunks.append((chunk, i))\n    \n    # Process chunks in parallel\n    with mp.Pool(processes=num_workers) as pool:\n        results = pool.map(_process_document_chunk, chunks)\n    \n    # Merge results\n    all_doc_tfs = {}\n    all_vocab = set()\n    \n    for doc_tfs, _, chunk_vocab in results:\n        all_doc_tfs.update(doc_tfs)\n        all_vocab.update(chunk_vocab)\n    \n    # Compute document frequencies\n    doc_tfs_list = [doc_tfs for doc_tfs, _, _ in results]\n    df = _compute_document_frequencies(doc_tfs_list)\n    \n    # Compute IDF scores\n    idf = {}\n    for term, freq in df.items():\n        idf[term] = math.log((num_docs + 1) / (freq + 1)) + 1.0\n    \n    # Build inverted index and compute document vectors\n    inverted_index = defaultdict(list)\n    doc_vectors = {}\n    doc_norms = {}\n    \n    for doc_id, term_freqs in all_doc_tfs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        \n        for term, tf in term_freqs.items():\n            tfidf = tf * idf[term]\n            doc_vector[term] = tfidf\n            inverted_index[term].append((doc_id, tfidf))\n            norm_squared += tfidf * tfidf\n        \n        doc_vectors[doc_id] = doc_vector\n        doc_norms[doc_id] = math.sqrt(norm_squared)\n    \n    # Create index\n    index = TFIDFIndex(\n        num_documents=num_docs,\n        vocabulary=all_vocab,\n        document_frequencies=df,\n        idf=idf,\n        inverted_index=dict(inverted_index),\n        doc_vectors=doc_vectors,\n        doc_norms=doc_norms\n    )\n    \n    elapsed_time = time.perf_counter() - start_time\n    \n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed_time,\n        num_documents=num_docs,\n        vocabulary_size=len(all_vocab)\n    )\n\n\n# ============================================================================\n# Parallel Batch Search\n# ============================================================================\n\ndef _search_single_query(args):\n    """\n    Search for a single query.\n    \n    Args:\n        args: Tuple of (query, index, top_k, doc_titles)\n    \n    Returns:\n        List of SearchResult objects\n    """\n    query, index, top_k, doc_titles = args\n    \n    # Tokenize query\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n    \n    # Compute query TF\n    query_tf = compute_term_frequencies(query_tokens)\n    \n    # Compute query TF-IDF vector\n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in index.idf:\n            tfidf = tf * index.idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n    \n    if not query_vector:\n        return []\n    \n    query_norm = math.sqrt(query_norm_squared)\n    \n    # Find candidate documents\n    candidate_docs = set()\n    for term in query_vector:\n        if term in index.inverted_index:\n            for doc_id, _ in index.inverted_index[term]:\n                candidate_docs.add(doc_id)\n    \n    # Compute cosine similarity for each candidate\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index.doc_vectors.get(doc_id, {})\n        doc_norm = index.doc_norms.get(doc_id, 0)\n        \n        if doc_norm == 0:\n            continue\n        \n        # Dot product\n        dot_product = sum(\n            query_vector.get(term, 0) * doc_vector.get(term, 0)\n            for term in query_vector\n        )\n        \n        # Cosine similarity\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n    \n    # Get top-k results\n    scores.sort(key=lambda x: x[1], reverse=True)\n    top_results = scores[:top_k]\n    \n    # Build result objects\n    results = []\n    for doc_id, score in top_results:\n        title = doc_titles.get(doc_id, f"Document {doc_id}")\n        results.append(SearchResult(doc_id=doc_id, score=score, title=title))\n    \n    return results\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: Optional[int] = None,\n    documents=None\n) -> Tuple[List[List[SearchResult]], float]:\n    """\n    Search for multiple queries in parallel.\n    \n    Args:\n        queries: List of search query strings\n        index: TF-IDF index to search\n        top_k: Number of top results per query\n        num_workers: Number of worker processes (default: CPU count)\n        documents: Optional list of documents for title lookup\n    \n    Returns:\n        Tuple of (results_list, elapsed_time)\n        - results_list: List of result lists, one per query\n        - elapsed_time: Time taken for search\n    """\n    start_time = time.perf_counter()\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    # Prepare document titles dictionary\n    doc_titles = {}\n    if documents:\n        doc_titles = {d.doc_id: d.title for d in documents}\n    \n    # Prepare arguments for each query\n    query_args = [(q, index, top_k, doc_titles) for q in queries]\n    \n    # Process queries in parallel\n    with mp.Pool(processes=num_workers) as pool:\n        results_list = pool.map(_search_single_query, query_args)\n    \n    elapsed_time = time.perf_counter() - start_time\n    \n    return results_list, elapsed_time\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
