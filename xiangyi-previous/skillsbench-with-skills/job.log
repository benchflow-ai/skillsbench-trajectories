Sending keys: ['cat > /root/process_video.py << \'EOF\'\nimport json\nimport subprocess\nimport os\nfrom pydub import AudioSegment\nfrom pydub.utils import mediainfo\nfrom moviepy.editor import VideoFileClip, concatenate_videoclips\nimport re\n\n# Filler words and phrases to detect\nFILLER_WORDS = {\n    \'um\': r\'\\bum\\b\',\n    \'uh\': r\'\\buh\\b\',\n    \'hum\': r\'\\bhum\\b\',\n    \'hmm\': r\'\\bhmm\\b\',\n    \'mhm\': r\'\\bmhm\\b\',\n    \'like\': r\'\\blike\\b\',\n    \'you know\': r\'\\byou\\s+know\\b\',\n    \'i mean\': r\'\\bi\\s+mean\\b\',\n    \'yeah\': r\'\\byeah\\b\',\n    \'so\': r\'\\bso\\b\',\n    \'kind of\': r\'\\bkind\\s+of\\b\',\n    \'basically\': r\'\\bbasically\\b\',\n    \'i guess\': r\'\\bi\\s+guess\\b\',\n    \'well\': r\'\\bwell\\b\',\n    \'okay\': r\'\\bokay\\b\',\n}\n\ndef extract_audio(video_path, audio_path):\n    """Extract audio from video file"""\n    print(f"Extracting audio from {video_path}...")\n    cmd = [\n        \'ffmpeg\', \'-i\', video_path,\n        \'-q:a\', \'9\',\n        \'-n\',\n        audio_path\n    ]\n    subprocess.run(cmd, capture_output=True, check=True)\n    print(f"Audio extracted to {audio_path}")\n\ndef transcribe_with_pocketsphinx(audio_path):\n    """Transcribe audio using pocketsphinx"""\n    print(f"Transcribing audio with pocketsphinx...")\n    # Use pocketsphinx to transcribe\n    cmd = [\'pocketsphinx\', \'-infile\', audio_path]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    transcript = result.stdout.strip()\n    print(f"Transcript: {transcript}")\n    return transcript\n\ndef get_audio_duration(audio_path):\n    """Get duration of audio file in seconds"""\n    cmd = [\'ffprobe\', \'-v\', \'error\', \'-show_entries\', \'format=duration\',\n           \'-of\', \'default=noprint_wrappers=1:nokey=1:noprint_wrappers=1\', audio_path]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    try:\n        return float(result.stdout.strip())\n    except:\n        return 0\n\ndef detect_filler_words(transcript, audio_duration):\n    """Detect filler words in transcript and estimate timestamps"""\n    annotations = []\n    transcript_lower = transcript.lower()\n    \n    # Split transcript into words with approximate timing\n    words = transcript_lower.split()\n    total_words = len(words)\n    \n    if total_words == 0:\n        return annotations\n    \n    # Calculate approximate time per word\n    time_per_word = audio_duration / total_words if total_words > 0 else 0\n    \n    current_pos = 0\n    word_index = 0\n    \n    for filler, pattern in FILLER_WORDS.items():\n        # Find all occurrences of the filler word\n        for match in re.finditer(pattern, transcript_lower):\n            # Estimate timestamp based on position in transcript\n            char_pos = match.start()\n            # Count words up to this position\n            words_before = transcript_lower[:char_pos].split()\n            estimated_time = len(words_before) * time_per_word\n            \n            # Ensure timestamp is within bounds\n            estimated_time = max(0, min(estimated_time, audio_duration))\n            \n            annotations.append({\n                \'word\': filler,\n                \'timestamp\': round(estimated_time, 1)\n            })\n    \n    # Sort by timestamp\n    annotations.sort(key=lambda x: x[\'timestamp\'])\n    return annotations\n\ndef extract_clips_and_create_output(video_path, annotations, output_path):\n    """Extract filler word clips and stitch them together"""\n    print(f"Creating output video with filler word clips...")\n    \n    if not annotations:\n        print("No filler words found")\n        return\n    \n    video = VideoFileClip(video_path)\n    clips = []\n    \n    for item in annotations:\n        timestamp = item[\'timestamp\']\n        # Extract a 1-second clip around the timestamp\n        start_time = max(0, timestamp - 0.5)\n        end_time = min(video.duration, timestamp + 0.5)\n        \n        if start_time < end_time:\n            clip = video.subclip(start_time, end_time)\n            clips.append(clip)\n    \n    if clips:\n        final_video = concatenate_videoclips(clips)\n        final_video.write_videofile(output_path, verbose=False, logger=None)\n        print(f"Output video created at {output_path}")\n    else:\n        print("No clips to stitch")\n    \n    video.close()\n\ndef main():\n    input_video = \'/root/input.mp4\'\n    audio_file = \'/tmp/audio.wav\'\n    output_json = \'/root/annotations.json\'\n    output_video = \'/root/output.mp4\'\n    \n    # Step 1: Extract audio\n    extract_audio(input_video, audio_file)\n    \n    # Step 2: Get audio duration\n    audio_duration = get_audio_duration(audio_file)\n    print(f"Audio duration: {audio_duration} seconds")\n    \n    # Step 3: Transcribe\n    transcript = transcribe_with_pocketsphinx(audio_file)\n    \n    # Step 4: Detect filler words\n    annotations = detect_filler_words(transcript, audio_duration)\n    \n    # Step 5: Save annotations\n    with open(output_json, \'w\') as f:\n        json.dump(annotations, f, indent=2)\n    print(f"Annotations saved to {output_json}")\n    print(f"Found {len(annotations)} filler words")\n    \n    # Step 6: Extract clips and create output video\n    extract_clips_and_create_output(input_video, annotations, output_video)\n    \n    # Cleanup\n    if os.path.exists(audio_file):\n        os.remove(audio_file)\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
