Sending keys: ['cat >> solve_dcopf.py << \'EOF\'\n\ndef main():\n    print("Loading network...")\n    data = load_network(\'network.json\')\n    \n    # Find branch 64-1501\n    target_idx = None\n    for i, br in enumerate(data[\'branch\']):\n        if (int(br[0]) == 64 and int(br[1]) == 1501) or \\\n           (int(br[0]) == 1501 and int(br[1]) == 64):\n            target_idx = i\n            orig_rate = br[5]\n            print(f"Target branch {i}: 64-1501, RATE_A={orig_rate} MW")\n            break\n    \n    # Base case\n    print("\\nSolving base case...")\n    base = solve_dcopf(data)\n    print(f"Base cost: ${base[\'total_cost_dollars_per_hour\']}/hr")\n    print(f"Binding lines: {len(base[\'binding_lines\'])}")\n    \n    # Counterfactual: 20% increase on target line\n    print("\\nSolving counterfactual (20% capacity increase)...")\n    m = build_matrices(data)\n    rate_a_cf = m[\'rate_a\'].copy()\n    rate_a_cf[target_idx] *= 1.2\n    print(f"New capacity: {rate_a_cf[target_idx]} MW")\n    \n    cf = solve_dcopf(data, rate_a_cf)\n    print(f"CF cost: ${cf[\'total_cost_dollars_per_hour\']}/hr")\n    \n    # Check if target line is still binding\n    target_binding_cf = any(\n        (bl[\'from\']==64 and bl[\'to\']==1501) or (bl[\'from\']==1501 and bl[\'to\']==64)\n        for bl in cf[\'binding_lines\']\n    )\n    \n    # Find top 3 LMP drops\n    lmp_changes = []\n    for i in range(len(base[\'lmp_by_bus\'])):\n        bus = base[\'lmp_by_bus\'][i][\'bus\']\n        base_lmp = base[\'lmp_by_bus\'][i][\'lmp_dollars_per_MWh\']\n        cf_lmp = cf[\'lmp_by_bus\'][i][\'lmp_dollars_per_MWh\']\n        delta = cf_lmp - base_lmp\n        lmp_changes.append({\'bus\': bus, \'base_lmp\': base_lmp, \'cf_lmp\': cf_lmp, \'delta\': round(delta, 4)})\n    \n    top3 = sorted(lmp_changes, key=lambda x: x[\'delta\'])[:3]\n    \n    report = {\n        \'base_case\': {\n            \'total_cost_dollars_per_hour\': base[\'total_cost_dollars_per_hour\'],\n            \'lmp_by_bus\': base[\'lmp_by_bus\'],\n            \'reserve_mcp_dollars_per_MWh\': base[\'reserve_mcp_dollars_per_MWh\'],\n            \'binding_lines\': base[\'binding_lines\']\n        },\n        \'counterfactual\': {\n            \'total_cost_dollars_per_hour\': cf[\'total_cost_dollars_per_hour\'],\n            \'lmp_by_bus\': cf[\'lmp_by_bus\'],\n            \'reserve_mcp_dollars_per_MWh\': cf[\'reserve_mcp_dollars_per_MWh\'],\n            \'binding_lines\': cf[\'binding_lines\']\n        },\n        \'impact_analysis\': {\n            \'cost_reduction_dollars_per_hour\': round(base[\'total_cost_dollars_per_hour\'] - cf[\'total_cost_dollars_per_hour\'], 2),\n            \'buses_with_largest_lmp_drop\': top3,\n            \'congestion_relieved\': not target_binding_cf\n        }\n    }\n    \n    with open(\'report.json\', \'w\') as f:\n        json.dump(report, f, indent=2)\n    print("\\nReport saved to report.json")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
