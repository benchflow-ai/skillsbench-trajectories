Sending keys: ['cat << \'EOF\' > /root/compute_stats.py\nimport sys\nfrom scapy.all import *\nimport math\nfrom collections import Counter, defaultdict\n\ndef shannon_entropy(data_counts, total):\n    if total == 0:\n        return 0\n    entropy = 0\n    for count in data_counts.values():\n        p = count / total\n        entropy -= p * math.log2(p)\n    return entropy\n\n# Basic counts\nproto_counts = Counter()\nip_total = 0\ntotal_bytes = 0\nsizes = []\ntimestamps = []\n\nsrc_ips_counts = Counter()\ndst_ips_counts = Counter()\nsrc_ports_counts = Counter()\ndst_ports_counts = Counter()\n\n# Flows: (src_ip, dst_ip, src_port, dst_port, protocol)\nflows = set()\ntcp_flows = set()\nudp_flows = set()\n\n# Graph\nedges = set() # (src_ip, dst_ip)\n\n# PCR computation\nip_sent = defaultdict(int)\nip_recv = defaultdict(int)\n\nwith PcapReader(\'/root/packets.pcap\') as pr:\n    for p in pr:\n        ts = float(p.time)\n        timestamps.append(ts)\n        size = len(p)\n        sizes.append(size)\n        total_bytes += size\n        \n        if p.haslayer(IP):\n            ip_total += 1\n            src_ip = p[IP].src\n            dst_ip = p[IP].dst\n            src_ips_counts[src_ip] += 1\n            dst_ips_counts[dst_ip] += 1\n            edges.add((src_ip, dst_ip))\n            ip_sent[src_ip] += size\n            ip_recv[dst_ip] += size\n            \n            proto = p[IP].proto\n            sport = None\n            dport = None\n            \n            if p.haslayer(TCP):\n                proto_counts[\'tcp\'] += 1\n                sport = p[TCP].sport\n                dport = p[TCP].dport\n                tcp_flows.add((src_ip, dst_ip, sport, dport, \'TCP\'))\n                flows.add((src_ip, dst_ip, sport, dport, \'TCP\'))\n            elif p.haslayer(UDP):\n                proto_counts[\'udp\'] += 1\n                sport = p[UDP].sport\n                dport = p[UDP].dport\n                udp_flows.add((src_ip, dst_ip, sport, dport, \'UDP\'))\n                flows.add((src_ip, dst_ip, sport, dport, \'UDP\'))\n            elif p.haslayer(ICMP):\n                proto_counts[\'icmp\'] += 1\n                flows.add((src_ip, dst_ip, None, None, \'ICMP\'))\n            else:\n                flows.add((src_ip, dst_ip, None, None, proto))\n                \n            if sport is not None:\n                src_ports_counts[sport] += 1\n            if dport is not None:\n                dst_ports_counts[dport] += 1\n                \n        elif p.haslayer(ARP):\n            proto_counts[\'arp\'] += 1\n\n# Protocol counts\nprint(f"protocol_tcp,{proto_counts[\'tcp\']}")\nprint(f"protocol_udp,{proto_counts[\'udp\']}")\nprint(f"protocol_icmp,{proto_counts[\'icmp\']}")\nprint(f"protocol_arp,{proto_counts[\'arp\']}")\nprint(f"protocol_ip_total,{ip_total}")\n\n# Time / rate\nduration = max(timestamps) - min(timestamps) if timestamps else 0\nprint(f"duration_seconds,{duration}")\n\nif timestamps:\n    start_ts = min(timestamps)\n    buckets = defaultdict(int)\n    for ts in timestamps:\n        bucket = int((ts - start_ts) // 60)\n        buckets[bucket] += 1\n    \n    num_buckets = int(duration // 60) + 1\n    counts_list = [buckets[i] for i in range(num_buckets)]\n    print(f"packets_per_minute_avg,{sum(counts_list)/len(counts_list)}")\n    print(f"packets_per_minute_max,{max(counts_list)}")\n    print(f"packets_per_minute_min,{min(counts_list)}")\nelse:\n    counts_list = []\n    print("packets_per_minute_avg,0")\n    print("packets_per_minute_max,0")\n    print("packets_per_minute_min,0")\n\n# Sizes\nprint(f"total_bytes,{total_bytes}")\nif sizes:\n    print(f"avg_packet_size,{sum(sizes)/len(sizes)}")\n    print(f"min_packet_size,{min(sizes)}")\n    print(f"max_packet_size,{max(sizes)}")\nelse:\n    print("avg_packet_size,0")\n    print("min_packet_size,0")\n    print("max_packet_size,0")\n\n# Entropy\nprint(f"dst_port_entropy,{shannon_entropy(dst_ports_counts, sum(dst_ports_counts.values()))}")\nprint(f"src_port_entropy,{shannon_entropy(src_ports_counts, sum(src_ports_counts.values()))}")\nprint(f"src_ip_entropy,{shannon_entropy(src_ips_counts, sum(src_ips_counts.values()))}")\nprint(f"dst_ip_entropy,{shannon_entropy(dst_ips_counts, sum(dst_ips_counts.values()))}")\nprint(f"unique_dst_ports,{len(dst_ports_counts)}")\nprint(f"unique_src_ports,{len(src_ports_counts)}")\n\n# Graph\nnodes = set(src_ips_counts.keys()) | set(dst_ips_counts.keys())\nnum_nodes = len(nodes)\nnum_edges = len(edges)\nprint(f"num_nodes,{num_nodes}")\nprint(f"num_edges,{num_edges}")\nif num_nodes < 2:\n    density = 0\nelse:\n    density = num_edges / (num_nodes * (num_nodes - 1))\nprint(f"network_density,{density}")\n\noutdegrees = Counter(src for src, dst in edges)\nindegrees = Counter(dst for src, dst in edges)\nprint(f"max_indegree,{max(indegrees.values()) if indegrees else 0}")\nprint(f"max_outdegree,{max(outdegrees.values()) if outdegrees else 0}")\n\n# Timing\ntimestamps.sort()\niats = [timestamps[i+1] - timestamps[i] for i in range(len(timestamps)-1)]\nif iats:\n    iat_mean = sum(iats) / len(iats)\n    iat_var = sum((x - iat_mean)**2 for x in iats) / len(iats)\n    iat_cv = (iat_var**0.5 / iat_mean) if iat_mean != 0 else 0\n    print(f"iat_mean,{iat_mean}")\n    print(f"iat_variance,{iat_var}")\n    print(f"iat_cv,{iat_cv}")\nelse:\n    iat_mean = 0\n    iat_cv = 0\n    print("iat_mean,0")\n    print("iat_variance,0")\n    print("iat_cv,0")\n\n# Producer/Consumer\nnum_producers = 0\nnum_consumers = 0\nfor ip in nodes:\n    sent = ip_sent[ip]\n    recv = ip_recv[ip]\n    if sent + recv > 0:\n        pcr = (sent - recv) / (sent + recv)\n        if pcr > 0.2:\n            num_producers += 1\n        elif pcr < -0.2:\n            num_consumers += 1\nprint(f"num_producers,{num_producers}")\nprint(f"num_consumers,{num_consumers}")\n\n# Flows\nprint(f"unique_flows,{len(flows)}")\nbidi_flows = 0\nfor f in flows:\n    rev_f = (f[1], f[0], f[3], f[2], f[4])\n    if rev_f in flows:\n        bidi_flows += 1\nprint(f"bidirectional_flows,{bidi_flows}")\nprint(f"tcp_flows,{len(tcp_flows)}")\nprint(f"udp_flows,{len(udp_flows)}")\n\n# Heuristics for analysis flags\nhas_port_scan = False\nsrc_dst_ports = defaultdict(set)\nfor f in flows:\n    if f[4] in [\'TCP\', \'UDP\']:\n        src_dst_ports[(f[0], f[1])].add(f[3])\nfor ports in src_dst_ports.values():\n    if len(ports) > 50:\n        has_port_scan = True\n        break\n\nhas_dos_pattern = max(counts_list) > 10000 if counts_list else False\nhas_beaconing = (iat_cv < 0.5 and iat_mean > 0.1) if iats else False\nis_traffic_benign = not (has_port_scan or has_dos_pattern or has_beaconing)\n\nprint(f"is_traffic_benign,{str(is_traffic_benign).lower()}")\nprint(f"has_port_scan,{str(has_port_scan).lower()}")\nprint(f"has_dos_pattern,{str(has_dos_pattern).lower()}")\nprint(f"has_beaconing,{str(has_beaconing).lower()}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
