tail.get(\'state\') == \'closed\':\n                closed_prs.append(pr_detail)\n    \n    print(f"  Merged: {len(merged_prs)}, Closed: {len(closed_prs)}")\n    \n    merge_times = []\n    for pr in merged_prs:\n        created = datetime.fromisoformat(pr[\'created_at\'].replace(\'Z\', \'+00:00\'))\n        merged = datetime.fromisoformat(pr[\'merged_at\'].replace(\'Z\', \'+00:00\'))\n        days = (merged - created).days + (merged - created).seconds / 86400\n        merge_times.append(days)\n    \n    avg_merge_days = round(sum(merge_times) / len(merge_times), 1) if merge_times else 0.0\n    print(f"  Average merge time: {avg_merge_days} days")\n    \n    contributor_count = defaultdict(int)\n    for pr in all_prs:\n        contributor = pr[\'user\'][\'login\']\n        contributor_count[contributor] += 1\n    \n    top_contributor = max(contributor_count, key=contributor_count.get) if contributor_count else ""\n    print(f"  Top contributor: {top_contributor} ({contributor_count[top_contributor]} PRs)")\nelse:\n    merged_prs = []\n    closed_prs = []\n    avg_merge_days = 0.0\n    top_contributor = ""\n\nprint("\\nFetching issues created in December 2024...")\n# Search API query for issues (excluding PRs) in December 2024\nissue_search = f"{api_base}/search/issues?q=repo:cli/cli+type:issue+created:2024-12-01..2024-12-31&sort=created&order=desc&per_page=100"\nall_issues = []\npage = 1\nwhile page <= 10:\n    page_url = f"{issue_search}&page={page}"\n    print(f"  Fetching issue page {page}...")\n    response = run_curl(page_url)\n    if not response:\n        break\n    if \'message\' in response:\n        print(f"  API Error: {response[\'message\']}")\n        break\n    \n    items = response.get(\'items\', [])\n    if not items:\n        break\n    \n    all_issues.extend(items)\n    print(f"    Got {len(items)} items, total so far: {len(all_issues)}")\n    \n    if len(items) < 100:\n        break\n    page += 1\n\nprint(f"Found {len(all_issues)} issues created in December 2024")\n\nbug_issues = []\nfor issue in all_issues:\n    labels = issue.get(\'labels\', [])\n    has_bug_label = any(\'bug\' in label[\'name\'].lower() for label in labels)\n    if has_bug_label:\n        bug_issues.append(issue)\n\nprint(f"  Bug reports: {len(bug_issues)}")\n\nresolved_bugs = [issue for issue in bug_issues if issue[\'state\'] == \'closed\']\nprint(f"  Resolved bugs: {len(resolved_bugs)}")\n\nreport = {\n    "pr": {\n        "total": len(all_prs),\n        "merged": len(merged_prs),\n        "closed": len(closed_prs),\n        "avg_merge_days": avg_merge_days,\n        "top_contributor": top_contributor\n    },\n    "issue": {\n        "total": len(all_issues),\n        "bug": len(bug_issues),\n        "resolved_bugs": len(resolved_bugs)\n    }\n}\n\nprint("\\nReport:")\nprint(json.dumps(report, indent=2))\n\nwith open(\'/app/report.json\', \'w\') as f:\n    json.dump(report, f, indent=2)\n\nprint("\\nReport saved to /app/report.json")\nEOF\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
