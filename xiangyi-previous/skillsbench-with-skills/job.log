Sending keys: ['cat >> /root/solve_task.py << \'EOF\'\n# Event association using simple time clustering\nprint("\\nAssociating picks to events...")\n\n# Sort picks by time\npicks_df = picks_df.sort_values(\'timestamp\').reset_index(drop=True)\n\n# Simple association: group P picks that are close in time\n# Use DBSCAN-like approach or simple time windowing\nevents = []\n\n# Use only P picks for initial event detection (more reliable)\np_picks = picks_df[picks_df[\'phase\'] == \'P\'].copy()\n\nif len(p_picks) == 0:\n    print("No P picks found for association!")\n    pd.DataFrame({\'time\': []}).to_csv(\'/root/results.csv\', index=False)\n    exit()\n\n# Time window for association (seconds)\n# Considering stations can be far apart and velocity model\ntime_window = 30.0  # seconds\nmin_picks = 3  # minimum picks to declare an event\n\nused_picks = set()\n\nfor i, pick in p_picks.iterrows():\n    if i in used_picks:\n        continue\n    \n    # Find all picks within time window\n    pick_time = pick[\'timestamp\']\n    nearby_picks = p_picks[\n        (p_picks[\'timestamp\'] >= pick_time) & \n        (p_picks[\'timestamp\'] <= pick_time + time_window)\n    ]\n    \n    # Check if we have enough picks from different stations\n    unique_stations = nearby_picks.groupby([\'network\', \'station\']).size()\n    \n    if len(unique_stations) >= min_picks:\n        # This is likely an event\n        # Use the median time of picks as event time\n        event_time = nearby_picks[\'timestamp\'].median()\n        \n        # Mark these picks as used\n        used_picks.update(nearby_picks.index.tolist())\n        \n        events.append({\n            \'time\': datetime.utcfromtimestamp(event_time).isoformat(),\n            \'timestamp\': event_time,\n            \'n_picks\': len(nearby_picks),\n            \'n_stations\': len(unique_stations)\n        })\n\nprint(f"Found {len(events)} events with >= {min_picks} picks")\n\n# If we found very few events, try with lower threshold\nif len(events) < 5:\n    print("\\nTrying with lower threshold (min_picks=2)...")\n    events = []\n    used_picks = set()\n    min_picks = 2\n    \n    for i, pick in p_picks.iterrows():\n        if i in used_picks:\n            continue\n        \n        pick_time = pick[\'timestamp\']\n        nearby_picks = p_picks[\n            (p_picks[\'timestamp\'] >= pick_time) & \n            (p_picks[\'timestamp\'] <= pick_time + time_window)\n        ]\n        \n        unique_stations = nearby_picks.groupby([\'network\', \'station\']).size()\n        \n        if len(unique_stations) >= min_picks:\n            event_time = nearby_picks[\'timestamp\'].median()\n            used_picks.update(nearby_picks.index.tolist())\n            \n            events.append({\n                \'time\': datetime.utcfromtimestamp(event_time).isoformat(),\n                \'timestamp\': event_time,\n                \'n_picks\': len(nearby_picks),\n                \'n_stations\': len(unique_stations)\n            })\n    \n    print(f"Found {len(events)} events with >= {min_picks} picks")\n\n# Create results DataFrame\nif len(events) > 0:\n    results_df = pd.DataFrame(events)\n    # Sort by time\n    results_df = results_df.sort_values(\'timestamp\').reset_index(drop=True)\n    # Keep only required columns for output\n    output_df = results_df[[\'time\']]\n    print(f"\\nWriting {len(output_df)} events to /root/results.csv")\n    output_df.to_csv(\'/root/results.csv\', index=False)\n    print("Done!")\n    print(f"\\nFirst few events:")\n    print(output_df.head(10))\nelse:\n    print("No events found!")\n    pd.DataFrame({\'time\': []}).to_csv(\'/root/results.csv\', index=False)\n\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
