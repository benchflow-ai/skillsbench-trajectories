ay, hour, 0)\n            end_time = check_date + timedelta(hours=constraints[\'duration\'])\n            \n            # Check if slot is free\n            try:\n                events_result = calendar_service.events().list(\n                    calendarId=\'primary\',\n                    timeMin=check_date.isoformat() + \'Z\',\n                    timeMax=end_time.isoformat() + \'Z\',\n                    singleEvents=True\n                ).execute()\n                \n                events = events_result.get(\'items\', [])\n                if not events:\n                    return {\n                        \'date\': check_date,\n                        \'end_time\': end_time,\n                        \'duration\': constraints[\'duration\']\n                    }\n            except:\n                # If API call fails, assume slot is available\n                return {\n                    \'date\': check_date,\n                    \'end_time\': end_time,\n                    \'duration\': constraints[\'duration\']\n                }\n    \n    return None\n\ndef format_date(dt):\n    """Format date as \'Thursday, January 08, 2026\'"""\n    day_names = [\'Monday\', \'Tuesday\', \'Wednesday\', \'Thursday\', \'Friday\', \'Saturday\', \'Sunday\']\n    month_names = [\'\', \'January\', \'February\', \'March\', \'April\', \'May\', \'June\',\n                   \'July\', \'August\', \'September\', \'October\', \'November\', \'December\']\n    \n    day_name = day_names[dt.weekday()]\n    month_name = month_names[dt.month]\n    day_str = f"{dt.day:02d}"\n    year = dt.year\n    \n    return f"{day_name}, {month_name} {day_str}, {year}"\n\ndef format_time_range(start_dt, end_dt):\n    """Format time range as \'09:00 AM - 10:30 AM\'"""\n    def format_time(dt):\n        hour = dt.hour\n        minute = dt.minute\n        ampm = \'AM\' if hour < 12 else \'PM\'\n        if hour > 12:\n            hour -= 12\n        elif hour == 0:\n            hour = 12\n        return f"{hour:02d}:{minute:02d} {ampm}"\n    \n    return f"{format_time(start_dt)} - {format_time(end_dt)}"\n\ndef send_reply_email(gmail_service, to_email, meeting_info, duration):\n    """Send reply email with proposed meeting time"""\n    date_formatted = format_date(meeting_info[\'date\'])\n    time_range = format_time_range(meeting_info[\'date\'], meeting_info[\'end_time\'])\n    \n    message_body = f"""Hi,\n\nThank you for your meeting request.\n\nI can be available:\n\nDate: {date_formatted}\nTime: {time_range}\nDuration: {duration} hour(s)\n\nIf this time doesn\'t work, please let me know your preferred alternatives.\n\nBest regards,\nSkillsBench"""\n    \n    message = MIMEText(message_body)\n    message[\'to\'] = to_email\n    message[\'subject\'] = \'Re: Meeting Request\'\n    \n    raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode()\n    \n    try:\n        result = gmail_service.users().messages().send(\n            userId=\'me\',\n            body={\'raw\': raw_message}\n        ).execute()\n        return result.get(\'id\')\n    except HttpError as error:\n        print(f\'An error occurred: {error}\')\n        return None\n\ndef main():\n    # Load input\n    with open(\'/root/test_input.json\', \'r\') as f:\n        requests = json.load(f)\n    \n    gmail_service = get_gmail_service()\n    calendar_service = get_calendar_service()\n    \n    results = {\'sent_results\': []}\n    \n    for request in requests:\n        email_text = request[\'email_text\']\n        from_email = request[\'from_email\']\n        \n        # Parse meeting constraints\n        constraints = parse_meeting_request(email_text)\n        \n        # Find available slot\n        slot = find_available_slot(calendar_service, constraints)\n        \n        if slot:\n            # Send reply\n            message_id = send_reply_email(gmail_service, from_email, slot, constraints[\'duration\'])\n            if message_id:\n                results[\'sent_results\'].