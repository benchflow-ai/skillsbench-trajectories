Sending keys: ['python3 - <<\'PY\'\nimport pandas as pd\n\n# Load data as strings\nraw = pd.read_csv(\'/root/environment/data/ckd_lab_data.csv\', dtype=str)\n\n# Clean numeric formatting: replace commas with dots, strip spaces, convert to numeric\nfor col in raw.columns:\n    if col == \'patient_id\':\n        continue\n    raw[col] = raw[col].str.replace(\',\', \'.\', regex=False).str.strip()\n    raw[col] = pd.to_numeric(raw[col], errors=\'coerce\')\n\n# Drop rows with any missing values\nraw = raw.dropna()\n\n# Helper for conditional conversion\n\ndef convert_cond(df, col, cond, factor, op=\'*\'):\n    if op == \'*\':\n        df.loc[cond(df[col]), col] = df.loc[cond(df[col]), col] * factor\n    else:\n        df.loc[cond(df[col]), col] = df.loc[cond(df[col]), col] / factor\n\n# Unit harmonization conversions\nconvert_cond(raw, \'Serum_Creatinine\', lambda s: s > 20, 88.4, op=\'/\')            # µmol/L -> mg/dL\nconvert_cond(raw, \'BUN\', lambda s: s < 5, 2.8, op=\'*\')                           # mmol/L -> mg/dL\nconvert_cond(raw, \'Serum_Calcium\', lambda s: s < 4, 4, op=\'*\')                   # mmol/L -> mg/dL\nraw[\'Ionized_Calcium\'] = raw[\'Ionized_Calcium\'] * 4                              # mmol/L -> mg/dL\nconvert_cond(raw, \'Phosphorus\', lambda s: s < 2, 3.1, op=\'*\')                    # mmol/L -> mg/dL\nconvert_cond(raw, \'Magnesium\', lambda s: s < 1, 2.43, op=\'*\')                    # mmol/L -> mg/dL\nconvert_cond(raw, \'Intact_PTH\', lambda s: s < 10, 9.43, op=\'*\')                  # pmol/L -> pg/mL\nconvert_cond(raw, \'Vitamin_D_25OH\', lambda s: s > 100, 2.5, op=\'/\')              # nmol/L -> ng/mL\nconvert_cond(raw, \'Vitamin_D_1_25OH\', lambda s: s > 100, 2.4, op=\'/\')            # pmol/L -> pg/mL\nconvert_cond(raw, \'Hemoglobin\', lambda s: s > 25, 10, op=\'/\')                    # g/L -> g/dL\nconvert_cond(raw, \'Albumin_Serum\', lambda s: s > 10, 10, op=\'/\')                 # g/L -> g/dL\nconvert_cond(raw, \'Total_Protein\', lambda s: s > 10, 10, op=\'/\')                 # g/L -> g/dL\nconvert_cond(raw, \'Prealbumin\', lambda s: s > 100, 10, op=\'/\')                   # mg/L -> mg/dL\nconvert_cond(raw, \'Total_Bilirubin\', lambda s: s > 5, 17.1, op=\'/\')              # µmol/L -> mg/dL\nconvert_cond(raw, \'Direct_Bilirubin\', lambda s: s > 2, 17.1, op=\'/\')             # µmol/L -> mg/dL\nconvert_cond(raw, \'Serum_Iron\', lambda s: s < 30, 5.585, op=\'*\')                 # µmol/L -> µg/dL\nconvert_cond(raw, \'TIBC\', lambda s: s < 100, 5.585, op=\'*\')                      # µmol/L -> µg/dL\nfor col in [\'Total_Cholesterol\',\'LDL_Cholesterol\',\'HDL_Cholesterol\',\'Non_HDL_Cholesterol\']:\n    convert_cond(raw, col, lambda s: s < 10, 38.67, op=\'*\')                      # mmol/L -> mg/dL\nconvert_cond(raw, \'Triglycerides\', lambda s: s < 10, 88.57, op=\'*\')              # mmol/L -> mg/dL\nconvert_cond(raw, \'Glucose\', lambda s: s < 30, 18, op=\'*\')                       # mmol/L -> mg/dL\nconvert_cond(raw, \'Uric_Acid\', lambda s: s > 20, 59.48, op=\'/\')                  # µmol/L -> mg/dL\nconvert_cond(raw, \'Urine_Creatinine\', lambda s: s > 1000, 88.4, op=\'/\')          # µmol/L -> mg/dL\nconvert_cond(raw, \'Albumin_to_Creatinine_Ratio_Urine\', lambda s: s < 30, 8.84, op=\'*\')  # mg/mmol -> mg/g\nconvert_cond(raw, \'Protein_to_Creatinine_Ratio_Urine\', lambda s: s < 30, 8.84, op=\'*\')  # mg/mmol -> mg/g\nconvert_cond(raw, \'Troponin_I\', lambda s: s > 1, 1000, op=\'/\')                   # ng/L -> ng/mL\nconvert_cond(raw, \'Troponin_T\', lambda s: s > 1, 1000, op=\'/\')                   # ng/L -> ng/mL\nconvert_cond(raw, \'Free_T4\', lambda s: s > 5, 12.87, op=\'/\')                     # pmol/L -> ng/dL\nconvert_cond(raw, \'Free_T3\', lambda s: s > 10, 1.536, op=\'/\')                    # pmol/L -> pg/mL\nconvert_cond(raw, \'Lactate\', lambda s: s > 10, 9, op=\'/\')                        # mg/dL -> mmol/L (or adjust)\n\n# Format output: patient_id as integer, others as 2-decimal strings\nraw[\'patient_id\'] = raw[\'patient_id\'].astype(int)\n\nfor col in raw.columns:\n    if col == \'patient_id\':\n        continue\n    raw[col] = raw[col].map(lambda x: f"{x:.2f}")\n\n# Save harmonized data\noutput_path = \'/root/ckd_lab_data_harmonized.csv\'\nraw.to_csv(output_path, index=False)\nprint(\'saved\', output_path, \'shape\', raw.shape)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
