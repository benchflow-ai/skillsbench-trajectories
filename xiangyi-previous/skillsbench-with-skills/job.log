Sending keys: ['cat > /app/solution.py <<EOF\nimport pandas as pd\nimport json\nimport re\nimport numpy as np\n\ndef load_codebook(filepath):\n    df = pd.read_csv(filepath)\n    codebook = []\n    for _, row in df.iterrows():\n        keywords = [k.strip().lower() for k in re.split(r\'[,;、]\', str(row[\'keywords_examples\'])) if k.strip()]\n        codebook.append({\n            \'code\': row[\'code\'],\n            \'label\': row[\'standard_label\'],\n            \'keywords\': keywords,\n            \'station_scope\': [s.strip() for s in str(row[\'station_scope\']).split(\';\')],\n            \'category_lv1\': str(row[\'category_lv1\']),\n            \'category_lv2\': str(row[\'category_lv2\'])\n        })\n    return codebook\n\ncodebooks = {\n    \'P1_POWER\': load_codebook(\'/app/data/codebook_P1_POWER.csv\'),\n    \'P2_CTRL\': load_codebook(\'/app/data/codebook_P2_CTRL.csv\'),\n    \'P3_RF\': load_codebook(\'/app/data/codebook_P3_RF.csv\')\n}\n\ndef split_segments(text):\n    if pd.isna(text):\n        return []\n    # Split by common separators\n    seps = [r\' / \', r\' ; \', r\' ;\', r\'; \', r\';\', r\' /\', r\'/ \', r\'/\', r\' 、\', r\'、 \', r\'、\', r\' & \', r\'&\', r\', \', r\' ,\', r\',\', r\'；\', r\'\\s{2,}\', r\'。\']\n    pattern = \'|\'.join(map(re.escape, seps))\n    segments = re.split(pattern, str(text))\n    return [s.strip() for s in segments if s.strip()]\n\ndef extract_components(text):\n    # Simple regex to find component-like strings (e.g., R152, U202, C87, J3)\n    return set(re.findall(r\'[A-Z]+\\d+\', str(text).upper()))\n\ndef get_best_match(segment, product_id, station, test_item):\n    if product_id not in codebooks:\n        return "UNKNOWN", "", 0.0, "Product codebook not found"\n    \n    best_entry = None\n    max_score = 0.0\n    seg_lower = segment.lower()\n    test_item_upper = str(test_item).upper() if not pd.isna(test_item) else ""\n    seg_components = extract_components(segment)\n    if test_item_upper:\n        seg_components.update(extract_components(test_item_upper))\n\n    for entry in codebooks[product_id]:\n        score = 0.0\n        \n        # 1. Component Match (High Weight)\n        entry_label_upper = entry[\'label\'].upper()\n        entry_components = extract_components(entry_label_upper)\n        for kw in entry[\'keywords\']:\n            entry_components.update(extract_components(kw))\n            \n        common_components = seg_components.intersection(entry_components)\n        if common_components:\n            score += 0.5\n        elif test_item_upper and any(comp in entry_label_upper for comp in extract_components(test_item_upper)):\n            score += 0.4\n\n        # 2. Keyword matching\n        kw_matches = 0\n        for kw in entry[\'keywords\']:\n            if kw in seg_lower:\n                kw_matches += 1\n        \n        if entry[\'keywords\']:\n            score += (kw_matches / len(entry[\'keywords\'])) * 0.4\n        \n        # 3. Label match\n        if entry[\'label\'].lower() in seg_lower or seg_lower in entry[\'label\'].lower():\n            score += 0.2\n            \n        # 4. Station match (Minor Weight)\n        if station in entry[\'station_scope\']:\n            score += 0.05\n            \n        if score > max_score:\n            max_score = score\n            best_entry = entry\n            \n    if max_score < 0.35:\n        # Calibration for UNKNOWN\n        return "UNKNOWN", "", max_score * 0.4, "Low match score"\n    \n    # Confidence calibration\n    confidence = min(0.4 + (max_score / 1.5) * 0.6, 0.99)\n    return best_entry[\'code\'], best_entry[\'label\'], confidence, f"Matched with score {max_score:.2f}"\n\ncol_names = [\n    \'record_id\', \'site\', \'product_id\', \'work_order\', \'serial_number\', \'station\', \'line\', \'fixture_id\', \n    \'test_item\', \'fail_code\', \'meas_value\', \'limit_low\', \'limit_high\', \'fw_version\', \'sw_version\', \n    \'operator_id\', \'shift\', \'timestamp\', \'engineer_id\', \'raw_reason_text\', \'action_text\', \'result\'\n]\n\nlogs = pd.read_csv(\'/app/data/test_center_logs.csv\', skiprows=2, names=col_names, engine=\'python\')\n\nrecords = []\nfor _, row in logs.iterrows():\n    record_id = str(row[\'record_id\'])\n    product_id = str(row[\'product_id\'])\n    raw_text = str(row[\'raw_reason_text\'])\n    station = str(row[\'station\'])\n    test_item = row[\'test_item\']\n    \n    segments = split_segments(raw_text)\n    normalized_segments = []\n    \n    for i, span in enumerate(segments, 1):\n        pred_code, pred_label, conf, rationale = get_best_match(span, product_id, station, test_item)\n        normalized_segments.append({\n            "segment_id": f"{record_id}-S{i}",\n            "span_text": span,\n            "pred_code": pred_code,\n            "pred_label": pred_label,\n            "confidence": float(round(conf, 2)),\n            "rationale": rationale\n        })\n    \n    records.append({\n        "record_id": record_id,\n        "product_id": product_id,\n        "station": station,\n        "engineer_id": str(row[\'engineer_id\']),\n        "raw_reason_text": raw_text,\n        "normalized": normalized_segments\n    })\n\nwith open(\'/app/output/solution.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump({"records": records}, f, ensure_ascii=False, indent=2)\nEOF\npython3 /app/solution.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
