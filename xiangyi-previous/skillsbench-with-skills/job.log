Sending keys: ['cat > /root/solve_task.py << \'EOF\'\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom obspy import read\nimport seisbench.models as sbm\nfrom datetime import datetime\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Load data\nprint("Loading waveform data...")\nst = read(\'/root/data/wave.mseed\')\nprint(f"Loaded {len(st)} traces")\n\n# Load station data\nprint("Loading station data...")\nstations_df = pd.read_csv(\'/root/data/stations.csv\')\nprint(f"Loaded {len(stations_df)} station channels")\n\n# Load SeisBench picking model\nprint("Loading SeisBench PhaseNet model...")\nmodel = sbm.PhaseNet.from_pretrained(\'original\')\nprint("Model loaded successfully")\n\n# Prepare picks list\nall_picks = []\n\n# Process each trace\nprint("\\nPicking P and S waves...")\nfor i, tr in enumerate(st):\n    if i % 10 == 0:\n        print(f"Processing trace {i+1}/{len(st)}...")\n    \n    try:\n        # Get station info\n        net = tr.stats.network\n        sta = tr.stats.station\n        loc = tr.stats.location\n        cha = tr.stats.channel\n        \n        # Find station coordinates\n        station_info = stations_df[\n            (stations_df[\'network\'] == net) & \n            (stations_df[\'station\'] == sta) & \n            (stations_df[\'channel\'] == cha)\n        ]\n        \n        if len(station_info) == 0:\n            continue\n            \n        lon = station_info.iloc[0][\'longitude\']\n        lat = station_info.iloc[0][\'latitude\']\n        \n        # Prepare waveform for model (needs to be 3 components ideally, but can work with 1)\n        # PhaseNet expects 3-channel input, we\'ll use single channel repeated\n        data = tr.data.astype(np.float32)\n        \n        # Normalize\n        if np.std(data) > 0:\n            data = (data - np.mean(data)) / np.std(data)\n        \n        # Create 3-channel array (repeat same channel)\n        data_3c = np.array([data, data, data])\n        \n        # Run picker\n        annotations = model.annotate(data_3c)\n        \n        # Extract picks from annotations\n        # PhaseNet outputs probabilities for P, S, and noise\n        p_prob = annotations[0, :, 0]  # P wave probability\n        s_prob = annotations[0, :, 1]  # S wave probability\n        \n        # Find peaks in probabilities (threshold = 0.3)\n        threshold = 0.3\n        \n        # P picks\n        p_indices = np.where(p_prob > threshold)[0]\n        if len(p_indices) > 0:\n            # Group consecutive indices and take max probability in each group\n            groups = np.split(p_indices, np.where(np.diff(p_indices) > 10)[0] + 1)\n            for group in groups:\n                if len(group) > 0:\n                    max_idx = group[np.argmax(p_prob[group])]\n                    # Convert sample index to time\n                    pick_time = tr.stats.starttime + (max_idx * tr.stats.delta)\n                    all_picks.append({\n                        \'time\': pick_time,\n                        \'phase\': \'P\',\n                        \'station\': sta,\n                        \'network\': net,\n                        \'longitude\': lon,\n                        \'latitude\': lat,\n                        \'probability\': float(p_prob[max_idx])\n                    })\n        \n        # S picks\n        s_indices = np.where(s_prob > threshold)[0]\n        if len(s_indices) > 0:\n            groups = np.split(s_indices, np.where(np.diff(s_indices) > 10)[0] + 1)\n            for group in groups:\n                if len(group) > 0:\n                    max_idx = group[np.argmax(s_prob[group])]\n                    pick_time = tr.stats.starttime + (max_idx * tr.stats.delta)\n                    all_picks.append({\n                        \'time\': pick_time,\n                        \'phase\': \'S\',\n                        \'station\': sta,\n                        \'network\': net,\n                        \'longitude\': lon,\n                        \'latitude\': lat,\n                        \'probability\': float(s_prob[max_idx])\n                    })\n    \n    except Exception as e:\n        print(f"Error processing trace {i}: {e}")\n        continue\n\nprint(f"\\nTotal picks found: {len(all_picks)}")\n\n# Convert to DataFrame\npicks_df = pd.DataFrame(all_picks)\nif len(picks_df) > 0:\n    picks_df[\'timestamp\'] = picks_df[\'time\'].apply(lambda x: x.timestamp)\n    print(f"P picks: {len(picks_df[picks_df[\'phase\']==\'P\'])}")\n    print(f"S picks: {len(picks_df[picks_df[\'phase\']==\'S\'])}")\nelse:\n    print("No picks found!")\n    # Create empty results file\n    pd.DataFrame({\'time\': []}).to_csv(\'/root/results.csv\', index=False)\n    exit()\n\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
