Sending keys: ['python3 << \'EOF\'\nimport re\nfrom collections import deque\n\ndef parse_domain_and_generate_plan(domain_file, problem_file, output_file):\n    # Read files\n    with open(domain_file, \'r\') as f:\n        domain_content = f.read()\n    with open(problem_file, \'r\') as f:\n        problem_content = f.read()\n    \n    # Extract move action names\n    move_actions = re.findall(r\'\\(:action\\s+(move_[^\\s]+)\', domain_content)\n    \n    # Build transition graph\n    transitions = {}  # from_seg -> [(to_seg, action_name), ...]\n    action_map = {}  # (from_seg, to_seg) -> action_name\n    \n    for action in move_actions:\n        parts = action.split(\'_\')\n        seg_pos = [i for i, p in enumerate(parts) if p == \'seg\']\n        \n        if len(seg_pos) >= 2:\n            from_parts = [\'seg\']\n            for i in range(seg_pos[0]+1, seg_pos[1]):\n                from_parts.append(parts[i])\n            \n            to_parts = [\'seg\']\n            for i in range(seg_pos[1]+1, len(parts)):\n                if parts[i] in [\'north\', \'south\', \'medium\']:\n                    break\n                to_parts.append(parts[i])\n            \n            from_seg = \'_\'.join(from_parts)\n            to_seg = \'_\'.join(to_parts)\n            \n            if from_seg not in transitions:\n                transitions[from_seg] = []\n            transitions[from_seg].append((to_seg, action))\n            action_map[(from_seg, to_seg)] = action\n    \n    # Extract initial state\n    init_match = re.search(r\'\\(at-segment\\s+(\\S+)\\s+(\\S+)\\)\', problem_content)\n    if init_match:\n        airplane = init_match.group(1)\n        start_seg = init_match.group(2)\n    \n    # Extract goal\n    goal_match = re.search(r\'\\(is-parked\\s+(\\S+)\\s+(\\S+)\\)|\\(airborne\\s+(\\S+)\\s+(\\S+)\\)\', problem_content)\n    if goal_match:\n        if goal_match.group(1):  # is-parked\n            goal_seg = goal_match.group(2)\n        else:  # airborne\n            goal_seg = goal_match.group(4)\n    \n    print(f"Start: {start_seg}, Goal: {goal_seg}")\n    \n    # BFS to find path\n    def find_path(start, goal):\n        queue = deque([(start, [start])])\n        visited = {start}\n        \n        while queue:\n            current, path = queue.popleft()\n            \n            if current == goal:\n                return path\n            \n            if current in transitions:\n                for next_seg, _ in transitions[current]:\n                    if next_seg not in visited:\n                        visited.add(next_seg)\n                        queue.append((next_seg, path + [next_seg]))\n        \n        return None\n    \n    path = find_path(start_seg, goal_seg)\n    \n    if path:\n        print(f"Path found: {path}")\n        \n        # Generate plan\n        plan_lines = []\n        for i in range(len(path) - 1):\n            from_seg = path[i]\n            to_seg = path[i+1]\n            action = action_map[(from_seg, to_seg)]\n            plan_lines.append(f"{action}({airplane})")\n        \n        # Write plan\n        with open(output_file, \'w\') as f:\n            for line in plan_lines:\n                f.write(line + \'\\n\')\n        \n        print(f"Plan written to {output_file}")\n        for line in plan_lines:\n            print(f"  {line}")\n    else:\n        print("No path found!")\n\n# Process task01\nprint("=== Task01 ===")\nparse_domain_and_generate_plan(\'/app/airport/domain01.pddl\', \'/app/airport/task01.pddl\', \'/app/task01.txt\')\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
