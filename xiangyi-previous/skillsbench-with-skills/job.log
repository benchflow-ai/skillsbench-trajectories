Sending keys: ['cat > simulation.py << \'EOF\'\nimport yaml\nimport pandas as pd\nimport math\nfrom acc_system import AdaptiveCruiseControl\n\ndef run_simulation():\n    # Load configuration\n    with open(\'vehicle_params.yaml\', \'r\') as f:\n        config = yaml.safe_load(f)\n    \n    # Load tuned gains if available\n    try:\n        with open(\'tuning_results.yaml\', \'r\') as f:\n            tuning = yaml.safe_load(f)\n            config[\'pid_speed\'] = tuning[\'pid_speed\']\n            config[\'pid_distance\'] = tuning[\'pid_distance\']\n            print("Loaded tuned gains")\n    except FileNotFoundError:\n        print("No tuning results found, using default gains")\n\n    # Initialize ACC\n    acc = AdaptiveCruiseControl(config)\n    dt = config[\'simulation\'][\'dt\']\n    \n    # Load sensor data\n    sensor_data = pd.read_csv(\'sensor_data.csv\')\n    \n    # Pre-calculate lead trajectory from sensor data\n    # We assume the recorded data is valid relative motion\n    # LeadPos(t) = RecEgoPos(t) + RecDistance(t)\n    rec_ego_pos = 0.0\n    lead_positions = []\n    lead_speeds = []\n    \n    for _, row in sensor_data.iterrows():\n        rec_ego_pos += row[\'ego_speed\'] * dt\n        if not pd.isna(row[\'distance\']):\n            lead_pos = rec_ego_pos + row[\'distance\']\n            lead_positions.append(lead_pos)\n            lead_speeds.append(row[\'lead_speed\'])\n        else:\n            lead_positions.append(None)\n            lead_speeds.append(None)\n            \n    # Simulation loop\n    results = []\n    sim_ego_speed = 0.0\n    sim_ego_pos = 0.0\n    \n    for i in range(len(sensor_data)):\n        t = sensor_data.iloc[i][\'time\']\n        lead_pos = lead_positions[i]\n        l_speed = lead_speeds[i]\n        \n        # Determine inputs for ACC\n        sim_dist = None\n        if lead_pos is not None:\n            sim_dist = lead_pos - sim_ego_pos\n            \n        # ACC Compute\n        accel_cmd, mode, dist_err = acc.compute(sim_ego_speed, l_speed, sim_dist, dt)\n        \n        # Update Physics\n        sim_ego_speed += accel_cmd * dt\n        sim_ego_speed = max(0.0, sim_ego_speed) # No reverse\n        sim_ego_pos += sim_ego_speed * dt\n        \n        # Calculate TTC for logging\n        ttc = None\n        if l_speed is not None and sim_dist is not None:\n            rel_speed = sim_ego_speed - l_speed\n            if rel_speed > 0:\n                ttc = sim_dist / rel_speed\n        \n        results.append({\n            \'time\': t,\n            \'ego_speed\': sim_ego_speed,\n            \'acceleration_cmd\': accel_cmd,\n            \'mode\': mode,\n            \'distance_error\': dist_err,\n            \'distance\': sim_dist,\n            \'ttc\': ttc\n        })\n    \n    # Save results\n    df_results = pd.DataFrame(results)\n    df_results.to_csv(\'simulation_results.csv\', index=False)\n    print("Simulation complete. Results saved to simulation_results.csv")\n\nif __name__ == \'__main__\':\n    run_simulation()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
