Sending keys: ['cat << \'EOF\' > solution.py\nimport openpyxl\n\nwb = openpyxl.load_workbook(\'gdp.xlsx\')\nws_task = wb[\'Task\']\n\n# Step 1: Fill in H12:L17, H19:L24, H26:L31\n# Formula: =INDEX(Data!$A$1:$M$100, MATCH($D12, Data!$B$1:$B$100, 0), MATCH(H$9, Data!$A$4:$M$4, 0))\nfor r in list(range(12, 18)) + list(range(19, 25)) + list(range(26, 32)):\n    for c in range(8, 13): # H to L\n        col_letter = openpyxl.utils.get_column_letter(c)\n        formula = f\'=INDEX(Data!$A$1:$M$100, MATCH($D{r}, Data!$B$1:$B$100, 0), MATCH({col_letter}$9, Data!$A$4:$M$4, 0))\'\n        ws_task.cell(row=r, column=c).value = formula\n\n# Step 2: Calculate net exports as % of GDP in H35:L40\nfor r in range(35, 41):\n    for c in range(8, 13):\n        col_letter = openpyxl.utils.get_column_letter(c)\n        # UAE is row 35, its data is in 12, 19, 26\n        # Bahrain is row 36, its data is in 13, 20, 27\n        # So for row r, data is in r-23, r-16, r-9\n        r_exp = r - 23\n        r_imp = r - 16\n        r_gdp = r - 9\n        formula = f"=({col_letter}{r_exp}-{col_letter}{r_imp})/{col_letter}{r_gdp}*100"\n        ws_task.cell(row=r, column=c).value = formula\n\n# Step 2: Stats in H42:L47\nstats = [\'MIN\', \'MAX\', \'MEDIAN\', \'AVERAGE\', \'PERCENTILE.INC\', \'PERCENTILE.INC\']\nfor i, stat in enumerate(stats):\n    row = 42 + i\n    for c in range(8, 13):\n        col_letter = openpyxl.utils.get_column_letter(c)\n        if \'PERCENTILE\' in stat:\n            p = 0.25 if i == 4 else 0.75\n            formula = f"={stat}({col_letter}$35:{col_letter}$40, {p})"\n        else:\n            formula = f"={stat}({col_letter}$35:{col_letter}$40)"\n        ws_task.cell(row=row, column=c).value = formula\n\n# Step 3: Weighted Mean in H50:L50\nfor c in range(8, 13):\n    col_letter = openpyxl.utils.get_column_letter(c)\n    # Weighted Mean = SUMPRODUCT(NetExports%GDP_Range, GDP_Range) / SUM(GDP_Range)\n    # NetExports%GDP: H35:H40, GDP: H26:H31\n    formula = f"=SUMPRODUCT({col_letter}35:{col_letter}40, {col_letter}26:{col_letter}31)/SUM({col_letter}26:{col_letter}31)"\n    ws_task.cell(row=50, column=c).value = formula\n\nwb.save(\'gdp.xlsx\')\nEOF\npython3 solution.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
