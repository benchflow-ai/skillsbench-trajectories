askEvent::fromCSV))\n        ).name("TaskEventSource");\n\n        // Filter for SUBMIT events (eventType = 4) and assign timestamps\n        DataStream<TaskEvent> submitEvents = taskEvents\n            .filter(new FilterFunction<TaskEvent>() {\n                @Override\n                public boolean filter(TaskEvent event) throws Exception {\n                    return event.eventType == 4; // SUBMIT event\n                }\n            })\n            .assignTimestampsAndWatermarks(\n                WatermarkStrategy.<TaskEvent>forMonotonousTimestamps()\n                    .withTimestampAssigner((event, recordTimestamp) -> event.timestamp)\n            )\n            .name("FilterSubmitEvents");\n\n        // Group by jobId and apply session window (10 minutes in seconds)\n        DataStream<Tuple2<Long, Long>> result = submitEvents\n            .keyBy(new org.apache.flink.api.java.functions.KeySelector<TaskEvent, Long>() {\n                @Override\n                public Long getKey(TaskEvent event) throws Exception {\n                    return event.jobId;\n                }\n            })\n            .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n            .apply(new WindowFunction<TaskEvent, Tuple2<Long, Long>, Long, TimeWindow>() {\n                @Override\n                public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> events, Collector<Tuple2<Long, Long>> out) throws Exception {\n                    long count = 0;\n                    for (TaskEvent event : events) {\n                        count++;\n                    }\n                    out.collect(new Tuple2<>(jobId, count));\n                }\n            })\n            .name("SessionWindow");\n\n        // Find max tasks per job\n        DataStream<Tuple2<Long, Long>> maxPerJob = result\n            .keyBy(new org.apache.flink.api.java.functions.KeySelector<Tuple2<Long, Long>, Long>() {\n                @Override\n                public Long getKey(Tuple2<Long, Long> value) throws Exception {\n                    return value.f0;\n                }\n            })\n            .reduce(new org.apache.flink.api.common.functions.ReduceFunction<Tuple2<Long, Long>>() {\n                @Override\n                public Tuple2<Long, Long> reduce(Tuple2<Long, Long> v1, Tuple2<Long, Long> v2) throws Exception {\n                    return new Tuple2<>(v1.f0, Math.max(v1.f1, v2.f1));\n                }\n            })\n            .name("FindMaxPerJob");\n\n        // Write to file\n        maxPerJob.addSink(new RichSinkFunction<Tuple2<Long, Long>>() {\n            private transient FileWriter writer;\n\n            @Override\n            public void open(org.apache.flink.configuration.Configuration parameters) throws Exception {\n                super.open(parameters);\n                writer = new FileWriter(outputPath, false);\n            }\n\n            @Override\n            public void invoke(Tuple2<Long, Long> value, Context context) throws Exception {\n                synchronized(writer) {\n                    writer.write("(" + value.f0 + "," + value.f1 + ")\\n");\n                    writer.flush();\n                }\n            }\n\n            @Override\n            public void close() throws Exception {\n                if (writer != null) {\n                    writer.close();\n                }\n                super.close();\n            }\n        }).name("FileSink");\n\n        env.execute("LongestSessionPerJob");\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
