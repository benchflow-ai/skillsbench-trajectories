.0000010706, 0.0005158568, -0.1126655495, 13.6175032, -57.96288\n\n    m_denom = f"({m_a}*POWER({bw_cell},4) + {m_b}*POWER({bw_cell},3) + {m_c}*POWER({bw_cell},2) + {m_d}*{bw_cell} + {m_e})"\n    f_denom = f"({f_a}*POWER({bw_cell},4) + {f_b}*POWER({bw_cell},3) + {f_c}*POWER({bw_cell},2) + {f_d}*{bw_cell} + {f_e})"\n    \n    # Formula: TotalKg * 500 / Denom\n    # Using ROUND to 3 digits as requested\n    formula = f"=ROUND({total_cell}*500/IF({sex_cell}=\\"M\\",{m_denom},{f_denom}),3)"\n    dots_sheet.cell(row=row_idx, column=dots_col).value = formula\n\nwb.save(\'/root/data/openipf.xlsx\')\nEOF\npython3 solution.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
