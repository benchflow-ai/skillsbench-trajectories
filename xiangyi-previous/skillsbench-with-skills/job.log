Sending keys: ['cat <<EOF > solve.py\nimport pycbc.frame\nimport pycbc.filter\nimport pycbc.waveform\nimport pycbc.psd\nimport numpy as np\nimport sys\nimport time\n\ndata_file = "/root/data/PyCBC_T2_2.gwf"\nchannel_name = "H1:TEST-STRAIN"\n\nprint("Reading frame...")\nstrain = pycbc.frame.read_frame(data_file, channel_name)\n\n# Conditioning\nprint("Conditioning...")\nstrain = pycbc.filter.resample_to_delta_t(strain, 1.0/2048)\nstrain = pycbc.filter.highpass(strain, 15.0)\nstrain = strain.crop(2, 2)\n\n# PSD estimation\nprint("Computing PSD...")\nseg_len = int(4 * strain.sample_rate)\nseg_stride = int(seg_len / 2)\npsd = pycbc.psd.welch(strain,\n                      seg_len=seg_len,\n                      seg_stride=seg_stride,\n                      avg_method=\'median\')\npsd = pycbc.psd.interpolate(psd, strain.delta_f)\npsd = pycbc.psd.inverse_spectrum_truncation(psd, int(4 * strain.sample_rate),\n                                          low_frequency_cutoff=15.0)\n\napproximants = ["SEOBNRv4_opt", "IMRPhenomD", "TaylorT4"]\nmass_range = range(10, 41)\n\nresults = []\n\nf_lower = 20.0\n\nfor approx in approximants:\n    print(f"Processing {approx}...")\n    best_snr = 0.0\n    best_total_mass = 0.0\n    \n    count = 0\n    start_time = time.time()\n    for m1 in mass_range:\n        for m2 in mass_range:\n            if m2 < m1:\n                continue\n                \n            count += 1\n            if count % 50 == 0:\n                elapsed = time.time() - start_time\n                print(f"  Iteration {count} (elapsed: {elapsed:.1f}s)...")\n            \n            try:\n                if approx == "IMRPhenomD":\n                     hp, _ = pycbc.waveform.get_fd_waveform(approximant=approx, \n                                                         mass1=m1, mass2=m2, \n                                                         delta_f=strain.delta_f, \n                                                         f_lower=f_lower)\n                     hp.resize(len(strain) // 2 + 1)\n                else:\n                     hp, _ = pycbc.waveform.get_td_waveform(approximant=approx, \n                                                         mass1=m1, mass2=m2, \n                                                         delta_t=strain.delta_t, \n                                                         f_lower=f_lower)\n                     hp.resize(len(strain))\n                     hp = hp.to_frequencyseries()\n                \n                snr = pycbc.filter.matched_filter(hp, strain, psd=psd, low_frequency_cutoff=f_lower)\n                peak = abs(snr).max()\n                \n                if peak > best_snr:\n                    best_snr = peak\n                    best_total_mass = m1 + m2\n            except Exception as e:\n                print(f"Error with {approx} m1={m1} m2={m2}: {e}")\n                continue\n    \n    print(f"Result for {approx}: SNR={best_snr}, Mass={best_total_mass}")\n    results.append((approx, best_snr, best_total_mass))\n\nwith open("/root/detection_results.csv", "w") as f:\n    f.write("approximant,snr,total_mass\\n")\n    for r in results:\n        f.write(f"{r[0]},{r[1]},{r[2]}\\n")\n\nprint("Done.")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
