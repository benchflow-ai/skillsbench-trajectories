Sending keys: ['cat << \'EOF\' > /root/workspace/parallel_solution.py\nimport math\nimport time\nimport multiprocessing\nfrom collections import defaultdict\nfrom dataclasses import dataclass, field\nfrom heapq import nlargest\nfrom sequential import TFIDFIndex, SearchResult, tokenize, compute_term_frequencies, STOP_WORDS, TOKEN_PATTERN\nfrom document_generator import Document\n\n@dataclass\nclass ParallelIndexingResult:\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\ndef _tokenize_and_count_worker(docs):\n    doc_tfs = {}\n    local_df = defaultdict(int)\n    local_vocab = set()\n    for doc in docs:\n        text = doc.title + " " + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        doc_tfs[doc.doc_id] = tf\n        for term in tf:\n            local_df[term] += 1\n        local_vocab.update(tf.keys())\n    return doc_tfs, local_df, local_vocab\n\ndef build_tfidf_index_parallel(documents, num_workers=None, chunk_size=500):\n    start_time = time.perf_counter()\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n\n    pool = multiprocessing.Pool(processes=num_workers)\n    \n    # Step 1 & 2: Tokenize and count DF\n    chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]\n    results = pool.map(_tokenize_and_count_worker, chunks)\n\n    doc_term_freqs = {}\n    global_df = defaultdict(int)\n    vocabulary = set()\n    \n    for tfs, dfs, vocab in results:\n        doc_term_freqs.update(tfs)\n        vocabulary.update(vocab)\n        for term, count in dfs.items():\n            global_df[term] += count\n\n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n    index.vocabulary = vocabulary\n    index.document_frequencies = dict(global_df)\n\n    # Step 3: Compute IDF scores\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n\n    # Step 4 & 5: Build inverted index and doc vectors (Sequential for now, as they are fast once we have TFs and IDF)\n    # Actually, Step 4 & 5 in sequential were slow because of the nested loops.\n    # Let\'s optimize them.\n\n    for doc_id, tf_dict in doc_term_freqs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * index.idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n            \n            if term not in index.inverted_index:\n                index.inverted_index[term] = []\n            index.inverted_index[term].append((doc_id, tfidf))\n        \n        index.doc_vectors[doc_id] = doc_vector\n        index.doc_norms[doc_id] = math.sqrt(norm_squared)\n\n    # Sort inverted index posting lists\n    for term in index.inverted_index:\n        index.inverted_index[term].sort(key=lambda x: x[1], reverse=True)\n\n    pool.close()\n    pool.join()\n\n    elapsed = time.perf_counter() - start_time\n    return ParallelIndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\n\n_global_index = None\n\ndef _init_search_worker(index):\n    global _global_index\n    _global_index = index\n\ndef _search_worker_optimized(args):\n    from sequential import tokenize, compute_term_frequencies\n    query, top_k, documents = args\n    index = _global_index\n    \n    query_tokens = tokenize(query)\n    if not query_tokens: return []\n    query_tf = compute_term_frequencies(query_tokens)\n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in index.idf:\n            tfidf = tf * index.idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n    if not query_vector: return []\n    query_norm = math.sqrt(query_norm_squared)\n    candidate_docs = set()\n    for term in query_vector:\n        if term in index.inverted_index:\n            for doc_id, _ in index.inverted_index[term]:\n                candidate_docs.add(doc_id)\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = index.doc_vectors.get(doc_id, {})\n        doc_norm = index.doc_norms.get(doc_id, 0)\n        if doc_norm == 0: continue\n        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector if term in doc_vector)\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    results = []\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n    for doc_id, score in top_results:\n        results.append(SearchResult(doc_id=doc_id, score=score, title=doc_titles.get(doc_id, f"Document {doc_id}")))\n    return results\n\ndef batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\n    start_time = time.perf_counter()\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n    \n    # Using initializer to share index among workers once\n    pool = multiprocessing.Pool(processes=num_workers, initializer=_init_search_worker, initargs=(index,))\n    search_args = [(query, top_k, documents) for query in queries]\n    results = pool.map(_search_worker_optimized, search_args)\n    pool.close()\n    pool.join()\n    \n    elapsed = time.perf_counter() - start_time\n    return results, elapsed\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
