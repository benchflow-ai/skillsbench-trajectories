.append({\n                'id': emp_id,\n                'field': field,\n                'old_value': old_val,\n                'new_value': new_val\n            })\n\nprint(f'Modified records: {len(modified)}')\n\n# Sort modified by ID\nmodified.sort(key=lambda x: x['id'])\n\n# Create result\nresult = {\n    'deleted_employees': deleted,\n    'modified_employees': modified\n}\n\n# Write to file\nwith open('/root/diff_report.json', 'w') as f:\n    json.dump(result, f, indent=2)\n\nprint('Report written to /root/diff_report.json')\nprint('\\nFirst 5 deleted:', deleted[:5])\nprint('First 5 modified:', modified[:5])\nSCRIPT\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
