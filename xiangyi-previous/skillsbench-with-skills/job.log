alse\n\ndef get_available_time_after_downtime(machine, start, duration, downtime):\n    """Find the earliest time >= start when operation can fit without downtime conflict"""\n    if machine not in downtime:\n        return start\n    \n    current_start = start\n    while True:\n        current_end = current_start + duration\n        conflict = False\n        for dt_start, dt_end in downtime[machine]:\n            if not (current_end <= dt_start or current_start >= dt_end):\n                current_start = dt_end\n                conflict = True\n                break\n        if not conflict:\n            return current_start\n\ndef solve_schedule_improved(num_jobs, num_machines, jobs, downtime, policy, baseline):\n    """Improved job shop scheduling with downtime constraints"""\n    \n    freeze_until = policy.get(\'freeze\', {}).get(\'freeze_until\', 0)\n    baseline_schedule = {(op[\'job\'], op[\'op\']): op for op in baseline[\'schedule\']}\n    \n    # Track state\n    schedule = {}\n    machine_events = [[] for _ in range(num_machines)]  # List of (end_time, job, op)\n    job_last_op = [-1] * num_jobs  # Last operation end time for each job\n    \n    # Priority queue: (earliest_possible_start, job, op)\n    priority_queue = []\n    scheduled_ops = set()\n    \n    # Start with first operation of each job\n    for job_id in range(num_jobs):\n        heapq.heappush(priority_queue, (0, job_id, 0))\n    \n    while priority_queue:\n        _, job_id, op_id = heapq.heappop(priority_queue)\n        \n        if (job_id, op_id) in scheduled_ops:\n            continue\n        \n        # Check if previous operation is done\n        if op_id > 0 and (job_id, op_id - 1) not in scheduled_ops:\n            heapq.heappush(priority_queue, (job_last_op[job_id], job_id, op_id))\n            continue\n        \n        alternatives = jobs[job_id][op_id]\n        best_schedule = None\n        best_end_time = float(\'inf\')\n        \n        # Check if frozen\n        is_frozen = (job_id, op_id) in baseline_schedule and \\\n                    baseline_schedule[(job_id, op_id)][\'end\'] <= freeze_until\n        \n        if is_frozen:\n            baseline_op = baseline_schedule[(job_id, op_id)]\n            machine = baseline_op[\'machine\']\n            duration = baseline_op[\'dur\']\n            start = baseline_op[\'start\']\n            end = baseline_op[\'end\']\n            \n            if not check_downtime_conflict(machine, start, end, downtime):\n                best_schedule = (machine, start, end, duration)\n                best_end_time = end\n        else:\n            # Try each alternative\n            for machine, duration in alternatives:\n                # Earliest start time\n                earliest_start = job_last_op[job_id] + 1 if job_last_op[job_id] >= 0 else 0\n                \n                # Get machine free time\n                if machine_events[machine]:\n                    machine_free = machine_events[machine][-1][0]\n                else:\n                    machine_free = 0\n                \n                earliest_start = max(earliest_start, machine_free)\n                \n                # Adjust for downtime\n                start = get_available_time_after_downtime(machine, earliest_start, duration, downtime)\n                end = start + duration\n                \n                if end < best_end_time:\n                    best_end_time = end\n                    best_schedule = (machine, start, end, duration)\n        \n        if best_schedule:\n            machine, start, end, duration = best_schedule\n            schedule[(job_id, op_id)] = {\n                \'job\': job_id,\n                \'op\': op_id,\n                \'machine\': machine,\n                \'start\': start,\n                \'end\': end,\n                \'dur\': duration\n            }\n            machine_events[machine].append((end, job_id, op_id))\n            machine_events[machine].sort()\n            job_last_op[job_id] = end\n            scheduled_ops.add((job_id, op_id))\n            \n            # Add next operation to queue\n            if op_id + 1 < len(jobs[job_id]):\n                heapq.heappush(priority_queue, (end, job_id, op_id + 1))\n    \n    # Convert to list\n    schedule_list = [schedule[(job_id, op_id)] \n                     for job_id in range(num_jobs) \n                     for op_id in range(len(jobs[job_id]))]\n    schedule_list.sort(key=lambda x: (x[\'start\'], x[\'job\'], x[\'op\']))\n    \n    makespan = max(op[\'end\'] for op in schedule_list) if schedule_list else 0\n    \n    return schedule_list, makespan\n\ndef main():\n    num_jobs, num_machines, jobs = parse_instance(\'/app/data/instance.txt\')\n    downtime = parse_downtime(\'/app/data/downtime.csv\')\n    policy = parse_policy(\'/app/data/policy.json\')\n    baseline = parse_baseline(\'/app/data/baseline_solution.json\')\n    \n    schedule, makespan = solve_schedule_improved(num_jobs, num_machines, jobs, downtime, policy, baseline)\n    \n    violations = 0\n    for op in schedule:\n        if check_downtime_conflict(op[\'machine\'], op[\'start\'], op[\'end\'], downtime):\n            violations += 1\n    \n    status = "FEASIBLE" if violations == 0 else "INFEASIBLE"\n    \n    solution = {\n        "status": status,\n        "makespan": makespan,\n        "schedule": schedule\n    }\n    \n    with open(\'/app/output/solution.json\', \'w\') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open(\'/app/output/schedule.csv\', \'w\') as f:\n        writer = csv.DictWriter(f, fieldnames=[\'job\', \'op\', \'machine\', \'start\', \'end\', \'dur\'])\n        writer.writeheader()\n        for op in schedule:\n            writer.writerow(op)\n    \n    print(f"Schedule generated successfully!")\n    print(f"Status: {status}")\n    print(f"Makespan: {makespan}")\n    print(f"Downtime violations: {violations}")\n    print(f"Guard constraint (max {int(baseline[\'makespan\'] * 1.1)}): {\'PASS\' if makespan <= baseline[\'makespan\'] * 1.1 else \'FAIL\'}")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.2 max_timeout_sec: 180.0
