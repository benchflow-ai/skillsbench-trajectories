Sending keys: ['cat > solve_tasks.py << \'EOF\'\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\n# Task 1: basic_reduce - compute mean of each row\ndef task_basic_reduce():\n    x = np.load(\'data/x.npy\')\n    x_jax = jnp.array(x)\n    result = jnp.mean(x_jax, axis=1)\n    np.save(\'basic_reduce.npy\', np.array(result))\n    print("Task 1 (basic_reduce) completed")\n\n# Task 2: map_square - apply square function to each element\ndef task_map_square():\n    x = np.load(\'data/x.npy\')\n    x_jax = jnp.array(x)\n    result = jnp.square(x_jax)\n    np.save(\'map_square.npy\', np.array(result))\n    print("Task 2 (map_square) completed")\n\n# Task 3: grad_logistic - compute gradient of logistic loss\ndef task_grad_logistic():\n    data = np.load(\'data/logistic.npz\')\n    x = jnp.array(data[\'x\'])\n    y = jnp.array(data[\'y\'])\n    w = jnp.array(data[\'w\'])\n    \n    def logistic_loss(w):\n        logits = x @ w\n        return jnp.mean(jnp.logaddexp(0, -y * logits))\n    \n    gradient = jax.grad(logistic_loss)(w)\n    np.save(\'grad_logistic.npy\', np.array(gradient))\n    print("Task 3 (grad_logistic) completed")\n\n# Task 4: scan_rnn - implement RNN forward pass using scan\ndef task_scan_rnn():\n    data = np.load(\'data/seq.npz\')\n    seq = jnp.array(data[\'seq\'])\n    Wx = jnp.array(data[\'Wx\'])\n    Wh = jnp.array(data[\'Wh\'])\n    b = jnp.array(data[\'b\'])\n    \n    def rnn_step(h, x):\n        h_new = jnp.tanh(Wx @ x + Wh @ h + b)\n        return h_new, h_new\n    \n    h0 = jnp.zeros(Wh.shape[0])\n    final_state, all_states = jax.lax.scan(rnn_step, h0, seq)\n    np.save(\'scan_rnn.npy\', np.array(all_states))\n    print("Task 4 (scan_rnn) completed")\n\n# Task 5: jit_mlp - implement and JIT compile a 2-layer MLP\ndef task_jit_mlp():\n    data = np.load(\'data/mlp.npz\')\n    X = jnp.array(data[\'X\'])\n    W1 = jnp.array(data[\'W1\'])\n    b1 = jnp.array(data[\'b1\'])\n    W2 = jnp.array(data[\'W2\'])\n    b2 = jnp.array(data[\'b2\'])\n    \n    @jax.jit\n    def mlp(x, w1, b1, w2, b2):\n        hidden = jnp.tanh(jnp.dot(x, w1) + b1)\n        output = jnp.dot(hidden, w2) + b2\n        return output\n    \n    result = mlp(X, W1, b1, W2, b2)\n    np.save(\'jit_mlp.npy\', np.array(result))\n    print("Task 5 (jit_mlp) completed")\n\nif __name__ == \'__main__\':\n    task_basic_reduce()\n    task_map_square()\n    task_grad_logistic()\n    task_scan_rnn()\n    task_jit_mlp()\n    print("\\nAll tasks completed!")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
