Sending keys: ['cat > convert_to_audio.py << \'EOF\'\nimport os\nfrom bs4 import BeautifulSoup\nfrom openai import OpenAI\nimport re\n\n# Initialize OpenAI client\nclient = OpenAI(api_key=os.environ.get(\'OPENAI_API_KEY\'))\n\ndef extract_text_from_html(html_file):\n    """Extract main text content from Paul Graham essay HTML"""\n    with open(html_file, \'r\', encoding=\'utf-8\') as f:\n        html_content = f.read()\n    \n    soup = BeautifulSoup(html_content, \'html.parser\')\n    \n    # Get title\n    title = soup.find(\'title\')\n    title_text = title.get_text() if title else "Essay"\n    \n    # Find the main content - Paul Graham\'s essays have text in font tags with size=2 face=verdana\n    content = []\n    \n    # Get all text from font tags\n    for font_tag in soup.find_all(\'font\', {\'size\': \'2\', \'face\': \'verdana\'}):\n        text = font_tag.get_text(separator=\' \', strip=True)\n        # Clean up the text\n        text = re.sub(r\'\\s+\', \' \', text)\n        if len(text) > 100:  # Only include substantial text blocks\n            content.append(text)\n    \n    # Combine title and content\n    full_text = f"{title_text}. " + \' \'.join(content)\n    return full_text\n\ndef text_to_speech(text, output_file):\n    """Convert text to speech using OpenAI TTS API"""\n    print(f"Converting text to speech... ({len(text)} characters)")\n    \n    # OpenAI TTS has a limit, so we might need to chunk\n    # The limit is around 4096 characters per request\n    max_chars = 4000\n    \n    if len(text) <= max_chars:\n        # Single request\n        response = client.audio.speech.create(\n            model="tts-1",\n            voice="alloy",\n            input=text\n        )\n        response.stream_to_file(output_file)\n    else:\n        # Need to chunk and combine\n        chunks = []\n        sentences = text.split(\'. \')\n        current_chunk = ""\n        \n        for sentence in sentences:\n            if len(current_chunk) + len(sentence) < max_chars:\n                current_chunk += sentence + ". "\n            else:\n                if current_chunk:\n                    chunks.append(current_chunk)\n                current_chunk = sentence + ". "\n        \n        if current_chunk:\n            chunks.append(current_chunk)\n        \n        print(f"Processing {len(chunks)} chunks...")\n        \n        # Generate audio for each chunk and combine\n        temp_files = []\n        for i, chunk in enumerate(chunks):\n            temp_file = f"temp_chunk_{i}.mp3"\n            print(f"  Chunk {i+1}/{len(chunks)}...")\n            response = client.audio.speech.create(\n                model="tts-1",\n                voice="alloy",\n                input=chunk\n            )\n            response.stream_to_file(temp_file)\n            temp_files.append(temp_file)\n        \n        # Combine all chunks using ffmpeg or simple concatenation\n        # For MP3, we can use binary concatenation (simple approach)\n        with open(output_file, \'wb\') as outfile:\n            for temp_file in temp_files:\n                with open(temp_file, \'rb\') as infile:\n                    outfile.write(infile.read())\n                os.remove(temp_file)\n        \n        print(f"Combined {len(chunks)} chunks into {output_file}")\n\nif __name__ == "__main__":\n    print("Extracting text from essays...")\n    \n    # Extract text from both essays\n    essay1_text = extract_text_from_html(\'essay1.html\')\n    essay2_text = extract_text_from_html(\'essay2.html\')\n    \n    print(f"Essay 1: {len(essay1_text)} characters")\n    print(f"Essay 2: {len(essay2_text)} characters")\n    \n    # Combine both essays with a separator\n    combined_text = essay1_text + " ... Next essay: ... " + essay2_text\n    \n    print(f"\\nTotal text: {len(combined_text)} characters")\n    print("\\nGenerating audiobook...")\n    \n    # Convert to speech\n    text_to_speech(combined_text, \'/root/audiobook.mp3\')\n    \n    print("\\nAudiobook created successfully at /root/audiobook.mp3")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
