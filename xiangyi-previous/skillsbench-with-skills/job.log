Sending keys: ['cat >> solve_dcopf_fast.py << \'EOF\'\n    \n    # Generator-bus matrix\n    Cg = np.zeros((n_bus, n_gen))\n    Cg[gen_bus_idx, np.arange(n_gen)] = 1\n    \n    # Variables\n    Pg = cp.Variable(n_gen, nonneg=True)\n    R = cp.Variable(n_gen, nonneg=True)\n    \n    # Objective\n    obj = cp.sum(cp.multiply(c2, cp.square(Pg)) + cp.multiply(c1, Pg) + c0 + cp.multiply(res_cost, R))\n    \n    # Constraints\n    cons = [Pg >= Pmin, Pg + R <= Pmax, R <= reserve_cap]\n    cons.append(cp.sum(Pg) == np.sum(Pd))  # Power balance\n    \n    # Line limits - only constrained lines\n    P_inj = Cg @ Pg - Pd\n    constrained = active & (rate_a > 0) & (rate_a < 50000)\n    con_idx = np.where(constrained)[0]\n    \n    # Use matrix form for line constraints\n    PTDF_con = PTDF[con_idx, :]\n    rate_con = rate_a[con_idx]\n    flow = PTDF_con @ P_inj\n    cons.append(flow <= rate_con)\n    cons.append(flow >= -rate_con)\n    \n    cons.append(cp.sum(R) >= reserve_req)  # Reserve requirement\n    \n    prob = cp.Problem(cp.Minimize(obj), cons)\n    prob.solve(solver=cp.ECOS, verbose=False)\n    \n    if prob.status not in [\'optimal\', \'optimal_inaccurate\']:\n        print(f"Status: {prob.status}")\n        return None\n    \n    # Extract results\n    Pg_v, R_v = Pg.value, R.value\n    P_inj_v = Cg @ Pg_v - Pd\n    \n    # Duals\n    lam = cons[3].dual_value if cons[3].dual_value is not None else 0\n    mu_pos = cons[4].dual_value if cons[4].dual_value is not None else np.zeros(len(con_idx))\n    mu_neg = cons[5].dual_value if cons[5].dual_value is not None else np.zeros(len(con_idx))\n    res_dual = cons[6].dual_value if cons[6].dual_value is not None else 0\n    \n    # LMPs\n    lmp = np.full(n_bus, lam)\n    for i, l in enumerate(con_idx):\n        lmp += (mu_pos[i] - mu_neg[i]) * PTDF[l, :]\n    \n    # Binding lines\n    binding = []\n    flows = PTDF @ P_inj_v\n    for l in range(n_br):\n        if br_status[l] > 0 and rate_a[l] > 0 and rate_a[l] < 50000:\n            if abs(flows[l]) / rate_a[l] >= 0.99:\n                binding.append({\'from\': int(branches[l,0]), \'to\': int(branches[l,1]),\n                               \'flow_MW\': round(abs(flows[l]),2), \'limit_MW\': round(rate_a[l],2)})\n    \n    lmp_list = [{\'bus\': int(bus_ids[i]), \'lmp_dollars_per_MWh\': round(lmp[i],4)} for i in range(n_bus)]\n    \n    return {\'total_cost_dollars_per_hour\': round(prob.value,2), \'lmp_by_bus\': lmp_list,\n            \'reserve_mcp_dollars_per_MWh\': round(abs(res_dual),4), \'binding_lines\': binding}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
