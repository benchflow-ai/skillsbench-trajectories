PWCTLONIRQ], arg ptr[in, int8])\n\n# Clear (and return) interrupt count\nioctl$PPCLRIRQ(fd fd_ppdev, cmd const[PPCLRIRQ], arg ptr[out, int32])\n\n# Set the IEEE 1284 phase\nioctl$PPSETPHASE(fd fd_ppdev, cmd const[PPSETPHASE], arg ptr[in, int32])\n\n# Set and get port timeout (struct timeval\'s)\nioctl$PPGETTIME(fd fd_ppdev, cmd const[PPGETTIME], arg ptr[out, timeval])\nioctl$PPSETTIME(fd fd_ppdev, cmd const[PPSETTIME], arg ptr[in, timeval])\n\n# Get available modes (what the hardware can do)\nioctl$PPGETMODES(fd fd_ppdev, cmd const[PPGETMODES], arg ptr[out, flags[ieee1284_modes, int32]])\n\n# Get the current mode and phase\nioctl$PPGETMODE(fd fd_ppdev, cmd const[PPGETMODE], arg ptr[out, flags[ieee1284_modes, int32]])\nioctl$PPGETPHASE(fd fd_ppdev, cmd const[PPGETPHASE], arg ptr[out, int32])\n\n# Get/set flags\nioctl$PPGETFLAGS(fd fd_ppdev, cmd const[PPGETFLAGS], arg ptr[out, flags[ppdev_flags, int32]])\nioctl$PPSETFLAGS(fd fd_ppdev, cmd const[PPSETFLAGS], arg ptr[in, flags[ppdev_flags, int32]])\n\nppdev_frob_struct {\n        mask    int8\n        val     int8\n}\n\nieee1284_modes = IEEE1284_MODE_NIBBLE, IEEE1284_MODE_BYTE, IEEE1284_MODE_COMPAT, IEEE1284_MODE_ECP, IEEE1284_MODE_ECPRLE, IEEE1284_MODE_ECPSWE, IEEE1284_MODE_EPP, IEEE1284_MODE_BECP, IEEE1284_MODE_EPPSL, IEEE1284_MODE_EPPSWE\n\nppdev_flags = PP_FASTWRITE, PP_FASTREAD, PP_W91284PIC\nEOFFILE\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
