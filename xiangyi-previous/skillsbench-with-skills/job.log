Sending keys: ['cat > /root/solve.py << \'EOF\'\nimport geopandas as gpd\nimport pandas as pd\nimport json\nfrom shapely.geometry import Point, MultiLineString, LineString\nfrom shapely.ops import unary_union\nimport numpy as np\nfrom datetime import datetime, timezone\n\n# Load earthquake data\nwith open(\'/root/earthquakes_2024.json\', \'r\') as f:\n    eq_data = json.load(f)\n\n# Load plate data\nplates = gpd.read_file(\'/root/PB2002_plates.json\')\nboundaries = gpd.read_file(\'/root/PB2002_boundaries.json\')\n\n# Find Pacific plate\npacific_plate = plates[plates[\'PlateName\'] == \'Pacific\']\npacific_polygon = pacific_plate.geometry.values[0]\n\n# Find Pacific plate boundaries (where PlateA or PlateB is \'PA\')\npacific_boundaries = boundaries[(boundaries[\'PlateA\'] == \'PA\') | (boundaries[\'PlateB\'] == \'PA\')]\n\n# Combine all boundary segments into a single geometry\npacific_boundary_union = unary_union(pacific_boundaries.geometry.values)\n\n# Create earthquake GeoDataFrame\neq_features = eq_data[\'features\']\neq_list = []\nfor f in eq_features:\n    props = f[\'properties\']\n    coords = f[\'geometry\'][\'coordinates\']\n    eq_list.append({\n        \'id\': f[\'id\'],\n        \'mag\': props[\'mag\'],\n        \'place\': props[\'place\'],\n        \'time\': props[\'time\'],\n        \'longitude\': coords[0],\n        \'latitude\': coords[1],\n        \'depth\': coords[2] if len(coords) > 2 else None,\n        \'geometry\': Point(coords[0], coords[1])\n    })\n\neq_gdf = gpd.GeoDataFrame(eq_list, crs=\'EPSG:4326\')\n\n# Filter earthquakes within Pacific plate\neq_in_pacific = eq_gdf[eq_gdf.geometry.within(pacific_polygon)].copy()\nprint(f"Earthquakes in Pacific plate: {len(eq_in_pacific)}")\n\n# Create boundary GeoDataFrame for projection\nboundary_gdf = gpd.GeoDataFrame(geometry=[pacific_boundary_union], crs=\'EPSG:4326\')\n\n# Use an azimuthal equidistant projection centered in the Pacific\n# Center at approximately 180 longitude (dateline) and 0 latitude\naeqd_crs = \'+proj=aeqd +lat_0=0 +lon_0=-160 +x_0=0 +y_0=0 +datum=WGS84 +units=m +no_defs\'\n\n# Project to AEQD\neq_in_pacific_proj = eq_in_pacific.to_crs(aeqd_crs)\nboundary_proj = boundary_gdf.to_crs(aeqd_crs)\nboundary_geom_proj = boundary_proj.geometry.values[0]\n\n# Calculate distance from each earthquake to the boundary\ndistances = []\nfor idx, row in eq_in_pacific_proj.iterrows():\n    dist = row.geometry.distance(boundary_geom_proj)\n    distances.append(dist)\n\neq_in_pacific_proj[\'distance_m\'] = distances\neq_in_pacific_proj[\'distance_km\'] = eq_in_pacific_proj[\'distance_m\'] / 1000\n\n# Find earthquake with maximum distance\nmax_idx = eq_in_pacific_proj[\'distance_km\'].idxmax()\nfurthest_eq = eq_in_pacific_proj.loc[max_idx]\n\nprint(f"\\nFurthest earthquake from Pacific plate boundary:")\nprint(f"ID: {furthest_eq[\'id\']}")\nprint(f"Place: {furthest_eq[\'place\']}")\nprint(f"Magnitude: {furthest_eq[\'mag\']}")\nprint(f"Latitude: {furthest_eq[\'latitude\']}")\nprint(f"Longitude: {furthest_eq[\'longitude\']}")\nprint(f"Distance: {furthest_eq[\'distance_km\']:.2f} km")\nprint(f"Time (ms): {furthest_eq[\'time\']}")\n\n# Convert time from milliseconds to ISO 8601 format\ntime_ms = furthest_eq[\'time\']\ntime_dt = datetime.fromtimestamp(time_ms / 1000, tz=timezone.utc)\ntime_iso = time_dt.strftime(\'%Y-%m-%dT%H:%M:%SZ\')\nprint(f"Time (ISO): {time_iso}")\n\n# Create output JSON\nresult = {\n    \'id\': furthest_eq[\'id\'],\n    \'place\': furthest_eq[\'place\'],\n    \'time\': time_iso,\n    \'magnitude\': furthest_eq[\'mag\'],\n    \'latitude\': furthest_eq[\'latitude\'],\n    \'longitude\': furthest_eq[\'longitude\'],\n    \'distance_km\': round(furthest_eq[\'distance_km\'], 2)\n}\n\nwith open(\'/root/answer.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\n\nprint(f"\\nResult saved to /root/answer.json")\nprint(json.dumps(result, indent=2))\n\nEOF\npython3 /root/solve.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
