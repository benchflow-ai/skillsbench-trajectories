Sending keys: ['cat > parallel_solution.py << \'EOF\'\n#!/usr/bin/env python3\n"""\nParallel TF-IDF Implementation\n\nThis module provides parallel implementations of:\n1. TF-IDF index building with parallel document processing\n2. Batch search with parallel query processing\n"""\n\nimport math\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor, as_completed\nfrom dataclasses import dataclass\nfrom typing import List, Optional, Tuple\nimport multiprocessing as mp\n\nfrom sequential import (\n    TFIDFIndex,\n    SearchResult,\n    tokenize,\n    compute_term_frequencies,\n)\nfrom document_generator import Document\n\n\n# ============================================================================\n# Data Structures\n# ============================================================================\n\n\n@dataclass\nclass ParallelIndexingResult:\n    """Result from parallel index building."""\n\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\n# ============================================================================\n# Parallel Index Building\n# ============================================================================\n\n\ndef _process_document_chunk(docs_chunk: List[Document]) -> Tuple[dict, dict, set]:\n    """\n    Process a chunk of documents to compute term frequencies.\n    \n    Args:\n        docs_chunk: List of Document objects to process\n    \n    Returns:\n        Tuple of (doc_term_freqs, doc_terms, vocabulary)\n    """\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    for doc in docs_chunk:\n        text = doc.title + " " + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        doc_term_freqs[doc.doc_id] = tf\n        doc_terms[doc.doc_id] = set(tf.keys())\n        vocabulary.update(tf.keys())\n    \n    return doc_term_freqs, doc_terms, vocabulary\n\n\ndef build_tfidf_index_parallel(\n    documents: List[Document],\n    num_workers: Optional[int] = None,\n    chunk_size: int = 500,\n) -> ParallelIndexingResult:\n    """\n    Build TF-IDF inverted index in parallel.\n    \n    Steps:\n    1. Tokenize documents in parallel chunks and compute term frequencies\n    2. Merge results and calculate document frequencies\n    3. Compute IDF scores\n    4. Build inverted index with TF-IDF scores\n    5. Compute document vector norms for cosine similarity\n    \n    Args:\n        documents: List of Document objects to index\n        num_workers: Number of worker processes (None = CPU count)\n        chunk_size: Number of documents per chunk\n    \n    Returns:\n        ParallelIndexingResult with the built index and timing info\n    """\n    start_time = time.perf_counter()\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n    \n    # Step 1: Tokenize documents and compute TF in parallel\n    doc_term_freqs = {}\n    doc_terms = {}\n    vocabulary = set()\n    \n    # Optimize chunk size for better parallelism\n    # Aim for 4-6x more chunks than workers\n    optimal_chunks = num_workers * 5\n    optimal_chunk_size = max(50, len(documents) // optimal_chunks)\n    actual_chunk_size = min(chunk_size, optimal_chunk_size)\n    \n    chunks = []\n    for i in range(0, len(documents), actual_chunk_size):\n        chunks.append(documents[i:i + actual_chunk_size])\n    \n    # Process chunks in parallel\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\n        \n        for future in as_completed(futures):\n            chunk_term_freqs, chunk_terms, chunk_vocab = future.result()\n            doc_term_freqs.update(chunk_term_freqs)\n            doc_terms.update(chunk_terms)\n            vocabulary.update(chunk_vocab)\n    \n    index.vocabulary = vocabulary\n    \n    # Step 2: Calculate document frequencies (sequential - fast)\n    for term in index.vocabulary:\n        df = sum(1 for doc_id in doc_terms if term in doc_terms[doc_id])\n        index.document_frequencies[term] = df\n    \n    # Step 3: Compute IDF scores (sequential - fast)\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n    \n    # Step 4: Build inverted index with TF-IDF scores (sequential - fast)\n    for term in index.vocabulary:\n        posting_list = []\n        for doc_id, tf_dict in doc_term_freqs.items():\n            if term in tf_dict:\n                tf = tf_dict[term]\n                tfidf = tf * index.idf[term]\n                posting_list.append((doc_id, tfidf))\n        posting_list.sort(key=lambda x: x[1], reverse=True)\n        index.inverted_index[term] = posting_list\n    \n    # Step 5: Build document vectors and compute norms (sequential - fast)\n    for doc_id, tf_dict in doc_term_freqs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * index.idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n        index.doc_vectors[doc_id] = doc_vector\n        index.doc_norms[doc_id] = math.sqrt(norm_squared)\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed,\n        num_documents=len(documents),\n        vocabulary_size=len(index.vocabulary),\n    )\n\n\n# ============================================================================\n# Parallel Search Functions\n# ============================================================================\n\n\ndef _search_query_batch(args):\n    """\n    Search a batch of queries (for multiprocessing).\n    \n    Args:\n        args: Tuple of (queries, index, top_k, doc_titles)\n    \n    Returns:\n        List of search results for each query\n    """\n    queries, index, top_k, doc_titles = args\n    from heapq import nlargest\n    \n    results = []\n    for query in queries:\n        # Tokenize query\n        query_tokens = tokenize(query)\n        if not query_tokens:\n            results.append([])\n            continue\n        \n        # Compute query TF\n        query_tf = compute_term_frequencies(query_tokens)\n        \n        # Compute query TF-IDF vector\n        query_vector = {}\n        query_norm_squared = 0.0\n        for term, tf in query_tf.items():\n            if term in index.idf:\n                tfidf = tf * index.idf[term]\n                query_vector[term] = tfidf\n                query_norm_squared += tfidf * tfidf\n        \n        if not query_vector:\n            results.append([])\n            continue\n        \n        query_norm = math.sqrt(query_norm_squared)\n        \n        # Find candidate documents\n        candidate_docs = set()\n        for term in query_vector:\n            if term in index.inverted_index:\n                for doc_id, _ in index.inverted_index[term]:\n                    candidate_docs.add(doc_id)\n        \n        # Compute cosine similarity for each candidate\n        scores = []\n        for doc_id in candidate_docs:\n            doc_vector = index.doc_vectors.get(doc_id, {})\n            doc_norm = index.doc_norms.get(doc_id, 0)\n            \n            if doc_norm == 0:\n                continue\n            \n            # Dot product\n            dot_product = sum(\n                query_vector.get(term, 0) * doc_vector.get(term, 0)\n                for term in query_vector\n            )\n            \n            # Cosine similarity\n            similarity = dot_product / (query_norm * doc_norm)\n            scores.append((doc_id, similarity))\n        \n        # Get top-k results\n        top_results = nlargest(top_k, scores, key=lambda x: x[1])\n        \n        # Build result objects\n        query_results = []\n        for doc_id, score in top_results:\n            query_results.append(\n                SearchResult(\n                    doc_id=doc_id,\n                    score=score,\n                    title=doc_titles.get(doc_id, f"Document {doc_id}"),\n                )\n            )\n        results.append(query_results)\n    \n    return results\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: Optional[int] = None,\n    documents: Optional[List[Document]] = None,\n) -> Tuple[List[List[SearchResult]], float]:\n    """\n    Search for multiple queries in parallel.\n    \n    Args:\n        queries: List of search query strings\n        index: TF-IDF index to search\n        top_k: Number of top results per query\n        num_workers: Number of worker processes (None = CPU count)\n        documents: Optional list of documents for title lookup\n    \n    Returns:\n        Tuple of (list of result lists, elapsed_time)\n    """\n    start_time = time.perf_counter()\n    \n    # Prepare document titles\n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n    \n    if num_workers is None:\n        num_workers = mp.cpu_count()\n    \n    # Split queries into batches for parallel processing\n    # Each worker gets a batch of queries to process\n    queries_per_batch = max(1, len(queries) // num_workers)\n    \n    query_batches = []\n    for i in range(0, len(queries), queries_per_batch):\n        batch = queries[i:i + queries_per_batch]\n        query_batches.append((batch, index, top_k, doc_titles))\n    \n    # Process query batches in parallel\n    all_results = []\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_search_query_batch, batch) for batch in query_batches]\n        \n        for future in futures:  # Maintain order\n            batch_results = future.result()\n            all_results.extend(batch_results)\n    \n    elapsed = time.perf_counter() - start_time\n    \n    return all_results, elapsed\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
