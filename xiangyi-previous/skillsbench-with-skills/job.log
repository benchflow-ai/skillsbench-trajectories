Sending keys: ['cat > dicke_model.py << \'EOFPYTHON\'\nimport numpy as np\nfrom qutip import *\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\nN = 4\nomega_0 = 1.0\nomega_c = 1.0\ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\n\ngrid_points = 1000\nx_range = 6.0\np_range = 6.0\n\nprint("Initializing Dicke model...")\nprint(f"N={N}, omega_0={omega_0}, omega_c={omega_c}, g={g:.4f}")\n\na = destroy(n_max)\nI_cav = qeye(n_max)\nI_spin = qeye(2)\n\nprint("Building collective spin operators...")\n\nJz_list = []\nJp_list = []\nJm_list = []\n\nfor i in range(N):\n    ops_z = [I_spin for _ in range(N)]\n    ops_z[i] = 0.5 * sigmaz()\n    Jz_list.append(tensor(I_cav, *ops_z))\n    \n    ops_p = [I_spin for _ in range(N)]\n    ops_p[i] = (sigmax() + 1j*sigmay()) / 2.0\n    Jp_list.append(tensor(I_cav, *ops_p))\n    \n    ops_m = [I_spin for _ in range(N)]\n    ops_m[i] = (sigmax() - 1j*sigmay()) / 2.0\n    Jm_list.append(tensor(I_cav, *ops_m))\n\nJz = sum(Jz_list)\nJp = sum(Jp_list)\nJm = sum(Jm_list)\n\na_full = tensor(a, *[I_spin for _ in range(N)])\na_dag = a_full.dag()\nN_cav_full = tensor(num(n_max), *[I_spin for _ in range(N)])\n\nprint(f"Jz shape: {Jz.shape}")\nprint(f"a_full shape: {a_full.shape}")\n\nH = omega_0 * Jz + omega_c * N_cav_full + g * (a_full + a_dag) * (Jp + Jm)\n\nprint("Hamiltonian built.")\nprint("\\nSolving steady states...")\n\nprint("\\nCase 1: Local dephasing & local pumping")\nc_ops_1 = [np.sqrt(kappa) * a_full]\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_1.append(np.sqrt(0.01) * tensor(I_cav, *ops))\n    ops[i] = (I_spin - sigmaz()) / 2.0\n    c_ops_1.append(np.sqrt(0.1) * tensor(I_cav, *ops))\nrho_ss_1 = steadystate(H, c_ops_1, method=\'direct\')\nprint("Done.")\n\nprint("\\nCase 2: Local dephasing & local emission")\nc_ops_2 = [np.sqrt(kappa) * a_full]\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_2.append(np.sqrt(0.01) * tensor(I_cav, *ops))\n    ops[i] = (sigmax() - 1j*sigmay()) / 2.0\n    c_ops_2.append(np.sqrt(0.1) * tensor(I_cav, *ops))\nrho_ss_2 = steadystate(H, c_ops_2, method=\'direct\')\nprint("Done.")\n\nprint("\\nCase 3: Local dephasing & local emission & collective pumping")\nc_ops_3 = [np.sqrt(kappa) * a_full]\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_3.append(np.sqrt(0.01) * tensor(I_cav, *ops))\n    ops[i] = (sigmax() - 1j*sigmay()) / 2.0\n    c_ops_3.append(np.sqrt(0.1) * tensor(I_cav, *ops))\nc_ops_3.append(np.sqrt(0.1) * Jp)\nrho_ss_3 = steadystate(H, c_ops_3, method=\'direct\')\nprint("Done.")\n\nprint("\\nCase 4: Local dephasing & local emission & collective emission")\nc_ops_4 = [np.sqrt(kappa) * a_full]\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_4.append(np.sqrt(0.01) * tensor(I_cav, *ops))\n    ops[i] = (sigmax() - 1j*sigmay()) / 2.0\n    c_ops_4.append(np.sqrt(0.1) * tensor(I_cav, *ops))\nc_ops_4.append(np.sqrt(0.1) * Jm)\nrho_ss_4 = steadystate(H, c_ops_4, method=\'direct\')\nprint("Done.")\n\nprint("\\nTracing out spins...")\nrho_cav_1 = ptrace(rho_ss_1, 0)\nrho_cav_2 = ptrace(rho_ss_2, 0)\nrho_cav_3 = ptrace(rho_ss_3, 0)\nrho_cav_4 = ptrace(rho_ss_4, 0)\n\nprint("Calculating Wigner functions...")\nxvec = np.linspace(-x_range, x_range, grid_points)\npvec = np.linspace(-p_range, p_range, grid_points)\n\nprint("W1...")\nW1 = wigner(rho_cav_1, xvec, pvec)\nprint("W2...")\nW2 = wigner(rho_cav_2, xvec, pvec)\nprint("W3...")\nW3 = wigner(rho_cav_3, xvec, pvec)\nprint("W4...")\nW4 = wigner(rho_cav_4, xvec, pvec)\n\nprint("\\nSaving to CSV...")\nnp.savetxt(\'1.csv\', W1, delimiter=\',\')\nnp.savetxt(\'2.csv\', W2, delimiter=\',\')\nnp.savetxt(\'3.csv\', W3, delimiter=\',\')\nnp.savetxt(\'4.csv\', W4, delimiter=\',\')\n\nprint("Complete!")\nEOFPYTHON\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
