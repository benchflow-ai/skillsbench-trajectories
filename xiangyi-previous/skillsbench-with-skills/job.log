Sending keys: ['python3 << \'EOF\'\nimport openpyxl\n\nwb = openpyxl.load_workbook(\'nasa_budget_incomplete.xlsx\')\nws1 = wb[\'Budget by Directorate\']\nws2 = wb[\'YoY Changes (%)\']\nws3 = wb[\'Directorate Shares (%)\']\nws4 = wb[\'Growth Analysis\']\n\n# ============ SHEET 1: Budget by Directorate ============\n# Column mapping: 2=Science, 3=Aeronautics, 4=Space Tech, 5=Exploration,\n#                 6=Space Ops, 7=STEM, 8=Safety, 9=Construction, 10=Inspector, 11=Total\n\n# Row mapping: 4=2015, 5=2016, 6=2017, 7=2018, 8=2019, 9=2020, 10=2021, 11=2022, 12=2023, 13=2024\n\n# 1. 2016 Total (row 5, col 11): sum of cols 2-10\nsum_2016 = 5589 + 640 + 687 + 4030 + 5029 + 115 + 2769 + 389 + 37\nprint(f"2016 Total: {sum_2016}")\nws1.cell(row=5, column=11).value = sum_2016\n\n# 2. 2019 Space Operations (row 8, col 6): Total - sum of others\nsum_2019_others = 6906 + 725 + 927 + 5047 + 110 + 2755 + 538 + 41\nspace_ops_2019 = 21688 - sum_2019_others\nprint(f"2019 Space Operations: {space_ops_2019}")\nws1.cell(row=8, column=6).value = space_ops_2019\n\n# 3. 2020 Science (row 9, col 2): Total - sum of others\nsum_2020_others = 819 + 1100 + 6017 + 3989 + 120 + 2913 + 373 + 43\nscience_2020 = 22513 - sum_2020_others\nprint(f"2020 Science: {science_2020}")\nws1.cell(row=9, column=2).value = science_2020\n\n# 4. 2023 Aeronautics (row 12, col 3): Total - sum of others\nsum_2023_others = 8262 + 1192 + 7618 + 4256 + 143 + 3106 + 424 + 47\naero_2023 = 25984 - sum_2023_others\nprint(f"2023 Aeronautics: {aero_2023}")\nws1.cell(row=12, column=3).value = aero_2023\n\n# 5 & 6. 2021 Exploration and Total - need to solve together\n# Using YoY Total change of 3.43%: Total_2021 = 22513 * 1.0343\ntotal_2021 = round(22513 * (1 + 3.43/100))\nprint(f"2021 Total (from YoY): {total_2021}")\n\n# Actually let\'s verify by calculating from known 2021 values + exploration\n# Sum of known 2021 values: 7301+829+1100+3986+127+2953+390+44 = 16730\nsum_2021_known = 7301 + 829 + 1100 + 3986 + 127 + 2953 + 390 + 44\nprint(f"Sum of known 2021 values: {sum_2021_known}")\n\n# If total is 23286 (from YoY), then Exploration = 23286 - 16730 = 6556\n# Let\'s check with the Exploration YoY change of 8.94%: 6017 * 1.0894 = 6554.7\nexploration_2021_from_yoy = round(6017 * (1 + 8.94/100))\nprint(f"2021 Exploration (from YoY): {exploration_2021_from_yoy}")\n\n# Use the YoY-derived exploration value\nexploration_2021 = exploration_2021_from_yoy\nws1.cell(row=10, column=5).value = exploration_2021\n\n# Calculate 2021 Total as sum\ntotal_2021_calc = sum_2021_known + exploration_2021\nprint(f"2021 Total (calculated): {total_2021_calc}")\nws1.cell(row=10, column=11).value = total_2021_calc\n\nprint("\\nSheet 1 values recovered!")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
