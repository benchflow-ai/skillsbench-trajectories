Sending keys: ['cat > process_meetings.py << \'EOF\'\nimport json\nimport os\nfrom datetime import datetime, timedelta\nfrom google.oauth2.credentials import Credentials\nfrom googleapiclient.discovery import build\nfrom email.mime.text import MIMEText\nimport base64\nimport re\nfrom dateutil import parser\nimport pytz\n\n# Load meeting requests\nwith open(\'/root/test_input.json\', \'r\') as f:\n    meeting_requests = json.load(f)\n\n# Initialize Google Calendar API\ncalendar_creds = Credentials.from_authorized_user_file(\'/root/auth/calendar/tokens.json\')\ncalendar_service = build(\'calendar\', \'v3\', credentials=calendar_creds)\n\n# Initialize Gmail API\ngmail_creds = Credentials.from_authorized_user_file(\'/root/auth/gmail/tokens.json\')\ngmail_service = build(\'gmail\', \'v1\', credentials=gmail_creds)\n\ndef parse_meeting_request(request):\n    """Extract meeting details from email text"""\n    email_text = request[\'email_text\']\n    from_email = request[\'from_email\']\n    \n    # Extract duration\n    duration = None\n    if \'one-hour\' in email_text or \'1 hour\' in email_text:\n        duration = 1.0\n    elif \'1.5 hour\' in email_text:\n        duration = 1.5\n    elif \'45-minute\' in email_text or \'45 minute\' in email_text:\n        duration = 0.75\n    \n    # Extract dates and times\n    dates = []\n    time_range = None\n    timezone_str = \'America/Los_Angeles\'  # Default PST\n    \n    if \'January 8th, 2026\' in email_text and \'January 9th\' not in email_text:\n        dates = [datetime(2026, 1, 8)]\n    elif \'January 8th and January 9th\' in email_text:\n        dates = [datetime(2026, 1, 8), datetime(2026, 1, 9)]\n    elif \'January 6th or 7th\' in email_text:\n        dates = [datetime(2026, 1, 6), datetime(2026, 1, 7)]\n    \n    # Extract time range\n    if \'10:00am to 2:00pm\' in email_text or \'10:00 am to 2:00 pm\' in email_text:\n        time_range = (\'10:00\', \'14:00\')\n    elif \'11:00 AM and 3:00 PM\' in email_text:\n        time_range = (\'11:00\', \'15:00\')\n    elif \'9:30am and 11:30am\' in email_text:\n        time_range = (\'09:30\', \'11:30\')\n    \n    # Check for PST timezone\n    if \'PST\' not in email_text:\n        timezone_str = \'America/Los_Angeles\'  # Default\n    \n    return {\n        \'from_email\': from_email,\n        \'duration\': duration,\n        \'dates\': dates,\n        \'time_range\': time_range,\n        \'timezone\': timezone_str\n    }\n\ndef check_calendar_availability(date, start_time, end_time, duration_hours):\n    """Check if a time slot is available in the calendar"""\n    tz = pytz.timezone(\'America/Los_Angeles\')\n    \n    # Parse start and end times\n    start_hour, start_min = map(int, start_time.split(\':\'))\n    end_hour, end_min = map(int, end_time.split(\':\'))\n    \n    # Create datetime objects\n    start_dt = tz.localize(datetime(date.year, date.month, date.day, start_hour, start_min))\n    end_dt = tz.localize(datetime(date.year, date.month, date.day, end_hour, end_min))\n    \n    # Get events from calendar\n    events_result = calendar_service.events().list(\n        calendarId=\'primary\',\n        timeMin=start_dt.isoformat(),\n        timeMax=end_dt.isoformat(),\n        singleEvents=True,\n        orderBy=\'startTime\'\n    ).execute()\n    \n    events = events_result.get(\'items\', [])\n    \n    # Find available slots\n    current_time = start_dt\n    duration_delta = timedelta(hours=duration_hours)\n    \n    while current_time + duration_delta <= end_dt:\n        slot_end = current_time + duration_delta\n        is_free = True\n        \n        for event in events:\n            event_start = parser.parse(event[\'start\'].get(\'dateTime\', event[\'start\'].get(\'date\')))\n            event_end = parser.parse(event[\'end\'].get(\'dateTime\', event[\'end\'].get(\'date\')))\n            \n            # Check for overlap\n            if not (slot_end <= event_start or current_time >= event_end):\n                is_free = False\n                break\n        \n        if is_free:\n            return current_time, slot_end\n        \n        # Move to next 15-minute slot\n        current_time += timedelta(minutes=15)\n    \n    return None, None\n\ndef find_earliest_slot(meeting_info):\n    """Find the earliest available time slot"""\n    for date in meeting_info[\'dates\']:\n        start_time, end_time = meeting_info[\'time_range\']\n        slot_start, slot_end = check_calendar_availability(\n            date, start_time, end_time, meeting_info[\'duration\']\n        )\n        \n        if slot_start:\n            return slot_start, slot_end\n    \n    return None, None\n\ndef format_datetime(dt):\n    """Format datetime according to requirements"""\n    day_name = dt.strftime(\'%A\')\n    month = dt.strftime(\'%B\')\n    day = dt.strftime(\'%d\')\n    year = dt.strftime(\'%Y\')\n    return f"{day_name}, {month} {day}, {year}"\n\ndef format_time_range(start_dt, end_dt):\n    """Format time range according to requirements"""\n    start_time = start_dt.strftime(\'%I:%M %p\')\n    end_time = end_dt.strftime(\'%I:%M %p\')\n    return f"{start_time} - {end_time}"\n\ndef send_email(to_email, date_str, time_range_str, duration):\n    """Send reply email via Gmail API"""\n    message_text = f"""Hi,\n\nThank you for your meeting request.\n\nI can be available:\n\nDate: {date_str}\nTime: {time_range_str}\nDuration: {duration} hour(s)\n\nIf this time doesn\'t work, please let me know your preferred alternatives.\n\nBest regards,\nSkillsBench"""\n    \n    message = MIMEText(message_text)\n    message[\'to\'] = to_email\n    message[\'subject\'] = \'Re: Meeting Request\'\n    \n    raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode(\'utf-8\')\n    \n    sent_message = gmail_service.users().messages().send(\n        userId=\'me\',\n        body={\'raw\': raw_message}\n    ).execute()\n    \n    return sent_message[\'id\']\n\n# Process all meeting requests\nresults = {\'sent_results\': []}\n\nfor request in meeting_requests:\n    meeting_info = parse_meeting_request(request)\n    slot_start, slot_end = find_earliest_slot(meeting_info)\n    \n    if slot_start and slot_end:\n        date_str = format_datetime(slot_start)\n        time_range_str = format_time_range(slot_start, slot_end)\n        duration = meeting_info[\'duration\']\n        \n        message_id = send_email(\n            meeting_info[\'from_email\'],\n            date_str,\n            time_range_str,\n            duration\n        )\n        \n        results[\'sent_results\'].append({\'messageId\': message_id})\n        print(f"Sent email to {meeting_info[\'from_email\']}: {date_str} {time_range_str}")\n    else:\n        print(f"No available slot found for {meeting_info[\'from_email\']}")\n\n# Save results\nwith open(\'/root/results.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint(f"\\nResults saved to /root/results.json")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
