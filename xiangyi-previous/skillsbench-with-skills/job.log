Sending keys: ["\n\n\ncat > phase_picker.py << 'ENDOFFILE'\nimport numpy as np\nimport os\nimport glob\nfrom scipy import signal\nimport csv\n\ndef sta_lta(data, sta_len, lta_len):\n    sta = np.convolve(data**2, np.ones(sta_len)/sta_len, mode='same')\n    lta = np.convolve(data**2, np.ones(lta_len)/lta_len, mode='same')\n    lta[lta == 0] = 1e-10\n    return sta / lta\n\ndef pick_phases(trace_data, dt):\n    fs = 1.0 / dt\n    sos_p = signal.butter(4, [1, 15], btype='band', fs=fs, output='sos')\n    vertical_filt = signal.sosfilt(sos_p, trace_data[:, 2])\n    cf_p = sta_lta(np.abs(vertical_filt), int(5/dt), int(100/dt))\n    p_picks = []\n    triggers = np.where(np.diff((cf_p > 3.5).astype(int)) == 1)[0]\n    if len(triggers) > 0:\n        early = triggers[triggers < len(cf_p) // 2]\n        if len(early) > 0:\n            p_picks.append(early[0])\n    sos_s = signal.butter(4, [1, 10], btype='band', fs=fs, output='sos')\n    h1 = signal.sosfilt(sos_s, trace_data[:, 0])\n    h2 = signal.sosfilt(sos_s, trace_data[:, 1])\n    h_combined = np.sqrt(h1**2 + h2**2)\n    cf_s = sta_lta(h_combined, int(10/dt), int(200/dt))\n    s_picks = []\n    triggers_s = np.where(np.diff((cf_s > 3.0).astype(int)) == 1)[0]\n    start = p_picks[0] + int(0.2/dt) if len(p_picks) > 0 else int(0.5/dt)\n    for t in triggers_s:\n        if t > start and t < len(cf_s) - int(1.0/dt):\n            s_picks.append(t)\n            break\n    return p_picks, s_picks\n\nfiles = sorted(glob.glob('/root/data/*.npz'))\nresults = []\nfor f in files:\n    data = np.load(f)\n    trace = data['data']\n    dt = float(data['dt'])\n    p_picks, s_picks = pick_phases(trace, dt)\n    fname = os.path.basename(f)\n    for p in p_picks:\n        results.append([fname, 'P', p])\n    for s in s_picks:\n        results.append([fname, 'S', s])\n\nwith open('/root/results.csv', 'w', newline='') as f:\n    writer = csv.writer(f)\n    writer.writerow(['file_name', 'phase', 'pick_idx'])\n    writer.writerows(results)\n\nprint(f'Processed {len(files)} files, generated {len(results)} picks')\nENDOFFILE\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
