Sending keys: ['cat > simulation.py << \'EOF\'\n"""ACC Simulation runner with proper position tracking."""\n\nimport csv\nimport yaml\nfrom acc_system import AdaptiveCruiseControl\n\n\ndef load_yaml(filepath):\n    """Load YAML configuration file."""\n    with open(filepath, \'r\') as f:\n        return yaml.safe_load(f)\n\n\ndef load_sensor_data(filepath):\n    """Load sensor data from CSV file."""\n    data = []\n    with open(filepath, \'r\') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            entry = {\n                \'time\': float(row[\'time\']),\n                \'ref_ego_speed\': float(row[\'ego_speed\']) if row[\'ego_speed\'] else 0.0,\n                \'lead_speed\': float(row[\'lead_speed\']) if row[\'lead_speed\'] else None,\n                \'ref_distance\': float(row[\'distance\']) if row[\'distance\'] else None\n            }\n            data.append(entry)\n    return data\n\n\ndef run_simulation():\n    """Run the ACC simulation with proper position tracking."""\n    # Load configurations\n    vehicle_config = load_yaml(\'vehicle_params.yaml\')\n    tuning_config = load_yaml(\'tuning_results.yaml\')\n    \n    # Load sensor data for lead vehicle information\n    sensor_data = load_sensor_data(\'sensor_data.csv\')\n    \n    # Initialize ACC system\n    acc = AdaptiveCruiseControl(vehicle_config)\n    \n    # Update with tuned PID gains\n    acc.set_pid_gains(tuning_config[\'pid_speed\'], tuning_config[\'pid_distance\'])\n    \n    # Simulation parameters\n    dt = vehicle_config[\'simulation\'][\'dt\']\n    \n    # Initial state - ego vehicle\n    ego_speed = 0.0\n    ego_position = 0.0\n    \n    # Lead vehicle state (will be set when lead appears)\n    lead_position = None\n    lead_active = False\n    \n    # Results storage\n    results = []\n    \n    # Run simulation for each timestep\n    for i, sensor in enumerate(sensor_data):\n        time = sensor[\'time\']\n        lead_speed = sensor[\'lead_speed\']\n        \n        # Handle lead vehicle appearance/disappearance\n        if lead_speed is not None:\n            if not lead_active:\n                # Lead vehicle just appeared - initialize its position\n                # Use the reference distance from sensor data for initial gap\n                initial_distance = sensor[\'ref_distance\'] if sensor[\'ref_distance\'] else 50.0\n                lead_position = ego_position + initial_distance\n                lead_active = True\n            \n            # Calculate current distance\n            distance = lead_position - ego_position\n        else:\n            lead_active = False\n            lead_position = None\n            distance = None\n        \n        # Compute ACC command\n        accel_cmd, mode, distance_error = acc.compute(\n            ego_speed, lead_speed, distance, dt\n        )\n        \n        # Calculate TTC if lead vehicle present\n        if lead_speed is not None and distance is not None:\n            ttc = acc.compute_ttc(ego_speed, lead_speed, distance)\n            if ttc == float(\'inf\'):\n                ttc_str = \'\'\n            else:\n                ttc_str = f\'{ttc:.2f}\'\n            distance_str = f\'{distance:.2f}\'\n            dist_error_str = f\'{distance_error:.2f}\' if distance_error is not None else \'\'\n        else:\n            ttc_str = \'\'\n            distance_str = \'\'\n            dist_error_str = \'\'\n        \n        # Store result\n        results.append({\n            \'time\': time,\n            \'ego_speed\': round(ego_speed, 10),\n            \'acceleration_cmd\': round(accel_cmd, 10),\n            \'mode\': mode,\n            \'distance_error\': dist_error_str,\n            \'distance\': distance_str,\n            \'ttc\': ttc_str\n        })\n        \n        # Update ego vehicle state\n        ego_speed = ego_speed + accel_cmd * dt\n        ego_speed = max(0.0, ego_speed)  # Can\'t go backwards\n        ego_position = ego_position + ego_speed * dt\n        \n        # Update lead vehicle position if active\n        if lead_active and lead_speed is not None:\n            lead_position = lead_position + lead_speed * dt\n    \n    # Write results to CSV\n    with open(\'simulation_results.csv\', \'w\', newline=\'\') as f:\n        fieldnames = [\'time\', \'ego_speed\', \'acceleration_cmd\', \'mode\', \n                      \'distance_error\', \'distance\', \'ttc\']\n        writer = csv.DictWriter(f, fieldnames=fieldnames)\n        writer.writeheader()\n        writer.writerows(results)\n    \n    print(f"Simulation complete. Results saved to simulation_results.csv")\n    print(f"Total timesteps: {len(results)}")\n    \n    # Calculate and print performance metrics\n    analyze_results(results, vehicle_config)\n    \n    return results\n\n\ndef analyze_results(results, config):\n    """Analyze simulation results and print metrics."""\n    set_speed = config[\'acc_settings\'][\'set_speed\']\n    \n    # Find rise time (time to reach 90% of set speed for the first time)\n    rise_time = None\n    for r in results:\n        if r[\'ego_speed\'] >= 0.9 * set_speed:\n            rise_time = r[\'time\']\n            break\n    \n    # Find max speed during cruise phase (before lead appears at t=30)\n    cruise_phase_speeds = [r[\'ego_speed\'] for r in results if r[\'time\'] < 30]\n    max_cruise_speed = max(cruise_phase_speeds) if cruise_phase_speeds else 0\n    \n    # Find overall max speed\n    max_speed = max(r[\'ego_speed\'] for r in results)\n    \n    # Calculate overshoot during initial cruise phase\n    overshoot = ((max_cruise_speed - set_speed) / set_speed) * 100 if max_cruise_speed > set_speed else 0\n    \n    # Calculate steady-state speed error (use t=25-29s, just before lead appears)\n    ss_cruise_speeds = [r[\'ego_speed\'] for r in results if 25 <= r[\'time\'] < 30]\n    if ss_cruise_speeds:\n        ss_speed_error = abs(set_speed - sum(ss_cruise_speeds) / len(ss_cruise_speeds))\n    else:\n        ss_speed_error = 0\n    \n    # Also check final cruise phase (t=140-150s)\n    final_cruise_speeds = [r[\'ego_speed\'] for r in results if r[\'time\'] >= 140 and r[\'mode\'] == \'cruise\']\n    if final_cruise_speeds:\n        final_ss_error = abs(set_speed - sum(final_cruise_speeds) / len(final_cruise_speeds))\n    else:\n        final_ss_error = ss_speed_error\n    \n    # Use the worse of the two for reporting\n    ss_speed_error = max(ss_speed_error, final_ss_error)\n    \n    # Find minimum distance during follow/emergency mode\n    follow_distances = []\n    for r in results:\n        if r[\'distance\'] and r[\'mode\'] in [\'follow\', \'emergency\']:\n            try:\n                follow_distances.append(float(r[\'distance\']))\n            except:\n                pass\n    min_distance = min(follow_distances) if follow_distances else float(\'inf\')\n    \n    # Calculate distance steady-state error (last 20s of follow mode)\n    follow_results = [(r[\'time\'], r[\'distance_error\']) for r in results if r[\'distance_error\']]\n    if follow_results:\n        # Get the last portion of follow mode\n        last_follow = [float(de) for t, de in follow_results if t > 100]\n        if not last_follow:\n            last_follow = [float(de) for t, de in follow_results[-50:]]\n        if last_follow:\n            ss_dist_error = abs(sum(last_follow) / len(last_follow))\n        else:\n            ss_dist_error = 0\n    else:\n        ss_dist_error = 0\n    \n    print(f"\\n=== Performance Metrics ===")\n    print(f"Rise time (to 90% of {set_speed} m/s): {rise_time:.1f}s" if rise_time else "Rise time: N/A")\n    print(f"Maximum cruise speed: {max_cruise_speed:.2f} m/s")\n    print(f"Speed overshoot: {overshoot:.2f}%")\n    print(f"Steady-state speed error: {ss_speed_error:.3f} m/s")\n    print(f"Minimum following distance: {min_distance:.2f} m")\n    print(f"Steady-state distance error: {ss_dist_error:.2f} m")\n    \n    # Check against targets\n    print(f"\\n=== Target Compliance ===")\n    print(f"Rise time < 10s: {\'PASS\' if rise_time and rise_time < 10 else \'FAIL\'}")\n    print(f"Overshoot < 5%: {\'PASS\' if overshoot < 5 else \'FAIL\'}")\n    print(f"Speed SS error < 0.5 m/s: {\'PASS\' if ss_speed_error < 0.5 else \'FAIL\'}")\n    print(f"Distance SS error < 2m: {\'PASS\' if ss_dist_error < 2 else \'FAIL\'}")\n    print(f"Min distance > 5m: {\'PASS\' if min_distance > 5 else \'FAIL\'}")\n\n\nif __name__ == \'__main__\':\n    run_simulation()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
