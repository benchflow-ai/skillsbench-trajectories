Sending keys: ['cat > /app/solution.py <<\'PYCODE\'\nimport re\nimport json\nfrom typing import Dict, List\n\n\ndef parse_script(text: str):\n    lines = text.splitlines()\n    nodes: List[Dict] = []\n    edges: List[Dict] = []\n\n    current_id = None\n    content: List[str] = []\n\n    def flush():\n        nonlocal current_id, content\n        if current_id is None:\n            return\n        # filter non-empty lines\n        content_lines = [l for l in content if l.strip() != ""]\n        if not content_lines:\n            # create empty node\n            nodes.append({"id": current_id, "text": "", "speaker": "", "type": "line"})\n            return\n        first = content_lines[0].lstrip()\n        if re.match(r\'^\\d+\\.\', first):\n            # choice node\n            nodes.append({"id": current_id, "text": "", "speaker": "", "type": "choice"})\n            for line in content_lines:\n                line = line.strip()\n                m = re.match(r\'^\\d+\\.\\s*(.*)$\', line)\n                option_text = m.group(1) if m else line\n                # split on last arrow\n                if "->" in option_text:\n                    opt_text, target = option_text.rsplit("->", 1)\n                    opt_text = opt_text.strip()\n                    target = target.strip()\n                else:\n                    opt_text = option_text.strip()\n                    target = None\n                if target:\n                    edges.append({"from": current_id, "to": target, "text": opt_text})\n        else:\n            # line node\n            line_text = " ".join([l.strip() for l in content_lines])\n            if "->" in line_text:\n                before, target = line_text.rsplit("->", 1)\n                target = target.strip()\n            else:\n                before = line_text\n                target = None\n            if ":" in before:\n                speaker, text = before.split(":", 1)\n                speaker = speaker.strip()\n                text = text.strip()\n            else:\n                speaker = ""\n                text = before.strip()\n            nodes.append({"id": current_id, "text": text, "speaker": speaker, "type": "line"})\n            if target:\n                edges.append({"from": current_id, "to": target, "text": ""})\n\n    for raw in lines:\n        line = raw.strip()\n        if line.startswith("[") and line.endswith("]"):\n            flush()\n            current_id = line[1:-1].strip()\n            content = []\n        else:\n            content.append(raw)\n    flush()\n\n    # add implicit nodes for missing targets (e.g., End)\n    node_ids = {n["id"] for n in nodes}\n    for e in edges:\n        if e["to"] not in node_ids:\n            nodes.append({"id": e["to"], "text": "", "speaker": "", "type": "line"})\n            node_ids.add(e["to"])\n\n    return {"nodes": nodes, "edges": edges}\n\n\ndef to_dot(graph: Dict) -> str:\n    lines = ["digraph Dialogue {", "  rankdir=LR;", "  node [shape=box];"]\n    for node in graph["nodes"]:\n        nid = node["id"]\n        ntype = node.get("type", "")\n        label = nid\n        if ntype == "line":\n            speaker = node.get("speaker", "")\n            text = node.get("text", "")\n            if speaker:\n                label = f"{nid}\\\\n{speaker}: {text}"\n            else:\n                label = f"{nid}\\\\n{text}"\n        else:\n            label = f"{nid}\\\\n(choice)"\n        shape = "diamond" if ntype == "choice" else "box"\n        lines.append(f"  \\"{nid}\\" [label=\\"{label}\\", shape={shape}];")\n    for edge in graph["edges"]:\n        frm = edge["from"]\n        to = edge["to"]\n        text = edge.get("text", "")\n        if text:\n            lines.append(f"  \\"{frm}\\" -> \\"{to}\\" [label=\\"{text}\\"]; ")\n        else:\n            lines.append(f"  \\"{frm}\\" -> \\"{to}\\";")\n    lines.append("}")\n    return "\\n".join(lines)\n\n\nif __name__ == "__main__":\n    with open("/app/script.txt", "r", encoding="utf-8") as f:\n        text = f.read()\n    graph = parse_script(text)\n    with open("/app/dialogue.json", "w", encoding="utf-8") as f:\n        json.dump(graph, f, indent=2)\n    dot = to_dot(graph)\n    with open("/app/dialogue.dot", "w", encoding="utf-8") as f:\n        f.write(dot)\nPYCODE\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
