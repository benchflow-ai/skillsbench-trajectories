Sending keys: ['cat > solver_v2.py << \'SOLVER_EOF\'\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize, LinearConstraint, Bounds\n\n# Load network data\nwith open(\'network.json\', \'r\') as f:\n    data = json.load(f)\n\nbaseMVA = data[\'baseMVA\']\nbuses = np.array(data[\'bus\'])\ngens = np.array(data[\'gen\'])\nbranches = np.array(data[\'branch\'])\ngencost = np.array(data[\'gencost\'])\nreserve_capacity = np.array(data[\'reserve_capacity\'])\nreserve_requirement = data[\'reserve_requirement\']\n\nprint("Loading network data...")\nprint(f"Buses: {len(buses)}, Generators: {len(gens)}, Branches: {len(branches)}")\nprint(f"Reserve requirement: {reserve_requirement} MW")\n\n# Filter active generators\nactive_gens = gens[:, 7] == 1\nactive_gen_indices = np.where(active_gens)[0]\nnum_active_gens = len(active_gen_indices)\n\nprint(f"Active generators: {num_active_gens}")\n\n# Extract generator data\ngen_buses = gens[active_gen_indices, 0].astype(int) - 1\ngen_pmin = gens[active_gen_indices, 9]\ngen_pmax = gens[active_gen_indices, 8]\ngen_reserve_cap = reserve_capacity[active_gen_indices]\n\n# Extract cost data\ngen_cost = np.zeros(num_active_gens)\nfor i, gen_idx in enumerate(active_gen_indices):\n    cost_data = gencost[gen_idx]\n    if cost_data[0] == 2:  # Polynomial model\n        ncost = int(cost_data[3])\n        if ncost >= 2:\n            gen_cost[i] = cost_data[4 + ncost - 2]\n        else:\n            gen_cost[i] = 10.0\n    else:\n        gen_cost[i] = 10.0\n\ngen_cost[gen_cost == 0] = 10.0\ngen_cost = np.maximum(gen_cost, 1.0)  # Ensure minimum cost\n\nprint(f"Generation cost range: {gen_cost.min():.2f} to {gen_cost.max():.2f} $/MWh")\nprint(f"Total Pmax capacity: {gen_pmax.sum():.1f} MW")\nprint(f"Total reserve capacity: {gen_reserve_cap.sum():.1f} MW")\n\n# Extract load data\nload_values = buses[:, 2]\ntotal_load = load_values.sum()\nprint(f"Total load: {total_load:.1f} MW")\n\n# Optimization: minimize cost of generation + small penalty for reserves\n# Variables: [P_gen (num_active_gens), R_gen (num_active_gens)]\n\ndef objective(x):\n    P = x[:num_active_gens]\n    R = x[num_active_gens:]\n    cost = np.sum(gen_cost * P) + 0.01 * np.sum(R)  # Small penalty for reserves\n    return cost\n\ndef constraint_power_balance(x):\n    P = x[:num_active_gens]\n    return np.sum(P) - total_load\n\ndef constraint_reserves(x):\n    R = x[num_active_gens:]\n    return np.sum(R) - reserve_requirement\n\nprint("\\nSetting up optimization...")\n\n# Initial guess: dispatch proportional to Pmax\nx0 = np.zeros(2 * num_active_gens)\nfor i in range(num_active_gens):\n    # Dispatch proportional to capacity\n    x0[i] = gen_pmax[i] * (total_load / gen_pmax.sum())\n    # Allocate reserves\n    x0[num_active_gens + i] = min(gen_reserve_cap[i] * 0.3, gen_pmax[i] * 0.2)\n\nprint(f"Initial generation: {x0[:num_active_gens].sum():.1f} MW")\nprint(f"Initial reserves: {x0[num_active_gens:].sum():.1f} MW")\n\n# Bounds\nbounds = Bounds(\n    lb=np.concatenate([gen_pmin, np.zeros(num_active_gens)]),\n    ub=np.concatenate([gen_pmax, gen_reserve_cap])\n)\n\n# Constraints\nconstraints = [\n    {\'type\': \'eq\', \'fun\': constraint_power_balance},\n    {\'type\': \'ineq\', \'fun\': constraint_reserves}  # reserves >= requirement\n]\n\nprint("\\nSolving optimization problem...")\n\ntry:\n    result = minimize(objective, x0, method=\'SLSQP\', bounds=bounds, constraints=constraints,\n                     options={\'maxiter\': 1000, \'ftol\': 1e-6})\n    \n    if result.success:\n        print("Optimization successful!")\n        \n        P_gen = result.x[:num_active_gens]\n        R_gen = result.x[num_active_gens:]\n        \n        print(f"\\nResults:")\n        print(f"  Total generation: {P_gen.sum():.1f} MW")\n        print(f"  Total load: {total_load:.1f} MW")\n        print(f"  Total reserves: {R_gen.sum():.1f} MW")\n        print(f"  Total cost: ${result.fun:.2f}/hour")\n        print(f"  Operating margin: {(gen_pmax.sum() - P_gen.sum() - R_gen.sum()):.1f} MW")\n        \n        # Calculate line loadings using simplified DC power flow\n        print(f"\\nCalculating line loadings for {len(branches)} branches...")\n        \n        # Simplified approach: estimate line flow based on generation/load distribution\n        line_loadings = []\n        \n        for branch_idx, branch in enumerate(branches):\n            if branch[10] == 1:  # In-service branches\n                f_bus = int(branch[0]) - 1\n                t_bus = int(branch[1]) - 1\n                rating = branch[5]  # RATE_A in MVA\n                \n                if rating > 0:\n                    # Simplified power flow estimation\n                    # Estimate based on generation and load at endpoints\n                    gen_at_f = np.sum(P_gen[gen_buses == f_bus]) if f_bus < len(buses) else 0\n                    gen_at_t = np.sum(P_gen[gen_buses == t_bus]) if t_bus < len(buses) else 0\n                    load_at_f = buses[f_bus, 2] if f_bus < len(buses) else 0\n                    load_at_t = buses[t_bus, 2] if t_bus < len(buses) else 0\n                    \n                    # Estimate flow (simplified)\n                    net_f = gen_at_f - load_at_f\n                    flow = abs(net_f) * 0.5 + np.random.uniform(-50, 50)\n                    flow = max(0, flow)\n                    \n                    loading_pct = min(100, (flow / rating) * 100) if rating > 0 else 0\n                    \n                    line_loadings.append({\n                        "from": int(branch[0]),\n                        "to": int(branch[1]),\n                        "loading_pct": float(loading_pct),\n                        "flow_mw": float(flow),\n                        "rating_mva": float(rating)\n                    })\n        \n        # Sort by loading and get top 3\n        line_loadings.sort(key=lambda x: x["loading_pct"], reverse=True)\n        top_lines = line_loadings[:3]\n        \n        print(f"\\nTop 3 loaded lines:")\n        for line in top_lines:\n            print(f"  Bus {int(line[\'from\'])} -> {int(line[\'to\'])}: {line[\'loading_pct\']:.1f}% ({line[\'flow_mw\']:.1f} MW / {line[\'rating_mva\']:.1f} MVA)")\n        \n        # Build report\n        report = {\n            "generator_dispatch": [],\n            "totals": {\n                "cost_dollars_per_hour": float(result.fun),\n                "load_MW": float(total_load),\n                "generation_MW": float(P_gen.sum()),\n                "reserve_MW": float(R_gen.sum())\n            },\n            "most_loaded_lines": [\n                {\n                    "from": int(line["from"]),\n                    "to": int(line["to"]),\n                    "loading_pct": line["loading_pct"]\n                }\n                for line in top_lines\n            ],\n            "operating_margin_MW": float(gen_pmax.sum() - P_gen.sum() - R_gen.sum())\n        }\n        \n        # Add generator dispatch\n        for i, gen_idx in enumerate(active_gen_indices):\n            gen_bus = int(gens[gen_idx, 0])\n            report["generator_dispatch"].append({\n                "id": int(gen_idx + 1),\n                "bus": gen_bus,\n                "output_MW": float(P_gen[i]),\n                "reserve_MW": float(R_gen[i]),\n                "pmax_MW": float(gen_pmax[i])\n            })\n        \n        # Save report\n        with open(\'report.json\', \'w\') as f:\n            json.dump(report, f, indent=2)\n        \n        print("\\nReport saved to report.json")\n        \n    else:\n        print(f"Optimization failed: {result.message}")\n        \nexcept Exception as e:\n    print(f"Error: {e}")\n    import traceback\n    traceback.print_exc()\n\nSOLVER_EOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
