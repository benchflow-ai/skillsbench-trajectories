en(volume_countries)}")\nfor country, vol in volume_countries.items():\n    print(f"  {country}: {vol} troy oz")\n\n# Find countries in Volume but not in Value\nadditional_countries = {}\nfor country, volume in volume_countries.items():\n    # Normalize country names for comparison\n    country_normalized = country.replace(\'Intl Reserves\', \'International Reserves\').strip()\n    \n    # Check if this country is NOT in value_countries\n    found = False\n    for val_country in value_countries.keys():\n        val_normalized = val_country.replace(\'Intl Reserves\', \'International Reserves\').strip()\n        if country_normalized.lower() in val_normalized.lower() or val_normalized.lower() in country_normalized.lower():\n            found = True\n            break\n    \n    if not found:\n        # Convert volume to value (assuming volume is in millions of troy ounces)\n        # Gold price is per troy ounce, so value = volume * price\n        value_millions = volume * avg_gold_price_2025\n        additional_countries[country] = value_millions\n        print(f"\\nAdditional country from Volume: {country}")\n        print(f"  Volume: {volume} million troy oz")\n        print(f"  Converted value: ${value_millions:.2f} million")\n\nPYEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
