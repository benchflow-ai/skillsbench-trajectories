Sending keys: ['cat << \'EOF\' > /root/workspace/parallel_solution.py\nimport math\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor, as_completed\nfrom dataclasses import dataclass, field\nfrom multiprocessing import cpu_count\nimport itertools\n\nfrom sequential import (\n    Document,\n    TFIDFIndex,\n    SearchResult,\n    tokenize,\n    compute_term_frequencies,\n    search_sequential,\n)\n\n@dataclass\nclass ParallelIndexingResult:\n    """Result from parallel index building."""\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n# ============================================================================\n# Helper Functions for Parallel Execution\n# ============================================================================\n\ndef _process_document_chunk(documents_chunk):\n    """\n    Process a chunk of documents: Tokenize and compute TF.\n    Returns:\n        doc_term_freqs: dict[doc_id, dict[term, tf]]\n        doc_terms: dict[doc_id, set[term]]\n        local_vocab: set[term]\n        local_inverted: dict[term, list[(doc_id, tf)]]\n    """\n    doc_term_freqs = {}\n    doc_terms = {}\n    local_vocab = set()\n    local_inverted = defaultdict(list)\n    \n    for doc in documents_chunk:\n        text = doc.title + " " + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        \n        doc_term_freqs[doc.doc_id] = tf\n        terms = set(tf.keys())\n        doc_terms[doc.doc_id] = terms\n        local_vocab.update(terms)\n        \n        for term, freq in tf.items():\n            local_inverted[term].append((doc.doc_id, freq))\n            \n    return doc_term_freqs, doc_terms, local_vocab, local_inverted\n\ndef _finalize_inverted_index_chunk(items_chunk, idf_dict):\n    """\n    Process a chunk of (term, posting_list_with_tf) items.\n    Compute TF-IDF scores and sort.\n    Returns:\n        partial_inverted_index: dict[term, list[(doc_id, tfidf_score)]]\n    """\n    partial_index = {}\n    for term, posting_list in items_chunk:\n        term_idf = idf_dict.get(term, 0)\n        new_posting = []\n        for doc_id, tf in posting_list:\n            tfidf = tf * term_idf\n            new_posting.append((doc_id, tfidf))\n        \n        # Sort by score descending\n        new_posting.sort(key=lambda x: x[1], reverse=True)\n        partial_index[term] = new_posting\n    return partial_index\n\ndef _compute_doc_vector_chunk(doc_items_chunk, idf_dict):\n    """\n    Compute document vectors and norms for a chunk of documents.\n    Args:\n        doc_items_chunk: list of (doc_id, tf_dict)\n        idf_dict: global idf dictionary\n    Returns:\n        doc_vectors: dict[doc_id, dict[term, tfidf]]\n        doc_norms: dict[doc_id, float]\n    """\n    doc_vectors = {}\n    doc_norms = {}\n    \n    for doc_id, tf_dict in doc_items_chunk:\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            if term in idf_dict:\n                tfidf = tf * idf_dict[term]\n                doc_vector[term] = tfidf\n                norm_squared += tfidf * tfidf\n        doc_vectors[doc_id] = doc_vector\n        doc_norms[doc_id] = math.sqrt(norm_squared)\n        \n    return doc_vectors, doc_norms\n\n# ============================================================================\n# Parallel Implementations\n# ============================================================================\n\ndef build_tfidf_index_parallel(documents, num_workers=None, chunk_size=500):\n    if num_workers is None:\n        num_workers = cpu_count()\n        \n    start_time = time.perf_counter()\n    \n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n    \n    # Split documents into chunks\n    chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]\n    \n    doc_term_freqs = {}\n    doc_terms = {}\n    # Temporary raw inverted index: term -> list of (doc_id, tf)\n    raw_inverted_index = defaultdict(list)\n    \n    # Step 1: Parallel Tokenization and TF Computation\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_process_document_chunk, chunk) for chunk in chunks]\n        \n        for future in as_completed(futures):\n            chunk_dtf, chunk_dt, chunk_vocab, chunk_inv = future.result()\n            doc_term_freqs.update(chunk_dtf)\n            doc_terms.update(chunk_dt)\n            index.vocabulary.update(chunk_vocab)\n            for term, postings in chunk_inv.items():\n                raw_inverted_index[term].extend(postings)\n\n    # Step 2: Calculate document frequencies\n    # Since we have raw_inverted_index, DF is just len(posting_list)\n    for term, postings in raw_inverted_index.items():\n        index.document_frequencies[term] = len(postings)\n        \n    # Step 3: Compute IDF scores\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n        \n    # Step 4: Parallel Inverted Index Finalization (TF-IDF & Sort)\n    # Convert raw_inverted_index items to a list for chunking\n    all_items = list(raw_inverted_index.items())\n    # Heuristic for chunk size: divide items evenly among workers, or fixed size\n    # Given vocabulary can be large, let\'s use a reasonable chunk size\n    vocab_chunk_size = max(1, len(all_items) // (num_workers * 4))\n    item_chunks = [all_items[i:i + vocab_chunk_size] for i in range(0, len(all_items), vocab_chunk_size)]\n    \n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_finalize_inverted_index_chunk, chunk, index.idf) for chunk in item_chunks]\n        \n        for future in as_completed(futures):\n            partial_index = future.result()\n            index.inverted_index.update(partial_index)\n            \n    # Step 5: Parallel Document Vector & Norm Construction\n    dtf_items = list(doc_term_freqs.items())\n    dtf_chunk_size = max(1, len(dtf_items) // num_workers)\n    dtf_chunks = [dtf_items[i:i + dtf_chunk_size] for i in range(0, len(dtf_items), dtf_chunk_size)]\n    \n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_compute_doc_vector_chunk, chunk, index.idf) for chunk in dtf_chunks]\n        \n        for future in as_completed(futures):\n            d_vecs, d_norms = future.result()\n            index.doc_vectors.update(d_vecs)\n            index.doc_norms.update(d_norms)\n            \n    elapsed = time.perf_counter() - start_time\n    \n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed,\n        num_documents=len(documents),\n        vocabulary_size=len(index.vocabulary)\n    )\n\ndef batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\n    if num_workers is None:\n        num_workers = cpu_count()\n        \n    start_time = time.perf_counter()\n    \n    # Note: Passing the large \'index\' object to workers can be slow due to pickling.\n    # However, on Linux, \'fork\' start method is used by default which utilizes Copy-On-Write,\n    # so it should be efficient enough as long as we don\'t modify it.\n    \n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        # We map the search function over queries\n        # We need to use a lambda or partial, but index/documents are constant\n        # Executor.map is convenient here\n        \n        # Creating a list of futures\n        futures = [executor.submit(search_sequential, query, index, top_k, documents) for query in queries]\n        \n        results = []\n        # Collect results in order\n        for future in futures:\n            results.append(future.result())\n            \n    elapsed = time.perf_counter() - start_time\n    return results, elapsed\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
