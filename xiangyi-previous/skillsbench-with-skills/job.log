er\'][\'NW\']):\n            bonus += 2\n        else:\n            for n in get_neighbors(p[\'x\'], p[\'y\']):\n                if n.get(\'river\') and (n[\'river\'][\'NE\'] or n[\'river\'][\'W\'] or n[\'river\'][\'NW\']):\n                    bonus += 2\n                    break\n        districts = sum(1 for n in get_neighbors(p[\'x\'], p[\'y\']) if (n[\'x\'], n[\'y\']) in placements)\n        bonus += districts // 2\n        return int(bonus)\n\n    def calc_industrial_zone(p, placements):\n        bonus = 0\n        for n in get_neighbors(p[\'x\'], p[\'y\']):\n            if n.get(\'resource\') in [\'RESOURCE_IRON\', \'RESOURCE_COAL\', \'RESOURCE_STRATEGIC_COAL\', \'RESOURCE_ALUMINUM\', \'RESOURCE_STRATEGIC_ALUMINUM\', \'RESOURCE_COPPER\']:\n                pass # Mines would give bonus, but we don\'t know improvements.\n            # Let\'s assume no improvements.\n        districts = sum(1 for n in get_neighbors(p[\'x\'], p[\'y\']) if (n[\'x\'], n[\'y\']) in placements)\n        bonus += districts // 2\n        return int(bonus)\n\n    best_total = -1\n    best_res = {}\n\n    # Iterate over possible city centers\n    for x in range(width):\n        for y in range(height):\n            cc_plot = plots[(x, y)]\n            if \'MOUNTAIN\' in cc_plot[\'terrain\'] or \'OCEAN\' in cc_plot[\'terrain\'] or \'COAST\' in cc_plot[\'terrain\'] or cc_plot.get(\'feature\') == \'FEATURE_ICE\':\n                continue\n            \n            # City center at (x, y)\n            city_center = (x, y)\n            nearby = [p for p in map_data[\'plots\'] if get_dist(cc_plot, p, width, height) <= 3 and (p[\'x\'], p[\'y\']) != city_center and \'MOUNTAIN\' not in p[\'terrain\'] and \'OCEAN\' not in p[\'terrain\'] and \'COAST\' not in p[\'terrain\'] and p.get(\'feature\') != \'FEATURE_ICE\']\n            \n            # Try combinations of 3 districts from nearby plots\n            # To speed up, we can pick the best spots for each district type\n            best_campus = sorted(nearby, key=lambda p: calc_campus(p, {city_center: \'CITY_CENTER\'}), reverse=True)[:5]\n            for cp in best_campus:\n                placements = {city_center: \'CITY_CENTER\', (cp[\'x\'], cp[\'y\']): \'CAMPUS\'}\n                remaining = [p for p in nearby if (p[\'x\'], p[\'y\']) not in placements]\n                best_ch = sorted(remaining, key=lambda p: calc_commercial_hub(p, placements), reverse=True)[:5]\n                for chp in best_ch:\n                    placements[(chp[\'x\'], chp[\'y\'])] = \'COMMERCIAL_HUB\'\n                    remaining2 = [p for p in remaining if (p[\'x\'], p[\'y\']) not in placements]\n                    best_iz = sorted(remaining2, key=lambda p: calc_industrial_zone(p, placements), reverse=True)[:5]\n                    for izp in best_iz:\n                        placements[(izp[\'x\'], izp[\'y\'])] = \'INDUSTRIAL_ZONE\'\n                        \n                        c_bonus = calc_campus(cp, placements)\n                        ch_bonus = calc_commercial_hub(chp, placements)\n                        iz_bonus = calc_industrial_zone(izp, placements)\n                        total = c_bonus + ch_bonus + iz_bonus\n                        \n                        if total > best_total:\n                            best_total = total\n                            best_res = {\n                                "city_center": [x, y],\n                                "placements": {\n                                    "CAMPUS": [cp[\'x\'], cp[\'y\']],\n                                    "COMMERCIAL_HUB": [chp[\'x\'], chp[\'y\']],\n                                    "INDUSTRIAL_ZONE": [izp[\'x\'], izp[\'y\']]\n                                },\n                                "adjacency_bonuses": {\n                                    "CAMPUS": c_bonus,\n                                    "COMMERCIAL_HUB": ch_bonus,\n                                    "INDUSTRIAL_ZONE": iz_bonus\n                                },\n                                "total_adjacency": total\n                            }\n                        del placements[(izp[\'x\'], izp[\'y\'])]\n                    del placements[(chp[\'x\'], chp[\'y\'])]\n\n    print(json.dumps(best_res))\n\nsolve()\nEOF\npython3 optimize.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
