Sending keys: ['cat > /root/diarize.py << \'ENDSCRIPT\'\nimport json\nimport subprocess\nimport sys\nfrom pathlib import Path\n\ntry:\n    from pyannote.audio import Pipeline\n    import torch\nexcept Exception as e:\n    print(f"Error importing: {e}")\n    sys.exit(1)\n\ntry:\n    import whisper\nexcept:\n    whisper = None\n\ndef extract_audio(video_path, audio_path):\n    """Extract audio from video"""\n    print(f"[1/5] Extracting audio...")\n    cmd = [\'ffmpeg\', \'-i\', video_path, \'-acodec\', \'pcm_s16le\', \'-ac\', \'1\', \'-ar\', \'16000\', \'-y\', audio_path]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    if not Path(audio_path).exists():\n        print(f"Error: Audio extraction failed")\n        return False\n    print(f"  ✓ Audio extracted: {audio_path}")\n    return True\n\ndef get_duration(audio_path):\n    """Get audio duration"""\n    cmd = [\'ffprobe\', \'-v\', \'error\', \'-show_entries\', \'format=duration\', \'-of\', \'csv=p=0\', audio_path]\n    result = subprocess.run(cmd, capture_output=True, text=True)\n    try:\n        return float(result.stdout.strip())\n    except:\n        return 0.0\n\ndef diarize(audio_path):\n    """Perform speaker diarization"""\n    print(f"[2/5] Performing speaker diarization...")\n    try:\n        pipeline = Pipeline.from_pretrained("pyannote/speaker-diarization-3.0", use_auth_token=None)\n        diarization = pipeline(audio_path)\n        print(f"  ✓ Diarization complete")\n        return diarization\n    except Exception as e:\n        print(f"Error in diarization: {e}")\n        return None\n\ndef transcribe(audio_path):\n    """Transcribe audio with Whisper"""\n    print(f"[3/5] Transcribing audio...")\n    if not whisper:\n        print(f"  ⚠ Whisper not available, using dummy transcription")\n        return None\n    try:\n        model = whisper.load_model("tiny")\n        result = model.transcribe(audio_path, language="en", fp16=False)\n        print(f"  ✓ Transcription complete")\n        return result\n    except Exception as e:\n        print(f"  ⚠ Transcription failed: {e}")\n        return None\n\ndef generate_rttm(diarization, output_path):\n    """Generate RTTM file"""\n    print(f"[4/5] Generating RTTM file...")\n    with open(output_path, \'w\') as f:\n        for turn, _, speaker in diarization.itertracks(yield_label=True):\n            start = turn.start\n            duration = turn.end - turn.start\n            f.write(f"SPEAKER input 1 {start:.6f} {duration:.6f} <NA> <NA> {speaker} <NA> <NA>\\n")\n    print(f"  ✓ RTTM file generated: {output_path}")\n\ndef generate_ass(diarization, transcription, output_path):\n    """Generate ASS subtitle file"""\n    print(f"[5/5] Generating ASS subtitle file...")\n    \n    ass_header = """[Script Info]\nTitle: Diarization Subtitles\nScriptType: v4.00+\n\n[V4+ Styles]\nFormat: Name, Fontname, Fontsize, PrimaryColour, SecondaryColour, OutlineColour, BackColour, Bold, Italic, Underline, StrikeOut, ScaleX, ScaleY, Spacing, Angle, BorderStyle, Outline, Shadow, Alignment, MarginL, MarginR, MarginV, Encoding\nStyle: Default,Arial,20,&H00FFFFFF,&H000000FF,&H00000000,&H00000000,0,0,0,0,100,100,0,0,1,0,0,2,0,0,0,1\n\n[Events]\nFormat: Layer, Start, End, Style, Name, MarginL, MarginR, MarginV, Effect, Text\n"""\n    \n    with open(output_path, \'w\') as f:\n        f.write(ass_header)\n        \n        # Create speaker segments from diarization\n        segments = []\n        for turn, _, speaker in diarization.itertracks(yield_label=True):\n            segments.append({\n                \'start\': turn.start,\n                \'end\': turn.end,\n                \'speaker\': speaker\n            })\n        \n        # If we have transcription, try to align it\n        if transcription and \'segments\' in transcription:\n            for seg in transcription[\'segments\']:\n                seg_start = seg[\'start\']\n                seg_end = seg[\'end\']\n                text = seg[\'text\'].strip()\n                \n                # Find dominant speaker for this segment\n                speaker_times = {}\n                for turn, _, spk in diarization.itertracks(yield_label=True):\n                    overlap_start = max(turn.start, seg_start)\n                    overlap_end = min(turn.end, seg_end)\n                    if overlap_end > overlap_start:\n                        overlap = overlap_end - overlap_start\n                        speaker_times[spk] = speaker_times.get(spk, 0) + overlap\n                \n                speaker = max(speaker_times, key=speaker_times.get) if speaker_times else "spk00"\n                \n                # Format times for ASS\n                h1 = int(seg_start // 3600)\n                m1 = int((seg_start % 3600) // 60)\n                s1 = int(seg_start % 60)\n                cs1 = int((seg_start % 1) * 100)\n                \n                h2 = int(seg_end // 3600)\n                m2 = int((seg_end % 3600) // 60)\n                s2 = int(seg_end % 60)\n                cs2 = int((seg_end % 1) * 100)\n                \n                start_time = f"{h1}:{m1:02d}:{s1:02d}.{cs1:02d}"\n                end_time = f"{h2}:{m2:02d}:{s2:02d}.{cs2:02d}"\n                \n                label = speaker.upper()\n                f.write(f"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{label}: {text}\\n")\n        else:\n            # No transcription, just use speaker segments\n            for seg in segments:\n                h1 = int(seg[\'start\'] // 3600)\n                m1 = int((seg[\'start\'] % 3600) // 60)\n                s1 = int(seg[\'start\'] % 60)\n                cs1 = int((seg[\'start\'] % 1) * 100)\n                \n                h2 = int(seg[\'end\'] // 3600)\n                m2 = int((seg[\'end\'] % 3600) // 60)\n                s2 = int(seg[\'end\'] % 60)\n                cs2 = int((seg[\'end\'] % 1) * 100)\n                \n                start_time = f"{h1}:{m1:02d}:{s1:02d}.{cs1:02d}"\n                end_time = f"{h2}:{m2:02d}:{s2:02d}.{cs2:02d}"\n                \n                label = seg[\'speaker\'].upper()\n                f.write(f"Dialogue: 0,{start_time},{end_time},Default,,0,0,0,,{label}: [speech]\\n")\n    \n    print(f"  ✓ ASS file generated: {output_path}")\n\ndef count_speakers(diarization):\n    """Count number of speakers"""\n    speakers = set()\n    for turn, _, speaker in diarization.itertracks(yield_label=True):\n        speakers.add(speaker)\n    return len(speakers)\n\ndef calculate_speech_time(diarization):\n    """Calculate total speech time"""\n    total = 0\n    for turn, _, _ in diarization.itertracks(yield_label=True):\n        total += turn.end - turn.start\n    return total\n\ndef main():\n    input_video = "/root/input.mp4"\n    audio_path = "/tmp/audio.wav"\n    rttm_path = "/root/diarization.rttm"\n    ass_path = "/root/subtitles.ass"\n    report_path = "/root/report.json"\n    \n    print("\\n" + "="*60)\n    print("SPEAKER DIARIZATION PIPELINE")\n    print("="*60 + "\\n")\n    \n    steps = []\n    tools = {}\n    libraries = []\n    \n    try:\n        # Step 1: Extract audio\n        if not extract_audio(input_video, audio_path):\n            sys.exit(1)\n        steps.append("audio_extraction")\n        tools["audio_extraction"] = "ffmpeg"\n        \n        # Get duration\n        audio_duration = get_duration(audio_path)\n        print(f"  Duration: {audio_duration:.2f} seconds\\n")\n        \n        # Step 2: Diarization\n        diarization = diarize(audio_path)\n        if not diarization:\n            print("ERROR: Diarization failed")\n            sys.exit(1)\n        \n        steps.append("diarization")\n        tools["diarization"] = "pyannote.audio"\n        libraries.append("pyannote.audio")\n        libraries.append("torch")\n        \n        num_speakers = count_speakers(diarization)\n        print(f"  Speakers detected: {num_speakers}\\n")\n        \n        # Step 3: Transcription\n        transcription = transcribe(audio_path)\n        if transcription:\n            steps.append("transcription")\n            tools["transcription"] = "openai-whisper"\n            libraries.append("openai-whisper")\n        print()\n        \n        # Step 4 & 5: Generate outputs\n        generate_rttm(diarization, rttm_path)\n        generate_ass(diarization, transcription, ass_path)\n        \n        steps.append("rttm_generation")\n        steps.append("subtitle_generation")\n        \n        # Calculate metrics\n        total_speech_time = calculate_speech_time(diarization)\n        \n        # Generate report\n        report = {\n            "num_speakers_pred": num_speakers,\n            "total_speech_time_sec": round(total_speech_time, 2),\n            "audio_duration_sec": round(audio_duration, 2),\n            "steps_completed": steps,\n            "commands_used": ["ffmpeg", "ffprobe", "python3"],\n            "libraries_used": list(set(libraries)),\n            "tools_used": tools,\n            "notes": f"Successfully processed {input_video} with {num_speakers} speakers. Generated RTTM diarization output, ASS subtitle file with speaker labels, and comprehensive report."\n        }\n        \n        with open(report_path, \'w\') as f:\n            json.dump(report, f, indent=2)\n        \n        steps.append("report_generation")\n        \n        print("\\n" + "="*60)\n        print("SUMMARY")\n        print("="*60)\n        print(f"Speakers detected: {num_speakers}")\n        print(f"Total speech time: {total_speech_time:.2f}s")\n        print(f"Audio duration: {audio_duration:.2f}s")\n        print(f"\\nOutput files:")\n        print(f"  - {rttm_path}")\n        print(f"  - {ass_path}")\n        print(f"  - {report_path}")\n        print("\\n" + "="*60 + "\\n")\n        \n    except Exception as e:\n        print(f"\\nERROR: {e}")\n        import traceback\n        traceback.print_exc()\n        sys.exit(1)\n\nif __name__ == "__main__":\n    main()\nENDSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
