Sending keys: ["cat > /root/compute_pareto.py <<'PY'\nimport os\nos.environ['OMP_NUM_THREADS'] = '1'\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\n\n# Load data\ncitsci = pd.read_csv('/root/data/citsci_train.csv', usecols=['file_rad','x','y'])\nexpert = pd.read_csv('/root/data/expert_train.csv', usecols=['file_rad','x','y'])\n\n# Group by image\ncitsci_groups = {k: v[['x','y']].values for k, v in citsci.groupby('file_rad')}\nexpert_groups = {k: v[['x','y']].values for k, v in expert.groupby('file_rad')}\nimages = expert['file_rad'].unique()\nnum_images = len(images)\n\nempty = np.empty((0,2), dtype=float)\n\n# Hyperparameter grid\nmin_samples_list = list(range(3,10))\neps_list = list(range(4,25,2))\nshape_weights = [round(x,1) for x in np.arange(0.9, 2.0, 0.1)]\ncombos = [(ms, eps, w) for ms in min_samples_list for eps in eps_list for w in shape_weights]\n\nresults = []\nfor idx, (ms, eps, w) in enumerate(combos, 1):\n    f1_sum = 0.0\n    delta_sum = 0.0\n    delta_count = 0\n    scale = np.array([w, 2.0 - w])\n    for img in images:\n        exp = expert_groups.get(img, empty)\n        pts = citsci_groups.get(img, empty)\n        if pts.shape[0] == 0:\n            # no citsci points\n            continue\n        scaled = pts * scale\n        labels = DBSCAN(eps=eps, min_samples=ms).fit_predict(scaled)\n        unique_labels = set(labels)\n        clusters = []\n        for lab in unique_labels:\n            if lab == -1:\n                continue\n            clusters.append(pts[labels == lab].mean(axis=0))\n        if len(clusters) == 0 or exp.shape[0] == 0:\n            # no clusters or no expert points\n            continue\n        clusters = np.array(clusters)\n        # Greedy matching\n        dists = np.linalg.norm(clusters[:, None, :] - exp[None, :, :], axis=2)\n        pairs = []\n        for i in range(dists.shape[0]):\n            for j in range(dists.shape[1]):\n                dist = dists[i, j]\n                if dist <= 100:\n                    pairs.append((dist, i, j))\n        if not pairs:\n            continue\n        pairs.sort(key=lambda x: x[0])\n        matched_clusters = set()\n        matched_experts = set()\n        match_dists = []\n        for dist, i, j in pairs:\n            if i in matched_clusters or j in matched_experts:\n                continue\n            matched_clusters.add(i)\n            matched_experts.add(j)\n            match_dists.append(dist)\n        if len(match_dists) == 0:\n            continue\n        tp = len(match_dists)\n        fp = len(clusters) - tp\n        fn = len(exp) - tp\n        denom = 2*tp + fp + fn\n        f1 = 2*tp / denom if denom > 0 else 0.0\n        f1_sum += f1\n        delta_sum += np.mean(match_dists)\n        delta_count += 1\n    avg_f1 = f1_sum / num_images\n    avg_delta = delta_sum / delta_count if delta_count > 0 else np.nan\n    if avg_f1 > 0.5 and not np.isnan(avg_delta):\n        results.append((avg_f1, avg_delta, ms, eps, w))\n    if idx % 50 == 0:\n        print(f'Processed {idx}/{len(combos)} combos')\n\nif not results:\n    raise RuntimeError('No results with F1 > 0.5')\n\n# DataFrame and Pareto frontier\nimport pandas as pd\nimport numpy as np\n\ndf = pd.DataFrame(results, columns=['F1','delta','min_samples','epsilon','shape_weight'])\nvals = df[['F1','delta']].values\npareto_mask = np.ones(len(df), dtype=bool)\nfor i in range(len(df)):\n    for j in range(len(df)):\n        if i == j:\n            continue\n        if (vals[j,0] >= vals[i,0] and vals[j,1] <= vals[i,1] and (vals[j,0] > vals[i,0] or vals[j,1] < vals[i,1])):\n            pareto_mask[i] = False\n            break\n\npareto_df = df[pareto_mask].copy()\npareto_df = pareto_df.sort_values(['F1','delta'], ascending=[False, True])\npareto_df['F1'] = pareto_df['F1'].round(5)\npareto_df['delta'] = pareto_df['delta'].round(5)\npareto_df['shape_weight'] = pareto_df['shape_weight'].round(1)\n\npareto_df.to_csv('/root/pareto_frontier.csv', index=False)\nprint(pareto_df.head())\nprint('Saved to /root/pareto_frontier.csv with', len(pareto_df), 'rows')\nPY\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
