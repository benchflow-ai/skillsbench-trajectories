Sending keys: ['python3 << \'EOFPYTHON\'\nimport pandas as pd\nimport json\nimport numpy as np\n\nthermo = pd.read_csv(\'/app/data/thermocouples.csv\')\nmes = pd.read_csv(\'/app/data/mes_log.csv\')\n\n# Q1: Preheat ramp rate calculation\n# Preheat is zone 1, target 100-150°C, limit is 2°C/second\n# Ramp rate = (temp2 - temp1) / (time2 - time1)\n\nq1_data = {}\nviolating_runs = set()\n\nfor run_id in sorted(thermo[\'run_id\'].unique()):\n    run_data = thermo[thermo[\'run_id\'] == run_id]\n    preheat_data = run_data[run_data[\'zone_id\'] == 1].copy()\n    \n    if len(preheat_data) == 0:\n        continue\n    \n    # Group by thermocouple\n    max_ramp = {}\n    \n    for tc_id in preheat_data[\'tc_id\'].unique():\n        tc_data = preheat_data[preheat_data[\'tc_id\'] == tc_id].sort_values(\'time_s\')\n        \n        if len(tc_data) < 2:\n            continue\n        \n        # Calculate ramp rates\n        temps = tc_data[\'temp_c\'].values\n        times = tc_data[\'time_s\'].values\n        \n        ramp_rates = np.diff(temps) / np.diff(times)\n        max_ramp_rate = np.max(ramp_rates)\n        \n        max_ramp[tc_id] = max_ramp_rate\n        \n        if max_ramp_rate > 2.0:\n            violating_runs.add(run_id)\n    \n    if max_ramp:\n        # Select most representative (highest) ramp rate\n        best_tc = max(max_ramp, key=max_ramp.get)\n        q1_data[run_id] = {\n            \'tc_id\': best_tc,\n            \'max_preheat_ramp_c_per_s\': round(max_ramp[best_tc], 2)\n        }\n\nprint(f"Q1 Data (first 5):")\nfor i, (run_id, data) in enumerate(sorted(q1_data.items())[:5]):\n    print(f"  {run_id}: {data}")\n\nprint(f"\\nViolating runs (ramp > 2°C/s): {sorted(violating_runs)}")\nprint(f"Total runs with data: {len(q1_data)}")\n\nEOFPYTHON\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
