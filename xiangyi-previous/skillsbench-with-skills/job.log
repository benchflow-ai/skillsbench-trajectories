Sending keys: ['cat > /root/phase_association_v2.py << \'EOF\'\nimport obspy\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime\nimport seisbench.models\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Load data\nprint("Loading data...")\nstations_df = pd.read_csv(\'/root/data/stations.csv\')\nst = obspy.read(\'/root/data/wave.mseed\')\n\nprint(f"Loaded {len(st)} traces")\nprint(f"Time range: {st[0].stats.starttime} to {st[-1].stats.endtime}")\n\n# Load model\nprint("Loading SeisBench PhaseNet model...")\nmodel = seisbench.models.PhaseNet.from_pretrained("original")\nprint(f"Model config: sampling_rate={model.sampling_rate}, in_samples={model.in_samples}")\nprint(f"Component order: {model.component_order}, Labels: {model.labels}")\n\n# Group traces by station\nstations = {}\nfor trace in st:\n    key = (trace.stats.network, trace.stats.station)\n    if key not in stations:\n        stations[key] = obspy.Stream()\n    stations[key].append(trace)\n\nprint(f"\\nFound {len(stations)} unique stations")\n\n# Dictionary to store picks\nall_picks = []  # List of (time, network, station, phase)\n\n# Process each station\nfor (net, sta), stream in sorted(stations.items()):\n    print(f"\\nProcessing {net}.{sta} with {len(stream)} traces...")\n    \n    # Check if we have the required components\n    channels = [tr.stats.channel for tr in stream]\n    print(f"  Channels: {channels}")\n    \n    try:\n        # Annotate the stream\n        annotated_stream = model.annotate(stream, copy=True)\n        \n        # Extract picks from annotations\n        picks = model.picks_from_annotations(annotated_stream)\n        \n        if picks:\n            print(f"  Found {len(picks)} picks:")\n            for pick in picks:\n                print(f"    {pick}")\n                # pick is a dict with keys like \'time\', \'phase\', \'trace_index\'\n                if \'time\' in pick and \'phase\' in pick:\n                    all_picks.append({\n                        \'time\': pick[\'time\'],\n                        \'network\': net,\n                        \'station\': sta,\n                        \'phase\': pick[\'phase\']\n                    })\n        else:\n            print(f"  No picks found")\n    except Exception as e:\n        print(f"  Error processing station: {e}")\n        import traceback\n        traceback.print_exc()\n\nprint(f"\\n\\nTotal picks extracted: {len(all_picks)}")\nif all_picks:\n    picks_df = pd.DataFrame(all_picks)\n    print(picks_df.head(20))\n    \n    # Event association: group P-wave picks by time (within 5 seconds)\n    p_picks = picks_df[picks_df[\'phase\'] == \'P\'].copy()\n    p_picks = p_picks.sort_values(\'time\').reset_index(drop=True)\n    \n    print(f"\\nP-wave picks: {len(p_picks)}")\n    print(p_picks)\n    \n    events = []\n    if len(p_picks) > 0:\n        current_event_time = p_picks.iloc[0][\'time\']\n        current_event_picks = [p_picks.iloc[0]]\n        \n        for idx in range(1, len(p_picks)):\n            pick = p_picks.iloc[idx]\n            time_diff = (pick[\'time\'] - current_event_time).total_seconds()\n            \n            if time_diff < 5:  # 5 second window\n                current_event_picks.append(pick)\n            else:\n                # Save current event if it has enough picks\n                if len(current_event_picks) >= 3:\n                    # Use median time of all picks\n                    event_times = [p[\'time\'] for _, p in enumerate(current_event_picks)]\n                    event_time = sorted(event_times)[len(event_times)//2]\n                    events.append({\'time\': event_time})\n                \n                # Start new event\n                current_event_time = pick[\'time\']\n                current_event_picks = [pick]\n        \n        # Don\'t forget the last event\n        if len(current_event_picks) >= 3:\n            event_times = [p[\'time\'] for _, p in enumerate(current_event_picks)]\n            event_time = sorted(event_times)[len(event_times)//2]\n            events.append({\'time\': event_time})\n    \n    print(f"\\nIdentified {len(events)} earthquake events")\n    \n    # Write results\n    if events:\n        results_df = pd.DataFrame(events)\n        # Convert to ISO format without timezone\n        results_df[\'time\'] = results_df[\'time\'].dt.strftime(\'%Y-%m-%dT%H:%M:%S.%f\').str[:-3]\n        results_df.to_csv(\'/root/results.csv\', index=False)\n        print(f"\\nResults written to /root/results.csv")\n        print(results_df)\n    else:\n        # Write empty results\n        pd.DataFrame(columns=[\'time\']).to_csv(\'/root/results.csv\', index=False)\n        print("No events found, writing empty results")\nelse:\n    pd.DataFrame(columns=[\'time\']).to_csv(\'/root/results.csv\', index=False)\n    print("No picks found, writing empty results")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
