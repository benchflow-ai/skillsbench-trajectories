Sending keys: ["cat > pid_controller.py <<'EOF'\nclass PIDController:\n    def __init__(self, kp, ki, kd, integrator_limit=10.0):\n        self.kp = kp\n        self.ki = ki\n        self.kd = kd\n        self.integrator_limit = integrator_limit\n        self.reset()\n\n    def reset(self):\n        self.integral = 0.0\n        self.prev_error = None\n\n    def compute(self, error, dt):\n        if dt <= 0:\n            return 0.0\n        # Integral term with simple anti-windup\n        self.integral += error * dt\n        if self.integrator_limit is not None:\n            self.integral = max(-self.integrator_limit, min(self.integrator_limit, self.integral))\n        # Derivative term\n        if self.prev_error is None:\n            derivative = 0.0\n        else:\n            derivative = (error - self.prev_error) / dt\n        self.prev_error = error\n        return self.kp * error + self.ki * self.integral + self.kd * derivative\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > acc_system.py <<'EOF'\nfrom pid_controller import PIDController\nimport math\n\nclass AdaptiveCruiseControl:\n    def __init__(self, config):\n        self.config = config\n        acc_settings = config['acc_settings']\n        vehicle = config['vehicle']\n        pid_speed_cfg = config.get('pid_speed', {})\n        pid_distance_cfg = config.get('pid_distance', {})\n\n        self.set_speed = acc_settings['set_speed']\n        self.time_headway = acc_settings['time_headway']\n        self.min_distance = acc_settings['min_distance']\n        self.emergency_ttc_threshold = acc_settings['emergency_ttc_threshold']\n\n        self.max_acceleration = vehicle['max_acceleration']\n        self.max_deceleration = vehicle['max_deceleration']\n\n        self.pid_speed = PIDController(pid_speed_cfg.get('kp', 0.1),\n                                       pid_speed_cfg.get('ki', 0.01),\n                                       pid_speed_cfg.get('kd', 0.0))\n        self.pid_distance = PIDController(pid_distance_cfg.get('kp', 0.1),\n                                          pid_distance_cfg.get('ki', 0.01),\n                                          pid_distance_cfg.get('kd', 0.0))\n\n    def compute(self, ego_speed, lead_speed, distance, dt):\n        # Determine if lead vehicle is present\n        if lead_speed is None or distance is None:\n            mode = 'cruise'\n            speed_error = self.set_speed - ego_speed\n            accel_cmd = self.pid_speed.compute(speed_error, dt)\n            distance_error = None\n        else:\n            # Calculate time to collision\n            rel_speed = ego_speed - lead_speed\n            if rel_speed > 0:\n                ttc = distance / max(rel_speed, 1e-5)\n            else:\n                ttc = math.inf\n\n            desired_distance = self.min_distance + self.time_headway * ego_speed\n            distance_error = distance - desired_distance\n\n            if ttc < self.emergency_ttc_threshold:\n                mode = 'emergency'\n                accel_cmd = self.max_deceleration\n                # reset PID to avoid windup during emergency\n                self.pid_speed.reset()\n                self.pid_distance.reset()\n            else:\n                mode = 'follow'\n                # Distance controller determines acceleration\n                accel_distance = self.pid_distance.compute(distance_error, dt)\n                # Speed controller to keep set speed if safe\n                accel_speed = self.pid_speed.compute(self.set_speed - ego_speed, dt)\n                if distance_error >= 0:\n                    # far enough: use conservative of speed and distance commands\n                    accel_cmd = min(accel_speed, accel_distance)\n                else:\n                    # too close: prioritize distance control\n                    accel_cmd = accel_distance\n\n        # Apply acceleration limits\n        accel_cmd = max(self.max_deceleration, min(self.max_acceleration, accel_cmd))\n        return accel_cmd, mode, distance_error\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
Sending keys: ["cat > simulation.py <<'EOF'\nimport csv\nimport yaml\nfrom acc_system import AdaptiveCruiseControl\n\n\ndef load_yaml(path):\n    with open(path, 'r') as f:\n        return yaml.safe_load(f)\n\n\ndef main():\n    config = load_yaml('vehicle_params.yaml')\n    tuning = load_yaml('tuning_results.yaml')\n    # override PID gains with tuned values\n    config['pid_speed'] = tuning['pid_speed']\n    config['pid_distance'] = tuning['pid_distance']\n\n    acc = AdaptiveCruiseControl(config)\n    dt = config['simulation']['dt']\n\n    # Read sensor data\n    with open('sensor_data.csv', 'r') as f:\n        reader = csv.DictReader(f)\n        data = list(reader)\n\n    # Initialize states\n    ego_speed = 0.0\n    ego_pos = 0.0\n    lead_pos = None\n\n    results = []\n\n    for row in data:\n        time = float(row['time'])\n        lead_speed = row['lead_speed']\n        distance_meas = row['distance']\n\n        lead_speed = float(lead_speed) if lead_speed != '' else None\n        distance_meas = float(distance_meas) if distance_meas != '' else None\n\n        # Handle lead appearance/disappearance\n        if lead_speed is None:\n            lead_pos = None\n        else:\n            if lead_pos is None:\n                # initialize lead position using measured distance\n                if distance_meas is None:\n                    distance_meas = config['acc_settings']['min_distance']\n                lead_pos = ego_pos + distance_meas\n\n        # Compute current distance\n        distance = None\n        if lead_pos is not None:\n            distance = lead_pos - ego_pos\n\n        # Compute control\n        accel_cmd, mode, distance_error = acc.compute(ego_speed, lead_speed, distance, dt)\n\n        # Compute TTC for reporting\n        ttc = None\n        if lead_speed is not None and distance is not None and ego_speed > lead_speed:\n            rel_speed = ego_speed - lead_speed\n            ttc = distance / max(rel_speed, 1e-5)\n\n        # Store results at current time\n        results.append({\n            'time': time,\n            'ego_speed': ego_speed,\n            'acceleration_cmd': accel_cmd,\n            'mode': mode,\n            'distance_error': distance_error,\n            'distance': distance,\n            'ttc': ttc\n        })\n\n        # Update vehicle states for next timestep\n        ego_speed = max(0.0, ego_speed + accel_cmd * dt)\n        ego_pos += ego_speed * dt\n        if lead_pos is not None and lead_speed is not None:\n            lead_pos += lead_speed * dt\n\n    # Write simulation results\n    with open('simulation_results.csv', 'w', newline='') as f:\n        fieldnames = ['time', 'ego_speed', 'acceleration_cmd', 'mode', 'distance_error', 'distance', 'ttc']\n        writer = csv.DictWriter(f, fieldnames=fieldnames)\n        writer.writeheader()\n        for row in results:\n            # convert None to empty string for CSV\n            writer.writerow({k: ('' if row[k] is None else round(row[k], 4)) for k in fieldnames})\n\n\nif __name__ == '__main__':\n    main()\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
