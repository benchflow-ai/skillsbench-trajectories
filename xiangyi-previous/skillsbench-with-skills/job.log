ersion', 'CVE_ID', 'Severity', 'CVSS_Score', 'Fixed_Version', 'Title', 'Url']\n    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n    \n    writer.writeheader()\n    for vuln in vulnerabilities:\n        writer.writerow(vuln)\n\nprint(f'Successfully wrote {len(vulnerabilities)} vulnerabilities to /root/security_audit.csv')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
