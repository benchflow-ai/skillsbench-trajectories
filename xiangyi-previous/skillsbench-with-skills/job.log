Sending keys: ['cat << \'EOF\' > solution.py\nimport cv2\nimport numpy as np\nimport json\n\ndef get_csr(mask):\n    # mask is HxW boolean array\n    # CSR representation: data, indices, indptr\n    # Since it\'s a binary mask, \'data\' is just all True values\n    rows, cols = np.where(mask)\n    data = np.ones(len(rows), dtype=bool)\n    indices = cols.astype(np.int32)\n    \n    H, W = mask.shape\n    indptr = np.zeros(H + 1, dtype=np.int32)\n    counts = np.bincount(rows, minlength=H)\n    indptr[1:] = np.cumsum(counts)\n    return data, indices, indptr\n\nvideo_path = \'/root/input.mp4\'\ncap = cv2.VideoCapture(video_path)\noriginal_fps = cap.get(cv2.CAP_PROP_FPS)\ntarget_fps = 6\nskip = max(1, int(round(original_fps / target_fps)))\n\nframes = []\ncount = 0\nwhile True:\n    ret, frame = cap.read()\n    if not ret: break\n    if count % skip == 0:\n        frames.append(frame)\n    count += 1\ncap.release()\n\nlabels_dict = {}\nmasks_data = {}\n\nH, W = frames[0].shape[:2]\nmasks_data[\'shape\'] = np.array([H, W])\n\norb = cv2.ORB_create(nfeatures=2000)\n\nfor i in range(len(frames) - 1):\n    f1 = frames[i]\n    f2 = frames[i+1]\n    \n    gray1 = cv2.cvtColor(f1, cv2.COLOR_BGR2GRAY)\n    gray2 = cv2.cvtColor(f2, cv2.COLOR_BGR2GRAY)\n    \n    kp1, des1 = orb.detectAndCompute(gray1, None)\n    kp2, des2 = orb.detectAndCompute(gray2, None)\n    \n    bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)\n    matches = bf.match(des1, des2)\n    matches = sorted(matches, key=lambda x: x.distance)\n    \n    src_pts = np.float32([kp1[m.queryIdx].pt for m in matches]).reshape(-1, 1, 2)\n    dst_pts = np.float32([kp2[m.trainIdx].pt for m in matches]).reshape(-1, 1, 2)\n    \n    # Estimate transformation (Rotation, Translation, Scale)\n    M, inliers = cv2.estimateAffinePartial2D(src_pts, dst_pts, method=cv2.RANSAC, ransacReprojThreshold=3.0)\n    \n    motion_labels = []\n    if M is not None:\n        tx = M[0, 2]\n        ty = M[1, 2]\n        s = np.sqrt(M[0, 0]**2 + M[0, 1]**2)\n        angle = np.arctan2(M[1, 0], M[0, 1]) # simplified rotation check\n        # More robust angle\n        angle = np.arctan2(M[1, 0], M[0, 0])\n        \n        # Thresholds for labels (tuning might be needed)\n        if abs(tx) > 1.5: motion_labels.append("Pan Left" if tx > 0 else "Pan Right")\n        if abs(ty) > 1.5: motion_labels.append("Tilt Down" if ty > 0 else "Tilt Up")\n        if s > 1.005: motion_labels.append("Dolly In")\n        elif s < 0.995: motion_labels.append("Dolly Out")\n        if abs(angle) > 0.005:\n            motion_labels.append("Roll Left" if angle < 0 else "Roll Right")\n            \n    if not motion_labels:\n        motion_labels.append("Stay")\n    \n    labels_dict[f"{i}->{i+1}"] = motion_labels\n    \n    # Dynamic object detection\n    if M is not None:\n        warped_f1 = cv2.warpAffine(f1, M, (W, H))\n        diff = cv2.absdiff(warped_f1, f2)\n        diff_gray = cv2.cvtColor(diff, cv2.COLOR_BGR2GRAY)\n        _, mask = cv2.threshold(diff_gray, 30, 255, cv2.THRESH_BINARY)\n        # Clean up mask\n        kernel = np.ones((5,5), np.uint8)\n        mask = cv2.morphologyEx(mask, cv2.MORPH_OPEN, kernel)\n        mask = cv2.morphologyEx(mask, cv2.MORPH_DILATE, kernel)\n    else:\n        mask = np.zeros((H, W), dtype=np.uint8)\n        \n    binary_mask = mask > 0\n    data, indices, indptr = get_csr(binary_mask)\n    masks_data[f"f_{i}_data"] = data\n    masks_data[f"f_{i}_indices"] = indices\n    masks_data[f"f_{i}_indptr"] = indptr\n\n# Last frame mask (empty or repeat last)\nlast_idx = len(frames) - 1\ndata, indices, indptr = get_csr(np.zeros((H, W), dtype=bool))\nmasks_data[f"f_{last_idx}_data"] = data\nmasks_data[f"f_{last_idx}_indices"] = indices\nmasks_data[f"f_{last_idx}_indptr"] = indptr\n\nwith open(\'/root/pred_instructions.json\', \'w\') as f:\n    json.dump(labels_dict, f, indent=2)\n\nnp.savez(\'/root/pred_dyn_masks.npz\', **masks_data)\nEOF\npython3 solution.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
