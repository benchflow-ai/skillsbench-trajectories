Sending keys: ['python3 << \'EOF\'\nimport numpy as np\nimport os\nfrom scipy import signal\nimport csv\nfrom pathlib import Path\n\ndef sta_lta_picker(trace, dt, sta_len=0.5, lta_len=5.0):\n    """\n    Simple STA/LTA picker for phase detection.\n    Returns indices where STA/LTA ratio exceeds threshold.\n    """\n    sta_samples = int(sta_len / dt)\n    lta_samples = int(lta_len / dt)\n    \n    # Compute envelope (absolute value)\n    envelope = np.abs(trace)\n    \n    # Compute STA and LTA\n    sta = np.convolve(envelope, np.ones(sta_samples)/sta_samples, mode=\'same\')\n    lta = np.convolve(envelope, np.ones(lta_samples)/lta_samples, mode=\'same\')\n    \n    # Avoid division by zero\n    lta[lta == 0] = 1e-10\n    \n    # Compute ratio\n    ratio = sta / lta\n    \n    return ratio\n\ndef find_peaks_simple(ratio, threshold=2.0, min_distance=100):\n    """\n    Find peaks in STA/LTA ratio above threshold.\n    """\n    peaks = []\n    in_peak = False\n    peak_start = 0\n    \n    for i in range(len(ratio)):\n        if ratio[i] > threshold and not in_peak:\n            in_peak = True\n            peak_start = i\n        elif ratio[i] <= threshold and in_peak:\n            in_peak = False\n            # Record peak center\n            peak_idx = peak_start + np.argmax(ratio[peak_start:i])\n            if len(peaks) == 0 or peak_idx - peaks[-1] > min_distance:\n                peaks.append(peak_idx)\n    \n    return peaks\n\ndef pick_phases(data, dt, channels):\n    """\n    Pick P and S waves from seismic data.\n    Returns lists of (phase, index) tuples.\n    """\n    picks = []\n    \n    # Combine all channels (RMS)\n    rms = np.sqrt(np.mean(data**2, axis=1))\n    \n    # Apply STA/LTA\n    ratio = sta_lta_picker(rms, dt, sta_len=0.3, lta_len=3.0)\n    \n    # Find peaks\n    peaks = find_peaks_simple(ratio, threshold=1.8, min_distance=200)\n    \n    # First peak is likely P wave, second is likely S wave\n    if len(peaks) > 0:\n        picks.append((\'P\', peaks[0]))\n    if len(peaks) > 1:\n        picks.append((\'S\', peaks[1]))\n    \n    return picks\n\n# Process all files\ndata_dir = \'/root/data/\'\nresults = []\n\nfor filename in sorted(os.listdir(data_dir)):\n    if filename.endswith(\'.npz\'):\n        filepath = os.path.join(data_dir, filename)\n        try:\n            data_dict = np.load(filepath)\n            waveform = data_dict[\'data\']\n            dt = float(data_dict[\'dt\'])\n            channels = str(data_dict[\'channels\'])\n            \n            picks = pick_phases(waveform, dt, channels)\n            \n            for phase, idx in picks:\n                results.append({\n                    \'file_name\': filename,\n                    \'phase\': phase,\n                    \'pick_idx\': int(idx)\n                })\n        except Exception as e:\n            print(f"Error processing {filename}: {e}")\n\n# Write results to CSV\nwith open(\'/root/results.csv\', \'w\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'file_name\', \'phase\', \'pick_idx\'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint(f"Processed {len([f for f in os.listdir(data_dir) if f.endswith(\'.npz\')])} files")\nprint(f"Found {len(results)} picks")\nprint(f"Results written to /root/results.csv")\n\nEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
