Sending keys: ['cat > /root/unify_taxonomy.py << \'ENDOFSCRIPT\'\nimport pandas as pd\nimport numpy as np\nimport re\nfrom collections import defaultdict, Counter\nimport csv\nimport os\n\n# Load data files\nprint("Loading data files...")\namazon_df = pd.read_csv(\'/root/data/amazon_product_categories.csv\')\nfb_df = pd.read_csv(\'/root/data/fb_product_categories.csv\')\ngoogle_df = pd.read_csv(\'/root/data/google_shopping_product_categories.csv\')\n\nprint(f"Amazon: {len(amazon_df)} rows")\nprint(f"Facebook: {len(fb_df)} rows")\nprint(f"Google: {len(google_df)} rows")\n\n# Standardize and clean category paths\ndef clean_text(text):\n    """Standardize category text"""\n    if pd.isna(text):\n        return ""\n    text = str(text).strip()\n    text = re.sub(r\'\\s+\', \' \', text)\n    text = text.title()\n    # Remove trailing/leading punctuation\n    text = text.strip(\'"\\\' \')\n    return text\n\ndef parse_category_path(path):\n    """Parse a category path into levels"""\n    if pd.isna(path):\n        return []\n    parts = str(path).split(\' > \')\n    return [clean_text(p) for p in parts if p.strip()]\n\n# Define unified top-level category mappings\n# Map original top-level categories to unified categories\nTOP_LEVEL_MAPPING = {\n    # Sports & Outdoors\n    \'Sporting Goods\': \'Sports | Outdoors | Recreation\',\n    \'Sports & Outdoors\': \'Sports | Outdoors | Recreation\',\n    \'Sports & Fitness\': \'Sports | Outdoors | Recreation\',\n    \'Outdoor Recreation\': \'Sports | Outdoors | Recreation\',\n    \n    # Home & Garden\n    \'Home & Garden\': \'Home | Garden | Living\',\n    \'Home\': \'Home | Garden | Living\',\n    \'Patio & Garden\': \'Home | Garden | Living\',\n    \'Home & Kitchen\': \'Home | Garden | Living\',\n    \'Furniture\': \'Home | Garden | Living\',\n    \'Kitchen & Dining\': \'Home | Garden | Living\',\n    \'Lawn & Garden\': \'Home | Garden | Living\',\n    \'Garden & Outdoor\': \'Home | Garden | Living\',\n    \n    # Hardware & Tools\n    \'Hardware\': \'Hardware | Tools | Building\',\n    \'Home Improvement\': \'Hardware | Tools | Building\',\n    \'Tools & Home Improvement\': \'Hardware | Tools | Building\',\n    \'Building Materials\': \'Hardware | Tools | Building\',\n    \n    # Electronics\n    \'Electronics\': \'Electronics | Technology\',\n    \'Cameras & Optics\': \'Electronics | Technology\',\n    \'Computers & Electronics\': \'Electronics | Technology\',\n    \'Cell Phones & Accessories\': \'Electronics | Technology\',\n    \'Software\': \'Electronics | Technology\',\n    \n    # Books & Media\n    \'Books\': \'Books | Media | Entertainment\',\n    \'Arts & Entertainment\': \'Books | Media | Entertainment\',\n    \'Media\': \'Books | Media | Entertainment\',\n    \'Movies & Tv\': \'Books | Media | Entertainment\',\n    \'Music\': \'Books | Media | Entertainment\',\n    \'Musical Instruments\': \'Books | Media | Entertainment\',\n    \n    # Health & Beauty\n    \'Health & Beauty\': \'Health | Beauty | Personal Care\',\n    \'Beauty & Personal Care\': \'Health | Beauty | Personal Care\',\n    \'Health & Household\': \'Health | Beauty | Personal Care\',\n    \'Personal Care\': \'Health | Beauty | Personal Care\',\n    \n    # Food & Beverages\n    \'Food, Beverages & Tobacco\': \'Food | Beverages | Grocery\',\n    \'Grocery & Gourmet Food\': \'Food | Beverages | Grocery\',\n    \'Food & Beverages\': \'Food | Beverages | Grocery\',\n    \n    # Clothing & Fashion\n    \'Clothing & Accessories\': \'Clothing | Fashion | Accessories\',\n    \'Apparel & Accessories\': \'Clothing | Fashion | Accessories\',\n    \'Clothing, Shoes & Jewelry\': \'Clothing | Fashion | Accessories\',\n    "Women\'S Fashion": \'Clothing | Fashion | Accessories\',\n    "Men\'S Fashion": \'Clothing | Fashion | Accessories\',\n    \'Luggage & Travel Gear\': \'Clothing | Fashion | Accessories\',\n    \n    # Toys & Games\n    \'Toys & Games\': \'Toys | Games | Hobbies\',\n    \'Toys\': \'Toys | Games | Hobbies\',\n    \'Games\': \'Toys | Games | Hobbies\',\n    \n    # Automotive & Vehicles\n    \'Automotive\': \'Automotive | Vehicles | Parts\',\n    \'Vehicles & Parts\': \'Automotive | Vehicles | Parts\',\n    \n    # Baby & Kids\n    \'Baby Products\': \'Baby | Kids | Maternity\',\n    \'Baby & Toddler\': \'Baby | Kids | Maternity\',\n    \'Baby\': \'Baby | Kids | Maternity\',\n    \n    # Pets & Animals\n    \'Animals & Pet Supplies\': \'Pets | Animals | Supplies\',\n    \'Pet Supplies\': \'Pets | Animals | Supplies\',\n    \n    # Business & Industrial\n    \'Business & Industrial\': \'Business | Industrial | Office\',\n    \'Industrial & Scientific\': \'Business | Industrial | Office\',\n    \'Office Supplies\': \'Business | Industrial | Office\',\n    \'Office Products\': \'Business | Industrial | Office\',\n    \n    # Mature\n    \'Mature\': \'Adult | Mature Products\',\n    \n    # Religious & Ceremonial\n    \'Religious & Ceremonial\': \'Religious | Ceremonial | Occasions\',\n}\n\n# Default mapping for unmapped categories\ndef get_unified_level1(original_cat):\n    """Get unified level 1 category"""\n    if original_cat in TOP_LEVEL_MAPPING:\n        return TOP_LEVEL_MAPPING[original_cat]\n    # Try partial matching\n    original_lower = original_cat.lower()\n    if \'sport\' in original_lower or \'outdoor\' in original_lower or \'fitness\' in original_lower:\n        return \'Sports | Outdoors | Recreation\'\n    if \'home\' in original_lower or \'garden\' in original_lower or \'furniture\' in original_lower or \'kitchen\' in original_lower:\n        return \'Home | Garden | Living\'\n    if \'tool\' in original_lower or \'hardware\' in original_lower or \'improvement\' in original_lower:\n        return \'Hardware | Tools | Building\'\n    if \'electron\' in original_lower or \'computer\' in original_lower or \'phone\' in original_lower or \'camera\' in original_lower:\n        return \'Electronics | Technology\'\n    if \'book\' in original_lower or \'media\' in original_lower or \'music\' in original_lower or \'movie\' in original_lower or \'art\' in original_lower or \'entertainment\' in original_lower:\n        return \'Books | Media | Entertainment\'\n    if \'health\' in original_lower or \'beauty\' in original_lower or \'personal\' in original_lower:\n        return \'Health | Beauty | Personal Care\'\n    if \'food\' in original_lower or \'beverage\' in original_lower or \'grocery\' in original_lower:\n        return \'Food | Beverages | Grocery\'\n    if \'cloth\' in original_lower or \'apparel\' in original_lower or \'fashion\' in original_lower or \'shoe\' in original_lower or \'jewelry\' in original_lower:\n        return \'Clothing | Fashion | Accessories\'\n    if \'toy\' in original_lower or \'game\' in original_lower or \'hobby\' in original_lower:\n        return \'Toys | Games | Hobbies\'\n    if \'auto\' in original_lower or \'vehicle\' in original_lower or \'car\' in original_lower:\n        return \'Automotive | Vehicles | Parts\'\n    if \'baby\' in original_lower or \'kid\' in original_lower or \'toddler\' in original_lower:\n        return \'Baby | Kids | Maternity\'\n    if \'pet\' in original_lower or \'animal\' in original_lower:\n        return \'Pets | Animals | Supplies\'\n    if \'business\' in original_lower or \'industrial\' in original_lower or \'office\' in original_lower or \'scientific\' in original_lower:\n        return \'Business | Industrial | Office\'\n    if \'mature\' in original_lower or \'adult\' in original_lower:\n        return \'Adult | Mature Products\'\n    if \'religious\' in original_lower or \'ceremonial\' in original_lower:\n        return \'Religious | Ceremonial | Occasions\'\n    # Default fallback\n    return \'Other | Miscellaneous\'\n\n# Process each source\ndef process_source(df, source_name):\n    """Process a dataframe and extract category information"""\n    records = []\n    for idx, row in df.iterrows():\n        path = row[\'category_path\']\n        levels = parse_category_path(path)\n        if levels:\n            records.append({\n                \'source\': source_name,\n                \'category_path\': path,\n                \'levels\': levels,\n                \'depth\': len(levels)\n            })\n    return records\n\nprint("\\nProcessing sources...")\namazon_records = process_source(amazon_df, \'amazon\')\nfb_records = process_source(fb_df, \'facebook\')\ngoogle_records = process_source(google_df, \'google\')\n\nall_records = amazon_records + fb_records + google_records\nprint(f"Total records: {len(all_records)}")\n\n# Build hierarchical structure\nprint("\\nBuilding unified taxonomy...")\n\n# Collect all unique paths at each level within each unified L1\nhierarchy = defaultdict(lambda: defaultdict(lambda: defaultdict(lambda: defaultdict(set))))\n\nfor r in all_records:\n    levels = r[\'levels\']\n    if not levels:\n        continue\n    \n    # Get unified level 1\n    unified_l1 = get_unified_level1(levels[0])\n    \n    # Use original levels 2-5 as basis for unified levels 2-5\n    l2 = levels[1] if len(levels) > 1 else \'\'\n    l3 = levels[2] if len(levels) > 2 else \'\'\n    l4 = levels[3] if len(levels) > 3 else \'\'\n    l5 = levels[4] if len(levels) > 4 else \'\'\n    \n    if l2:\n        hierarchy[unified_l1][l2][l3][l4].add(l5 if l5 else \'\')\n\n# Count categories at each level\nprint(f"\\nUnified Level 1 categories: {len(hierarchy)}")\nfor l1 in sorted(hierarchy.keys()):\n    print(f"  {l1}: {len(hierarchy[l1])} L2 categories")\n\nENDOFSCRIPT\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
