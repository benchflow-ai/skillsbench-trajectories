Sending keys: ['cat > /root/phase_picker2.py << \'ENDOFSCRIPT\'\nimport numpy as np\nimport os\nfrom scipy import signal\nfrom scipy.ndimage import uniform_filter1d\nimport csv\n\ndef bandpass_filter(data, lowcut, highcut, fs, order=3):\n    """Apply bandpass filter to data"""\n    nyq = 0.5 * fs\n    low = lowcut / nyq\n    high = highcut / nyq\n    low = max(0.001, min(low, 0.99))\n    high = max(low + 0.01, min(high, 0.999))\n    b, a = signal.butter(order, [low, high], btype=\'band\')\n    return signal.filtfilt(b, a, data, axis=0, padlen=min(150, len(data)-1))\n\ndef recursive_sta_lta(data, sta_len, lta_len):\n    """Calculate recursive STA/LTA ratio"""\n    npts = len(data)\n    cf = np.zeros(npts)\n    abs_data = np.abs(data)\n    \n    # Initialize\n    sta = np.mean(abs_data[:sta_len])\n    lta = np.mean(abs_data[:lta_len])\n    \n    for i in range(lta_len, npts):\n        sta = sta + (abs_data[i] - abs_data[i-sta_len]) / sta_len\n        lta = lta + (abs_data[i] - abs_data[i-lta_len]) / lta_len\n        if lta > 1e-10:\n            cf[i] = sta / lta\n    \n    return cf\n\ndef pick_phase_stalta(data, fs, sta_sec=0.1, lta_sec=2.0, threshold=2.0):\n    """Pick phase using STA/LTA method"""\n    sta_len = int(sta_sec * fs)\n    lta_len = int(lta_sec * fs)\n    \n    cf = recursive_sta_lta(data, sta_len, lta_len)\n    \n    # Find where CF exceeds threshold\n    above_thresh = np.where(cf > threshold)[0]\n    \n    if len(above_thresh) > 0:\n        # Return the first point where threshold is exceeded\n        idx = above_thresh[0]\n        # Refine by looking for the actual onset\n        for j in range(idx, max(0, idx-sta_len), -1):\n            if cf[j] < threshold * 0.7:\n                return j\n        return idx\n    return None\n\ndef pick_by_energy(data, fs, window_sec=0.5):\n    """Pick based on energy increase"""\n    window = int(window_sec * fs)\n    \n    # Calculate running energy\n    energy = uniform_filter1d(data**2, size=window, mode=\'nearest\')\n    \n    # Calculate derivative of energy\n    energy_diff = np.diff(energy)\n    \n    # Find maximum energy increase\n    if len(energy_diff) > 0:\n        max_idx = np.argmax(energy_diff)\n        return max_idx\n    return None\n\ndef pick_by_kurtosis(data, fs, window_sec=1.0):\n    """Pick based on kurtosis - higher kurtosis indicates impulsive arrival"""\n    window = int(window_sec * fs)\n    npts = len(data)\n    kurtosis = np.zeros(npts)\n    \n    for i in range(window, npts - window):\n        segment = data[i:i+window]\n        mean = np.mean(segment)\n        std = np.std(segment)\n        if std > 1e-10:\n            kurtosis[i] = np.mean(((segment - mean) / std) ** 4) - 3\n    \n    # Find maximum kurtosis\n    max_idx = np.argmax(kurtosis)\n    return max_idx\n\ndef aic_pick(data):\n    """Akaike Information Criterion picker"""\n    npts = len(data)\n    aic = np.zeros(npts)\n    \n    for k in range(1, npts - 1):\n        var1 = np.var(data[:k]) if k > 0 else 1e-10\n        var2 = np.var(data[k:]) if k < npts else 1e-10\n        var1 = max(var1, 1e-10)\n        var2 = max(var2, 1e-10)\n        aic[k] = k * np.log(var1) + (npts - k - 1) * np.log(var2)\n    \n    # Find minimum AIC (excluding edges)\n    margin = int(npts * 0.05)\n    search_region = aic[margin:npts-margin]\n    if len(search_region) > 0:\n        min_idx = np.argmin(search_region) + margin\n        return min_idx\n    return npts // 2\n\ndef process_file(filepath):\n    """Process a single trace file and return picks"""\n    f = np.load(filepath, allow_pickle=True)\n    data = f[\'data\']  # shape: (12000, 3)\n    dt = float(f[\'dt\'])\n    fs = 1.0 / dt\n    channels = str(f[\'channels\']).split(\',\')\n    \n    # Identify channel indices (E, N, Z)\n    z_idx, e_idx, n_idx = 2, 0, 1  # defaults\n    \n    for i, ch in enumerate(channels):\n        if ch.endswith(\'Z\'):\n            z_idx = i\n        elif ch.endswith(\'E\') or ch.endswith(\'1\'):\n            e_idx = i\n        elif ch.endswith(\'N\') or ch.endswith(\'2\'):\n            n_idx = i\n    \n    # Get components\n    data_z = data[:, z_idx].copy()\n    data_e = data[:, e_idx].copy()\n    data_n = data[:, n_idx].copy()\n    \n    # Remove mean\n    data_z -= np.mean(data_z)\n    data_e -= np.mean(data_e)\n    data_n -= np.mean(data_n)\n    \n    # Filter for P-wave (higher frequency content)\n    try:\n        filt_z = bandpass_filter(data_z, 1.0, 20.0, fs)\n    except:\n        filt_z = data_z\n    \n    # Filter for S-wave (slightly lower frequency)\n    try:\n        horizontal = np.sqrt(data_e**2 + data_n**2)\n        filt_h = bandpass_filter(horizontal, 1.0, 15.0, fs)\n    except:\n        filt_h = np.sqrt(data_e**2 + data_n**2)\n    \n    picks = []\n    \n    # Try multiple methods for P-wave and take the best\n    p_candidates = []\n    \n    # Method 1: STA/LTA with different thresholds\n    for thresh in [1.5, 2.0, 2.5, 3.0]:\n        p = pick_phase_stalta(filt_z, fs, sta_sec=0.1, lta_sec=2.0, threshold=thresh)\n        if p is not None and 100 < p < 11900:\n            p_candidates.append(p)\n            break\n    \n    # Method 2: AIC picker on filtered vertical\n    aic_p = aic_pick(filt_z)\n    if 100 < aic_p < 11900:\n        p_candidates.append(aic_p)\n    \n    # Method 3: Energy-based\n    energy_p = pick_by_energy(filt_z, fs, window_sec=0.3)\n    if energy_p is not None and 100 < energy_p < 11900:\n        p_candidates.append(energy_p)\n    \n    # Choose P pick - prefer STA/LTA if available, otherwise use AIC\n    if len(p_candidates) > 0:\n        # Use median of candidates to be robust\n        p_pick = int(np.median(p_candidates))\n    else:\n        # Fallback: use middle of trace\n        p_pick = 6000\n    \n    picks.append((\'P\', p_pick))\n    \n    # S-wave picking\n    s_candidates = []\n    \n    # Search for S-wave after P-wave\n    min_ps_sep = int(0.2 * fs)  # Minimum 0.2 seconds after P\n    search_start = p_pick + min_ps_sep\n    \n    if search_start < len(filt_h) - 100:\n        # Method 1: STA/LTA on horizontal after P\n        for thresh in [1.3, 1.5, 2.0]:\n            s = pick_phase_stalta(filt_h[search_start:], fs, sta_sec=0.15, lta_sec=1.5, threshold=thresh)\n            if s is not None:\n                s_idx = search_start + s\n                if s_idx < 11900:\n                    s_candidates.append(s_idx)\n                    break\n        \n        # Method 2: AIC on horizontal after P\n        aic_s = aic_pick(filt_h[search_start:])\n        s_idx = search_start + aic_s\n        if s_idx < 11900:\n            s_candidates.append(s_idx)\n        \n        # Method 3: Energy-based after P\n        energy_s = pick_by_energy(filt_h[search_start:], fs, window_sec=0.3)\n        if energy_s is not None:\n            s_idx = search_start + energy_s\n            if s_idx < 11900:\n                s_candidates.append(s_idx)\n    \n    if len(s_candidates) > 0:\n        s_pick = int(np.median(s_candidates))\n    else:\n        # Fallback: estimate S from P using typical Vp/Vs ratio\n        # S arrives about 1.73x later than P (relative to event time)\n        # Assume event is at index 6000, so S is roughly at P + 0.73*(P-6000) or just P + some offset\n        s_pick = min(p_pick + int(1.0 * fs), 11900)  # 1 second after P as fallback\n    \n    picks.append((\'S\', s_pick))\n    \n    return picks\n\ndef main():\n    data_dir = \'/root/data/\'\n    output_file = \'/root/results.csv\'\n    \n    files = sorted([f for f in os.listdir(data_dir) if f.endswith(\'.npz\')])\n    \n    results = []\n    \n    for fname in files:\n        filepath = os.path.join(data_dir, fname)\n        try:\n            picks = process_file(filepath)\n            for phase, idx in picks:\n                results.append({\n                    \'file_name\': fname,\n                    \'phase\': phase,\n                    \'pick_idx\': idx\n                })\n        except Exception as e:\n            print(f\'Error processing {fname}: {e}\')\n            # Add fallback picks\n            results.append({\'file_name\': fname, \'phase\': \'P\', \'pick_idx\': 6000})\n            results.append({\'file_name\': fname, \'phase\': \'S\', \'pick_idx\': 7000})\n    \n    # Write results to CSV\n    with open(output_file, \'w\', newline=\'\') as csvfile:\n        fieldnames = [\'file_name\', \'phase\', \'pick_idx\']\n        writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n        writer.writeheader()\n        for row in results:\n            writer.writerow(row)\n    \n    print(f\'Processed {len(files)} files\')\n    print(f\'Total picks: {len(results)}\')\n    print(f\'Results written to {output_file}\')\n\nif __name__ == \'__main__\':\n    main()\nENDOFSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
