Sending keys: ['cat > test_solution.py << \'EOF\'\n#!/usr/bin/env python3\n"""Test the parallel solution."""\n\nimport time\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\n\ndef test_correctness():\n    """Test that parallel version produces same results as sequential."""\n    print("=" * 60)\n    print("Testing Correctness")\n    print("=" * 60)\n    \n    # Generate small corpus\n    print("\\nGenerating test corpus...")\n    documents = generate_corpus(num_docs=1000, seed=42)\n    print(f"Generated {len(documents)} documents")\n    \n    # Build sequential index\n    print("\\nBuilding sequential index...")\n    seq_result = build_tfidf_index_sequential(documents)\n    print(f"Sequential: {seq_result.elapsed_time:.3f}s, vocab: {seq_result.vocabulary_size}")\n    \n    # Build parallel index\n    print("\\nBuilding parallel index...")\n    par_result = build_tfidf_index_parallel(documents, num_workers=4)\n    print(f"Parallel: {par_result.elapsed_time:.3f}s, vocab: {par_result.vocabulary_size}")\n    \n    # Compare indices\n    print("\\nComparing indices...")\n    assert seq_result.num_documents == par_result.num_documents, "Document count mismatch"\n    assert seq_result.vocabulary_size == par_result.vocabulary_size, "Vocabulary size mismatch"\n    \n    # Compare vocabularies\n    assert seq_result.index.vocabulary == par_result.index.vocabulary, "Vocabulary mismatch"\n    \n    # Compare document frequencies\n    assert seq_result.index.document_frequencies == par_result.index.document_frequencies, "DF mismatch"\n    \n    # Compare IDF scores\n    for term in seq_result.index.idf:\n        assert abs(seq_result.index.idf[term] - par_result.index.idf[term]) < 1e-10, f"IDF mismatch for {term}"\n    \n    print("✓ Index structure matches")\n    \n    # Test search\n    queries = [\n        "machine learning algorithm",\n        "database system performance",\n        "neural network training"\n    ]\n    \n    print("\\nTesting search...")\n    seq_search_results = batch_search_sequential(queries, seq_result.index, top_k=10, documents=documents)\n    par_search_results, _ = batch_search_parallel(queries, par_result.index, top_k=10, num_workers=4, documents=documents)\n    \n    # Compare search results\n    for i, (seq_res, par_res) in enumerate(zip(seq_search_results, par_search_results)):\n        assert len(seq_res) == len(par_res), f"Query {i}: result count mismatch"\n        for j, (s, p) in enumerate(zip(seq_res, par_res)):\n            assert s.doc_id == p.doc_id, f"Query {i}, result {j}: doc_id mismatch"\n            assert abs(s.score - p.score) < 1e-10, f"Query {i}, result {j}: score mismatch"\n    \n    print("✓ Search results match")\n    print("\\n" + "=" * 60)\n    print("ALL CORRECTNESS TESTS PASSED")\n    print("=" * 60)\n\n\ndef test_performance():\n    """Test performance with larger corpus."""\n    print("\\n" + "=" * 60)\n    print("Testing Performance")\n    print("=" * 60)\n    \n    # Generate larger corpus\n    print("\\nGenerating performance test corpus...")\n    documents = generate_corpus(num_docs=5000, seed=42)\n    print(f"Generated {len(documents)} documents")\n    \n    # Test indexing performance\n    print("\\n" + "-" * 60)\n    print("Indexing Performance")\n    print("-" * 60)\n    \n    # Sequential\n    print("\\nSequential indexing...")\n    seq_result = build_tfidf_index_sequential(documents)\n    seq_time = seq_result.elapsed_time\n    print(f"Time: {seq_time:.3f}s")\n    \n    # Parallel with 4 workers\n    print("\\nParallel indexing (4 workers)...")\n    par_result = build_tfidf_index_parallel(documents, num_workers=4)\n    par_time = par_result.elapsed_time\n    print(f"Time: {par_time:.3f}s")\n    \n    speedup = seq_time / par_time\n    print(f"\\nSpeedup: {speedup:.2f}x")\n    if speedup >= 1.5:\n        print("✓ Meets 1.5x speedup target")\n    else:\n        print(f"⚠ Below 1.5x target (got {speedup:.2f}x)")\n    \n    # Test search performance\n    print("\\n" + "-" * 60)\n    print("Search Performance")\n    print("-" * 60)\n    \n    # Generate queries\n    queries = [\n        "machine learning algorithm optimization",\n        "database system performance analysis",\n        "neural network training methods",\n        "cloud computing infrastructure",\n        "software development practices",\n        "data science techniques",\n        "artificial intelligence applications",\n        "computer vision research"\n    ] * 10  # 80 queries total\n    \n    print(f"\\nSearching {len(queries)} queries...")\n    \n    # Sequential search\n    print("\\nSequential search...")\n    start = time.perf_counter()\n    seq_search_results = batch_search_sequential(queries, seq_result.index, top_k=10, documents=documents)\n    seq_search_time = time.perf_counter() - start\n    print(f"Time: {seq_search_time:.3f}s")\n    \n    # Parallel search\n    print("\\nParallel search (4 workers)...")\n    par_search_results, par_search_time = batch_search_parallel(\n        queries, par_result.index, top_k=10, num_workers=4, documents=documents\n    )\n    print(f"Time: {par_search_time:.3f}s")\n    \n    search_speedup = seq_search_time / par_search_time\n    print(f"\\nSpeedup: {search_speedup:.2f}x")\n    if search_speedup >= 2.0:\n        print("✓ Meets 2.0x speedup target")\n    else:\n        print(f"⚠ Below 2.0x target (got {search_speedup:.2f}x)")\n    \n    print("\\n" + "=" * 60)\n    print("PERFORMANCE TEST COMPLETE")\n    print("=" * 60)\n\n\nif __name__ == "__main__":\n    test_correctness()\n    test_performance()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
