Sending keys: ['cat > estimate_params.py << \'EOF\'\n#!/usr/bin/env python3\n"""Parameter estimation: Fit first-order model to calibration data."""\n\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\ndef estimate_parameters():\n    # Load calibration data\n    with open(\'calibration_log.json\', \'r\') as f:\n        cal_data = json.load(f)\n    \n    data = cal_data[\'data\']\n    heater_power = cal_data[\'heater_power_test\']\n    \n    # Extract time and temperature arrays\n    times = np.array([d[\'time\'] for d in data])\n    temps = np.array([d[\'temperature\'] for d in data])\n    \n    # Get initial and ambient temperature\n    T_0 = temps[0]\n    T_ambient = 18.0  # From config\n    \n    print(f"Estimating parameters from {len(data)} data points...")\n    print(f"Initial temperature: {T_0:.2f}C")\n    print(f"Heater power: {heater_power}%")\n    \n    # First-order step response model:\n    # T(t) = T_ss - (T_ss - T_0) * exp(-t/tau)\n    # where T_ss = T_ambient + K * u (steady-state temperature)\n    \n    def first_order_response(t, K, tau):\n        """First-order step response model."""\n        T_ss = T_ambient + K * heater_power\n        return T_ss - (T_ss - T_0) * np.exp(-t / tau)\n    \n    # Initial guess: K ~ (final_temp - ambient) / heater_power, tau ~ 20s\n    T_final = np.mean(temps[-10:])  # Average last 10 points\n    K_guess = (T_final - T_ambient) / heater_power\n    tau_guess = 20.0\n    \n    print(f"Initial guess: K={K_guess:.4f}, tau={tau_guess:.1f}")\n    \n    # Fit the model (skip first point which is at t=0 with heater off)\n    try:\n        params, _ = curve_fit(\n            first_order_response,\n            times[1:],\n            temps[1:],\n            p0=[K_guess, tau_guess],\n            bounds=([0.0, 1.0], [1.0, 100.0]),  # K in [0, 1], tau in [1, 100]\n            maxfev=10000\n        )\n        \n        K_est, tau_est = params\n        \n        # Calculate R-squared and fitting error\n        temps_pred = first_order_response(times[1:], K_est, tau_est)\n        residuals = temps[1:] - temps_pred\n        ss_res = np.sum(residuals**2)\n        ss_tot = np.sum((temps[1:] - np.mean(temps[1:]))**2)\n        r_squared = 1 - (ss_res / ss_tot)\n        fitting_error = np.sqrt(np.mean(residuals**2))  # RMSE\n        \n        print(f"\\nEstimated parameters:")\n        print(f"  K = {K_est:.4f} C/%")\n        print(f"  tau = {tau_est:.2f} s")\n        print(f"  R² = {r_squared:.4f}")\n        print(f"  RMSE = {fitting_error:.4f} C")\n        \n        # Save results\n        results = {\n            "K": round(K_est, 6),\n            "tau": round(tau_est, 4),\n            "r_squared": round(r_squared, 6),\n            "fitting_error": round(fitting_error, 6)\n        }\n        \n        with open(\'estimated_params.json\', \'w\') as f:\n            json.dump(results, f, indent=2)\n        \n        print("\\nSaved estimated_params.json")\n        \n    except Exception as e:\n        print(f"Error during curve fitting: {e}")\n        raise\n\nif __name__ == "__main__":\n    estimate_parameters()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
