Sending keys: ['cat << \'EOF\' >> /root/Tokenizer.scala\n\n// ============================================================================\n// Whitespace Tokenizer - Basic Text Tokenization\n// ============================================================================\n\nclass WhitespaceTokenizer(\n    val lowercase: Boolean = false,\n    val minLength: Int = 0,\n    val maxLength: Option[Int] = None,\n    val stripPunctuation: Boolean = false\n) {\n  private val punctuation = ".,!?;:\'\\"()[]{}".toSet\n\n  private def processToken(word: String): Option[String] = {\n    var processed = word\n    if (stripPunctuation) {\n      processed = processed.replaceAll("^[" + java.util.regex.Pattern.quote(punctuation.mkString) + "]+", "")\n      processed = processed.replaceAll("[" + java.util.regex.Pattern.quote(punctuation.mkString) + "]+$", "")\n    }\n\n    if (lowercase) {\n      processed = processed.toLowerCase\n    }\n\n    if (processed.length < minLength) {\n      return None\n    }\n\n    maxLength.foreach { max =>\n      if (processed.length > max) {\n        processed = processed.substring(0, max)\n      }\n    }\n\n    if (processed.isEmpty) None else Some(processed)\n  }\n\n  def tokenize(text: String): List[Token] = {\n    text.split("\\\\s+").zipWithIndex.flatMap { case (word, i) =>\n      processToken(word).map { processed =>\n        Token(value = processed, tokenType = TokenType.STRING, metadata = Map("position" -> i, "original" -> word))\n      }\n    }.toList\n  }\n\n  def tokenizeToStrings(text: String): List[String] = {\n    tokenize(text).map(_.value)\n  }\n\n  def tokenizeWithPositions(text: String): List[(String, Int, Int)] = {\n    var currentPos = 0\n    text.split("\\\\s+").flatMap { word =>\n      val start = text.indexOf(word, currentPos)\n      val end = start + word.length\n      currentPos = end\n      processToken(word).map { processed =>\n        (processed, start, end)\n      }\n    }.toList\n  }\n\n  def countTokens(text: String): Int = {\n    tokenize(text).length\n  }\n}\n\n// ============================================================================\n// Builder Pattern with Fluent Interface\n// ============================================================================\n\nclass TokenizerBuilder[T] {\n  private val _normalizers = mutable.ListBuffer.empty[String => String]\n  private val _validators = mutable.ListBuffer.empty[T => Boolean]\n  private val _metadata = mutable.Map.empty[String, Any]\n\n  def withNormalizer(normalizer: String => String): TokenizerBuilder[T] = {\n    _normalizers += normalizer\n    this\n  }\n\n  def withValidator(validator: T => Boolean): TokenizerBuilder[T] = {\n    _validators += validator\n    this\n  }\n\n  def withMetadata(metadata: (String, Any)*): TokenizerBuilder[T] = {\n    _metadata ++= metadata\n    this\n  }\n\n  def build(): T => Token = {\n    val normalizers = _normalizers.toList\n    val validators = _validators.toList\n    val metadata = _metadata.toMap\n\n    (value: T) => {\n      for (validator <- validators) {\n        if (!validator(value)) {\n          throw new IllegalArgumentException(s"Validation failed for $value")\n        }\n      }\n\n      var strValue = value.toString\n      for (normalizer <- normalizers) {\n        strValue = normalizer(strValue)\n      }\n\n      Token(strValue, TokenType.STRING, metadata)\n    }\n  }\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
