Sending keys: ['/root/venv/bin/python - <<\'PY\'\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.text import PP_ALIGN, MSO_ANCHOR\nfrom pptx.enum.shapes import PP_PLACEHOLDER\nfrom pptx.oxml.xmlchemy import OxmlElement\nfrom pptx.oxml.ns import qn\n\nprs = Presentation(\'/root/Awesome-Agent-Papers.pptx\')\nslide_width, slide_height = prs.slide_width, prs.slide_height\n\ntitles = []\nfor idx, slide in enumerate(prs.slides, 1):\n    if idx == 1:\n        continue\n    candidates = []\n    for shape in slide.shapes:\n        if not shape.has_text_frame:\n            continue\n        text = shape.text.strip()\n        if not text:\n            continue\n        l = len(text)\n        if 20 <= l <= 120:\n            candidates.append((l, shape, text))\n    if not candidates:\n        continue\n    candidates.sort(key=lambda x: x[0], reverse=True)\n    l, shape, text = candidates[0]\n    titles.append(text)\n\n    width = slide_width - Inches(1)\n    height = Inches(0.5)\n    left = int((slide_width - width) / 2)\n    top = int(slide_height - height - Inches(0.3))\n    shape.left, shape.top, shape.width, shape.height = left, top, width, height\n    tf = shape.text_frame\n    tf.word_wrap = False\n    tf.vertical_anchor = MSO_ANCHOR.MIDDLE\n    for p in tf.paragraphs:\n        p.alignment = PP_ALIGN.CENTER\n        for run in p.runs:\n            font = run.font\n            font.name = \'Arial\'\n            font.size = Pt(16)\n            font.bold = False\n            font.color.rgb = RGBColor(0x98, 0x95, 0x96)\n\n# remove duplicates preserving order\nseen = set()\nunique_titles = []\nfor t in titles:\n    if t not in seen:\n        seen.add(t)\n        unique_titles.append(t)\n\n# add reference slide\nlayout = prs.slide_layouts[1] if len(prs.slide_layouts) > 1 else prs.slide_layouts[0]\nref_slide = prs.slides.add_slide(layout)\nif ref_slide.shapes.title:\n    ref_slide.shapes.title.text = "Reference"\nelse:\n    ref_slide.shapes.add_textbox(Inches(0.5), Inches(0.2), slide_width-Inches(1), Inches(0.6)).text = "Reference"\n\nbody = None\nfor shape in ref_slide.shapes:\n    if shape.is_placeholder and shape.placeholder_format.type == PP_PLACEHOLDER.BODY:\n        body = shape\n        break\nif body is None:\n    body = ref_slide.shapes.add_textbox(Inches(1), Inches(1.5), slide_width-Inches(2), slide_height-Inches(2))\n\ntf = body.text_frame\ntf.clear()\nfor i, title in enumerate(unique_titles, 1):\n    if i == 1:\n        p = tf.paragraphs[0]\n    else:\n        p = tf.add_paragraph()\n    p.text = title\n    p.level = 0\n    pPr = p._pPr\n    for child in list(pPr):\n        if child.tag in (qn(\'a:buChar\'), qn(\'a:buAutoNum\'), qn(\'a:buNone\')):\n            pPr.remove(child)\n    bu = OxmlElement(\'a:buAutoNum\')\n    bu.set(\'type\', \'arabicPeriod\')\n    if i == 1:\n        bu.set(\'startAt\', \'1\')\n    pPr.insert(0, bu)\n\nprs.save(\'/root/Awesome-Agent-Papers_processed.pptx\')\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
