Sending keys: ["cat << 'EOF' > /root/process_frames.py\nimport cv2\nimport numpy as np\nimport csv\nimport os\n\ndef count_matches(img_gray, template_path, threshold=0.8):\n    template = cv2.imread(template_path, cv2.IMREAD_GRAYSCALE)\n    if template is None:\n        return 0\n    w, h = template.shape[::-1]\n    res = cv2.matchTemplate(img_gray, template, cv2.TM_CCOEFF_NORMED)\n    loc = np.where(res >= threshold)\n    \n    points = list(zip(*loc[::-1]))\n    if not points:\n        return 0\n    \n    # Sort by score to take the best matches first in NMS\n    scores = res[loc]\n    indexed_points = sorted(range(len(points)), key=lambda i: scores[i], reverse=True)\n    \n    unique_points = []\n    used_mask = np.zeros(img_gray.shape, dtype=bool)\n    \n    for i in indexed_points:\n        pt = points[i]\n        if not used_mask[pt[1], pt[0]]:\n            unique_points.append(pt)\n            # Mask out the area around the match to avoid double counting\n            y1 = max(0, pt[1] - h // 2)\n            y2 = min(img_gray.shape[0], pt[1] + h // 2)\n            x1 = max(0, pt[0] - w // 2)\n            x2 = min(img_gray.shape[1], pt[0] + w // 2)\n            used_mask[y1:y2, x1:x2] = True\n    \n    return len(unique_points)\n\nkeyframes = sorted([f for f in os.listdir('/root') if f.startswith('keyframes_') and f.endswith('.png')])\nresults = []\n\nfor kf in keyframes:\n    path = os.path.join('/root', kf)\n    # Image is already grayscale from previous run, but let's be safe and handle both\n    img = cv2.imread(path, cv2.IMREAD_GRAYSCALE)\n    cv2.imwrite(path, img)\n    \n    coins = count_matches(img, '/root/coin.png')\n    enemies = count_matches(img, '/root/enemy.png')\n    turtles = count_matches(img, '/root/turtle.png')\n    \n    results.append({\n        'frame_id': path,\n        'coins': coins,\n        'enemies': enemies,\n        'turtles': turtles\n    })\n\nwith open('/root/counting_results.csv', 'w', newline='') as csvfile:\n    fieldnames = ['frame_id', 'coins', 'enemies', 'turtles']\n    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n    writer.writeheader()\n    for row in results:\n        writer.writerow(row)\nEOF\npython3 /root/process_frames.py\ncat /root/counting_results.csv\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
