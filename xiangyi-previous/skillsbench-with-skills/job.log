Sending keys: ['cat > seismic_analysis.py << \'EOF\'\nimport obspy\nimport pandas as pd\nimport numpy as np\nimport torch\nfrom obspy import read\nimport seisbench.models as sbm\nfrom datetime import datetime\nfrom sklearn.cluster import DBSCAN\nfrom scipy.signal import find_peaks\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\nprint("Loading data...")\nst = read(\'/root/data/wave.mseed\')\nstations_df = pd.read_csv(\'/root/data/stations.csv\')\n\nstation_lookup = {}\nfor _, row in stations_df.iterrows():\n    key = f"{row[\'network\']}.{row[\'station\']}"\n    if key not in station_lookup:\n        station_lookup[key] = {\n            \'latitude\': row[\'latitude\'],\n            \'longitude\': row[\'longitude\']\n        }\n\nprint(f"Loaded {len(st)} traces, {len(station_lookup)} stations")\n\nprint("Loading PhaseNet model...")\nmodel = sbm.PhaseNet.from_pretrained("original")\nmodel.eval()\nprint("Model ready\\n")\n\n# Group by station\nfrom collections import defaultdict\nstation_streams = defaultdict(list)\nfor tr in st:\n    station_id = f"{tr.stats.network}.{tr.stats.station}"\n    station_streams[station_id].append(tr)\n\nall_picks = []\n\nfor station_id, traces in station_streams.items():\n    print(f"Processing {station_id}...", end=\' \', flush=True)\n    \n    try:\n        station_st = obspy.Stream(traces)\n        \n        # Get components\n        z_tr = station_st.select(channel="*Z")[0] if station_st.select(channel="*Z") else None\n        n_tr = station_st.select(channel="*N")[0] if station_st.select(channel="*N") else None\n        e_tr = station_st.select(channel="*E")[0] if station_st.select(channel="*E") else None\n        \n        if not z_tr:\n            print("no Z")\n            continue\n        \n        # Get data\n        z = z_tr.data.astype(np.float32)\n        n = n_tr.data.astype(np.float32) if n_tr else z.copy()\n        e = e_tr.data.astype(np.float32) if e_tr else z.copy()\n        \n        # Normalize\n        z = (z - np.mean(z)) / (np.std(z) + 1e-10)\n        n = (n - np.mean(n)) / (np.std(n) + 1e-10)\n        e = (e - np.mean(e)) / (np.std(e) + 1e-10)\n        \n        sr = z_tr.stats.sampling_rate\n        start_time = z_tr.stats.starttime\n        \n        # Process in 30-second windows with 15-second overlap\n        window = 3000  # 30 sec at 100 Hz\n        step = 1500    # 15 sec overlap\n        \n        station_picks = []\n        \n        for i in range(0, len(z) - window + 1, step):\n            # Extract window\n            z_w = z[i:i+window]\n            n_w = n[i:i+window]\n            e_w = e[i:i+window]\n            \n            # Pad to 3001 if needed\n            if len(z_w) < 3001:\n                pad = 3001 - len(z_w)\n                z_w = np.pad(z_w, (0, pad))\n                n_w = np.pad(n_w, (0, pad))\n                e_w = np.pad(e_w, (0, pad))\n            else:\n                z_w = z_w[:3001]\n                n_w = n_w[:3001]\n                e_w = e_w[:3001]\n            \n            # Stack and convert to tensor\n            data = np.stack([z_w, n_w, e_w])\n            data_t = torch.from_numpy(data).unsqueeze(0)\n            \n            # Predict\n            with torch.no_grad():\n                pred = model(data_t)\n            \n            p_prob = pred[0, 1, :].numpy()\n            s_prob = pred[0, 2, :].numpy()\n            \n            # Find peaks\n            p_peaks, _ = find_peaks(p_prob, height=0.5, distance=50)\n            s_peaks, _ = find_peaks(s_prob, height=0.5, distance=50)\n            \n            # Convert to absolute time\n            for pk in p_peaks:\n                sample = i + pk\n                if sample < len(z):\n                    t = start_time + (sample / sr)\n                    station_picks.append({\n                        \'station\': station_id,\n                        \'time\': t,\n                        \'phase\': \'P\',\n                        \'probability\': float(p_prob[pk])\n                    })\n            \n            for pk in s_peaks:\n                sample = i + pk\n                if sample < len(z):\n                    t = start_time + (sample / sr)\n                    station_picks.append({\n                        \'station\': station_id,\n                        \'time\': t,\n                        \'phase\': \'S\',\n                        \'probability\': float(s_prob[pk])\n                    })\n        \n        # Remove duplicates (from overlapping windows)\n        if station_picks:\n            df_temp = pd.DataFrame(station_picks)\n            df_temp[\'timestamp\'] = df_temp[\'time\'].apply(lambda x: x.timestamp)\n            df_temp = df_temp.sort_values(\'timestamp\')\n            \n            # Keep picks at least 1 second apart\n            filtered = []\n            last_p_time = -999\n            last_s_time = -999\n            \n            for _, row in df_temp.iterrows():\n                if row[\'phase\'] == \'P\':\n                    if row[\'timestamp\'] - last_p_time > 1.0:\n                        filtered.append(row.to_dict())\n                        last_p_time = row[\'timestamp\']\n                else:\n                    if row[\'timestamp\'] - last_s_time > 1.0:\n                        filtered.append(row.to_dict())\n                        last_s_time = row[\'timestamp\']\n            \n            all_picks.extend(filtered)\n            print(f"{len(filtered)} picks")\n        else:\n            print("0 picks")\n        \n    except Exception as e:\n        print(f"Error: {e}")\n        continue\n\nprint(f"\\nTotal picks: {len(all_picks)}")\n\nif len(all_picks) == 0:\n    print("No picks! Creating empty results.")\n    pd.DataFrame({\'time\': []}).to_csv(\'/root/results.csv\', index=False)\n    exit(0)\n\npicks_df = pd.DataFrame(all_picks)\nprint(f"P: {len(picks_df[picks_df[\'phase\']==\'P\'])}, S: {len(picks_df[picks_df[\'phase\']==\'S\'])}")\n\n# Associate events\nprint("\\nAssociating events...")\n\nmean_lat = np.mean([s[\'latitude\'] for s in station_lookup.values()])\nmean_lon = np.mean([s[\'longitude\'] for s in station_lookup.values()])\n\nvp, vs = 6.0, 6.0/1.75\n\norigin_times = []\nfor pick in all_picks:\n    if pick[\'station\'] not in station_lookup:\n        continue\n    \n    s = station_lookup[pick[\'station\']]\n    dist = np.sqrt((s[\'latitude\']-mean_lat)**2 + (s[\'longitude\']-mean_lon)**2) * 111.0\n    \n    tt = dist / (vp if pick[\'phase\'] == \'P\' else vs)\n    origin_times.append(pick[\'time\'].timestamp - tt)\n\norigin_times_array = np.array(origin_times).reshape(-1, 1)\n\ndbscan = DBSCAN(eps=5.0, min_samples=3)\nlabels = dbscan.fit_predict(origin_times_array)\n\nprint(f"Found {len(set(labels)) - (1 if -1 in labels else 0)} clusters")\n\nevents = []\nfor cid in set(labels):\n    if cid == -1:\n        continue\n    mask = labels == cid\n    t = np.median(origin_times_array[mask])\n    events.append({\n        \'time\': datetime.utcfromtimestamp(t).isoformat(),\n        \'num_picks\': int(np.sum(mask))\n    })\n\nevents_df = pd.DataFrame(events).sort_values(\'time\').reset_index(drop=True)\n\nprint(f"\\nEvents: {len(events_df)}")\nprint(events_df)\n\nevents_df.to_csv(\'/root/results.csv\', index=False)\nprint("\\nSaved to /root/results.csv")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
