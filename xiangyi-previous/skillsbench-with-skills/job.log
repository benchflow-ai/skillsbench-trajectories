Sending keys: ["cat>/root/opt.py<<'Z'\nimport pandas as pd;import numpy as np;from sklearn.cluster import DBSCAN;from scipy.spatial.distance import cdist;from itertools import product\ndef dm(X,w):n=len(X);D=np.zeros((n,n));\n for i in range(n):\n  for j in range(i+1,n):dx=X[i,0]-X[j,0];dy=X[i,1]-X[j,1];d=np.sqrt((w*dx)**2+((2-w)*dy)**2);D[i,j]=d;D[j,i]=d\n return D\ndef gm(c,e,m=100):\n if len(c)==0 or len(e)==0:return[],[]\n d=cdist(c,e);mc,me,uc,ue=[],[],set(),set()\n while True:\n  md=d.copy()\n  for i in uc:md[i,:]=np.inf\n  for j in ue:md[:,j]=np.inf\n  mv=md.min()\n  if mv>m or mv==np.inf:break\n  i,j=np.unravel_index(md.argmin(),md.shape);mc.append(i);me.append(j);uc.add(i);ue.add(j)\n return mc,me\ndef ev(c,e,ms,ep,sw):\n if len(c)==0:return 0.,np.nan\n D=dm(c,sw);l=DBSCAN(eps=ep,min_samples=ms,metric='precomputed').fit_predict(D);u=set(l)\n if -1 in u:u.remove(-1)\n if len(u)==0:return 0.,np.nan\n ct=np.array([c[l==x].mean(axis=0)for x in u]);mc,me=gm(ct,e);nm=len(mc)\n if nm==0:return 0.,np.nan\n p=nm/len(ct);r=nm/len(e);f1=2*p*r/(p+r)if p+r>0 else 0;dt=np.mean([np.linalg.norm(ct[i]-e[j])for i,j in zip(mc,me)])\n return f1,dt\ncs=pd.read_csv('/root/data/citsci_train.csv')[['file_rad','x','y']];ex=pd.read_csv('/root/data/expert_train.csv')[['file_rad','x','y']];im=ex['file_rad'].unique();id={i:(cs[cs['file_rad']==i][['x','y']].values,ex[ex['file_rad']==i][['x','y']].values)for i in im};pm=list(product(range(3,10),range(4,26,2),[round(.9+i*.1,1)for i in range(11)]));rs=[]\nfor ms,ep,sw in pm:\n f1s,dts=[],[]\n for i in im:c,e=id[i];f1,dt=ev(c,e,ms,ep,sw);f1s.append(f1)\n  if not np.isnan(dt):dts.append(dt)\n af1=np.mean(f1s);adt=np.mean(dts)if dts else np.nan;rs.append((af1,adt,ms,ep,sw))\nft=[(f1,d,ms,ep,sw)for f1,d,ms,ep,sw in rs if f1>.5 and not np.isnan(d)]\nif ft:\n cs=np.array([(f1,d)for f1,d,_,_,_ in ft]);pr=[]\n for i in range(len(ft)):\n  dm=False\n  for j in range(len(ft)):\n   if i!=j and cs[j,0]>=cs[i,0]and cs[j,1]<=cs[i,1]and(cs[j,0]>cs[i,0]or cs[j,1]<cs[i,1]):dm=True;break\n  if not dm:pr.append(ft[i])\n pr.sort(reverse=True)\n with open('/root/pareto_frontier.csv','w')as f:f.write('F1,delta,min_samples,epsilon,shape_weight\\n');[f.write(f'{f1:.5f},{d:.5f},{ms},{ep},{sw:.1f}\\n')for f1,d,ms,ep,sw in pr]\nZ\npython3 /root/opt.py;echo DONE\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
