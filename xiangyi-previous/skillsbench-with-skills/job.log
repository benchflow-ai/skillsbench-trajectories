me.timedelta(hours=duration_hours))\n                break\n        \n        if ev_end > current_pointer:\n            current_pointer = ev_end\n            \n    # Check gap after last event\n    if not found_slot:\n        # Handle timezone for day_end\n        if current_pointer.tzinfo is None and day_end.tzinfo is not None:\n             current_pointer = current_pointer.replace(tzinfo=day_end.tzinfo)\n        elif current_pointer.tzinfo is not None and day_end.tzinfo is None:\n             day_end = day_end.replace(tzinfo=current_pointer.tzinfo)\n             \n        if day_end > current_pointer:\n            gap = (day_end - current_pointer).total_seconds() / 3600.0\n            if gap >= duration_hours:\n                found_slot = (current_pointer, current_pointer + datetime.timedelta(hours=duration_hours))\n                \n    return found_slot\n\ndef send_email(service, to_email, subject, body_text):\n    message = MIMEText(body_text)\n    message[\'to\'] = to_email\n    message[\'subject\'] = subject\n    raw = base64.urlsafe_b64encode(message.as_bytes()).decode()\n    body = {\'raw\': raw}\n    try:\n        message = service.users().messages().send(userId=\'me\', body=body).execute()\n        return message[\'id\']\n    except Exception as error:\n        print(f\'An error occurred: {error}\')\n        return None\n\ndef main():\n    cal_service = get_service(\'calendar\', SCOPES_CALENDAR, \'/root/auth/calendar/\')\n    gmail_service = get_service(\'gmail\', SCOPES_GMAIL, \'/root/auth/gmail/\')\n    \n    with open(\'/root/test_input.json\', \'r\') as f:\n        requests = json.load(f)\n        \n    results = []\n    \n    for req in requests:\n        email_text = req[\'email_text\']\n        from_email = req[\'from_email\']\n        \n        print(f"Processing request from {from_email}...")\n        \n        parsed = parse_email_requirements(email_text)\n        print(f"Parsed requirements: {parsed}")\n        \n        # Find slot\n        slot = None\n        for date_obj in parsed[\'dates\']:\n            slot = check_calendar(cal_service, date_obj, parsed[\'duration_hours\'], parsed[\'start_time_pref\'], parsed[\'end_time_pref\'])\n            if slot:\n                break\n        \n        if slot:\n            start_dt, end_dt = slot\n            \n            # Format reply\n            # Date: {day_name}, {month} {DD}, {YYYY}\n            day_name = start_dt.strftime(\'%A\')\n            date_formatted = start_dt.strftime(\'%B %d, %Y\')\n            \n            # Time: {HH:MM AM/PM} - {HH:MM AM/PM}\n            # Ensure 09:00 not 9:00\n            time_range = f"{start_dt.strftime(\'%I:%M %p\')} - {end_dt.strftime(\'%I:%M %p\')}"\n            \n            reply_body = f"""Hi,\n\nThank you for your meeting request.\n\nI can be available:\n\nDate: {day_name}, {date_formatted}\nTime: {time_range}\nDuration: {parsed[\'duration_hours\']} hour(s)\n\nIf this time doesn\'t work, please let me know your preferred alternatives.\n\nBest regards,\nSkillsBench"""\n            \n            print(f"Sending reply to {from_email} with slot {start_dt}")\n            msg_id = send_email(gmail_service, from_email, "Re: Meeting Request", reply_body)\n            if msg_id:\n                results.append({"messageId": msg_id})\n        else:\n            print("No slot found!")\n            \n    with open(\'/root/results.json\', \'w\') as f:\n        json.dump({"sent_results": results}, f, indent=4)\n        \nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
