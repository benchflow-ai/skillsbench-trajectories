Sending keys: ['cat >> solve_final.py << \'EOF\'\n\n# Calculate power injections and verify balance\nV = Vm * np.exp(1j * Va)\nS_calc = V * np.conj(Ybus @ V)\nP_calc = S_calc.real\nQ_calc = S_calc.imag\n\n# Net injections\nP_inj = np.zeros(n_bus)\nQ_inj = np.zeros(n_bus)\n\nfor i in range(n_gen):\n    if gen_status[i]:\n        P_inj[gen_bus[i]] += Pg[i]\n        Q_inj[gen_bus[i]] += Qg[i]\n\n# Power balance mismatches\ndP = P_inj - Pd - P_calc\ndQ = Q_inj - Qd - Q_calc\n\nmax_p_mismatch = np.max(np.abs(dP)) * baseMVA\nmax_q_mismatch = np.max(np.abs(dQ)) * baseMVA\n\nprint(f"Max P mismatch: {max_p_mismatch:.6f} MW")\nprint(f"Max Q mismatch: {max_q_mismatch:.6f} MVAr")\n\n# Calculate branch flows\nbranch_data = []\n\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    \n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    \n    Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V[f] * np.conj(V[f]) - (Ys / np.conj(tr)) * V[f] * np.conj(V[t])\n    St = (Ys + Ysh/2) * V[t] * np.conj(V[t]) - (Ys / tr) * V[t] * np.conj(V[f])\n    \n    Sf_MVA = np.abs(Sf) * baseMVA\n    St_MVA = np.abs(St) * baseMVA\n    limit_MVA = rate_a[i] * baseMVA if rate_a[i] > 0 else 9999.0\n    \n    loading_pct = (max(Sf_MVA, St_MVA) / limit_MVA * 100) if limit_MVA > 0 and limit_MVA < 9999 else 0\n    \n    branch_data.append({\n        \'from_bus\': int(fbus[i] + 1),\n        \'to_bus\': int(tbus[i] + 1),\n        \'loading_pct\': float(loading_pct),\n        \'flow_from_MVA\': float(Sf_MVA),\n        \'flow_to_MVA\': float(St_MVA),\n        \'limit_MVA\': float(limit_MVA)\n    })\n\nbranch_data.sort(key=lambda x: x[\'loading_pct\'], reverse=True)\nmost_loaded = branch_data[:10]\n\nif most_loaded:\n    print(f"Most loaded branch: {most_loaded[0][\'loading_pct\']:.2f}%")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
