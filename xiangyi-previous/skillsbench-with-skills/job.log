ype == 0)\n                .assignTimestampsAndWatermarks(new BoundedOutOfOrdernessTimestampExtractor<TaskEvent>(Time.seconds(0)) {\n                    @Override\n                    public long extractTimestamp(TaskEvent element) {\n                        return element.timestamp / 1000;\n                    }\n                });\n\n        DataStream<Tuple2<Long, Integer>> sessionCounts = taskEvents\n                .keyBy(e -> e.jobId)\n                .window(EventTimeSessionWindows.withGap(Time.minutes(10)))\n                .apply(new WindowFunction<TaskEvent, Tuple2<Long, Integer>, Long, TimeWindow>() {\n                    @Override\n                    public void apply(Long jobId, TimeWindow window, Iterable<TaskEvent> input, Collector<Tuple2<Long, Integer>> out) {\n                        int count = 0;\n                        for (TaskEvent e : input) {\n                            count++;\n                        }\n                        out.collect(new Tuple2<>(jobId, count));\n                    }\n                });\n\n        DataStream<JobEvent> jobFinishEvents = env.readTextFile(jobInput)\n                .map(JobEvent::fromString)\n                .filter(e -> e != null && e.eventType == 4)\n                .assignTimestampsAndWatermarks(new BoundedOutOfOrdernessTimestampExtractor<JobEvent>(Time.seconds(0)) {\n                    @Override\n                    public long extractTimestamp(JobEvent element) {\n                        return element.timestamp / 1000;\n                    }\n                });\n\n        sessionCounts.keyBy(t -> t.f0)\n                .connect(jobFinishEvents.keyBy(e -> e.jobId))\n                .process(new KeyedCoProcessFunction<Long, Tuple2<Long, Integer>, JobEvent, String>() {\n                    private ValueState<Integer> maxTasks;\n                    private ValueState<Long> finishTime;\n\n                    @Override\n                    public void open(Configuration parameters) {\n                        maxTasks = getRuntimeContext().getState(new ValueStateDescriptor<>("maxTasks", Integer.class, 0));\n                        finishTime = getRuntimeContext().getState(new ValueStateDescriptor<>("finishTime", Long.class));\n                    }\n\n                    @Override\n                    public void processElement1(Tuple2<Long, Integer> value, Context ctx, Collector<String> out) throws Exception {\n                        if (value.f1 > maxTasks.value()) {\n                            maxTasks.update(value.f1);\n                        }\n                        if (finishTime.value() != null) {\n                            ctx.timerService().registerEventTimeTimer(ctx.timestamp() + 600001);\n                        }\n                    }\n\n                    @Override\n                    public void processElement2(JobEvent value, Context ctx, Collector<String> out) throws Exception {\n                        finishTime.update(ctx.timestamp());\n                        ctx.timerService().registerEventTimeTimer(ctx.timestamp() + 600001);\n                    }\n\n                    @Override\n                    public void onTimer(long timestamp, OnTimerContext ctx, Collector<String> out) throws Exception {\n                        out.collect("(" + ctx.getCurrentKey() + "," + maxTasks.value() + ")");\n                        maxTasks.clear();\n                        finishTime.clear();\n                    }\n                })\n                .writeAsText(outputPath).setParallelism(1);\n\n        env.execute("LongestSessionPerJob");\n    }\n}\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
