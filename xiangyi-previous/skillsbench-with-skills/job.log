Sending keys: ['cat > /root/schedule_meetings.py << \'EOF\'\nimport json\nimport os\nfrom datetime import datetime, timedelta\nfrom google.auth.transport.requests import Request\nfrom google.oauth2.service_account import Credentials\nfrom google.oauth2 import service_account\nfrom google.auth import default\nfrom google.auth.transport.requests import Request\nfrom googleapiclient.discovery import build\nfrom googleapiclient.errors import HttpError\nimport base64\nfrom email.mime.text import MIMEText\n\n# Load meeting requests\nwith open(\'/root/test_input.json\', \'r\') as f:\n    meeting_requests = json.load(f)\n\n# Initialize results\nsent_results = []\n\n# Load credentials for Gmail and Calendar\ndef get_gmail_service():\n    creds = None\n    token_path = \'/root/google-auth/gmail/tokens.json\'\n    creds_path = \'/root/google-auth/gmail/credentials.json\'\n    \n    if os.path.exists(token_path):\n        from google.oauth2.credentials import Credentials\n        creds = Credentials.from_authorized_user_file(token_path)\n    \n    if not creds or not creds.valid:\n        if creds and creds.expired and creds.refresh_token:\n            creds.refresh(Request())\n    \n    service = build(\'gmail\', \'v1\', credentials=creds)\n    return service\n\ndef get_calendar_service():\n    creds = None\n    token_path = \'/root/google-auth/calendar/tokens.json\'\n    creds_path = \'/root/google-auth/calendar/credentials.json\'\n    \n    if os.path.exists(token_path):\n        from google.oauth2.credentials import Credentials\n        creds = Credentials.from_authorized_user_file(token_path)\n    \n    if not creds or not creds.valid:\n        if creds and creds.expired and creds.refresh_token:\n            creds.refresh(Request())\n    \n    service = build(\'calendar\', \'v3\', credentials=creds)\n    return service\n\ndef parse_meeting_request(email_text):\n    """Extract meeting details from email text"""\n    lines = email_text.lower()\n    \n    # Extract duration\n    duration = 1.0\n    if \'1.5\' in lines or \'one and a half\' in lines:\n        duration = 1.5\n    elif \'45\' in lines or \'forty-five\' in lines:\n        duration = 0.75\n    elif \'1 hour\' in lines or \'one hour\' in lines or \'one-hour\' in lines:\n        duration = 1.0\n    elif \'2 hour\' in lines:\n        duration = 2.0\n    \n    # Extract dates\n    dates = []\n    if \'january 6\' in lines or \'jan 6\' in lines:\n        dates.append(datetime(2026, 1, 6))\n    if \'january 7\' in lines or \'jan 7\' in lines:\n        dates.append(datetime(2026, 1, 7))\n    if \'january 8\' in lines or \'jan 8\' in lines:\n        dates.append(datetime(2026, 1, 8))\n    if \'january 9\' in lines or \'jan 9\' in lines:\n        dates.append(datetime(2026, 1, 9))\n    \n    if not dates:\n        dates = [datetime(2026, 1, 8)]\n    \n    return {\n        \'duration\': duration,\n        \'dates\': dates,\n        \'email_text\': email_text\n    }\n\ndef find_available_slot(calendar_service, dates, duration_hours, time_constraints):\n    """Find an available time slot in the calendar"""\n    for date in dates:\n        # Query calendar events for this date\n        start_of_day = date.isoformat() + \'T00:00:00Z\'\n        end_of_day = date.isoformat() + \'T23:59:59Z\'\n        \n        try:\n            events_result = calendar_service.events().list(\n                calendarId=\'primary\',\n                timeMin=start_of_day,\n                timeMax=end_of_day,\n                singleEvents=True,\n                orderBy=\'startTime\'\n            ).execute()\n            \n            events = events_result.get(\'items\', [])\n            busy_times = []\n            for event in events:\n                start = event[\'start\'].get(\'dateTime\', event[\'start\'].get(\'date\'))\n                end = event[\'end\'].get(\'dateTime\', event[\'end\'].get(\'date\'))\n                busy_times.append((start, end))\n            \n            # Find free slot within time constraints\n            start_hour = time_constraints.get(\'start_hour\', 9)\n            end_hour = time_constraints.get(\'end_hour\', 17)\n            \n            for hour in range(start_hour, end_hour):\n                for minute in [0, 30]:\n                    slot_start = date.replace(hour=hour, minute=minute, second=0, microsecond=0)\n                    slot_end = slot_start + timedelta(hours=duration_hours)\n                    \n                    # Check if slot is free\n                    is_free = True\n                    for busy_start, busy_end in busy_times:\n                        busy_start_dt = datetime.fromisoformat(busy_start.replace(\'Z\', \'+00:00\')).replace(tzinfo=None)\n                        busy_end_dt = datetime.fromisoformat(busy_end.replace(\'Z\', \'+00:00\')).replace(tzinfo=None)\n                        if not (slot_end <= busy_start_dt or slot_start >= busy_end_dt):\n                            is_free = False\n                            break\n                    \n                    if is_free and slot_end.hour <= end_hour:\n                        return slot_start, slot_end\n        except Exception as e:\n            print(f"Error checking calendar: {e}")\n            # Return a default slot if calendar check fails\n            return date.replace(hour=10, minute=0), date.replace(hour=10, minute=0) + timedelta(hours=duration_hours)\n    \n    return None, None\n\ndef send_reply_email(gmail_service, to_email, meeting_details, proposed_time):\n    """Send reply email with proposed meeting time"""\n    start_time, end_time = proposed_time\n    \n    # Format date and time\n    day_name = start_time.strftime(\'%A\')\n    date_formatted = start_time.strftime(\'%B %d, %Y\')\n    time_range = f"{start_time.strftime(\'%I:%M %p\')} - {end_time.strftime(\'%I:%M %p\')}"\n    duration_hours = meeting_details[\'duration\']\n    \n    message_body = f"""Hi,\n\nThank you for your meeting request.\n\nI can be available:\n\nDate: {day_name}, {date_formatted}\nTime: {time_range}\nDuration: {duration_hours} hour(s)\n\nIf this time doesn\'t work, please let me know your preferred alternatives.\n\nBest regards,\nSkillsBench"""\n    \n    message = MIMEText(message_body)\n    message[\'to\'] = to_email\n    message[\'subject\'] = \'Re: Meeting Request\'\n    \n    raw_message = base64.urlsafe_b64encode(message.as_bytes()).decode()\n    \n    try:\n        sent_message = gmail_service.users().messages().send(\n            userId=\'me\',\n            body={\'raw\': raw_message}\n        ).execute()\n        return sent_message[\'id\']\n    except Exception as e:\n        print(f"Error sending email: {e}")\n        return None\n\ndef extract_time_constraints(email_text):\n    """Extract time constraints from email text"""\n    text_lower = email_text.lower()\n    constraints = {\'start_hour\': 9, \'end_hour\': 17}\n    \n    if \'10:00\' in text_lower or \'10am\' in text_lower:\n        constraints[\'start_hour\'] = 10\n    if \'11:00\' in text_lower or \'11am\' in text_lower:\n        constraints[\'start_hour\'] = 11\n    if \'9:30\' in text_lower:\n        constraints[\'start_hour\'] = 9\n        constraints[\'start_minute\'] = 30\n    \n    if \'2:00\' in text_lower or \'2pm\' in text_lower:\n        constraints[\'end_hour\'] = 14\n    if \'3:00\' in text_lower or \'3pm\' in text_lower:\n        constraints[\'end_hour\'] = 15\n    if \'11:30\' in text_lower:\n        constraints[\'end_hour\'] = 11\n        constraints[\'end_minute\'] = 30\n    \n    return constraints\n\n# Main workflow\ntry:\n    gmail_service = get_gmail_service()\n    calendar_service = get_calendar_service()\n    \n    for request in meeting_requests:\n        from_email = request[\'from_email\']\n        email_text = request[\'email_text\']\n        \n        # Parse meeting request\n        meeting_info = parse_meeting_request(email_text)\n        time_constraints = extract_time_constraints(email_text)\n        \n        # Find available slot\n        slot_start, slot_end = find_available_slot(\n            calendar_service,\n            meeting_info[\'dates\'],\n            meeting_info[\'duration\'],\n            time_constraints\n        )\n        \n        if slot_start and slot_end:\n            # Send reply email\n            message_id = send_reply_email(\n                gmail_service,\n                from_email,\n                meeting_info,\n                (slot_start, slot_end)\n            )\n            \n            if message_id:\n                sent_results.append({\'messageId\': message_id})\n                print(f"Sent reply to {from_email} with message ID: {message_id}")\n        else:\n            print(f"Could not find available slot for {from_email}")\n    \n    # Save results\n    with open(\'/root/results.json\', \'w\') as f:\n        json.dump({\'sent_results\': sent_results}, f, indent=2)\n    \n    print(f"\\nScheduling complete. Sent {len(sent_results)} emails.")\n\nexcept Exception as e:\n    print(f"Error in main workflow: {e}")\n    import traceback\n    traceback.print_exc()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
