Sending keys: ['cat > market_clearing.py << \'SCRIPT_EOF\'\nimport json\nimport numpy as np\nimport cvxpy as cp\nfrom collections import defaultdict\n\n# Load network data\nwith open(\'network.json\') as f:\n    network = json.load(f)\n\nbase_mva = network[\'baseMVA\']\nbuses = np.array(network[\'bus\'])\ngens = np.array(network[\'gen\'])\nbranches = np.array(network[\'branch\'])\ngencost = np.array(network[\'gencost\'])\nreserve_capacity = np.array(network[\'reserve_capacity\'])\nreserve_requirement = network[\'reserve_requirement\']\n\n# Extract bus data\nbus_ids = buses[:, 0].astype(int)\nbus_type = buses[:, 1].astype(int)  # 1=PQ, 2=PV, 3=ref\nbus_pd = buses[:, 2]  # Real power demand\nbus_qd = buses[:, 3]  # Reactive power demand\nbus_vmax = buses[:, 11]\nbus_vmin = buses[:, 12]\n\n# Extract generator data\ngen_bus = gens[:, 0].astype(int)\ngen_pg = gens[:, 1]  # Real power output\ngen_pmax = gens[:, 8]  # Max power\ngen_pmin = gens[:, 9]  # Min power\n\n# Extract branch data\nbranch_from = branches[:, 0].astype(int)\nbranch_to = branches[:, 1].astype(int)\nbranch_r = branches[:, 2]  # Resistance\nbranch_x = branches[:, 3]  # Reactance\nbranch_rate = branches[:, 5]  # Thermal limit (MVA)\n\n# Extract cost data (quadratic cost function)\ncost_type = gencost[:, 0].astype(int)\ncost_startup = gencost[:, 1]\ncost_shutdown = gencost[:, 2]\ncost_n = gencost[:, 3].astype(int)\ncost_coeffs = gencost[:, 4:]\n\ndef solve_market(branches_modified=None):\n    """\n    Solve DC-OPF with reserve co-optimization\n    """\n    num_buses = len(bus_ids)\n    num_gens = len(gen_bus)\n    num_branches = len(branch_from)\n    \n    # Decision variables\n    pg = cp.Variable(num_gens)  # Generator dispatch (MW)\n    reserve = cp.Variable(num_gens)  # Spinning reserve (MW)\n    theta = cp.Variable(num_buses)  # Bus voltage angles (radians)\n    reserve_price = cp.Variable(1)  # Reserve market clearing price\n    \n    # Objective: minimize total cost\n    # Cost = generation cost + reserve cost\n    gen_cost = 0\n    for i in range(num_gens):\n        if cost_n[i] == 3:  # Quadratic cost\n            c2 = cost_coeffs[i, 0]\n            c1 = cost_coeffs[i, 1]\n            c0 = cost_coeffs[i, 2]\n            gen_cost += c2 * cp.square(pg[i]) + c1 * pg[i] + c0\n        elif cost_n[i] == 2:  # Linear cost\n            c1 = cost_coeffs[i, 0]\n            c0 = cost_coeffs[i, 1]\n            gen_cost += c1 * pg[i] + c0\n    \n    reserve_cost = reserve_price[0] * cp.sum(reserve)\n    objective = gen_cost + reserve_cost\n    \n    constraints = []\n    \n    # Generator constraints\n    constraints.extend([pg >= gen_pmin])\n    constraints.extend([pg <= gen_pmax])\n    constraints.extend([reserve >= 0])\n    constraints.extend([reserve <= reserve_capacity])\n    constraints.extend([pg + reserve <= gen_pmax])  # Reserve coupling constraint\n    \n    # Bus angle constraints (slack bus at 0)\n    constraints.append(theta[0] == 0)\n    \n    # Power balance constraints (DC approximation)\n    for b_idx, bus_id in enumerate(bus_ids):\n        # Sum of generation at this bus\n        gen_at_bus = 0\n        for g_idx, g_bus in enumerate(gen_bus):\n            if g_bus == bus_id:\n                gen_at_bus += pg[g_idx]\n        \n        # Sum of flows from this bus\n        flow_from_bus = 0\n        flow_to_bus = 0\n        \n        for br_idx in range(num_branches):\n            if branch_from[br_idx] == bus_id:\n                # Find bus indices\n                to_idx = np.where(bus_ids == branch_to[br_idx])[0][0]\n                x = branch_x[br_idx]\n                if x != 0:\n                    flow = (theta[b_idx] - theta[to_idx]) / x * base_mva\n                    flow_from_bus += flow\n            \n            if branch_to[br_idx] == bus_id:\n                from_idx = np.where(bus_ids == branch_from[br_idx])[0][0]\n                x = branch_x[br_idx]\n                if x != 0:\n                    flow = (theta[from_idx] - theta[b_idx]) / x * base_mva\n                    flow_to_bus += flow\n        \n        # Power balance: generation = demand + net outflow\n        constraints.append(gen_at_bus == bus_pd[b_idx] + flow_from_bus + flow_to_bus)\n    \n    # Transmission line constraints\n    for br_idx in range(num_branches):\n        from_idx = np.where(bus_ids == branch_from[br_idx])[0][0]\n        to_idx = np.where(bus_ids == branch_to[br_idx])[0][0]\n        x = branch_x[br_idx]\n        \n        if x != 0:\n            limit = branch_rate[br_idx]\n            if branches_modified is not None and br_idx in branches_modified:\n                limit = branches_modified[br_idx]\n            \n            flow = (theta[from_idx] - theta[to_idx]) / x * base_mva\n            constraints.extend([flow <= limit, flow >= -limit])\n    \n    # Reserve requirement constraint\n    constraints.append(cp.sum(reserve) >= reserve_requirement)\n    \n    # Reserve price non-negativity\n    constraints.append(reserve_price >= 0)\n    \n    # Solve\n    problem = cp.Problem(cp.Minimize(objective), constraints)\n    problem.solve(solver=cp.ECOS, verbose=False)\n    \n    if problem.status != cp.OPTIMAL:\n        print(f"Warning: Solver status {problem.status}")\n    \n    # Extract results\n    results = {\n        \'pg\': pg.value,\n        \'reserve\': reserve.value,\n        \'theta\': theta.value,\n        \'total_cost\': problem.value,\n        \'reserve_price\': reserve_price.value[0] if reserve_price.value is not None else 0,\n    }\n    \n    return results, problem, theta, pg, reserve, reserve_price\n\n# Solve base case\nprint("Solving base case...")\nresults_base, problem_base, theta_base, pg_base, reserve_base, rp_base = solve_market()\n\n# Create modified branches for counterfactual (20% increase on line 64-1501)\nline_64_1501_idx = None\nfor br_idx in range(len(branch_from)):\n    if (branch_from[br_idx] == 64 and branch_to[br_idx] == 1501) or \\\n       (branch_from[br_idx] == 1501 and branch_to[br_idx] == 64):\n        line_64_1501_idx = br_idx\n        break\n\nif line_64_1501_idx is not None:\n    branches_modified = {line_64_1501_idx: branch_rate[line_64_1501_idx] * 1.2}\n    print(f"Found line 64-1501 at index {line_64_1501_idx}")\n    print(f"Original limit: {branch_rate[line_64_1501_idx]:.2f} MW")\n    print(f"Modified limit: {branches_modified[line_64_1501_idx]:.2f} MW")\nelse:\n    print("Warning: Line 64-1501 not found, using empty modification")\n    branches_modified = {}\n\n# Solve counterfactual case\nprint("Solving counterfactual case...")\nresults_cf, problem_cf, theta_cf, pg_cf, reserve_cf, rp_cf = solve_market(branches_modified)\n\nprint(f"Base case cost: ${results_base[\'total_cost\']:.2f}")\nprint(f"Counterfactual cost: ${results_cf[\'total_cost\']:.2f}")\nprint(f"Cost reduction: ${results_base[\'total_cost\'] - results_cf[\'total_cost\']:.2f}")\n\nSCRIPT_EOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
