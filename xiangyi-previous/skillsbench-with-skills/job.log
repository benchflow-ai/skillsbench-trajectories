Sending keys: ['cat > /app/solution.py <<EOF\nimport pandas as pd\nimport json\nimport re\nimport numpy as np\n\ndef load_codebook(filepath):\n    df = pd.read_csv(filepath)\n    codebook = []\n    for _, row in df.iterrows():\n        keywords = [k.strip().lower() for k in re.split(r\'[,;、]\', str(row[\'keywords_examples\'])) if k.strip()]\n        codebook.append({\n            \'code\': row[\'code\'],\n            \'label\': row[\'standard_label\'],\n            \'keywords\': keywords,\n            \'category_lv1\': row[\'category_lv1\'],\n            \'category_lv2\': row[\'category_lv2\']\n        })\n    return codebook\n\ncodebooks = {\n    \'P1_POWER\': load_codebook(\'/app/data/codebook_P1_POWER.csv\'),\n    \'P2_CTRL\': load_codebook(\'/app/data/codebook_P2_CTRL.csv\'),\n    \'P3_RF\': load_codebook(\'/app/data/codebook_P3_RF.csv\')\n}\n\ndef split_segments(text):\n    if pd.isna(text):\n        return []\n    # Split by common separators\n    # Added some more separators based on observation\n    seps = [r\' / \', r\' ; \', r\' ;\', r\'; \', r\';\', r\' /\', r\'/ \', r\'/\', r\' 、\', r\'、 \', r\'、\', r\' & \', r\'&\', r\', \', r\' ,\', r\',\', r\'；\', r\'\\s{2,}\']\n    pattern = \'|\'.join(map(re.escape, seps))\n    segments = re.split(pattern, str(text))\n    return [s.strip() for s in segments if s.strip()]\n\ndef calculate_confidence(segment, entry):\n    seg_lower = segment.lower()\n    score = 0.0\n    \n    # Exact label match (rare but high confidence)\n    if entry[\'label\'].lower() in seg_lower or seg_lower in entry[\'label\'].lower():\n        score += 0.4\n    \n    # Keyword matches\n    kw_matches = 0\n    for kw in entry[\'keywords\']:\n        if kw in seg_lower:\n            kw_matches += 1\n    \n    if entry[\'keywords\']:\n        score += (kw_matches / len(entry[\'keywords\'])) * 0.6\n    \n    return min(score, 1.0)\n\ndef get_best_match(segment, product_id):\n    if product_id not in codebooks:\n        return "UNKNOWN", "", 0.0, "Product codebook not found"\n    \n    best_entry = None\n    max_score = 0.0\n    \n    for entry in codebooks[product_id]:\n        score = calculate_confidence(segment, entry)\n        if score > max_score:\n            max_score = score\n            best_entry = entry\n            \n    if max_score < 0.3: # Threshold for UNKNOWN\n        return "UNKNOWN", "", max_score * 0.5, "No confident match found"\n    \n    return best_entry[\'code\'], best_entry[\'label\'], max_score, f"Matched with score {max_score:.2f}"\n\n# Read the logs. The header is messy.\n# Based on the head output, we can skip the first two lines and provide our own header\ncol_names = [\n    \'record_id\', \'site\', \'product_id\', \'work_order\', \'serial_number\', \'station\', \'line\', \'fixture_id\', \n    \'test_item\', \'fail_code\', \'meas_value\', \'limit_low\', \'limit_high\', \'fw_version\', \'sw_version\', \n    \'operator_id\', \'shift\', \'timestamp\', \'engineer_id\', \'raw_reason_text\', \'action_text\', \'result\'\n]\n\n# We need to handle the fact that the file might have been read incorrectly by pd.read_csv \n# if we don\'t account for the two header lines.\nlogs = pd.read_csv(\'/app/data/test_center_logs.csv\', skiprows=2, names=col_names, engine=\'python\')\n\nrecords = []\nfor _, row in logs.iterrows():\n    record_id = str(row[\'record_id\'])\n    product_id = str(row[\'product_id\'])\n    raw_text = str(row[\'raw_reason_text\'])\n    \n    segments = split_segments(raw_text)\n    normalized_segments = []\n    \n    for i, span in enumerate(segments, 1):\n        pred_code, pred_label, conf, rationale = get_best_match(span, product_id)\n        normalized_segments.append({\n            "segment_id": f"{record_id}-S{i}",\n            "span_text": span,\n            "pred_code": pred_code,\n            "pred_label": pred_label,\n            "confidence": float(round(conf, 2)),\n            "rationale": rationale\n        })\n    \n    records.append({\n        "record_id": record_id,\n        "product_id": product_id,\n        "station": str(row[\'station\']),\n        "engineer_id": str(row[\'engineer_id\']),\n        "raw_reason_text": raw_text,\n        "normalized": normalized_segments\n    })\n\nwith open(\'/app/output/solution.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump({"records": records}, f, ensure_ascii=False, indent=2)\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
