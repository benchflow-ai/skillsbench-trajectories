Sending keys: ['cat << \'EOF\' > /root/verifier-skills/gmail-skill/solve_task.mjs\nimport { google } from \'googleapis\';\nimport { readFileSync, writeFileSync } from \'fs\';\nimport path from \'path\';\n\nconst INPUT_FILE = \'/root/test_input.json\';\nconst RESULTS_FILE = \'/root/results.json\';\nconst CALENDAR_AUTH_DIR = \'/root/auth/calendar\';\nconst GMAIL_AUTH_DIR = \'/root/auth/gmail\';\n\nasync function getAuthClient(authDir) {\n  const credentials = JSON.parse(readFileSync(path.join(authDir, \'credentials.json\'), \'utf8\'));\n  const tokenConfig = JSON.parse(readFileSync(path.join(authDir, \'tokens.json\'), \'utf8\'));\n  const accountId = tokenConfig.defaultAccount;\n  const tokens = tokenConfig.accounts[accountId];\n  \n  const { client_id, client_secret, redirect_uris } = credentials.installed || credentials.web;\n  const oauth2Client = new google.auth.OAuth2(client_id, client_secret, redirect_uris[0]);\n  oauth2Client.setCredentials(tokens);\n  return oauth2Client;\n}\n\nfunction parseTime(timeStr, dateStr) {\n  const cleanDateStr = dateStr.replace(/(\\d+)(st|nd|rd|th)/, \'$1\');\n  const cleanTimeStr = timeStr.replace(/PST|PDT|EST|EDT/g, \'\').trim();\n  const dateTimeStr = `${cleanDateStr} ${cleanTimeStr}`;\n  return new Date(dateTimeStr);\n}\n\nfunction formatTime(date) {\n  let hours = date.getHours();\n  const minutes = date.getMinutes().toString().padStart(2, \'0\');\n  const ampm = hours >= 12 ? \'PM\' : \'AM\';\n  hours = hours % 12;\n  hours = hours ? hours : 12;\n  return `${hours.toString().padStart(2, \'0\')}:${minutes} ${ampm}`;\n}\n\nfunction formatDate(date) {\n  const dayName = date.toLocaleDateString(\'en-US\', { weekday: \'long\' });\n  const month = date.toLocaleDateString(\'en-US\', { month: \'long\' });\n  const day = date.getDate().toString().padStart(2, \'0\');\n  const year = date.getFullYear();\n  return `${dayName}, ${month} ${day}, ${year}`;\n}\n\nasync function solve() {\n  const requests = JSON.parse(readFileSync(INPUT_FILE, \'utf8\'));\n  const calendarAuth = await getAuthClient(CALENDAR_AUTH_DIR);\n  const gmailAuth = await getAuthClient(GMAIL_AUTH_DIR);\n  const calendar = google.calendar({ version: \'v3\', auth: calendarAuth });\n  const gmail = google.gmail({ version: \'v1\', auth: gmailAuth });\n\n  const sentResults = [];\n\n  for (const req of requests) {\n    const { email_text, from_email } = req;\n    \n    let duration = 1.0;\n    if (email_text.includes(\'1.5 hour\')) duration = 1.5;\n    else if (email_text.includes(\'45-minute\')) duration = 0.75;\n    else if (email_text.includes(\'one-hour\')) duration = 1.0;\n\n    let dates = [];\n    if (email_text.includes(\'January 8th, 2026\')) dates.push(\'January 8, 2026\');\n    if (email_text.includes(\'January 9th, 2026\')) dates.push(\'January 9, 2026\');\n    if (email_text.includes(\'January 6th\')) dates.push(\'January 6, 2026\');\n    if (email_text.includes(\'January 7th\')) dates.push(\'January 7, 2026\');\n    if (dates.length === 0 && email_text.includes(\'January 8th and January 9th\')) {\n        dates = [\'January 8, 2026\', \'January 9, 2026\'];\n    }\n\n    let startTimeLimit = "09:00 AM";\n    let endTimeLimit = "05:00 PM";\n    if (email_text.toLowerCase().includes(\'10:00am to 2:00pm\')) {\n        startTimeLimit = "10:00 AM";\n        endTimeLimit = "02:00 PM";\n    } else if (email_text.toLowerCase().includes(\'11:00 am and 3:00 pm\')) {\n        startTimeLimit = "11:00 AM";\n        endTimeLimit = "03:00 PM";\n    } else if (email_text.toLowerCase().includes(\'9:30am and 11:30am\')) {\n        startTimeLimit = "09:30 AM";\n        endTimeLimit = "11:30 AM";\n    }\n\n    let foundSlot = null;\n    for (const dateStr of dates) {\n        const startLimit = parseTime(startTimeLimit, dateStr);\n        const endLimit = parseTime(endTimeLimit, dateStr);\n        \n        const res = await calendar.events.list({\n            calendarId: \'primary\',\n            timeMin: startLimit.toISOString(),\n            timeMax: endLimit.toISOString(),\n            singleEvents: true,\n            orderBy: \'startTime\',\n        });\n        \n        const events = res.data.items || [];\n        let currentStart = new Date(startLimit);\n        \n        while (new Date(currentStart.getTime() + duration * 60 * 60 * 1000) <= endLimit) {\n            const currentEnd = new Date(currentStart.getTime() + duration * 60 * 60 * 1000);\n            const conflict = events.find(event => {\n                const eventStart = new Date(event.start.dateTime || event.start.date);\n                const eventEnd = new Date(event.end.dateTime || event.end.date);\n                return (currentStart < eventEnd && currentEnd > eventStart);\n            });\n            \n            if (!conflict) {\n                foundSlot = { start: new Date(currentStart), end: currentEnd };\n                break;\n            }\n            const conflictEnd = new Date(conflict.end.dateTime || conflict.end.date);\n            currentStart = new Date(Math.max(currentStart.getTime() + 15 * 60 * 1000, conflictEnd.getTime()));\n        }\n        if (foundSlot) break;\n    }\n\n    if (foundSlot) {\n        const dateFormatted = formatDate(foundSlot.start);\n        const dayName = foundSlot.start.toLocaleDateString(\'en-US\', { weekday: \'long\' });\n        const timeRange = `${formatTime(foundSlot.start)} - ${formatTime(foundSlot.end)}`;\n        \n        const body = `Hi,\n\nThank you for your meeting request.\n\nI can be available:\n\nDate: ${dateFormatted}\nTime: ${timeRange}\nDuration: ${duration} hour(s)\n\nIf this time doesn\'t work, please let me know your preferred alternatives.\n\nBest regards,\nSkillsBench`;\n\n        const subject = \'Meeting Request Reply\';\n        const utf8Subject = `=?utf-8?B?${Buffer.from(subject).toString(\'base64\')}?=`;\n        const messageParts = [\n            `From: SkillsBench <me>`,\n            `To: ${from_email}`,\n            `Content-Type: text/plain; charset=utf-8`,\n            `MIME-Version: 1.0`,\n            `Subject: ${utf8Subject}`,\n            \'\',\n            body,\n        ];\n        const message = messageParts.join(\'\\n\');\n        const encodedMessage = Buffer.from(message)\n            .toString(\'base64\')\n            .replace(/\\+/g, \'-\')\n            .replace(/\\//g, \'_\')\n            .replace(/=+$/, \'\');\n\n        const sentMsg = await gmail.users.messages.send({\n            userId: \'me\',\n            requestBody: {\n                raw: encodedMessage,\n            },\n        });\n        sentResults.push({ messageId: sentMsg.data.id });\n    }\n  }\n\n  writeFileSync(RESULTS_FILE, JSON.stringify({ sent_results: sentResults }, null, 2));\n}\n\nsolve().catch(console.error);\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
