Sending keys: ['cat > /root/output/js/visualization.js << \'EOF\'\nconst margin = { top: 20, right: 20, bottom: 20, left: 20 };\nconst width = document.getElementById(\'bubble-chart\').clientWidth - margin.left - margin.right;\nconst height = 600 - margin.top - margin.bottom;\n\nconst svg = d3.select(\'#bubble-chart\')\n    .attr(\'width\', width + margin.left + margin.right)\n    .attr(\'height\', height + margin.top + margin.bottom)\n    .append(\'g\')\n    .attr(\'transform\', `translate(${margin.left},${margin.top})`);\n\nconst tooltip = d3.select(\'#tooltip\');\n\nlet stocks = [];\nlet simulation;\n\n// Load and process data\nd3.csv(\'data/stock-descriptions.csv\').then(data => {\n    // Parse numeric fields\n    stocks = data.map(d => ({\n        ticker: d.ticker,\n        sector: d.sector,\n        name: d[\'full name\'],\n        marketCap: parseFloat(d.marketCap) || null,\n        country: d.country,\n        website: d.website,\n        returnOnEquity: parseFloat(d.returnOnEquity) || null,\n        revenuePerShare: parseFloat(d.revenuePerShare) || null,\n        bookValue: parseFloat(d.bookValue) || null,\n        yield: parseFloat(d.yield) || null,\n        beta: parseFloat(d.beta) || null\n    })).filter(d => d.ticker && d.sector && d.name);\n\n    // Filter out stocks without market cap (ETFs) for bubble chart, but keep for table\n    const stocksWithMarketCap = stocks.filter(d => d.marketCap !== null);\n    const etfs = stocks.filter(d => d.marketCap === null);\n\n    // Create visualization\n    createBubbleChart(stocksWithMarketCap, etfs);\n    createTable(stocks);\n}).catch(error => {\n    console.error(\'Error loading data:\', error);\n});\n\nfunction createBubbleChart(stocksWithMarketCap, etfs) {\n    // Combine for visualization (ETFs with uniform size)\n    const bubbleData = stocksWithMarketCap.concat(etfs.map(d => ({\n        ...d,\n        marketCap: d3.mean(stocksWithMarketCap.map(s => s.marketCap)) // Use average for ETFs\n    })));\n\n    // Get unique sectors\n    const sectors = [...new Set(bubbleData.map(d => d.sector))].sort();\n\n    // Color scale\n    const colorScale = d3.scaleOrdinal()\n        .domain(sectors)\n        .range(d3.schemeCategory10);\n\n    // Size scale for bubbles\n    const sizeScale = d3.scaleSqrt()\n        .domain([0, d3.max(bubbleData, d => d.marketCap)])\n        .range([10, 80]);\n\n    // Create nodes for force simulation\n    const nodes = bubbleData.map(d => ({\n        ...d,\n        x: width / 2,\n        y: height / 2,\n        vx: 0,\n        vy: 0\n    }));\n\n    // Create force simulation\n    simulation = d3.forceSimulation(nodes)\n        .force(\'x\', d3.forceX(d => {\n            const sectorIndex = sectors.indexOf(d.sector);\n            return (sectorIndex / (sectors.length - 1 || 1)) * width;\n        }).strength(0.1))\n        .force(\'y\', d3.forceY(height / 2).strength(0.05))\n        .force(\'collide\', d3.forceCollide(d => sizeScale(d.marketCap) + 2))\n        .force(\'charge\', d3.forceManyBody().strength(-30))\n        .on(\'tick\', ticked);\n\n    // Create bubble groups\n    const bubbles = svg.selectAll(\'.bubble\')\n        .data(nodes, d => d.ticker)\n        .enter()\n        .append(\'g\')\n        .attr(\'class\', \'bubble\')\n        .attr(\'data-ticker\', d => d.ticker);\n\n    // Add circles\n    bubbles.append(\'circle\')\n        .attr(\'r\', d => sizeScale(d.marketCap))\n        .attr(\'fill\', d => colorScale(d.sector))\n        .attr(\'stroke\', \'white\')\n        .attr(\'stroke-width\', 2)\n        .on(\'mouseover\', function(event, d) {\n            if (d.marketCap && stocks.find(s => s.ticker === d.ticker).marketCap !== null) {\n                showTooltip(event, d);\n            }\n        })\n        .on(\'mouseout\', hideTooltip)\n        .on(\'click\', function(event, d) {\n            event.stopPropagation();\n            highlightBubbleAndRow(d.ticker);\n        });\n\n    // Add labels (ticker symbols)\n    bubbles.append(\'text\')\n        .attr(\'class\', \'bubble-label\')\n        .attr(\'dy\', \'0.3em\')\n        .text(d => d.ticker)\n        .attr(\'fill\', \'white\')\n        .attr(\'font-weight\', \'bold\')\n        .attr(\'font-size\', \'11px\')\n        .attr(\'pointer-events\', \'none\');\n\n    // Update positions on simulation tick\n    function ticked() {\n        bubbles.attr(\'transform\', d => `translate(${d.x},${d.y})`);\n    }\n\n    // Create legend\n    const legend = d3.select(\'#legend\');\n    sectors.forEach(sector => {\n        const item = legend.append(\'div\')\n            .attr(\'class\', \'legend-item\');\n        item.append(\'div\')\n            .attr(\'class\', \'legend-color\')\n            .style(\'background-color\', colorScale(sector));\n        item.append(\'span\')\n            .text(sector);\n    });\n}\n\nfunction createTable(stocks) {\n    const tbody = d3.select(\'#table-body\');\n    const rows = tbody.selectAll(\'tr\')\n        .data(stocks, d => d.ticker)\n        .enter()\n        .append(\'tr\')\n        .attr(\'data-ticker\', d => d.ticker)\n        .on(\'click\', function(event, d) {\n            highlightBubbleAndRow(d.ticker);\n        });\n\n    rows.append(\'td\').text(d => d.ticker);\n    rows.append(\'td\').text(d => d.name);\n    rows.append(\'td\').text(d => d.sector);\n    rows.append(\'td\').text(d => {\n        if (d.marketCap === null) return \'N/A\';\n        return formatMarketCap(d.marketCap);\n    });\n}\n\nfunction formatMarketCap(value) {\n    if (value >= 1e12) return (value / 1e12).toFixed(2) + \'T\';\n    if (value >= 1e9) return (value / 1e9).toFixed(2) + \'B\';\n    if (value >= 1e6) return (value / 1e6).toFixed(2) + \'M\';\n    return value.toFixed(0);\n}\n\nfunction showTooltip(event, d) {\n    const stock = stocks.find(s => s.ticker === d.ticker);\n    if (!stock || stock.marketCap === null) return;\n\n    tooltip.classed(\'visible\', true)\n        .style(\'left\', (event.pageX + 10) + \'px\')\n        .style(\'top\', (event.pageY - 10) + \'px\')\n        .html(`\n            <strong>${d.ticker}</strong><br/>\n            ${d.name}<br/>\n            ${d.sector}\n        `);\n}\n\nfunction hideTooltip() {\n    tooltip.classed(\'visible\', false);\n}\n\nfunction highlightBubbleAndRow(ticker) {\n    // Clear previous highlights\n    d3.selectAll(\'circle.highlighted\').classed(\'highlighted\', false);\n    d3.selectAll(\'tr.highlighted\').classed(\'highlighted\', false);\n\n    // Highlight bubble\n    d3.selectAll(`[data-ticker="${ticker}"] circle`)\n        .classed(\'highlighted\', true);\n\n    // Highlight table row\n    const row = d3.select(`tr[data-ticker="${ticker}"]`);\n    row.classed(\'highlighted\', true);\n\n    // Scroll table row into view\n    const element = document.querySelector(`tr[data-ticker="${ticker}"]`);\n    if (element) {\n        element.scrollIntoView({ behavior: \'smooth\', block: \'nearest\' });\n    }\n}\n\n// Clear highlights on background click\nd3.select(\'body\').on(\'click\', function() {\n    d3.selectAll(\'circle.highlighted\').classed(\'highlighted\', false);\n    d3.selectAll(\'tr.highlighted\').classed(\'highlighted\', false);\n});\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
