Sending keys: ['cat > /tmp/dc_opf_v2.py << \'EOFSCRIPT\'\nimport json\nimport numpy as np\nimport cvxpy as cp\nfrom scipy.sparse import csr_matrix\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Load network data\nwith open(\'/root/network.json\', \'r\') as f:\n    network_data = json.load(f)\n\nbase_mva = network_data[\'baseMVA\']\nbus_data = np.array(network_data[\'bus\'])\ngen_data = np.array(network_data[\'gen\'])\nbranch_data = np.array(network_data[\'branch\'])\ngencost_data = np.array(network_data[\'gencost\'])\n\n# Column indices\nBUS_I, BUS_TYPE, PD, QD = 0, 1, 2, 3\nGEN_BUS, GEN_PG, GEN_PMAX, GEN_PMIN = 0, 1, 8, 9\nBR_FBUS, BR_TBUS, BR_X, BR_STATUS = 0, 1, 3, 10\n\nnum_bus = len(bus_data)\nnum_gen = len(gen_data)\nnum_branch = len(branch_data)\n\nprint(f"DC-OPF V2 Solver")\nprint(f"Buses: {num_bus}, Generators: {num_gen}, Branches: {num_branch}")\n\n# Bus mapping\nbus_idx_map = {int(bus_data[i, BUS_I]): i for i in range(num_bus)}\ngen_bus_indices = [bus_idx_map[int(gen_data[i, GEN_BUS])] for i in range(num_gen)]\n\n# Find slack bus\nslack_idx = None\nfor i in range(num_bus):\n    if int(bus_data[i, BUS_TYPE]) == 3:\n        slack_idx = i\n        break\nif slack_idx is None:\n    slack_idx = 0\n\nprint(f"Slack bus index: {slack_idx}")\n\n# Build susceptance matrix B\nB = np.zeros((num_bus, num_bus))\nfor b_idx in range(num_branch):\n    if int(branch_data[b_idx, BR_STATUS]) == 0:\n        continue\n    fbus_id = int(branch_data[b_idx, BR_FBUS])\n    tbus_id = int(branch_data[b_idx, BR_TBUS])\n    if fbus_id not in bus_idx_map or tbus_id not in bus_idx_map:\n        continue\n    fbus = bus_idx_map[fbus_id]\n    tbus = bus_idx_map[tbus_id]\n    x = branch_data[b_idx, BR_X]\n    if x != 0:\n        b_val = 1.0 / x\n        B[fbus, fbus] += b_val\n        B[tbus, tbus] += b_val\n        B[fbus, tbus] -= b_val\n        B[tbus, fbus] -= b_val\n\n# Reduced B matrix (remove slack row/col)\nnon_slack_idx = [i for i in range(num_bus) if i != slack_idx]\nB_red = B[np.ix_(non_slack_idx, non_slack_idx)]\n\nprint(f"B matrix size: {B_red.shape}")\n\n# Variables\npg = cp.Variable(num_gen)  # Generation in per-unit\ntheta = cp.Variable(len(non_slack_idx))  # Angles in radians\n\n# Objective\ncost = 0\nfor i in range(num_gen):\n    n = int(gencost_data[i, 3])\n    if n >= 2:\n        c = gencost_data[i, 4:4+n]\n        # Polynomial: sum c_k * Pg^(n-1-k)\n        for k, coeff in enumerate(c):\n            power = n - 1 - k\n            if power > 0:\n                cost += coeff * (pg[i] ** power)\n            else:\n                cost += coeff\n    else:\n        cost += gencost_data[i, 4] * pg[i]\n\n# Constraints list\ncons = []\n\n# Generator limits\nfor i in range(num_gen):\n    cons.append(pg[i] >= gen_data[i, GEN_PMIN] / base_mva)\n    cons.append(pg[i] <= gen_data[i, GEN_PMAX] / base_mva)\n\n# Load vector (per-unit)\np_load = np.zeros(num_bus)\nfor i in range(num_bus):\n    p_load[i] = bus_data[i, PD] / base_mva\np_load_red = p_load[non_slack_idx]\n\n# Generation vector matrix\nC_gen = np.zeros((len(non_slack_idx), num_gen))\nfor g_idx in range(num_gen):\n    bus_idx = gen_bus_indices[g_idx]\n    if bus_idx in non_slack_idx:\n        row_idx = non_slack_idx.index(bus_idx)\n        C_gen[row_idx, g_idx] = 1.0\n\n# Power balance: C_gen @ pg - p_load = B_red @ theta\n# Rearrange: C_gen @ pg = B_red @ theta + p_load\ncons.append(C_gen @ pg == B_red @ theta + p_load_red)\n\nprint(f"Total constraints: {len(cons)}")\nprint(f"Solving...")\n\nproblem = cp.Problem(cp.Minimize(cost), cons)\nproblem.solve(solver=cp.SCS, verbose=False, max_iters=5000)\n\nprint(f"Status: {problem.status}")\nprint(f"Optimal cost: {problem.value:.2f}")\n\nif problem.status == \'optimal\':\n    pg_opt = np.array(pg.value) * base_mva\n    print(f"Total generation: {pg_opt.sum():.2f} MW")\n    print(f"Total load: {p_load.sum() * base_mva:.2f} MW")\n    print(f"\\nSample generator outputs:")\n    for i in range(min(5, num_gen)):\n        print(f"  Gen {i}: {pg_opt[i]:.2f} MW")\nelse:\n    print(f"Optimization failed!")\n\nEOFSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
