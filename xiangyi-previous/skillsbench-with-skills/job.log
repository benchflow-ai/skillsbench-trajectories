try:\n            text_parts=[]\n            with zipfile.ZipFile(path) as z:\n                for name in z.namelist():\n                    if name.startswith('ppt/slides/slide') and name.endswith('.xml'):\n                        xml = z.read(name).decode('utf-8', errors='ignore')\n                        text_parts.append(re.sub('<[^<]+?>',' ',xml))\n            return ' '.join(text_parts)\n        except Exception:\n            return ''\n    return ''\n\ndef classify(text):\n    for cat in ['black_hole','DNA','LLM','music_history','trapped_ion_and_qc']:\n        if any(r.search(text) for r in regex[cat]):\n            return cat\n    return 'unknown'\n\nfiles = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\ncat_files = {c:[] for c in patterns}\nfor f in files:\n    t = extract_text(f)\n    cat = classify(t)\n    cat_files.setdefault(cat, []).append((f,t))\n\nfor cat, flist in cat_files.items():\n    print('\\n',cat)\n    for f,t in flist[:3]:\n        lines=[l.strip() for l in t.splitlines() if l.strip()]\n        print(' ',f, '::', ' / '.join(lines[:2]))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
