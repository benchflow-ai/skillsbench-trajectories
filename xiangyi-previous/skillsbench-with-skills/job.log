Sending keys: ["python3 << 'PYEOF'\nimport numpy as np\nimport qutip as qt\nN = 4\nomega_0 = 1.0\nomega_c = 1.0\ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\nj = N / 2\ndim_spin = int(2 * j + 1)\na = qt.tensor(qt.destroy(n_max), qt.qeye(dim_spin))\nJz = qt.tensor(qt.qeye(n_max), qt.jmat(j, 'z'))\nJp = qt.tensor(qt.qeye(n_max), qt.jmat(j, '+'))\nJm = qt.tensor(qt.qeye(n_max), qt.jmat(j, '-'))\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\nfor case in [1,2,3,4]:\n    c_ops = [np.sqrt(kappa) * a]\n    if case == 1:\n        c_ops.append(np.sqrt(0.01) * 2 * Jz)\n        c_ops.append(np.sqrt(0.1) * Jp)\n    elif case == 2:\n        c_ops.append(np.sqrt(0.01) * 2 * Jz)\n        c_ops.append(np.sqrt(0.1) * Jm)\n    elif case == 3:\n        c_ops.append(np.sqrt(0.01) * 2 * Jz)\n        c_ops.append(np.sqrt(0.1) * Jm)\n        c_ops.append(np.sqrt(0.1) * Jp)\n    elif case == 4:\n        c_ops.append(np.sqrt(0.01) * 2 * Jz)\n        c_ops.append(np.sqrt(0.1) * Jm)\n        c_ops.append(np.sqrt(0.1) * Jm)\n    rho_ss = qt.steadystate(H, c_ops)\n    rho_cav = rho_ss.ptrace(0)\n    W = qt.wigner(rho_cav, xvec, pvec)\n    np.savetxt(f'{case}.csv', W, delimiter=',')\n    print(f'Case {case} done')\nprint('All done')\nPYEOF\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
