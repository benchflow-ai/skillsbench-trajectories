Sending keys: ['cat << \'EOF\' > classify.py\nimport os, subprocess, zipfile, re\nimport xml.etree.ElementTree as ET\n\ndef get_text(path):\n    if path.endswith(\'.pdf\'):\n        return subprocess.check_output([\'pdftotext\', path, \'-\'], stderr=subprocess.DEVNULL).decode(\'utf-8\', errors=\'ignore\')\n    if path.endswith(\'.docx\'):\n        try:\n            with zipfile.ZipFile(path) as z:\n                root = ET.fromstring(z.read(\'word/document.xml\'))\n                return " ".join(node.text for node in root.iter() if node.text)\n        except: return ""\n    if path.endswith(\'.pptx\'):\n        try:\n            text = []\n            with zipfile.ZipFile(path) as z:\n                for f in z.namelist():\n                    if f.startswith(\'ppt/slides/slide\'):\n                        root = ET.fromstring(z.read(f))\n                        text.append(" ".join(node.text for node in root.iter() if node.text))\n            return " ".join(text)\n        except: return ""\n    return ""\n\ndef classify(text, filename):\n    text = text.lower() + " " + filename.lower()\n    \n    # Check for Black Hole\n    if re.search(r\'\\b(black hole|event horizon|hawking radiation|schwarzschild|gravitational wave|general relativity)\\b\', text):\n        return "black_hole"\n    # Check for DNA\n    if re.search(r\'\\b(dna|genome|genetics|sequencing|nucleotide|chromosome|rna|phylogenetic)\\b\', text):\n        return "DNA"\n    # Check for Trapped Ion / QC\n    if re.search(r\'\\b(trapped ion|quantum computing|qubit|quantum gate|rydberg|ion trap|quantum simulation)\\b\', text):\n        return "trapped_ion_and_qc"\n    # Check for LLM\n    if re.search(r\'\\b(large language model|llm|transformer|gpt|attention mechanism|pre-training|nlp)\\b\', text):\n        return "LLM"\n    \n    return "music_history"\n\ncats = [\'LLM\', \'trapped_ion_and_qc\', \'black_hole\', \'DNA\', \'music_history\']\nfor c in cats: os.makedirs(c, exist_ok=True)\n\n# Collect all files first\nall_files = []\nfor c in cats:\n    for f in os.listdir(c):\n        all_files.append(os.path.join(c, f))\n\nfor path in all_files:\n    if os.path.isdir(path): continue\n    filename = os.path.basename(path)\n    text = get_text(path)\n    category = classify(text, filename)\n    \n    dest = os.path.join(category, filename)\n    if path != dest:\n        os.rename(path, dest)\nEOF\npython3 classify.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
