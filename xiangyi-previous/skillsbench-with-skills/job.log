sPoolExecutor(max_workers=num_workers) as executor:\n        results = executor.map(_index_chunk_stage2, stage2_inputs)\n        \n        for p_inverted, p_vectors, p_norms in results:\n            # Merge inverted index\n            for term, postings in p_inverted.items():\n                if term not in index.inverted_index:\n                    index.inverted_index[term] = []\n                index.inverted_index[term].extend(postings)\n            \n            index.doc_vectors.update(p_vectors)\n            index.doc_norms.update(p_norms)\n            \n    # Sort posting lists (required for consistency with sequential version)\n    for term in index.inverted_index:\n        index.inverted_index[term].sort(key=lambda x: x[1], reverse=True)\n        \n    elapsed = time.perf_counter() - start_time\n    return IndexingResult(index=index, elapsed_time=elapsed, num_documents=len(documents), vocabulary_size=len(index.vocabulary))\n\n# ============================================================================\n# Parallel Search\n# ============================================================================\n\n_global_index = None\n_global_documents = None\n\ndef _init_search_worker(index, documents):\n    """\n    Initializer to set global variables in worker processes.\n    Avoids pickling large index for every task.\n    """\n    global _global_index, _global_documents\n    _global_index = index\n    _global_documents = documents\n\ndef _search_chunk(queries: List[str], top_k: int) -> List[SearchResult]:\n    """\n    Worker function to search a chunk of queries.\n    """\n    results = []\n    # We use search_sequential for each query, but distribute queries across workers\n    for query in queries:\n        # search_sequential is imported from sequential.py\n        # It uses the global index we set in initializer\n        res = search_sequential(query, _global_index, top_k, _global_documents)\n        results.append(res)\n    return results\n\ndef _search_chunk_wrapper(args):\n    """Unpack arguments for map."""\n    return _search_chunk(*args)\n\ndef batch_search_parallel(queries: List[str], index: TFIDFIndex, top_k=10, num_workers=None, documents=None) -> Tuple[List[List[SearchResult]], float]:\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n        \n    start_time = time.perf_counter()\n    \n    # Chunk queries\n    chunk_size = max(1, len(queries) // num_workers)\n    # Ensure we don\'t have empty chunks if len(queries) < num_workers\n    if len(queries) < num_workers:\n        chunk_size = 1\n        \n    query_chunks = [queries[i:i + chunk_size] for i in range(0, len(queries), chunk_size)]\n    \n    # Prepare arguments: just query chunks and top_k\n    # index and documents are passed via initializer\n    process_args = [(chunk, top_k) for chunk in query_chunks]\n    \n    results = []\n    \n    with ProcessPoolExecutor(max_workers=num_workers, initializer=_init_search_worker, initargs=(index, documents)) as executor:\n        chunk_results = executor.map(_search_chunk_wrapper, process_args)\n        \n        for res in chunk_results:\n            results.extend(res)\n            \n    elapsed = time.perf_counter() - start_time\n    return results, elapsed\n\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
