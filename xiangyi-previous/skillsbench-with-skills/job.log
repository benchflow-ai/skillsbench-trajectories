 hint\n    matches = re.findall(r\'(\\d{1,3}(?:,\\d{3})*\\.\\d{2})\', line)\n    if matches:\n        # Return the last one found on the line\n        val = matches[-1]\n        return val.replace(\',\', \'\')\n    return None\n\ndef extract_total(text):\n    lines = text.split(\'\\n\')\n    candidates = [] # (priority, value)\n    \n    for i, line in enumerate(lines):\n        line_upper = line.upper()\n        \n        # Check exclusion\n        if any(ex in line_upper for ex in EXCLUSION):\n            continue\n            \n        priority = 0\n        if any(k in line_upper for k in PRIORITY_1):\n            priority = 1\n        elif any(k in line_upper for k in PRIORITY_2):\n            priority = 2\n        elif any(k in line_upper for k in PRIORITY_3):\n            priority = 3\n        elif any(k in line_upper for k in PRIORITY_4):\n            priority = 4\n            \n        if priority > 0:\n            val = parse_amount(line)\n            if val:\n                candidates.append((priority, val))\n            else:\n                # Fallback to next line\n                if i + 1 < len(lines):\n                    next_line = lines[i+1]\n                    val_next = parse_amount(next_line)\n                    if val_next:\n                        candidates.append((priority, val_next))\n    \n    if not candidates:\n        return None\n        \n    # Sort by priority (1 is best, so ascending)\n    candidates.sort(key=lambda x: x[0])\n    return candidates[0][1]\n\ndef process():\n    wb = Workbook()\n    ws = wb.active\n    ws.title = "results"\n    ws.append(["filename", "date", "total_amount"])\n    \n    files = sorted(glob.glob(os.path.join(IMG_DIR, "*.jpg")))\n    \n    for fpath in files:\n        fname = os.path.basename(fpath)\n        try:\n            text = pytesseract.image_to_string(Image.open(fpath))\n            \n            date_str = extract_date(text)\n            total_str = extract_total(text)\n            \n            ws.append([fname, date_str, total_str])\n        except Exception as e:\n            print(f"Error processing {fname}: {e}")\n            ws.append([fname, None, None])\n            \n    wb.save(OUTPUT_FILE)\n\nif __name__ == "__main__":\n    process()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
