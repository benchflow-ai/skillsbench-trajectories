Sending keys: ['cat > solve_acopf.py << \'EOF\'\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize\nimport sys\n\n# Load network data\nwith open(\'network.json\', \'r\') as f:\n    data = json.load(f)\n\nbaseMVA = data[\'baseMVA\']\nbuses = np.array(data[\'bus\'])\ngens = np.array(data[\'gen\'])\nbranches = np.array(data[\'branch\'])\ngencosts = np.array(data[\'gencost\'])\n\n# Parse data\nn_bus = len(buses)\nn_gen = len(gens)\nn_branch = len(branches)\n\nprint(f"Loading network: {n_bus} buses, {n_gen} generators, {n_branch} branches")\n\n# Bus data (1-indexed in file, convert to 0-indexed)\nbus_id = buses[:, 0].astype(int)\nbus_type = buses[:, 1].astype(int)\nPd = buses[:, 2] / baseMVA\nQd = buses[:, 3] / baseMVA\nGs = buses[:, 4]\nBs = buses[:, 5]\nVm_init = buses[:, 7]\nVa_init = buses[:, 8] * np.pi / 180\nVmax = buses[:, 11]\nVmin = buses[:, 12]\n\n# Generator data\ngen_bus = gens[:, 0].astype(int) - 1\nPg_init = gens[:, 1] / baseMVA\nQg_init = gens[:, 2] / baseMVA\nQmax = gens[:, 3] / baseMVA\nQmin = gens[:, 4] / baseMVA\nVg = gens[:, 5]\ngen_status = gens[:, 7].astype(int)\nPmax = gens[:, 8] / baseMVA\nPmin = gens[:, 9] / baseMVA\n\n# Generator cost data\ncost_model = gencosts[:, 0].astype(int)\nn_cost = gencosts[:, 3].astype(int)\ncost_coeffs = gencosts[:, 4:]\n\nc2 = np.zeros(n_gen)\nc1 = np.zeros(n_gen)\nc0 = np.zeros(n_gen)\nfor i in range(n_gen):\n    if cost_model[i] == 2:\n        if n_cost[i] == 3:\n            c2[i] = cost_coeffs[i, 0] * baseMVA * baseMVA\n            c1[i] = cost_coeffs[i, 1] * baseMVA\n            c0[i] = cost_coeffs[i, 2]\n        elif n_cost[i] == 2:\n            c1[i] = cost_coeffs[i, 0] * baseMVA\n            c0[i] = cost_coeffs[i, 1]\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
