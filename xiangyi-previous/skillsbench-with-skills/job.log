Sending keys: ['cat >> solve_acopf.py << \'EOF\'\n\n# Initial point\nx0 = pack_vars(Va_init, Vm_init, Pg_init, Qg_init)\n\nprint("\\nSolving AC-OPF...")\nprint(f"Initial objective: ${objective(x0):.2f}/hr")\n\n# Set up constraints\ncons_eq = {\'type\': \'eq\', \'fun\': constraints_eq}\ncons_ineq = {\'type\': \'ineq\', \'fun\': lambda x: -constraints_ineq(x)}\n\n# Bounds\nbounds = []\nfor i in range(n_bus):\n    bounds.append((-np.pi, np.pi))\nfor i in range(n_bus):\n    bounds.append((Vmin[i], Vmax[i]))\nfor i in range(n_gen):\n    if gen_status[i]:\n        bounds.append((Pmin[i], Pmax[i]))\n    else:\n        bounds.append((0, 0))\nfor i in range(n_gen):\n    if gen_status[i]:\n        bounds.append((Qmin[i], Qmax[i]))\n    else:\n        bounds.append((0, 0))\n\n# Solve\nresult = minimize(\n    objective,\n    x0,\n    method=\'SLSQP\',\n    bounds=bounds,\n    constraints=[cons_eq, cons_ineq],\n    options={\'maxiter\': 1000, \'ftol\': 1e-6, \'disp\': True}\n)\n\nprint(f"\\nOptimization: {result.message}")\nprint(f"Success: {result.success}")\nprint(f"Final objective: ${result.fun:.2f}/hr")\n\nVa_sol, Vm_sol, Pg_sol, Qg_sol = unpack_vars(result.x)\nVa_deg = Va_sol * 180 / np.pi\n\nP_mis, Q_mis = power_flow_mismatch(Va_sol, Vm_sol, Pg_sol, Qg_sol)\nprint(f"Max P mismatch: {np.max(np.abs(P_mis))*baseMVA:.6f} MW")\nprint(f"Max Q mismatch: {np.max(np.abs(Q_mis))*baseMVA:.6f} MVAr")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
