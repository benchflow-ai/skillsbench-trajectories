Sending keys: ['cat << \'EOF\' > verify.py\nimport json\n\nwith open(\'map_data.json\') as f:\n    map_data = json.load(f)\n\nwidth = map_data[\'width\']\nheight = map_data[\'height\']\nplots = { (p[\'x\'], p[\'y\']): p for p in map_data[\'plots\'] }\n\ndef get_dist(p1, p2):\n    x1, y1 = p1[\'x\'], p1[\'y\']\n    x2, y2 = p2[\'x\'], p2[\'y\']\n    def to_cube(x, y):\n        q = x - (y + (y & 1)) // 2\n        r = y\n        s = -q - r\n        return q, r, s\n    q1, r1, s1 = to_cube(x1, y1)\n    best_dist = 999\n    for offset in [-width, 0, width]:\n        q2, r2, s2 = to_cube(x2 + offset, y2)\n        dist = (abs(q1 - q2) + abs(r1 - r2) + abs(s1 - s2)) // 2\n        if dist < best_dist: best_dist = dist\n    return best_dist\n\ndef get_neighbors(x, y):\n    neighbors = []\n    if y % 2 == 0:\n        coords = [(x-1, y), (x+1, y), (x, y-1), (x+1, y-1), (x, y+1), (x+1, y+1)]\n    else:\n        coords = [(x-1, y), (x+1, y), (x-1, y-1), (x, y-1), (x-1, y+1), (x, y+1)]\n    for nx, ny in coords:\n        if 0 <= ny < height:\n            neighbors.append(plots[(nx % width, ny)])\n    return neighbors\n\ncc = [23, 11]\ndistricts = {"CAMPUS": [21, 14], "COMMERCIAL_HUB": [21, 13], "INDUSTRIAL_ZONE": [22, 13]}\n\nfor name, coord in districts.items():\n    d = get_dist(plots[tuple(cc)], plots[tuple(coord)])\n    print(f"{name} distance from CC: {d}")\n    p = plots[tuple(coord)]\n    print(f"{name} terrain: {p[\'terrain\']}, feature: {p.get(\'feature\')}, resource: {p.get(\'resource\')}")\n    neighbors = get_neighbors(coord[0], coord[1])\n    print(f"{name} neighbors:")\n    for n in neighbors:\n        print(f"  ({n[\'x\']}, {n[\'y\']}): {n[\'terrain\']}, {n.get(\'feature\')}, {n.get(\'resource\')}, {\'DISTRICT\' if [n[\'x\'], n[\'y\']] in districts.values() or [n[\'x\'], n[\'y\']] == cc else \'\'}")\n\nEOF\npython3 verify.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
