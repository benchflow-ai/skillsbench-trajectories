Sending keys: ['cat > /root/workspace/solution.py << \'EOF\'\nimport pdfplumber\nimport json\nimport urllib.request\nimport urllib.parse\nfrom rdkit import Chem\nfrom rdkit.Chem import AllChem\nfrom collections import defaultdict\n\ndef get_smiles_from_pubchem(molecule_name):\n    """\n    Convert a chemical name to SMILES using PubChem API.\n    """\n    try:\n        # URL encode the molecule name\n        encoded_name = urllib.parse.quote(molecule_name)\n        url = f"https://pubchem.ncbi.nlm.nih.gov/rest/v1/compound/name/{encoded_name}/property/CanonicalSMILES/JSON"\n        \n        with urllib.request.urlopen(url, timeout=5) as response:\n            data = json.loads(response.read().decode())\n            if \'properties\' in data and len(data[\'properties\']) > 0:\n                return data[\'properties\'][0].get(\'CanonicalSMILES\')\n    except Exception as e:\n        pass\n    \n    return None\n\ndef extract_molecules_from_pdf(filepath):\n    """\n    Extract chemical names from the PDF file.\n    """\n    molecules = []\n    try:\n        with pdfplumber.open(filepath) as pdf:\n            for page in pdf.pages:\n                text = page.extract_text()\n                if text:\n                    # Split by newlines and filter empty lines\n                    lines = [line.strip() for line in text.split(\'\\n\') if line.strip()]\n                    molecules.extend(lines)\n    except Exception as e:\n        pass\n    \n    return molecules\n\ndef compute_morgan_fingerprint(smiles, radius=2):\n    """\n    Compute Morgan fingerprint for a molecule.\n    """\n    try:\n        mol = Chem.MolFromSmiles(smiles)\n        if mol is not None:\n            return AllChem.GetMorganFingerprintAsBitVect(mol, radius=radius, nBits=2048, useChirality=True)\n    except Exception as e:\n        pass\n    \n    return None\n\ndef tanimoto_similarity(fp1, fp2):\n    """\n    Compute Tanimoto similarity between two fingerprints.\n    """\n    if fp1 is None or fp2 is None:\n        return -1.0\n    \n    try:\n        from rdkit import DataStructs\n        return DataStructs.TanimotoSimilarity(fp1, fp2)\n    except Exception as e:\n        return -1.0\n\ndef topk_tanimoto_similarity_molecules(target_molecule_name, molecule_pool_filepath, top_k):\n    """\n    Find the top k similar chemicals to a target molecule.\n    \n    Args:\n        target_molecule_name: Name of the target molecule\n        molecule_pool_filepath: Path to the PDF file containing molecule names\n        top_k: Number of top similar molecules to return\n    \n    Returns:\n        List of tuples (molecule_name, similarity_score) sorted by similarity (descending)\n        and alphabetically for ties\n    """\n    # Get SMILES for target molecule\n    target_smiles = get_smiles_from_pubchem(target_molecule_name)\n    if target_smiles is None:\n        return []\n    \n    # Compute fingerprint for target\n    target_fp = compute_morgan_fingerprint(target_smiles, radius=2)\n    if target_fp is None:\n        return []\n    \n    # Extract molecules from PDF\n    molecules = extract_molecules_from_pdf(molecule_pool_filepath)\n    \n    # Compute similarities\n    similarities = []\n    for mol_name in molecules:\n        if mol_name.lower() == target_molecule_name.lower():\n            continue  # Skip the target molecule itself\n        \n        mol_smiles = get_smiles_from_pubchem(mol_name)\n        if mol_smiles is not None:\n            mol_fp = compute_morgan_fingerprint(mol_smiles, radius=2)\n            if mol_fp is not None:\n                sim = tanimoto_similarity(target_fp, mol_fp)\n                if sim >= 0:\n                    similarities.append((mol_name, sim))\n    \n    # Sort by similarity (descending) and then alphabetically\n    similarities.sort(key=lambda x: (-x[1], x[0]))\n    \n    # Return top k\n    return similarities[:top_k]\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
