Sending keys: ['cat > /tmp/dubbing.py << \'EOF\'\nimport asyncio\nimport subprocess\nimport json\nimport os\nfrom datetime import timedelta\nimport numpy as np\nimport soundfile as sf\nfrom scipy import signal\nfrom scipy.io import wavfile\n\n# Parse SRT time to seconds\ndef srt_time_to_seconds(time_str):\n    parts = time_str.split(\':\')\n    hours = int(parts[0])\n    minutes = int(parts[1])\n    seconds_parts = parts[2].split(\',\')\n    seconds = int(seconds_parts[0])\n    milliseconds = int(seconds_parts[1])\n    return hours * 3600 + minutes * 60 + seconds + milliseconds / 1000\n\n# Parse SRT file\ndef parse_srt(filename):\n    segments = []\n    with open(filename, \'r\', encoding=\'utf-8\') as f:\n        lines = f.readlines()\n    \n    i = 0\n    while i < len(lines):\n        if lines[i].strip().isdigit():\n            start_end = lines[i+1].strip().split(\' --> \')\n            start = srt_time_to_seconds(start_end[0])\n            end = srt_time_to_seconds(start_end[1])\n            text = lines[i+2].strip()\n            segments.append({\'start\': start, \'end\': end, \'text\': text})\n            i += 4\n        else:\n            i += 1\n    return segments\n\n# Generate TTS using edge-tts\nasync def generate_tts(text, language, output_file):\n    cmd = f\'edge-tts --voice ja-JP-NanaNeural --text "{text}" --write-media {output_file}\'\n    process = await asyncio.create_subprocess_shell(cmd)\n    await process.wait()\n\n# Convert audio to target specs\ndef process_audio(input_file, output_file, target_duration):\n    # Read audio\n    data, sr = sf.read(input_file)\n    \n    # Convert to mono if stereo\n    if len(data.shape) > 1:\n        data = np.mean(data, axis=1)\n    \n    # Resample to 48kHz\n    if sr != 48000:\n        num_samples = int(len(data) * 48000 / sr)\n        data = signal.resample(data, num_samples)\n        sr = 48000\n    \n    # Adjust duration\n    current_duration = len(data) / sr\n    if current_duration < target_duration:\n        # Pad with silence\n        samples_needed = int((target_duration - current_duration) * sr)\n        data = np.pad(data, (0, samples_needed), mode=\'constant\')\n    elif current_duration > target_duration:\n        # Trim\n        samples_to_keep = int(target_duration * sr)\n        data = data[:samples_to_keep]\n    \n    # Normalize to -23 LUFS (simplified: use RMS normalization)\n    rms = np.sqrt(np.mean(data ** 2))\n    if rms > 0:\n        target_rms = 10 ** (-23 / 20)  # Simplified LUFS to RMS\n        data = data * (target_rms / rms)\n    \n    # Ensure no clipping\n    data = np.clip(data, -1.0, 1.0)\n    \n    # Write output\n    sf.write(output_file, data, sr)\n    return sr, len(data) / sr\n\n# Measure LUFS (simplified)\ndef measure_lufs(audio_file):\n    data, sr = sf.read(audio_file)\n    if len(data.shape) > 1:\n        data = np.mean(data, axis=1)\n    \n    # Simplified LUFS calculation\n    rms = np.sqrt(np.mean(data ** 2))\n    if rms > 0:\n        lufs = 20 * np.log10(rms) - 0.691  # Simplified conversion\n    else:\n        lufs = -np.inf\n    return lufs\n\n# Main dubbing process\nasync def main():\n    # Read target language\n    with open(\'/root/target_language.txt\', \'r\') as f:\n        target_lang = f.read().strip()\n    \n    # Parse segments\n    segments_data = parse_srt(\'/root/segments.srt\')\n    source_data = parse_srt(\'/root/source_text.srt\')\n    target_data = parse_srt(\'/root/reference_target_text.srt\')\n    \n    # Get original video duration\n    result = subprocess.run(\n        [\'ffprobe\', \'-v\', \'error\', \'-show_entries\', \'format=duration\', \'-of\', \'default=noprint_wrappers=1:nokey=1:noesc=1\', \'/root/input.mp4\'],\n        capture_output=True, text=True\n    )\n    original_duration = float(result.stdout.strip())\n    \n    # Process each segment\n    report_segments = []\n    \n    for idx, seg in enumerate(segments_data):\n        window_start = seg[\'start\']\n        window_end = seg[\'end\']\n        window_duration = window_end - window_start\n        \n        # Get corresponding text\n        source_text = source_data[idx][\'text\'] if idx < len(source_data) else \'\'\n        target_text = target_data[idx][\'text\'] if idx < len(target_data) else \'\'\n        \n        # Generate TTS\n        tts_file = f\'/tmp/tts_{idx}.mp3\'\n        await generate_tts(target_text, target_lang, tts_file)\n        \n        # Process audio\n        output_wav = f\'/outputs/tts_segments/seg_{idx}.wav\'\n        sr, tts_duration = process_audio(tts_file, output_wav, window_duration)\n        \n        # Measure LUFS\n        lufs = measure_lufs(output_wav)\n        \n        # Calculate drift\n        drift = abs(tts_duration - window_duration)\n        \n        # Determine duration control method\n        if tts_duration < window_duration:\n            duration_control = \'pad_silence\'\n        elif tts_duration > window_duration:\n            duration_control = \'trim\'\n        else:\n            duration_control = \'rate_adjust\'\n        \n        report_segments.append({\n            \'window_start_sec\': round(window_start, 3),\n            \'window_end_sec\': round(window_end, 3),\n            \'placed_start_sec\': round(window_start, 3),\n            \'placed_end_sec\': round(window_start + tts_duration, 3),\n            \'source_text\': source_text,\n            \'target_text\': target_text,\n            \'window_duration_sec\': round(window_duration, 3),\n            \'tts_duration_sec\': round(tts_duration, 3),\n            \'drift_sec\': round(drift, 3),\n            \'duration_control\': duration_control\n        })\n    \n    # Create dubbed video\n    # Extract video without audio\n    subprocess.run([\n        \'ffmpeg\', \'-i\', \'/root/input.mp4\', \'-c:v\', \'copy\', \'-an\', \'-y\',\n        \'/tmp/video_only.mp4\'\n    ], capture_output=True)\n    \n    # Concatenate all audio segments\n    concat_file = \'/tmp/concat.txt\'\n    with open(concat_file, \'w\') as f:\n        for idx in range(len(segments_data)):\n            f.write(f"file \'/outputs/tts_segments/seg_{idx}.wav\'\\n")\n    \n    # Concat audio\n    subprocess.run([\n        \'ffmpeg\', \'-f\', \'concat\', \'-safe\', \'0\', \'-i\', concat_file,\n        \'-c:a\', \'pcm_s16le\', \'-y\', \'/tmp/dubbed_audio.wav\'\n    ], capture_output=True)\n    \n    # Mux video and audio\n    subprocess.run([\n        \'ffmpeg\', \'-i\', \'/tmp/video_only.mp4\', \'-i\', \'/tmp/dubbed_audio.wav\',\n        \'-c:v\', \'copy\', \'-c:a\', \'aac\', \'-shortest\', \'-y\',\n        \'/outputs/dubbed.mp4\'\n    ], capture_output=True)\n    \n    # Measure final LUFS\n    final_lufs = measure_lufs(\'/tmp/dubbed_audio.wav\')\n    \n    # Generate report\n    report = {\n        \'source_language\': \'en\',\n        \'target_language\': target_lang,\n        \'audio_sample_rate_hz\': 48000,\n        \'audio_channels\': 1,\n        \'original_duration_sec\': round(original_duration, 3),\n        \'new_duration_sec\': round(original_duration, 3),\n        \'measured_lufs\': round(final_lufs, 1),\n        \'speech_segments\': report_segments\n    }\n    \n    # Write report\n    with open(\'/outputs/report.json\', \'w\', encoding=\'utf-8\') as f:\n        json.dump(report, f, indent=2, ensure_ascii=False)\n    \n    print(\'Dubbing complete!\')\n    print(json.dumps(report, indent=2, ensure_ascii=False))\n\nif __name__ == \'__main__\':\n    asyncio.run(main())\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
