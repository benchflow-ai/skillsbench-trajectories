width, height):\n        p = plots[adj_id]\n        if \'COAST\' in p[\'terrain\']:\n            bonus += 0.5\n    return bonus\n\ndef calculate_industrial_zone_bonus(plot_id, width, height, plots):\n    """Industrial Zone: +0.5 per mountain, +0.5 per river"""\n    bonus = 0\n    for adj_id in get_adjacent_plots(plot_id, width, height):\n        p = plots[adj_id]\n        if \'MOUNTAIN\' in p[\'terrain\']:\n            bonus += 0.5\n    return bonus\n\ndef calculate_holy_site_bonus(plot_id, width, height, plots):\n    """Holy Site: +0.5 per mountain"""\n    bonus = 0\n    for adj_id in get_adjacent_plots(plot_id, width, height):\n        p = plots[adj_id]\n        if \'MOUNTAIN\' in p[\'terrain\']:\n            bonus += 0.5\n    return bonus\n\ndef calculate_theater_square_bonus(plot_id, width, height, plots, other_districts):\n    """Theater Square: +0.5 per adjacent district"""\n    bonus = 0\n    for adj_id in get_adjacent_plots(plot_id, width, height):\n        if adj_id in other_districts:\n            bonus += 0.5\n    return bonus\n\n# Find passable land suitable for city center\npassable_land = [pid for pid, p in plots.items() \n                 if p[\'terrain\'] != \'TERRAIN_OCEAN\' and not p[\'impassable\'] and p[\'terrain\'] != \'TERRAIN_COAST\']\n\nprint(f"Suitable city center locations (non-coast passable land): {len(passable_land)}")\nprint("\\nTop candidates:")\n\nbest_config = None\nbest_total = 0\n\n# Test each possible city center location\nfor city_center_id in passable_land:\n    city_p = plots[city_center_id]\n    \n    # Get adjacent plots for districts\n    adjacent_ids = get_adjacent_plots(city_center_id, width, height)\n    \n    # Filter valid district locations (passable, not ocean, not the city center)\n    valid_districts = [pid for pid in adjacent_ids \n                      if plots[pid][\'terrain\'] != \'TERRAIN_OCEAN\' and not plots[pid][\'impassable\']]\n    \n    if len(valid_districts) < 3:  # Need at least 3 spots for districts\n        continue\n    \n    # Calculate bonuses for different district types\n    campus_bonus = calculate_campus_bonus(city_center_id, width, height, plots)\n    commercial_bonus = calculate_commercial_hub_bonus(city_center_id, width, height, plots)\n    industrial_bonus = calculate_industrial_zone_bonus(city_center_id, width, height, plots)\n    holy_site_bonus = calculate_holy_site_bonus(city_center_id, width, height, plots)\n    \n    # Simple strategy: place districts with highest bonuses\n    districts_config = []\n    if campus_bonus > 0:\n        districts_config.append((\'CAMPUS\', city_center_id, campus_bonus))\n    if commercial_bonus > 0:\n        districts_config.append((\'COMMERCIAL_HUB\', city_center_id, commercial_bonus))\n    if industrial_bonus > 0:\n        districts_config.append((\'INDUSTRIAL_ZONE\', city_center_id, industrial_bonus))\n    \n    total_bonus = sum(b for _, _, b in districts_config)\n    \n    if total_bonus > best_total:\n        best_total = total_bonus\n        best_config = {\n            \'city_center\': city_center_id,\n            \'city_p\': city_p,\n            \'districts\': districts_config,\n            \'total\': total_bonus\n        }\n\nif best_config:\n    print(f"\\nBest configuration found:")\n    print(f"  City center: Plot {best_config[\'city_center\']} at ({best_config[\'city_p\'][\'x\']}, {best_config[\'city_p\'][\'y\']})")\n    print(f"  Total adjacency bonus: {best_config[\'total\']}")\n    for dist_type, city_id, bonus in best_config[\'districts\']:\n        print(f"    {dist_type}: {bonus}")\n\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
