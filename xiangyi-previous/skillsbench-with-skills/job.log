Sending keys: ["cat <<EOF > solve_tasks.py\nimport jax\nimport jax.numpy as jnp\nimport numpy as np\n\n# 1. basic_reduce\nx = jnp.load('data/x.npy')\nres1 = jnp.mean(x, axis=1)\nnp.save('basic_reduce.npy', np.array(res1))\n\n# 2. map_square\n# Apply square function to each element using vectorization.\ndef square(x):\n    return x ** 2\nres2 = jax.vmap(jax.vmap(square))(x)\n# Alternatively, just x**2 but the task says 'using vectorization', \n# usually meaning vmap in JAX context, though JAX arrays are already vectorized.\n# Let's use simple x**2 as it's the standard way in JAX/numpy too.\n# However, to be safe with the 'description', I'll show use of vmap if it's element-wise.\n# Actually, jnp.square(x) is also fine. Let's use vmap to be explicit.\n# For a 2D array, we need to vmap twice or vmap over the flattened array.\n# Actually vmap(square) on a 1D array works, so vmap(vmap(square)) for 2D.\n# But jnp.square(x) is easier. Let's stick with what's expected in JAX.\nres2 = jax.vmap(lambda row: jax.vmap(lambda el: el**2)(row))(x)\nnp.save('map_square.npy', np.array(res2))\n\n# 3. grad_logistic\n# Compute gradient of logistic loss.\n# Loss = -sum(y * log(sigmoid(x @ w)) + (1 - y) * log(1 - sigmoid(x @ w)))\n# or simply use the formula for logistic loss gradient.\ndef logistic_loss(w, x, y):\n    logits = jnp.dot(x, w)\n    # Binary cross entropy loss\n    # Using jax.nn.sigmoid_binary_cross_entropy or similar is better for stability\n    # But let's write it out or use a stable version.\n    # loss = -jnp.mean(y * jax.nn.log_sigmoid(logits) + (1 - y) * jnp.log(1 - jax.nn.sigmoid(logits)))\n    # More stable: \n    max_val = jnp.maximum(0, logits)\n    loss = jnp.mean(max_val - logits * y + jnp.log(1 + jnp.exp(-jnp.abs(logits))))\n    return loss\n\ndata_log = np.load('data/logistic.npz')\nx_log, y_log, w_log = data_log['x'], data_log['y'], data_log['w']\ngrad_fn = jax.grad(logistic_loss)\nres3 = grad_fn(w_log, x_log, y_log)\nnp.save('grad_logistic.npy', np.array(res3))\n\n# 4. scan_rnn\n# Implement RNN forward pass using scan.\n# h_t = tanh(h_{t-1} W_h + x_t W_x + b)\ndata_seq = np.load('data/seq.npz')\nseq, h_init, Wx, Wh, b = data_seq['seq'], data_seq['init'], data_seq['Wx'], data_seq['Wh'], data_seq['b']\n\ndef rnn_step(h, x):\n    h_next = jnp.tanh(jnp.dot(h, Wh) + jnp.dot(x, Wx) + b)\n    return h_next, h_next\n\n_, h_seq = jax.lax.scan(rnn_step, h_init, seq)\nnp.save('scan_rnn.npy', np.array(h_seq))\n\n# 5. jit_mlp\n# Implement and JIT compile a 2-layer MLP.\ndata_mlp = np.load('data/mlp.npz')\nX_mlp, W1, b1, W2, b2 = data_mlp['X'], data_mlp['W1'], data_mlp['b1'], data_mlp['W2'], data_mlp['b2']\n\n@jax.jit\ndef mlp(X, W1, b1, W2, b2):\n    layer1 = jax.nn.relu(jnp.dot(X, W1) + b1)\n    layer2 = jnp.dot(layer1, W2) + b2\n    return layer2\n\nres5 = mlp(X_mlp, W1, b1, W2, b2)\nnp.save('jit_mlp.npy', np.array(res5))\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
