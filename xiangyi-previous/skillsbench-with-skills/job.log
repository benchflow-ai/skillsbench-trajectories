   unified = find_best_match(item, taxonomy)\n    depth = len([x for x in unified if x])\n    \n    mappings.append({\n        \'source\': item[\'source\'],\n        \'category_path\': item[\'original\'],\n        \'depth\': depth,\n        \'unified_level_1\': unified[0],\n        \'unified_level_2\': unified[1],\n        \'unified_level_3\': unified[2],\n        \'unified_level_4\': unified[3],\n        \'unified_level_5\': unified[4]\n    })\n\nprint(f"Created {len(mappings)} mappings")\n\n# Write unified_taxonomy_full.csv\nprint("Writing unified_taxonomy_full.csv...")\ndf_full = pd.DataFrame(mappings)\ndf_full.to_csv(\'/root/output/unified_taxonomy_full.csv\', index=False)\n\n# Generate hierarchy CSV\nprint("Writing unified_taxonomy_hierarchy.csv...")\nhierarchy_paths = set()\n\ndef add_paths(tax, path=[]):\n    if isinstance(tax, dict):\n        for key, value in tax.items():\n            new_path = path + [key]\n            # Pad to 5 levels\n            padded = new_path + [\'\'] * (5 - len(new_path))\n            hierarchy_paths.add(tuple(padded))\n            add_paths(value, new_path)\n\nadd_paths(taxonomy)\n\nhierarchy_data = []\nfor path_tuple in sorted(hierarchy_paths):\n    hierarchy_data.append({\n        \'unified_level_1\': path_tuple[0],\n        \'unified_level_2\': path_tuple[1],\n        \'unified_level_3\': path_tuple[2],\n        \'unified_level_4\': path_tuple[3],\n        \'unified_level_5\': path_tuple[4]\n    })\n\ndf_hierarchy = pd.DataFrame(hierarchy_data)\ndf_hierarchy.to_csv(\'/root/output/unified_taxonomy_hierarchy.csv\', index=False)\n\nprint(f"\\nCompleted!")\nprint(f"Total unified paths in hierarchy: {len(hierarchy_data)}")\nprint(f"Level 1 categories: {len(taxonomy)}")\nprint(f"\\nOutput files:")\nprint("  /root/output/unified_taxonomy_full.csv")\nprint("  /root/output/unified_taxonomy_hierarchy.csv")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
