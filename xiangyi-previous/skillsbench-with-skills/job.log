Sending keys: ['cat > dicke_wigner.py << \'EOF\'\nimport numpy as np\nfrom qutip import *\nimport csv\n\n# Parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0  # Spin frequency\nomega_c = 1.0  # Cavity frequency\ng = 2.0 / np.sqrt(N)  # Coupling strength\nkappa = 1.0  # Cavity loss rate\nn_max = 16  # Photon number cutoff\n\n# Wigner function grid\nx_vec = np.linspace(-6, 6, 1000)\np_vec = np.linspace(-6, 6, 1000)\n\n# Spin dimension (using collective spin basis for N spin-1/2)\n# Total spin j = N/2 = 2, dimension = 2j+1 = 5\nj = N / 2.0\ndim_spin = int(2 * j + 1)\n\n# Create operators\n# Cavity operators\na = tensor(destroy(n_max), qeye(dim_spin))\n\n# Collective spin operators using spin-j representation\nJz = tensor(qeye(n_max), jmat(j, \'z\'))\nJp = tensor(qeye(n_max), jmat(j, \'+\'))\nJm = tensor(qeye(n_max), jmat(j, \'-\'))\nJx = tensor(qeye(n_max), jmat(j, \'x\'))\n\n# Hamiltonian\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\ndef solve_and_save_wigner(case_num, c_ops):\n    """Solve for steady state and save Wigner function to CSV"""\n    print(f"Solving case {case_num}...")\n    \n    # Solve for steady state\n    rho_ss = steadystate(H, c_ops)\n    \n    # Trace out spin to get cavity state\n    # rho_ss is in tensor product space (cavity x spin)\n    # We need to trace over spin (second subsystem)\n    rho_cavity = ptrace(rho_ss, 0)\n    \n    # Calculate Wigner function\n    print(f"Calculating Wigner function for case {case_num}...")\n    W = wigner(rho_cavity, x_vec, p_vec)\n    \n    # Save to CSV\n    filename = f"{case_num}.csv"\n    print(f"Saving to {filename}...")\n    np.savetxt(filename, W, delimiter=\',\')\n    print(f"Case {case_num} complete!")\n\n# Common collapse operators\n# Cavity loss\nc_cavity = np.sqrt(kappa) * a\n\n# For local operators, we need to sum over individual spins\n# In collective spin basis, local dephasing: sum_i sigma_z^i -> proportional to Jz\n# Local emission: sum_i sigma_-^i -> proportional to Jm  \n# Local pumping: sum_i sigma_+^i -> proportional to Jp\n# But the rates scale differently. For N identical spins:\n# sum_i sigma_z^i = 2*Jz, and for local processes the effective rate is N times single-spin rate\n\n# Case 1: Local de-phasing & local pumping\n# gamma_phi = 0.01, gamma_up = 0.1\nprint("\\n=== Case 1: Local de-phasing & local pumping ===")\ngamma_phi_1 = 0.01\ngamma_up_1 = 0.1\nc_ops_1 = [\n    c_cavity,\n    np.sqrt(gamma_phi_1) * Jz,  # Dephasing (Jz is sum of sigma_z/2)\n    np.sqrt(gamma_up_1) * Jp    # Local pumping\n]\nsolve_and_save_wigner(1, c_ops_1)\n\n# Case 2: Local de-phasing & local emission\n# gamma_phi = 0.01, gamma_down = 0.1\nprint("\\n=== Case 2: Local de-phasing & local emission ===")\ngamma_phi_2 = 0.01\ngamma_down_2 = 0.1\nc_ops_2 = [\n    c_cavity,\n    np.sqrt(gamma_phi_2) * Jz,  # Dephasing\n    np.sqrt(gamma_down_2) * Jm  # Local emission\n]\nsolve_and_save_wigner(2, c_ops_2)\n\n# Case 3: Local de-phasing & local emission & collective pumping\n# gamma_phi = 0.01, gamma_down = 0.1, gamma_Up = 0.1\nprint("\\n=== Case 3: Local de-phasing & local emission & collective pumping ===")\ngamma_phi_3 = 0.01\ngamma_down_3 = 0.1\ngamma_Up_3 = 0.1\nc_ops_3 = [\n    c_cavity,\n    np.sqrt(gamma_phi_3) * Jz,   # Dephasing\n    np.sqrt(gamma_down_3) * Jm,  # Local emission\n    np.sqrt(gamma_Up_3) * Jp     # Collective pumping\n]\nsolve_and_save_wigner(3, c_ops_3)\n\n# Case 4: Local de-phasing & local emission & collective emission\n# gamma_phi = 0.01, gamma_down = 0.1, gamma_Down = 0.1\nprint("\\n=== Case 4: Local de-phasing & local emission & collective emission ===")\ngamma_phi_4 = 0.01\ngamma_down_4 = 0.1\ngamma_Down_4 = 0.1\nc_ops_4 = [\n    c_cavity,\n    np.sqrt(gamma_phi_4) * Jz,    # Dephasing\n    np.sqrt(gamma_down_4) * Jm,   # Local emission\n    np.sqrt(gamma_Down_4) * Jm    # Collective emission (same operator, different physical meaning)\n]\nsolve_and_save_wigner(4, c_ops_4)\n\nprint("\\nAll cases completed!")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
