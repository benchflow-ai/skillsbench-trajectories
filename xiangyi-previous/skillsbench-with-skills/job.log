Sending keys: ['cat > /app/solution.py << \'EOFPYTHON\'\nimport json\nimport re\nfrom typing import Dict, List, Set, Tuple, Any\nfrom collections import deque\n\ndef parse_script(text: str) -> Dict[str, Any]:\n    """\n    Parse a dialogue script into a structured graph with nodes and edges.\n    \n    Args:\n        text: The script content as a string\n        \n    Returns:\n        A dictionary with \'nodes\' and \'edges\' keys containing the parsed graph\n    """\n    nodes = []\n    edges = []\n    node_ids = set()\n    \n    # Split by scene headers [SceneName]\n    scene_pattern = r\'\\[([^\\]]+)\\]\'\n    parts = re.split(scene_pattern, text.strip())\n    \n    # Process alternating headers and content\n    i = 1\n    while i < len(parts):\n        scene_id = parts[i].strip()\n        scene_content = parts[i + 1].strip() if i + 1 < len(parts) else ""\n        i += 2\n        \n        if not scene_content:\n            continue\n        \n        lines = [l.strip() for l in scene_content.split(\'\\n\') if l.strip()]\n        \n        # Parse scene content\n        dialogue_line = None\n        dialogue_target = None\n        choices = []  # List of (choice_num, tag, text, target)\n        \n        for line in lines:\n            # Check for dialogue line (speaker: text -> target)\n            if \':\' in line and \'->\' in line and not choices:  # Dialogue comes before choices\n                match = re.match(r\'([^:]+):\\s*(.+?)\\s*->\\s*(.+)$\', line)\n                if match:\n                    speaker = match.group(1).strip()\n                    dialogue_line = match.group(2).strip()\n                    dialogue_target = match.group(3).strip()\n            \n            # Check for choice lines (numbered)\n            elif re.match(r\'^\\d+\\.\', line):\n                match = re.match(r\'^(\\d+)\\.\\s*(?:\\[([^\\]]+)\\]\\s*)?(.+?)\\s*->\\s*(.+)$\', line)\n                if match:\n                    choice_num = match.group(1)\n                    tag = match.group(2)  # Optional tag\n                    choice_text = match.group(3).strip()\n                    target = match.group(4).strip()\n                    choices.append((choice_num, tag, choice_text, target))\n        \n        # Create scene node\n        scene_node = {\n            "id": scene_id,\n            "text": dialogue_line if dialogue_line else "",\n            "speaker": "",\n            "type": "line"\n        }\n        nodes.append(scene_node)\n        node_ids.add(scene_id)\n        \n        # Handle dialogue line with target\n        if dialogue_line and dialogue_target:\n            if choices:\n                # If there are choices, connect dialogue to first choice instead\n                first_choice_id = f"{scene_id}_choice_{choices[0][0]}"\n                edge = {"from": scene_id, "to": first_choice_id, "text": ""}\n                edges.append(edge)\n            else:\n                # No choices, direct edge to target\n                edge = {"from": scene_id, "to": dialogue_target, "text": ""}\n                edges.append(edge)\n        elif choices:\n            # Scene has only choices, connect to first choice\n            first_choice_id = f"{scene_id}_choice_{choices[0][0]}"\n            edge = {"from": scene_id, "to": first_choice_id, "text": ""}\n            edges.append(edge)\n        \n        # Create choice nodes and edges\n        for choice_num, tag, choice_text, target in choices:\n            choice_id = f"{scene_id}_choice_{choice_num}"\n            \n            # Build full choice text\n            full_text = f"[{tag}] {choice_text}" if tag else choice_text\n            \n            # Create choice node\n            choice_node = {\n                "id": choice_id,\n                "text": full_text,\n                "speaker": "",\n                "type": "choice"\n            }\n            nodes.append(choice_node)\n            node_ids.add(choice_id)\n            \n            # Create edge from choice to target\n            choice_edge = {"from": choice_id, "to": target, "text": ""}\n            edges.append(choice_edge)\n    \n    # Ensure End node exists\n    if "End" not in node_ids:\n        nodes.append({\n            "id": "End",\n            "text": "The End",\n            "speaker": "Narrator",\n            "type": "line"\n        })\n        node_ids.add("End")\n    \n    return {\n        "nodes": nodes,\n        "edges": edges\n    }\n\n\ndef validate_graph(graph: Dict[str, Any]) -> Tuple[bool, List[str]]:\n    """\n    Validate the graph for reachability and edge integrity.\n    \n    Returns:\n        Tuple of (is_valid, list_of_errors)\n    """\n    errors = []\n    nodes = graph["nodes"]\n    edges = graph["edges"]\n    \n    node_ids = {n["id"] for n in nodes}\n    \n    # Check all edge targets exist (except End)\n    for edge in edges:\n        if edge["to"] not in node_ids and edge["to"] != "End":\n            errors.append(f"Edge target \'{edge[\'to\']}\' from \'{edge[\'from\']}\' does not exist")\n    \n    # Check reachability from Start\n    if "Start" not in node_ids:\n        errors.append("No \'Start\' node found")\n    else:\n        reachable = set()\n        queue = deque(["Start"])\n        reachable.add("Start")\n        \n        while queue:\n            current = queue.popleft()\n            for edge in edges:\n                if edge["from"] == current and edge["to"] not in reachable:\n                    reachable.add(edge["to"])\n                    if edge["to"] != "End":\n                        queue.append(edge["to"])\n        \n        unreachable = node_ids - reachable - {"End"}\n        for node_id in unreachable:\n            errors.append(f"Node \'{node_id}\' is not reachable from \'Start\'")\n    \n    return len(errors) == 0, errors\n\n\ndef generate_dot(graph: Dict[str, Any]) -> str:\n    """\n    Generate a Graphviz DOT representation of the dialogue graph.\n    \n    Args:\n        graph: The parsed dialogue graph\n        \n    Returns:\n        A string containing the DOT format representation\n    """\n    lines = ["digraph Dialogue {"]\n    lines.append("  rankdir=LR;")\n    lines.append("  node [shape=box, style=rounded];")\n    \n    nodes = graph["nodes"]\n    edges = graph["edges"]\n    \n    # Add nodes\n    for node in nodes:\n        node_id = node["id"].replace("-", "_").replace(" ", "_")\n        label = node["text"][:50]  # Truncate long text\n        if node["type"] == "choice":\n            lines.append(f\'  {node_id} [label="{label}", shape=diamond];\')\n        else:\n            lines.append(f\'  {node_id} [label="{label}"];\')\n    \n    # Add edges\n    for edge in edges:\n        from_id = edge["from"].replace("-", "_").replace(" ", "_")\n        to_id = edge["to"].replace("-", "_").replace(" ", "_")\n        lines.append(f\'  {from_id} -> {to_id};\')\n    \n    lines.append("}")\n    return "\\n".join(lines)\n\n\nif __name__ == "__main__":\n    with open(\'/app/script.txt\', \'r\') as f:\n        script_content = f.read()\n    \n    graph = parse_script(script_content)\n    \n    # Validate\n    is_valid, validation_errors = validate_graph(graph)\n    if validation_errors:\n        print("Validation warnings:")\n        for error in validation_errors[:10]:  # Show first 10 errors\n            print(f"  - {error}")\n        if len(validation_errors) > 10:\n            print(f"  ... and {len(validation_errors) - 10} more errors")\n    \n    # Save JSON\n    with open(\'/app/dialogue.json\', \'w\') as f:\n        json.dump(graph, f, indent=2)\n    \n    # Generate and save DOT\n    dot_content = generate_dot(graph)\n    with open(\'/app/dialogue.dot\', \'w\') as f:\n        f.write(dot_content)\n    \n    print(f"\\nParsed successfully!")\n    print(f"Total nodes: {len(graph[\'nodes\'])}")\n    print(f"Total edges: {len(graph[\'edges\'])}")\n    print(f"Graph valid: {is_valid}")\n    print(f"Files created: /app/dialogue.json, /app/dialogue.dot")\nEOFPYTHON\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
