Sending keys: ['cat << \'EOF\' > solution.py\nimport requests\nimport csv\nimport io\nimport pandas as pd\n\n# 1. Load station IDs\nwith open(\'/root/data/michigan_stations.txt\', \'r\') as f:\n    station_ids = [line.strip() for line in f if line.strip()]\n\n# 2. Download NWS thresholds\nnws_url = "https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv"\nresponse = requests.get(nws_url)\nnws_df = pd.read_csv(io.StringIO(response.text))\nnws_df[\'flood stage\'] = pd.to_numeric(nws_df[\'flood stage\'], errors=\'coerce\')\n\nthresholds = {}\nfor _, row in nws_df.iterrows():\n    usgs_id = str(row[\'usgs id\']).strip().zfill(8)\n    if usgs_id in station_ids:\n        if not pd.isna(row[\'flood stage\']) and row[\'flood stage\'] != -9999:\n            thresholds[usgs_id] = row[\'flood stage\']\n\n# 3. Fetch USGS data using multi-site request\nstart_date = \'2025-04-01\'\nend_date = \'2025-04-07\'\nsites_str = ",".join(station_ids)\n\nflood_results = {}\n\ndef process_data(url):\n    try:\n        r = requests.get(url, timeout=30)\n        if r.status_code != 200: return\n        data = r.json()\n        time_series = data.get(\'value\', {}).get(\'timeSeries\', [])\n        for ts in time_series:\n            usgs_id = ts[\'sourceInfo\'][\'siteCode\'][0][\'value\']\n            if usgs_id not in thresholds: continue\n            threshold = thresholds[usgs_id]\n            values = ts.get(\'values\', [{}])[0].get(\'value\', [])\n            \n            daily_max = {}\n            for entry in values:\n                date = entry[\'dateTime\'].split(\'T\')[0]\n                val = float(entry[\'value\'])\n                daily_max[date] = max(daily_max.get(date, -9999), val)\n            \n            flood_days = sum(1 for val in daily_max.values() if val >= threshold)\n            if flood_days > 0:\n                flood_results[usgs_id] = max(flood_results.get(usgs_id, 0), flood_days)\n    except Exception as e:\n        print(f"Error: {e}")\n\n# Try daily values first\nprint("Fetching Daily Values...")\nprocess_data(f"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={sites_str}&startDT={start_date}&endDT={end_date}&parameterCd=00065&statCd=00001")\n\n# Then try instantaneous values for any missing or to supplement\nprint("Fetching Instantaneous Values...")\nprocess_data(f"https://waterservices.usgs.gov/nwis/iv/?format=json&sites={sites_str}&startDT={start_date}&endDT={end_date}&parameterCd=00065")\n\n# 4. Save results\nwith open(\'/root/output/flood_results.csv\', \'w\', newline=\'\') as f:\n    writer = csv.writer(f)\n    writer.writerow([\'station_id\', \'flood_days\'])\n    for usgs_id, flood_days in flood_results.items():\n        writer.writerow([usgs_id, flood_days])\n\nprint(f"Done! Found {len(flood_results)} stations with flooding.")\nEOF\npython3 solution.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
