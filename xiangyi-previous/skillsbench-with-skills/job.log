ze picks by station\nall_picks = []\nfor pick in p_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split(\'.\')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'P\',\n            \'time\': pick.peak_time,\n            \'trace_id\': trace_id\n        })\n\nfor pick in s_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split(\'.\')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'S\',\n            \'time\': pick.peak_time,\n            \'trace_id\': trace_id\n        })\n\nprint(f"Total picks: {len(all_picks)}")\n\n# Group picks by station and phase\npicks_by_station = defaultdict(lambda: {\'P\': None, \'S\': None})\nfor pick in all_picks:\n    key = f"{pick[\'network\']}.{pick[\'station\']}"\n    picks_by_station[key][pick[\'phase\']] = pick[\'time\']\n\nprint(f"Picks organized at {len(picks_by_station)} stations")\n\n# Calculate P-S times for each station\nps_times = {}\nfor station, phases in picks_by_station.items():\n    if phases[\'P\'] and phases[\'S\']:\n        ps_time = (phases[\'S\'] - phases[\'P\']).total_seconds()\n        ps_times[station] = {\n            \'p_time\': phases[\'P\'],\n            \'s_time\': phases[\'S\'],\n            \'ps_time\': ps_time\n        }\n\nprint(f"\\nStations with both P and S picks: {len(ps_times)}")\nprint("Sample P-S times:")\nfor i, (station, data) in enumerate(list(ps_times.items())[:5]):\n    print(f"  {station}: P-S = {data[\'ps_time\']:.2f}s")\n\nEOFPYTHON\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
