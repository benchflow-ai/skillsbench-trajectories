Sending keys: ['python3 << \'ENDSCRIPT\'\nimport pandas as pd\nimport numpy as np\n\n# Load and convert data\ndata = pd.read_csv(\'/root/environment/data/ckd_lab_data.csv\')\n\ndef convert_to_float(val):\n    if pd.isna(val) or val == \'\' or val == \'nan\':\n        return np.nan\n    val_str = str(val).strip()\n    val_str = val_str.replace(\',\', \'.\')\n    try:\n        return float(val_str)\n    except:\n        return np.nan\n\nfor col in data.columns[1:]:\n    data[col] = data[col].apply(convert_to_float)\n\ndata_clean = data.dropna().reset_index(drop=True)\n\nprint(f"Data shape after removing missing values: {data_clean.shape}")\n\n# Apply comprehensive unit conversions\nprint("\\nApplying unit conversions...")\n\n# Serum_Creatinine: if > 1.5, divide by 88.4 (µmol/L to mg/dL)\nmask = data_clean[\'Serum_Creatinine\'] > 1.5\ndata_clean.loc[mask, \'Serum_Creatinine\'] = data_clean.loc[mask, \'Serum_Creatinine\'] / 88.4\n\n# BUN: if > 25, divide by 2.8 (mmol/L to mg/dL)\nmask = data_clean[\'BUN\'] > 25\ndata_clean.loc[mask, \'BUN\'] = data_clean.loc[mask, \'BUN\'] / 2.8\n\n# Magnesium: if > 3, divide by 2.43 (mmol/L to mg/dL)\nmask = data_clean[\'Magnesium\'] > 3\ndata_clean.loc[mask, \'Magnesium\'] = data_clean.loc[mask, \'Magnesium\'] / 2.43\n\n# Serum_Calcium: if > 15, divide by 4.0 (mmol/L to mg/dL)\nmask = data_clean[\'Serum_Calcium\'] > 15\ndata_clean.loc[mask, \'Serum_Calcium\'] = data_clean.loc[mask, \'Serum_Calcium\'] / 4.0\n\n# Phosphorus: if > 6, divide by 3.1 (mmol/L to mg/dL)\nmask = data_clean[\'Phosphorus\'] > 6\ndata_clean.loc[mask, \'Phosphorus\'] = data_clean.loc[mask, \'Phosphorus\'] / 3.1\n\n# Albumin_Serum: if > 8, divide by 10 (g/L to g/dL)\nmask = data_clean[\'Albumin_Serum\'] > 8\ndata_clean.loc[mask, \'Albumin_Serum\'] = data_clean.loc[mask, \'Albumin_Serum\'] / 10\n\n# Total_Protein: if > 10, divide by 10 (g/L to g/dL)\nmask = data_clean[\'Total_Protein\'] > 10\ndata_clean.loc[mask, \'Total_Protein\'] = data_clean.loc[mask, \'Total_Protein\'] / 10\n\n# Hemoglobin: if > 20, divide by 10 (g/L to g/dL)\nmask = data_clean[\'Hemoglobin\'] > 20\ndata_clean.loc[mask, \'Hemoglobin\'] = data_clean.loc[mask, \'Hemoglobin\'] / 10\n\n# Hemoglobin: if < 5, multiply by 10 (mmol/L to g/dL)\nmask = data_clean[\'Hemoglobin\'] < 5\ndata_clean.loc[mask, \'Hemoglobin\'] = data_clean.loc[mask, \'Hemoglobin\'] * 10\n\n# Hematocrit: if > 60, divide by 10\nmask = data_clean[\'Hematocrit\'] > 60\ndata_clean.loc[mask, \'Hematocrit\'] = data_clean.loc[mask, \'Hematocrit\'] / 10\n\n# Glucose: if > 1000, divide by 18 (µmol/L to mg/dL)\nmask = data_clean[\'Glucose\'] > 1000\ndata_clean.loc[mask, \'Glucose\'] = data_clean.loc[mask, \'Glucose\'] / 18\n\n# Uric_Acid: if > 15, divide by 59.48 (µmol/L to mg/dL)\nmask = data_clean[\'Uric_Acid\'] > 15\ndata_clean.loc[mask, \'Uric_Acid\'] = data_clean.loc[mask, \'Uric_Acid\'] / 59.48\n\n# Triglycerides: if > 1000, divide by 100 (mg/L to mg/dL)\nmask = data_clean[\'Triglycerides\'] > 1000\ndata_clean.loc[mask, \'Triglycerides\'] = data_clean.loc[mask, \'Triglycerides\'] / 100\n\n# Total_Cholesterol: if > 1000, divide by 100 (mg/L to mg/dL)\nmask = data_clean[\'Total_Cholesterol\'] > 1000\ndata_clean.loc[mask, \'Total_Cholesterol\'] = data_clean.loc[mask, \'Total_Cholesterol\'] / 100\n\n# LDL_Cholesterol: if > 1000, divide by 100 (mg/L to mg/dL)\nmask = data_clean[\'LDL_Cholesterol\'] > 1000\ndata_clean.loc[mask, \'LDL_Cholesterol\'] = data_clean.loc[mask, \'LDL_Cholesterol\'] / 100\n\n# HDL_Cholesterol: if > 1000, divide by 100 (mg/L to mg/dL)\nmask = data_clean[\'HDL_Cholesterol\'] > 1000\ndata_clean.loc[mask, \'HDL_Cholesterol\'] = data_clean.loc[mask, \'HDL_Cholesterol\'] / 100\n\n# Ferritin: if > 500, divide by 10 (might be in µg/L, convert to ng/mL)\nmask = data_clean[\'Ferritin\'] > 500\ndata_clean.loc[mask, \'Ferritin\'] = data_clean.loc[mask, \'Ferritin\'] / 10\n\n# Prealbumin: if > 50, divide by 10 (mg/L to mg/dL)\nmask = data_clean[\'Prealbumin\'] > 50\ndata_clean.loc[mask, \'Prealbumin\'] = data_clean.loc[mask, \'Prealbumin\'] / 10\n\n# Additional refinement passes for remaining out-of-range values\nprint("\\nApplying refinement conversions...")\n\n# Hemoglobin: if still < 5, multiply by 10 again\nmask = data_clean[\'Hemoglobin\'] < 5\nif mask.any():\n    data_clean.loc[mask, \'Hemoglobin\'] = data_clean.loc[mask, \'Hemoglobin\'] * 10\n    print(f"Hemoglobin refinement (<5): {mask.sum()} converted")\n\n# Ferritin: if still > 300, divide by 10 again\nmask = data_clean[\'Ferritin\'] > 300\nif mask.any():\n    data_clean.loc[mask, \'Ferritin\'] = data_clean.loc[mask, \'Ferritin\'] / 10\n    print(f"Ferritin refinement (>300): {mask.sum()} converted")\n\n# BUN: if still > 25, divide by 2.8 again\nmask = data_clean[\'BUN\'] > 25\nif mask.any():\n    data_clean.loc[mask, \'BUN\'] = data_clean.loc[mask, \'BUN\'] / 2.8\n    print(f"BUN refinement (>25): {mask.sum()} converted")\n\n# Magnesium: if still > 2.5, divide by 2.43 again\nmask = data_clean[\'Magnesium\'] > 2.5\nif mask.any():\n    data_clean.loc[mask, \'Magnesium\'] = data_clean.loc[mask, \'Magnesium\'] / 2.43\n    print(f"Magnesium refinement (>2.5): {mask.sum()} converted")\n\n# Round all values to 2 decimal places\nprint("\\nRounding all values to 2 decimal places...")\nfor col in data_clean.columns[1:]:\n    data_clean[col] = data_clean[col].round(2)\n\n# Format as X.XX\nfor col in data_clean.columns[1:]:\n    data_clean[col] = data_clean[col].apply(lambda x: f"{x:.2f}")\n\nprint(f"\\nFinal data shape: {data_clean.shape}")\nprint(f"\\nSample of final data:")\nprint(data_clean[[\'patient_id\', \'Serum_Creatinine\', \'Hemoglobin\', \'Ferritin\', \'BUN\']].head(10))\n\n# Save to output file\noutput_path = \'/root/ckd_lab_data_harmonized.csv\'\ndata_clean.to_csv(output_path, index=False)\nprint(f"\\nData saved to {output_path}")\n\n# Verify output\nprint(f"\\nVerifying output...")\noutput_data = pd.read_csv(output_path)\nprint(f"Output shape: {output_data.shape}")\nprint(f"Output columns: {output_data.shape[1]}")\nprint(f"First few rows:")\nprint(output_data.head(3))\n\nENDSCRIPT\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
