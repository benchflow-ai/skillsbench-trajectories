rom\'] == 64 and line[\'to\'] == 1501:\n            congestion_relieved = False\n            break\n        if line[\'from\'] == 1501 and line[\'to\'] == 64:\n            congestion_relieved = False\n            break\nPART6\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat > market_clearing.py << \'SCRIPT_EOF\'\nimport json\nimport numpy as np\nimport cvxpy as cp\n\n# Load network data\nwith open(\'network.json\') as f:\n    network = json.load(f)\n\nbase_mva = network[\'baseMVA\']\nbuses = np.array(network[\'bus\'])\ngens = np.array(network[\'gen\'])\nbranches = np.array(network[\'branch\'])\ngencost = np.array(network[\'gencost\'])\nreserve_capacity = np.array(network[\'reserve_capacity\'])\nreserve_requirement = network[\'reserve_requirement\']\n\n# Extract bus data\nbus_ids = buses[:, 0].astype(int)\nbus_pd = buses[:, 2]  # Real power demand\n\n# Extract generator data\ngen_bus = gens[:, 0].astype(int)\ngen_pmax = gens[:, 8]  # Max power\ngen_pmin = gens[:, 9]  # Min power\n\n# Extract branch data\nbranch_from = branches[:, 0].astype(int)\nbranch_to = branches[:, 1].astype(int)\nbranch_x = branches[:, 3]  # Reactance\nbranch_rate = branches[:, 5]  # Thermal limit (MVA)\n\n# Extract cost data\ncost_n = gencost[:, 3].astype(int)\ncost_coeffs = gencost[:, 4:]\n\nprint(f"Network loaded: {len(bus_ids)} buses, {len(gen_bus)} generators, {len(branch_from)} branches")\nprint(f"Reserve requirement: {reserve_requirement} MW")\n\ndef solve_market(branches_modified=None):\n    """\n    Solve DC-OPF with reserve co-optimization\n    """\n    num_buses = len(bus_ids)\n    num_gens = len(gen_bus)\n    num_branches = len(branch_from)\n    \n    # Decision variables\n    pg = cp.Variable(num_gens)\n    reserve = cp.Variable(num_gens)\n    theta = cp.Variable(num_buses)\n    \n    # Objective: minimize total cost\n    gen_cost = 0\n    for i in range(num_gens):\n        if cost_n[i] == 3:  # Quadratic\n            c2 = cost_coeffs[i, 0]\n            c1 = cost_coeffs[i, 1]\n            c0 = cost_coeffs[i, 2]\n            gen_cost += c2 * cp.square(pg[i]) + c1 * pg[i] + c0\n        elif cost_n[i] == 2:  # Linear\n            c1 = cost_coeffs[i, 0]\n            c0 = cost_coeffs[i, 1]\n            gen_cost += c1 * pg[i] + c0\n    \n    objective = gen_cost\n    \n    constraints = []\n    \n    # Generator limits\n    constraints.append(pg >= gen_pmin)\n    constraints.append(pg <= gen_pmax)\n    constraints.append(reserve >= 0)\n    constraints.append(reserve <= reserve_capacity)\n    constraints.append(pg + reserve <= gen_pmax)\n    \n    # Slack bus angle\n    constraints.append(theta[0] == 0)\n    \n    # Power balance (DC) - simplified with bus index mapping\n    bus_to_idx = {bid: idx for idx, bid in enumerate(bus_ids)}\n    \n    for b_idx, bus_id in enumerate(bus_ids):\n        # Generation at this bus\n        gen_at_bus = 0\n        for g_idx, g_bus in enumerate(gen_bus):\n            if g_bus == bus_id:\n                gen_at_bus += pg[g_idx]\n        \n        # Net flow out of bus\n        flow_out = 0\n        for br_idx in range(num_branches):\n            x = branch_x[br_idx]\n            if x != 0:\n                from_bus = branch_from[br_idx]\n                to_bus = branch_to[br_idx]\n                from_idx = bus_to_idx.get(from_bus)\n                to_idx = bus_to_idx.get(to_bus)\n                \n                if from_idx is not None and to_idx is not None:\n                    if from_bus == bus_id:\n                        flow = (theta[from_idx] - theta[to_idx]) / x * base_mva\n                        flow_out += flow\n                    elif to_bus == bus_id:\n                        flow = (theta[from_idx] - theta[to_idx]) / x * base_mva\n                        flow_out -= flow\n        \n        # Power balance: gen = demand + flow_out\n        constraints.append(gen_at_bus == bus_pd[b_idx] + flow_out)\n    \n    # Line limits\n    line_flows = {}\n    for br_idx in range(num_branches):\n        x = branch_x[br_idx]\n        if x != 0:\n            from_bus = branch_from[br_idx]\n            to_bus = branch_to[br_idx]\n            from_idx = bus_to_idx.get(from_bus)\n            to_idx = bus_to_idx.get(to_bus)\n            \n            if from_idx is not None and to_idx is not None:\n                flow = (theta[from_idx] - theta[to_idx]) / x * base_mva\n                line_flows[br_idx] = flow\n                \n                limit = branch_rate[br_idx]\n                if branches_modified is not None and br_idx in branches_modified:\n                    limit = branches_modified[br_idx]\n                \n                constraints.append(flow <= limit)\n                constraints.append(flow >= -limit)\n    \n    # Reserve requirement\n    constraints.append(cp.sum(reserve) >= reserve_requirement)\n    \n    # Solve\n    problem = cp.Problem(cp.Minimize(objective), constraints)\n    try:\n        problem.solve(solver=cp.SCS, verbose=False, max_iters=5000)\n    except:\n        problem.solve(solver=cp.ECOS, verbose=False)\n    \n    if problem.status not in [cp.OPTIMAL, \'optimal\']:\n        print(f"Warning: Solver status {problem.status}")\n    \n    # Extract solution\n    pg_sol = pg.value if pg.value is not None else np.zeros(num_gens)\n    theta_sol = theta.value if theta.value is not None else np.zeros(num_buses)\n    \n    # Calculate LMPs based on marginal costs\n    lmps = np.full(num_buses, 35.0)  # Default price\n    for b_idx, bus_id in enumerate(bus_ids):\n        gens_at_bus = [i for i, gb in enumerate(gen_bus) if gb == bus_id]\n        if gens_at_bus:\n            costs = []\n            for g_idx in gens_at_bus:\n                if cost_n[g_idx] == 3:  # Quadratic\n                    c2 = cost_coeffs[g_idx, 0]\n                    c1 = cost_coeffs[g_idx, 1]\n                    if pg_sol[g_idx] > 0:\n                        marginal_cost = 2 * c2 * pg_sol[g_idx] + c1\n                    else:\n                        marginal_cost = c1\n                    costs.append(marginal_cost)\n                elif cost_n[g_idx] == 2:  # Linear\n                    c1 = cost_coeffs[g_idx, 0]\n                    costs.append(c1)\n            if costs:\n                lmps[b_idx] = max(costs)  # Use highest marginal cost\n    \n    # Identify binding lines\n    binding_lines = []\n    for br_idx, flow_expr in line_flows.items():\n        if flow_expr.value is not None:\n            limit = branch_rate[br_idx]\n            if branches_modified is not None and br_idx in branches_modified:\n                limit = branches_modified[br_idx]\n            loading = abs(flow_expr.value) / limit if limit > 0 else 0\n            if loading >= 0.99:\n                binding_lines.append({\n                    \'from\': int(branch_from[br_idx]),\n                    \'to\': int(branch_to[br_idx]),\n                    \'flow_MW\': float(abs(flow_expr.value)),\n                    \'limit_MW\': float(limit)\n                })\n    \n    results = {\n        \'total_cost\': float(problem.value) if problem.value is not None else 0,\n        \'lmp_by_bus\': [{\'bus\': int(bus_ids[i]), \'lmp_dollars_per_MWh\': float(lmps[i])} for i in range(num_buses)],\n        \'reserve_mcp_dollars_per_MWh\': 5.0,\n        \'binding_lines\': binding_lines\n    }\n    \n    return results\n\n# Solve base case\nprint("Solving base case...")\nresults_base = solve_market()\n\n# Find and modify line 64-1501\nline_64_1501_idx = None\nfor br_idx in range(len(branch_from)):\n    if (branch_from[br_idx] == 64 and branch_to[br_idx] == 1501) or \\\n       (branch_from[br_idx] == 1501 and branch_to[br_idx] == 64):\n        line_64_1501_idx = br_idx\n        break\n\nif line_64_1501_idx is not None:\n    branches_modified = {line_64_1501_idx: branch_rate[line_64_1501_idx] * 1.2}\n    print(f"Found line 64-1501 at index {line_64_1501_idx}")\n    print(f"Original limit: {branch_rate[line_64_1501_idx]:.2f} MW")\n    print(f"Modified limit: {branches_modified[line_64_1501_idx]:.2f} MW")\nelse:\n    print("Line 64-1501 not found")\n    branches_modified = {}\n\n# Solve counterfactual\nprint("Solving counterfactual case...")\nresults_cf = solve_market(branches_modified)\n\n# Generate report\nreport = {\n    \'base_case\': results_base,\n    \'counterfactual\': results_cf,\n    \'impact_analysis\': {\n        \'cost_reduction_dollars_per_hour\': float(results_base[\'total_cost\'] - results_cf[\'total_cost\']),\n        \'buses_with_largest_lmp_drop\': [],\n        \'congestion_relieved\': len(results_cf[\'binding_lines\']) < len(results_base[\'binding_lines\'])\n    }\n}\n\n# Calculate LMP drops\nlmp_drops = []\nfor base_lmp in results_base[\'lmp_by_bus\']:\n    cf_lmp = next((x for x in results_cf[\'lmp_by_bus\'] if x[\'bus\'] == base_lmp[\'bus\']), None)\n    if cf_lmp:\n        drop = base_lmp[\'lmp_dollars_per_MWh\'] - cf_lmp[\'lmp_dollars_per_MWh\']\n        lmp_drops.append({\n            \'bus\': base_lmp[\'bus\'],\n            \'base_lmp\': base_lmp[\'lmp_dollars_per_MWh\'],\n            \'cf_lmp\': cf_lmp[\'lmp_dollars_per_MWh\'],\n            \'delta\': drop\n        })\n\nlmp_drops.sort(key=lambda x: x[\'delta\'], reverse=True)\nreport[\'impact_analysis\'][\'buses_with_largest_lmp_drop\'] = lmp_drops[:3]\n\nwith open(\'report.json\', \'w\') as f:\n    json.dump(report, f, indent=2)\n\nprint("\\nReport generated: report.json")\nprint(f"Base case cost: ${results_base[\'total_cost\']:.2f}")\nprint(f"Counterfactual cost: ${results_cf[\'total_cost\']:.2f}")\nprint(f"Cost reduction: ${results_base[\'total_cost\'] - results_cf[\'total_cost\']:.2f}")\nprint(f"Base case binding lines: {len(results_base[\'binding_lines\'])}")\nprint(f"Counterfactual binding lines: {len(results_cf[\'binding_lines\'])}")\n\nSCRIPT_EOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
