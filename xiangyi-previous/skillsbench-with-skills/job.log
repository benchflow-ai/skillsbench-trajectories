 crs=\'EPSG:4326\').to_crs(proj_crs)\n    l_gdf = gpd.GeoSeries([lines], crs=\'EPSG:4326\').to_crs(proj_crs)\n    return p_gdf.distance(l_gdf).iloc[0] / 1000.0\n\npacific_quakes[\'distance_km\'] = pacific_quakes.geometry.apply(lambda p: get_min_distance(p, boundary_lines))\n\n# Find the one with max distance\nfurthest_quake = pacific_quakes.loc[pacific_quakes[\'distance_km\'].idxmax()]\n\n# Prepare output\nresult = {\n    "id": furthest_quake[\'id\'],\n    "place": furthest_quake[\'place\'],\n    "time": pd.to_datetime(furthest_quake[\'time\'], unit=\'ms\').strftime(\'%Y-%m-%dT%H:%M:%SZ\'),\n    "magnitude": float(furthest_quake[\'mag\']),\n    "latitude": float(furthest_quake.geometry.y),\n    "longitude": float(furthest_quake.geometry.x),\n    "distance_km": round(float(furthest_quake[\'distance_km\']), 2)\n}\n\nwith open(\'/root/answer.json\', \'w\') as f:\n    json.dump(result, f, indent=2)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
