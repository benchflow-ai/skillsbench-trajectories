None\n    \n    # Regex for time ranges\n    # This is a bit complex, let\'s look for two times in close proximity or "between X and Y"\n    times = []\n    # Regex to find times like 10:00am, 2pm, etc.\n    time_pattern = r\'(\\d{1,2}(?::\\d{2})?\\s*(?:am|pm|AM|PM))\'\n    found_times = list(re.finditer(time_pattern, email_text))\n    \n    if len(found_times) >= 2:\n        # Assume the first two found in a "between ... and ..." or "from ... to ..." context are the range\n        # We can parse these strings into time objects\n        t1_str = found_times[0].group(1)\n        t2_str = found_times[1].group(1)\n        t1 = dateparser.parse(t1_str).time()\n        t2 = dateparser.parse(t2_str).time()\n        start_time_pref = t1\n        end_time_pref = t2\n    \n    return {\n        \'duration_hours\': duration,\n        \'dates\': sorted(list(set(parsed_dates))),\n        \'start_time_pref\': start_time_pref,\n        \'end_time_pref\': end_time_pref\n    }\n\ndef check_calendar(service, date_obj, duration_hours, start_pref, end_pref):\n    # Define the search window for the day\n    # If prefs are given, use them. Else use 9am-5pm work hours?\n    # Prompt says "I can be available: ... Time: {time_range}"\n    # And "select the earliest time slots if multiple time slots can work"\n    \n    day_start = datetime.datetime.combine(date_obj, datetime.time(9, 0)) # Default 9am\n    day_end = datetime.datetime.combine(date_obj, datetime.time(17, 0)) # Default 5pm\n    \n    if start_pref:\n        day_start = datetime.datetime.combine(date_obj, start_pref)\n    if end_pref:\n        day_end = datetime.datetime.combine(date_obj, end_pref)\n        \n    # Get events for this day\n    time_min = day_start.isoformat() + \'Z\'\n    time_max = day_end.isoformat() + \'Z\'\n    \n    events_result = service.events().list(calendarId=\'primary\', timeMin=time_min,\n                                          timeMax=time_max, singleEvents=True,\n                                