esponse.text}")\n        exit(1)\n\nwith open("/root/audiobook.mp3", "wb") as f:\n    for part in audio_parts:\n        f.write(part)\n\nprint("Audiobook saved to /root/audiobook.mp3")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
