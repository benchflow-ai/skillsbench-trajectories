Sending keys: ['cat << \'EOF\' > solve_dispatch.py\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize, LinearConstraint, Bounds\nfrom scipy.sparse import coo_matrix, csr_matrix, vstack, eye\nimport time\n\ndef solve():\n    print("Loading data...")\n    with open(\'network.json\') as f:\n        data = json.load(f)\n\n    # Extract data\n    bus = np.array(data[\'bus\'])\n    gen = np.array(data[\'gen\'])\n    branch = np.array(data[\'branch\'])\n    gencost = np.array(data[\'gencost\'])\n    reserve_cap = np.array(data[\'reserve_capacity\'])\n    reserve_req = data[\'reserve_requirement\']\n    baseMVA = data[\'baseMVA\']\n\n    # Dimensions\n    nb = bus.shape[0]\n    ng = gen.shape[0]\n    nl = branch.shape[0]\n\n    # Column indices\n    BUS_I, BUS_TYPE, PD, QD, GS, BS, BUS_AREA, VM, VA, BASE_KV, ZONE, VMAX, VMIN = range(13)\n    GEN_BUS, PG, QG, QMAX, QMIN, VG, MBASE, GEN_STATUS, PMAX, PMIN = range(10)\n    F_BUS, T_BUS, BR_R, BR_X, BR_B, RATE_A, RATE_B, RATE_C, TAP, SHIFT, BR_STATUS, ANGMIN, ANGMAX = range(13)\n    MODEL, STARTUP, SHUTDOWN, NCOST, COST0, COST1, COST2 = range(7) # Assuming NCOST=3 quadratic\n\n    # Mappings\n    bus_id_to_idx = {int(b_id): i for i, b_id in enumerate(bus[:, BUS_I])}\n    ref_bus_idx = np.where(bus[:, BUS_TYPE] == 3)[0][0]\n\n    # Build B matrices\n    print("Building matrices...")\n    stat = branch[:, BR_STATUS].astype(bool)\n    f = np.array([bus_id_to_idx[int(x)] for x in branch[stat, F_BUS]])\n    t = np.array([bus_id_to_idx[int(x)] for x in branch[stat, T_BUS]])\n    x = branch[stat, BR_X]\n    b = 1.0 / x\n    # Tap ratio (ignore phase shift for simple DC)\n    tap = branch[stat, TAP]\n    tap[tap == 0] = 1.0\n    b = b / tap # Approximation\n\n    # Branch admittance matrix (Flow = B_branch * theta)\n    # Flow_ij = (theta_i - theta_j) / x_ij\n    # We need to map this to sparse matrix\n    # Rows: active branches, Cols: buses\n    nl_active = np.sum(stat)\n    \n    # B_branch construction\n    # Flow = b * (theta_f - theta_t)\n    vals = np.concatenate([b, -b])\n    rows = np.concatenate([np.arange(nl_active), np.arange(nl_active)])\n    cols = np.concatenate([f, t])\n    B_branch = coo_matrix((vals, (rows, cols)), shape=(nl_active, nb))\n\n    # B_bus construction\n    # P_inj = B_bus * theta\n    # B_bus_ii = sum(b_ik)\n    # B_bus_ij = -b_ij\n    \n    # Off-diagonals\n    Y_off = -b\n    # Diagonals\n    Y_diag_f = b\n    Y_diag_t = b\n    \n    # Aggregate for B_bus\n    # contributions from each branch to f and t\n    # (f, f) += b, (t, t) += b, (f, t) -= b, (t, f) -= b\n    b_bus_rows = np.concatenate([f, t, f, t])\n    b_bus_cols = np.concatenate([f, t, t, f])\n    b_bus_vals = np.concatenate([b, b, -b, -b])\n    B_bus = coo_matrix((b_bus_vals, (b_bus_rows, b_bus_cols)), shape=(nb, nb))\n\n    # Optimization Variables: [Pg (ng), Rg (ng), Theta (nb)]\n    # Total size = 2*ng + nb\n    n_vars = 2 * ng + nb\n    \n    # Indices\n    idx_pg = slice(0, ng)\n    idx_rg = slice(ng, 2*ng)\n    idx_th = slice(2*ng, n_vars)\n\n    # 1. Objective Function\n    # Minimize Sum(Cost(Pg))\n    # Cost is c2*P^2 + c1*P + c0\n    # gencost cols: MODEL, STARTUP, SHUTDOWN, NCOST, c2, c1, c0\n    # Note: gencost coefficients are [c2, c1, c0] if NCOST=3\n    # We need to check NCOST. Assuming 3 for quadratic.\n    \n    c2 = np.zeros(ng)\n    c1 = np.zeros(ng)\n    c0 = np.zeros(ng)\n    \n    for i in range(ng):\n        gc = gencost[i]\n        if gc[MODEL] == 2: # Polynomial\n            nc = int(gc[NCOST])\n            if nc == 3:\n                c2[i] = gc[4]\n                c1[i] = gc[5]\n                c0[i] = gc[6]\n            elif nc == 2:\n                c1[i] = gc[4]\n                c0[i] = gc[5]\n    \n    def objective(x):\n        pg = x[idx_pg]\n        return np.sum(c2 * pg**2 + c1 * pg + c0)\n\n    def jacobian(x):\n        pg = x[idx_pg]\n        grad = np.zeros(n_vars)\n        grad[idx_pg] = 2 * c2 * pg + c1\n        return grad\n\n    # 2. Constraints\n    constraints = []\n\n    # A. Equality: Power Balance\n    # P_gen - P_load = B_bus * theta\n    # sum(Pg_at_bus_i) - Pd_i = (B_bus * theta)_i\n    # Rearrange: sum(Pg) - B_bus * theta = Pd\n    \n    # Map gens to buses\n    C_g = coo_matrix((np.ones(ng), (gen[:, GEN_BUS].astype(int)-1, np.arange(ng))), shape=(nb, ng))\n    # Note: gen bus is 1-indexed in file, convert to 0-indexed using map\n    # Wait, simple subtraction might be wrong if bus numbering is non-consecutive.\n    # Use bus_id_to_idx mapping.\n    gen_bus_indices = [bus_id_to_idx[int(b_id)] for b_id in gen[:, GEN_BUS]]\n    C_g = coo_matrix((np.ones(ng), (gen_bus_indices, np.arange(ng))), shape=(nb, ng))\n\n    # Construct A_eq for: [Pg, Rg, Th]\n    # [C_g, 0, -B_bus] * x = Pd\n    \n    # Pd vector\n    Pd = bus[:, PD]\n    \n    # Combine matrices\n    # C_g is (nb, ng)\n    # Zero block is (nb, ng)\n    # -B_bus is (nb, nb)\n    \n    # A_eq = hstack([C_g, csr_matrix((nb, ng)), -B_bus]) # This is dense in hstack if not careful\n    # Build manually using coo/csr\n    \n    # We need to use LinearConstraint\n    # A_eq needs to be (nb, n_vars)\n    \n    # Parts:\n    # 1. Pg part: C_g\n    # 2. Rg part: Zeros\n    # 3. Theta part: -B_bus\n    \n    # Stack these\n    from scipy.sparse import hstack\n    A_eq = hstack([C_g, csr_matrix((nb, ng)), -B_bus])\n    \n    constraints.append(LinearConstraint(A_eq, Pd, Pd))\n\n    # B. Inequality: Reserve Req\n    # sum(Rg) >= Req\n    # [0, 1...1, 0] * x >= Req\n    A_res = np.zeros(n_vars)\n    A_res[idx_rg] = 1.0\n    constraints.append(LinearConstraint(A_res.reshape(1, -1), [reserve_req], [np.inf]))\n\n    # C. Inequality: Gen Capacity Coupling\n    # Pg + Rg <= Pmax\n    # [I, I, 0] * x <= Pmax\n    # I is identity (ng, ng)\n    I_ng = eye(ng)\n    A_cap = hstack([I_ng, I_ng, csr_matrix((ng, nb))])\n    constraints.append(LinearConstraint(A_cap, -np.inf, gen[:, PMAX]))\n\n    # D. Inequality: Line Flow Limits\n    # -Limit <= B_branch * theta <= Limit\n    # [0, 0, B_branch] * x\n    A_flow = hstack([csr_matrix((nl_active, 2*ng)), B_branch])\n    limits = branch[stat, RATE_A]\n    # Handle limits=0 (unlimited)\n    limits[limits == 0] = 1e6 # Large number\n    constraints.append(LinearConstraint(A_flow, -limits, limits))\n\n    # E. Equality: Reference Bus Angle = 0\n    # [0, 0, ... 1 ... ] * x = 0\n    A_ref = np.zeros(n_vars)\n    A_ref[2*ng + ref_bus_idx] = 1.0\n    constraints.append(LinearConstraint(A_ref.reshape(1, -1), [0], [0]))\n\n    # 3. Bounds\n    # Pg: [Pmin, Pmax]\n    # Rg: [0, ReserveCap]\n    # Theta: [-inf, inf]\n    \n    lb = np.concatenate([gen[:, PMIN], np.zeros(ng), np.full(nb, -np.inf)])\n    ub = np.concatenate([gen[:, PMAX], reserve_cap, np.full(nb, np.inf)])\n    bounds = Bounds(lb, ub)\n\n    # Initial guess\n    x0 = np.zeros(n_vars)\n    x0[idx_pg] = (gen[:, PMIN] + gen[:, PMAX]) / 2\n    x0[idx_rg] = reserve_req / ng\n\n    print(f"Solving optimization with {n_vars} variables...")\n    res = minimize(objective, x0, jac=jacobian, bounds=bounds, constraints=constraints, method=\'SLSQP\', options={\'disp\': True, \'maxiter\': 200})\n\n    print("Optimization finished. Success:", res.success)\n    print("Message:", res.message)\n\n    # Extract results\n    pg_res = res.x[idx_pg]\n    rg_res = res.x[idx_rg]\n    theta_res = res.x[idx_th]\n\n    # Calculate outputs\n    total_cost = objective(res.x)\n    total_load = np.sum(bus[:, PD])\n    total_gen = np.sum(pg_res)\n    total_reserve = np.sum(rg_res)\n    \n    # Line flows\n    flows = B_branch.dot(theta_res)\n    loadings = np.abs(flows) / limits * 100\n    \n    # Top 3 loaded lines\n    # Map back to original indices\n    active_indices = np.where(stat)[0]\n    sorted_idx = np.argsort(loadings)[::-1]\n    \n    top_lines = []\n    for i in range(min(3, len(sorted_idx))):\n        idx = sorted_idx[i]\n        orig_idx = active_indices[idx]\n        top_lines.append({\n            "from": int(branch[orig_idx, F_BUS]),\n            "to": int(branch[orig_idx, T_BUS]),\n            "loading_pct": float(round(loadings[idx], 2))\n        })\n\n    # Operating Margin\n    # Uncommitted capacity = sum(Pmax - Pg - Rg)\n    # But only for ON generators? Usually margin is system wide.\n    # Assuming all gens in list are available or checking status.\n    # Using gen status\n    status = gen[:, GEN_STATUS] > 0\n    margin = np.sum(gen[status, PMAX] - pg_res[status] - rg_res[status])\n\n    # Generator Dispatch List\n    gen_dispatch = []\n    for i in range(ng):\n        gen_dispatch.append({\n            "id": i+1,\n            "bus": int(gen[i, GEN_BUS]),\n            "output_MW": float(round(pg_res[i], 2)),\n            "reserve_MW": float(round(rg_res[i], 2)),\n            "pmax_MW": float(gen[i, PMAX])\n        })\n\n    report = {\n        "generator_dispatch": gen_dispatch,\n        "totals": {\n            "cost_dollars_per_hour": float(round(total_cost, 2)),\n            "load_MW": float(round(total_load, 2)),\n            "generation_MW": float(round(total_gen, 2)),\n            "reserve_MW": float(round(total_reserve, 2))\n        },\n        "most_loaded_lines": top_lines,\n        "operating_margin_MW": float(round(margin, 2))\n    }\n\n    with open(\'report.json\', \'w\') as f:\n        json.dump(report, f, indent=2)\n    print("Report generated.")\n\nif __name__ == "__main__":\n    solve()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
