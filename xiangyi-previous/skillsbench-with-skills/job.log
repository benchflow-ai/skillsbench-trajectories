Sending keys: ['cat > /root/analyze_video.py << \'EOF\'\nimport cv2\nimport numpy as np\nfrom scipy import sparse\nimport json\nfrom collections import defaultdict\n\ndef get_video_frames(video_path, fps=6):\n    """Extract frames from video at specified fps"""\n    cap = cv2.VideoCapture(video_path)\n    video_fps = cap.get(cv2.CAP_PROP_FPS)\n    total_frames = int(cap.get(cv2.CAP_PROP_FRAME_COUNT))\n    \n    frame_interval = int(video_fps / fps) if video_fps > 0 else 1\n    frames = []\n    frame_indices = []\n    \n    frame_count = 0\n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n        if frame_count % frame_interval == 0:\n            frames.append(cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY))\n            frame_indices.append(frame_count)\n        frame_count += 1\n    \n    cap.release()\n    return frames, frame_indices\n\ndef compute_optical_flow(prev_frame, curr_frame):\n    """Compute optical flow between frames"""\n    flow = cv2.calcOpticalFlowFarneback(\n        prev_frame, curr_frame, None, 0.5, 3, 15, 3, 5, 1.2, 0\n    )\n    return flow\n\ndef classify_motion(flow):\n    """Classify camera motion from optical flow"""\n    h, w = flow.shape[:2]\n    fx = flow[..., 0]\n    fy = flow[..., 1]\n    \n    # Compute statistics\n    mean_x = np.mean(fx)\n    mean_y = np.mean(fy)\n    std_x = np.std(fx)\n    std_y = np.std(fy)\n    \n    # Check for dominant motion direction\n    abs_mean_x = abs(mean_x)\n    abs_mean_y = abs(mean_y)\n    \n    # Threshold for motion detection\n    motion_threshold = 0.5\n    \n    if abs_mean_x < motion_threshold and abs_mean_y < motion_threshold:\n        return "Stay"\n    \n    # Pan (horizontal camera motion)\n    if abs_mean_x > abs_mean_y:\n        if mean_x > 0:\n            return "Pan Right"\n        else:\n            return "Pan Left"\n    # Tilt (vertical camera motion)\n    elif abs_mean_y > abs_mean_x:\n        if mean_y > 0:\n            return "Tilt Down"\n        else:\n            return "Tilt Up"\n    \n    return "Stay"\n\ndef detect_dynamic_objects(prev_frame, curr_frame, flow):\n    """Detect dynamic objects using frame difference and optical flow"""\n    h, w = prev_frame.shape\n    \n    # Compute frame difference\n    diff = cv2.absdiff(prev_frame, curr_frame)\n    \n    # Threshold to get binary mask\n    _, diff_mask = cv2.threshold(diff, 30, 1, cv2.THRESH_BINARY)\n    \n    # Warp previous frame using optical flow\n    x, y = np.meshgrid(np.arange(w), np.arange(h))\n    map_x = (x + flow[..., 0]).astype(np.float32)\n    map_y = (y + flow[..., 1]).astype(np.float32)\n    \n    warped = cv2.remap(prev_frame, map_x, map_y, cv2.INTER_LINEAR)\n    \n    # Dynamic objects are where warped frame doesn\'t match current frame\n    dynamic_diff = cv2.absdiff(warped, curr_frame)\n    _, dynamic_mask = cv2.threshold(dynamic_diff, 20, 1, cv2.THRESH_BINARY)\n    \n    # Combine masks\n    combined_mask = np.logical_or(diff_mask, dynamic_mask).astype(np.uint8)\n    \n    # Morphological operations to clean up\n    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))\n    combined_mask = cv2.morphologyEx(combined_mask, cv2.MORPH_OPEN, kernel)\n    \n    return combined_mask\n\ndef mask_to_csr(mask):\n    """Convert binary mask to CSR sparse format"""\n    # Convert to scipy sparse CSR format\n    csr_matrix = sparse.csr_matrix(mask)\n    return csr_matrix.data, csr_matrix.indices, csr_matrix.indptr\n\ndef analyze_video(video_path, output_json, output_npz, fps=6):\n    """Main analysis function"""\n    print(f"Loading video from {video_path}...")\n    frames, frame_indices = get_video_frames(video_path, fps=fps)\n    \n    print(f"Loaded {len(frames)} frames")\n    if len(frames) < 2:\n        print("Error: Not enough frames")\n        return\n    \n    # Motion classification\n    motion_dict = defaultdict(list)\n    \n    # Dynamic masks storage\n    masks_data = {"shape": [frames[0].shape[0], frames[0].shape[1]]}\n    \n    print("\\nAnalyzing frames...")\n    for i in range(len(frames) - 1):\n        print(f"Processing frame pair {i}-{i+1}...")\n        \n        # Compute optical flow\n        flow = compute_optical_flow(frames[i], frames[i+1])\n        \n        # Classify motion\n        motion_label = classify_motion(flow)\n        motion_dict[f"{i}->{i+1}"].append(motion_label)\n        \n        # Detect dynamic objects\n        dyn_mask = detect_dynamic_objects(frames[i], frames[i+1], flow)\n        \n        # Convert to CSR format\n        data, indices, indptr = mask_to_csr(dyn_mask)\n        masks_data[f"f_{i}_data"] = data\n        masks_data[f"f_{i}_indices"] = indices\n        masks_data[f"f_{i}_indptr"] = indptr\n    \n    # Save motion instructions\n    print(f"\\nSaving motion instructions to {output_json}...")\n    with open(output_json, \'w\') as f:\n        json.dump(dict(motion_dict), f, indent=2)\n    \n    # Save dynamic masks\n    print(f"Saving dynamic masks to {output_npz}...")\n    np.savez(output_npz, **masks_data)\n    \n    print("\\nAnalysis complete!")\n    print(f"Motion labels: {set(v[0] for v in motion_dict.values())}")\n\nif __name__ == "__main__":\n    analyze_video(\n        "/root/input.mp4",\n        "/root/pred_instructions.json",\n        "/root/pred_dyn_masks.npz",\n        fps=6\n    )\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
