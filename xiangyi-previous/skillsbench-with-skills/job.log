Sending keys: ['cat <<EOF > process_ppt.py\nfrom pptx import Presentation\nfrom pptx.util import Pt, Inches\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.text import PP_ALIGN\nfrom pptx.enum.shapes import MSO_SHAPE_TYPE\n\ndef process_presentation(input_path, output_path):\n    prs = Presentation(input_path)\n    slide_width = prs.slide_width\n    slide_height = prs.slide_height\n    \n    paper_titles = []\n    \n    # Iterate through slides to process dangling titles\n    for slide in prs.slides:\n        # Identify dangling titles (text boxes that are not placeholders)\n        # We iterate a copy of shapes because we might modify them, though usually safe here\n        for shape in slide.shapes:\n            if not shape.has_text_frame:\n                continue\n                \n            # Skip placeholders (Title, Content, etc.)\n            if shape.is_placeholder:\n                continue\n            \n            # Check if it has text\n            if not shape.text.strip():\n                continue\n                \n            # This is likely our dangling paper title\n            # Apply formatting\n            text_frame = shape.text_frame\n            text_frame.clear()  # Clear existing formatting to be safe, but we need the text back\n            \n            # Actually, better to iterate paragraphs/runs to preserve text but change style\n            # But requirement says \'change font type...\', implies uniform style.\n            # Let\'s get the text first\n            full_text = shape.text.replace(\'\\n\', \' \').strip()\n            paper_titles.append(full_text)\n            \n            # Clear and set new text to ensure clean formatting\n            text_frame.text = full_text\n            \n            for paragraph in text_frame.paragraphs:\n                paragraph.alignment = PP_ALIGN.CENTER\n                paragraph.font.name = \'Arial\'\n                paragraph.font.size = Pt(16)\n                paragraph.font.co