ysis\nws=wb['Growth Analysis']\nheaders=[cell.value for cell in ws[3]]\ncol_idx={h:i+1 for i,h in enumerate(headers)}\nfor row in ws.iter_rows(min_row=4):\n    metric=row[0].value\n    if metric in [m for m,_ in values_growth.keys()]:\n        for (m,col),val in values_growth.items():\n            if m==metric:\n                ws.cell(row=row[0].row, column=col_idx[col]).value = val\n\n# save\nwb.save('nasa_budget_recovered.xlsx')\n\n# verify no ???\nwb2=openpyxl.load_workbook('nasa_budget_recovered.xlsx', data_only=True)\nfound=False\nfor ws in wb2.worksheets:\n    for row in ws.iter_rows(values_only=True):\n        if any(v=='???' for v in row):\n            found=True\n            print('Found ??? in', ws.title, row)\nif not found:\n    print('No ??? remaining')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
