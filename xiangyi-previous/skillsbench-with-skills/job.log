Sending keys: ['cat <<\'EOF\' > /root/output/js/visualization.js\n// Get dimensions\nconst chartArea = document.getElementById(\'chart-area\');\nconst width = chartArea.clientWidth;\nconst height = chartArea.clientHeight;\n\nconst svg = d3.select("#chart-area").append("svg")\n    .attr("width", width)\n    .attr("height", height);\n\nconst tooltip = d3.select("#tooltip");\n\nd3.csv("data/stock-descriptions.csv").then(data => {\n    // Process data\n    data.forEach(d => {\n        d.marketCapVal = parseFloat(d.marketCap);\n        d.isETF = isNaN(d.marketCapVal) || d.marketCap === "";\n    });\n\n    const sectors = Array.from(new Set(data.map(d => d.sector))).sort();\n    \n    // Scales\n    const colorScale = d3.scaleOrdinal()\n        .domain(sectors)\n        .range(d3.schemeCategory10);\n\n    // Filter valid caps for scale domain\n    const validCaps = data.filter(d => !d.isETF).map(d => d.marketCapVal);\n    const minCap = d3.min(validCaps);\n    const maxCap = d3.max(validCaps);\n\n    const sizeScale = d3.scaleSqrt()\n        .domain([minCap, maxCap])\n        .range([15, 60]); \n\n    const getRadius = (d) => {\n        if (d.isETF) return 20; \n        return sizeScale(d.marketCapVal);\n    };\n\n    // Force Simulation Centers\n    const xCenter = d3.scalePoint()\n        .domain(sectors)\n        .range([100, width - 100])\n        .padding(0.5);\n\n    const simulation = d3.forceSimulation(data)\n        .force("charge", d3.forceManyBody().strength(5))\n        .force("collide", d3.forceCollide().radius(d => getRadius(d) + 2).strength(0.7))\n        .force("x", d3.forceX(d => xCenter(d.sector)).strength(0.4))\n        .force("y", d3.forceY(height / 2).strength(0.15))\n        .on("tick", ticked);\n\n    // Draw Bubbles\n    const node = svg.selectAll(".node")\n        .data(data)\n        .enter().append("g")\n        .attr("class", "node")\n        .call(drag(simulation));\n\n    const circles = node.append("circle")\n        .attr("r", d => getRadius(d))\n        .attr("fill", d => colorScale(d.sector))\n        .attr("stroke", "#fff")\n        .attr("stroke-width", 1.5)\n        .on("mouseover", (event, d) => {\n            if (d.isETF) return;\n            tooltip.transition().duration(200).style("opacity", .9);\n            tooltip.html(`<strong>${d.ticker}</strong><br>${d["full name"]}<br>${d.sector}`)\n                .style("left", (event.pageX + 10) + "px")\n                .style("top", (event.pageY - 28) + "px");\n        })\n        .on("mouseout", (event, d) => {\n            tooltip.transition().duration(500).style("opacity", 0);\n        })\n        .on("click", (event, d) => highlight(d));\n\n    const labels = node.append("text")\n        .text(d => d.ticker)\n        .attr("text-anchor", "middle")\n        .attr("dy", ".35em")\n        .style("font-size", "10px")\n        .style("pointer-events", "none");\n\n    function ticked() {\n        node.attr("transform", d => {\n            // Keep within bounds\n            const r = getRadius(d);\n            d.x = Math.max(r, Math.min(width - r, d.x));\n            d.y = Math.max(r, Math.min(height - r, d.y));\n            return `translate(${d.x},${d.y})`;\n        });\n    }\n\n    // Legend\n    const legend = svg.selectAll(".legend")\n        .data(sectors)\n        .enter().append("g")\n        .attr("class", "legend")\n        .attr("transform", (d, i) => `translate(20, ${20 + i * 20})`);\n\n    legend.append("rect")\n        .attr("x", 0)\n        .attr("width", 12)\n        .attr("height", 12)\n        .style("fill", colorScale);\n\n    legend.append("text")\n        .attr("x", 18)\n        .attr("y", 6)\n        .attr("dy", ".35em")\n        .text(d => d)\n        .style("font-size", "12px");\n\n    // Table\n    const tableArea = d3.select("#table-area");\n    const table = tableArea.append("table");\n    const thead = table.append("thead");\n    const tbody = table.append("tbody");\n\n    const columns = ["Ticker symbol", "Full company name", "Sector", "Market cap"];\n    \n    thead.append("tr")\n        .selectAll("th")\n        .data(columns)\n        .enter()\n        .append("th")\n        .text(d => d);\n\n    const rows = tbody.selectAll("tr")\n        .data(data)\n        .enter()\n        .append("tr")\n        .attr("id", d => "row-" + d.ticker)\n        .on("click", (event, d) => highlight(d));\n\n    rows.selectAll("td")\n        .data(d => {\n            return [\n                d.ticker,\n                d["full name"],\n                d.sector,\n                formatMarketCap(d.marketCapVal)\n            ];\n        })\n        .enter()\n        .append("td")\n        .text(d => d);\n\n    function formatMarketCap(val) {\n        if (!val || isNaN(val)) return "N/A";\n        if (val >= 1e12) return (val / 1e12).toFixed(2) + "T";\n        if (val >= 1e9) return (val / 1e9).toFixed(2) + "B";\n        if (val >= 1e6) return (val / 1e6).toFixed(2) + "M";\n        return val;\n    }\n\n    function highlight(d) {\n        circles.attr("stroke", "#fff").attr("stroke-width", 1.5);\n        rows.classed("selected", false);\n\n        circles.filter(data => data.ticker === d.ticker)\n            .attr("stroke", "#000")\n            .attr("stroke-width", 3)\n            .raise(); // Bring to front\n\n        const selectedRow = rows.filter(data => data.ticker === d.ticker);\n        selectedRow.classed("selected", true);\n        \n        const rowNode = selectedRow.node();\n        if (rowNode) {\n            rowNode.scrollIntoView({ behavior: "smooth", block: "center" });\n        }\n    }\n    \n    function drag(simulation) {\n        function dragstarted(event, d) {\n            if (!event.active) simulation.alphaTarget(0.3).restart();\n            d.fx = d.x;\n            d.fy = d.y;\n        }\n        \n        function dragged(event, d) {\n            d.fx = event.x;\n            d.fy = event.y;\n        }\n        \n        function dragended(event, d) {\n            if (!event.active) simulation.alphaTarget(0);\n            d.fx = null;\n            d.fy = null;\n        }\n        \n        return d3.drag()\n            .on("start", dragstarted)\n            .on("drag", dragged)\n            .on("end", dragended);\n    }\n});\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
