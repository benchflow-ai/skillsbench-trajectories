Sending keys: ['cat > /root/process_video.py <<\'PY\'\nimport cv2, json, numpy as np\n\nvideo_path = \'/root/input.mp4\'\ncap = cv2.VideoCapture(video_path)\nif not cap.isOpened():\n    raise RuntimeError(\'Cannot open video\')\norig_fps = cap.get(cv2.CAP_PROP_FPS)\nif orig_fps <= 0:\n    orig_fps = 30.0\nsample_fps = 6.0\nstep = max(int(round(orig_fps / sample_fps)), 1)\n\nframes = []\nidx = 0\nwhile True:\n    ret, frame = cap.read()\n    if not ret:\n        break\n    if idx % step == 0:\n        frames.append(frame)\n    idx += 1\ncap.release()\n\nif len(frames) < 2:\n    raise RuntimeError(\'Not enough frames\')\n\nh, w = frames[0].shape[:2]\n\nlabels = {}\nmask_data = {}\n\n\ndef mask_to_csr(mask: np.ndarray):\n    # mask is boolean HxW\n    H, W = mask.shape\n    indices_list = []\n    indptr = [0]\n    for r in range(H):\n        cols = np.where(mask[r])[0]\n        indices_list.append(cols)\n        indptr.append(indptr[-1] + len(cols))\n    if indices_list:\n        indices = np.concatenate(indices_list) if indptr[-1] > 0 else np.array([], dtype=np.int64)\n    else:\n        indices = np.array([], dtype=np.int64)\n    data = np.ones(indices.shape[0], dtype=np.uint8)\n    indptr = np.array(indptr, dtype=np.int64)\n    return data, indices.astype(np.int64), indptr\n\n\nfor i in range(len(frames)-1):\n    prev = frames[i]\n    nxt = frames[i+1]\n    prev_gray = cv2.cvtColor(prev, cv2.COLOR_BGR2GRAY)\n    nxt_gray = cv2.cvtColor(nxt, cv2.COLOR_BGR2GRAY)\n\n    flow = cv2.calcOpticalFlowFarneback(prev_gray, nxt_gray, None, 0.5, 3, 15, 3, 5, 1.2, 0)\n    dx = flow[...,0]\n    dy = flow[...,1]\n    mean_dx = float(np.mean(dx))\n    mean_dy = float(np.mean(dy))\n\n    # radial component for dolly\n    ys, xs = np.mgrid[0:h, 0:w]\n    cx, cy = w/2.0, h/2.0\n    vx = xs - cx\n    vy = ys - cy\n    norm = np.sqrt(vx*vx + vy*vy) + 1e-6\n    rad = (dx*vx + dy*vy) / norm\n    mean_rad = float(np.mean(rad))\n\n    # choose label\n    thresh = 0.5\n    candidates = {\n        \'h\': abs(mean_dx),\n        \'v\': abs(mean_dy),\n        \'r\': abs(mean_rad)\n    }\n    max_key = max(candidates, key=candidates.get)\n    if candidates[max_key] < thresh:\n        label = \'Stay\'\n    elif max_key == \'h\':\n        label = \'Pan Left\' if mean_dx > 0 else \'Pan Right\'\n    elif max_key == \'v\':\n        label = \'Tilt Up\' if mean_dy > 0 else \'Tilt Down\'\n    else:\n        label = \'Dolly In\' if mean_rad > 0 else \'Dolly Out\'\n\n    labels[f"{i}->{i+1}"] = [label]\n\n    # estimate affine global motion using features\n    p0 = cv2.goodFeaturesToTrack(prev_gray, maxCorners=500, qualityLevel=0.01, minDistance=7)\n    if p0 is not None:\n        p1, st, err = cv2.calcOpticalFlowPyrLK(prev_gray, nxt_gray, p0, None)\n        good0 = p0[st==1]\n        good1 = p1[st==1]\n        if len(good0) >= 6:\n            M, inliers = cv2.estimateAffinePartial2D(good0, good1)\n        else:\n            M = None\n    else:\n        M = None\n\n    if M is not None:\n        A = M[:, :2]\n        b = M[:, 2]\n        coords = np.stack([xs, ys], axis=-1).astype(np.float32)\n        global_flow = coords @ A.T + b - coords\n        gdx = global_flow[...,0]\n        gdy = global_flow[...,1]\n        res = np.sqrt((dx-gdx)**2 + (dy-gdy)**2)\n    else:\n        res = np.sqrt(dx**2 + dy**2)\n\n    dyn_mask = res > 1.0\n    dyn_mask = cv2.morphologyEx(dyn_mask.astype(np.uint8)*255, cv2.MORPH_OPEN, np.ones((3,3),np.uint8)) > 0\n\n    data, indices, indptr = mask_to_csr(dyn_mask)\n    mask_data[f\'f_{i}_data\'] = data\n    mask_data[f\'f_{i}_indices\'] = indices\n    mask_data[f\'f_{i}_indptr\'] = indptr\n\nwith open(\'/root/pred_instructions.json\',\'w\') as f:\n    json.dump(labels, f, indent=2)\n\nnp.savez(\'/root/pred_dyn_masks.npz\', shape=np.array([h,w]), **mask_data)\n\nprint(\'Done. frames:\', len(frames))\nPY\npython3 /root/process_video.py\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
