Sending keys: ['cat << \'EOF\' > implement_mpc.py\nimport numpy as np\nimport json\nfrom r2r_simulator import R2RSimulator\nimport scipy.linalg\n\ndef get_linear_model(params, x_ref, u_ref):\n    EA = params[\'EA\']\n    L = params[\'L\']\n    R = params[\'R\']\n    J = params[\'J\']\n    fb = params[\'fb\']\n    v0 = params[\'v0\']\n    num_sec = 6\n    dt = params[\'dt\']\n\n    A_cont = np.zeros((12, 12))\n    B_cont = np.zeros((12, 6))\n\n    T_ref = x_ref[:6]\n    v_ref = x_ref[6:]\n\n    for i in range(num_sec):\n        # Tension dynamics derivatives\n        # dT_i/dt = (EA/L)*(v_i - v_{i-1}) + (1/L)*(v_{i-1}*T_{i-1} - v_i*T_i)\n        if i == 0:\n            # T_{i-1} is T0=0, v_{i-1} is v0\n            # df_T1/dv1 = EA/L - T1/L\n            A_cont[i, 6 + i] = (EA - T_ref[i]) / L\n            # df_T1/dT1 = -v1/L\n            A_cont[i, i] = -v_ref[i] / L\n        else:\n            # df_Ti/dT_{i-1} = v_{i-1}/L\n            A_cont[i, i-1] = v_ref[i-1] / L\n            # df_Ti/dT_i = -v_i/L\n            A_cont[i, i] = -v_ref[i] / L\n            # df_Ti/dv_{i-1} = -EA/L + T_{i-1}/L\n            A_cont[i, 6 + i - 1] = (-EA + T_ref[i-1]) / L\n            # df_Ti/dv_i = EA/L - T_i/L\n            A_cont[i, 6 + i] = (EA - T_ref[i]) / L\n\n        # Velocity dynamics derivatives\n        # dv_i/dt = (R^2/J)*(T_{i+1} - T_i) + (R/J)*u_i - (fb/J)*v_i\n        # df_vi/dT_i = -R^2/J\n        A_cont[6 + i, i] = -R**2 / J\n        if i < num_sec - 1:\n            # df_vi/dT_{i+1} = R^2/J\n            A_cont[6 + i, i + 1] = R**2 / J\n        # df_vi/dv_i = -fb/J\n        A_cont[6 + i, 6 + i] = -fb / J\n        # df_vi/du_i = R/J\n        B_cont[6 + i, i] = R / J\n\n    # Discretize\n    A_disc = np.eye(12) + A_cont * dt\n    B_disc = B_cont * dt\n    return A_disc, B_disc\n\ndef solve_lqr(A, B, Q, R):\n    P = scipy.linalg.solve_discrete_are(A, B, Q, R)\n    K = np.linalg.inv(B.T @ P @ B + R) @ (B.T @ P @ A)\n    return K\n\nsim = R2RSimulator()\nparams = sim.get_params()\nx_ref_initial, u_ref_initial = sim.get_reference(0)\n\nA, B = get_linear_model(params, x_ref_initial, u_ref_initial)\n\nQ_diag = [100.0] * 6 + [0.1] * 6\nR_diag = [0.033] * 6\nQ = np.diag(Q_diag)\nR_mat = np.diag(R_diag)\nK_lqr = solve_lqr(A, B, Q, R_mat)\n\n# MPC implementation\n# Since we need to run for 5 seconds and it\'s a linear system, we can use a simple MPC or even LQR with reference tracking.\n# For MPC, we\'ll use a prediction horizon. Given the constraints and the task, a simple QP might be needed if there were hard constraints,\n# but here we can try LQR first or a simple MPC formulation.\n\nhorizon_N = 9\n\n# Save controller params\ncontroller_params = {\n    "horizon_N": horizon_N,\n    "Q_diag": Q_diag,\n    "R_diag": R_diag,\n    "K_lqr": K_lqr.tolist(),\n    "A_matrix": A.tolist(),\n    "B_matrix": B.tolist()\n}\nwith open(\'controller_params.json\', \'w\') as f:\n    json.dump(controller_params, f, indent=2)\n\n# Simulation\nx = sim.reset()\nlog_data = []\ntensions_all = []\n\n# For MPC, we\'ll solve a simple QP or just use the LQR gain for tracking\n# u = u_ref - K * (x - x_ref)\n\nfor i in range(500):\n    t = sim.get_time()\n    x_ref, u_ref = sim.get_reference()\n    \n    # LQR control law for tracking\n    u = u_ref - K_lqr @ (x - x_ref)\n    \n    x_next = sim.step(u)\n    \n    log_entry = {\n        "time": round(t, 2),\n        "tensions": x[:6].tolist(),\n        "velocities": x[6:].tolist(),\n        "control_inputs": u.tolist(),\n        "references": x_ref.tolist()\n    }\n    log_data.append(log_entry)\n    tensions_all.append(x[:6])\n    x = x_next\n\n# Save control log\nwith open(\'control_log.json\', \'w\') as f:\n    json.dump({"phase": "control", "data": log_data}, f, indent=2)\n\n# Compute metrics\ntensions_all = np.array(tensions_all)\nfinal_ref = np.array(params[\'T_ref_final\'])\n\n# Steady state error (last 1s)\nsse = np.mean(np.abs(tensions_all[400:, :] - final_ref))\n\n# Settling time (within 5% of the step change)\n# Step is at t=0.5 (index 50)\n# We\'ll check from t=0.5 onwards\nsettling_time = 5.0\nfor i in range(50, 500):\n    if np.all(np.abs(tensions_all[i:, :] - final_ref) < 0.05 * np.abs(final_ref - params[\'T_ref_initial\'] + 1e-6)):\n        settling_time = i * 0.01 - 0.5\n        break\n\n# Actually, the requirement is mean steady-state error < 2.0N\n# Let\'s re-calculate SSE correctly\nsse = np.mean(np.abs(tensions_all[400:, :] - final_ref))\n\nmetrics = {\n    "steady_state_error": float(sse),\n    "settling_time": float(settling_time),\n    "max_tension": float(np.max(tensions_all)),\n    "min_tension": float(np.min(tensions_all))\n}\n\nwith open(\'metrics.json\', \'w\') as f:\n    json.dump(metrics, f, indent=2)\n\nprint("Simulation complete. Metrics:", metrics)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
