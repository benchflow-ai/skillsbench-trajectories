Sending keys: ['python3 - <<\'PY\'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\nwb=openpyxl.load_workbook(\'gdp.xlsx\')\nws=wb[\'Task\']\n# Step1 ranges\nranges = [(12,17),(19,24),(26,31)]\nfor rstart,rend in ranges:\n    for r in range(rstart,rend+1):\n        for c in range(8,13):  # H-L\n            col_letter=get_column_letter(c)\n            formula = f"=INDEX(Data!$H$21:$M$40, MATCH($D{r}, Data!$B$21:$B$40,0), MATCH({col_letter}$9, Data!$H$4:$M$4,0))"\n            ws.cell(row=r, column=c).value = formula\n# Step2 net exports percent of GDP\nfor r in range(35,41):\n    exports_row = r-23\n    imports_row = r-16\n    gdp_row = r-9\n    for c in range(8,13):\n        col_letter=get_column_letter(c)\n        formula = f"=({col_letter}{exports_row}-{col_letter}{imports_row})/{col_letter}{gdp_row}*100"\n        ws.cell(row=r, column=c).value = formula\n# Summary stats rows 42-47\nstat_formulas = {\n    42: "MIN",\n    43: "MAX",\n    44: "MEDIAN",\n    45: "AVERAGE",\n    46: "PERCENTILE.INC",\n    47: "PERCENTILE.INC",\n}\nfor r,func in stat_formulas.items():\n    for c in range(8,13):\n        col_letter=get_column_letter(c)\n        if r in (46,47):\n            percentile = "0.25" if r==46 else "0.75"\n            formula = f"={func}({col_letter}35:{col_letter}40,{percentile})"\n        else:\n            formula = f"={func}({col_letter}35:{col_letter}40)"\n        ws.cell(row=r, column=c).value = formula\n# Weighted mean row 50\nfor c in range(8,13):\n    col_letter=get_column_letter(c)\n    formula = f"=SUMPRODUCT({col_letter}35:{col_letter}40,{col_letter}26:{col_letter}31)/SUM({col_letter}26:{col_letter}31)"\n    ws.cell(row=50, column=c).value = formula\n\nwb.save(\'gdp.xlsx\')\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
