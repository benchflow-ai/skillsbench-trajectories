up in data.groupby('col3'):\n    game_id = int(game_id)\n    if len(group) == 2:\n        turns = group.sort_values('col2')\n        t1_rolls = turns.iloc[0][['col4', 'col5', 'col6', 'col7', 'col8', 'col9']].astype(int).tolist()\n        t2_rolls = turns.iloc[1][['col4', 'col5', 'col6', 'col7', 'col8', 'col9']].astype(int).tolist()\n        game_scores[game_id] = get_max_game_score(t1_rolls, t2_rolls)\n\np1_wins = 0\np2_wins = 0\n\nmax_game = int(max(game_scores.keys()))\nfor i in range(1, max_game, 2):\n    g1 = i\n    g2 = i + 1\n    if g1 in game_scores and g2 in game_scores:\n        score1 = game_scores[g1]\n        score2 = game_scores[g2]\n        if score1 > score2:\n            p1_wins += 1\n        elif score2 > score1:\n            p2_wins += 1\n\nprint(p1_wins - p2_wins)\nEOF\npython3 /root/solution.py > /root/answer.txt\ncat /root/answer.txt\n"] min_timeout_sec: 5.0 max_timeout_sec: 180.0
