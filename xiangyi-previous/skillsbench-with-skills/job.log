Sending keys: ['python3 << \'EOF\'\nimport re\n\n# Read domain01\nwith open(\'/app/airport/domain01.pddl\', \'r\') as f:\n    content = f.read()\n\n# Extract all move action names\nmove_actions = re.findall(r\'\\(:action\\s+(move_[^\\s]+)\', content)\n\nprint(f"Found {len(move_actions)} move actions")\nprint("\\nMove actions (first 20):")\n\n# Parse action names to extract transitions\ntransitions = {}\nfor action in move_actions:\n    # Format: move_seg_FROM_seg_TO_...\n    parts = action.split(\'_\')\n    # Find indices of \'seg\' keywords\n    seg_indices = [i for i, p in enumerate(parts) if p == \'seg\']\n    \n    if len(seg_indices) >= 2:\n        from_idx = seg_indices[0]\n        to_idx = seg_indices[1]\n        \n        # Extract segment names\n        from_seg_parts = []\n        to_seg_parts = []\n        \n        i = from_idx\n        while i < to_idx and parts[i] != \'seg\':\n            from_seg_parts.append(parts[i])\n            i += 1\n        from_seg_parts.append(parts[i])  # add \'seg\'\n        \n        i = to_idx\n        while i < len(parts) and parts[i] != \'north\' and parts[i] != \'south\':\n            to_seg_parts.append(parts[i])\n            i += 1\n        \n        from_seg = \'_\'.join(from_seg_parts)\n        to_seg = \'_\'.join(to_seg_parts)\n        \n        if from_seg not in transitions:\n            transitions[from_seg] = []\n        transitions[from_seg].append((to_seg, action))\n        \n        print(f"{action}")\n        print(f"  {from_seg} -> {to_seg}")\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
