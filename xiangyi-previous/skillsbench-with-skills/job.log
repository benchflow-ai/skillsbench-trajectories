 for (x, y), t in tiles.items() \n               if not t[\'is_water\'] and not t[\'is_mountain\'] \n               and t.get(\'feature\') not in [\'FEATURE_ICE\'])\n\ndef calc_campus_adj(x, y, placements):\n    bonus = 0\n    jungle_count = 0\n    district_count = 0\n    \n    for nx, ny in get_neighbors(x, y):\n        t = tiles.get((nx, ny), {})\n        feature = t.get(\'feature\', \'\')\n        \n        if feature == \'FEATURE_GEOTHERMAL_FISSURE\':\n            bonus += 2\n        if feature == \'FEATURE_REEF\':\n            bonus += 2\n        if t.get(\'is_mountain\'):\n            bonus += 1\n        if feature == \'FEATURE_JUNGLE\' and (nx, ny) not in placements:\n            jungle_count += 1\n        if (nx, ny) in placements:\n            district_count += 1\n    \n    bonus += (jungle_count // 2)\n    bonus += (district_count // 2)\n    return bonus\n\ndef calc_holy_site_adj(x, y, placements):\n    bonus = 0\n    forest_count = 0\n    district_count = 0\n    \n    for nx, ny in get_neighbors(x, y):\n        t = tiles.get((nx, ny), {})\n        feature = t.get(\'feature\', \'\')\n        \n        if t.get(\'is_mountain\'):\n            bonus += 1\n        if feature == \'FEATURE_FOREST\' and (nx, ny) not in placements:\n            forest_count += 1\n        if (nx, ny) in placements:\n            district_count += 1\n    \n    bonus += (forest_count // 2)\n    bonus += (district_count // 2)\n    return bonus\n\ndef calc_commercial_hub_adj(x, y, placements):\n    bonus = 0\n    t = tiles.get((x, y), {})\n    \n    if t.get(\'has_river\'):\n        bonus += 2\n    \n    # Check for adjacent Harbor\n    harbor_count = 0\n    district_count = 0\n    for nx, ny in get_neighbors(x, y):\n        if (nx, ny) in placements:\n            if placements[(nx, ny)] == \'HARBOR\':\n                harbor_count += 1\n            else:\n                district_count += 1\n    \n    bonus += harbor_count * 2  # +2 per adjacent harbor\n    bonus += (district_count // 2)\n    return bonus\n\ndef calc_industrial_zone_adj(x, y, placements):\n    bonus = 0\n    district_count = 0\n    \n    for nx, ny in get_neighbors(x, y):\n        if (nx, ny) in placements:\n            dtype = placements[(nx, ny)]\n            if dtype in [\'AQUEDUCT\', \'DAM\', \'CANAL\']:\n                bonus += 2\n            else:\n                district_count += 1\n    \n    bonus += (district_count // 2)\n    return bonus\n\ndef calc_theater_square_adj(x, y, placements):\n    bonus = 0\n    district_count = 0\n    \n    for nx, ny in get_neighbors(x, y):\n        if (nx, ny) in placements:\n            dtype = placements[(nx, ny)]\n            if dtype in [\'ENTERTAINMENT_COMPLEX\', \'WATER_PARK\']:\n                bonus += 2\n            else:\n                district_count += 1\n    \n    bonus += (district_count // 2)\n    return bonus\n\n# District types that give adjacency bonuses\nDISTRICT_TYPES = [\'CAMPUS\', \'HOLY_SITE\', \'COMMERCIAL_HUB\', \'INDUSTRIAL_ZONE\', \'THEATER_SQUARE\']\n\ncalc_funcs = {\n    \'CAMPUS\': calc_campus_adj,\n    \'HOLY_SITE\': calc_holy_site_adj,\n    \'COMMERCIAL_HUB\': calc_commercial_hub_adj,\n    \'INDUSTRIAL_ZONE\': calc_industrial_zone_adj,\n    \'THEATER_SQUARE\': calc_theater_square_adj,\n}\n\nbest_total = 0\nbest_config = None\n\n# Try all city center positions\nfor cc in valid_cc_tiles:\n    cc_x, cc_y = cc\n    \n    # Get tiles within 3 of city center (valid for districts)\n    workable = [t for t in valid_district_tiles if t != cc and hex_distance(cc_x, cc_y, t[0], t[1]) <= 3]\n    \n    if len(workable) < 3:\n        continue\n    \n    # Try all combinations of 3 district positions\n    for positions in combinations(workable, 3):\n        # Try all permutations of district types for these positions\n        for district_combo in combinations(DISTRICT_TYPES, 3):\n            for perm in permutations(district_combo):\n                placements = {cc: \'CITY_CENTER\'}\n                for i, pos in enumerate(positions):\n                    placements[pos] = perm[i]\n                \n                total = 0\n                adj_dict = {}\n                for pos, dtype in zip(positions, perm):\n                    adj = calc_funcs[dtype](pos[0], pos[1], placements)\n                    total += adj\n                    adj_dict[dtype] = adj\n                \n                if total > best_total:\n                    best_total = total\n                    best_config = {\n                        \'city_center\': cc,\n                        \'placements\': {perm[i]: positions[i] for i in range(3)},\n                        \'adj\': adj_dict,\n                        \'total\': total\n                    }\n\nprint(f"Best total adjacency: {best_total}")\nprint(f"Best config: {best_config}")\n\nEOF\n'] min_timeout_sec: 60.0 max_timeout_sec: 180.0
