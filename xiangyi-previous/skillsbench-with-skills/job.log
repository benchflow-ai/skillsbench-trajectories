Sending keys: ['cat << \'EOF\' > /root/detect_fillers.py\nimport whisper\nimport json\nimport subprocess\nimport re\n\ndef detect_fillers(video_path, output_json, output_video):\n    model = whisper.load_model("base")\n    result = model.transcribe(video_path, word_timestamps=True)\n\n    filler_words = [\n        "um", "uh", "hum", "hmm", "mhm",\n        "like",\n        "you know",\n        "i mean",\n        "yeah",\n        "so",\n        "kind of",\n        "basically",\n        "i guess",\n        "well",\n        "okay"\n    ]\n\n    detected = []\n    words_list = []\n    for segment in result[\'segments\']:\n        for word_info in segment[\'words\']:\n            words_list.append(word_info)\n\n    # Sort words by start time just in case\n    words_list.sort(key=lambda x: x[\'start\'])\n\n    i = 0\n    while i < len(words_list):\n        found = False\n        # Check for phrases first (2 words)\n        if i + 1 < len(words_list):\n            phrase2 = (words_list[i][\'word\'].strip().lower() + " " + words_list[i+1][\'word\'].strip().lower())\n            phrase2_clean = re.sub(r\'[^\\w\\s]\', \'\', phrase2)\n            if phrase2_clean in filler_words:\n                detected.append({\n                    "word": phrase2_clean,\n                    "timestamp": words_list[i][\'start\'],\n                    "end": words_list[i+1][\'end\']\n                })\n                i += 2\n                found = True\n                continue\n        \n        # Check for single words\n        word = words_list[i][\'word\'].strip().lower()\n        word_clean = re.sub(r\'[^\\w\\s]\', \'\', word)\n        if word_clean in filler_words:\n            detected.append({\n                "word": word_clean,\n                "timestamp": words_list[i][\'start\'],\n                "end": words_list[i][\'end\']\n            })\n        i += 1\n\n    # Save to annotations.json (only word and timestamp as requested)\n    annotations = [{"word": d["word"], "timestamp": d["timestamp"]} for d in detected]\n    with open(output_json, \'w\') as f:\n        json.dump(annotations, f, indent=2)\n\n    if not detected:\n        print("No filler words detected.")\n        return\n\n    # Create ffmpeg filter complex to stitch clips\n    # We\'ll use a filter_complex to avoid many intermediate files\n    filter_complex = ""\n    for i, d in enumerate(detected):\n        filter_complex += f"[0:v]trim=start={d[\'timestamp\']}:end={d[\'end\']},setpts=PTS-STARTPTS[v{i}];"\n        filter_complex += f"[0:a]atrim=start={d[\'timestamp\']}:end={d[\'end\']},asetpts=PTS-STARTPTS[a{i}];"\n    \n    for i in range(len(detected)):\n        filter_complex += f"[v{i}][a{i}]"\n    filter_complex += f"concat=n={len(detected)}:v=1:a=1[outv][outa]"\n\n    cmd = [\n        "ffmpeg", "-y", "-i", video_path,\n        "-filter_complex", filter_complex,\n        "-map", "[outv]", "-map", "[outa]",\n        output_video\n    ]\n    \n    print("Running ffmpeg...")\n    subprocess.run(cmd)\n\ndetect_fillers("/root/input.mp4", "/root/annotations.json", "/root/output.mp4")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
