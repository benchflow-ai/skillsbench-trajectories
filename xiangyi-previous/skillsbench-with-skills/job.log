Sending keys: ['python3 << \'EOF\'\nimport cv2\nimport numpy as np\nimport csv\nimport sys\n\ndef count_objects_fast(frame_path, template_path, threshold=0.85):\n    """Count objects in a frame using template matching - fast version"""\n    try:\n        frame = cv2.imread(frame_path, cv2.IMREAD_GRAYSCALE)\n        template = cv2.imread(template_path, cv2.IMREAD_GRAYSCALE)\n        \n        if frame is None or template is None:\n            return 0\n        \n        # Ensure template is not larger than frame\n        if template.shape[0] > frame.shape[0] or template.shape[1] > frame.shape[1]:\n            return 0\n        \n        # Perform template matching using normalized correlation\n        result = cv2.matchTemplate(frame, template, cv2.TM_CCORR_NORMED)\n        \n        # Find all matches above threshold - very high threshold for speed\n        locations = np.where(result >= threshold)\n        \n        if len(locations[0]) == 0:\n            return 0\n        \n        # Get coordinates\n        matches = list(zip(locations[1], locations[0]))\n        \n        if not matches:\n            return 0\n        \n        # Simple non-maximum suppression\n        template_h, template_w = template.shape\n        min_distance = max(template_h, template_w) // 2\n        \n        selected = []\n        for x, y in sorted(matches):\n            # Check if this match overlaps with already selected matches\n            overlaps = False\n            for sx, sy in selected:\n                if abs(x - sx) < min_distance and abs(y - sy) < min_distance:\n                    overlaps = True\n                    break\n            if not overlaps:\n                selected.append((x, y))\n        \n        return len(selected)\n    except Exception as e:\n        print(f"Error in count_objects_fast: {e}", file=sys.stderr)\n        return 0\n\n# Load template paths\ncoin_template = "/root/coin.png"\nenemy_template = "/root/enemy.png"\nturtle_template = "/root/turtle.png"\n\n# Prepare CSV output\nresults = []\n\nprint("Processing frames and counting objects...")\nsys.stdout.flush()\n\nfor i in range(1, 28):\n    frame_path = f"/root/keyframes_{i:03d}.png"\n    frame_id = f"/root/keyframes_{i:03d}.png"\n    \n    # Count each object type with high threshold for speed\n    coins = count_objects_fast(frame_path, coin_template, threshold=0.85)\n    enemies = count_objects_fast(frame_path, enemy_template, threshold=0.85)\n    turtles = count_objects_fast(frame_path, turtle_template, threshold=0.85)\n    \n    results.append({\n        \'frame_id\': frame_id,\n        \'coins\': coins,\n        \'enemies\': enemies,\n        \'turtles\': turtles\n    })\n    \n    print(f"Frame {i:03d}: coins={coins}, enemies={enemies}, turtles={turtles}")\n    sys.stdout.flush()\n\n# Write to CSV\nwith open(\'/root/counting_results.csv\', \'w\', newline=\'\') as csvfile:\n    fieldnames = [\'frame_id\', \'coins\', \'enemies\', \'turtles\']\n    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n    \n    writer.writeheader()\n    writer.writerows(results)\n\nprint("\\nResults written to /root/counting_results.csv")\nEOF\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
