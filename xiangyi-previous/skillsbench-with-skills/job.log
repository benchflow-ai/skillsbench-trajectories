Sending keys: ['python3 << \'PYEOF\'\nimport pandas as pd\nimport numpy as np\n\n# Load data\ndata = pd.read_csv(\'/root/environment/data/ckd_lab_data.csv\')\n\ndef convert_to_float(val):\n    if pd.isna(val) or val == \'\' or val == \'nan\':\n        return np.nan\n    try:\n        return float(str(val).strip().replace(\',\', \'.\'))\n    except:\n        return np.nan\n\n# Convert all columns to numeric\nfor col in data.columns[1:]:\n    data[col] = data[col].apply(convert_to_float)\n\n# Remove rows with missing values\ndata = data.dropna().reset_index(drop=True)\nprint(f"Data shape: {data.shape}")\n\n# Apply conversions - First pass\nprint("\\nFirst pass conversions:")\n\n# Serum_Creatinine: µmol/L to mg/dL if > 1.5\nmask = data[\'Serum_Creatinine\'] > 1.5\nif mask.any():\n    data.loc[mask, \'Serum_Creatinine\'] = data.loc[mask, \'Serum_Creatinine\'] / 88.4\n    print(f"Serum_Creatinine: {mask.sum()} converted")\n\n# BUN: mmol/L to mg/dL if > 25\nmask = data[\'BUN\'] > 25\nif mask.any():\n    data.loc[mask, \'BUN\'] = data.loc[mask, \'BUN\'] / 2.8\n    print(f"BUN: {mask.sum()} converted")\n\n# Magnesium: mmol/L to mg/dL if > 3\nmask = data[\'Magnesium\'] > 3\nif mask.any():\n    data.loc[mask, \'Magnesium\'] = data.loc[mask, \'Magnesium\'] / 2.43\n    print(f"Magnesium: {mask.sum()} converted")\n\n# Phosphorus: mmol/L to mg/dL if > 6\nmask = data[\'Phosphorus\'] > 6\nif mask.any():\n    data.loc[mask, \'Phosphorus\'] = data.loc[mask, \'Phosphorus\'] / 3.1\n    print(f"Phosphorus: {mask.sum()} converted")\n\n# Hemoglobin: g/L to g/dL if > 20\nmask = data[\'Hemoglobin\'] > 20\nif mask.any():\n    data.loc[mask, \'Hemoglobin\'] = data.loc[mask, \'Hemoglobin\'] / 10\n    print(f"Hemoglobin (>20): {mask.sum()} converted")\n\n# Ferritin: µg/L to ng/mL if > 500\nmask = data[\'Ferritin\'] > 500\nif mask.any():\n    data.loc[mask, \'Ferritin\'] = data.loc[mask, \'Ferritin\'] / 10\n    print(f"Ferritin: {mask.sum()} converted")\n\n# pO2_Arterial: kPa to mmHg if > 200\nmask = data[\'pO2_Arterial\'] > 200\nif mask.any():\n    data.loc[mask, \'pO2_Arterial\'] = data.loc[mask, \'pO2_Arterial\'] / 7.5\n    print(f"pO2_Arterial: {mask.sum()} converted")\n\n# Lactate: mmol/L to mg/dL if > 10\nmask = data[\'Lactate\'] > 10\nif mask.any():\n    data.loc[mask, \'Lactate\'] = data.loc[mask, \'Lactate\'] / 11.2\n    print(f"Lactate: {mask.sum()} converted")\n\n# Second pass - for remaining out-of-range values\nprint("\\nSecond pass conversions:")\n\n# Hemoglobin: if < 5, multiply by 10 (mmol/L to g/dL)\nmask = data[\'Hemoglobin\'] < 5\nif mask.any():\n    data.loc[mask, \'Hemoglobin\'] = data.loc[mask, \'Hemoglobin\'] * 10\n    print(f"Hemoglobin (<5): {mask.sum()} converted")\n\n# Ferritin: if still > 300, divide by 10 again\nmask = data[\'Ferritin\'] > 300\nif mask.any():\n    data.loc[mask, \'Ferritin\'] = data.loc[mask, \'Ferritin\'] / 10\n    print(f"Ferritin (>300): {mask.sum()} converted")\n\n# BUN: if still > 25, divide by 2.8 again\nmask = data[\'BUN\'] > 25\nif mask.any():\n    data.loc[mask, \'BUN\'] = data.loc[mask, \'BUN\'] / 2.8\n    print(f"BUN (>25): {mask.sum()} converted")\n\n# Magnesium: if still > 2.5, divide by 2.43 again\nmask = data[\'Magnesium\'] > 2.5\nif mask.any():\n    data.loc[mask, \'Magnesium\'] = data.loc[mask, \'Magnesium\'] / 2.43\n    print(f"Magnesium (>2.5): {mask.sum()} converted")\n\n# Round to 2 decimal places\nfor col in data.columns[1:]:\n    data[col] = data[col].round(2)\n    data[col] = data[col].apply(lambda x: f"{x:.2f}")\n\nprint(f"\\nFinal shape: {data.shape}")\nprint(f"\\nSample:")\nprint(data[[\'patient_id\', \'Serum_Creatinine\', \'Hemoglobin\', \'Ferritin\', \'BUN\']].head(10))\n\n# Save\ndata.to_csv(\'/root/ckd_lab_data_harmonized.csv\', index=False)\nprint(f"\\nSaved to /root/ckd_lab_data_harmonized.csv")\nPYEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
