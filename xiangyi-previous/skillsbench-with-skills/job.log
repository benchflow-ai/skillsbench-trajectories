Sending keys: ['python3 << \'EOF\'\nimport zipfile\nimport os\n\n# Extract results.pptx to verify\nverify_dir = \'/root/verify_results\'\nos.makedirs(verify_dir, exist_ok=True)\n\nwith zipfile.ZipFile(\'/root/results.pptx\', \'r\') as zf:\n    zf.extractall(verify_dir)\n\n# Extract the embedded Excel\nexcel_verify_dir = \'/root/verify_excel\'\nos.makedirs(excel_verify_dir, exist_ok=True)\n\nwith zipfile.ZipFile(f\'{verify_dir}/ppt/embeddings/Microsoft_Excel_Worksheet.xlsx\', \'r\') as zf:\n    zf.extractall(excel_verify_dir)\n\n# Read and check sheet1.xml\nwith open(f\'{excel_verify_dir}/xl/worksheets/sheet1.xml\', \'r\') as f:\n    content = f.read()\n    \n# Check for B3 value\nimport re\nmatch = re.search(r\'r="B3"[^>]*>.*?<v>([^<]+)</v>\', content)\nif match:\n    print(f"B3 value in results.pptx: {match.group(1)}")\n    if match.group(1) == \'7.02\':\n        print("SUCCESS: USD to CNY rate updated correctly to 7.02")\n    else:\n        print(f"WARNING: Expected 7.02 but found {match.group(1)}")\nelse:\n    print("ERROR: Could not find B3 cell")\n\n# Also verify formulas are preserved\nformulas = re.findall(r\'<f>([^<]+)</f>\', content)\nprint(f"\\nFormulas preserved in the sheet: {len(formulas)}")\nfor f in formulas:\n    print(f"  - {f}")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
