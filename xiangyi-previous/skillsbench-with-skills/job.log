Sending keys: ['cat > /root/process_pptx.py << \'ENDSCRIPT\'\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt, Emu\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.text import PP_ALIGN, MSO_ANCHOR\nfrom pptx.enum.shapes import MSO_SHAPE_TYPE\nfrom pptx.oxml.ns import nsmap\nfrom copy import deepcopy\n\n# Load presentation\nprs = Presentation(\'/root/Awesome-Agent-Papers.pptx\')\n\n# Get slide dimensions\nslide_width = prs.slide_width\nslide_height = prs.slide_height\n\nprint(f"Slide dimensions: {slide_width.inches:.2f} x {slide_height.inches:.2f} inches")\n\n# Collect paper titles and their text boxes\npaper_titles = []\ndangling_boxes = []  # (slide, shape, title_text)\n\nfor slide_idx, slide in enumerate(prs.slides):\n    for shape in slide.shapes:\n        # Check if it\'s a TEXT_BOX (dangling paper title)\n        if shape.shape_type == MSO_SHAPE_TYPE.TEXT_BOX:\n            if shape.has_text_frame:\n                text = ""\n                for para in shape.text_frame.paragraphs:\n                    text += para.text.strip()\n                if text:\n                    print(f"Slide {slide_idx + 1}: Found paper title: \'{text}\'")\n                    dangling_boxes.append((slide, shape, text))\n                    paper_titles.append(text)\n\nprint(f"\\nFound {len(dangling_boxes)} dangling paper titles")\n\n# Get unique titles while preserving order\nseen = set()\nunique_titles = []\nfor title in paper_titles:\n    if title not in seen:\n        seen.add(title)\n        unique_titles.append(title)\n\nprint(f"Unique paper titles: {len(unique_titles)}")\nfor i, title in enumerate(unique_titles, 1):\n    print(f"  {i}. {title}")\n\n# Define formatting\nfont_name = "Arial"\nfont_size = Pt(16)\nfont_color = RGBColor(0x98, 0x95, 0x96)  # #989596\n\n# Bottom margin from slide bottom\nbottom_margin = Inches(0.3)\nbox_height = Inches(0.4)\n\n# Process each dangling text box\nfor slide, shape, title_text in dangling_boxes:\n    # Calculate required width - estimate based on character count\n    # Use a generous width to ensure single line\n    # We\'ll use almost full slide width with some margin\n    new_width = slide_width - Inches(0.5)  # Leave 0.25" margin on each side\n    \n    # Center horizontally\n    new_left = (slide_width - new_width) / 2\n    \n    # Position at bottom center\n    new_top = slide_height - bottom_margin - box_height\n    \n    # Update shape position and size\n    shape.left = int(new_left)\n    shape.top = int(new_top)\n    shape.width = int(new_width)\n    shape.height = int(box_height)\n    \n    # Format the text\n    for para in shape.text_frame.paragraphs:\n        para.alignment = PP_ALIGN.CENTER\n        for run in para.runs:\n            run.font.name = font_name\n            run.font.size = font_size\n            run.font.color.rgb = font_color\n            run.font.bold = False\n        \n        # Also set paragraph-level font properties in case there are no runs\n        if para.font:\n            para.font.name = font_name\n            para.font.size = font_size\n            para.font.color.rgb = font_color\n            para.font.bold = False\n\nprint("\\nFormatted all dangling paper titles")\n\n# Create a new Reference slide at the end\n# Use a blank layout or title and content layout\nslide_layouts = prs.slide_layouts\n\n# Find a suitable layout (Title and Content or similar)\n# Layout index 1 is typically "Title and Content"\nlayout = None\nfor sl in slide_layouts:\n    if \'Title and Content\' in sl.name or \'title and content\' in sl.name.lower():\n        layout = sl\n        break\nif layout is None:\n    # Try to get layout index 1 (usually Title and Content)\n    layout = slide_layouts[1] if len(slide_layouts) > 1 else slide_layouts[0]\n\nprint(f"Using layout: {layout.name}")\n\n# Add new slide\nref_slide = prs.slides.add_slide(layout)\n\n# Set the title\nfor shape in ref_slide.shapes:\n    if shape.has_text_frame:\n        if \'title\' in shape.name.lower() or shape.placeholder_format is not None:\n            if hasattr(shape, \'placeholder_format\') and shape.placeholder_format is not None:\n                from pptx.enum.shapes import PP_PLACEHOLDER\n                if shape.placeholder_format.type == PP_PLACEHOLDER.TITLE:\n                    shape.text_frame.paragraphs[0].text = "Reference"\n                    print("Set Reference title")\n                    break\n            elif \'title\' in shape.name.lower():\n                shape.text_frame.paragraphs[0].text = "Reference"\n                print("Set Reference title")\n                break\n\n# Find the content placeholder and add paper titles\nfor shape in ref_slide.shapes:\n    if shape.has_text_frame and hasattr(shape, \'placeholder_format\') and shape.placeholder_format is not None:\n        from pptx.enum.shapes import PP_PLACEHOLDER\n        if shape.placeholder_format.type in [PP_PLACEHOLDER.BODY, PP_PLACEHOLDER.OBJECT, PP_PLACEHOLDER.CONTENT]:\n            tf = shape.text_frame\n            tf.clear()  # Clear existing content\n            \n            for i, title in enumerate(unique_titles):\n                if i == 0:\n                    p = tf.paragraphs[0]\n                else:\n                    p = tf.add_paragraph()\n                p.text = f"{i + 1}. {title}"\n                p.level = 0\n            \n            print(f"Added {len(unique_titles)} references to the slide")\n            break\n\n# Save the presentation\noutput_path = \'/root/Awesome-Agent-Papers_processed.pptx\'\nprs.save(output_path)\nprint(f"\\nSaved processed presentation to: {output_path}")\nENDSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
