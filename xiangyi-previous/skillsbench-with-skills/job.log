Sending keys: ["python3 - <<'PY'\nimport obspy, seisbench.models as sbm\nfrom collections import defaultdict\nimport numpy as np\nvp=6.0\nvs=vp/1.75\nst=obspy.read('/root/data/wave.mseed')\nmodel=sbm.PhaseNet.from_pretrained('scedc')\nprint('classify...')\npicks=model.classify(st, P_threshold=0.5, S_threshold=0.5).picks\n# group picks by station\np_by_sta=defaultdict(list)\ns_by_sta=defaultdict(list)\nfor p in picks:\n    if p.phase=='P':\n        p_by_sta[p.trace_id].append(p.peak_time)\n    elif p.phase=='S':\n        s_by_sta[p.trace_id].append(p.peak_time)\n# sort times\nfor sta in p_by_sta: p_by_sta[sta]=sorted(p_by_sta[sta])\nfor sta in s_by_sta: s_by_sta[sta]=sorted(s_by_sta[sta])\n# pair P with nearest S after it\norigin_times=[]\nfor sta, ptimes in p_by_sta.items():\n    stimes = s_by_sta.get(sta, [])\n    if not stimes: continue\n    j=0\n    for pt in ptimes:\n        # move j to first S after pt\n        while j < len(stimes) and stimes[j] < pt: j+=1\n        if j>=len(stimes): break\n        stime=stimes[j]\n        sp = stime - pt\n        if sp < 0.5 or sp > 20: continue\n        # compute distance and origin time\n        dist = sp / (1/vs - 1/vp)\n        t0 = pt - dist/vp\n        origin_times.append(t0)\n\nprint('origin estimates', len(origin_times))\norigin_times=sorted(origin_times)\n# cluster by 5s\nclusters=[]\ncurrent=[]\nfor t in origin_times:\n    if not current:\n        current=[t]\n    elif t - current[-1] <= 5:\n        current.append(t)\n    else:\n        clusters.append(current)\n        current=[t]\nif current: clusters.append(current)\nprint('n clusters', len(clusters))\nfor i,c in enumerate(clusters):\n    if len(c)>=3:\n        print(i, 'size', len(c), 'median', np.median([t.timestamp for t in c]))\n# show times for clusters >=3\nfor i,c in enumerate(clusters):\n    if len(c)>=3:\n        med=obspy.UTCDateTime(np.median([t.timestamp for t in c]))\n        print('event', i, 'time', med, 'count', len(c))\nPY\n"] min_timeout_sec: 1.