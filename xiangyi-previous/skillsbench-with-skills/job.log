e)\n    top_extensive = extensive_drivers[:3]\n    \n    surge_results.append({\n        \'category\': category,\n        \'anomaly_index\': round(float(anomaly_idx), 2),\n        \'baseline_avg_spend\': round(float(baseline_avg_spend), 2),\n        \'treatment_avg_spend\': round(float(treatment_avg_spend), 2),\n        \'n_purchasers_baseline\': int(n_purchasers_baseline),\n        \'n_purchasers_treatment\': int(n_purchasers_treatment),\n        \'baseline_purchase_rate\': round(float(baseline_purchase_rate), 4),\n        \'treatment_purchase_rate\': round(float(treatment_purchase_rate), 4),\n        \'n_at_risk\': int(n_at_risk),\n        \'intensive_margin\': top_intensive,\n        \'extensive_margin\': top_extensive\n    })\n\nprint("\\nAnalyzing slump categories...")\nslump_results = []\n\nfor category in top_slump:\n    print(f"  Processing {category}...")\n    \n    # Get anomaly index\n    anomaly_idx = anomaly_df[anomaly_df[\'Category\'] == category][\'Anomaly_Index\'].values[0]\n    \n    # Calculate baseline and treatment statistics\n    cat_purchases = purchases_top[purchases_top[\'Category\'] == category]\n    \n    baseline_purchases = cat_purchases[cat_purchases[\'Period\'] == \'baseline\']\n    treatment_purchases = cat_purchases[cat_purchases[\'Period\'] == \'treatment\']\n    \n    baseline_avg_spend = baseline_purchases[\'Total_Spend\'].mean() if len(baseline_purchases) > 0 else 0\n    treatment_avg_spend = treatment_purchases[\'Total_Spend\'].mean() if len(treatment_purchases) > 0 else 0\n    \n    n_purchasers_baseline = baseline_purchases[\'Survey ResponseID\'].nunique()\n    n_purchasers_treatment = treatment_purchases[\'Survey ResponseID\'].nunique()\n    \n    n_at_risk = len(all_users)\n    baseline_purchase_rate = n_purchasers_baseline / n_at_risk if n_at_risk > 0 else 0\n    treatment_purchase_rate = n_purchasers_treatment / n_at_risk if n_at_risk > 0 else 0\n    \n    # Intensive margin analysis\n    intensive_drivers = []\n    for feature in feature_cols:\n        result = univariate_did_intensive(intensive_merged, category, feature)\n        if result:\n            intensive_drivers.append(result)\n    \n    # Sort by did_estimate (ascending for slump - largest negative effects)\n    intensive_drivers.sort(key=lambda x: x[\'did_estimate\'])\n    top_intensive = intensive_drivers[:3]\n    \n    # Extensive margin analysis\n    extensive_drivers = multivariate_did_extensive(extensive_merged, category, feature_cols)\n    \n    # Sort by did_estimate (ascending for slump - largest negative effects)\n    extensive_drivers.sort(key=lambda x: x[\'did_estimate\'])\n    top_extensive = extensive_drivers[:3]\n    \n    slump_results.append({\n        \'category\': category,\n        \'anomaly_index\': round(float(anomaly_idx), 2),\n        \'baseline_avg_spend\': round(float(baseline_avg_spend), 2),\n        \'treatment_avg_spend\': round(float(treatment_avg_spend), 2),\n        \'n_purchasers_baseline\': int(n_purchasers_baseline),\n        \'n_purchasers_treatment\': int(n_purchasers_treatment),\n        \'baseline_purchase_rate\': round(float(baseline_purchase_rate), 4),\n        \'treatment_purchase_rate\': round(float(treatment_purchase_rate), 4),\n        \'n_at_risk\': int(n_at_risk),\n        \'intensive_margin\': top_intensive,\n        \'extensive_margin\': top_extensive\n    })\n\n# Step 6: Generate final JSON report\nprint("\\nStep 6: Generating final report...")\n\nfinal_report = {\n    \'metadata\': {\n        \'baseline_start\': baseline_start.strftime(\'%m-%d-%Y\'),\n        \'baseline_end\': baseline_end.strftime(\'%m-%d-%Y\'),\n        \'treatment_start\': treatment_start.strftime(\'%m-%d-%Y\'),\n        \'treatment_end\': treatment_end.strftime(\'%m-%d-%Y\'),\n        \'total_features_analyzed\': len(feature_cols)\n    },\n    \'surge_categories\': surge_results,\n    \'slump_categories\': slump_results,\n    \'summary\': {\n        \'surge\': {\n            \'total_categories\': len(s