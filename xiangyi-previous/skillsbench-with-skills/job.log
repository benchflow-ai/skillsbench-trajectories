Sending keys: ['cat > /root/create_report.py << \'EOF\'\nimport pandas as pd\nimport pdfplumber\nfrom openpyxl import Workbook\nfrom openpyxl.utils.dataframe import dataframe_to_rows\n\n# Extract population data from PDF\nprint("Extracting population data from PDF...")\nall_rows = []\nwith pdfplumber.open(\'/root/population.pdf\') as pdf:\n    for page_num, page in enumerate(pdf.pages):\n        tables = page.extract_tables()\n        for table in tables:\n            for i, row in enumerate(table):\n                # Skip header rows (first row of first page or repeated headers)\n                if row[0] == \'SA2_CODE\':\n                    continue\n                if len(row) >= 4 and row[0]:\n                    all_rows.append(row[:4])\n\nprint(f"Extracted {len(all_rows)} rows from PDF")\n\n# Create population dataframe\npop_df = pd.DataFrame(all_rows, columns=[\'SA2_CODE\', \'SA2_NAME\', \'STATE\', \'POPULATION_2023\'])\npop_df[\'SA2_CODE\'] = pd.to_numeric(pop_df[\'SA2_CODE\'], errors=\'coerce\')\npop_df[\'POPULATION_2023\'] = pd.to_numeric(pop_df[\'POPULATION_2023\'], errors=\'coerce\')\npop_df = pop_df.dropna(subset=[\'SA2_CODE\'])\n\nprint(f"Population dataframe shape: {pop_df.shape}")\nprint(pop_df.head())\n\n# Read income data\nprint("\\nReading income data...")\nincome_df = pd.read_excel(\'/root/income.xlsx\')\nprint(f"Income dataframe shape: {income_df.shape}")\n\n# Merge dataframes\nprint("\\nMerging dataframes...")\nmerged_df = pd.merge(pop_df, income_df, on=\'SA2_CODE\', how=\'inner\', suffixes=(\'\', \'_income\'))\n# Keep only one SA2_NAME column\nif \'SA2_NAME_income\' in merged_df.columns:\n    merged_df = merged_df.drop(columns=[\'SA2_NAME_income\'])\n\nprint(f"Merged dataframe shape: {merged_df.shape}")\nprint(merged_df.head())\n\n# Convert EARNERS and MEDIAN_INCOME to numeric\nmerged_df[\'EARNERS\'] = pd.to_numeric(merged_df[\'EARNERS\'], errors=\'coerce\')\nmerged_df[\'MEDIAN_INCOME\'] = pd.to_numeric(merged_df[\'MEDIAN_INCOME\'], errors=\'coerce\')\nmerged_df[\'MEAN_INCOME\'] = pd.to_numeric(merged_df[\'MEAN_INCOME\'], errors=\'coerce\')\n\n# Create quartiles based on MEDIAN_INCOME\nprint("\\nCreating quartiles...")\nmerged_df[\'Quarter\'] = pd.qcut(merged_df[\'MEDIAN_INCOME\'], q=4, labels=[\'Q1\', \'Q2\', \'Q3\', \'Q4\'])\n\n# Create Total column\nmerged_df[\'Total\'] = merged_df[\'EARNERS\'] * merged_df[\'MEDIAN_INCOME\']\n\nprint(merged_df[[\'SA2_NAME\', \'MEDIAN_INCOME\', \'Quarter\', \'Total\']].head(10))\n\n# Create pivot tables\nprint("\\nCreating pivot tables...")\n\n# 1. Population by State\npivot_pop = merged_df.pivot_table(\n    index=\'STATE\',\n    values=\'POPULATION_2023\',\n    aggfunc=\'sum\'\n).reset_index()\npivot_pop.columns = [\'STATE\', \'Sum of POPULATION_2023\']\n\n# 2. Earners by State\npivot_earners = merged_df.pivot_table(\n    index=\'STATE\',\n    values=\'EARNERS\',\n    aggfunc=\'sum\'\n).reset_index()\npivot_earners.columns = [\'STATE\', \'Sum of EARNERS\']\n\n# 3. Regions by State (count of SA2 regions)\npivot_regions = merged_df.groupby(\'STATE\').size().reset_index(name=\'Count\')\n\n# 4. State Income Quartile\npivot_quartile = merged_df.pivot_table(\n    index=\'STATE\',\n    columns=\'Quarter\',\n    values=\'EARNERS\',\n    aggfunc=\'sum\',\n    fill_value=0\n).reset_index()\n\n# 5. Source Data - prepare the enriched data\nsource_data = merged_df[[\'SA2_CODE\', \'SA2_NAME\', \'STATE\', \'POPULATION_2023\', \'EARNERS\', \'MEDIAN_INCOME\', \'MEAN_INCOME\', \'Quarter\', \'Total\']].copy()\n\nprint("\\nPivot tables created successfully")\nprint(f"Population by State: {pivot_pop.shape}")\nprint(f"Earners by State: {pivot_earners.shape}")\nprint(f"Regions by State: {pivot_regions.shape}")\nprint(f"State Income Quartile: {pivot_quartile.shape}")\nprint(f"Source Data: {source_data.shape}")\n\n# Write to Excel\nprint("\\nWriting to Excel...")\nwith pd.ExcelWriter(\'/root/demographic_analysis.xlsx\', engine=\'openpyxl\') as writer:\n    pivot_pop.to_excel(writer, sheet_name=\'Population by State\', index=False)\n    pivot_earners.to_excel(writer, sheet_name=\'Earners by State\', index=False)\n    pivot_regions.to_excel(writer, sheet_name=\'Regions by State\', index=False)\n    pivot_quartile.to_excel(writer, sheet_name=\'State Income Quartile\', index=False)\n    source_data.to_excel(writer, sheet_name=\'SourceData\', index=False)\n\nprint("\\nReport saved to /root/demographic_analysis.xlsx")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
