Sending keys: ['cat > dicke_wigner.py << \'EOF\'\nimport numpy as np\nfrom qutip import *\nimport csv\n\n# Parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0  # Atomic frequency\nomega_c = 1.0  # Cavity frequency\ng = 2.0 / np.sqrt(N)  # Coupling strength\nkappa = 1.0  # Cavity loss\nn_max = 16  # Photon number cutoff\n\n# Wigner function grid\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\n# Spin dimension for N spin-1/2 particles using collective spin representation\n# j = N/2 for the symmetric subspace\nj = N / 2.0\ndim_spin = int(2 * j + 1)  # Dimension of symmetric spin subspace\n\nprint(f"Setting up Dicke model with N={N} atoms, j={j}")\nprint(f"Cavity dimension: {n_max}, Spin dimension: {dim_spin}")\n\n# Create operators\n# Cavity operators\na = tensor(destroy(n_max), qeye(dim_spin))\n\n# Collective spin operators using spin-j representation\nJz = tensor(qeye(n_max), jmat(j, \'z\'))\nJp = tensor(qeye(n_max), jmat(j, \'+\'))\nJm = tensor(qeye(n_max), jmat(j, \'-\'))\nJx = (Jp + Jm) / 2.0\n\n# Hamiltonian: H = omega_0 * Jz + omega_c * a^dag * a + g * (a + a^dag) * (J+ + J-)\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\nprint("Hamiltonian created")\n\ndef create_collapse_operators(case):\n    """\n    Create collapse operators for different loss cases.\n    \n    Local operators act on individual atoms, but in the symmetric subspace,\n    we use collective operators scaled appropriately.\n    \n    For N identical atoms in symmetric subspace:\n    - Local dephasing: sum_i sigma_z^i -> scales with individual contributions\n    - Local emission: sum_i sigma_-^i -> J_-\n    - Local pumping: sum_i sigma_+^i -> J_+\n    - Collective emission: J_-\n    - Collective pumping: J_+\n    """\n    c_ops = []\n    \n    # Cavity loss (always present)\n    c_ops.append(np.sqrt(kappa) * a)\n    \n    if case == 1:\n        # Local de-phasing & local pumping\n        gamma_phi = 0.01\n        gamma_up = 0.1\n        # Local dephasing: sum of individual sigma_z operators\n        # In symmetric subspace, this gives sqrt(N) * sqrt(gamma_phi) * Jz contribution\n        # But for dephasing, we need individual contributions\n        # For symmetric states: sum_i sigma_z^i = 2*Jz, dephasing rate per atom\n        for i in range(N):\n            c_ops.append(np.sqrt(gamma_phi) * Jz * (2.0/N))  # Approximate local dephasing\n        # Local pumping: sum_i sigma_+^i ~ J_+ for symmetric subspace\n        c_ops.append(np.sqrt(gamma_up * N) * Jp / np.sqrt(N * (N/2 + 1)))  # Normalized\n        \n    elif case == 2:\n        # Local de-phasing & local emission\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        for i in range(N):\n            c_ops.append(np.sqrt(gamma_phi) * Jz * (2.0/N))\n        c_ops.append(np.sqrt(gamma_down * N) * Jm / np.sqrt(N * (N/2 + 1)))\n        \n    elif case == 3:\n        # Local de-phasing & local emission & collective pumping\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        gamma_Up = 0.1  # Collective pumping\n        for i in range(N):\n            c_ops.append(np.sqrt(gamma_phi) * Jz * (2.0/N))\n        c_ops.append(np.sqrt(gamma_down * N) * Jm / np.sqrt(N * (N/2 + 1)))\n        c_ops.append(np.sqrt(gamma_Up) * Jp)  # Collective pumping\n        \n    elif case == 4:\n        # Local de-phasing & local emission & collective emission\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        gamma_Down = 0.1  # Collective emission\n        for i in range(N):\n            c_ops.append(np.sqrt(gamma_phi) * Jz * (2.0/N))\n        c_ops.append(np.sqrt(gamma_down * N) * Jm / np.sqrt(N * (N/2 + 1)))\n        c_ops.append(np.sqrt(gamma_Down) * Jm)  # Collective emission\n    \n    return c_ops\n\ndef solve_and_save(case):\n    print(f"\\n=== Processing Case {case} ===")\n    \n    # Create collapse operators\n    c_ops = create_collapse_operators(case)\n    print(f"Number of collapse operators: {len(c_ops)}")\n    \n    # Solve for steady state\n    print("Solving for steady state...")\n    rho_ss = steadystate(H, c_ops)\n    print("Steady state found")\n    \n    # Trace out spin degrees of freedom to get cavity state\n    # The total system is cavity x spin, so we trace over spin (index 1)\n    print("Tracing out spin degrees of freedom...")\n    rho_cavity = ptrace(rho_ss, 0)\n    print(f"Cavity state dimension: {rho_cavity.shape}")\n    \n    # Calculate Wigner function\n    print("Calculating Wigner function (1000x1000 grid)...")\n    W = wigner(rho_cavity, xvec, pvec)\n    print(f"Wigner function shape: {W.shape}")\n    \n    # Save to CSV\n    filename = f"{case}.csv"\n    print(f"Saving to {filename}...")\n    np.savetxt(filename, W, delimiter=\',\')\n    print(f"Case {case} complete!")\n    \n    return W\n\n# Process all 4 cases\nfor case in [1, 2, 3, 4]:\n    solve_and_save(case)\n\nprint("\\nAll cases completed successfully!")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
