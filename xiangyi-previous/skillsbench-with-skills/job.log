Sending keys: ['cat << \'EOF\' > solver.py\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize\n\ndef solve_opf():\n    with open(\'network.json\') as f:\n        data = json.load(f)\n    \n    baseMVA = data[\'baseMVA\']\n    buses = np.array(data[\'bus\'])\n    gens = np.array(data[\'gen\'])\n    branches = np.array(data[\'branch\'])\n    gencosts = np.array(data[\'gencost\'])\n    \n    num_buses = len(buses)\n    num_gens = len(gens)\n    num_branches = len(branches)\n    \n    bus_ids = buses[:, 0].astype(int)\n    bus_idx = {id: i for i, id in enumerate(bus_ids)}\n    \n    slack_bus_idx = np.where(buses[:, 1] == 3)[0][0]\n    \n    Y = np.zeros((num_buses, num_buses), dtype=complex)\n    for br in branches:\n        f = bus_idx[int(br[0])]\n        t = bus_idx[int(br[1])]\n        r, x, b = br[2], br[3], br[4]\n        tau = br[8] if br[8] != 0 else 1.0\n        shift = np.radians(br[9])\n        y = 1.0 / (r + 1j * x)\n        T = tau * np.exp(1j * shift)\n        Y[f, f] += (y + 1j * b / 2) / (abs(T)**2)\n        Y[t, t] += y + 1j * b / 2\n        Y[f, t] -= y / np.conj(T)\n        Y[t, f] -= y / T\n\n    for i in range(num_buses):\n        gs = buses[i, 4] / baseMVA\n        bs = buses[i, 5] / baseMVA\n        Y[i, i] += gs + 1j * bs\n\n    x0 = np.concatenate([\n        np.radians(buses[:, 8]),\n        buses[:, 7],\n        gens[:, 1] / baseMVA,\n        gens[:, 2] / baseMVA\n    ])\n    \n    bounds = []\n    for i in range(num_buses):\n        if i == slack_bus_idx: bounds.append((0, 0))\n        else: bounds.append((-np.pi, np.pi))\n    for i in range(num_buses): bounds.append((buses[i, 12], buses[i, 11]))\n    for i in range(num_gens): bounds.append((gens[i, 9] / baseMVA, gens[i, 8] / baseMVA))\n    for i in range(num_gens): bounds.append((gens[i, 4] / baseMVA, gens[i, 3] / baseMVA))\n\n    def objective(x):\n        Pg = x[2*num_buses : 2*num_buses + num_gens] * baseMVA\n        cost = 0\n        for i in range(num_gens):\n            c2, c1, c0 = gencosts[i, 4], gencosts[i, 5], gencosts[i, 6]\n            cost += c2 * Pg[i]**2 + c1 * Pg[i] + c0\n        return cost\n\n    def constraints(x):\n        Va, Vm = x[0:num_buses], x[num_buses:2*num_buses]\n        Pg, Qg = x[2*num_buses:2*num_buses+num_gens], x[2*num_buses+num_gens:]\n        V = Vm * np.exp(1j * Va)\n        S_inj = V * np.conj(Y @ V)\n        P_gen, Q_gen = np.zeros(num_buses), np.zeros(num_buses)\n        for i in range(num_gens):\n            idx = bus_idx[int(gens[i, 0])]\n            P_gen[idx] += Pg[i]\n            Q_gen[idx] += Qg[i]\n        return np.concatenate([P_gen - buses[:, 2]/baseMVA - S_inj.real, Q_gen - buses[:, 3]/baseMVA - S_inj.imag])\n\n    def branch_flow_limit(x):\n        Va, Vm = x[0:num_buses], x[num_buses:2*num_buses]\n        V = Vm * np.exp(1j * Va)\n        limits = []\n        for br in branches:\n            if br[5] == 0: continue\n            f, t = bus_idx[int(br[0])], bus_idx[int(br[1])]\n            r, x_br, b = br[2], br[3], br[4]\n            tau, shift = (br[8] if br[8] != 0 else 1.0), np.radians(br[9])\n            T, y = tau * np.exp(1j * shift), 1.0 / (r + 1j * x_br)\n            Sf = V[f] * np.conj((y + 1j*b/2)/abs(T)**2 * V[f] - y/np.conj(T) * V[t])\n            St = V[t] * np.conj((y + 1j*b/2) * V[t] - y/T * V[f])\n            limits.extend([br[5]/baseMVA - abs(Sf), br[5]/baseMVA - abs(St)])\n        return np.array(limits)\n\n    res = minimize(objective, x0, method=\'SLSQP\', bounds=bounds, \n                   constraints=[{\'type\': \'eq\', \'fun\': constraints}, \n                                {\'type\': \'ineq\', \'fun\': branch_flow_limit}],\n                   options={\'maxiter\': 200, \'ftol\': 1e-6})\n    \n    x = res.x\n    Va, Vm = x[0:num_buses], x[num_buses:2*num_buses]\n    Pg, Qg = x[2*num_buses:2*num_buses+num_gens], x[2*num_buses+num_gens:]\n    V = Vm * np.exp(1j * Va)\n    \n    gen_list = []\n    for i in range(num_gens):\n        gen_list.append({\n            "id": i + 1,\n            "bus": int(gens[i, 0]),\n            "pg_MW": float(Pg[i] * baseMVA),\n            "qg_MVAr": float(Qg[i] * baseMVA),\n            "pmin_MW": float(gens[i, 9]),\n            "pmax_MW": float(gens[i, 8]),\n            "qmin_MVAr": float(gens[i, 4]),\n            "qmax_MVAr": float(gens[i, 3])\n        })\n    \n    bus_list = []\n    for i in range(num_buses):\n        bus_list.append({\n            "id": int(buses[i, 0]),\n            "vm_pu": float(Vm[i]),\n            "va_deg": float(np.degrees(Va[i])),\n            "vmin_pu": float(buses[i, 12]),\n            "vmax_pu": float(buses[i, 11])\n        })\n\n    branch_results = []\n    for br in branches:\n        f_id, t_id = int(br[0]), int(br[1])\n        f, t = bus_idx[f_id], bus_idx[t_id]\n        r, x_br, b = br[2], br[3], br[4]\n        tau, shift = (br[8] if br[8] != 0 else 1.0), np.radians(br[9])\n        T, y = tau * np.exp(1j * shift), 1.0 / (r + 1j * x_br)\n        Sf = V[f] * np.conj((y + 1j*b/2)/abs(T)**2 * V[f] - y/np.conj(T) * V[t]) * baseMVA\n        St = V[t] * np.conj((y + 1j*b/2) * V[t] - y/T * V[f]) * baseMVA\n        limit = br[5]\n        loading = max(abs(Sf), abs(St)) / limit * 100 if limit > 0 else 0\n        branch_results.append({\n            "from_bus": f_id,\n            "to_bus": t_id,\n            "loading_pct": float(loading),\n            "flow_from_MVA": float(abs(Sf)),\n            "flow_to_MVA": float(abs(St)),\n            "limit_MVA": float(limit)\n        })\n    branch_results.sort(key=lambda x: x[\'loading_pct\'], reverse=True)\n\n    S_inj = V * np.conj(Y @ V) * baseMVA\n    mismatch = constraints(x) * baseMVA\n    \n    report = {\n        "summary": {\n            "total_cost_per_hour": float(res.fun),\n            "total_load_MW": float(np.sum(buses[:, 2])),\n            "total_load_MVAr": float(np.sum(buses[:, 3])),\n            "total_generation_MW": float(np.sum(Pg) * baseMVA),\n            "total_generation_MVAr": float(np.sum(Qg) * baseMVA),\n            "total_losses_MW": float(np.sum(Pg) * baseMVA - np.sum(buses[:, 2])),\n            "solver_status": "optimal" if res.success else "suboptimal"\n        },\n        "generators": gen_list,\n        "buses": bus_list,\n        "most_loaded_branches": branch_results[:10],\n        "feasibility_check": {\n            "max_p_mismatch_MW": float(np.max(np.abs(mismatch[:num_buses]))),\n            "max_q_mismatch_MVAr": float(np.max(np.abs(mismatch[num_buses:]))),\n            "max_voltage_violation_pu": float(max(0, np.max(Vm - buses[:, 11]), np.max(buses[:, 12] - Vm))),\n            "max_branch_overload_MVA": float(max(0, max(br[\'flow_from_MVA\'] - br[\'limit_MVA\'] for br in branch_results if br[\'limit_MVA\'] > 0)))\n        }\n    }\n    with open(\'report.json\', \'w\') as f:\n        json.dump(report, f, indent=2)\n\nsolve_opf()\nEOF\npython3 solver.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
