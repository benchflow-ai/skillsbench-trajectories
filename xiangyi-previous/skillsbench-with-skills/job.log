ce, 0.98)\n                rationale = f"Matched keywords: {\', \'.join(matched_kw[:5])}" if matched_kw else f"Pattern match with {best_entry.get(\'category_lv2\', \'\')}"\n            \n            normalized.append({\n                "segment_id": f"{record_id}-S{segment_id}",\n                "span_text": span_text.strip(),\n                "pred_code": pred_code,\n                "pred_label": pred_label,\n                "confidence": confidence,\n                "rationale": rationale\n            })\n            segment_id += 1\n        \n        # If no segments were processed, add one with the full text\n        if not normalized:\n            normalized.append({\n                "segment_id": f"{record_id}-S1",\n                "span_text": str(raw_reason_text) if pd.notna(raw_reason_text) else "",\n                "pred_code": "UNKNOWN",\n                "pred_label": "",\n                "confidence": 0.05,\n                "rationale": "Unable to parse or match text"\n            })\n        \n        records.append({\n            "record_id": record_id,\n            "product_id": product_id,\n            "station": station,\n            "engineer_id": engineer_id,\n            "raw_reason_text": str(raw_reason_text) if pd.notna(raw_reason_text) else "",\n            "normalized": normalized\n        })\n        \n        if (idx + 1) % 1000 == 0:\n            print(f"Processed {idx + 1} records...")\n    \n    return {"records": records}\n\nif __name__ == "__main__":\n    print("Starting normalization...")\n    result = process_records()\n    \n    # Save output\n    with open(\'/app/output/solution.json\', \'w\', encoding=\'utf-8\') as f:\n        json.dump(result, f, ensure_ascii=False, indent=2)\n    \n    print(f"Done! Processed {len(result[\'records\'])} records.")\n    print(f"Output saved to /app/output/solution.json")\nENDSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
