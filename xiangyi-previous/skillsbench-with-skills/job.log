rts)\n        except Exception:\n            return ''\n    return ''\n\nfiles = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\nresults = {}\nfor f in files:\n    t = extract_text(f)\n    cat = None\n    for c in ['black_hole','DNA','music_history','LLM']:\n        if any(r.search(t) for r in regex[c]):\n            cat = c\n            break\n    if cat is None:\n        cat = 'trapped_ion_and_qc'\n    results[f]=cat\n\nfrom collections import Counter\nprint('Counts:', Counter(results.values()))\n# list LLM files\nprint('\\nLLM files:', [f for f,c in results.items() if c=='LLM'])\nprint('\\nMusic files:', [f for f,c in results.items() if c=='music_history'])\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
