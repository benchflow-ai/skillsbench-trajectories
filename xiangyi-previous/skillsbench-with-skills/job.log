Sending keys: ['cat > dicke_model.py << \'EOF\'\nimport numpy as np\nfrom qutip import *\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# System parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0\nomega_c = 1.0\ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\n\n# Wigner function grid parameters\ngrid_points = 1000\nx_range = 6.0\np_range = 6.0\n\nprint("Initializing Dicke model simulation...")\nprint(f"Parameters: N={N}, omega_0={omega_0}, omega_c={omega_c}, g={g:.4f}, kappa={kappa}, n_max={n_max}")\n\n# Create basic operators\na = destroy(n_max)\nI_cav = qeye(n_max)\nI_spin = qeye(2)\n\n# Single spin operators\njz = 0.5 * sigmaz()\njp = (sigmax() + 1j*sigmay()) / 2.0\njm = (sigmax() - 1j*sigmay()) / 2.0\n\nprint("Building Hamiltonian operators...")\n\n# Build Jz by explicit summation\nJz_terms = []\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = jz\n    Jz_terms.append(tensor(I_cav, tensor(ops)))\nJz = sum(Jz_terms)\n\n# Build Jp by explicit summation\nJp_terms = []\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = jp\n    Jp_terms.append(tensor(I_cav, tensor(ops)))\nJp = sum(Jp_terms)\n\n# Build Jm by explicit summation\nJm_terms = []\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = jm\n    Jm_terms.append(tensor(I_cav, tensor(ops)))\nJm = sum(Jm_terms)\n\nprint(f"Jz dims: {Jz.dims}")\nprint(f"Jp dims: {Jp.dims}")\nprint(f"Jm dims: {Jm.dims}")\n\n# Cavity operators\na_full = tensor(a, qeye(2**N))\na_dag = a_full.dag()\nN_cav_full = tensor(num(n_max), qeye(2**N))\n\nprint(f"a_full dims: {a_full.dims}")\nprint(f"N_cav_full dims: {N_cav_full.dims}")\n\n# Hamiltonian\nH = omega_0 * Jz + omega_c * N_cav_full + g * (a_full + a_dag) * (Jp + Jm)\n\nprint("Hamiltonian constructed.")\nprint(f"Hilbert space dimension: {H.dims}")\nprint("\\nSolving for steady states...")\n\n# ============================================================================\n# Case 1: Local dephasing & local pumping\n# ============================================================================\nprint("\\nCase 1: Local dephasing & local pumping")\ngamma_phi_1 = 0.01\ngamma_up_1 = 0.1\n\nc_ops_1 = [np.sqrt(kappa) * a_full]\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_1.append(np.sqrt(gamma_phi_1) * tensor(I_cav, tensor(ops)))\n    \n    ops[i] = (I_spin - sigmaz()) / 2.0\n    c_ops_1.append(np.sqrt(gamma_up_1) * tensor(I_cav, tensor(ops)))\n\nprint(f"Collapse operators: {len(c_ops_1)}")\nrho_ss_1 = steadystate(H, c_ops_1, method=\'direct\')\nprint("Steady state found.")\n\n# ============================================================================\n# Case 2: Local dephasing & local emission\n# ============================================================================\nprint("\\nCase 2: Local dephasing & local emission")\ngamma_phi_2 = 0.01\ngamma_down_2 = 0.1\n\nc_ops_2 = [np.sqrt(kappa) * a_full]\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_2.append(np.sqrt(gamma_phi_2) * tensor(I_cav, tensor(ops)))\n    \n    ops[i] = jm\n    c_ops_2.append(np.sqrt(gamma_down_2) * tensor(I_cav, tensor(ops)))\n\nprint(f"Collapse operators: {len(c_ops_2)}")\nrho_ss_2 = steadystate(H, c_ops_2, method=\'direct\')\nprint("Steady state found.")\n\n# ============================================================================\n# Case 3: Local dephasing & local emission & collective pumping\n# ============================================================================\nprint("\\nCase 3: Local dephasing & local emission & collective pumping")\ngamma_phi_3 = 0.01\ngamma_down_3 = 0.1\ngamma_coll_up_3 = 0.1\n\nc_ops_3 = [np.sqrt(kappa) * a_full]\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_3.append(np.sqrt(gamma_phi_3) * tensor(I_cav, tensor(ops)))\n    \n    ops[i] = jm\n    c_ops_3.append(np.sqrt(gamma_down_3) * tensor(I_cav, tensor(ops)))\n\nc_ops_3.append(np.sqrt(gamma_coll_up_3) * Jp)\n\nprint(f"Collapse operators: {len(c_ops_3)}")\nrho_ss_3 = steadystate(H, c_ops_3, method=\'direct\')\nprint("Steady state found.")\n\n# ============================================================================\n# Case 4: Local dephasing & local emission & collective emission\n# ============================================================================\nprint("\\nCase 4: Local dephasing & local emission & collective emission")\ngamma_phi_4 = 0.01\ngamma_down_4 = 0.1\ngamma_coll_down_4 = 0.1\n\nc_ops_4 = [np.sqrt(kappa) * a_full]\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    ops[i] = sigmaz()\n    c_ops_4.append(np.sqrt(gamma_phi_4) * tensor(I_cav, tensor(ops)))\n    \n    ops[i] = jm\n    c_ops_4.append(np.sqrt(gamma_down_4) * tensor(I_cav, tensor(ops)))\n\nc_ops_4.append(np.sqrt(gamma_coll_down_4) * Jm)\n\nprint(f"Collapse operators: {len(c_ops_4)}")\nrho_ss_4 = steadystate(H, c_ops_4, method=\'direct\')\nprint("Steady state found.")\n\nprint("\\nTracing out spins...")\nrho_cav_1 = ptrace(rho_ss_1, 0)\nrho_cav_2 = ptrace(rho_ss_2, 0)\nrho_cav_3 = ptrace(rho_ss_3, 0)\nrho_cav_4 = ptrace(rho_ss_4, 0)\nprint("Done.")\n\nprint("\\nCalculating Wigner functions...")\nxvec = np.linspace(-x_range, x_range, grid_points)\npvec = np.linspace(-p_range, p_range, grid_points)\n\nprint("W1...")\nW1 = wigner(rho_cav_1, xvec, pvec)\nprint("W2...")\nW2 = wigner(rho_cav_2, xvec, pvec)\nprint("W3...")\nW3 = wigner(rho_cav_3, xvec, pvec)\nprint("W4...")\nW4 = wigner(rho_cav_4, xvec, pvec)\n\nprint("\\nSaving to CSV...")\nnp.savetxt(\'1.csv\', W1, delimiter=\',\')\nnp.savetxt(\'2.csv\', W2, delimiter=\',\')\nnp.savetxt(\'3.csv\', W3, delimiter=\',\')\nnp.savetxt(\'4.csv\', W4, delimiter=\',\')\n\nprint("\\nComplete!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
