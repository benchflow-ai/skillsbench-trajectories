Sending keys: ["python3<<'EOF'>/root/out.log 2>&1\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom itertools import product\nprint('Starting')\ncs=pd.read_csv('/root/data/citsci_train.csv')[['file_rad','x','y']]\nex=pd.read_csv('/root/data/expert_train.csv')[['file_rad','x','y']]\nim=ex['file_rad'].unique()\nid={i:(cs[cs['file_rad']==i][['x','y']].values,ex[ex['file_rad']==i][['x','y']].values)for i in im}\ndef dm(X,w):\n n=len(X);D=np.zeros((n,n))\n for i in range(n):\n  for j in range(i+1,n):\n   D[i,j]=D[j,i]=np.sqrt((w*(X[i,0]-X[j,0]))**2+((2-w)*(X[i,1]-X[j,1]))**2)\n return D\ndef gm(c,e):\n if len(c)==0 or len(e)==0:return[],[]\n d=cdist(c,e);mc,me,uc,ue=[],[],set(),set()\n while True:\n  md=d.copy()\n  for i in uc:md[i,:]=1e9\n  for j in ue:md[:,j]=1e9\n  if md.min()>100:break\n  i,j=np.unravel_index(md.argmin(),md.shape);mc.append(i);me.append(j);uc.add(i);ue.add(j)\n return mc,me\ndef ev(c,e,ms,ep,sw):\n if len(c)==0:return 0.,np.nan\n l=DBSCAN(eps=ep,min_samples=ms,metric='precomputed').fit_predict(dm(c,sw));u=set(l)-{-1}\n if not u:return 0.,np.nan\n ct=np.array([c[l==x].mean(0)for x in u]);mc,me=gm(ct,e);nm=len(mc)\n if nm==0:return 0.,np.nan\n p,r=nm/len(ct),nm/len(e);return 2*p*r/(p+r),np.mean([np.linalg.norm(ct[i]-e[j])for i,j in zip(mc,me)])\npm=list(product(range(3,10),range(4,26,2),[.9+i*.1 for i in range(11)]))\nrs=[]\nfor k,(ms,ep,sw)in enumerate(pm):\n if k%100==0:print(f'{k}/{len(pm)}')\n f1s,dts=[],[]\n for i in im:\n  f1,dt=ev(*id[i],ms,ep,sw);f1s.append(f1)\n  if not np.isnan(dt):dts.append(dt)\n rs.append((np.mean(f1s),np.mean(dts)if dts else np.nan,ms,ep,round(sw,1)))\nft=[(f1,d,ms,ep,sw)for f1,d,ms,ep,sw in rs if f1>.5 and not np.isnan(d)]\nprint(f'Filtered:{len(ft)}')\nif ft:\n cs=np.array([[f1,d]for f1,d,*_ in ft]);pr=[]\n for i in range(len(ft)):\n  if not any(i!=j and cs[j,0]>=cs[i,0]and cs[j,1]<=cs[i,1]and(cs[j,0]>cs[i,0]or cs[j,1]<cs[i,1])for j in range(len(ft))):pr.append(ft[i])\n pr.sort(reverse=True)\n open('/root/pareto_frontier.csv','w').write('F1,delta,min_samples,epsilon,shape_weight\\n'+''.join(f'{f1:.5f},{d:.5f},{ms},{ep},{sw:.1f}\\n'for f1,d,ms,ep,sw in pr))\n print(f'Wrote {len(pr)}')\nprint('Done')\nEOF\ncat /root/out.log;cat /root/pareto_frontier.csv\n"] min_timeout_sec: 60.0 max_timeout_sec: 180.0
