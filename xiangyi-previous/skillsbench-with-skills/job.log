Sending keys: ['python3 << \'EOF\'\nimport openpyxl\n\n# Load the workbook\nwb = openpyxl.load_workbook(\'gdp.xlsx\')\ntask_sheet = wb[\'Task\']\n\ncols = [\'H\', \'I\', \'J\', \'K\', \'L\']\n\n# Step 2: Net exports as % of GDP in H35:L40\n# Net Exports % of GDP = (Exports - Imports) / GDP * 100\n# Row mapping:\n# 35 -> UAE: exports row 12, imports row 19, GDP row 26\n# 36 -> Bahrain: exports row 13, imports row 20, GDP row 27\n# 37 -> Kuwait: exports row 14, imports row 21, GDP row 28\n# 38 -> Qatar: exports row 15, imports row 22, GDP row 29\n# 39 -> Oman: exports row 16, imports row 23, GDP row 30\n# 40 -> Saudi Arabia: exports row 17, imports row 24, GDP row 31\n\nrow_mapping = {\n    35: (12, 19, 26),  # UAE\n    36: (13, 20, 27),  # Bahrain\n    37: (14, 21, 28),  # Kuwait\n    38: (15, 22, 29),  # Qatar\n    39: (16, 23, 30),  # Oman\n    40: (17, 24, 31),  # Saudi Arabia\n}\n\nprint("=== Step 2: Net Exports as % of GDP ===")\nfor row in range(35, 41):\n    exp_row, imp_row, gdp_row = row_mapping[row]\n    for col in cols:\n        # Formula: (Exports - Imports) / GDP * 100\n        formula = f\'=({col}{exp_row}-{col}{imp_row})/{col}{gdp_row}*100\'\n        task_sheet[f\'{col}{row}\'] = formula\n        print(f\'{col}{row}: {formula}\')\n\nprint("\\n=== Step 2: Statistics ===")\n# Row 42: min\n# Row 43: max\n# Row 44: median\n# Row 45: simple mean (AVERAGE)\n# Row 46: 25th percentile\n# Row 47: 75th percentile\n\nfor col in cols:\n    # MIN\n    formula = f\'=MIN({col}35:{col}40)\'\n    task_sheet[f\'{col}42\'] = formula\n    print(f\'{col}42: {formula}\')\n    \n    # MAX\n    formula = f\'=MAX({col}35:{col}40)\'\n    task_sheet[f\'{col}43\'] = formula\n    print(f\'{col}43: {formula}\')\n    \n    # MEDIAN\n    formula = f\'=MEDIAN({col}35:{col}40)\'\n    task_sheet[f\'{col}44\'] = formula\n    print(f\'{col}44: {formula}\')\n    \n    # Simple mean (AVERAGE)\n    formula = f\'=AVERAGE({col}35:{col}40)\'\n    task_sheet[f\'{col}45\'] = formula\n    print(f\'{col}45: {formula}\')\n    \n    # 25th percentile\n    formula = f\'=PERCENTILE({col}35:{col}40,0.25)\'\n    task_sheet[f\'{col}46\'] = formula\n    print(f\'{col}46: {formula}\')\n    \n    # 75th percentile\n    formula = f\'=PERCENTILE({col}35:{col}40,0.75)\'\n    task_sheet[f\'{col}47\'] = formula\n    print(f\'{col}47: {formula}\')\n\nprint("\\n=== Step 3: Weighted Mean using SUMPRODUCT ===")\n# Weighted mean = SUMPRODUCT(net_exports_pct * GDP) / SUM(GDP)\n# This weights each country\'s net exports % by their GDP\nfor col in cols:\n    # SUMPRODUCT formula: sum of (net exports % * GDP) / sum of GDP\n    # Net exports % is in rows 35-40, GDP is in rows 26-31\n    formula = f\'=SUMPRODUCT({col}35:{col}40,{col}26:{col}31)/SUM({col}26:{col}31)\'\n    task_sheet[f\'{col}50\'] = formula\n    print(f\'{col}50: {formula}\')\n\n# Save the workbook\nwb.save(\'gdp.xlsx\')\nprint("\\nAll formulas saved!")\nwb.close()\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
