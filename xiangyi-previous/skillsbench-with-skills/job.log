Sending keys: ['cat > dicke_simulation.py << \'EOF\'\nimport numpy as np\nimport qutip as qt\nimport csv\n\n# Parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0  # Atomic frequency\nomega_c = 1.0  # Cavity frequency\ng = 2.0 / np.sqrt(N)  # Coupling strength\nkappa = 1.0  # Cavity loss rate\nn_max = 16  # Photon number cutoff\n\nprint("Setting up Dicke model simulation...")\nprint(f"Parameters: N={N}, ω0={omega_0}, ωc={omega_c}, g={g:.4f}, κ={kappa}, n_max={n_max}")\n\n# Helper function to create operator acting on i-th spin\ndef spin_operator(op, i, N, n_max):\n    """\n    Create operator acting on i-th spin (0-indexed) in a system of N spins\n    coupled to a cavity.\n    op: single spin operator (sigmaz, sigmap, sigmam)\n    i: index of spin (0 to N-1)\n    N: total number of spins\n    n_max: cavity Fock space dimension\n    """\n    op_list = [qt.qeye(n_max)]  # Cavity\n    for j in range(N):\n        if j == i:\n            op_list.append(op)\n        else:\n            op_list.append(qt.qeye(2))  # Identity for other spins\n    return qt.tensor(op_list)\n\n# Create collective operators\ndef collective_operator(op, N, n_max):\n    """\n    Create collective operator sum_i op_i\n    """\n    result = 0\n    for i in range(N):\n        result += spin_operator(op, i, N, n_max)\n    return result\n\n# Build operators\nprint("Building operators...")\n# Cavity operators\nop_list_a = [qt.destroy(n_max)] + [qt.qeye(2) for _ in range(N)]\na = qt.tensor(op_list_a)\n\n# Collective spin operators\nJz = collective_operator(qt.sigmaz() / 2.0, N, n_max)\nJp = collective_operator(qt.sigmap(), N, n_max)\nJm = collective_operator(qt.sigmam(), N, n_max)\n\n# Hamiltonian\nprint("Constructing Hamiltonian...")\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\nprint("Hamiltonian constructed.")\nprint(f"Hilbert space dimension: {H.shape[0]}")\n\n# Function to solve for steady state and calculate Wigner function\ndef solve_case(case_num, collapse_ops, description):\n    print(f"\\n{\'=\'*60}")\n    print(f"Case {case_num}: {description}")\n    print(f"{\'=\'*60}")\n    \n    # Add cavity loss to all cases\n    c_ops = [np.sqrt(kappa) * a] + collapse_ops\n    \n    print(f"Number of collapse operators: {len(c_ops)}")\n    \n    # Solve for steady state\n    print("Solving for steady state...")\n    rho_ss = qt.steadystate(H, c_ops, method=\'direct\')\n    print("Steady state found.")\n    \n    # Trace out spins to get cavity state\n    print("Tracing out spin degrees of freedom...")\n    # Keep subsystem 0 (cavity), trace out subsystems 1 to N (spins)\n    rho_cavity = rho_ss.ptrace(0)\n    print(f"Cavity density matrix dimension: {rho_cavity.shape[0]}")\n    \n    # Calculate Wigner function\n    print("Calculating Wigner function on 1000x1000 grid...")\n    xvec = np.linspace(-6, 6, 1000)\n    pvec = np.linspace(-6, 6, 1000)\n    W = qt.wigner(rho_cavity, xvec, pvec)\n    \n    # Save to CSV\n    filename = f"{case_num}.csv"\n    print(f"Saving Wigner function to {filename}...")\n    np.savetxt(filename, W, delimiter=\',\')\n    print(f"Saved {filename} with shape {W.shape}")\n    \n    return W\n\n# Case 1: Local dephasing & local pumping\nprint("\\n" + "#"*60)\nprint("Starting Case 1")\nprint("#"*60)\ngamma_phi = 0.01\ngamma_up = 0.1\n\ncollapse_ops_1 = []\n\n# Local dephasing on each spin\nfor i in range(N):\n    sz_i = spin_operator(qt.sigmaz(), i, N, n_max)\n    collapse_ops_1.append(np.sqrt(gamma_phi) * sz_i)\n\n# Local pumping on each spin  \nfor i in range(N):\n    sp_i = spin_operator(qt.sigmap(), i, N, n_max)\n    collapse_ops_1.append(np.sqrt(gamma_up) * sp_i)\n\nW1 = solve_case(1, collapse_ops_1, "Local dephasing & local pumping")\n\n# Case 2: Local dephasing & local emission\nprint("\\n" + "#"*60)\nprint("Starting Case 2")\nprint("#"*60)\ngamma_phi = 0.01\ngamma_down = 0.1\n\ncollapse_ops_2 = []\n\n# Local dephasing on each spin\nfor i in range(N):\n    sz_i = spin_operator(qt.sigmaz(), i, N, n_max)\n    collapse_ops_2.append(np.sqrt(gamma_phi) * sz_i)\n\n# Local emission on each spin\nfor i in range(N):\n    sm_i = spin_operator(qt.sigmam(), i, N, n_max)\n    collapse_ops_2.append(np.sqrt(gamma_down) * sm_i)\n\nW2 = solve_case(2, collapse_ops_2, "Local dephasing & local emission")\n\n# Case 3: Local dephasing & local emission & collective pumping\nprint("\\n" + "#"*60)\nprint("Starting Case 3")\nprint("#"*60)\ngamma_phi = 0.01\ngamma_down = 0.1\ngamma_Up = 0.1\n\ncollapse_ops_3 = []\n\n# Local dephasing on each spin\nfor i in range(N):\n    sz_i = spin_operator(qt.sigmaz(), i, N, n_max)\n    collapse_ops_3.append(np.sqrt(gamma_phi) * sz_i)\n\n# Local emission on each spin\nfor i in range(N):\n    sm_i = spin_operator(qt.sigmam(), i, N, n_max)\n    collapse_ops_3.append(np.sqrt(gamma_down) * sm_i)\n\n# Collective pumping\ncollapse_ops_3.append(np.sqrt(gamma_Up) * Jp)\n\nW3 = solve_case(3, collapse_ops_3, "Local dephasing & local emission & collective pumping")\n\n# Case 4: Local dephasing & local emission & collective emission\nprint("\\n" + "#"*60)\nprint("Starting Case 4")\nprint("#"*60)\ngamma_phi = 0.01\ngamma_down = 0.1\ngamma_Down = 0.1\n\ncollapse_ops_4 = []\n\n# Local dephasing on each spin\nfor i in range(N):\n    sz_i = spin_operator(qt.sigmaz(), i, N, n_max)\n    collapse_ops_4.append(np.sqrt(gamma_phi) * sz_i)\n\n# Local emission on each spin\nfor i in range(N):\n    sm_i = spin_operator(qt.sigmam(), i, N, n_max)\n    collapse_ops_4.append(np.sqrt(gamma_down) * sm_i)\n\n# Collective emission\ncollapse_ops_4.append(np.sqrt(gamma_Down) * Jm)\n\nW4 = solve_case(4, collapse_ops_4, "Local dephasing & local emission & collective emission")\n\nprint("\\n" + "="*60)\nprint("All simulations completed successfully!")\nprint("="*60)\nprint("\\nGenerated files:")\nfor i in range(1, 5):\n    print(f"  {i}.csv - Wigner function for case {i}")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
