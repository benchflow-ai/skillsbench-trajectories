Sending keys: ["python3 - <<'PY'\nimport pandas as pd, numpy as np, json, math\nfrom pathlib import Path\n\n# Load data\nmes = pd.read_csv('/app/data/mes_log.csv')\nthermo = pd.read_csv('/app/data/thermocouples.csv')\ndefects = pd.read_csv('/app/data/test_defects.csv')\n\n# Helper: compute max ramp rate in preheat (100-150C) for a given df\nPREHEAT_MIN = 100.0\nPREHEAT_MAX = 150.0\n\n# choose representative TC for ramp: smallest_mass if available\n\ndef get_tc_for_location(run_df, location):\n    sub = run_df[run_df['tc_location'] == location]\n    if sub.empty:\n        return None\n    # choose first tc_id\n    return sub['tc_id'].iloc[0]\n\n# compute max ramp rate within region using linear segments\n\ndef max_ramp_preheat(df):\n    if df.empty:\n        return None\n    df = df.sort_values('time_s')\n    max_slope = None\n    times = df['time_s'].values\n    temps = df['temp_c'].values\n    for i in range(len(df)-1):\n        t1, t2 = times[i], times[i+1]\n        T1, T2 = temps[i], temps[i+1]\n        if t2 == t1:\n            continue\n        # if segment intersects preheat region\n        if max(T1, T2) < PREHEAT_MIN or min(T1, T2) > PREHEAT_MAX:\n            continue\n        slope = (T2 - T1) / (t2 - t1)\n        if max_slope is None or slope > max_slope:\n            max_slope = slope\n    return max_slope\n\n# compute TAL (time above liquidus) using linear interpolation\n\ndef time_above_threshold(df, thr):\n    if df.empty:\n        return None\n    df = df.sort_values('time_s')\n    times = df['time_s'].values\n    temps = df['temp_c'].values\n    total = 0.0\n    for i in range(len(df)-1):\n        t1, t2 = times[i], times[i+1]\n        T1, T2 = temps[i], temps[i+1]\n        if t2 == t1:\n            continue\n        if T1 >= thr and T2 >= thr:\n            total += (t2 - t1)\n        elif T1 < thr and T2 > thr:\n            # crossing upward\n            frac = (T2 - thr) / (T2 - T1)\n            total += (t2 - t1) * frac\n        elif T1 > thr and T2 < thr:\n            # crossing downward\n            frac = (T1 - thr) / (T1 - T2)\n            total += (t2 - t1) * frac\n        else:\n            # both below\n            pass\n    return total\n\n# Create output directory\nPath('/app/output').mkdir(parents=True, exist_ok=True)\n\n# Q1: ramp rate\nramp_limit = 2.0\nq1_max_by_run = {}\nviolating = []\n\nfor run_id, run_df in thermo.groupby('run_id'):\n    tc_id = get_tc_for_location(run_df, 'smallest_mass')\n    if tc_id is None:\n        # fallback: use first tc_id\n        tc_id = run_df['tc_id'].iloc[0] if not run_df.empty else None\n        df_tc = run_df[run_df['tc_id']==tc_id] if tc_id else pd.DataFrame()\n    else:\n        df_tc = run_df[run_df['tc_id']==tc_id]\n    max_ramp = max_ramp_preheat(df_tc)\n    q1_max_by_run[run_id] = {\n        'tc_id': tc_id if tc_id is not None else None,\n        'max_preheat_ramp_c_per_s': round(max_ramp,2) if max_ramp is not None else None\n    }\n    if max_ramp is not None and max_ramp > ramp_limit:\n        violating.append(run_id)\n\n# ensure all runs in mes_log included, even if no thermo\nfor run_id in mes['run_id']:\n    if run_id not in q1_max_by_run:\n        q1_max_by_run[run_id] = {'tc_id': None, 'max_preheat_ramp_c_per_s': None}\n\nviolating = sorted(set(violating))\n\nq1 = {\n    'ramp_rate_limit_c_per_s': ramp_limit,\n    'violating_runs': violating,\n    'max_ramp_by_run': {k: q1_max_by_run[k] for k in sorted(q1_max_by_run.keys())}\n}\n\nPath('/app/output/q01.json').write_text(json.dumps(q1, indent=2))\n\n# Q2: TAL\nTAL_MIN = 30.0\nTAL_MAX = 60.0\nq2_list = []\n\nfor run_id in sorted(mes['run_id'].unique()):\n    run_mes = mes[mes['run_id']==run_id].iloc[0]\n    liquidus = run_mes['solder_liquidus_c']\n    run_tc = thermo[thermo['run_id']==run_id]\n    if run_tc.empty:\n        q2_list.append({\n            'run_id': run_id,\n            'tc_id': None,\n            'tal_s': None,\n            'required_min_tal_s': TAL_MIN,\n            'required_max_tal_s': TAL_MAX,\n            'status': 'non-compliant'\n        })\n        continue\n    tc_id = get_tc_for_location(run_tc, 'largest_mass')\n    if tc_id is None:\n        tc_id = run_tc['tc_id'].iloc[0]\n    df_tc = run_tc[run_tc['tc_id']==tc_id]\n    tal = time_above_threshold(df_tc, liquidus)\n    status = 'compliant' if tal is not None and (TAL_MIN <= tal <= TAL_MAX) else 'non-compliant'\n    q2_list.append({\n        'run_id': run_id,\n        'tc_id': tc_id,\n        'tal_s': round(tal,2) if tal is not None else None,\n        'required_min_tal_s': TAL_MIN,\n        'required_max_tal_s': TAL_MAX,\n        'status': status\n    })\n\nPath('/app/output/q02.json').write_text(json.dumps(q2_list, indent=2))\n\n# Q3: peak temperature requirement\nq3_min_peak = {}\nfail_runs = []\n\nfor run_id in sorted(mes['run_id'].unique()):\n    run_mes = mes[mes['run_id']==run_id].iloc[0]\n    liquidus = run_mes['solder_liquidus_c']\n    required_min_peak = liquidus + 20.0\n    run_tc = thermo[thermo['run_id']==run_id]\n    if run_tc.empty:\n        q3_min_peak[run_id] = {'tc_id': None, 'peak_temp_c': None, 'required_min_peak_c': round(required_min_peak,2)}\n        fail_runs.append(run_id)\n        continue\n    tc_id = get_tc_for_location(run_tc, 'largest_mass')\n    if tc_id is None:\n        tc_id = run_tc['tc_id'].iloc[0]\n    df_tc = run_tc[run_tc['tc_id']==tc_id]\n    peak = df_tc['temp_c'].max() if not df_tc.empty else None\n    q3_min_peak[run_id] = {'tc_id': tc_id, 'peak_temp_c': round(float(peak),2) if peak is not None else None, 'required_min_peak_c': round(required_min_peak,2)}\n    if peak is None or peak < required_min_peak:\n        fail_runs.append(run_id)\n\nq3 = {\n    'failing_runs': sorted(set(fail_runs)),\n    'min_peak_by_run': {k: q3_min_peak[k] for k in sorted(q3_min_peak.keys())}\n}\nPath('/app/output/q03.json').write_text(json.dumps(q3, indent=2))\n\n# Q4: conveyor speed feasibility using line speed formula\n# LINE SPEED = boards per minute * length per board / loading factor\nq4_list = []\nfor run_id in sorted(mes['run_id'].unique()):\n    row = mes[mes['run_id']==run_id].iloc[0]\n    bpm = row['boards_per_min']\n    length = row['board_length_cm']\n    load_factor = row['loading_factor']\n    actual = row['conveyor_speed_cm_min']\n    if pd.isna(bpm) or pd.isna(length) or pd.isna(load_factor) or load_factor==0:\n        req = None\n    else:\n        req = bpm * length / load_factor\n    meets = (actual >= req) if (req is not None and not pd.isna(actual)) else False\n    q4_list.append({\n        'run_id': run_id,\n        'required_min_speed_cm_min': round(req,2) if req is not None else None,\n        'actual_speed_cm_min': round(actual,2) if not pd.isna(actual) else None,\n        'meets': bool(meets)\n    })\n\nPath('/app/output/q04.json').write_text(json.dumps(q4_list, indent=2))\n\n# Q5: best run per board_family based on quality and efficiency\n# Use yield summary (fp_yield_pct) as quality; boards_per_min as efficiency; downtime_s as tiebreaker (lower better)\n# Create yield per run from defects summary\nsummary = defects[(defects['inspection_stage']=='SUMMARY') & (defects['defect_type']=='yield_summary')][['run_id','fp_yield_pct']]\nsummary = summary.drop_duplicates(subset=['run_id'])\n\n# merge with mes\nmes_q5 = mes.merge(summary, on='run_id', how='left')\n\nq5_list = []\nfor fam, fam_df in mes_q5.groupby('board_family'):\n    # sort by yield desc, boards_per_min desc, downtime_s asc\n    fam_df = fam_df.copy()\n    fam_df['fp_yield_pct'] = fam_df['fp_yield_pct'].fillna(-1)\n    fam_df['boards_per_min'] = fam_df['boards_per_min'].fillna(-1)\n    fam_df['downtime_s'] = fam_df['downtime_s'].fillna(1e9)\n    fam_df = fam_df.sort_values(by=['fp_yield_pct','boards_per_min','downtime_s','run_id'], ascending=[False,False,True,True])\n    best_run = fam_df.iloc[0]['run_id']\n    runner_up = [r for r in fam_df['run_id'].tolist() if r != best_run]\n    q5_list.append({'board_family': fam, 'best_run_id': best_run, 'runner_up_run_ids': runner_up})\n\nq5_list = sorted(q5_list, key=lambda x: x['board_family'])\nPath('/app/output/q05.json').write_text(json.dumps(q5_list, indent=2))\n\nprint('Generated outputs')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
