Sending keys: ['cat > test_parallel.py << \'EOF\'\n#!/usr/bin/env python3\n"""\nTest script for parallel TF-IDF implementation.\n"""\n\nimport time\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\n\ndef compare_indexes(seq_index, par_index):\n    """Compare sequential and parallel indexes for correctness."""\n    errors = []\n    \n    # Check basic properties\n    if seq_index.num_documents != par_index.num_documents:\n        errors.append(f"num_documents mismatch: {seq_index.num_documents} vs {par_index.num_documents}")\n    \n    if seq_index.vocabulary != par_index.vocabulary:\n        errors.append(f"vocabulary mismatch: {len(seq_index.vocabulary)} vs {len(par_index.vocabulary)}")\n    \n    # Check IDF values\n    for term in seq_index.idf:\n        if term not in par_index.idf:\n            errors.append(f"term {term} missing in parallel IDF")\n        else:\n            seq_val = seq_index.idf[term]\n            par_val = par_index.idf[term]\n            if abs(seq_val - par_val) > 1e-9:\n                errors.append(f"IDF mismatch for term {term}: {seq_val} vs {par_val}")\n    \n    # Check doc vectors\n    for doc_id in seq_index.doc_vectors:\n        if doc_id not in par_index.doc_vectors:\n            errors.append(f"doc_id {doc_id} missing in parallel doc_vectors")\n        else:\n            seq_vec = seq_index.doc_vectors[doc_id]\n            par_vec = par_index.doc_vectors[doc_id]\n            if set(seq_vec.keys()) != set(par_vec.keys()):\n                errors.append(f"doc_vector keys mismatch for doc {doc_id}")\n            else:\n                for term in seq_vec:\n                    if abs(seq_vec[term] - par_vec[term]) > 1e-9:\n                        errors.append(f"doc_vector mismatch for doc {doc_id}, term {term}")\n    \n    # Check doc norms\n    for doc_id in seq_index.doc_norms:\n        if doc_id not in par_index.doc_norms:\n            errors.append(f"doc_id {doc_id} missing in parallel doc_norms")\n        else:\n            seq_norm = seq_index.doc_norms[doc_id]\n            par_norm = par_index.doc_norms[doc_id]\n            if abs(seq_norm - par_norm) > 1e-9:\n                errors.append(f"doc_norm mismatch for doc {doc_id}: {seq_norm} vs {par_norm}")\n    \n    return errors\n\n\ndef compare_search_results(seq_results, par_results, tolerance=1e-6):\n    """Compare search results from sequential and parallel implementations."""\n    errors = []\n    \n    if len(seq_results) != len(par_results):\n        errors.append(f"number of queries mismatch: {len(seq_results)} vs {len(par_results)}")\n        return errors\n    \n    for q_idx, (seq_res, par_res) in enumerate(zip(seq_results, par_results)):\n        if len(seq_res) != len(par_res):\n            errors.append(f"query {q_idx}: result count mismatch: {len(seq_res)} vs {len(par_res)}")\n        else:\n            for i, (seq_r, par_r) in enumerate(zip(seq_res, par_res)):\n                if seq_r.doc_id != par_r.doc_id:\n                    errors.append(f"query {q_idx}, result {i}: doc_id mismatch: {seq_r.doc_id} vs {par_r.doc_id}")\n                if abs(seq_r.score - par_r.score) > tolerance:\n                    errors.append(f"query {q_idx}, result {i}: score mismatch: {seq_r.score} vs {par_r.score}")\n    \n    return errors\n\n\ndef main():\n    print("=" * 70)\n    print("Testing Parallel TF-IDF Implementation")\n    print("=" * 70)\n    \n    # Generate test corpus\n    print("\\nGenerating test corpus...")\n    num_docs = 2000\n    documents = generate_corpus(num_docs, seed=42)\n    print(f"Generated {len(documents)} documents")\n    \n    # Test 1: Index building correctness\n    print("\\n" + "=" * 70)\n    print("Test 1: Index Building Correctness")\n    print("=" * 70)\n    \n    print("\\nBuilding sequential index...")\n    seq_result = build_tfidf_index_sequential(documents)\n    print(f"Sequential index built in {seq_result.elapsed_time:.3f}s")\n    print(f"  Vocabulary size: {seq_result.vocabulary_size:,}")\n    print(f"  Documents: {seq_result.num_documents}")\n    \n    print("\\nBuilding parallel index (1 worker)...")\n    par_result_1 = build_tfidf_index_parallel(documents, num_workers=1)\n    print(f"Parallel index built in {par_result_1.elapsed_time:.3f}s")\n    print(f"  Vocabulary size: {par_result_1.vocabulary_size:,}")\n    print(f"  Documents: {par_result_1.num_documents}")\n    \n    errors = compare_indexes(seq_result.index, par_result_1.index)\n    if errors:\n        print(f"\\n❌ Correctness check FAILED with {len(errors)} errors:")\n        for error in errors[:5]:\n            print(f"  - {error}")\n        if len(errors) > 5:\n            print(f"  ... and {len(errors) - 5} more errors")\n    else:\n        print("\\n✓ Indexes are identical (correctness verified)")\n    \n    # Test 2: Index building performance\n    print("\\n" + "=" * 70)\n    print("Test 2: Index Building Performance")\n    print("=" * 70)\n    \n    for num_workers in [2, 4]:\n        print(f"\\nBuilding parallel index ({num_workers} workers)...")\n        par_result = build_tfidf_index_parallel(documents, num_workers=num_workers)\n        print(f"Parallel index built in {par_result.elapsed_time:.3f}s")\n        speedup = seq_result.elapsed_time / par_result.elapsed_time\n        print(f"Speedup: {speedup:.2f}x")\n    \n    # Test 3: Search correctness\n    print("\\n" + "=" * 70)\n    print("Test 3: Search Correctness")\n    print("=" * 70)\n    \n    test_queries = [\n        "machine learning algorithm",\n        "data analysis",\n        "software development",\n        "scientific research",\n        "business strategy",\n    ]\n    \n    print(f"\\nSearching with {len(test_queries)} queries (sequential)...")\n    seq_search_start = time.perf_counter()\n    seq_search_results = batch_search_sequential(test_queries, seq_result.index, top_k=10, documents=documents)\n    seq_search_time = time.perf_counter() - seq_search_start\n    print(f"Sequential search completed in {seq_search_time*1000:.2f}ms")\n    \n    print(f"\\nSearching with {len(test_queries)} queries (parallel, 1 worker)...")\n    par_search_results_1, par_search_time_1 = batch_search_parallel(\n        test_queries, par_result_1.index, top_k=10, num_workers=1, documents=documents\n    )\n    print(f"Parallel search completed in {par_search_time_1*1000:.2f}ms")\n    \n    errors = compare_search_results(seq_search_results, par_search_results_1)\n    if errors:\n        print(f"\\n❌ Search correctness check FAILED with {len(errors)} errors:")\n        for error in errors[:5]:\n            print(f"  - {error}")\n        if len(errors) > 5:\n            print(f"  ... and {len(errors) - 5} more errors")\n    else:\n        print("\\n✓ Search results are identical (correctness verified)")\n    \n    # Test 4: Search performance\n    print("\\n" + "=" * 70)\n    print("Test 4: Search Performance")\n    print("=" * 70)\n    \n    for num_workers in [2, 4]:\n        print(f"\\nSearching with {len(test_queries)} queries (parallel, {num_workers} workers)...")\n        par_search_results, par_search_time = batch_search_parallel(\n            test_queries, par_result_1.index, top_k=10, num_workers=num_workers, documents=documents\n        )\n        print(f"Parallel search completed in {par_search_time*1000:.2f}ms")\n        speedup = seq_search_time / par_search_time\n        print(f"Speedup: {speedup:.2f}x")\n    \n    print("\\n" + "=" * 70)\n    print("All tests completed!")\n    print("=" * 70)\n\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
