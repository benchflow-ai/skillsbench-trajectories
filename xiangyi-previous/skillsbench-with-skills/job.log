Sending keys: ['cat > /root/workspace/solution.py << \'EOF\'\nfrom typing import Any\nfrom fractions import Fraction\nfrom pymatgen.core import Structure\nfrom pymatgen.symmetry.analyzer import SpacegroupAnalyzer\n\n\ndef decimal_to_fraction(val: float, max_denom: int = 12) -> str:\n    """\n    Convert a decimal value to a fraction string with denominator <= max_denom.\n    The value is normalized to [0, 1) range first.\n    """\n    # Normalize to [0, 1) range\n    val = val % 1.0\n    # Handle values very close to 0 or 1\n    if abs(val) < 1e-9:\n        return "0"\n    if abs(val - 1.0) < 1e-9:\n        return "0"\n    \n    frac = Fraction(val).limit_denominator(max_denom)\n    if frac.denominator == 1:\n        return str(frac.numerator % 1) if frac.numerator >= 1 else str(frac.numerator)\n    return f"{frac.numerator}/{frac.denominator}"\n\n\ndef analyze_wyckoff_position_multiplicities_and_coordinates(filepath: str) -> dict[str, dict] | dict[str, Any]:\n    """\n    Analyze a CIF file to extract Wyckoff position multiplicities and \n    calculate approximate coordinates for the first atom of each Wyckoff position.\n    \n    Args:\n        filepath: Path to the CIF file\n        \n    Returns:\n        Dictionary containing:\n        - wyckoff_multiplicity_dict: mapping of Wyckoff letter to multiplicity\n        - wyckoff_coordinates_dict: mapping of Wyckoff letter to list of fractional coordinates\n    """\n    # Read the structure from CIF file\n    structure = Structure.from_file(filepath)\n    \n    # Get symmetry information\n    sga = SpacegroupAnalyzer(structure)\n    symmetrized = sga.get_symmetrized_structure()\n    \n    # Get Wyckoff symbols and equivalent sites\n    wyckoff_symbols = symmetrized.wyckoff_symbols\n    equivalent_sites = symmetrized.equivalent_sites\n    \n    wyckoff_multiplicity_dict = {}\n    wyckoff_coordinates_dict = {}\n    \n    for wsym, sites in zip(wyckoff_symbols, equivalent_sites):\n        # Extract multiplicity (digits) and letter (alphabetic characters)\n        multiplicity = int(\'\'.join(c for c in wsym if c.isdigit()))\n        letter = \'\'.join(c for c in wsym if c.isalpha())\n        \n        # Store multiplicity\n        wyckoff_multiplicity_dict[letter] = multiplicity\n        \n        # Get the first site\'s fractional coordinates\n        first_site = sites[0]\n        frac_coords = first_site.frac_coords\n        \n        # Convert to fraction strings\n        coord_strings = [decimal_to_fraction(c) for c in frac_coords]\n        wyckoff_coordinates_dict[letter] = coord_strings\n    \n    return {\n        "wyckoff_multiplicity_dict": wyckoff_multiplicity_dict,\n        "wyckoff_coordinates_dict": wyckoff_coordinates_dict\n    }\n\n\nif __name__ == "__main__":\n    # Test with the example file\n    result = analyze_wyckoff_position_multiplicities_and_coordinates("/root/cif_files/FeS2_mp-226.cif")\n    print(result)\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
