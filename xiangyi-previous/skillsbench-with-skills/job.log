   new_limit = original_limit * 1.2\n    \n    print(f"\\nModifying branch {branch_idx} (64->1501): {original_limit} MW -> {new_limit} MW")\n    print("Solving counterfactual case...")\n    \n    cf_result = solve_dcopf_with_reserves(data, {branch_idx: new_limit})\n    \n    if cf_result is None or cf_result[\'pg\'] is None:\n        print("Counterfactual case failed to solve")\n        return\n    \n    cf_analysis = analyze_results(cf_result, data)\n    \n    print(f"\\nCounterfactual total cost: ${cf_analysis[\'total_cost_dollars_per_hour\']:.2f}/hr")\n    print(f"Counterfactual binding lines: {len(cf_analysis[\'binding_lines\'])}")\n    \n    cost_reduction = base_analysis[\'total_cost_dollars_per_hour\'] - cf_analysis[\'total_cost_dollars_per_hour\']\n    print(f"\\nCost reduction: ${cost_reduction:.2f}/hr")\n    \n    # Calculate LMP drops\n    lmp_drops = []\n    base_lmps = {item[\'bus\']: item[\'lmp_dollars_per_MWh\'] for item in base_analysis[\'lmp_by_bus\']}\n    cf_lmps = {item[\'bus\']: item[\'lmp_dollars_per_MWh\'] for item in cf_analysis[\'lmp_by_bus\']}\n    \n    for bus in base_lmps:\n        if bus in cf_lmps:\n            delta = cf_lmps[bus] - base_lmps[bus]\n            if delta < 0:\n                lmp_drops.append({\n                    \'bus\': bus,\n                    \'base_lmp\': base_lmps[bus],\n                    \'cf_lmp\': cf_lmps[bus],\n                    \'delta\': delta\n                })\n    \n    lmp_drops.sort(key=lambda x: x[\'delta\'])\n    top_3_drops = lmp_drops[:3] if len(lmp_drops) >= 3 else lmp_drops\n    \n    # Check if congestion is relieved\n    congestion_relieved = True\n    for line in cf_analysis[\'binding_lines\']:\n        if (line[\'from\'] == 64 and line[\'to\'] == 1501) or (line[\'from\'] == 1501 and line[\'to\'] == 64):\n            congestion_relieved = False\n            break\n    \n    report = {\n        \'base_case\': base_analysis,\n        \'counterfactual\': cf_analysis,\n        \'impact_analysis\': {\n            \'cost_reduction_dollars_per_hour\': cost_reduction,\n            \'buses_with_largest_lmp_drop\': top_3_drops,\n            \'congestion_relieved\': congestion_relieved\n        }\n    }\n    \n    with open(\'report.json\', \'w\') as f:\n        json.dump(report, f, indent=2)\n    \n    print("\\nReport saved to report.json")\n    print(f"\\nTop {len(top_3_drops)} buses with largest LMP drops:")\n    for item in top_3_drops:\n        print(f"  Bus {item[\'bus\']}: ${item[\'base_lmp\']:.2f} -> ${item[\'cf_lmp\']:.2f} (${item[\'delta\']:.2f})")\n    print(f"\\nCongestion relieved on line 64->1501: {congestion_relieved}")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
