Sending keys: ['cat > /app/normalize.py << \'EOF\'\nimport csv\nimport json\nimport re\nfrom typing import List, Dict, Tuple\nfrom collections import defaultdict\n\ndef load_codebooks(data_dir=\'/app/data/\'):\n    """Load all codebooks into a dictionary keyed by product_id"""\n    codebooks = {}\n    products = [\'P1_POWER\', \'P2_CTRL\', \'P3_RF\']\n    \n    for product in products:\n        codebooks[product] = []\n        with open(f\'{data_dir}/codebook_{product}.csv\', \'r\', encoding=\'utf-8\') as f:\n            reader = csv.DictReader(f)\n            for row in reader:\n                codebooks[product].append(row)\n    \n    return codebooks\n\ndef load_test_logs(filepath=\'/app/data/test_center_logs.csv\'):\n    """Load test center logs"""\n    logs = []\n    with open(filepath, \'r\', encoding=\'utf-8\') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            logs.append(row)\n    return logs\n\ndef extract_keywords(text):\n    """Extract meaningful keywords from text (both English and Chinese)"""\n    # Convert to lowercase for English matching\n    text_lower = text.lower()\n    \n    # Extract component names (e.g., R152, U12, C87)\n    components = re.findall(r\'\\b[A-Z]\\d+[A-Z_]*\\b\', text, re.IGNORECASE)\n    \n    # Extract signal names (e.g., I2C_SDA, VDD_5V, SW_NODE)\n    signals = re.findall(r\'\\b[A-Z][A-Z0-9_]+\\b\', text)\n    \n    # Common keywords\n    keywords = []\n    keywords.extend(components)\n    keywords.extend(signals)\n    \n    return keywords, text_lower\n\ndef calculate_match_score(raw_text, codebook_entry):\n    """Calculate how well a codebook entry matches the raw text"""\n    raw_keywords, raw_lower = extract_keywords(raw_text)\n    \n    # Get keywords from codebook\n    cb_keywords = codebook_entry[\'keywords_examples\'].lower()\n    cb_label = codebook_entry[\'standard_label\'].lower()\n    \n    score = 0.0\n    matches = []\n    \n    # Check for component/signal matches\n    for kw in raw_keywords:\n        if kw.lower() in cb_label or kw.lower() in cb_keywords:\n            score += 0.3\n            matches.append(kw)\n    \n    # Check for keyword matches\n    keyword_list = [k.strip() for k in cb_keywords.split(\',\')]\n    for kw in keyword_list:\n        if kw and kw in raw_lower:\n            score += 0.15\n            matches.append(kw)\n    \n    # Specific pattern matching\n    if \'open\' in cb_label or \'开路\' in cb_keywords:\n        if \'open\' in raw_lower or \'开路\' in raw_text or \'os\' in raw_lower:\n            score += 0.2\n    \n    if \'short\' in cb_label or \'短路\' in cb_keywords:\n        if \'short\' in raw_lower or \'短路\' in raw_text or \'短路趋势\' in raw_text:\n            score += 0.2\n    \n    if \'cold solder\' in cb_label or \'虚焊\' in cb_keywords:\n        if \'cold solder\' in raw_lower or \'虚焊\' in raw_text or \'少锡\' in raw_text or \'浮高\' in raw_text:\n            score += 0.2\n    \n    if \'fixture\' in cb_label or \'接触不良\' in cb_keywords:\n        if \'fixture\' in raw_lower or \'pogo\' in raw_lower or \'probe\' in raw_lower or \\\n           \'reseat\' in raw_lower or \'接触不良\' in raw_text or \'探针\' in raw_text or \\\n           \'重插\' in raw_text or \'换针\' in raw_text or \'治具\' in raw_text:\n            score += 0.25\n    \n    return score, matches\n\ndef segment_raw_text(raw_text):\n    """Segment raw text into individual issues"""\n    # Split by common delimiters\n    segments = []\n    \n    # Try to split by common separators\n    parts = re.split(r\'[/&]|\\s+and\\s+|\\s+then\\s+\', raw_text)\n    \n    if len(parts) > 1:\n        for part in parts:\n            part = part.strip()\n            if len(part) > 5:  # Minimum meaningful length\n                segments.append(part)\n    else:\n        segments.append(raw_text.strip())\n    \n    return segments if segments else [raw_text.strip()]\n\ndef find_best_match(segment, codebooks, product_id, station):\n    """Find the best matching code for a segment"""\n    if product_id not in codebooks:\n        return None, 0.0, []\n    \n    best_score = 0.0\n    best_match = None\n    best_matches_detail = []\n    \n    for entry in codebooks[product_id]:\n        # Check if station is in scope\n        station_scope = entry[\'station_scope\'].upper()\n        if station.upper() not in station_scope and \'ALL\' not in station_scope:\n            # Still allow but with penalty\n            score, matches = calculate_match_score(segment, entry)\n            score *= 0.7  # Penalty for out-of-scope station\n        else:\n            score, matches = calculate_match_score(segment, entry)\n        \n        if score > best_score:\n            best_score = score\n            best_match = entry\n            best_matches_detail = matches\n    \n    return best_match, best_score, best_matches_detail\n\ndef normalize_logs(logs, codebooks):\n    """Normalize all logs"""\n    results = []\n    \n    for log in logs:\n        record_id = log[\'record_id\']\n        product_id = log[\'product_id\']\n        station = log[\'station\']\n        engineer_id = log[\'engineer_id\']\n        raw_reason_text = log[\'raw_reason_text\']\n        \n        # Segment the raw text\n        segments = segment_raw_text(raw_reason_text)\n        \n        normalized = []\n        for i, segment in enumerate(segments, 1):\n            segment_id = f"{record_id}-S{i}"\n            \n            # Find best match\n            best_match, score, matches = find_best_match(segment, codebooks, product_id, station)\n            \n            if best_match and score >= 0.3:  # Threshold for acceptable match\n                # Calculate confidence based on score\n                confidence = min(0.95, score)  # Cap at 0.95\n                pred_code = best_match[\'code\']\n                pred_label = best_match[\'standard_label\']\n                rationale = f"Matched keywords: {\', \'.join(matches[:5])}. Score: {score:.2f}"\n            else:\n                # Unknown - low confidence\n                confidence = score * 0.5 if score > 0 else 0.1\n                pred_code = "UNKNOWN"\n                pred_label = ""\n                rationale = f"No confident match found. Best score: {score:.2f}"\n            \n            normalized.append({\n                "segment_id": segment_id,\n                "span_text": segment,\n                "pred_code": pred_code,\n                "pred_label": pred_label,\n                "confidence": round(confidence, 3),\n                "rationale": rationale\n            })\n        \n        results.append({\n            "record_id": record_id,\n            "product_id": product_id,\n            "station": station,\n            "engineer_id": engineer_id,\n            "raw_reason_text": raw_reason_text,\n            "normalized": normalized\n        })\n    \n    return results\n\ndef main():\n    print("Loading codebooks...")\n    codebooks = load_codebooks()\n    \n    print("Loading test logs...")\n    logs = load_test_logs()\n    \n    print(f"Processing {len(logs)} records...")\n    results = normalize_logs(logs, codebooks)\n    \n    output = {"records": results}\n    \n    print("Writing output...")\n    with open(\'/app/output/solution.json\', \'w\', encoding=\'utf-8\') as f:\n        json.dump(output, f, ensure_ascii=False, indent=2)\n    \n    print("Done!")\n    print(f"Processed {len(results)} records")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
