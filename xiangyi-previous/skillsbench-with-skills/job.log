Sending keys: ['cat > dicke_wigner.py << \'EOF\'\nimport numpy as np\nfrom qutip import *\n\n# Parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0  # Atomic frequency\nomega_c = 1.0  # Cavity frequency\ng = 2.0 / np.sqrt(N)  # Coupling strength\nkappa = 1.0  # Cavity loss\nn_max = 16  # Photon number cutoff\n\n# Wigner function grid\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\n# For N spin-1/2 particles, use the symmetric (Dicke) subspace with j = N/2\nj = N / 2.0\ndim_spin = int(2 * j + 1)  # = N + 1\n\nprint(f"Setting up Dicke model with N={N} atoms, j={j}")\nprint(f"Cavity dimension: {n_max}, Spin dimension: {dim_spin}")\n\n# Create operators in the tensor product space: cavity x spin\n# Cavity operators\na = tensor(destroy(n_max), qeye(dim_spin))\nadag = a.dag()\n\n# Collective spin operators (spin-j representation)\nJz = tensor(qeye(n_max), jmat(j, \'z\'))\nJp = tensor(qeye(n_max), jmat(j, \'+\'))\nJm = tensor(qeye(n_max), jmat(j, \'-\'))\n\n# Hamiltonian: H = omega_0 * Jz + omega_c * a^dag * a + g * (a + a^dag) * (J+ + J-)\nH = omega_0 * Jz + omega_c * adag * a + g * (adag + a) * (Jp + Jm)\n\nprint("Hamiltonian created")\nprint(f"Hilbert space dimension: {n_max * dim_spin}")\n\ndef create_collapse_operators(case):\n    """\n    Create collapse operators for different loss cases.\n    \n    In the symmetric Dicke subspace:\n    - Collective operators J+, J-, Jz act naturally\n    - Local operators need to be expressed in terms of collective operators\n    \n    For local processes on N identical atoms in symmetric subspace:\n    - Local dephasing (sigma_z on each): contributes to dephasing of collective spin\n    - Local emission (sigma_- on each): J_- with appropriate scaling\n    - Local pumping (sigma_+ on each): J_+ with appropriate scaling\n    \n    The rates given are per-atom rates, so we scale accordingly.\n    """\n    c_ops = []\n    \n    # Cavity loss: sqrt(kappa) * a\n    c_ops.append(np.sqrt(kappa) * a)\n    \n    if case == 1:\n        # Local de-phasing & local pumping\n        gamma_phi = 0.01  # Dephasing rate per atom\n        gamma_up = 0.1    # Pumping rate per atom\n        \n        # Local dephasing: Lindblad term with sigma_z for each atom\n        # In symmetric subspace, sum_i sigma_z^i = 2*Jz\n        # D[sigma_z]rho = sigma_z rho sigma_z - rho (since sigma_z^2 = I)\n        # For N atoms: effective dephasing on collective spin\n        # We use sqrt(gamma_phi) * (2/sqrt(N)) * Jz as approximation\n        c_ops.append(np.sqrt(gamma_phi) * 2 * Jz / np.sqrt(N))\n        \n        # Local pumping: sum_i sigma_+^i in symmetric subspace\n        # This is approximated by J_+ with rate scaled by N\n        c_ops.append(np.sqrt(gamma_up) * Jp)\n        \n    elif case == 2:\n        # Local de-phasing & local emission\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        \n        c_ops.append(np.sqrt(gamma_phi) * 2 * Jz / np.sqrt(N))\n        c_ops.append(np.sqrt(gamma_down) * Jm)\n        \n    elif case == 3:\n        # Local de-phasing & local emission & collective pumping\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        gamma_Up = 0.1  # Collective pumping rate\n        \n        c_ops.append(np.sqrt(gamma_phi) * 2 * Jz / np.sqrt(N))\n        c_ops.append(np.sqrt(gamma_down) * Jm)\n        c_ops.append(np.sqrt(gamma_Up) * Jp)  # Collective pumping\n        \n    elif case == 4:\n        # Local de-phasing & local emission & collective emission\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        gamma_Down = 0.1  # Collective emission rate\n        \n        c_ops.append(np.sqrt(gamma_phi) * 2 * Jz / np.sqrt(N))\n        c_ops.append(np.sqrt(gamma_down) * Jm)\n        c_ops.append(np.sqrt(gamma_Down) * Jm)  # Collective emission\n    \n    return c_ops\n\ndef solve_and_save(case):\n    print(f"\\n{\'=\'*50}")\n    print(f"Processing Case {case}")\n    print(f"{\'=\'*50}")\n    \n    # Create collapse operators\n    c_ops = create_collapse_operators(case)\n    print(f"Number of collapse operators: {len(c_ops)}")\n    \n    # Solve for steady state\n    print("Solving for steady state...")\n    try:\n        rho_ss = steadystate(H, c_ops, method=\'direct\')\n    except:\n        print("Direct method failed, trying iterative...")\n        rho_ss = steadystate(H, c_ops, method=\'iterative-gmres\')\n    print("Steady state found")\n    \n    # Verify it\'s a valid density matrix\n    print(f"Trace of steady state: {rho_ss.tr():.6f}")\n    \n    # Trace out spin degrees of freedom to get cavity state\n    # dims are [n_max, dim_spin], trace over index 1 (spin)\n    print("Tracing out spin degrees of freedom...")\n    rho_cavity = ptrace(rho_ss, 0)\n    print(f"Cavity state dimension: {rho_cavity.shape}")\n    print(f"Trace of cavity state: {rho_cavity.tr():.6f}")\n    \n    # Calculate mean photon number\n    a_cav = destroy(n_max)\n    n_mean = expect(a_cav.dag() * a_cav, rho_cavity)\n    print(f"Mean photon number: {n_mean:.4f}")\n    \n    # Calculate Wigner function\n    print("Calculating Wigner function (1000x1000 grid)...")\n    W = wigner(rho_cavity, xvec, pvec)\n    print(f"Wigner function shape: {W.shape}")\n    print(f"Wigner function range: [{W.min():.6f}, {W.max():.6f}]")\n    \n    # Save to CSV\n    filename = f"{case}.csv"\n    print(f"Saving to {filename}...")\n    np.savetxt(filename, W, delimiter=\',\')\n    print(f"Case {case} complete!")\n    \n    return W\n\n# Process all 4 cases\nif __name__ == "__main__":\n    for case in [1, 2, 3, 4]:\n        solve_and_save(case)\n    \n    print("\\n" + "="*50)\n    print("All cases completed successfully!")\n    print("="*50)\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
