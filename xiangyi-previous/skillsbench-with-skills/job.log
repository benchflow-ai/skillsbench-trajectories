Sending keys: ['cat > /root/process_taxonomy_v2.py << \'EOFSCRIPT\'\nimport pandas as pd\nfrom collections import defaultdict, Counter\nimport re\nfrom typing import Dict, List, Set, Tuple\nfrom difflib import SequenceMatcher\n\ndef normalize_text(text: str) -> str:\n    """Normalize text for comparison."""\n    text = text.strip().lower()\n    text = re.sub(r\'[&/]\', \' and \', text)\n    text = re.sub(r\'[^a-z0-9\\s]\', \'\', text)\n    text = re.sub(r\'\\s+\', \' \', text)\n    return text\n\ndef load_and_parse_categories():\n    """Load and parse all categories."""\n    all_data = []\n    \n    # Load Amazon\n    df = pd.read_csv(\'/root/data/amazon_product_categories.csv\')\n    for path in df[\'category_path\']:\n        parts = [p.strip() for p in path.split(\'>\')]\n        all_data.append({\n            \'source\': \'amazon\',\n            \'original_path\': path,\n            \'parts\': parts,\n            \'depth\': len(parts),\n            \'normalized_parts\': [normalize_text(p) for p in parts]\n        })\n    \n    # Load Facebook\n    df = pd.read_csv(\'/root/data/fb_product_categories.csv\')\n    for path in df[\'category_path\']:\n        parts = [p.strip() for p in path.split(\'>\')]\n        all_data.append({\n            \'source\': \'facebook\',\n            \'original_path\': path,\n            \'parts\': parts,\n            \'depth\': len(parts),\n            \'normalized_parts\': [normalize_text(p) for p in parts]\n        })\n    \n    # Load Google\n    df = pd.read_csv(\'/root/data/google_shopping_product_categories.csv\')\n    for path in df[\'category_path\']:\n        parts = [p.strip() for p in path.split(\'>\')]\n        all_data.append({\n            \'source\': \'google\',\n            \'original_path\': path,\n            \'parts\': parts,\n            \'depth\': len(parts),\n            \'normalized_parts\': [normalize_text(p) for p in parts]\n        })\n    \n    return all_data\n\ndef extract_level_items(all_data: List[Dict], level: int) -> Dict[str, Tuple[str, int]]:\n    """Extract items at a specific level with their original names and frequency."""\n    items = defaultdict(lambda: {\'normalized\': \'\', \'count\': 0, \'originals\': set()})\n    \n    for entry in all_data:\n        if level <= len(entry[\'parts\']):\n            norm = entry[\'normalized_parts\'][level - 1]\n            orig = entry[\'parts\'][level - 1]\n            items[norm][\'normalized\'] = norm\n            items[norm][\'originals\'].add(orig)\n            items[norm][\'count\'] += 1\n    \n    return items\n\ndef similarity(s1: str, s2: str) -> float:\n    """Calculate similarity between two strings."""\n    return SequenceMatcher(None, s1, s2).ratio()\n\ndef get_representative_name(originals: Set[str]) -> str:\n    """Get most representative name from a set of original names."""\n    if not originals:\n        return ""\n    if len(originals) == 1:\n        return list(originals)[0]\n    # Return the longest (usually most specific) name\n    return max(originals, key=lambda x: len(x))\n\ndef build_unified_taxonomy(all_data: List[Dict]):\n    """Build unified 5-level taxonomy."""\n    unified_structure = {}\n    \n    # Level 1: Extract top-level categories\n    level1_items = extract_level_items(all_data, 1)\n    level1_sorted = sorted(level1_items.items(), key=lambda x: x[1][\'count\'], reverse=True)\n    \n    # Keep top 15-20 for level 1\n    level1_unified = {}\n    for norm, data in level1_sorted[:18]:\n        orig_name = get_representative_name(data[\'originals\'])\n        level1_unified[norm] = {\n            \'name\': orig_name,\n            \'normalized\': norm,\n            \'count\': data[\'count\'],\n            \'children\': set()\n        }\n    \n    unified_structure[1] = level1_unified\n    \n    # Build hierarchy by analyzing parent-child relationships\n    for level in range(2, 6):\n        level_items = extract_level_items(all_data, level)\n        level_unified = {}\n        \n        # For each item at this level, find its parent\n        for norm, data in level_items.items():\n            if data[\'count\'] < 2:  # Skip rare categories\n                continue\n            \n            orig_name = get_representative_name(data[\'originals\'])\n            level_unified[norm] = {\n                \'name\': orig_name,\n                \'normalized\': norm,\n                \'count\': data[\'count\'],\n                \'children\': set()\n            }\n        \n        # Keep top items at this level\n        top_n = min(len(level_unified), max(50, 15 * (6 - level)))\n        sorted_items = sorted(level_unified.items(), key=lambda x: x[1][\'count\'], reverse=True)\n        level_unified = {k: v for k, v in sorted_items[:top_n]}\n        \n        unified_structure[level] = level_unified\n    \n    return unified_structure\n\ndef map_category_to_unified(entry: Dict, unified_structure: Dict) -> Dict:\n    """Map a single category to the unified taxonomy."""\n    result = {\n        \'source\': entry[\'source\'],\n        \'category_path\': entry[\'original_path\'],\n        \'depth\': entry[\'depth\']\n    }\n    \n    for level in range(1, 6):\n        if level <= entry[\'depth\']:\n            norm_cat = entry[\'normalized_parts\'][level - 1]\n            \n            # Find best match in unified structure\n            best_match = None\n            best_score = 0\n            \n            for unified_norm, unified_data in unified_structure[level].items():\n                score = similarity(norm_cat, unified_norm)\n                if score > best_score:\n                    best_score = score\n                    best_match = unified_data[\'name\']\n            \n            if best_match is None and unified_structure[level]:\n                # Default to first item if no good match\n                best_match = list(unified_structure[level].values())[0][\'name\']\n            \n            result[f\'unified_level_{level}\'] = best_match\n        else:\n            result[f\'unified_level_{level}\'] = None\n    \n    return result\n\ndef main():\n    print("Loading and parsing categories...")\n    all_data = load_and_parse_categories()\n    print(f"Loaded {len(all_data)} category paths")\n    \n    print("Building unified taxonomy structure...")\n    unified_structure = build_unified_taxonomy(all_data)\n    \n    print("Mapping categories to unified taxonomy...")\n    results = []\n    for entry in all_data:\n        mapped = map_category_to_unified(entry, unified_structure)\n        results.append(mapped)\n    \n    # Save full mapping\n    df_full = pd.DataFrame(results)\n    df_full.to_csv(\'/root/output/unified_taxonomy_full.csv\', index=False)\n    print(f"Saved {len(df_full)} mappings to unified_taxonomy_full.csv")\n    \n    # Print statistics\n    print("\\nUnified Taxonomy Statistics:")\n    for level in range(1, 6):\n        unique_count = df_full[f\'unified_level_{level}\'].nunique()\n        print(f"Level {level}: {unique_count} unique categories")\n    \n    # Save hierarchy\n    hierarchy_rows = []\n    seen = set()\n    for _, row in df_full.iterrows():\n        levels = tuple(row[f\'unified_level_{i}\'] for i in range(1, 6))\n        if levels not in seen:\n            seen.add(levels)\n            hierarchy_rows.append({\n                \'unified_level_1\': levels[0],\n                \'unified_level_2\': levels[1],\n                \'unified_level_3\': levels[2],\n                \'unified_level_4\': levels[3],\n                \'unified_level_5\': levels[4]\n            })\n    \n    df_hierarchy = pd.DataFrame(hierarchy_rows)\n    df_hierarchy.to_csv(\'/root/output/unified_taxonomy_hierarchy.csv\', index=False)\n    print(f"Saved {len(df_hierarchy)} hierarchy paths to unified_taxonomy_hierarchy.csv")\n    \n    print("Done!")\n\nif __name__ == \'__main__\':\n    main()\nEOFSCRIPT\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
