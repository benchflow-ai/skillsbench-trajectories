Sending keys: ['cat > solution.py << \'EOF\'\nimport re\nimport json\n\ndef parse_script(text: str):\n    """\n    Parse a dialogue script into a graph structure.\n    Returns a dictionary with \'nodes\' and \'edges\' lists.\n    """\n    lines = text.strip().split(\'\\n\')\n    nodes = []\n    edges = []\n    \n    current_scene = None\n    scene_content = []\n    \n    # First pass: group lines by scene\n    scenes = {}\n    for line in lines:\n        line = line.strip()\n        if not line:\n            continue\n            \n        # Check if this is a scene header\n        scene_match = re.match(r\'^\\[(.+)\\]$\', line)\n        if scene_match:\n            # Save previous scene if exists\n            if current_scene and scene_content:\n                scenes[current_scene] = scene_content[:]\n            \n            current_scene = scene_match.group(1)\n            scene_content = []\n        elif current_scene:\n            scene_content.append(line)\n    \n    # Don\'t forget the last scene\n    if current_scene and scene_content:\n        scenes[current_scene] = scene_content\n    \n    # Second pass: parse each scene\n    for scene_id, content in scenes.items():\n        # Check if this is a choice menu (has numbered options)\n        is_choice = any(re.match(r\'^\\d+\\.\', line) for line in content)\n        \n        if is_choice:\n            # This is a choice node\n            nodes.append({\n                "id": scene_id,\n                "text": "",\n                "speaker": "",\n                "type": "choice"\n            })\n            \n            # Parse each choice option\n            for line in content:\n                choice_match = re.match(r\'^(\\d+)\\. (.+?) -> (.+)$\', line)\n                if choice_match:\n                    choice_text = choice_match.group(2)\n                    target = choice_match.group(3)\n                    \n                    edges.append({\n                        "from": scene_id,\n                        "to": target,\n                        "text": choice_text\n                    })\n        else:\n            # This is a dialogue line node\n            for line in content:\n                dialogue_match = re.match(r\'^(.+?): (.+?) -> (.+)$\', line)\n                if dialogue_match:\n                    speaker = dialogue_match.group(1)\n                    text = dialogue_match.group(2)\n                    target = dialogue_match.group(3)\n                    \n                    nodes.append({\n                        "id": scene_id,\n                        "text": text,\n                        "speaker": speaker,\n                        "type": "line"\n                    })\n                    \n                    edges.append({\n                        "from": scene_id,\n                        "to": target,\n                        "text": ""\n                    })\n    \n    return {\n        "nodes": nodes,\n        "edges": edges\n    }\n\ndef generate_dot(graph):\n    """\n    Generate a Graphviz DOT format visualization.\n    """\n    dot_lines = ["digraph Dialogue {"]\n    dot_lines.append("  rankdir=TB;")\n    dot_lines.append("  node [shape=box];")\n    dot_lines.append("")\n    \n    # Add nodes\n    for node in graph["nodes"]:\n        node_id = node["id"]\n        label_parts = []\n        \n        if node["speaker"]:\n            label_parts.append(f"{node[\'speaker\']}")\n        if node["text"]:\n            label_parts.append(f"{node[\'text\']}")\n        \n        label = "\\\\n".join(label_parts) if label_parts else node_id\n        \n        # Escape quotes in label\n        label = label.replace(\'"\', \'\\\\"\')\n        \n        shape = "diamond" if node["type"] == "choice" else "box"\n        dot_lines.append(f\'  "{node_id}" [label="{label}", shape={shape}];\')\n    \n    dot_lines.append("")\n    \n    # Add edges\n    for edge in graph["edges"]:\n        from_node = edge["from"]\n        to_node = edge["to"]\n        edge_label = edge["text"].replace(\'"\', \'\\\\"\') if edge["text"] else ""\n        \n        if edge_label:\n            dot_lines.append(f\'  "{from_node}" -> "{to_node}" [label="{edge_label}"];\')\n        else:\n            dot_lines.append(f\'  "{from_node}" -> "{to_node}";\')\n    \n    dot_lines.append("}")\n    return "\\n".join(dot_lines)\n\nif __name__ == "__main__":\n    # Read the script file\n    with open(\'/app/script.txt\', \'r\') as f:\n        script_text = f.read()\n    \n    # Parse the script\n    graph = parse_script(script_text)\n    \n    # Write JSON output\n    with open(\'/app/dialogue.json\', \'w\') as f:\n        json.dump(graph, f, indent=2)\n    \n    # Generate and write DOT visualization\n    dot_content = generate_dot(graph)\n    with open(\'/app/dialogue.dot\', \'w\') as f:\n        f.write(dot_content)\n    \n    print(f"Parsed {len(graph[\'nodes\'])} nodes and {len(graph[\'edges\'])} edges")\n    print("Output written to dialogue.json and dialogue.dot")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
