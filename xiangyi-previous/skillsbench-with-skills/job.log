'udp\'] += 1\n            src_port = pkt[UDP].sport\n            dst_port = pkt[UDP].dport\n            src_ports.append(src_port)\n            dst_ports.append(dst_port)\n            flows.add((src_ip, dst_ip, src_port, dst_port, \'udp\'))\n        elif ICMP in pkt:\n            protocol_counts[\'icmp\'] += 1\n    \n    if ARP in pkt:\n        protocol_counts[\'arp\'] += 1\n\nprint("Computing statistics...")\n\n# Time/Rate metrics\ntimestamps.sort()\nduration_seconds = timestamps[-1] - timestamps[0] if len(timestamps) > 1 else 0\n\n# Packets per minute buckets\nif duration_seconds > 0:\n    bucket_size = 60.0  # 60 seconds\n    min_time = timestamps[0]\n    packets_per_bucket = defaultdict(int)\n    for ts in timestamps:\n        bucket = int((ts - min_time) / bucket_size)\n        packets_per_bucket[bucket] += 1\n    \n    bucket_counts = list(packets_per_bucket.values())\n    packets_per_minute_avg = sum(bucket_counts) / len(bucket_counts) if bucket_counts else 0\n    packets_per_minute_max = max(bucket_counts) if bucket_counts else 0\n    packets_per_minute_min = min(bucket_counts) if bucket_counts else 0\nelse:\n    packets_per_minute_avg = packets_per_minute_max = packets_per_minute_min = 0\n\n# Size statistics\ntotal_bytes = sum(packet_sizes)\navg_packet_size = total_bytes / len(packet_sizes) if packet_sizes else 0\nmin_packet_size = min(packet_sizes) if packet_sizes else 0\nmax_packet_size = max(packet_sizes) if packet_sizes else 0\n\n# Shannon entropy function\ndef shannon_entropy(data):\n    if not data:\n        return 0.0\n    counts = Counter(data)\n    total = len(data)\n    entropy = 0.0\n    for count in counts.values():\n        p = count / total\n        if p > 0:\n            entropy -= p * math.log2(p)\n    return entropy\n\nsrc_ip_entropy = shannon_entropy(src_ips)\ndst_ip_entropy = shannon_entropy(dst_ips)\nsrc_port_entropy = shannon_entropy(src_ports)\ndst_port_entropy = shannon_entropy(dst_ports)\nunique_src_ports = len(set(src_ports))\nunique_dst_ports = len(set(dst_ports))\n\n# Graph metrics\nall_ips = ip_src_set | ip_dst_set\nnum_nodes = len(all_ips)\nnum_edges = len(ip_graph_edges)\nif num_nodes >= 2:\n    network_density = num_edges / (num_nodes * (num_nodes - 1))\nelse:\n    network_density = 0\n\nmax_outdegree = max(len(dsts) for dsts in ip_outdegree.values()) if ip_outdegree else 0\nmax_indegree = max(len(srcs) for srcs in ip_indegree.values()) if ip_indegree else 0\n\n# Inter-arrival times\niats = []\nfor i in range(1, len(timestamps)):\n    iats.append(timestamps[i] - timestamps[i-1])\n\nif iats:\n    iat_mean = sum(iats) / len(iats)\n    iat_variance = sum((x - iat_mean) ** 2 for x in iats) / len(iats)\n    iat_std = math.sqrt(iat_variance)\n    iat_cv = iat_std / iat_mean if iat_mean > 0 else 0\nelse:\n    iat_mean = iat_variance = iat_cv = 0\n\n# Producer/Consumer Ratio\nnum_producers = 0\nnum_consumers = 0\nfor ip in all_ips:\n    sent = ip_bytes_sent.get(ip, 0)\n    recv = ip_bytes_recv.get(ip, 0)\n    total = sent + recv\n    if total > 0:\n        pcr = (sent - recv) / total\n        if pcr > 0.2:\n            num_producers += 1\n        elif pcr < -0.2:\n            num_consumers += 1\n\n# Flow metrics\nunique_flows = len(flows)\ntcp_flows = sum(1 for f in flows if f[4] == \'tcp\')\nudp_flows = sum(1 for f in flows if f[4] == \'udp\')\n\n# Bidirectional flows\nbidirectional_flows = 0\nfor src_ip, dst_ip, src_port, dst_port, proto in flows:\n    reverse = (dst_ip, src_ip, dst_port, src_port, proto)\n    if reverse in flows:\n        bidirectional_flows += 1\nbidirectional_flows = bidirectional_flows // 2  # Each pair counted twice\n\n# Analysis flags\nis_traffic_benign = \'true\'\nhas_port_scan = \'false\'\nhas_dos_pattern = \'false\'\nhas_beaconing = \'false\'\n\n# Port scan detection: high outdegree with many unique dst ports per src IP\nfor src_ip in ip_outdegree:\n    # Count unique dst ports from this src\n    dst_ports_from_src = set()\n    for src, dst, sp, dp, proto in flows:\n 