Sending keys: ['cat >> /app/normalize_v2.py << \'ENDSCRIPT\'\n\n# Convert score to calibrated confidence\ndef calibrate_confidence(score, is_unknown):\n    if is_unknown:\n        # Unknown predictions should have low confidence\n        return round(max(0.05, min(0.35, score * 0.5)), 3)\n    \n    # Calibrated confidence for known predictions\n    # Score range: 0.15 to 1.0 -> Confidence range: 0.4 to 0.98\n    if score >= 0.7:\n        conf = 0.90 + (score - 0.7) * 0.27  # 0.90 to 0.98\n    elif score >= 0.5:\n        conf = 0.75 + (score - 0.5) * 0.75  # 0.75 to 0.90\n    elif score >= 0.35:\n        conf = 0.55 + (score - 0.35) * 1.33  # 0.55 to 0.75\n    elif score >= 0.2:\n        conf = 0.40 + (score - 0.2) * 1.0  # 0.40 to 0.55\n    else:\n        conf = 0.35 + score * 0.25  # Below threshold\n    \n    return round(min(0.98, max(0.38, conf)), 3)\n\n# Main processing function\ndef process_records():\n    # Load data\n    codebooks = load_codebooks()\n    keyword_index = build_keyword_index(codebooks)\n    logs_df = pd.read_csv(\'/app/data/test_center_logs.csv\')\n    \n    records = []\n    \n    for idx, row in logs_df.iterrows():\n        record_id = row[\'record_id\']\n        product_id = row[\'product_id\']\n        station = row[\'station\']\n        engineer_id = row[\'engineer_id\']\n        raw_reason_text = row[\'raw_reason_text\']\n        \n        # Get appropriate codebook\n        indexed_codebook = keyword_index.get(product_id, [])\n        \n        # Segment the raw text\n        segments = segment_text(raw_reason_text)\n        \n        normalized = []\n        segment_id = 1\n        \n        for span_text in segments:\n            span_text = span_text.strip()\n            if not span_text or len(span_text) < 2:\n                continue\n            \n            # Find best match\n            best_entry, score, matched_kw = find_best_match(span_text, indexed_codebook, station)\n            \n            # Threshold for unknown\n            unknown_threshold = 0.18\n            \n            if best_entry is None or score < unknown_threshold:\n                pred_code = "UNKNOWN"\n                pred_label = ""\n                confidence = calibrate_confidence(score, True)\n                rationale = f"Low match score ({score:.2f}), no confident codebook match"\n            else:\n                pred_code = best_entry[\'code\']\n                pred_label = best_entry[\'standard_label\']\n                confidence = calibrate_confidence(score, False)\n                if matched_kw:\n                    rationale = f"Matched keywords: {\', \'.join(matched_kw[:4])}"\n                else:\n                    rationale = f"Pattern match: {best_entry.get(\'category_lv2\', \'category\')}"\n            \n            normalized.append({\n                "segment_id": f"{record_id}-S{segment_id}",\n                "span_text": span_text,\n                "pred_code": pred_code,\n                "pred_label": pred_label,\n                "confidence": confidence,\n                "rationale": rationale\n            })\n            segment_id += 1\n        \n        # If no segments, create one with original text\n        if not normalized:\n            raw_str = str(raw_reason_text) if pd.notna(raw_reason_text) else ""\n            normalized.append({\n                "segment_id": f"{record_id}-S1",\n                "span_text": raw_str,\n                "pred_code": "UNKNOWN",\n                "pred_label": "",\n                "confidence": 0.05,\n                "rationale": "Unable to parse or match text"\n            })\n        \n        records.append({\n            "record_id": record_id,\n            "product_id": product_id,\n            "station": station,\n            "engineer_id": engineer_id,\n            "raw_reason_text": str(raw_reason_text) if pd.notna(raw_reason_text) else "",\n            "normalized": normalized\n        })\n        \n        if (idx + 1) % 2000 == 0:\n            print(f"Processed {idx + 1} records...")\n    \n    return {"records": records}\n\nif __name__ == "__main__":\n    print("Starting normalization v2...")\n    result = process_records()\n    \n    # Save output\n    with open(\'/app/output/solution.json\', \'w\', encoding=\'utf-8\') as f:\n        json.dump(result, f, ensure_ascii=False, indent=2)\n    \n    print(f"Done! Processed {len(result[\'records\'])} records.")\n    \n    # Quick stats\n    total_segs = sum(len(r[\'normalized\']) for r in result[\'records\'])\n    unknown_segs = sum(1 for r in result[\'records\'] for s in r[\'normalized\'] if s[\'pred_code\'] == \'UNKNOWN\')\n    print(f"Total segments: {total_segs}")\n    print(f"Unknown segments: {unknown_segs} ({100*unknown_segs/total_segs:.1f}%)")\nENDSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
