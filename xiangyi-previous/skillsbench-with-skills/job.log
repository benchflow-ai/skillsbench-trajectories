n# Calculate Total Spend (useful for later)\npurchase_df['Total Spend'] = purchase_df['Purchase Price Per Unit'] * purchase_df['Quantity']\n\n# Filter for relevant columns to save space if needed, but keeping all for now as per instructions\n# We need to ensure the Category strings are clean (strip whitespace)\npurchase_df['Category'] = purchase_df['Category'].astype(str).str.strip()\n\nprint(f'Purchase data: {initial_purchase_len} -> {len(purchase_df)} rows')\npurchase_df.to_csv(os.path.join(output_dir, 'amazon-purchases-2019-2020-filtered.csv'), index=False)\n\nprint('Data cleaning complete.')\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
