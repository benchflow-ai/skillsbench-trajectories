Sending keys: ['cat > /app/solution.py << \'EOF\'\nimport json\nimport re\nfrom typing import Dict, List, Set, Tuple\n\ndef parse_script(text: str) -> Dict:\n    """\n    Parse a dialogue script into a structured graph with nodes and edges.\n    \n    Args:\n        text: The script content as a string\n        \n    Returns:\n        A dictionary with \'nodes\' and \'edges\' keys containing the parsed graph\n    """\n    nodes = []\n    edges = []\n    node_ids = set()\n    \n    # Split by scene headers\n    scene_pattern = r\'\\[([^\\]]+)\\]\'\n    scenes = re.split(scene_pattern, text.strip())\n    \n    # Process scenes (alternating between headers and content)\n    for i in range(1, len(scenes), 2):\n        scene_id = scenes[i].strip()\n        scene_content = scenes[i + 1].strip() if i + 1 < len(scenes) else ""\n        \n        if not scene_content:\n            continue\n            \n        lines = scene_content.split(\'\\n\')\n        first_line = True\n        \n        for line in lines:\n            line = line.strip()\n            if not line:\n                continue\n                \n            # Check if this is a dialogue line (contains a colon and arrow)\n            if \':\' in line and \'->\' in line:\n                # This is a dialogue line with a target\n                match = re.match(r\'([^:]+):\\s*(.+?)\\s*->\\s*(.+)$\', line)\n                if match:\n                    speaker = match.group(1).strip()\n                    text_content = match.group(2).strip()\n                    target = match.group(3).strip()\n                    \n                    # Create node for this dialogue line\n                    node = {\n                        "id": scene_id,\n                        "text": text_content,\n                        "speaker": speaker,\n                        "type": "line"\n                    }\n                    \n                    # Only add if not already added (scenes should have one main dialogue)\n                    if not any(n["id"] == scene_id for n in nodes):\n                        nodes.append(node)\n                        node_ids.add(scene_id)\n                    \n                    # Create edge\n                    edge = {\n                        "from": scene_id,\n                        "to": target,\n                        "text": ""\n                    }\n                    edges.append(edge)\n                    first_line = False\n            \n            # Check if this is a choice line (starts with number)\n            elif re.match(r\'^\\d+\\.\', line):\n                # This is a choice option\n                match = re.match(r\'^(\\d+)\\.\\s*(?:\\[([^\\]]+)\\]\\s*)?(.+?)\\s*->\\s*(.+)$\', line)\n                if match:\n                    choice_num = match.group(1)\n                    tag = match.group(2)  # Optional tag like [Observe]\n                    choice_text = match.group(3).strip()\n                    target = match.group(4).strip()\n                    \n                    # Create a unique ID for this choice\n                    choice_id = f"{scene_id}_choice_{choice_num}"\n                    \n                    # Build the full choice text with tag if present\n                    full_text = f"[{tag}] {choice_text}" if tag else choice_text\n                    \n                    # Create node for this choice\n                    choice_node = {\n                        "id": choice_id,\n                        "text": full_text,\n                        "speaker": "",\n                        "type": "choice"\n                    }\n                    nodes.append(choice_node)\n                    node_ids.add(choice_id)\n                    \n                    # Create edge from choice to target\n                    edge = {\n                        "from": choice_id,\n                        "to": target,\n                        "text": ""\n                    }\n                    edges.append(edge)\n                    \n                    # Create edge from scene to choice (if first choice in this scene)\n                    if first_line:\n                        choice_edge = {\n                            "from": scene_id,\n                            "to": choice_id,\n                            "text": ""\n                        }\n                        edges.append(choice_edge)\n                        first_line = False\n                    else:\n                        # Connect previous choice to this choice\n                        if edges and edges[-2]["from"] == scene_id:\n                            # This is a subsequent choice, connect from previous\n                            pass\n    \n    # Add End node if it\'s referenced but not defined\n    if not any(n["id"] == "End" for n in nodes):\n        nodes.append({\n            "id": "End",\n            "text": "The End",\n            "speaker": "Narrator",\n            "type": "line"\n        })\n        node_ids.add("End")\n    \n    return {\n        "nodes": nodes,\n        "edges": edges,\n        "node_ids": node_ids  # For internal validation\n    }\n\n\nif __name__ == "__main__":\n    # Read the script\n    with open(\'/app/script.txt\', \'r\') as f:\n        script_content = f.read()\n    \n    # Parse it\n    graph = parse_script(script_content)\n    \n    # Remove internal node_ids before saving\n    output_graph = {\n        "nodes": graph["nodes"],\n        "edges": graph["edges"]\n    }\n    \n    # Save as JSON\n    with open(\'/app/dialogue.json\', \'w\') as f:\n        json.dump(output_graph, f, indent=2)\n    \n    print("Parsed script successfully!")\n    print(f"Total nodes: {len(graph[\'nodes\'])}")\n    print(f"Total edges: {len(graph[\'edges\'])}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
