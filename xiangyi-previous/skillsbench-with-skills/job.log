Sending keys: ['cat << \'EOF\' > solution.py\nimport os\nimport re\nimport pytesseract\nfrom PIL import Image\nfrom openpyxl import Workbook\n\ndef extract_date(text):\n    # Look for dates in various formats\n    date_patterns = [\n        r\'(\\d{2})[-/](\\d{2})[-/](\\d{4})\',  # DD-MM-YYYY or DD/MM/YYYY\n        r\'(\\d{4})[-/](\\d{2})[-/](\\d{2})\',  # YYYY-MM-DD or YYYY/MM/DD\n    ]\n    for pattern in date_patterns:\n        match = re.search(pattern, text)\n        if match:\n            g = match.groups()\n            if len(g[0]) == 4:\n                return f"{g[0]}-{g[1]}-{g[2]}"\n            else:\n                return f"{g[2]}-{g[1]}-{g[0]}"\n    return None\n\ndef extract_total_amount(text):\n    lines = text.split(\'\\n\')\n    lines = [line.strip() for line in lines if line.strip()]\n    \n    keywords_priority = [\n        r\'GRAND TOTAL\',\n        r\'TOTAL\\s*RM\',\n        r\'TOTAL:\\s*RM\',\n        r\'TOTAL AMOUNT\',\n        r\'TOTAL\', r\'AMOUNT\', r\'TOTAL DUE\', r\'AMOUNT DUE\', r\'BALANCE DUE\', r\'NETT TOTAL\', r\'NET TOTAL\'\n    ]\n    \n    exclusion_keywords = [\'SUBTOTAL\', \'SUB TOTAL\', \'TAX\', \'GST\', \'SST\', \'DISCOUNT\', \'CHANGE\', \'CASH TENDERED\']\n    \n    def get_amount_from_line(line):\n        # Look for something like 1,234.56 or 1234.56\n        # Use a regex that finds numbers at the end of the line or after a keyword\n        match = re.findall(r\'\\d{1,3}(?:,\\d{3})*\\.\\d{2}\', line)\n        if match:\n            return match[-1].replace(\',\', \'\')\n        return None\n\n    found_amount = None\n    for kw_pattern in keywords_priority:\n        for i, line in enumerate(lines):\n            if re.search(kw_pattern, line, re.IGNORECASE):\n                # Check if this line contains an exclusion keyword\n                if any(re.search(ex, line, re.IGNORECASE) for ex in exclusion_keywords):\n                    # If it\'s just \'TOTAL\' but also \'SUBTOTAL\', we skip it if we are looking for \'TOTAL\'\n                    # However, if we are specifically looking for \'SUBTOTAL\', it\'s different. \n                    # But the requirement says skip lines with exclusion keywords.\n                    # Let\'s be careful: if kw_pattern is \'TOTAL\' and line is \'SUBTOTAL\', skip.\n                    # We should check if the keyword is actually present as a separate word or part of a larger word we want to avoid.\n                    if kw_pattern.upper() == \'TOTAL\' and \'SUBTOTAL\' in line.upper().replace(\' \', \'\'):\n                        continue\n                    if kw_pattern.upper() in [\'TOTAL\', \'AMOUNT\']:\n                         continue\n\n                amount = get_amount_from_line(line)\n                if amount:\n                    return amount\n                # Fallback to next line\n                if i + 1 < len(lines):\n                    amount = get_amount_from_line(lines[i+1])\n                    if amount:\n                        return amount\n        if found_amount: break\n\n    return None\n\nimg_dir = \'/app/workspace/dataset/img\'\nfiles = sorted([f for f in os.listdir(img_dir) if f.endswith(\'.jpg\')])\n\nresults = []\nfor filename in files:\n    img_path = os.path.join(img_dir, filename)\n    try:\n        text = pytesseract.image_to_string(Image.open(img_path))\n        date = extract_date(text)\n        amount = extract_total_amount(text)\n        if amount:\n            amount = "{:.2f}".format(float(amount))\n        results.append((filename, date, amount))\n        print(f"{filename}: {date}, {amount}")\n    except Exception as e:\n        print(f"Error processing {filename}: {e}")\n        results.append((filename, None, None))\n\nwb = Workbook()\nws = wb.active\nws.title = "results"\nws.append(["filename", "date", "total_amount"])\nfor res in results:\n    ws.append(res)\n\nwb.save(\'/app/workspace/stat_ocr.xlsx\')\nEOF\npython3 solution.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
