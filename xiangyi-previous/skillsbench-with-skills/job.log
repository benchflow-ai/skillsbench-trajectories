Sending keys: ['cat > estimate_merge_times.py << \'EOF\'\nimport json\nimport urllib.request\nfrom datetime import datetime\nimport time\n\nprint("Fetching merged PRs with timestamps...")\nprint("Waiting to avoid rate limit...")\ntime.sleep(15)\n\ntry:\n    url = "https://api.github.com/search/issues?q=repo:cli/cli+type:pr+is:merged+created:2024-12-01..2024-12-31&per_page=100"\n    with urllib.request.urlopen(url) as response:\n        data = json.loads(response.read().decode())\n    \n    merged_prs = data.get(\'items\', [])\n    print(f"Found {len(merged_prs)} merged PRs")\n    \n    # Save raw data for inspection\n    with open(\'/tmp/merged_prs.json\', \'w\') as f:\n        json.dump(merged_prs[:3], f, indent=2)  # Save first 3 for inspection\n    \n    print("\\nSample PR data (first PR):")\n    if merged_prs:\n        sample = merged_prs[0]\n        print(f"Number: {sample.get(\'number\')}")\n        print(f"Created: {sample.get(\'created_at\')}")\n        print(f"Closed: {sample.get(\'closed_at\')}")\n        print(f"State: {sample.get(\'state\')}")\n        print(f"Available keys: {list(sample.keys())}")\n    \n    # Calculate using closed_at as proxy for merged_at\n    total_days = 0\n    count = 0\n    \n    for pr in merged_prs:\n        if pr.get(\'created_at\') and pr.get(\'closed_at\'):\n            created = datetime.strptime(pr[\'created_at\'], \'%Y-%m-%dT%H:%M:%SZ\')\n            closed = datetime.strptime(pr[\'closed_at\'], \'%Y-%m-%dT%H:%M:%SZ\')\n            days = (closed - created).total_seconds() / 86400\n            total_days += days\n            count += 1\n    \n    if count > 0:\n        avg_days = round(total_days / count, 1)\n        print(f"\\nEstimated average merge time: {avg_days} days (based on {count} PRs)")\n        print("Note: Using closed_at as proxy for merged_at")\n        \n        # Update report\n        with open(\'/app/report.json\', \'r\') as f:\n            report = json.load(f)\n        \n        report[\'pr\'][\'avg_merge_days\'] = avg_days\n        \n        with open(\'/app/report.json\', \'w\') as f:\n            json.dump(report, f, indent=2)\n        \n        print("\\nUpdated report:")\n        print(json.dumps(report, indent=2))\n    \nexcept Exception as e:\n    print(f"Error: {e}")\n    print("\\nCurrent report remains unchanged:")\n    with open(\'/app/report.json\', \'r\') as f:\n        print(f.read())\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
