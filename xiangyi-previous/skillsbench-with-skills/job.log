Sending keys: ['cat << \'EOF\' >> /root/Tokenizer.scala\n\n// ============================================================================\n// Tokenizer Implementations\n// ============================================================================\n\ntrait BaseTokenizer[T] {\n  def tokenize(value: T): Token\n\n  def tokenizeBatch(values: Iterable[T]): Iterator[Token] = {\n    values.iterator.map(tokenize)\n  }\n}\n\nclass StringTokenizer(\n    encoding: String = "UTF-8",\n    normalizer: String => String = identity\n) extends BaseTokenizer[Either[String, Array[Byte]]] {\n  // In Scala, we can use Either to represent str or bytes, or just have overloads.\n  // Given the python code used Union[str, bytes], Either or overloads are appropriate.\n  \n  def tokenize(value: Either[String, Array[Byte]]): Token = {\n    val strValue = value match {\n      case Left(s) => s\n      case Right(b) => new String(b, encoding)\n    }\n    Token(normalizer(strValue), TokenType.STRING)\n  }\n\n  // Convenience overloads\n  def tokenize(s: String): Token = tokenize(Left(s))\n  def tokenize(b: Array[Byte]): Token = tokenize(Right(b))\n}\n\nclass NumericTokenizer(\n    precision: Int = 6,\n    formatOptions: Map[String, Any] = Map.empty\n) extends BaseTokenizer[Any] { // Using Any to handle Int, Long, Float, Double, BigDecimal\n\n  def tokenize(value: Any): Token = {\n    val strValue = value match {\n      case d: BigDecimal => s"%.${precision}f".format(d)\n      case d: Double => s"%.${precision}f".format(d)\n      case f: Float => s"%.${precision}f".format(f)\n      case i: Int => i.toString\n      case l: Long => l.toString\n      case _ => value.toString\n    }\n    Token(strValue, TokenType.NUMERIC, Map("original_type" -> value.getClass.getSimpleName))\n  }\n}\n\nclass TemporalTokenizer(formatStr: Option[String] = None) extends BaseTokenizer[Any] {\n  private val ISO_FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd\'T\'HH:mm:ss")\n  private val DATE_FORMAT = DateTimeFormatter.ofPattern("yyyy-MM-dd")\n\n  def tokenize(value: Any): Token = {\n    val formatted = (value, formatStr) match {\n      case (dt: LocalDateTime, Some(fmt)) => dt.format(DateTimeFormatter.ofPattern(fmt))\n      case (dt: LocalDateTime, None) => dt.format(ISO_FORMAT)\n      case (d: LocalDate, Some(fmt)) => d.format(DateTimeFormatter.ofPattern(fmt))\n      case (d: LocalDate, None) => d.format(DATE_FORMAT)\n      case (d: java.util.Date, Some(fmt)) => \n        new java.text.SimpleDateFormat(fmt).format(d)\n      case (d: java.util.Date, None) => \n        new java.text.SimpleDateFormat("yyyy-MM-dd\'T\'HH:mm:ss").format(d)\n      case _ => value.toString\n    }\n    Token(formatted, TokenType.TEMPORAL)\n  }\n}\n\n// ============================================================================\n// Advanced: Union Types and Overloads\n// ============================================================================\n\nclass UniversalTokenizer {\n  private val _stringTokenizer = new StringTokenizer()\n  private val _numericTokenizer = new NumericTokenizer()\n  private val _temporalTokenizer = new TemporalTokenizer()\n\n  def tokenize(value: Any): Token = value match {\n    case null => Token("NULL", TokenType.NULL)\n    case t: Tokenizable => Token(t.toToken(), TokenType.STRUCTURED)\n    case s: String => _stringTokenizer.tokenize(s)\n    case b: Array[Byte] => _stringTokenizer.tokenize(b)\n    case i: Int => _numericTokenizer.tokenize(i)\n    case l: Long => _numericTokenizer.tokenize(l)\n    case f: Float => _numericTokenizer.tokenize(f)\n    case d: Double => _numericTokenizer.tokenize(d)\n    case bd: BigDecimal => _numericTokenizer.tokenize(bd)\n    case dt: LocalDateTime => _temporalTokenizer.tokenize(dt)\n    case d: LocalDate => _temporalTokenizer.tokenize(d)\n    case d: java.util.Date => _temporalTokenizer.tokenize(d)\n    case _ => Token(value.toString, TokenType.STRING, Map("fallback" -> true))\n  }\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat << \'EOF\' > analyze_invoices.py\nimport pandas as pd\nimport pdfplumber\nimport json\nimport re\nfrom rapidfuzz import process, fuzz\n\ndef solve():\n    vendors_df = pd.read_excel(\'/root/vendors.xlsx\')\n    pos_df = pd.read_csv(\'/root/purchase_orders.csv\')\n\n    # Convert vendors to list of dicts for easier search\n    vendors = vendors_df.to_dict(\'records\')\n    vendor_names = [v[\'name\'] for v in vendors]\n\n    fraud_report = []\n\n    with pdfplumber.open(\'/root/invoices.pdf\') as pdf:\n        for i, page in enumerate(pdf.pages):\n            text = page.extract_text()\n            if not text:\n                continue\n\n            lines = text.split(\'\\n\')\n            vendor_name = None\n            amount = None\n            iban = None\n            po_number = None\n\n            for line in lines:\n                if line.startswith(\'From:\'):\n                    vendor_name = line.replace(\'From:\', \'\').strip()\n                elif \'Total $\' in line:\n                    amount_str = line.split(\'Total $\')[-1].strip()\n                    amount = float(amount_str)\n                elif \'Payment IBAN:\' in line:\n                    iban = line.split(\'Payment IBAN:\')[-1].strip()\n                elif \'PO Number:\' in line:\n                    po_number = line.split(\'PO Number:\')[-1].strip()\n            \n            page_num = i + 1\n\n            # 1. Unknown Vendor\n            # We use fuzzy matching to find the best match\n            best_match = process.extractOne(vendor_name, vendor_names, scorer=fuzz.token_sort_ratio)\n            \n            matched_vendor = None\n            if best_match and best_match[1] >= 80: # Threshold for fuzzy matching\n                matched_vendor = next(v for v in vendors if v[\'name\'] == best_match[0])\n            \n            if not matched_vendor:\n                fraud_report.append({\n                    "invoice_page_number": page_num,\n                    "vendor_name": vendor_name,\n                    "invoice_amount": amount,\n                    "iban": iban,\n                    "po_number": po_number if po_number != "None" else None,\n                    "reason": "Unknown Vendor"\n                })\n                continue\n\n            # 2. IBAN Mismatch\n            if iban != matched_vendor[\'iban\']:\n                fraud_report.append({\n                    "invoice_page_number": page_num,\n                    "vendor_name": vendor_name,\n                    "invoice_amount": amount,\n                    "iban": iban,\n                    "po_number": po_number if po_number != "None" else None,\n                    "reason": "IBAN Mismatch"\n                })\n                continue\n\n            # 3. Invalid PO\n            po_row = pos_df[pos_df[\'po_number\'] == po_number]\n            if po_row.empty:\n                fraud_report.append({\n                    "invoice_page_number": page_num,\n                    "vendor_name": vendor_name,\n                    "invoice_amount": amount,\n                    "iban": iban,\n                    "po_number": po_number if po_number != "None" else None,\n                    "reason": "Invalid PO"\n                })\n                continue\n            \n            po_data = po_row.iloc[0]\n\n            # 4. Amount Mismatch\n            if abs(amount - po_data[\'amount\']) > 0.01:\n                fraud_report.append({\n                    "invoice_page_number": page_num,\n                    "vendor_name": vendor_name,\n                    "invoice_amount": amount,\n                    "iban": iban,\n                    "po_number": po_number if po_number != "None" else None,\n                    "reason": "Amount Mismatch"\n                })\n                continue\n\n            # 5. Vendor Mismatch\n            if po_data[\'vendor_id\'] != matched_vendor[\'id\']:\n                fraud_report.append({\n                    "invoice_page_number": page_num,\n                    "vendor_name": vendor_name,\n                    "invoice_amount": amount,\n                    "iban": iban,\n                    "po_number": po_number if po_number != "None" else None,\n                    "reason": "Vendor Mismatch"\n                })\n                continue\n\n    with open(\'/root/fraud_report.json\', \'w\') as f:\n        json.dump(fraud_report, f, indent=2)\n\nsolve()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
