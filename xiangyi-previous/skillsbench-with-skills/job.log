   t = text.lower()\n    if any(k in t for k in blackhole_keys):\n        return 'black_hole'\n    if any(k in t for k in DNA_keys):\n        return 'DNA'\n    if any(k in t for k in LLM_keys):\n        return 'LLM'\n    if any(k in t for k in music_keys):\n        return 'music_history'\n    if any(k in t for k in trapped_keys):\n        return 'trapped_ion_and_qc'\n    return 'unknown'\n\nfiles = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\nresults = {}\nunknown = []\nfor f in files:\n    text = extract_text(f)\n    cat = classify(text)\n    results[f]=cat\n    if cat=='unknown':\n        unknown.append(f)\n\nfrom collections import Counter\nprint('Counts:', Counter(results.values()))\nif unknown:\n    print('Unknown files:', len(unknown))\n    for f in unknown:\n        print(f)\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
