_df.shape}")\n\n# Remove rows with empty Category\npurchase_df = purchase_df[purchase_df[\'Category\'].str.strip() != \'\']\nprint(f"Purchase shape after removing empty categories: {purchase_df.shape}")\n\n# Convert Order Date to datetime\npurchase_df[\'Order Date\'] = pd.to_datetime(purchase_df[\'Order Date\'], errors=\'coerce\')\npurchase_df = purchase_df.dropna(subset=[\'Order Date\'])\n\n# Convert numeric columns\npurchase_df[\'Purchase Price Per Unit\'] = pd.to_numeric(purchase_df[\'Purchase Price Per Unit\'], errors=\'coerce\')\npurchase_df[\'Quantity\'] = pd.to_numeric(purchase_df[\'Quantity\'], errors=\'coerce\')\npurchase_df = purchase_df.dropna(subset=[\'Purchase Price Per Unit\', \'Quantity\'])\n\n# Calculate total price\npurchase_df[\'Total_Price\'] = purchase_df[\'Purchase Price Per Unit\'] * purchase_df[\'Quantity\']\n\n# Remove negative prices\npurchase_df = purchase_df[purchase_df[\'Total_Price\'] >= 0]\nprint(f"Final purchase shape: {purchase_df.shape}")\n\n# Filter to 2019-2020 data only\npurchase_df = purchase_df[(purchase_df[\'Order Date\'] >= \'2019-01-01\') & (purchase_df[\'Order Date\'] <= \'2020-12-31\')]\nprint(f"Purchase shape after date filtering: {purchase_df.shape}")\n\n# Save cleaned data\nsurvey_df.to_csv(\'/app/output/survey_cleaned.csv\', index=False)\npurchase_df.to_csv(\'/app/output/amazon-purchases-2019-2020-filtered.csv\', index=False)\n\nprint("\\nCleaned data saved.")\n\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
