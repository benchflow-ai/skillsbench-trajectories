Sending keys: ['cat << \'EOF\' > diagnostics_2.py\nimport json\nimport numpy as np\nimport scipy.sparse as sp\n\ndef diagnose():\n    with open(\'network.json\') as f:\n        data = json.load(f)\n    \n    bus_data = np.array(data[\'bus\'])\n    gen_data = np.array(data[\'gen\'])\n    branch_data = np.array(data[\'branch\'])\n    num_buses = len(bus_data)\n    bus_id_to_idx = {int(bus_data[i, 0]): i for i in range(num_buses)}\n\n    # Check connectivity\n    adj = [[] for _ in range(num_buses)]\n    for i in range(len(branch_data)):\n        if branch_data[i, 10] == 0: continue\n        u = bus_id_to_idx[int(branch_data[i, 0])]\n        v = bus_id_to_idx[int(branch_data[i, 1])]\n        adj[u].append(v)\n        adj[v].append(u)\n\n    visited = [False] * num_buses\n    components = []\n    for i in range(num_buses):\n        if not visited[i]:\n            comp = []\n            q = [i]\n            visited[i] = True\n            while q:\n                u = q.pop(0)\n                comp.append(u)\n                for v in adj[u]:\n                    if not visited[v]:\n                        visited[v] = True\n                        q.append(v)\n            components.append(comp)\n    \n    print(f"Number of components: {len(components)}")\n    for idx, comp in enumerate(components):\n        comp_load = np.sum(bus_data[comp, 2])\n        comp_gens = [g for g in range(len(gen_data)) if bus_id_to_idx[int(gen_data[g, 0])] in comp]\n        comp_pmax = np.sum(gen_data[comp_gens, 8])\n        comp_pmin = np.sum(gen_data[comp_gens, 9])\n        if comp_load > comp_pmax:\n            print(f"Component {idx} is deficit: Load={comp_load}, Pmax={comp_pmax}")\n        if comp_load < comp_pmin:\n            print(f"Component {idx} is surplus: Load={comp_load}, Pmin={comp_pmin}")\n\ndiagnose()\nEOF\npython3 diagnostics_2.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
