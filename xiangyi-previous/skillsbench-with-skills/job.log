g else None\n    \n    # Format output\n    name_str = str(name)[:25] if name else ""\n    sex_str = str(sex) if sex else ""\n    bw_str = f"{bw:.2f}" if bw else "N/A"\n    squat_str = f"{squat:.1f}" if squat else "N/A"\n    bench_str = f"{bench:.1f}" if bench else "N/A"\n    dl_str = f"{deadlift:.1f}" if deadlift else "N/A"\n    total_str = f"{total_kg:.3f}" if total_kg else "N/A"\n    dots_str = f"{dots_score:.3f}" if dots_score else "N/A"\n    \n    print(f"{name_str:<25} {sex_str:<5} {bw_str:<8} {squat_str:<8} {bench_str:<8} {dl_str:<8} {total_str:<10} {dots_str:<10}")\n\nprint("\\n" + "=" * 100)\nprint("VERIFICATION COMPLETE")\nprint("=" * 100)\nprint("\\nSummary:")\nprint(f"- Total lifters processed: {dots_sheet.max_row - 1}")\nprint(f"- Columns in Dots sheet: {dots_sheet.max_column}")\nprint(f"- Column headers: Name, Sex, BodyweightKg, Best3SquatKg, Best3BenchKg, Best3DeadliftKg, TotalKg, Dots")\nprint(f"- TotalKg formula: =ROUND(D[row]+E[row]+F[row],3)")\nprint(f"- Dots formula: Uses IF statement to apply different coefficients for Men and Women")\nprint(f"- All calculations rounded to 3 decimal places as required")\nprint("\\nThe Excel file has been successfully updated with formulas.")\nprint("When opened in Excel, all formulas will automatically calculate.")\n\nwb.close()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
