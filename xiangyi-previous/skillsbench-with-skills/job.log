Sending keys: ["cat >> acopf_solver.py << 'ENDOFFILE'\n\n# Variables: [Vm(nbus), Va(nbus), Pg(ngen), Qg(ngen)]\nnvar = 2 * nbus + 2 * ngen\n\ndef unpack(x):\n    return x[:nbus], x[nbus:2*nbus], x[2*nbus:2*nbus+ngen], x[2*nbus+ngen:]\n\ndef objective(x):\n    Pg = x[2*nbus:2*nbus+ngen] * baseMVA\n    return np.sum(cost_c2 * Pg**2 + cost_c1 * Pg + cost_c0)\n\ndef power_balance(x):\n    Vm, Va, Pg, Qg = unpack(x)\n    V = Vm * np.exp(1j * Va)\n    S_inj = V * np.conj(Ybus @ V)\n    Pg_bus = np.zeros(nbus)\n    Qg_bus = np.zeros(nbus)\n    for g in range(ngen):\n        if gen_status[g] == 1:\n            bi = bus_idx[gen_bus[g]]\n            Pg_bus[bi] += Pg[g]\n            Qg_bus[bi] += Qg[g]\n    P_mis = Pg_bus - Pd - np.real(S_inj)\n    Q_mis = Qg_bus - Qd - np.imag(S_inj)\n    return np.concatenate([P_mis, Q_mis])\nENDOFFILE\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
