Sending keys: ['cat << \'EOF\' > solution.py\nimport json\nimport numpy as np\nfrom scipy.optimize import linprog\n\ndef solve():\n    with open(\'network.json\') as f:\n        data = json.load(f)\n    \n    baseMVA = data[\'baseMVA\']\n    bus_data = np.array(data[\'bus\'])\n    gen_data = np.array(data[\'gen\'])\n    branch_data = np.array(data[\'branch\'])\n    gencost_data = np.array(data[\'gencost\'])\n    reserve_capacity = np.array(data[\'reserve_capacity\'])\n    reserve_requirement = data[\'reserve_requirement\']\n\n    num_buses = bus_data.shape[0]\n    num_gens = gen_data.shape[0]\n    num_branches = branch_data.shape[0]\n\n    # Bus indexing\n    bus_id_to_idx = {int(bus_data[i, 0]): i for i in range(num_buses)}\n\n    # Power balance: sum(P_gen at bus) - P_load = sum(flows out of bus)\n    # P_load = bus_data[:, 2]\n    # Flows: B * theta\n    \n    # Variables: [theta_1...theta_n, P_g1...P_gn, R_1...R_gn]\n    # theta_1 is slack (theta_1 = 0)\n    \n    c = np.zeros(num_buses + 2 * num_gens)\n    for i in range(num_gens):\n        # gencost: [2, startup, shutdown, n, c2, c1, c0] -> c2*Pg^2 + c1*Pg + c0\n        c[num_buses + i] = gencost_data[i, 5] # c1 coefficient\n\n    # Bounds\n    bounds = []\n    for i in range(num_buses):\n        if i == 0: # Slack bus\n            bounds.append((0, 0))\n        else:\n            bounds.append((-np.inf, np.inf))\n    \n    for i in range(num_gens):\n        bounds.append((gen_data[i, 9], gen_data[i, 8])) # PMIN, PMAX\n        \n    for i in range(num_gens):\n        bounds.append((0, reserve_capacity[i])) # Reserve capacity\n\n    # Constraints\n    # 1. DC Power Balance: B * theta - P_gen_at_bus = -P_load\n    # B_ij = -1/x_ij, B_ii = sum(1/x_ij)\n    B = np.zeros((num_buses, num_buses))\n    for i in range(num_branches):\n        if branch_data[i, 10] == 0: continue # out of service\n        f_bus = int(branch_data[i, 0])\n        t_bus = int(branch_data[i, 1])\n        f_idx = bus_id_to_idx[f_bus]\n        t_idx = bus_id_to_idx[t_bus]\n        x = branch_data[i, 3]\n        if x == 0: x = 0.0001 # Avoid division by zero\n        b = 1.0 / x\n        B[f_idx, f_idx] += b\n        B[t_idx, t_idx] += b\n        B[f_idx, t_idx] -= b\n        B[t_idx, f_idx] -= b\n\n    A_eq = []\n    b_eq = []\n\n    # Nodal power balance equations\n    for i in range(num_buses):\n        row = np.zeros(num_buses + 2 * num_gens)\n        # B * theta part\n        for j in range(num_buses):\n            if B[i, j] != 0:\n                row[j] = B[i, j]\n        # -P_gen part\n        for k in range(num_gens):\n            if int(gen_data[k, 0]) == int(bus_data[i, 0]):\n                row[num_buses + k] -= 1.0\n        \n        A_eq.append(row)\n        b_eq.append(-bus_data[i, 2] / baseMVA) # P_load is in MW, baseMVA is 100\n\n    # 2. Transmission limits: |(theta_i - theta_j) / x_ij| <= limit / baseMVA\n    A_ub = []\n    b_ub = []\n    for i in range(num_branches):\n        if branch_data[i, 10] == 0: continue\n        limit = branch_data[i, 5]\n        if limit == 0 or limit >= 9999: continue # No limit\n        f_bus = int(branch_data[i, 0])\n        t_bus = int(branch_data[i, 1])\n        f_idx = bus_id_to_idx[f_bus]\n        t_idx = bus_id_to_idx[t_bus]\n        x = branch_data[i, 3]\n        if x == 0: x = 0.0001\n        \n        row = np.zeros(num_buses + 2 * num_gens)\n        row[f_idx] = 1.0 / x\n        row[t_idx] = -1.0 / x\n        A_ub.append(row)\n        b_ub.append(limit / baseMVA)\n        \n        row = np.zeros(num_buses + 2 * num_gens)\n        row[f_idx] = -1.0 / x\n        row[t_idx] = 1.0 / x\n        A_ub.append(row)\n        b_ub.append(limit / baseMVA)\n\n    # 3. Spinning reserve requirement: sum(R_i) >= R_req\n    row = np.zeros(num_buses + 2 * num_gens)\n    for i in range(num_gens):\n        row[num_buses + num_gens + i] = -1.0\n    A_ub.append(row)\n    b_ub.append(-reserve_requirement / baseMVA)\n\n    # 4. Capacity coupling: P_gen_i + R_i <= P_max_i\n    for i in range(num_gens):\n        row = np.zeros(num_buses + 2 * num_gens)\n        row[num_buses + i] = 1.0\n        row[num_buses + num_gens + i] = 1.0\n        A_ub.append(row)\n        b_ub.append(gen_data[i, 8] / baseMVA)\n\n    # Solve\n    res = linprog(c, A_ub=A_ub, b_ub=b_ub, A_eq=A_eq, b_eq=b_eq, bounds=bounds, method=\'highs\')\n\n    if not res.success:\n        print("Optimization failed:", res.message)\n        return\n\n    theta = res.x[:num_buses]\n    pg = res.x[num_buses:num_buses+num_gens] * baseMVA\n    rg = res.x[num_buses+num_gens:] * baseMVA\n\n    # Report\n    generator_dispatch = []\n    for i in range(num_gens):\n        generator_dispatch.append({\n            "id": i + 1,\n            "bus": int(gen_data[i, 0]),\n            "output_MW": float(round(pg[i], 2)),\n            "reserve_MW": float(round(rg[i], 2)),\n            "pmax_MW": float(gen_data[i, 8])\n        })\n\n    total_cost = 0\n    for i in range(num_gens):\n        # c2*Pg^2 + c1*Pg + c0\n        total_cost += gencost_data[i, 4] * (pg[i]**2) + gencost_data[i, 5] * pg[i] + gencost_data[i, 6]\n\n    totals = {\n        "cost_dollars_per_hour": float(round(total_cost, 2)),\n        "load_MW": float(round(np.sum(bus_data[:, 2]), 2)),\n        "generation_MW": float(round(np.sum(pg), 2)),\n        "reserve_MW": float(round(np.sum(rg), 2))\n    }\n\n    most_loaded_lines = []\n    for i in range(num_branches):\n        if branch_data[i, 10] == 0: continue\n        f_bus = int(branch_data[i, 0])\n        t_bus = int(branch_data[i, 1])\n        f_idx = bus_id_to_idx[f_bus]\n        t_idx = bus_id_to_idx[t_bus]\n        x = branch_data[i, 3]\n        if x == 0: x = 0.0001\n        flow = abs(theta[f_idx] - theta[t_idx]) / x * baseMVA\n        limit = branch_data[i, 5]\n        loading_pct = (flow / limit * 100.0) if limit > 0 else 0.0\n        most_loaded_lines.append({"from": f_bus, "to": t_bus, "loading_pct": float(round(loading_pct, 2))})\n\n    most_loaded_lines.sort(key=lambda x: x[\'loading_pct\'], reverse=True)\n    \n    # Operating margin: sum(Pmax_i) - sum(Pg_i + Rg_i)\n    operating_margin = np.sum(gen_data[:, 8]) - np.sum(pg + rg)\n\n    report = {\n        "generator_dispatch": generator_dispatch,\n        "totals": totals,\n        "most_loaded_lines": most_loaded_lines[:3],\n        "operating_margin_MW": float(round(operating_margin, 2))\n    }\n\n    with open(\'report.json\', \'w\') as f:\n        json.dump(report, f, indent=2)\n    print("Report generated successfully")\n\nsolve()\nEOF\npython3 solution.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
