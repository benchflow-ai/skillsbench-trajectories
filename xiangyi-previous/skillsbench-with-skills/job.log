Sending keys: ['python3 << \'EOF\'\nimport json\nimport numpy as np\n\n# Load control log\nwith open(\'control_log.json\', \'r\') as f:\n    log = json.load(f)\n\ndata = log[\'data\']\nsetpoint = log[\'setpoint\']\n\ntimes = np.array([d[\'time\'] for d in data])\ntemps = np.array([d[\'temperature\'] for d in data])\nerrors = np.array([d[\'error\'] for d in data])\n\nT_initial = np.mean(temps[:5])\nprint(f"Initial temp: {T_initial:.2f}C")\nprint(f"Setpoint: {setpoint}C")\nprint(f"Temperature change: {setpoint - T_initial:.2f}C")\n\n# Check settling with different criteria\nfor settling_pct in [0.02, 0.05, 0.10]:\n    settling_band = settling_pct * abs(setpoint - T_initial)\n    print(f"\\nSettling band ({settling_pct*100:.0f}%): ±{settling_band:.4f}C")\n    \n    # Find first time it enters and stays in band for 10 seconds (20 points)\n    for i in range(len(temps) - 20):\n        if all(abs(temps[i:i+20] - setpoint) <= settling_band):\n            print(f"  Settled at t={times[i]:.1f}s")\n            break\n    else:\n        print(f"  Not settled within duration")\n\n# Show last 20 data points\nprint("\\nLast 20 data points:")\nfor i in range(-20, 0):\n    print(f"  t={times[i]:.1f}s: T={temps[i]:.2f}C, error={errors[i]:.4f}C")\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
