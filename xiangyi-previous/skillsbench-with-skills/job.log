Sending keys: ['cat > estimate_params.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nimport numpy as np\nfrom scipy.optimize import curve_fit\n\n# Load calibration data\nwith open("calibration_log.json", "r") as f:\n    cal_data = json.load(f)\n\ndata = cal_data["data"]\ntest_power = cal_data["heater_power_test"]\n\n# Extract time and temperature arrays (skip first point which is at power=0)\ntimes = np.array([d["time"] for d in data[1:]])\ntemps = np.array([d["temperature"] for d in data[1:]])\n\n# Initial temperature (from first measurement)\nT_initial = data[0]["temperature"]\nT_ambient = 18.0  # From config\n\nprint(f"Calibration data: {len(times)} points")\nprint(f"Initial temperature: {T_initial:.2f}C")\nprint(f"Test heater power: {test_power}%")\nprint(f"Final temperature: {temps[-1]:.2f}C")\n\n# First-order step response model\n# T(t) = T_ambient + K*u*(1 - exp(-t/tau))\n# where u is heater power\ndef first_order_response(t, K, tau):\n    return T_ambient + K * test_power * (1 - np.exp(-t / tau))\n\n# Initial guesses\n# At steady state: T_ss = T_ambient + K*u\n# From data, T_ss appears to be around 24C (extrapolating)\n# So K ~ (24 - 18) / 50 = 0.12\n# tau is roughly time to reach 63.2% of final value\nK_guess = 0.12\ntau_guess = 30.0\n\n# Fit the model\ntry:\n    popt, pcov = curve_fit(first_order_response, times, temps, \n                           p0=[K_guess, tau_guess],\n                           bounds=([0.01, 5.0], [0.5, 200.0]),\n                           maxfev=5000)\n    K_est, tau_est = popt\n    \n    # Calculate R-squared and fitting error\n    temps_pred = first_order_response(times, K_est, tau_est)\n    ss_res = np.sum((temps - temps_pred) ** 2)\n    ss_tot = np.sum((temps - np.mean(temps)) ** 2)\n    r_squared = 1 - (ss_res / ss_tot)\n    fitting_error = np.sqrt(np.mean((temps - temps_pred) ** 2))  # RMSE\n    \n    print(f"\\nEstimated parameters:")\n    print(f"  K (process gain): {K_est:.4f} C/%")\n    print(f"  tau (time constant): {tau_est:.2f} s")\n    print(f"  R-squared: {r_squared:.4f}")\n    print(f"  Fitting error (RMSE): {fitting_error:.4f} C")\n    \n    # Verify: steady-state temperature should be T_ambient + K*100 for 100% power\n    T_ss_100 = T_ambient + K_est * 100\n    print(f"\\nPredicted steady-state at 100% power: {T_ss_100:.2f}C")\n    print(f"Predicted steady-state at 50% power: {T_ambient + K_est * 50:.2f}C")\n    \n    # Save estimated parameters\n    params = {\n        "K": round(K_est, 4),\n        "tau": round(tau_est, 2),\n        "r_squared": round(r_squared, 4),\n        "fitting_error": round(fitting_error, 4)\n    }\n    \n    with open("estimated_params.json", "w") as f:\n        json.dump(params, f, indent=2)\n    \n    print(f"\\nSaved to estimated_params.json")\n    \nexcept Exception as e:\n    print(f"Curve fitting failed: {e}")\n    # Fallback: manual estimation\n    # Use the 63.2% method for tau\n    T_final = np.mean(temps[-10:])  # Average of last 10 points\n    T_63 = T_initial + 0.632 * (T_final - T_initial)\n    \n    # Find time when temp crosses T_63\n    for i, t in enumerate(temps):\n        if t >= T_63:\n            tau_est = times[i]\n            break\n    else:\n        tau_est = 40.0\n    \n    # Estimate K from final temperature (not yet at steady state)\n    # Extrapolate: T_ss = T_ambient + K*u\n    # At t=35s, we\'re at about (1 - exp(-35/tau)) of the way there\n    fraction = 1 - np.exp(-35.0 / tau_est)\n    T_ss_est = T_initial + (T_final - T_initial) / fraction\n    K_est = (T_ss_est - T_ambient) / test_power\n    \n    print(f"\\nManual estimation:")\n    print(f"  K: {K_est:.4f}")\n    print(f"  tau: {tau_est:.2f}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
