ime(pick_time)\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'P\',\n            \'time\': pick_time,\n            \'trace_id\': trace_id\n        })\n\nfor pick in s_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split(\'.\')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'S\',\n            \'time\': pick_time,\n            \'trace_id\': trace_id\n        })\n\nprint(f"Total picks: {len(all_picks)}")\n\n# Group picks by station and phase\npicks_by_station = defaultdict(lambda: {\'P\': [], \'S\': []})\nfor pick in all_picks:\n    key = f"{pick[\'network\']}.{pick[\'station\']}"\n    picks_by_station[key][pick[\'phase\']].append(pick[\'time\'])\n\nprint(f"Picks organized at {len(picks_by_station)} stations")\n\n# For each station, get all P-S time pairs\nps_pairs = []  # List of (station, p_time, s_time, ps_time_diff)\nfor station, phases in picks_by_station.items():\n    if phases[\'P\'] and phases[\'S\']:\n        # Get all combinations of P and S picks\n        for p_time in phases[\'P\']:\n            for s_time in phases[\'S\']:\n                if s_time > p_time:  # S should come after P\n                    ps_diff = float(s_time - p_time)\n                    ps_pairs.append({\n                        \'station\': station,\n                        \'p_time\': p_time,\n                        \'s_time\': s_time,\n                        \'ps_diff\': ps_diff\n                    })\n\nprint(f"\\nTotal P-S pairs: {len(ps_pairs)}")\nprint("Sample P-S differences:")\nfor pair in ps_pairs[:5]:\n    print(f"  {pair[\'station\']}: P-S = {pair[\'ps_diff\']:.2f}s")\n\nEOFPYTHON\n'] min_timeout_sec: 1.0 