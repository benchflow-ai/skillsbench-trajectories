Sending keys: ['cat > parallel_solution.py << \'EOF\'\n#!/usr/bin/env python3\n"""\nParallel TF-IDF Implementation\n\nParallelizes the TF-IDF index building and search operations using multiprocessing\nto achieve speedup on multi-core systems.\n"""\n\nimport math\nimport re\nimport time\nfrom collections import defaultdict\nfrom concurrent.futures import ProcessPoolExecutor\nfrom dataclasses import dataclass, field\nfrom heapq import nlargest\nfrom typing import List\n\nfrom document_generator import Document\nfrom sequential import (\n    SearchResult,\n    TFIDFIndex,\n    STOP_WORDS,\n    TOKEN_PATTERN,\n    compute_term_frequencies,\n    tokenize,\n)\n\n\n@dataclass\nclass ParallelIndexingResult:\n    """Result from parallel index building."""\n\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\n\ndef _worker_tokenize_and_tf(doc: Document) -> tuple[int, dict[str, float]]:\n    """\n    Worker function to tokenize a document and compute term frequencies.\n    Returns (doc_id, term_frequencies).\n    """\n    tokens = tokenize(doc.content)\n    tf = compute_term_frequencies(tokens)\n    return doc.doc_id, tf\n\n\ndef build_tfidf_index_parallel(\n    documents: List[Document],\n    num_workers: int = None,\n    chunk_size: int = 500,\n) -> ParallelIndexingResult:\n    """\n    Build TF-IDF index in parallel.\n\n    Args:\n        documents: List of Document objects\n        num_workers: Number of worker processes (default: CPU count)\n        chunk_size: Chunk size for processing (default: 500)\n\n    Returns:\n        ParallelIndexingResult containing TFIDFIndex and timing info\n    """\n    start_time = time.perf_counter()\n\n    # Phase 1: Parallel tokenization and TF computation\n    doc_tfs = {}\n    all_tokens = defaultdict(int)  # For document frequency computation\n\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_worker_tokenize_and_tf, doc) for doc in documents]\n        for future in futures:\n            doc_id, tf = future.result()\n            doc_tfs[doc_id] = tf\n            # Count document frequencies (number of documents containing each term)\n            for term in tf.keys():\n                all_tokens[term] += 1\n\n    # Phase 2: Sequential IDF computation (must be done after all docs are processed)\n    num_docs = len(documents)\n    idf = {}\n    vocabulary = set()\n\n    for term, doc_count in all_tokens.items():\n        vocabulary.add(term)\n        # IDF = log(N / df)\n        idf[term] = math.log(num_docs / doc_count)\n\n    # Phase 3: Build inverted index and doc vectors\n    inverted_index = defaultdict(list)\n    doc_vectors = {}\n    doc_norms = {}\n\n    for doc_id, tf_dict in doc_tfs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n\n        for term, tf in tf_dict.items():\n            tfidf = tf * idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n            inverted_index[term].append((doc_id, tfidf))\n\n        doc_vectors[doc_id] = doc_vector\n        doc_norms[doc_id] = math.sqrt(norm_squared)\n\n    # Create index\n    index = TFIDFIndex(\n        num_documents=num_docs,\n        vocabulary=vocabulary,\n        document_frequencies=dict(all_tokens),\n        idf=idf,\n        inverted_index=dict(inverted_index),\n        doc_vectors=doc_vectors,\n        doc_norms=doc_norms,\n    )\n\n    elapsed_time = time.perf_counter() - start_time\n\n    return ParallelIndexingResult(\n        index=index,\n        elapsed_time=elapsed_time,\n        num_documents=num_docs,\n        vocabulary_size=len(vocabulary),\n    )\n\n\ndef _worker_search_query(\n    query: str,\n    query_vector: dict,\n    query_norm: float,\n    inverted_index: dict,\n    doc_vectors: dict,\n    doc_norms: dict,\n    top_k: int,\n) -> List[SearchResult]:\n    """\n    Worker function to search a single query.\n    Returns list of SearchResult objects.\n    """\n    if not query_vector:\n        return []\n\n    # Find candidate documents\n    candidate_docs = set()\n    for term in query_vector:\n        if term in inverted_index:\n            for doc_id, _ in inverted_index[term]:\n                candidate_docs.add(doc_id)\n\n    # Compute cosine similarity\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = doc_vectors.get(doc_id, {})\n        doc_norm = doc_norms.get(doc_id, 0)\n\n        if doc_norm == 0:\n            continue\n\n        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n\n    # Get top-k results\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    results = [SearchResult(doc_id=doc_id, score=score) for doc_id, score in top_results]\n\n    return results\n\n\ndef batch_search_parallel(\n    queries: List[str],\n    index: TFIDFIndex,\n    top_k: int = 10,\n    num_workers: int = None,\n    documents: List[Document] = None,\n) -> tuple[List[List[SearchResult]], float]:\n    """\n    Search for multiple queries in parallel.\n\n    Args:\n        queries: List of search query strings\n        index: TF-IDF index to search\n        top_k: Number of top results per query\n        num_workers: Number of worker processes (default: CPU count)\n        documents: Optional list of documents for title lookup\n\n    Returns:\n        Tuple of (results, elapsed_time) where results is a list of result lists\n    """\n    start_time = time.perf_counter()\n\n    # Pre-compute query vectors for all queries\n    query_vectors = []\n    query_norms = []\n\n    for query in queries:\n        query_tokens = tokenize(query)\n        if not query_tokens:\n            query_vectors.append({})\n            query_norms.append(0.0)\n            continue\n\n        query_tf = compute_term_frequencies(query_tokens)\n        query_vector = {}\n        query_norm_squared = 0.0\n\n        for term, tf in query_tf.items():\n            if term in index.idf:\n                tfidf = tf * index.idf[term]\n                query_vector[term] = tfidf\n                query_norm_squared += tfidf * tfidf\n\n        query_vectors.append(query_vector)\n        query_norms.append(math.sqrt(query_norm_squared))\n\n    # Prepare worker arguments\n    worker_args = [\n        (\n            queries[i],\n            query_vectors[i],\n            query_norms[i],\n            index.inverted_index,\n            index.doc_vectors,\n            index.doc_norms,\n            top_k,\n        )\n        for i in range(len(queries))\n    ]\n\n    results = []\n    with ProcessPoolExecutor(max_workers=num_workers) as executor:\n        futures = [executor.submit(_worker_search_query, *args) for args in worker_args]\n        for future in futures:\n            results.append(future.result())\n\n    # Add titles if documents provided\n    if documents:\n        doc_titles = {d.doc_id: d.title for d in documents}\n        for result_list in results:\n            for result in result_list:\n                result.title = doc_titles.get(result.doc_id, f"Document {result.doc_id}")\n\n    elapsed_time = time.perf_counter() - start_time\n\n    return results, elapsed_time\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
