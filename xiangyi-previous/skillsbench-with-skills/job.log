Sending keys: ['cat > test_parallel.py << \'EOF\'\n#!/usr/bin/env python3\n"""Test script for parallel TF-IDF implementation."""\n\nimport sys\nfrom document_generator import generate_corpus\nfrom sequential import build_tfidf_index_sequential, batch_search_sequential\nfrom parallel_solution import build_tfidf_index_parallel, batch_search_parallel\n\ndef test_index_building():\n    """Test parallel index building."""\n    print("Testing parallel index building...")\n    \n    # Generate test corpus\n    documents = generate_corpus(2000, seed=42)\n    print(f"Generated {len(documents)} documents")\n    \n    # Build sequential index\n    print("\\nBuilding sequential index...")\n    seq_result = build_tfidf_index_sequential(documents)\n    print(f"Sequential time: {seq_result.elapsed_time:.3f}s")\n    print(f"Vocabulary size: {seq_result.vocabulary_size}")\n    \n    # Build parallel index\n    print("\\nBuilding parallel index (4 workers)...")\n    par_result = build_tfidf_index_parallel(documents, num_workers=4, chunk_size=500)\n    print(f"Parallel time: {par_result.elapsed_time:.3f}s")\n    print(f"Vocabulary size: {par_result.vocabulary_size}")\n    \n    # Check speedup\n    speedup = seq_result.elapsed_time / par_result.elapsed_time\n    print(f"\\nSpeedup: {speedup:.2f}x")\n    \n    # Verify correctness\n    print("\\nVerifying correctness...")\n    assert seq_result.vocabulary_size == par_result.vocabulary_size, "Vocabulary size mismatch"\n    assert seq_result.num_documents == par_result.num_documents, "Document count mismatch"\n    assert seq_result.index.vocabulary == par_result.index.vocabulary, "Vocabulary mismatch"\n    \n    # Check a few IDF values\n    sample_terms = list(seq_result.index.vocabulary)[:10]\n    for term in sample_terms:\n        seq_idf = seq_result.index.idf.get(term, 0)\n        par_idf = par_result.index.idf.get(term, 0)\n        assert abs(seq_idf - par_idf) < 1e-9, f"IDF mismatch for \'{term}\'"\n    \n    print("✓ Index building correctness verified")\n    \n    if speedup >= 1.5:\n        print(f"✓ Speedup target met: {speedup:.2f}x >= 1.5x")\n    else:\n        print(f"✗ Speedup target not met: {speedup:.2f}x < 1.5x")\n    \n    return seq_result, par_result, documents\n\ndef test_batch_search(seq_result, par_result, documents):\n    """Test parallel batch search."""\n    print("\\n" + "="*60)\n    print("Testing parallel batch search...")\n    \n    # Create test queries\n    queries = [\n        "machine learning algorithms",\n        "data science analysis",\n        "artificial intelligence",\n        "deep neural networks",\n        "computer vision systems",\n        "natural language processing",\n        "reinforcement learning agents",\n        "statistical models",\n    ]\n    \n    print(f"\\nSearching {len(queries)} queries...")\n    \n    # Sequential search\n    print("\\nSequential batch search...")\n    import time\n    start = time.perf_counter()\n    seq_results = batch_search_sequential(queries, seq_result.index, top_k=10, documents=documents)\n    seq_time = time.perf_counter() - start\n    print(f"Sequential time: {seq_time:.3f}s")\n    \n    # Parallel search\n    print("\\nParallel batch search (4 workers)...")\n    par_results, par_time = batch_search_parallel(queries, par_result.index, top_k=10, num_workers=4, documents=documents)\n    print(f"Parallel time: {par_time:.3f}s")\n    \n    # Check speedup\n    speedup = seq_time / par_time\n    print(f"\\nSpeedup: {speedup:.2f}x")\n    \n    # Verify correctness\n    print("\\nVerifying correctness...")\n    assert len(seq_results) == len(par_results), "Result count mismatch"\n    \n    for i, (seq_res, par_res) in enumerate(zip(seq_results, par_results)):\n        assert len(seq_res) == len(par_res), f"Query {i} result count mismatch"\n        for j, (s, p) in enumerate(zip(seq_res, par_res)):\n            assert s.doc_id == p.doc_id, f"Query {i}, result {j}: doc_id mismatch"\n            assert abs(s.score - p.score) < 1e-9, f"Query {i}, result {j}: score mismatch"\n    \n    print("✓ Batch search correctness verified")\n    \n    if speedup >= 2.0:\n        print(f"✓ Speedup target met: {speedup:.2f}x >= 2.0x")\n    else:\n        print(f"✗ Speedup target not met: {speedup:.2f}x < 2.0x")\n\ndef main():\n    print("="*60)\n    print("Parallel TF-IDF Implementation Test")\n    print("="*60)\n    \n    try:\n        seq_result, par_result, documents = test_index_building()\n        test_batch_search(seq_result, par_result, documents)\n        \n        print("\\n" + "="*60)\n        print("All tests passed!")\n        print("="*60)\n        return 0\n    except Exception as e:\n        print(f"\\n✗ Test failed: {e}")\n        import traceback\n        traceback.print_exc()\n        return 1\n\nif __name__ == "__main__":\n    sys.exit(main())\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
