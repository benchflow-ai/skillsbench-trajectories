Sending keys: ['cat << \'EOF\' > process_data.py\nimport pandas as pd\nimport numpy as np\n\ndef clean_value(val):\n    if pd.isna(val):\n        return np.nan\n    if isinstance(val, str):\n        val = val.replace(\',\', \'.\')\n        try:\n            return float(val)\n        except ValueError:\n            return np.nan\n    return float(val)\n\ndf = pd.read_csv(\'/root/environment/data/ckd_lab_data.csv\')\ndf = df.dropna()\nfor col in df.columns:\n    if col != \'patient_id\':\n        df[col] = df[col].apply(clean_value)\ndf = df.dropna()\n\ndef harmonize(row):\n    # Serum_Creatinine (mg/dL): normal 0.7-1.3, CKD up to 20.\n    # if > 50, likely umol/L. \n    if row[\'Serum_Creatinine\'] > 50: row[\'Serum_Creatinine\'] /= 88.4\n    \n    # BUN (mg/dL): normal 7-20, CKD up to 200.\n    # If < 5 and Creatinine is high, likely mmol/L.\n    if row[\'BUN\'] < 5 and row[\'Serum_Creatinine\'] > 2: row[\'BUN\'] /= 0.357\n\n    # Serum_Calcium (mg/dL): normal 8.5-10.5.\n    # If < 5, likely mmol/L.\n    if row[\'Serum_Calcium\'] < 5: row[\'Serum_Calcium\'] *= 4.0\n    \n    # Phosphorus (mg/dL): normal 2.5-4.5.\n    # If < 2, likely mmol/L.\n    if row[\'Phosphorus\'] < 2: row[\'Phosphorus\'] *= 3.1\n\n    # Magnesium (mg/dL): normal 1.7-2.2.\n    # If < 1.2, likely mmol/L.\n    if row[\'Magnesium\'] < 1.2: row[\'Magnesium\'] *= 2.43\n\n    # Hemoglobin (g/dL): normal 12-16.\n    # If > 30, likely g/L.\n    if row[\'Hemoglobin\'] > 30: row[\'Hemoglobin\'] /= 10.0\n    # If Hemoglobin < 5, likely mmol/L.\n    if row[\'Hemoglobin\'] < 5: row[\'Hemoglobin\'] *= 1.61\n\n    # Albumin_Serum (g/dL): normal 3.5-5.0.\n    if row[\'Albumin_Serum\'] > 10: row[\'Albumin_Serum\'] /= 10.0\n    elif row[\'Albumin_Serum\'] < 1.0: row[\'Albumin_Serum\'] *= 1.0 # already g/dL?\n    \n    # Total_Protein (g/dL): normal 6-8.\n    if row[\'Total_Protein\'] > 15: row[\'Total_Protein\'] /= 10.0\n\n    # Glucose (mg/dL): normal 70-100.\n    if row[\'Glucose\'] < 25: row[\'Glucose\'] *= 18.0\n    \n    # Uric_Acid (mg/dL): normal 3-7.\n    if row[\'Uric_Acid\'] > 50: row[\'Uric_Acid\'] /= 16.8\n\n    # Cholesterol (mg/dL): normal < 200.\n    for col in [\'Total_Cholesterol\', \'LDL_Cholesterol\', \'HDL_Cholesterol\', \'Triglycerides\', \'Non_HDL_Cholesterol\']:\n        if row[col] < 15: \n            if \'Triglycerides\' in col:\n                row[col] *= 88.5\n            else:\n                row[col] *= 38.6\n\n    # Bilirubin (mg/dL): normal 0.1-1.2.\n    if row[\'Total_Bilirubin\'] > 5: row[\'Total_Bilirubin\'] /= 17.1\n    if row[\'Direct_Bilirubin\'] > 5: row[\'Direct_Bilirubin\'] /= 17.1\n\n    # Serum_Iron (ug/dL): normal 60-170.\n    if row[\'Serum_Iron\'] < 20: row[\'Serum_Iron\'] *= 55.8 # umol/L to ug/dL\n    \n    return row\n\ndf = df.apply(harmonize, axis=1)\n\n# Round to 2 decimal places and format as X.XX\nfor col in df.columns:\n    if col != \'patient_id\':\n        df[col] = df[col].apply(lambda x: "{:.2f}".format(x))\n    else:\n        df[col] = df[col].astype(int)\n\ndf.to_csv(\'/root/ckd_lab_data_harmonized.csv\', index=False)\nEOF\npython3 process_data.py\nhead -n 5 /root/ckd_lab_data_harmonized.csv\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
