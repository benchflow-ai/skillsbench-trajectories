Sending keys: ['cat > /root/process_pptx_v2.py << \'EOF\'\nfrom pptx import Presentation\nfrom pptx.util import Inches, Pt\nfrom pptx.enum.text import PP_ALIGN, MSO_ANCHOR\nfrom pptx.dml.color import RGBColor\nfrom pptx.enum.shapes import MSO_SHAPE_TYPE\nfrom collections import OrderedDict\n\n# Load presentation\nprs = Presentation(\'/root/Awesome-Agent-Papers.pptx\')\n\n# Collect all unique paper titles\npaper_titles = OrderedDict()\n\n# Process each slide\nfor slide_idx, slide in enumerate(prs.slides):\n    print(f"Processing slide {slide_idx + 1}")\n    \n    # Find TEXT_BOX shapes (dangling titles)\n    for shape in slide.shapes:\n        # Check if it\'s a TEXT_BOX\n        if shape.shape_type == MSO_SHAPE_TYPE.TEXT_BOX:\n            if hasattr(shape, "text_frame"):\n                text = shape.text.strip()\n                if text:\n                    print(f"  Found title: {text[:60]}...")\n                    \n                    # Store unique titles\n                    if text not in paper_titles:\n                        paper_titles[text] = True\n                    \n                    # Format the text box\n                    text_frame = shape.text_frame\n                    text_frame.word_wrap = True\n                    text_frame.vertical_anchor = MSO_ANCHOR.MIDDLE\n                    \n                    # Format all paragraphs and runs\n                    for paragraph in text_frame.paragraphs:\n                        paragraph.alignment = PP_ALIGN.CENTER\n                        \n                        for run in paragraph.runs:\n                            run.font.name = \'Arial\'\n                            run.font.size = Pt(16)\n                            run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)\n                            run.font.bold = False\n                    \n                    # Adjust shape position and size\n                    slide_width = prs.slide_width\n                    slide_height = prs.slide_height\n                    \n                    # Set width to 90% of slide width for single-line display\n                    shape.width = int(slide_width * 0.9)\n                    shape.left = int((slide_width - shape.width) / 2)\n                    \n                    # Position at bottom center (0.8 inches from bottom)\n                    shape.top = int(slide_height - Inches(0.8))\n                    shape.height = Inches(0.6)\n\nprint(f"\\nTotal unique paper titles found: {len(paper_titles)}")\nfor idx, title in enumerate(paper_titles.keys(), 1):\n    print(f"{idx}. {title}")\n\n# Create Reference slide\nblank_slide_layout = prs.slide_layouts[6]  # Blank layout\nreference_slide = prs.slides.add_slide(blank_slide_layout)\n\n# Add title "Reference" at the top\ntitle_box = reference_slide.shapes.add_textbox(Inches(0.5), Inches(0.5), Inches(9), Inches(0.8))\ntitle_frame = title_box.text_frame\ntitle_frame.text = "Reference"\ntitle_paragraph = title_frame.paragraphs[0]\ntitle_paragraph.alignment = PP_ALIGN.CENTER\ntitle_run = title_paragraph.runs[0]\ntitle_run.font.name = \'Arial\'\ntitle_run.font.size = Pt(16)\ntitle_run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)\ntitle_run.font.bold = False\n\n# Add content with auto-numbered bullet points\ncontent_box = reference_slide.shapes.add_textbox(Inches(0.8), Inches(1.5), Inches(8.4), Inches(5.5))\ncontent_frame = content_box.text_frame\ncontent_frame.word_wrap = True\n\nfor idx, title in enumerate(paper_titles.keys(), 1):\n    if idx == 1:\n        p = content_frame.paragraphs[0]\n    else:\n        p = content_frame.add_paragraph()\n    \n    # Set numbering\n    p.text = title\n    p.level = 0\n    \n    # Format text\n    for run in p.runs:\n        run.font.name = \'Arial\'\n        run.font.size = Pt(16)\n        run.font.color.rgb = RGBColor(0x98, 0x95, 0x96)\n        run.font.bold = False\n\n# Save processed presentation\nprs.save(\'/root/Awesome-Agent-Papers_processed.pptx\')\nprint("\\nPresentation processed and saved to /root/Awesome-Agent-Papers_processed.pptx")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
