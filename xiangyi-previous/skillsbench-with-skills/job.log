t(key=lambda x: (x[\'end\'], x[\'start_shift\']))\n                \n                if candidates:\n                    chosen = candidates[0]\n                    \n                    if chosen[\'machine_changed\']:\n                        machine_changes += 1\n                    total_start_shift += chosen[\'start_shift\']\n                    \n                    new_schedule.append({\n                        \'job\': job,\n                        \'op\': op,\n                        \'machine\': chosen[\'machine\'],\n                        \'start\': chosen[\'start\'],\n                        \'end\': chosen[\'end\'],\n                        \'dur\': chosen[\'duration\']\n                    })\n\nmakespan = max(op[\'end\'] for op in new_schedule)\nviolations = sum(1 for op in new_schedule if overlaps_downtime(op[\'machine\'], op[\'start\'], op[\'end\'], downtimes))\n\nprint(f"Makespan: {makespan} (max: {max_makespan})")\nprint(f"Machine changes: {machine_changes} (max: {max_machine_changes})")\nprint(f"Total start shift: {total_start_shift} (max: {max_start_shift})")\nprint(f"Downtime violations: {violations}\\n")\n\nfor op in sorted(new_schedule, key=lambda x: (x[\'job\'], x[\'op\'])):\n    bl = baseline_dict[(op[\'job\'], op[\'op\'])]\n    mc = \'MC\' if op[\'machine\'] != bl[\'machine\'] else \'  \'\n    print(f"{mc} J{op[\'job\']}O{op[\'op\']}: M{op[\'machine\']} [{op[\'start\']:2d}-{op[\'end\']:2d}] (was M{bl[\'machine\']} [{bl[\'start\']:2d}-{bl[\'end\']:2d}])")\n\nif violations == 0 and machine_changes <= max_machine_changes and total_start_shift <= max_start_shift and makespan <= max_makespan:\n    print("\\n*** SOLUTION IS FEASIBLE! ***")\n    \n    solution = {\n        \'status\': \'feasible\',\n        \'makespan\': makespan,\n        \'schedule\': sorted(new_schedule, key=lambda x: (x[\'start\'], x[\'job\'], x[\'op\']))\n    }\n    \n    with open(\'/app/output/solution.json\', \'w\') as f:\n        json.dump(solution, f, indent=2)\n    \n 