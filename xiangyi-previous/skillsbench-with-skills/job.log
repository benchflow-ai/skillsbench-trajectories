Sending keys: ['cat > solve_dcopf_v2.py << \'EOF\'\nimport json\nimport numpy as np\nimport cvxpy as cp\n\ndef load_network(filename):\n    with open(filename, \'r\') as f:\n        return json.load(f)\n\ndef build_incidence_matrix(buses, branches, bus_idx):\n    """Build branch-bus incidence matrix for DC power flow"""\n    n_bus = len(buses)\n    n_branch = len(branches)\n    \n    A = np.zeros((n_branch, n_bus))\n    \n    for b in range(n_branch):\n        if branches[b, 10] == 0:  # Out of service\n            continue\n        \n        f_bus = int(branches[b, 0])\n        t_bus = int(branches[b, 1])\n        \n        if f_bus in bus_idx and t_bus in bus_idx:\n            f_idx = bus_idx[f_bus]\n            t_idx = bus_idx[t_bus]\n            A[b, f_idx] = 1\n            A[b, t_idx] = -1\n    \n    return A\n\ndef solve_dcopf_with_reserves(data, branch_modifications=None):\n    baseMVA = data[\'baseMVA\']\n    buses = np.array(data[\'bus\'])\n    gens = np.array(data[\'gen\'])\n    branches = np.array(data[\'branch\']).copy()\n    gencost = np.array(data[\'gencost\'])\n    reserve_capacity = np.array(data[\'reserve_capacity\'])\n    reserve_requirement = data[\'reserve_requirement\']\n    \n    if branch_modifications:\n        for branch_idx, new_limit in branch_modifications.items():\n            branches[branch_idx, 5] = new_limit\n    \n    n_bus = len(buses)\n    n_gen = len(gens)\n    n_branch = len(branches)\n    \n    bus_nums = buses[:, 0].astype(int)\n    bus_idx = {int(num): i for i, num in enumerate(bus_nums)}\n    \n    gen_status = gens[:, 7]\n    active_gens = (gen_status == 1)\n    \n    # Decision variables\n    pg = cp.Variable(n_gen)\n    theta = cp.Variable(n_bus)\n    reserve = cp.Variable(n_gen)\n    \n    # Build cost function\n    costs = []\n    for i in range(n_gen):\n        cost_data = gencost[i]\n        ncost = int(cost_data[3])\n        coeffs = cost_data[4:4+ncost]\n        \n        if ncost == 3:  # Quadratic\n            costs.append(coeffs[0] * cp.square(pg[i]) + coeffs[1] * pg[i] + coeffs[2])\n        elif ncost == 2:  # Linear\n            costs.append(coeffs[0] * pg[i] + coeffs[1])\n        else:\n            costs.append(0)\n    \n    # Reserve costs (10% of marginal energy cost)\n    reserve_cost = 0\n    for i in range(n_gen):\n        cost_data = gencost[i]\n        ncost = int(cost_data[3])\n        if ncost >= 2:\n            coeffs = cost_data[4:4+ncost]\n            mc = coeffs[1] if ncost == 3 else coeffs[0]\n            reserve_cost += 0.1 * mc * reserve[i]\n    \n    objective = cp.Minimize(cp.sum(costs) + reserve_cost)\n    \n    constraints = []\n    \n    # Generator constraints\n    for i in range(n_gen):\n        if active_gens[i]:\n            constraints.append(pg[i] >= gens[i, 9])  # PMIN\n            constraints.append(pg[i] <= gens[i, 8])  # PMAX\n            constraints.append(reserve[i] >= 0)\n            constraints.append(reserve[i] <= reserve_capacity[i])\n            constraints.append(pg[i] + reserve[i] <= gens[i, 8])  # Capacity coupling\n        else:\n            constraints.append(pg[i] == 0)\n            constraints.append(reserve[i] == 0)\n    \n    # System reserve requirement\n    constraints.append(cp.sum(reserve) >= reserve_requirement)\n    \n    # Reference angle (slack bus)\n    slack_idx = 0\n    for i, bus in enumerate(buses):\n        if bus[1] == 3:\n            slack_idx = i\n            break\n    constraints.append(theta[slack_idx] == 0)\n    \n    # Power balance at each bus\n    for i in range(n_bus):\n        bus_num = int(buses[i, 0])\n        \n        # Generation\n        gen_power = 0\n        for g in range(n_gen):\n            if int(gens[g, 0]) == bus_num:\n                gen_power += pg[g]\n        \n        # Load\n        load = buses[i, 2]\n        \n        # Net flow\n        net_flow = 0\n        for b in range(n_branch):\n            if branches[b, 10] == 0:\n                continue\n            \n            f_bus = int(branches[b, 0])\n            t_bus = int(branches[b, 1])\n            x = branches[b, 3]\n            \n            if x <= 1e-6:\n                continue\n            \n            if f_bus == bus_num:\n                f_idx = bus_idx[f_bus]\n                t_idx = bus_idx[t_bus]\n                net_flow += (theta[f_idx] - theta[t_idx]) / x * baseMVA\n            elif t_bus == bus_num:\n                f_idx = bus_idx[f_bus]\n                t_idx = bus_idx[t_bus]\n                net_flow -= (theta[f_idx] - theta[t_idx]) / x * baseMVA\n        \n        constraints.append(gen_power == load + net_flow)\n    \n    # Branch flow limits\n    for b in range(n_branch):\n        if branches[b, 10] == 0:\n            continue\n        \n        f_bus = int(branches[b, 0])\n        t_bus = int(branches[b, 1])\n        x = branches[b, 3]\n        rate_a = branches[b, 5]\n        \n        if x <= 1e-6 or rate_a <= 0:\n            continue\n        \n        f_idx = bus_idx[f_bus]\n        t_idx = bus_idx[t_bus]\n        \n        flow_pu = (theta[f_idx] - theta[t_idx]) / x\n        \n        constraints.append(flow_pu <= rate_a / baseMVA)\n        constraints.append(flow_pu >= -rate_a / baseMVA)\n    \n    # Solve\n    problem = cp.Problem(objective, constraints)\n    \n    try:\n        problem.solve(solver=cp.SCS, verbose=True, eps=1e-4, max_iters=5000)\n    except Exception as e:\n        print(f"Solver error: {e}")\n        return None\n    \n    print(f"Solver status: {problem.status}")\n    print(f"Optimal value: {problem.value}")\n    \n    if problem.status not in [cp.OPTIMAL, cp.OPTIMAL_INACCURATE]:\n        print("Warning: Problem not solved optimally")\n        # Try with different solver\n        try:\n            problem.solve(solver=cp.OSQP, verbose=True, eps_abs=1e-4, eps_rel=1e-4, max_iter=10000)\n            print(f"OSQP Solver status: {problem.status}")\n        except:\n            pass\n    \n    return {\n        \'status\': problem.status,\n        \'total_cost\': problem.value,\n        \'pg\': pg.value,\n        \'theta\': theta.value,\n        \'reserve\': reserve.value,\n        \'buses\': buses,\n        \'gens\': gens,\n        \'branches\': branches,\n        \'baseMVA\': baseMVA,\n        \'bus_idx\': bus_idx,\n        \'gencost\': gencost,\n        \'active_gens\': active_gens\n    }\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
