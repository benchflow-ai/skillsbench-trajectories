Sending keys: ['cat >> control_system.py << \'EOF\'\n    \n    def calculate_metrics(self, temps, times, errors, setpoint):\n        """Calculate control performance metrics."""\n        print(f"\\n=== PERFORMANCE METRICS ===")\n        target_90 = temps[0] + 0.9 * (setpoint - temps[0])\n        rise_time_idx = np.where(temps >= target_90)[0]\n        rise_time = times[rise_time_idx[0]] if len(rise_time_idx) > 0 else times[-1]\n        max_temp = np.max(temps)\n        overshoot = max(0, (max_temp - setpoint) / (setpoint - temps[0]))\n        settled_region = np.abs(errors) < 0.5\n        if np.any(settled_region):\n            settled_idx = np.where(settled_region)[0]\n            settling_time = times[-1]\n            for i in range(len(settled_idx) - 10):\n                if np.all(settled_region[settled_idx[i]:settled_idx[i]+10]):\n                    settling_time = times[settled_idx[i]]\n                    break\n        else:\n            settling_time = times[-1]\n        last_30s_idx = np.where(times >= times[-1] - 30)[0]\n        steady_state_error = np.mean(np.abs(errors[last_30s_idx])) if len(last_30s_idx) > 0 else np.mean(np.abs(errors))\n        self.metrics = {"rise_time": round(rise_time, 2), "overshoot": round(overshoot, 4), "settling_time": round(settling_time, 2), "steady_state_error": round(steady_state_error, 4), "max_temp": round(max_temp, 2)}\n        print(f"Rise time: {self.metrics[\'rise_time\']:.2f}s")\n        print(f"Overshoot: {self.metrics[\'overshoot\']*100:.2f}%")\n        print(f"Settling time: {self.metrics[\'settling_time\']:.2f}s")\n        print(f"Steady-state error: {self.metrics[\'steady_state_error\']:.4f}C")\n        print(f"Max temp: {self.metrics[\'max_temp\']:.2f}C")\n        with open("metrics.json", "w") as f:\n            json.dump(self.metrics, f, indent=2)\n        print("Saved metrics.json")\n\nif __name__ == "__main__":\n    controller = TemperatureController()\n    controller.run_calibration(heater_power=50.0, duration=35.0)\n    controller.estimate_parameters()\n    controller.tune_controller_gains()\n    controller.run_closed_loop_control(duration=150.0)\n    print("\\n=== ALL PHASES COMPLETE ===")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
