Sending keys: ['cat >> /app/analysis_part4.py << \'EOF\'\n\n# INTENSIVE MARGIN: Total spend per user-category-period\nintensive = purchases_filtered.groupby(\n    [\'Survey ResponseID\', \'Category\', \'Period\']\n).agg(Total_Spend=(\'Total_Spend\', \'sum\')).reset_index()\n\nprint(f"Intensive margin data shape: {intensive.shape}")\nintensive.to_csv(\'/app/output/user_category_period_aggregated_intensive.csv\', index=False)\nprint("Saved: user_category_period_aggregated_intensive.csv")\n\n# EXTENSIVE MARGIN: Create panel with all user-category-period combinations\nall_users = survey_fe[\'Survey ResponseID\'].unique()\nperiods = [\'Baseline\', \'Treatment\']\n\n# Create full panel\npanel_rows = []\nfor user in all_users:\n    for cat in selected_cats:\n        for period in periods:\n            panel_rows.append({\'Survey ResponseID\': user, \'Category\': cat, \'Period\': period})\n\npanel = pd.DataFrame(panel_rows)\nprint(f"Full panel size: {len(panel)}")\n\n# Merge with actual purchases to get Has_Purchase indicator\npurchase_indicator = purchases_filtered.groupby(\n    [\'Survey ResponseID\', \'Category\', \'Period\']\n).size().reset_index(name=\'purchase_count\')\n\nextensive = panel.merge(purchase_indicator, on=[\'Survey ResponseID\', \'Category\', \'Period\'], how=\'left\')\nextensive[\'Has_Purchase\'] = (extensive[\'purchase_count\'].fillna(0) > 0).astype(int)\nextensive = extensive[[\'Survey ResponseID\', \'Category\', \'Period\', \'Has_Purchase\']]\n\nprint(f"Extensive margin data shape: {extensive.shape}")\nextensive.to_csv(\'/app/output/user_category_period_aggregated_extensive.csv\', index=False)\nprint("Saved: user_category_period_aggregated_extensive.csv")\n\n# Save for next step\nintensive.to_pickle(\'/app/output/intensive.pkl\')\nextensive.to_pickle(\'/app/output/extensive.pkl\')\nprint("Data preparation complete!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
