Sending keys: ['python3 << \'EOF\'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\nimport statistics\n\nwb = openpyxl.load_workbook(\'/root/gdp.xlsx\')\ndata_sheet = wb[\'Data\']\ntask_sheet = wb[\'Task\']\n\ndef get_data_value(series_code, year):\n    """Simulate INDEX/MATCH: find value in Data sheet"""\n    for row in range(1, 100):\n        if data_sheet.cell(row, 2).value == series_code:\n            for col in range(1, 20):\n                if data_sheet.cell(4, col).value == year:\n                    return data_sheet.cell(row, col).value\n    return None\n\nprint("=== Calculating Weighted Mean ===")\n\nyears = [2019, 2020, 2021, 2022, 2023]\n\n# First, collect all data\nexports_data = {}\nimports_data = {}\ngdp_data = {}\n\n# Populate Exports data (rows 12-17)\nfor row in range(12, 18):\n    series_code = task_sheet.cell(row, 4).value\n    exports_data[row] = {}\n    for col_idx, col in enumerate(range(8, 13)):\n        year = years[col_idx]\n        value = get_data_value(series_code, year)\n        exports_data[row][col] = value\n\n# Populate Imports data (rows 19-24)\nfor row in range(19, 25):\n    series_code = task_sheet.cell(row, 4).value\n    imports_data[row] = {}\n    for col_idx, col in enumerate(range(8, 13)):\n        year = years[col_idx]\n        value = get_data_value(series_code, year)\n        imports_data[row][col] = value\n\n# Populate GDP data (rows 26-31)\nfor row in range(26, 32):\n    series_code = task_sheet.cell(row, 4).value\n    gdp_data[row] = {}\n    for col_idx, col in enumerate(range(8, 13)):\n        year = years[col_idx]\n        value = get_data_value(series_code, year)\n        gdp_data[row][col] = value\n\n# Calculate Net Exports % of GDP\nnet_exports_pct = {}\nfor row in range(35, 41):\n    exports_row = row - 23  # 35->12, 36->13, etc.\n    imports_row = row - 16  # 35->19, 36->20, etc.\n    gdp_row = row - 9       # 35->26, 36->27, etc.\n    net_exports_pct[row] = {}\n    \n    for col in range(8, 13):\n        exp = exports_data[exports_row][col]\n        imp = imports_data[imports_row][col]\n        gdp = gdp_data[gdp_row][col]\n        \n        if exp is not None and imp is not None and gdp is not None:\n            net_exp_pct = (exp - imp) / gdp * 100\n            net_exports_pct[row][col] = net_exp_pct\n\n# Calculate weighted mean for each year\nprint("\\nWeighted Mean Calculations:")\nfor col in range(8, 13):\n    col_letter = get_column_letter(col)\n    year = years[col - 8]\n    \n    # Weighted mean = SUMPRODUCT(net_exports_pct, gdp) / SUM(gdp)\n    numerator = 0\n    denominator = 0\n    \n    for net_row in range(35, 41):\n        gdp_row = net_row - 9\n        net_pct = net_exports_pct[net_row][col]\n        gdp_val = gdp_data[gdp_row][col]\n        \n        numerator += net_pct * gdp_val\n        denominator += gdp_val\n    \n    weighted_mean = numerator / denominator\n    print(f"  {col_letter}50 (Year {year}): {weighted_mean:.6f}")\n    print(f"    Numerator (SUMPRODUCT): {numerator:.6f}")\n    print(f"    Denominator (SUM GDP): {denominator:.6f}")\n\nwb.close()\nprint("\\nWeighted mean calculations complete!")\nEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
