ath = params.get("output", null);\n        System.out.println("task_input  " + taskInput);\n        System.out.println("job_input  " + jobInput);\n        final int sesssize = params.getInt("sesssize", 600);\n\n        // set up streaming execution environment\n        StreamExecutionEnvironment env = StreamExecutionEnvironment.getExecutionEnvironment();\n\n        DataStream<TaskEvent> taskEventsStream = env.addSource(AppBase.taskSourceOrTest(new TaskEventSource(taskInput)))\n                .setParallelism(1);\n\n        WatermarkStrategy<TaskEvent> wm = WatermarkStrategy\n                .<TaskEvent>forBoundedOutOfOrderness(Duration.ofMinutes(1))\n                .withTimestampAssigner((event, ts) -> event.timestamp / 1000L);\n\n        DataStream<TaskEvent> submitEvents = taskEventsStream\n                .filter(e -> e.eventType == 0)\n                .assignTimestampsAndWatermarks(wm);\n\n        DataStream<Tuple2<Long, Long>> sessionCounts = submitEvents\n                .keyBy(TaskEvent::getJobId)\n                .window(EventTimeSessionWindows.withGap(Time.seconds(sesssize)))\n                .aggregate(new CountAgg(), new SessionWindowResult());\n\n        DataStream<Tuple2<Long, Long>> maxPerJob = sessionCounts\n                .keyBy(t -> t.f0)\n                .process(new MaxPerJobProcess());\n\n        DataStream<Tuple2<Long, Long>> finalResults = maxPerJob;\n\n        if (jobInput != null && !jobInput.isEmpty()) {\n            DataStream<JobEvent> jobEventsStream = env.addSource(AppBase.jobSourceOrTest(new JobEventSource(jobInput)))\n                    .setParallelism(1);\n            DataStream<Long> finishedJobs = jobEventsStream\n                    .filter(JobEvent::isTerminal)\n                    .map(JobEvent::getJobId);\n\n            MapStateDescriptor<Long, Boolean> finishedDesc =\n                    new MapStateDescriptor<>("finishedJobs", Types.LONG, Types.BOOLEAN);\n            BroadcastStream<Long> finishedBroadcast = finishedJobs.broadcast(finishedDesc);\n\n            finalResults = maxPerJob\n                    .connect(finishedBroadcast)\n                    .process(new FinishedFilterProcess(finishedDesc));\n        }\n\n        DataStream<String> output = finalResults\n                .map(t -> "(" + t.f0 + "," + t.f1 + ")");\n\n        if (AppBase.out != null) {\n            output.addSink((SinkFunction<String>) AppBase.out);\n        } else {\n            output.writeAsText(outputPath).setParallelism(1);\n        }\n\n        env.execute("LongestSessionPerJob");\n    }\n\n    public static class CountAgg implements AggregateFunction<TaskEvent, Long, Long> {\n        public Long createAccumulator() { return 0L; }\n        public Long add(TaskEvent value, Long acc) { return acc + 1; }\n        public Long getResult(Long acc) { return acc; }\n        public Long merge(Long a, Long b) { return a + b; }\n    }\n\n    public static class SessionWindowResult extends ProcessWindowFunction<Long, Tuple2<Long, Long>, Long, TimeWindow> {\n        @Override\n        public void process(Long key, Context ctx, Iterable<Long> elements, Collector<Tuple2<Long, Long>> out) {\n            long count = elements.iterator().next();\n            out.collect(Tuple2.of(key, count));\n        }\n    }\n\n    public static class MaxPerJobProcess extends KeyedProcessFunction<Long, Tuple2<Long, Long>, Tuple2<Long, Long>> {\n        private transient ValueState<Long> maxState;\n        private transient ValueState<Boolean> timerSet;\n\n        @Override\n        public void open(org.apache.flink.configuration.Configuration parameters) {\n            maxState = getRuntimeContext().getState(new ValueStateDescriptor<>("maxCount", Long.class));\n            timerSet = getRuntimeContext().getState(new ValueStateDescriptor<>("timerSet", Boolean.class));\n        }\n\n        @Override\n        public void processElement(Tuple2<Long, Long> value, Context ctx, Collector<Tuple2<Long, Long>> out) throws Exception {\n            Long current = maxState.value();\n            if (current == null || value.f1 > current) {\n                maxState.update(value.f1);\n            }\n            Boolean set = timerSet.value();\n            if (set == null || !set) {\n                ctx.timerService().registerEventTimeTimer(Long.MAX_VALUE);\n                timerSet.update(true);\n            }\n        }\n\n        @Override\n        public void onTimer(long timestamp, OnTimerContext ctx, Collector<Tuple2<Long, Long>> out) throws Exception {\n            Long max = maxState.value();\n            if (max != null) {\n                out.collect(Tuple2.of(ctx.getCurrentKey(), max));\n            }\n        }\n    }\n\n    public static class FinishedFilterProcess extends BroadcastProcessFunction<Tuple2<Long, Long>, Long, Tuple2<Long, Long>> {\n        private final MapStateDescriptor<Long, Boolean> desc;\n        public FinishedFilterProcess(MapStateDescriptor<Long, Boolean> desc) { this.desc = desc; }\n\n        @Override\n        public void processElement(Tuple2<Long, Long> value, ReadOnlyContext ctx, Collector<Tuple2<Long, Long>> out) throws Exception {\n            if (ctx.getBroadcastState(desc).get(value.f0) != null) {\n                out.collect(value);\n            }\n        }\n\n        @Override\n        public void processBroadcastElement(Long value, Context ctx, Collector<Tuple2<Long, Long>> out) throws Exception {\n            ctx.getBroadcastState(desc).put(value, true);\n        }\n    }\n\n    public static class TaskEventSource implements org.apache.flink.streaming.api.functions.source.SourceFunction<TaskEvent> {\n        private final String path;\n        private volatile boolean running = true;\n\n        public TaskEventSource(String path) { this.path = path; }\n\n        @Override\n        public void run(SourceContext<TaskEvent> ctx) throws Exception {\n            InputStream in = new FileInputStream(path);\n            if (path.endsWith(".gz")) {\n                in = new GZIPInputStream(in);\n            }\n            BufferedReader br = new BufferedReader(new InputStreamReader(in));\n            String line;\n            while (running && (line = br.readLine()) != null) {\n                if (line.trim().isEmpty()) continue;\n                ctx.collect(TaskEvent.fromString(line));\n            }\n            br.close();\n        }\n\n        @Override\n        public void cancel() { running = false; }\n    }\n\n    public static class JobEventSource implements org.apache.flink.streaming.api.functions.source.SourceFunction<JobEvent> {\n        private final String path;\n        private volatile boolean running = true;\n\n        public JobEventSource(String path) { this.path = path; }\n\n        @Override\n        public void run(SourceContext<JobEvent> ctx) throws Exception {\n            InputStream in = new FileInputStream(path);\n            if (path.endsWith(".gz")) {\n                in = new GZIPInputStream(in);\n            }\n            BufferedReader br = new BufferedReader(new InputStreamReader(in));\n            String line;\n            while (running && (line = br.readLine()) != null) {\n                if (line.trim().isEmpty()) continue;\n                ctx.collect(JobEvent.fromString(line));\n            }\n            br.close();\n        }\n\n        @Override\n        public void cancel() { running = false; }\n    }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
