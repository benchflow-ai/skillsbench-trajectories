Sending keys: ['cat > /app/solve.py << \'EOF\'\nimport json\nimport csv\nfrom itertools import product\n\ndef parse_instance(filename):\n    with open(filename, \'r\') as f:\n        lines = [l.strip() for l in f.readlines() if l.strip()]\n    first_line = lines[0].split()\n    num_jobs = int(first_line[0])\n    num_machines = int(first_line[1])\n    jobs = []\n    i = 1\n    for _ in range(num_jobs):\n        num_ops = int(lines[i])\n        i += 1\n        ops = []\n        for _ in range(num_ops):\n            parts = list(map(int, lines[i].split()))\n            i += 1\n            num_alts = parts[0]\n            alternatives = []\n            idx = 1\n            for _ in range(num_alts):\n                alternatives.append((parts[idx], parts[idx + 1]))\n                idx += 2\n            ops.append(alternatives)\n        jobs.append(ops)\n    return jobs, num_machines\n\ndef parse_downtime(filename):\n    downtime = {}\n    with open(filename, \'r\') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            m = int(row[\'machine\'])\n            if m not in downtime:\n                downtime[m] = []\n            downtime[m].append((int(row[\'start\']), int(row[\'end\'])))\n    return downtime\n\ndef overlaps_downtime(machine, start, end, downtime):\n    if machine not in downtime:\n        return False\n    for ds, de in downtime[machine]:\n        if start < de and end > ds:\n            return True\n    return False\n\ndef get_available_start(machine, earliest, duration, downtime):\n    start = earliest\n    if machine not in downtime:\n        return start\n    for _ in range(100):\n        end = start + duration\n        conflict = False\n        for ds, de in sorted(downtime[machine]):\n            if start < de and end > ds:\n                start = de\n                conflict = True\n                break\n        if not conflict:\n            return start\n    return start\n\njobs, num_machines = parse_instance(\'/app/data/instance.txt\')\ndowntime = parse_downtime(\'/app/data/downtime.csv\')\n\nwith open(\'/app/data/policy.json\') as f:\n    policy = json.load(f)\nwith open(\'/app/data/baseline_solution.json\') as f:\n    baseline = json.load(f)\n\nbaseline_ops = {(op[\'job\'], op[\'op\']): op for op in baseline[\'schedule\']}\nfreeze_until = policy[\'freeze\'][\'freeze_until\']\nmax_changes = policy[\'change_budget\'][\'max_machine_changes\']\nmax_shift = policy[\'change_budget\'][\'max_total_start_shift_L1\']\nmax_makespan = baseline[\'makespan\'] * policy[\'guards\'][\'max_makespan_ratio\']\n\ndef schedule_with_choices(choices):\n    machine_available = [0] * num_machines\n    schedule = []\n    all_ops = [(j, o) for j in range(len(jobs)) for o in range(len(jobs[j]))]\n    scheduled = set()\n    \n    while len(scheduled) < len(all_ops):\n        best = None\n        best_start = float(\'inf\')\n        \n        for j, o in all_ops:\n            if (j, o) in scheduled or (o > 0 and (j, o-1) not in scheduled):\n                continue\n            \n            machine, duration = choices[(j, o)]\n            prev_end = next((s[\'end\'] for s in schedule if s[\'job\'] == j and s[\'op\'] == o-1), 0) if o > 0 else 0\n            earliest = max(machine_available[machine], prev_end)\n            start = get_available_start(machine, earliest, duration, downtime)\n            \n            if start < best_start:\n                best = (j, o, machine, duration, start)\n                best_start = start\n        \n        if best is None:\n            return None\n        \n        j, o, machine, duration, start = best\n        schedule.append({\'job\': j, \'op\': o, \'machine\': machine, \'start\': start, \'end\': start + duration, \'dur\': duration})\n        machine_available[machine] = start + duration\n        scheduled.add((j, o))\n    \n    return schedule\n\ndef evaluate(schedule):\n    makespan = max(op[\'end\'] for op in schedule)\n    changes = sum(1 for op in schedule if op[\'machine\'] != baseline_ops[(op[\'job\'], op[\'op\'])][\'machine\'])\n    shift = sum(abs(op[\'start\'] - baseline_ops[(op[\'job\'], op[\'op\'])][\'start\']) for op in schedule)\n    violations = sum(1 for op in schedule if overlaps_downtime(op[\'machine\'], op[\'start\'], op[\'end\'], downtime))\n    return makespan, changes, shift, violations\n\n# Build all choices - for each op, list all valid alternatives\nall_keys = [(j, o) for j in range(len(jobs)) for o in range(len(jobs[j]))]\n\n# For each operation, determine valid alternatives\nvalid_alts = {}\nfor key in all_keys:\n    j, o = key\n    baseline_op = baseline_ops[key]\n    is_frozen = baseline_op[\'start\'] < freeze_until\n    has_violation = overlaps_downtime(baseline_op[\'machine\'], baseline_op[\'start\'], baseline_op[\'end\'], downtime)\n    \n    if is_frozen and has_violation:\n        # Must change machine\n        valid_alts[key] = [(m, d) for m, d in jobs[j][o] if m != baseline_op[\'machine\']]\n    elif is_frozen:\n        # Must keep machine (frozen without violation)\n        valid_alts[key] = [(m, d) for m, d in jobs[j][o] if m == baseline_op[\'machine\']]\n    else:\n        # Can use any alternative\n        valid_alts[key] = jobs[j][o]\n\nprint("Valid alternatives:")\nfor key in sorted(valid_alts.keys()):\n    baseline_m = baseline_ops[key][\'machine\']\n    print(f"  {key}: baseline M{baseline_m}, valid: {valid_alts[key]}")\n\n# Try all combinations (brute force for small problem)\nbest_schedule = None\nbest_score = (float(\'inf\'), float(\'inf\'), float(\'inf\'))\n\n# Generate all possible choice combinations\nalt_lists = [[(key, alt) for alt in valid_alts[key]] for key in all_keys]\n\nprint(f"\\nTotal combinations: {sum(1 for _ in product(*alt_lists))}")\n\nfor combo in product(*alt_lists):\n    choices = {key: alt for key, alt in combo}\n    \n    # Count changes\n    changes = sum(1 for key, (m, d) in choices.items() if m != baseline_ops[key][\'machine\'])\n    if changes > max_changes:\n        continue\n    \n    schedule = schedule_with_choices(choices)\n    if schedule:\n        makespan, changes, shift, violations = evaluate(schedule)\n        \n        if violations == 0 and changes <= max_changes and shift <= max_shift and makespan <= max_makespan:\n            if makespan < best_score[0] or (makespan == best_score[0] and (changes, shift) < (best_score[1], best_score[2])):\n                best_score = (makespan, changes, shift)\n                best_schedule = schedule\n                print(f"Found: makespan={makespan}, changes={changes}, shift={shift}")\n\nif best_schedule:\n    schedule = best_schedule\n    makespan, changes, shift, violations = evaluate(schedule)\n    \n    print(f"\\nBest: makespan={makespan}, changes={changes}, shift={shift}")\n    \n    schedule.sort(key=lambda x: (x[\'start\'], x[\'job\'], x[\'op\']))\n    \n    for op in schedule:\n        baseline_op = baseline_ops[(op[\'job\'], op[\'op\'])]\n        changed = "*" if op[\'machine\'] != baseline_op[\'machine\'] else " "\n        print(f"  {changed} Job {op[\'job\']} Op {op[\'op\']}: M{op[\'machine\']} [{op[\'start\']}-{op[\'end\']}]")\n    \n    solution = {"status": "FEASIBLE", "makespan": makespan, "schedule": schedule}\n    \n    with open(\'/app/output/solution.json\', \'w\') as f:\n        json.dump(solution, f, indent=2)\n    \n    with open(\'/app/output/schedule.csv\', \'w\') as f:\n        f.write(\'job,op,machine,start,end,dur\\n\')\n        for op in schedule:\n            f.write(f"{op[\'job\']},{op[\'op\']},{op[\'machine\']},{op[\'start\']},{op[\'end\']},{op[\'dur\']}\\n")\n    \n    print("\\nSaved!")\nelse:\n    print("No feasible solution!")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
