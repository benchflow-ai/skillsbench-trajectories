Sending keys: ['cat << \'EOF\' > /root/workspace/parallel_solution.py\nimport math\nimport time\nimport multiprocessing\nfrom collections import defaultdict, Counter\nfrom dataclasses import dataclass, field\nfrom typing import List, Tuple, Dict, Set\nfrom sequential import (\n    Document, \n    TFIDFIndex, \n    SearchResult, \n    tokenize, \n    compute_term_frequencies\n)\nfrom heapq import nlargest\n\n@dataclass\nclass ParallelIndexingResult:\n    index: TFIDFIndex\n    elapsed_time: float\n    num_documents: int\n    vocabulary_size: int\n\ndef process_docs_chunk(docs_chunk):\n    results = []\n    local_df = Counter()\n    for doc in docs_chunk:\n        text = doc.title + " " + doc.content\n        tokens = tokenize(text)\n        tf = compute_term_frequencies(tokens)\n        results.append((doc.doc_id, tf))\n        for term in tf:\n            local_df[term] += 1\n    return results, local_df\n\ndef build_tfidf_index_parallel(documents, num_workers=None, chunk_size=500):\n    start_time = time.perf_counter()\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n\n    index = TFIDFIndex()\n    index.num_documents = len(documents)\n\n    chunks = [documents[i:i + chunk_size] for i in range(0, len(documents), chunk_size)]\n    \n    with multiprocessing.Pool(processes=num_workers) as pool:\n        chunk_results = pool.map(process_docs_chunk, chunks)\n\n    doc_term_freqs = {}\n    total_df = Counter()\n    for results, local_df in chunk_results:\n        for doc_id, tf in results:\n            doc_term_freqs[doc_id] = tf\n        total_df.update(local_df)\n\n    index.vocabulary = set(total_df.keys())\n    index.document_frequencies = dict(total_df)\n\n    N = index.num_documents\n    for term, df in index.document_frequencies.items():\n        index.idf[term] = math.log(N / df) + 1\n\n    inverted_index = defaultdict(list)\n    for doc_id, tf_dict in doc_term_freqs.items():\n        doc_vector = {}\n        norm_squared = 0.0\n        for term, tf in tf_dict.items():\n            tfidf = tf * index.idf[term]\n            doc_vector[term] = tfidf\n            norm_squared += tfidf * tfidf\n            inverted_index[term].append((doc_id, tfidf))\n        index.doc_vectors[doc_id] = doc_vector\n        index.doc_norms[doc_id] = math.sqrt(norm_squared)\n\n    for term in inverted_index:\n        inverted_index[term].sort(key=lambda x: x[1], reverse=True)\n    \n    index.inverted_index = dict(inverted_index)\n\n    elapsed = time.perf_counter() - start_time\n    return ParallelIndexingResult(\n        index=index, \n        elapsed_time=elapsed, \n        num_documents=len(documents), \n        vocabulary_size=len(index.vocabulary)\n    )\n\n# Global variables for workers\n_worker_index_idf = None\n_worker_index_inverted_index = None\n_worker_index_doc_vectors = None\n_worker_index_doc_norms = None\n_worker_doc_titles = None\n\ndef init_search_worker(idf, inverted_index, doc_vectors, doc_norms, doc_titles):\n    global _worker_index_idf, _worker_index_inverted_index, _worker_index_doc_vectors, _worker_index_doc_norms, _worker_doc_titles\n    _worker_index_idf = idf\n    _worker_index_inverted_index = inverted_index\n    _worker_index_doc_vectors = doc_vectors\n    _worker_index_doc_norms = doc_norms\n    _worker_doc_titles = doc_titles\n\ndef search_worker_optimized(args):\n    query, top_k = args\n    query_tokens = tokenize(query)\n    if not query_tokens:\n        return []\n\n    query_tf = compute_term_frequencies(query_tokens)\n    query_vector = {}\n    query_norm_squared = 0.0\n    for term, tf in query_tf.items():\n        if term in _worker_index_idf:\n            tfidf = tf * _worker_index_idf[term]\n            query_vector[term] = tfidf\n            query_norm_squared += tfidf * tfidf\n\n    if not query_vector:\n        return []\n\n    query_norm = math.sqrt(query_norm_squared)\n    candidate_docs = set()\n    for term in query_vector:\n        if term in _worker_index_inverted_index:\n            for doc_id, _ in _worker_index_inverted_index[term]:\n                candidate_docs.add(doc_id)\n\n    scores = []\n    for doc_id in candidate_docs:\n        doc_vector = _worker_index_doc_vectors.get(doc_id, {})\n        doc_norm = _worker_index_doc_norms.get(doc_id, 0)\n        if doc_norm == 0:\n            continue\n        dot_product = sum(query_vector.get(term, 0) * doc_vector.get(term, 0) for term in query_vector)\n        similarity = dot_product / (query_norm * doc_norm)\n        scores.append((doc_id, similarity))\n\n    top_results = nlargest(top_k, scores, key=lambda x: x[1])\n    results = []\n    for doc_id, score in top_results:\n        results.append(SearchResult(doc_id=doc_id, score=score, title=_worker_doc_titles.get(doc_id, f"Document {doc_id}")))\n    return results\n\ndef batch_search_parallel(queries, index, top_k=10, num_workers=None, documents=None):\n    start_time = time.perf_counter()\n    if num_workers is None:\n        num_workers = multiprocessing.cpu_count()\n    \n    doc_titles = {d.doc_id: d.title for d in documents} if documents else {}\n    \n    # Use initializer to set up workers once\n    with multiprocessing.Pool(\n        processes=num_workers, \n        initializer=init_search_worker, \n        initargs=(index.idf, index.inverted_index, index.doc_vectors, index.doc_norms, doc_titles)\n    ) as pool:\n        worker_args = [(query, top_k) for query in queries]\n        results = pool.map(search_worker_optimized, worker_args)\n        \n    elapsed_time = time.perf_counter() - start_time\n    return results, elapsed_time\nEOF\npython3 /root/workspace/test_solution.py\n'] min_timeout_sec: 15.0 max_timeout_sec: 180.0
