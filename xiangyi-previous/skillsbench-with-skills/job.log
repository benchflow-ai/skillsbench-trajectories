Sending keys: ['cat > /root/count_objects.py << \'EOF\'\nimport cv2\nimport numpy as np\nimport csv\nimport glob\n\n# Get all keyframe files sorted\nkeyframe_files = sorted(glob.glob(\'/root/keyframes_*.png\'))\n\n# Step 3: Convert keyframes to grayscale in place\nprint("Converting keyframes to grayscale...")\nfor kf in keyframe_files:\n    img = cv2.imread(kf)\n    gray = cv2.cvtColor(img, cv2.COLOR_BGR2GRAY)\n    cv2.imwrite(kf, gray)\n    print(f"Converted {kf} to grayscale")\n\n# Load template images and convert to grayscale\nprint("\\nLoading template images...")\ncoin_template = cv2.imread(\'/root/coin.png\', cv2.IMREAD_GRAYSCALE)\nenemy_template = cv2.imread(\'/root/enemy.png\', cv2.IMREAD_GRAYSCALE)\nturtle_template = cv2.imread(\'/root/turtle.png\', cv2.IMREAD_GRAYSCALE)\n\nprint(f"Coin template size: {coin_template.shape}")\nprint(f"Enemy template size: {enemy_template.shape}")\nprint(f"Turtle template size: {turtle_template.shape}")\n\ndef count_matches(frame, template, threshold=0.8):\n    """Count non-overlapping template matches in frame"""\n    if template is None or frame is None:\n        return 0\n    \n    # Ensure frame is larger than template\n    if frame.shape[0] < template.shape[0] or frame.shape[1] < template.shape[1]:\n        return 0\n    \n    result = cv2.matchTemplate(frame, template, cv2.TM_CCOEFF_NORMED)\n    locations = np.where(result >= threshold)\n    \n    # Get template dimensions\n    h, w = template.shape[:2]\n    \n    # Use non-maximum suppression to avoid counting overlapping matches\n    matches = list(zip(*locations[::-1]))  # (x, y) format\n    \n    if len(matches) == 0:\n        return 0\n    \n    # Simple non-maximum suppression\n    filtered_matches = []\n    for pt in matches:\n        overlap = False\n        for existing in filtered_matches:\n            if abs(pt[0] - existing[0]) < w * 0.5 and abs(pt[1] - existing[1]) < h * 0.5:\n                overlap = True\n                break\n        if not overlap:\n            filtered_matches.append(pt)\n    \n    return len(filtered_matches)\n\n# Process each keyframe and count objects\nresults = []\nprint("\\nCounting objects in each frame...")\n\nfor kf in keyframe_files:\n    frame = cv2.imread(kf, cv2.IMREAD_GRAYSCALE)\n    \n    # Count objects with different thresholds if needed\n    coins = count_matches(frame, coin_template, threshold=0.8)\n    enemies = count_matches(frame, enemy_template, threshold=0.8)\n    turtles = count_matches(frame, turtle_template, threshold=0.8)\n    \n    print(f"{kf}: coins={coins}, enemies={enemies}, turtles={turtles}")\n    results.append({\n        \'frame_id\': kf,\n        \'coins\': coins,\n        \'enemies\': enemies,\n        \'turtles\': turtles\n    })\n\n# Write results to CSV\nprint("\\nWriting results to CSV...")\nwith open(\'/root/counting_results.csv\', \'w\', newline=\'\') as csvfile:\n    fieldnames = [\'frame_id\', \'coins\', \'enemies\', \'turtles\']\n    writer = csv.DictWriter(csvfile, fieldnames=fieldnames)\n    writer.writeheader()\n    for row in results:\n        writer.writerow(row)\n\nprint("Done! Results saved to /root/counting_results.csv")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
