Sending keys: ['python3 - <<\'PY\'\nimport pandas as pd, numpy as np, re\nfrom statsmodels.tsa.filters.hp_filter import hpfilter\n\n# Load CPI\ncpi = pd.read_excel(\'/root/CPI.xlsx\')\ncpi = cpi.set_index(\'Year\')[\'CPI_2024\']\n\n# Function to extract annual series and 2024 average from quarterly data\n\ndef extract_series(fname, sheet):\n    df = pd.read_excel(fname, sheet_name=sheet, header=None)\n    # annual rows: label like \'1973.\'\n    years = {}\n    for idx, label in df[0].items():\n        if isinstance(label, str):\n            m = re.fullmatch(r\'(\\d{4})\\.?\', label.strip())\n            if m:\n                year = int(m.group(1))\n                years[year] = df.loc[idx, 1]\n    # 2024 quarterly data\n    # find index of row with \'2024:\'\n    idxs = df[df[0].astype(str).str.contains(\'2024:\')].index\n    if len(idxs)==0:\n        raise ValueError(\'2024 quarterly not found\')\n    idx0 = idxs[0]\n    vals = [df.loc[idx0,1]]\n    # collect subsequent quarter rows\n    for j in range(idx0+1, len(df)):\n        lbl = str(df.loc[j,0]).strip()\n        if re.fullmatch(r\'(II|III|IV|I)( p\\.)?\\.\', lbl) or lbl in [\'II.\',\'III.\',\'IV.\',\'III p.\',\'IV p.\',\'II p.\',\'I p.\']:\n            vals.append(df.loc[j,1])\n        else:\n            break\n    years[2024] = float(np.mean(vals))\n    return pd.Series(years).sort_index()\n\npce_nom = extract_series(\'/root/ERP-2025-table10.xls\',\'B10\')\npfi_nom = extract_series(\'/root/ERP-2025-table12.xls\',\'B12\')\n\n# align years 1973-2024\nyears = range(1973, 2025)\n\npce_nom = pce_nom.reindex(years)\npfi_nom = pfi_nom.reindex(years)\n\n# deflate to real using CPI (2024 base)\nreal_pce = pce_nom / cpi\nreal_pfi = pfi_nom / cpi\n\n# log transform\nlog_pce = np.log(real_pce)\nlog_pfi = np.log(real_pfi)\n\n# HP filter\ncycle_pce, trend_pce = hpfilter(log_pce, lamb=100)\ncycle_pfi, trend_pfi = hpfilter(log_pfi, lamb=100)\n\ncorr = np.corrcoef(cycle_pce, cycle_pfi)[0,1]\n\n# round to 5 decimals and write\nout = f"{corr:.5f}"\nprint(\'Correlation:\', out)\nwith open(\'/root/answer.txt\',\'w\') as f:\n    f.write(out)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
