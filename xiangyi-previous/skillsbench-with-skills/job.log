Sending keys: ['cat << \'EOF\' > generate_report.py\nimport urllib.request\nimport urllib.parse\nimport json\nimport datetime\nimport sys\nimport time\n\ndef get_json(url):\n    req = urllib.request.Request(url)\n    req.add_header(\'User-Agent\', \'python-script\')\n    try:\n        with urllib.request.urlopen(req) as response:\n            return json.loads(response.read())\n    except Exception as e:\n        print(f"Error fetching {url}: {e}", file=sys.stderr)\n        return None\n\ndef search_github(query):\n    items = []\n    page = 1\n    while True:\n        time.sleep(2)  # Rate limit niceness\n        params = {\'q\': query, \'per_page\': 100, \'page\': page}\n        query_string = urllib.parse.urlencode(params)\n        url = f"https://api.github.com/search/issues?{query_string}"\n        print(f"Fetching page {page} for query: {query}")\n        data = get_json(url)\n        if not data:\n            break\n        page_items = data.get(\'items\', [])\n        items.extend(page_items)\n        if len(items) >= data.get(\'total_count\', 0) or len(page_items) == 0:\n            break\n        page += 1\n    return items\n\ndef is_bug(issue):\n    labels = issue.get(\'labels\', [])\n    for l in labels:\n        if \'bug\' in l[\'name\'].lower():\n            return True\n    return False\n\ndef parse_time(t_str):\n    return datetime.datetime.strptime(t_str, "%Y-%m-%dT%H:%M:%SZ")\n\ndef main():\n    # 1. PRs created in Dec\n    print("Fetching PRs...")\n    prs = search_github("repo:cli/cli is:pr created:2024-12-01..2024-12-31")\n    \n    pr_total = len(prs)\n    pr_merged = 0\n    pr_closed = 0\n    merge_times = []\n    authors = {}\n\n    for pr in prs:\n        user = pr.get(\'user\', {}).get(\'login\')\n        if user:\n            authors[user] = authors.get(user, 0) + 1\n            \n        pr_details = pr.get(\'pull_request\', {})\n        merged_at_str = pr_details.get(\'merged_at\')\n        \n        if merged_at_str:\n            pr_merged += 1\n            created_at = parse_time(pr[\'created_at\'])\n            merged_at = parse_time(merged_at_str)\n            delta = merged_at - created_at\n            merge_times.append(delta.total_seconds() / 86400.0)\n        elif pr[\'state\'] == \'closed\':\n            pr_closed += 1\n\n    avg_merge_days = 0.0\n    if merge_times:\n        avg_merge_days = sum(merge_times) / len(merge_times)\n    \n    top_contributor = ""\n    if authors:\n        top_contributor = max(authors, key=authors.get)\n\n    # 2. Issues created in Dec\n    print("Fetching Created Issues...")\n    issues_created = search_github("repo:cli/cli is:issue created:2024-12-01..2024-12-31")\n    issue_total = len(issues_created)\n    issue_bug_created = sum(1 for i in issues_created if is_bug(i))\n\n    # 3. Issues closed in Dec\n    print("Fetching Closed Issues...")\n    issues_closed = search_github("repo:cli/cli is:issue closed:2024-12-01..2024-12-31")\n    issue_bug_closed = sum(1 for i in issues_closed if is_bug(i))\n\n    report = {\n        "pr": {\n            "total": pr_total,\n            "merged": pr_merged,\n            "closed": pr_closed,\n            "avg_merge_days": round(avg_merge_days, 1),\n            "top_contributor": top_contributor\n        },\n        "issue": {\n            "total": issue_total,\n            "bug": issue_bug_created,\n            "resolved_bugs": issue_bug_closed\n        }\n    }\n\n    print("Writing report...")\n    with open(\'/app/report.json\', \'w\') as f:\n        json.dump(report, f, indent=2)\n    print("Done.")\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
