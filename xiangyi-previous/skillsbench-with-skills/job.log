Sending keys: ["cat > /root/export_meshes.js << 'EOF'\nimport * as THREE from 'three';\nimport { createScene } from './data/object.js';\nimport * as fs from 'fs';\nimport * as path from 'path';\n\n// Function to convert a BufferGeometry to OBJ format\nfunction geometryToOBJ(geometry, mesh, vertexOffset = 0) {\n    let obj = '';\n    \n    // Apply mesh transformations to get world coordinates\n    const positionAttribute = geometry.getAttribute('position');\n    const normalAttribute = geometry.getAttribute('normal');\n    \n    // Get world matrix from mesh\n    mesh.updateMatrixWorld(true);\n    const worldMatrix = mesh.matrixWorld;\n    const normalMatrix = new THREE.Matrix3().getNormalMatrix(worldMatrix);\n    \n    // Write vertices\n    const vertex = new THREE.Vector3();\n    for (let i = 0; i < positionAttribute.count; i++) {\n        vertex.set(\n            positionAttribute.getX(i),\n            positionAttribute.getY(i),\n            positionAttribute.getZ(i)\n        );\n        vertex.applyMatrix4(worldMatrix);\n        obj += `v ${vertex.x} ${vertex.y} ${vertex.z}\\n`;\n    }\n    \n    // Write normals if available\n    if (normalAttribute) {\n        const normal = new THREE.Vector3();\n        for (let i = 0; i < normalAttribute.count; i++) {\n            normal.set(\n                normalAttribute.getX(i),\n                normalAttribute.getY(i),\n                normalAttribute.getZ(i)\n            );\n            normal.applyMatrix3(normalMatrix).normalize();\n            obj += `vn ${normal.x} ${normal.y} ${normal.z}\\n`;\n        }\n    }\n    \n    // Write faces\n    const index = geometry.getIndex();\n    if (index) {\n        for (let i = 0; i < index.count; i += 3) {\n            const a = index.getX(i) + 1 + vertexOffset;\n            const b = index.getX(i + 1) + 1 + vertexOffset;\n            const c = index.getX(i + 2) + 1 + vertexOffset;\n            if (normalAttribute) {\n                obj += `f ${a}//${a} ${b}//${b} ${c}//${c}\\n`;\n            } else {\n                obj += `f ${a} ${b} ${c}\\n`;\n            }\n        }\n    } else {\n        for (let i = 0; i < positionAttribute.count; i += 3) {\n            const a = i + 1 + vertexOffset;\n            const b = i + 2 + vertexOffset;\n            const c = i + 3 + vertexOffset;\n            if (normalAttribute) {\n                obj += `f ${a}//${a} ${b}//${b} ${c}//${c}\\n`;\n            } else {\n                obj += `f ${a} ${b} ${c}\\n`;\n            }\n        }\n    }\n    \n    return { obj, vertexCount: positionAttribute.count };\n}\n\n// Function to export a single mesh to OBJ\nfunction exportMeshToOBJ(mesh) {\n    let geometry = mesh.geometry;\n    if (!geometry) return '';\n    \n    // Ensure geometry is BufferGeometry\n    if (!geometry.isBufferGeometry) {\n        console.warn('Non-BufferGeometry found, skipping');\n        return '';\n    }\n    \n    // Compute normals if not present\n    if (!geometry.getAttribute('normal')) {\n        geometry.computeVertexNormals();\n    }\n    \n    const result = geometryToOBJ(geometry, mesh);\n    return `# Mesh: ${mesh.name}\\n` + result.obj;\n}\n\n// Function to collect all meshes from a group (including nested)\nfunction collectMeshes(object, meshes = []) {\n    if (object.isMesh) {\n        meshes.push(object);\n    }\n    for (const child of object.children) {\n        collectMeshes(child, meshes);\n    }\n    return meshes;\n}\n\n// Function to combine multiple meshes into one OBJ\nfunction combineMeshesToOBJ(meshes) {\n    let obj = '';\n    let vertexOffset = 0;\n    \n    for (const mesh of meshes) {\n        let geometry = mesh.geometry;\n        if (!geometry || !geometry.isBufferGeometry) continue;\n        \n        if (!geometry.getAttribute('normal')) {\n            geometry.computeVertexNormals();\n        }\n        \n        obj += `# Mesh: ${mesh.name}\\n`;\n        const result = geometryToOBJ(geometry, mesh, vertexOffset);\n        obj += result.obj;\n        vertexOffset += result.vertexCount;\n    }\n    \n    return obj;\n}\n\n// Main export function\nasync function exportScene() {\n    const root = createScene();\n    \n    const partMeshesDir = '/root/output/part_meshes';\n    const linksDir = '/root/output/links';\n    \n    // Find all top-level parts (direct children of root that are Groups)\n    const parts = [];\n    \n    for (const child of root.children) {\n        if (child.isGroup) {\n            parts.push(child);\n        }\n    }\n    \n    console.log(`Found ${parts.length} top-level parts`);\n    \n    for (const part of parts) {\n        const partName = part.name || 'unnamed_part';\n        const partDir = path.join(partMeshesDir, partName);\n        \n        // Create part directory\n        fs.mkdirSync(partDir, { recursive: true });\n        \n        // Collect all meshes in this part (direct and nested)\n        const allMeshes = [];\n        \n        // Process direct mesh children and nested groups\n        function processPart(obj, currentPartDir) {\n            for (const child of obj.children) {\n                if (child.isMesh) {\n                    // Export individual mesh\n                    const meshName = child.name || `mesh_${allMeshes.length}`;\n                    const objContent = exportMeshToOBJ(child);\n                    if (objContent) {\n                        const filePath = path.join(currentPartDir, `${meshName}.obj`);\n                        fs.writeFileSync(filePath, objContent);\n                        console.log(`Exported: ${filePath}`);\n                        allMeshes.push(child);\n                    }\n                } else if (child.isGroup) {\n                    // For nested groups (like cabins), create subdirectory\n                    const subGroupName = child.name || 'subgroup';\n                    const subDir = path.join(currentPartDir, subGroupName);\n                    fs.mkdirSync(subDir, { recursive: true });\n                    \n                    // Export meshes in this subgroup\n                    const subMeshes = collectMeshes(child);\n                    for (const subMesh of subMeshes) {\n                        const meshName = subMesh.name || `mesh_${allMeshes.length}`;\n                        const objContent = exportMeshToOBJ(subMesh);\n                        if (objContent) {\n                            const filePath = path.join(subDir, `${meshName}.obj`);\n                            fs.writeFileSync(filePath, objContent);\n                            console.log(`Exported: ${filePath}`);\n                            allMeshes.push(subMesh);\n                        }\n                    }\n                }\n            }\n        }\n        \n        processPart(part, partDir);\n        \n        // Create combined link file for this part\n        if (allMeshes.length > 0) {\n            const linkContent = combineMeshesToOBJ(allMeshes);\n            const linkPath = path.join(linksDir, `${partName}.obj`);\n            fs.writeFileSync(linkPath, linkContent);\n            console.log(`Created link: ${linkPath}`);\n        }\n    }\n    \n    console.log('Export complete!');\n}\n\nexportScene();\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
