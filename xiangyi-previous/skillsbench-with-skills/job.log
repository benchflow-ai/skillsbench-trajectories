Sending keys: ['cat << \'EOF\' > find_robust_period.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt(\'/root/data/tess_lc.txt\')\nmask = (data[:, 2] == 0)\ntime = data[mask, 0]\nflux = data[mask, 1]\nflux_err = data[mask, 3]\nlc = lk.LightCurve(time=time, flux=flux, flux_err=flux_err).remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\n# Try to find a period that shows up consistently\nresults = []\nfor wl_days in [0.7, 0.8, 0.9, 1.0, 1.2]:\n    wl_pts = int(wl_days / cadence) | 1\n    flat = lc.flatten(window_length=wl_pts)\n    pg = flat.to_periodogram(method=\'bls\', minimum_period=0.5, maximum_period=15, frequency_factor=200)\n    results.append(pg)\n    print(f"WL: {wl_days}d, Best: {pg.period_at_max_power.value:.5f}, SNR: {pg.snr.max():.2f}")\n\n# Sum the power of all periodograms to find the most consistent peak\n# (First interpolate to a common frequency grid)\ncommon_periods = results[0].period\ncombined_power = np.zeros_like(results[0].power.value)\nfor pg in results:\n    combined_power += np.interp(common_periods.value, pg.period.value, pg.power.value)\n\nbest_idx = np.argmax(combined_power)\nbest_p = common_periods[best_idx].value\nprint(f"Combined Best Period: {best_p:.5f}")\n\nwith open(\'/root/period.txt\', \'w\') as f:\n    f.write(f"{best_p:.5f}\\n")\nEOF\npython3 find_robust_period.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
