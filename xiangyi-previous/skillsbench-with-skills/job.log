Sending keys: ['python3 << \'EOF\'\nimport cv2\nimport numpy as np\nimport csv\nimport sys\n\ndef count_objects_very_fast(frame_path, template_path, threshold=0.8):\n    """Count objects using downsampled template matching for speed"""\n    try:\n        frame = cv2.imread(frame_path, cv2.IMREAD_GRAYSCALE)\n        template = cv2.imread(template_path, cv2.IMREAD_GRAYSCALE)\n        \n        if frame is None or template is None:\n            return 0\n        \n        # Downsample both frame and template for faster processing\n        scale = 0.5\n        frame_small = cv2.resize(frame, None, fx=scale, fy=scale)\n        template_small = cv2.resize(template, None, fx=scale, fy=scale)\n        \n        if template_small.shape[0] > frame_small.shape[0] or template_small.shape[1] > frame_small.shape[1]:\n            return 0\n        \n        # Use TM_CCORR_NORMED for normalized correlation\n        result = cv2.matchTemplate(frame_small, template_small, cv2.TM_CCORR_NORMED)\n        \n        # Find matches above very high threshold\n        locations = np.where(result >= threshold)\n        \n        if len(locations[0]) == 0:\n            return 0\n        \n        # Count non-overlapping matches\n        matches = list(zip(locations[1], locations[0]))\n        template_h, template_w = template_small.shape\n        min_distance = max(template_h, template_w)\n        \n        selected = []\n        for x, y in sorted(matches):\n            overlaps = False\n            for sx, sy in selected:\n                if abs(x - sx) < min_distance and abs(y - sy) < min_distance:\n                    overlaps = True\n                    break\n            if not overlaps:\n                selected.append((x, y))\n        \n        return len(selected)\n    except Exception as e:\n        print(f"Error: {e}", file=sys.stderr)\n        return 0\n\nresults = []\nprint("Processing frames...")\nsys.stdout.flush()\n\nfor i in range(1, 28):\n    frame_path = f"/root/keyframes_{i:03d}.png"\n    frame_id = f"/root/keyframes_{i:03d}.png"\n    \n    coins = count_objects_very_fast(frame_path, "/root/coin.png", threshold=0.8)\n    enemies = count_objects_very_fast(frame_path, "/root/enemy.png", threshold=0.8)\n    turtles = count_objects_very_fast(frame_path, "/root/turtle.png", threshold=0.8)\n    \n    results.append({\'frame_id\': frame_id, \'coins\': coins, \'enemies\': enemies, \'turtles\': turtles})\n    print(f"Frame {i:03d}: coins={coins}, enemies={enemies}, turtles={turtles}")\n    sys.stdout.flush()\n\nwith open(\'/root/counting_results.csv\', \'w\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'frame_id\', \'coins\', \'enemies\', \'turtles\'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint("Done!")\nEOF\n'] min_timeout_sec: 45.0 max_timeout_sec: 180.0
