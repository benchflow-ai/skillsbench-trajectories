Sending keys: ['cat > /root/event_association_final.py << \'EOFPYTHON\'\nimport obspy\nfrom obspy import read, UTCDateTime\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime\nimport seisbench.models\nfrom collections import defaultdict\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Constants\nVP = 6.0  # km/s\nVS = VP / 1.75  # km/s\n\nprint("Loading data...")\nst = read(\'/root/data/wave.mseed\')\nstations_df = pd.read_csv(\'/root/data/stations.csv\')\n\n# Create station location lookup\nstation_locs = {}\nfor _, row in stations_df.iterrows():\n    key = f"{row[\'network\']}.{row[\'station\']}"\n    if key not in station_locs:\n        station_locs[key] = {\n            \'lon\': row[\'longitude\'],\n            \'lat\': row[\'latitude\'],\n            \'elev\': row[\'elevation_m\']\n        }\n\nprint(f"Found {len(station_locs)} unique stations")\n\n# Load PhaseNet model\nprint("Loading PhaseNet model...")\nmodel = seisbench.models.PhaseNet.from_pretrained("original")\n\n# Get Z channel traces\nz_traces = [tr for tr in st if tr.stats.channel.endswith(\'Z\')]\nz_stream = obspy.Stream(traces=z_traces)\n\nprint(f"Running phase picking on {len(z_stream)} traces...")\nannotations = model.annotate(z_stream)\n\n# Extract picks with lower threshold for better coverage\nthreshold = 0.4\nprint(f"Extracting picks (threshold={threshold})...")\np_picks = model.picks_from_annotations(annotations, threshold, phase=\'P\')\ns_picks = model.picks_from_annotations(annotations, threshold, phase=\'S\')\n\nprint(f"Found {len(p_picks)} P picks and {len(s_picks)} S picks")\n\n# Organize picks by station\nall_picks = []\nfor pick in p_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split(\'.\')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'P\',\n            \'time\': pick_time,\n            \'time_float\': float(pick_time),\n            \'trace_id\': trace_id\n        })\n\nfor pick in s_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split(\'.\')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'S\',\n            \'time\': pick_time,\n            \'time_float\': float(pick_time),\n            \'trace_id\': trace_id\n        })\n\nprint(f"Total picks: {len(all_picks)}")\n\n# Group picks by station and phase\npicks_by_station = defaultdict(lambda: {\'P\': [], \'S\': []})\nfor pick in all_picks:\n    key = f"{pick[\'network\']}.{pick[\'station\']}"\n    picks_by_station[key][pick[\'phase\']].append(pick)\n\nprint(f"Picks organized at {len(picks_by_station)} stations")\n\n# Get all unique P times and sort them\nall_p_times = []\nfor station, phases in picks_by_station.items():\n    for p_pick in phases[\'P\']:\n        all_p_times.append((p_pick[\'time_float\'], station, p_pick))\n\nall_p_times = sorted(all_p_times, key=lambda x: x[0])\nprint(f"Found {len(all_p_times)} P picks across all stations")\n\n# Cluster picks using a sliding window approach\nevents = []\nused_indices = set()\n\nfor i, (p_time_float, ref_station, ref_pick) in enumerate(all_p_times):\n    if i in used_indices:\n        continue\n    \n    # Find all picks within a time window\n    window_size = 1.5  # seconds\n    cluster_picks = {\'P\': {}, \'S\': {}}\n    cluster_indices = set()\n    \n    # Add reference pick\n    cluster_picks[\'P\'][ref_station] = ref_pick\n    cluster_indices.add(i)\n    \n    # Find other P picks in the window\n    for j, (other_p_time, other_station, other_pick) in enumerate(all_p_times):\n        if j != i and j not in used_indices:\n            if abs(other_p_time - p_time_float) < window_size and other_station != ref_station:\n                cluster_picks[\'P\'][other_station] = other_pick\n                cluster_indices.add(j)\n    \n    # Only keep clusters with at least 3 stations\n    if len(cluster_picks[\'P\']) >= 3:\n        # Try to find matching S picks\n        for station in cluster_picks[\'P\']:\n            p_pick = cluster_picks[\'P\'][station]\n            p_time = p_pick[\'time_float\']\n            \n            # Look for S pick within expected range (P-S time ~2-4 seconds for local events)\n            for s_pick in picks_by_station[station][\'S\']:\n                s_time = s_pick[\'time_float\']\n                ps_diff = s_time - p_time\n                if 1.5 < ps_diff < 5.0:  # Broader range for robustness\n                    cluster_picks[\'S\'][station] = s_pick\n                    break\n        \n        # Create event\n        event_time = UTCDateTime(np.median([p[\'time_float\'] for p in cluster_picks[\'P\'].values()]))\n        events.append({\n            \'time\': event_time,\n            \'time_float\': float(event_time),\n            \'num_stations\': len(cluster_picks[\'P\']),\n            \'picks\': cluster_picks\n        })\n        \n        # Mark these indices as used\n        for idx in cluster_indices:\n            used_indices.add(idx)\n\nprint(f"Found {len(events)} events from clustering")\n\n# Remove very similar events (within 1 second)\nfinal_events = []\nfor event in events:\n    is_duplicate = False\n    for final_event in final_events:\n        if abs(event[\'time_float\'] - final_event[\'time_float\']) < 1.0:\n            is_duplicate = True\n            break\n    if not is_duplicate:\n        final_events.append(event)\n\nprint(f"After removing duplicates: {len(final_events)} events")\n\n# Sort by time\nfinal_events = sorted(final_events, key=lambda x: x[\'time_float\'])\n\n# Write results to CSV\nresults = []\nfor event in final_events:\n    iso_time = event[\'time\'].isoformat().replace(\'Z\', \'\')\n    results.append({\'time\': iso_time})\n\nresults_df = pd.DataFrame(results)\nresults_df.to_csv(\'/root/results.csv\', index=False)\nprint(f"\\nWrote {len(results_df)} events to /root/results.csv")\nprint("\\nFirst 20 events:")\nprint(results_df.head(20))\n\nEOFPYTHON\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
