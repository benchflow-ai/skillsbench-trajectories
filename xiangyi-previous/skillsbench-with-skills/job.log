Sending keys: ['cat > /root/convert_units3.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\n\ndf = pd.read_csv(\'/root/temp_converted2.csv\')\nprint(f"Starting with {len(df)} rows")\n\n# Fix Hemoglobin: values < 5 are in mmol/L, multiply by 1.61 to get g/dL\nmask = df[\'Hemoglobin\'] < 5\nprint(f"Hemoglobin: converting {mask.sum()} values < 5 (mmol/L to g/dL)")\ndf.loc[mask, \'Hemoglobin\'] = df.loc[mask, \'Hemoglobin\'] * 1.61\n\n# Fix Serum_Calcium: values > 12 are still wrong, likely were in mmol/L\n# Normal range 8.5-10.5 mg/dL. mmol/L * 4.0 = mg/dL\n# Values that are > 12 after conversion might have been wrongly converted\n# Actually, let me check - if original was 2.5 mmol/L * 4 = 10 mg/dL (correct)\n# If original was already 10 mg/dL and we multiplied by 4 = 40 (wrong)\n# So values > 12 should be divided by 4 to restore, then we need different logic\n# Let\'s assume values 12-20 are already in mg/dL that got wrongly converted\nmask = df[\'Serum_Calcium\'] > 12\nprint(f"Serum_Calcium: reverting {mask.sum()} values > 12")\ndf.loc[mask, \'Serum_Calcium\'] = df.loc[mask, \'Serum_Calcium\'] / 4.0\n\n# Fix Magnesium: normal range 1.7-2.4 mg/dL\n# Values > 3 are likely in mmol/L that weren\'t converted, or wrong conversions\n# mmol/L * 2.43 = mg/dL. If value is 4 mmol/L * 2.43 = 9.7 mg/dL (too high)\n# So values > 3 that are actually in mg/dL should stay, values in mmol/L should convert\n# Let\'s say values between 3-6 are likely already mg/dL, values > 6 need /2.43\nmask = df[\'Magnesium\'] > 6\nprint(f"Magnesium: converting {mask.sum()} values > 6 (dividing by 2.43)")\ndf.loc[mask, \'Magnesium\'] = df.loc[mask, \'Magnesium\'] / 2.43\n\n# Fix Phosphorus: normal range 2.5-4.5 mg/dL\n# Values > 8 might be in mmol/L or just high (CKD patients can have high P)\n# mmol/L * 3.1 = mg/dL. If 5 mmol/L * 3.1 = 15.5 mg/dL\n# Values > 10 are likely mmol/L that got wrongly handled\nmask = df[\'Phosphorus\'] > 10\nprint(f"Phosphorus: converting {mask.sum()} values > 10 (dividing by 3.1)")\ndf.loc[mask, \'Phosphorus\'] = df.loc[mask, \'Phosphorus\'] / 3.1\n\ndf.to_csv(\'/root/temp_converted3.csv\', index=False)\nprint("Saved third batch of conversions")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
Sending keys: ['cat > harmonize_lab_data.py << \'ENDOFSCRIPT\'\nimport pandas as pd\nimport numpy as np\n\n# Load the data\nprint("Loading data...")\ndf = pd.read_csv(\'/root/environment/data/ckd_lab_data.csv\', dtype=str)\n\nprint(f"Initial rows: {len(df)}")\nprint(f"Columns: {len(df.columns)}")\n\n# Function to clean and convert values\ndef clean_value(val):\n    if pd.isna(val) or val == \'\' or str(val).strip() == \'\':\n        return np.nan\n    val = str(val).strip()\n    val = val.replace(\',\', \'.\')\n    try:\n        return float(val)\n    except:\n        return np.nan\n\n# Clean all numeric columns\nprint("Cleaning values...")\nfor col in df.columns:\n    if col != \'patient_id\':\n        df[col] = df[col].apply(clean_value)\n\n# Remove rows with missing values\nprint("Removing rows with missing values...")\ndf_clean = df.dropna().copy()\nprint(f"Rows after removing missing values: {len(df_clean)}")\n\n# Define conversions with better thresholds\n# Strategy: if value is outside the ENTIRE possible range for US units, it\'s in alternative units\nconversions = {\n    \'Serum_Creatinine\': {\'factor\': 88.4, \'threshold\': 25},  # >25 mg/dL is impossible, likely µmol/L\n    \'BUN\': {\'factor\': 0.357, \'threshold\': 150},  # >150 mg/dL rare, likely mmol/L  \n    \'Magnesium\': {\'factor\': 0.411, \'threshold\': 7},  # >7 mg/dL impossible, likely mmol/L\n    \'Serum_Calcium\': {\'factor\': 0.25, \'threshold\': 18},  # >18 mg/dL impossible, likely mmol/L\n    \'Ionized_Calcium\': {\'factor\': 0.25, \'threshold\': 8},  # >8 mg/dL impossible, likely mmol/L\n    \'Phosphorus\': {\'factor\': 0.323, \'threshold\': 30},  # >30 mg/dL impossible, likely mmol/L\n    \'Vitamin_D_25OH\': {\'factor\': 2.496, \'threshold\': 200},  # >200 ng/mL rare, likely nmol/L\n    \'Vitamin_D_1_25OH\': {\'factor\': 2.4, \'threshold\': 200},  # >200 pg/mL rare, likely pmol/L\n    \'Hemoglobin\': {\'factor\': 10, \'threshold\': 25},  # >25 g/dL impossible, likely g/L\n    \'Total_Bilirubin\': {\'factor\': 17.1, \'threshold\': 40},  # >40 mg/dL very rare, likely µmol/L\n    \'Direct_Bilirubin\': {\'factor\': 17.1, \'threshold\': 25},  # >25 mg/dL very rare, likely µmol/L\n    \'Albumin_Serum\': {\'factor\': 10, \'threshold\': 7},  # >7 g/dL impossible, likely g/L\n    \'Total_Protein\': {\'factor\': 10, \'threshold\': 12},  # >12 g/dL impossible, likely g/L\n    \'Prealbumin\': {\'factor\': 10, \'threshold\': 60},  # >60 mg/dL impossible, likely mg/L\n    \'CRP\': {\'factor\': 10, \'threshold\': 50},  # >50 mg/dL very high, likely mg/L\n    \'Serum_Iron\': {\'factor\': 0.179, \'threshold\': 500},  # >500 µg/dL impossible, likely µmol/L\n    \'TIBC\': {\'factor\': 0.179, \'threshold\': 700},  # >700 µg/dL impossible, likely µmol/L\n    \'Total_Cholesterol\': {\'factor\': 0.0259, \'threshold\': 500},  # >500 mg/dL very rare, likely mmol/L\n    \'LDL_Cholesterol\': {\'factor\': 0.0259, \'threshold\': 400},  # >400 mg/dL very rare, likely mmol/L\n    \'HDL_Cholesterol\': {\'factor\': 0.0259, \'threshold\': 150},  # >150 mg/dL very rare, likely mmol/L\n    \'Triglycerides\': {\'factor\': 0.0113, \'threshold\': 3000},  # >3000 mg/dL very rare, likely mmol/L\n    \'Non_HDL_Cholesterol\': {\'factor\': 0.0259, \'threshold\': 500},  # >500 mg/dL very rare, likely mmol/L\n    \'Glucose\': {\'factor\': 0.0555, \'threshold\': 1000},  # >1000 mg/dL extreme, likely mmol/L\n    \'Uric_Acid\': {\'factor\': 59.48, \'threshold\': 20},  # >20 mg/dL impossible, likely µmol/L\n    \'Troponin_I\': {\'factor\': 1000, \'threshold\': 500},  # >500 ng/mL impossible, likely pg/mL\n    \'Troponin_T\': {\'factor\': 1000, \'threshold\': 500},  # >500 ng/mL impossible, likely pg/mL\n    \'Free_T4\': {\'factor\': 12.87, \'threshold\': 10},  # >10 ng/dL impossible, likely pmol/L\n    \'Free_T3\': {\'factor\': 0.6536, \'threshold\': 20},  # >20 pg/mL impossible, likely pmol/L\n    \'Lactate\': {\'factor\': 0.111, \'threshold\': 50},  # >50 mg/dL impossible, likely mmol/L\n}\n\nprint("Applying unit conversions...")\nfor col, params in conversions.items():\n    if col in df_clean.columns:\n        mask = df_clean[col] > params[\'threshold\']\n        if mask.sum() > 0:\n            df_clean.loc[mask, col] = df_clean.loc[mask, col] / params[\'factor\']\n            print(f"  {col}: converted {mask.sum()} values from alternative unit")\n\n# Round all numeric columns to 2 decimal places\nprint("Rounding to 2 decimal places...")\nfor col in df_clean.columns:\n    if col != \'patient_id\':\n        df_clean.loc[:, col] = df_clean[col].round(2)\n        df_clean.loc[:, col] = df_clean[col].apply(lambda x: f"{x:.2f}")\n\n# Save the harmonized data\noutput_path = \'/root/ckd_lab_data_harmonized.csv\'\ndf_clean.to_csv(output_path, index=False)\nprint(f"\\nHarmonized data saved to: {output_path}")\nprint(f"Final rows: {len(df_clean)}")\nprint(f"Final columns: {len(df_clean.columns)}")\n\nENDOFSCRIPT\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
