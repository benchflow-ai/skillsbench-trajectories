Sending keys: ['cat > /app/normalize_v2.py << \'EOFPYTHON\'\nimport csv\nimport json\nimport re\nfrom typing import List, Dict, Tuple\n\ndef load_codebooks(data_dir=\'/app/data/\'):\n    """Load all codebooks into a dictionary keyed by product_id"""\n    codebooks = {}\n    products = [\'P1_POWER\', \'P2_CTRL\', \'P3_RF\']\n    \n    for product in products:\n        codebooks[product] = []\n        with open(f\'{data_dir}/codebook_{product}.csv\', \'r\', encoding=\'utf-8\') as f:\n            reader = csv.DictReader(f)\n            for row in reader:\n                codebooks[product].append(row)\n    \n    return codebooks\n\ndef load_test_logs(filepath=\'/app/data/test_center_logs.csv\'):\n    """Load test center logs"""\n    logs = []\n    with open(filepath, \'r\', encoding=\'utf-8\') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            logs.append(row)\n    return logs\n\ndef extract_components_signals(text):\n    """Extract component names and signal names from text"""\n    # Component patterns: R152, U12, C87, D34, etc.\n    components = set(re.findall(r\'\\b[A-Z]\\d+[A-Z]?\\b\', text, re.IGNORECASE))\n    \n    # Signal patterns: I2C_SDA, VDD_5V, SW_NODE, etc. (uppercase with underscores)\n    signals = set(re.findall(r\'\\b[A-Z][A-Z0-9]*(?:_[A-Z0-9]+)+\\b\', text))\n    \n    return list(components), list(signals)\n\ndef calculate_match_score(raw_text, codebook_entry):\n    """Calculate how well a codebook entry matches the raw text"""\n    raw_lower = raw_text.lower()\n    \n    # Extract from raw text\n    raw_components, raw_signals = extract_components_signals(raw_text)\n    \n    # Extract from codebook\n    cb_label = codebook_entry[\'standard_label\']\n    cb_keywords = codebook_entry[\'keywords_examples\']\n    cb_components, cb_signals = extract_components_signals(cb_label)\n    \n    score = 0.0\n    matches = []\n    \n    # Exact component match (high weight)\n    for comp in raw_components:\n        if comp.upper() in [c.upper() for c in cb_components]:\n            score += 0.4\n            matches.append(f"component:{comp}")\n            break  # Only count once\n    \n    # Exact signal match (high weight)\n    for sig in raw_signals:\n        if sig.upper() in [s.upper() for s in cb_signals]:\n            score += 0.4\n            matches.append(f"signal:{sig}")\n            break  # Only count once\n    \n    # Keyword matching from codebook examples\n    keyword_list = [k.strip() for k in cb_keywords.lower().split(\',\')]\n    \n    # Category-specific keywords with higher weights\n    category_matches = 0\n    \n    # Open circuit detection\n    if \'open\' in cb_label.lower() or \'开路\' in cb_keywords:\n        if \'open\' in raw_lower or \'开路\' in raw_text or \' os \' in raw_lower or \'os (\' in raw_lower:\n            score += 0.25\n            matches.append(\'open_circuit\')\n            category_matches += 1\n    \n    # Short circuit detection  \n    if \'short\' in cb_label.lower() or \'短路\' in cb_keywords:\n        if \'short\' in raw_lower or \'短路\' in raw_text or \'短路趋势\' in raw_text or \'bridge\' in raw_lower:\n            score += 0.25\n            matches.append(\'short_circuit\')\n            category_matches += 1\n    \n    # Cold solder detection\n    if \'cold solder\' in cb_label.lower() or \'虚焊\' in cb_keywords:\n        if \'cold solder\' in raw_lower or \'虚焊\' in raw_text or \'少锡\' in raw_text or \\\n           \'浮高\' in raw_text or \'missing solder\' in raw_lower:\n            score += 0.25\n            matches.append(\'cold_solder\')\n            category_matches += 1\n    \n    # Fixture/probe contact issues\n    if \'fixture\' in cb_label.lower() or \'contact\' in cb_label.lower():\n        if \'fixture\' in raw_lower or \'pogo\' in raw_lower or \'probe\' in raw_lower or \\\n           \'reseat\' in raw_lower or \'接触不良\' in raw_text or \'探针\' in raw_text or \\\n           \'重插\' in raw_text or \'换针\' in raw_text or \'治具\' in raw_text or \\\n           \'contact\' in raw_lower or \'pin\' in raw_lower or \'磨损\' in raw_text:\n            score += 0.3\n            matches.append(\'fixture_contact\')\n            category_matches += 1\n    \n    # Programming/Flash issues\n    if \'program\' in cb_label.lower() or \'flash\' in cb_label.lower():\n        if \'program\' in raw_lower or \'flash\' in raw_lower or \'烧录\' in raw_text or \\\n           \'写入\' in raw_text or \'reflash\' in raw_lower or \'reburn\' in raw_lower:\n            score += 0.3\n            matches.append(\'programming\')\n            category_matches += 1\n    \n    # Verification/CRC issues\n    if \'verif\' in cb_label.lower() or \'crc\' in cb_label.lower() or \'checksum\' in cb_label.lower():\n        if \'verif\' in raw_lower or \'crc\' in raw_lower or \'checksum\' in raw_lower or \\\n           \'校验\' in raw_text or \'验证\' in raw_text:\n            score += 0.3\n            matches.append(\'verification\')\n            category_matches += 1\n    \n    # Component issue detection\n    if \'component\' in cb_label.lower() and \'issue\' in cb_label.lower():\n        if \'器件\' in raw_text or \'component\' in raw_lower or \'device\' in raw_lower:\n            score += 0.2\n            matches.append(\'component_issue\')\n    \n    # Current issues\n    if \'current\' in cb_label.lower() or \'电流\' in cb_keywords:\n        if \'current\' in raw_lower or \'电流\' in raw_text or \'idle\' in raw_lower:\n            score += 0.2\n            matches.append(\'current_issue\')\n    \n    # General keyword matching (lower weight)\n    for kw in keyword_list:\n        if kw and len(kw) > 2 and kw in raw_lower:\n            score += 0.05\n            if kw not in str(matches):\n                matches.append(kw)\n    \n    return score, matches\n\ndef segment_raw_text(raw_text):\n    """Segment raw text into individual issues"""\n    segments = []\n    \n    # Split by common delimiters but be more careful\n    # Use / and & as primary delimiters, but keep "and" phrases together\n    parts = re.split(r\'\\s*/\\s*|\\s*&\\s*\', raw_text)\n    \n    if len(parts) > 1:\n        for part in parts:\n            part = part.strip()\n            if len(part) > 3:  # Minimum meaningful length\n                segments.append(part)\n    \n    # If no good split found, return whole text\n    if not segments:\n        segments = [raw_text.strip()]\n    \n    return segments\n\ndef find_best_match(segment, codebooks, product_id, station):\n    """Find the best matching code for a segment"""\n    if product_id not in codebooks:\n        return None, 0.0, []\n    \n    best_score = 0.0\n    best_match = None\n    best_matches_detail = []\n    \n    for entry in codebooks[product_id]:\n        score, matches = calculate_match_score(segment, entry)\n        \n        # Check if station is in scope - apply penalty if not\n        station_scope = entry[\'station_scope\'].upper()\n        if station.upper() not in station_scope:\n            score *= 0.8  # Small penalty for out-of-scope\n        \n        if score > best_score:\n            best_score = score\n            best_match = entry\n            best_matches_detail = matches\n    \n    return best_match, best_score, best_matches_detail\n\ndef normalize_logs(logs, codebooks):\n    """Normalize all logs"""\n    results = []\n    \n    for log in logs:\n        record_id = log[\'record_id\']\n        product_id = log[\'product_id\']\n        station = log[\'station\']\n        engineer_id = log[\'engineer_id\']\n        raw_reason_text = log[\'raw_reason_text\']\n        \n        # Segment the raw text\n        segments = segment_raw_text(raw_reason_text)\n        \n        normalized = []\n        for i, segment in enumerate(segments, 1):\n            segment_id = f"{record_id}-S{i}"\n            \n            # Find best match\n            best_match, score, matches = find_best_match(segment, codebooks, product_id, station)\n            \n            # Dynamic threshold based on match quality\n            if best_match and score >= 0.35:  # Threshold for acceptable match\n                # Calculate confidence based on score\n                # Map score to confidence range [0.5, 0.95]\n                confidence = min(0.95, max(0.50, score))\n                pred_code = best_match[\'code\']\n                pred_label = best_match[\'standard_label\']\n                rationale = f"Matched: {\', \'.join(str(m) for m in matches[:6])}. Score: {score:.2f}"\n            else:\n                # Unknown - low confidence\n                confidence = min(0.25, score * 0.6) if score > 0 else 0.10\n                pred_code = "UNKNOWN"\n                pred_label = ""\n                rationale = f"No confident match. Best score: {score:.2f}. Segment may need manual review."\n            \n            normalized.append({\n                "segment_id": segment_id,\n                "span_text": segment,\n                "pred_code": pred_code,\n                "pred_label": pred_label,\n                "confidence": round(confidence, 3),\n                "rationale": rationale\n            })\n        \n        results.append({\n            "record_id": record_id,\n            "product_id": product_id,\n            "station": station,\n            "engineer_id": engineer_id,\n            "raw_reason_text": raw_reason_text,\n            "normalized": normalized\n        })\n    \n    return results\n\ndef main():\n    print("Loading codebooks...")\n    codebooks = load_codebooks()\n    \n    print("Loading test logs...")\n    logs = load_test_logs()\n    \n    print(f"Processing {len(logs)} records...")\n    results = normalize_logs(logs, codebooks)\n    \n    output = {"records": results}\n    \n    print("Writing output...")\n    with open(\'/app/output/solution.json\', \'w\', encoding=\'utf-8\') as f:\n        json.dump(output, f, ensure_ascii=False, indent=2)\n    \n    print("Done!")\n    print(f"Processed {len(results)} records")\n    \n    # Print some statistics\n    total_segments = sum(len(r[\'normalized\']) for r in results)\n    unknown_count = sum(1 for r in results for n in r[\'normalized\'] if n[\'pred_code\'] == \'UNKNOWN\')\n    known_count = total_segments - unknown_count\n    \n    print(f"Total segments: {total_segments}")\n    print(f"Known matches: {known_count} ({known_count/total_segments*100:.1f}%)")\n    print(f"Unknown: {unknown_count} ({unknown_count/total_segments*100:.1f}%)")\n    \n    # Calculate confidence statistics\n    confidences = [n[\'confidence\'] for r in results for n in r[\'normalized\']]\n    if confidences:\n        print(f"Confidence - Mean: {sum(confidences)/len(confidences):.3f}")\n        confidences_sorted = sorted(confidences)\n        print(f"Confidence - Median: {confidences_sorted[len(confidences_sorted)//2]:.3f}")\n        print(f"Confidence - Min: {min(confidences):.3f}, Max: {max(confidences):.3f}")\n\nif __name__ == \'__main__\':\n    main()\nEOFPYTHON\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
