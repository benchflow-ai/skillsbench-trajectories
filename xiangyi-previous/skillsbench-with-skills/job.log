Sending keys: ['cat <<EOF > /app/run_causal_analysis.py\nimport pandas as pd\nimport numpy as np\nimport statsmodels.api as sm\nfrom scipy import stats\nimport json\nimport os\nimport warnings\n\n# Suppress warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Paths\nintensive_path = \'/app/output/user_category_period_aggregated_intensive.csv\'\nextensive_path = \'/app/output/user_category_period_aggregated_extensive.csv\'\nfeatures_path = \'/app/output/survey_feature_engineered.csv\'\nanomaly_path = \'/app/output/category_anomaly_index.csv\'\noutput_path = \'/app/output/causal_analysis_report.json\'\n\nprint(\'Loading data...\')\nintensive_df = pd.read_csv(intensive_path)\nextensive_df = pd.read_csv(extensive_path)\nfeatures_df = pd.read_csv(features_path)\nanomaly_df = pd.read_csv(anomaly_path)\n\n# Prepare features\nfeature_cols = [c for c in features_df.columns if c != \'Survey ResponseID\']\nprint(f\'Total features: {len(feature_cols)}\')\n\n# Convert features to numeric (int)\nfor col in feature_cols:\n    features_df[col] = features_df[col].astype(int)\n\n# Merge features into dataframes\nintensive_df = intensive_df.merge(features_df, on=\'Survey ResponseID\', how=\'left\')\nextensive_df = extensive_df.merge(features_df, on=\'Survey ResponseID\', how=\'left\')\n\n# Encode Period: Baseline=0, Treatment=1\nintensive_df[\'Period_Num\'] = (intensive_df[\'Period\'] == \'Treatment\').astype(int)\nextensive_df[\'Period_Num\'] = (extensive_df[\'Period\'] == \'Treatment\').astype(int)\n\n# Get Categories\nsurge_cats = anomaly_df.sort_values(\'Anomaly_Index\', ascending=False).head(10)\nslump_cats = anomaly_df.sort_values(\'Anomaly_Index\', ascending=True).head(10)\n\nresults_json = {\n    "metadata": {\n        "baseline_start": "01-01-2020",\n        "baseline_end": "02-29-2020",\n        "treatment_start": "03-01-2020",\n        "treatment_end": "03-31-2020",\n        "total_features_analyzed": len(feature_cols)\n    },\n    "surge_categories": [],\n    "slump_categories": [],\n    "summary": {}\n}\n\ndef fast_ols(y, X):\n    # X is expected to include constant\n    try:\n        # Coefficients\n        # b = (X\'X)^-1 X\'y\n        XtX = X.T @ X\n        Xty = X.T @ y\n        \n        # Use lstsq for stability\n        # b, res, rank, s = np.linalg.lstsq(X, y, rcond=None)\n        # But we need inv(XtX) for standard errors\n        \n        # Inverse of XtX\n        try:\n            XtX_inv = np.linalg.inv(XtX)\n        except np.linalg.LinAlgError:\n            # Singular matrix\n            return None, None\n            \n        b = XtX_inv @ Xty\n        \n        # Residuals\n        predictions = X @ b\n        residuals = y - predictions\n        n, k = X.shape\n        \n        if n <= k:\n            return None, None\n            \n        # Variance\n        sigma2 = np.sum(residuals**2) / (n - k)\n        var_b = sigma2 * XtX_inv\n        se_b = np.sqrt(np.diag(var_b))\n        \n        # t-stats\n        t_b = b / se_b\n        \n        # p-values\n        p_b = 2 * (1 - stats.t.cdf(np.abs(t_b), df=n-k))\n        \n        return b, p_b\n        \n    except Exception as e:\n        return None, None\n\ndef analyze_category(category, anomaly_score, is_surge):\n    print(f\'Analyzing {category}...\')\n    cat_intensive = intensive_df[intensive_df[\'Category\'] == category].copy()\n    cat_extensive = extensive_df[extensive_df[\'Category\'] == category].copy()\n    \n    # Basic Stats\n    baseline_spend = cat_intensive[cat_intensive[\'Period\'] == \'Baseline\'][\'Total Spend\']\n    treatment_spend = cat_intensive[cat_intensive[\'Period\'] == \'Treatment\'][\'Total Spend\']\n    \n    baseline_purchasers = cat_extensive[(cat_extensive[\'Period\'] == \'Baseline\') & (cat_extensive[\'Has_Purchase\'] == 1)].shape[0]\n    treatment_purchasers = cat_extensive[(cat_extensive[\'Period\'] == \'Treatment\') & (cat_extensive[\'Has_Purchase\'] == 1)].shape[0]\n    n_users = cat_extensive[\'Survey ResponseID\'].nunique()\n    \n    stats_dict = {\n        "category": category,\n        "anomaly_index": round(anomaly_score, 2),\n        "baseline_avg_spend": round(baseline_spend.mean(), 2),\n        "treatment_avg_spend": round(treatment_spend.mean(), 2),\n        "n_purchasers_baseline": int(baseline_purchasers),\n        "n_purchasers_treatment": int(treatment_purchasers),\n        "baseline_purchase_rate": round(baseline_purchasers / n_users, 4),\n        "treatment_purchase_rate": round(treatment_purchasers / n_users, 4),\n        "n_at_risk": int(n_users)\n    }\n    \n    # --- Intensive Margin: Univariate DiD ---\n    intensive_drivers = []\n    \n    # Prepare common columns\n    y_intensive = cat_intensive[\'Total Spend\'].values\n    period_intensive = cat_intensive[\'Period_Num\'].values\n    const_intensive = np.ones(len(y_intensive))\n    \n    for feature in feature_cols:\n        feat_vals = cat_intensive[feature].values\n        if np.unique(feat_vals).size < 2:\n            continue\n            \n        # X = [const, Period, Feature, Interaction]\n        interaction = period_intensive * feat_vals\n        X = np.column_stack((const_intensive, period_intensive, feat_vals, interaction))\n        \n        b, p = fast_ols(y_intensive, X)\n        \n        if b is not None:\n            # Interaction is the last column (index 3)\n            coeff = b[3]\n            pval = p[3]\n            \n            intensive_drivers.append({\n                "feature": feature,\n                "did_estimate": float(coeff),\n                "p_value": float(pval),\n                "method": "Univariate DiD"\n            })\n            \n    if is_surge:\n        intensive_drivers.sort(key=lambda x: x[\'did_estimate\'], reverse=True)\n    else:\n        intensive_drivers.sort(key=lambda x: x[\'did_estimate\'], reverse=False)\n    \n    stats_dict[\'intensive_margin\'] = intensive_drivers[:3]\n    \n    # --- Extensive Margin: Multivariate Heterogeneous DiD ---\n    # Screening with Fast OLS\n    extensive_candidates = []\n    y_extensive = cat_extensive[\'Has_Purchase\'].values\n    period_extensive = cat_extensive[\'Period_Num\'].values\n    const_extensive = np.ones(len(y_extensive))\n    \n    for feature in feature_cols:\n        feat_vals = cat_extensive[feature].values\n        if np.unique(feat_vals).size < 2:\n            continue\n            \n        interaction = period_extensive * feat_vals\n        X = np.column_stack((const_extensive, period_extensive, feat_vals, interaction))\n        \n        b, p = fast_ols(y_extensive, X)\n        if b is not None:\n            # We use absolute t-value proxy (coeff/se) or just p-value. \n            # Since we have p-value, use it (smaller is better)\n            pval = p[3]\n            extensive_candidates.append((feature, pval))\n    \n    # Select top 30 features by smallest p-value\n    extensive_candidates.sort(key=lambda x: x[1])\n    top_features = [x[0] for x in extensive_candidates[:30]]\n    \n    extensive_drivers = []\n    if top_features:\n        try:\n            # Build Multivariate Model with top features\n            # We can use statsmodels for the final multivariate model as it\'s just one call\n            period_col = cat_extensive[[\'Period_Num\']]\n            feat_cols = cat_extensive[top_features]\n            \n            inter_cols = feat_cols.multiply(cat_extensive[\'Period_Num\'], axis=0)\n            inter_cols.columns = [f\'Interaction_{f}\' for f in top_features]\n            \n            X = pd.concat([period_col, feat_cols, inter_cols], axis=1)\n            X = sm.add_constant(X)\n            y = cat_extensive[\'Has_Purchase\']\n            \n            model = sm.OLS(y, X.astype(float)).fit()\n            \n            for f in top_features:\n                inter_col = f\'Interaction_{f}\'\n                if inter_col in model.params:\n                    extensive_drivers.append({\n                        "feature": f,\n                        "did_estimate": float(model.params[inter_col]),\n                        "p_value": float(model.pvalues[inter_col]),\n                        "method": "Multivariate Heterogeneous DiD"\n                    })\n        except Exception as e:\n            print(f\'Multivariate failed for {category}: {e}\')\n            pass\n        \n    if is_surge:\n        extensive_drivers.sort(key=lambda x: x[\'did_estimate\'], reverse=True)\n    else:\n        extensive_drivers.sort(key=lambda x: x[\'did_estimate\'], reverse=False)\n        \n    stats_dict[\'extensive_margin\'] = extensive_drivers[:3]\n    \n    return stats_dict\n\n# Run for Surge\nprint(\'Processing Surge Categories...\')\nfor _, row in surge_cats.iterrows():\n    res = analyze_category(row[\'Category\'], row[\'Anomaly_Index\'], is_surge=True)\n    results_json[\'surge_categories\'].append(res)\n\n# Run for Slump\nprint(\'Processing Slump Categories...\')\nfor _, row in slump_cats.iterrows():\n    res = analyze_category(row[\'Category\'], row[\'Anomaly_Index\'], is_surge=False)\n    results_json[\'slump_categories\'].append(res)\n\n# Summary\nresults_json[\'summary\'][\'surge\'] = {\n    "total_categories": len(results_json[\'surge_categories\']),\n    "total_intensive_drivers": len(results_json[\'surge_categories\']) * 3,\n    "total_extensive_drivers": len(results_json[\'surge_categories\']) * 3\n}\nresults_json[\'summary\'][\'slump\'] = {\n    "total_categories": len(results_json[\'slump_categories\']),\n    "total_intensive_drivers": len(results_json[\'slump_categories\']) * 3,\n    "total_extensive_drivers": len(results_json[\'slump_categories\']) * 3\n}\n\nwith open(output_path, \'w\') as f:\n    json.dump(results_json, f, indent=2)\n\nprint(f\'Analysis complete. Saved to {output_path}\')\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
