Sending keys: ['cat > /root/flood_check.py << \'EOF\'\nimport requests\nimport csv\nfrom datetime import datetime, timedelta\n\n# Read station IDs\nwith open(\'/root/data/michigan_stations.txt\', \'r\') as f:\n    stations = [line.strip() for line in f if line.strip()]\n\nprint(f"Processing {len(stations)} stations...")\n\n# Date range: April 1-7, 2025\nstart_date = "2025-04-01"\nend_date = "2025-04-07"\n\nresults = []\n\nfor i, station_id in enumerate(stations):\n    try:\n        # Get daily values (discharge) from USGS\n        # Parameter 00060 = Discharge (cubic feet per second)\n        # Parameter 00065 = Gage height (feet)\n        url = f"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={station_id}&startDT={start_date}&endDT={end_date}&parameterCd=00060,00065&siteStatus=all"\n        \n        resp = requests.get(url, timeout=30)\n        data = resp.json()\n        \n        # Get flood stage from NWIS flood service\n        flood_url = f"https://waterwatch.usgs.gov/webservices/floodstage?format=json&site={station_id}"\n        flood_resp = requests.get(flood_url, timeout=30)\n        \n        flood_stage = None\n        try:\n            flood_data = flood_resp.json()\n            if \'sites\' in flood_data and len(flood_data[\'sites\']) > 0:\n                site_info = flood_data[\'sites\'][0]\n                if \'flood_stage\' in site_info:\n                    flood_stage = float(site_info[\'flood_stage\'])\n        except:\n            pass\n        \n        flood_days = 0\n        \n        # Check if we have time series data\n        if \'value\' in data and \'timeSeries\' in data[\'value\']:\n            for ts in data[\'value\'][\'timeSeries\']:\n                var_code = ts.get(\'variable\', {}).get(\'variableCode\', [{}])[0].get(\'value\', \'\')\n                \n                # Check gage height against flood stage\n                if var_code == \'00065\' and flood_stage is not None:\n                    values = ts.get(\'values\', [{}])[0].get(\'value\', [])\n                    for val in values:\n                        try:\n                            gage_height = float(val[\'value\'])\n                            if gage_height >= flood_stage:\n                                flood_days += 1\n                        except:\n                            pass\n        \n        if flood_days > 0:\n            results.append({\'station_id\': station_id, \'flood_days\': flood_days})\n            print(f"[{i+1}/{len(stations)}] Station {station_id}: {flood_days} flood days")\n        else:\n            print(f"[{i+1}/{len(stations)}] Station {station_id}: No flooding")\n            \n    except Exception as e:\n        print(f"[{i+1}/{len(stations)}] Station {station_id}: Error - {str(e)[:50]}")\n\n# Write results to CSV\nwith open(\'/root/output/flood_results.csv\', \'w\', newline=\'\') as f:\n    writer = csv.DictWriter(f, fieldnames=[\'station_id\', \'flood_days\'])\n    writer.writeheader()\n    writer.writerows(results)\n\nprint(f"\\nDone! Found {len(results)} stations with flooding.")\nprint(f"Results saved to /root/output/flood_results.csv")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
