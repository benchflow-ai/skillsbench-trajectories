g, int(0.2/dt), int(4.0/dt))\n        # Avoid picking S before P or too close to P\n        p_idx = p_picks[0] if len(p_picks) > 0 else 0\n        s_char[:p_idx + int(0.2/dt)] = 0\n        s_picks = np.where(s_char > 2.5)[0]\n        if len(s_picks) > 0:\n            results.append({'file_name': f, 'phase': 'S', 'pick_idx': s_picks[0]})\n            \n    df = pd.DataFrame(results)\n    df.to_csv('/root/results.csv', index=False)\n\nif __name__ == '__main__':\n    pick_phases()\nEOF\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
