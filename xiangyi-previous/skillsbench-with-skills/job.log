Sending keys: ['cat <<\'EOF\' > solve_dicke.py\nimport numpy as np\nfrom qutip import *\nimport sys\n\n# Force flush\ndef log(msg):\n    print(msg)\n    sys.stdout.flush()\n\nlog("Starting simulation script...")\n\n# Parameters\nN = 4\nw0 = 1.0\nwc = 1.0\ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\n\n# Operators\na = tensor(destroy(n_max), *[qeye(2) for _ in range(N)])\n\nsz_list = []\nsp_list = []\nsm_list = []\n\nfor i in range(N):\n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmaz()\n    sz_list.append(tensor(qeye(n_max), *ops))\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmap()\n    sp_list.append(tensor(qeye(n_max), *ops))\n    \n    ops = [qeye(2) for _ in range(N)]\n    ops[i] = sigmam()\n    sm_list.append(tensor(qeye(n_max), *ops))\n\n# Collective operators\nJz = sum([0.5 * sz for sz in sz_list])\nJp = sum(sp_list)\nJm = sum(sm_list)\n\n# Hamiltonian\nH = w0 * Jz + wc * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\n# Common c_ops (Cavity loss)\nc_ops_base = [np.sqrt(kappa) * a]\n\n# Wigner grid\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\ndef solve_and_save(case_id, specific_c_ops):\n    log(f"Solving Case {case_id}...")\n    c_ops = c_ops_base + specific_c_ops\n    \n    # Steady state\n    log(f"  Computing steady state for Case {case_id}...")\n    rho_ss = steadystate(H, c_ops, method=\'iterative-lgmres\', tol=1e-6)\n    \n    # Trace out spins (keep cavity, index 0)\n    log(f"  Tracing out spins for Case {case_id}...")\n    rho_cav = rho_ss.ptrace(0)\n    \n    # Wigner\n    log(f"  Computing Wigner function for Case {case_id}...")\n    W = wigner(rho_cav, xvec, pvec)\n    \n    # Save\n    log(f"  Saving Case {case_id}...")\n    np.savetxt(f"{case_id}.csv", W, delimiter=",")\n    log(f"Saved {case_id}.csv")\n\n# Define rates\ngamma_phi = 0.01\ngamma_up = 0.1\ngamma_down = 0.1\ngamma_up_coll = 0.1\ngamma_down_coll = 0.1\n\n# Case 1\nc_ops_1 = []\nfor i in range(N):\n    c_ops_1.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_1.append(np.sqrt(gamma_up) * sp_list[i])\nsolve_and_save(1, c_ops_1)\n\n# Case 2\nc_ops_2 = []\nfor i in range(N):\n    c_ops_2.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_2.append(np.sqrt(gamma_down) * sm_list[i])\nsolve_and_save(2, c_ops_2)\n\n# Case 3\nc_ops_3 = []\nfor i in range(N):\n    c_ops_3.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_3.append(np.sqrt(gamma_down) * sm_list[i])\nc_ops_3.append(np.sqrt(gamma_up_coll) * Jp)\nsolve_and_save(3, c_ops_3)\n\n# Case 4\nc_ops_4 = []\nfor i in range(N):\n    c_ops_4.append(np.sqrt(gamma_phi) * sz_list[i])\n    c_ops_4.append(np.sqrt(gamma_down) * sm_list[i])\nc_ops_4.append(np.sqrt(gamma_down_coll) * Jm)\nsolve_and_save(4, c_ops_4)\n\nlog("All cases completed.")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
