Sending keys: ['cat > dicke_wigner2.py << \'EOF\'\nimport numpy as np\nimport qutip as qt\n\n# Parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0  # Spin frequency\nomega_c = 1.0  # Cavity frequency\ng = 2.0 / np.sqrt(N)  # Coupling strength\nkappa = 1.0  # Cavity loss rate\nn_max = 16  # Photon number cutoff\n\n# Grid for Wigner function\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\nprint(f"Setting up Dicke model with N={N} spins, n_max={n_max} photons")\n\n# Build full Hilbert space with individual spins\n# Dimensions: [cavity, spin1, spin2, spin3, spin4]\ndims = [n_max] + [2] * N\ntotal_dim = np.prod(dims)\nprint(f"Total Hilbert space dimension: {total_dim}")\n\n# Create identity operators\nId_cav = qt.qeye(n_max)\nId_spin = qt.qeye(2)\n\n# Cavity annihilation operator\na_op = qt.destroy(n_max)\nfor i in range(N):\n    a_op = qt.tensor(a_op, Id_spin) if i == 0 else a_op\na = qt.tensor(qt.destroy(n_max), *[Id_spin]*N)\n\n# Single spin operators\nsigma_z = qt.sigmaz()\nsigma_p = qt.sigmap()\nsigma_m = qt.sigmam()\n\ndef spin_op(op, k):\n    """Create operator acting on k-th spin (0-indexed) in full Hilbert space."""\n    op_list = [Id_cav] + [Id_spin]*N\n    op_list[k+1] = op  # +1 because cavity is at index 0\n    return qt.tensor(op_list)\n\n# Collective spin operators\nJz = sum(spin_op(sigma_z, k) for k in range(N)) / 2\nJp = sum(spin_op(sigma_p, k) for k in range(N))\nJm = sum(spin_op(sigma_m, k) for k in range(N))\n\n# Hamiltonian\n# H = omega_0 * Jz + omega_c * a^dag * a + g * (a^dag + a) * (J+ + J-)\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\nprint("Hamiltonian created")\n\ndef get_collapse_operators(case):\n    """Get collapse operators for each case."""\n    c_ops = []\n    \n    # Cavity decay (always present)\n    c_ops.append(np.sqrt(kappa) * a)\n    \n    if case == 1:\n        # Local de-phasing & local pumping\n        gamma_phi = 0.01\n        gamma_up = 0.1\n        # Local dephasing on each spin\n        for k in range(N):\n            c_ops.append(np.sqrt(gamma_phi) * spin_op(sigma_z, k))\n        # Local pumping on each spin\n        for k in range(N):\n            c_ops.append(np.sqrt(gamma_up) * spin_op(sigma_p, k))\n        \n    elif case == 2:\n        # Local de-phasing & local emission\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        # Local dephasing on each spin\n        for k in range(N):\n            c_ops.append(np.sqrt(gamma_phi) * spin_op(sigma_z, k))\n        # Local emission on each spin\n        for k in range(N):\n            c_ops.append(np.sqrt(gamma_down) * spin_op(sigma_m, k))\n        \n    elif case == 3:\n        # Local de-phasing & local emission & collective pumping\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        gamma_Up = 0.1\n        # Local dephasing\n        for k in range(N):\n            c_ops.append(np.sqrt(gamma_phi) * spin_op(sigma_z, k))\n        # Local emission\n        for k in range(N):\n            c_ops.append(np.sqrt(gamma_down) * spin_op(sigma_m, k))\n        # Collective pumping\n        c_ops.append(np.sqrt(gamma_Up) * Jp)\n        \n    elif case == 4:\n        # Local de-phasing & local emission & collective emission\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        gamma_Down = 0.1\n        # Local dephasing\n        for k in range(N):\n            c_ops.append(np.sqrt(gamma_phi) * spin_op(sigma_z, k))\n        # Local emission\n        for k in range(N):\n            c_ops.append(np.sqrt(gamma_down) * spin_op(sigma_m, k))\n        # Collective emission\n        c_ops.append(np.sqrt(gamma_Down) * Jm)\n    \n    return c_ops\n\ndef solve_steady_state_and_wigner(case):\n    """Solve for steady state and compute Wigner function of cavity."""\n    print(f"\\nCase {case}: Computing steady state...")\n    \n    c_ops = get_collapse_operators(case)\n    print(f"  Number of collapse operators: {len(c_ops)}")\n    \n    # Solve for steady state with robust settings\n    rho_ss = qt.steadystate(H, c_ops, method=\'direct\', solver=\'solve\')\n    print(f"  Steady state found")\n    \n    # Trace out spin degrees of freedom to get cavity state\n    # Trace over all spin indices (1, 2, 3, 4)\n    rho_cavity = rho_ss.ptrace(0)\n    \n    print(f"  Cavity state obtained, dim = {rho_cavity.shape}")\n    print(f"  Trace of cavity state: {rho_cavity.tr():.6f}")\n    \n    a_cav = qt.destroy(n_max)\n    mean_n = qt.expect(a_cav.dag() * a_cav, rho_cavity)\n    print(f"  Mean photon number: {mean_n:.4f}")\n    \n    # Calculate Wigner function\n    print(f"  Computing Wigner function on {len(xvec)}x{len(pvec)} grid...")\n    W = qt.wigner(rho_cavity, xvec, pvec)\n    \n    print(f"  Wigner function computed, shape = {W.shape}")\n    print(f"  Wigner min: {W.min():.6f}, max: {W.max():.6f}")\n    \n    return W\n\n# Process all 4 cases\nfor case in range(1, 5):\n    W = solve_steady_state_and_wigner(case)\n    \n    # Save to CSV\n    filename = f"{case}.csv"\n    np.savetxt(filename, W, delimiter=\',\')\n    print(f"  Saved to {filename}")\n\nprint("\\nAll cases completed!")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
