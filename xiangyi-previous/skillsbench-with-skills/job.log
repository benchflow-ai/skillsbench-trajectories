Sending keys: ['python3 << \'EOF\'\nimport struct\nfrom collections import defaultdict, deque\nimport json\n\n# Parse binary STL\nwith open(\'/root/scan_data.stl\', \'rb\') as f:\n    header = f.read(80)\n    num_triangles = struct.unpack(\'<I\', f.read(4))[0]\n    \n    triangles = []\n    material_ids = []\n    \n    for i in range(num_triangles):\n        normal = struct.unpack(\'<3f\', f.read(12))\n        v1 = struct.unpack(\'<3f\', f.read(12))\n        v2 = struct.unpack(\'<3f\', f.read(12))\n        v3 = struct.unpack(\'<3f\', f.read(12))\n        material_id = struct.unpack(\'<H\', f.read(2))[0]\n        \n        triangles.append((v1, v2, v3))\n        material_ids.append(material_id)\n\n# Build edge-to-triangle adjacency\ndef make_edge_key(v1, v2):\n    return tuple(sorted([v1, v2]))\n\nedge_to_triangles = defaultdict(list)\nfor tri_idx, (v1, v2, v3) in enumerate(triangles):\n    edge_to_triangles[make_edge_key(v1, v2)].append(tri_idx)\n    edge_to_triangles[make_edge_key(v2, v3)].append(tri_idx)\n    edge_to_triangles[make_edge_key(v3, v1)].append(tri_idx)\n\n# Build triangle adjacency graph\ntriangle_neighbors = defaultdict(set)\nfor edge, tri_list in edge_to_triangles.items():\n    for i, tri1 in enumerate(tri_list):\n        for tri2 in tri_list[i+1:]:\n            triangle_neighbors[tri1].add(tri2)\n            triangle_neighbors[tri2].add(tri1)\n\n# Find connected components using BFS\nvisited = set()\ncomponents = []\n\nfor start_tri in range(len(triangles)):\n    if start_tri in visited:\n        continue\n    \n    # BFS to find component\n    component = []\n    queue = deque([start_tri])\n    visited.add(start_tri)\n    \n    while queue:\n        tri_idx = queue.popleft()\n        component.append(tri_idx)\n        \n        for neighbor in triangle_neighbors[tri_idx]:\n            if neighbor not in visited:\n                visited.add(neighbor)\n                queue.append(neighbor)\n    \n    components.append(component)\n\nprint(f"Found {len(components)} connected components")\nfor i, comp in enumerate(components):\n    mat_ids = set(material_ids[t] for t in comp)\n    print(f"Component {i}: {len(comp)} triangles, material IDs: {mat_ids}")\n\n# Find largest component\nlargest_component = max(components, key=len)\nprint(f"\\nLargest component has {len(largest_component)} triangles")\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
