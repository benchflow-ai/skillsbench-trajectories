       for j in range(nb):\n            if Y[i][j] != 0j:\n                sum_yv += Y[i][j] * cmath.rect(Vm[j], Va[j])\n        S = cmath.rect(Vm[i], Va[i]) * sum_yv.conjugate()\n        P_calc = S.real * baseMVA\n        Q_calc = S.imag * baseMVA\n        bus_gens = [g for g in gens if bus_map[g[0]] == i]\n        if bus_gens:\n            Pd = buses[i][2]\n            Qd = buses[i][3]\n            if bus_types[i] == 3:\n                P_gen_req = P_calc + Pd\n                bus_gens[0][1] = P_gen_req\n            if bus_types[i] in [2, 3]:\n                Q_gen_req = Q_calc + Qd\n                bus_gens[0][2] = Q_gen_req\n    return buses, gens, mismatch\n\n# --- Main ---\ndata = json.load(open("network.json"))\nbuses = data[\'bus\']\ngens = data[\'gen\']\nbranches = data[\'branch\']\nbaseMVA = data[\'baseMVA\']\ngencosts = data[\'gencost\']\n\n# ED Logic\ntotal_load = sum(b[2] for b in buses)\ntotal_gen_req = total_load * 1.02\ngen_data = []\nfor i, g in enumerate(gens):\n    cost_entry = gencosts[i]\n    n = int(cost_entry[3])\n    c2, c1, c0 = 0.0, 0.0, 0.0\n    if n >= 3:\n        c2 = cost_entry[4]; c1 = cost_entry[5]; c0 = cost_entry[6]\n    elif n == 2:\n        c1 = cost_entry[4]; c0 = cost_entry[5]\n    gen_data.append({\'id\': i, \'pmin\': g[9], \'pmax\': g[8], \'c2\': c2, \'c1\': c1, \'c0\': c0, \'gen_idx\': i})\n\nis_quadratic = any(g[\'c2\'] > 1e-6 for g in gen_data)\nif is_quadratic:\n    lam_min = min(g[\'c1\'] for g in gen_data)\n    lam_max = max(2*g[\'c2\']*g[\'pmax\'] + g[\'c1\'] for g in gen_data)\n    for _ in range(50):\n        lam = (lam_min + lam_max) / 2\n        p_sum = 0\n        for g in gen_data:\n            if g[\'c2\'] > 1e-6: p = (lam - g[\'c1\']) / (2*g[\'c2\'])\n            else: p = g[\'pmax\'] if lam > g[\'c1\'] else g[\'pmin\']\n            p = max(g[\'pmin\'], min(g[\'pmax\'], p))\n            p_sum += p\n        if abs(p_sum - total_gen_req) < 1e-2: break\n        if p_sum > total_gen_req: lam_max = lam\n        else: lam_min = lam\n    for g in gen_data:\n        if g[\'c2\'] > 1e-6: p = (lam - g[\'c1\']) / (2*g[\'c2\'])\n        else: p = g[\'pmax\'] if lam > g[\'c1\'] else g[\'pmin\']\n        p = max(g[\'pmin\'], min(g[\'pmax\'], p))\n        gens[g[\'gen_idx\']][1] = p\nelse:\n    gen_data.sort(key=lambda x: x[\'c1\'])\n    for g in gen_data:\n        gens[g[\'gen_idx\']][1] = g[\'pmin\']\n    curr_gen = sum(g[\'pmin\'] for g in gen_data)\n    needed = total_gen_req - curr_gen\n    for g in gen_data:\n        if needed <= 0: break\n        avail = g[\'pmax\'] - g[\'pmin\']\n        take = min(avail, needed)\n        gens[g[\'gen_idx\']][1] += take\n        needed -= take\n\nbuses, gens, final_mismatch = run_power_flow(buses, gens, branches, baseMVA)\n\nreport = {}\ntotal_load_mw = sum(b[2] for b in buses)\ntotal_load_mvar = sum(b[3] for b in buses)\ntotal_gen_mw = sum(g[1] for g in gens if g[7]>0)\ntotal_gen_mvar = sum(g[2] for g in gens if g[7]>0)\ntotal_losses = total_gen_mw - total_load_mw\ntotal_cost = 0\nfor i, g in enumerate(gens):\n    if g[7] == 0: continue\n    pg = g[1]\n    cost_entry = gencosts[i]\n    n = int(cost_entry[3])\n    cost = 0\n    if n >= 3: cost = cost_entry[4]*pg**2 + cost_entry[5]*pg + cost_entry[6]\n    elif n == 2: cost = cost_entry[4]*pg + cost_entry[5]\n    total_cost += cost\n\nreport["summary"] = {\n    "total_cost_per_hour": total_cost,\n    "total_load_MW": total_load_mw,\n    "total_load_MVAr": total_load_mvar,\n    "total_generation_MW": total_gen_mw,\n    "total_generation_MVAr": total_gen_mvar,\n    "total_losses_MW": total_losses,\n    "solver_status": "optimal" if final_mismatch < 1e-3 else "failed"\n}\nreport["generators"] = []\nfor i, g in enumerate(gens):\n    report["generators"].append({\n        "id": i+1, "bus": int(g[0]), "pg_MW": g[1], "qg_MVAr": g[2],\n        "pmin_MW": g[9], "pmax_MW": g[8], "qmin_MVAr": g[4], "qmax_MVAr": g[3]\n    })\nreport["buses"] = []\nmax_v_viol = 0\nfor i, b in enumerate(buses):\n    v = b[7]\n    vmin, vmax = b[12], b[11]\n    viol = max(0, vmin - v, v - vmax)\n    max_v_viol = max(max_v_viol, viol)\n    report["buses"].append({\n        "id": int(b[0]), "vm_pu": b[7], "va_deg": b[8], "vmin_pu": b[12], "vmax_pu": b[11]\n    })\nreport["most_loaded_branches"] = []\nbus_map = {b[0]: i for i, b in enumerate(buses)}\nmax_br_overload = 0\nfor br in branches:\n    f, t = br[0], br[1]\n    if f not in bus_map or t not in bus_map: continue\n    i, j = bus_map[f], bus_map[t]\n    if br[10] == 0: continue\n    r, x, b_chg = br[2], br[3], br[4]\n    tap, shift = br[8], br[9]\n    if tap == 0: tap = 1.0\n    tr = tap * cmath.exp(1j * math.radians(shift))\n    z = complex(r, x)\n    y = 1.0 / z\n    bc = complex(0, b_chg / 2.0)\n    Vi = cmath.rect(buses[i][7], math.radians(buses[i][8]))\n    Vj = cmath.rect(buses[j][7], math.radians(buses[j][8]))\n    Yff = (y + bc) / (abs(tr)**2)\n    Yft = -y / tr.conjugate()\n    S_f = Vi * (Yff*Vi + Yft*Vj).conjugate()\n    S_f_mva = abs(S_f) * baseMVA\n    limit = br[5]\n    loading = 0\n    if limit > 0:\n        loading = (S_f_mva / limit) * 100\n        if S_f_mva > limit: max_br_overload = max(max_br_overload, S_f_mva - limit)\n    if loading > 90:\n        report["most_loaded_branches"].append({\n            "from_bus": int(f), "to_bus": int(t), "loading_pct": loading,\n            "flow_from_MVA": S_f_mva, "flow_to_MVA": 0.0, "limit_MVA": limit\n        })\n\nreport["feasibility_check"] = {\n    "max_p_mismatch_MW": final_mismatch * baseMVA,\n    "max_q_mismatch_MVAr": final_mismatch * baseMVA,\n    "max_voltage_violation_pu": max_v_viol,\n    "max_branch_overload_MVA": max_br_overload\n}\n\nwith open("report.json", "w") as f:\n    json.dump(report, f, indent=2)\nprint("Done.")\nEOF\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
