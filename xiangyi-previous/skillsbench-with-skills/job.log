e\'ll tokenize by > and take the segment at \'depth-1\' if it exists\n    \n    candidates = []\n    for path in sub_df[\'category_path\']:\n        parts = [p.strip() for p in path.split(\'>\')]\n        if len(parts) >= depth:\n            candidates.append(parts[depth-1])\n        elif len(parts) > 0:\n            candidates.append(parts[-1]) # Use last part if depth exceeds path\n    \n    if not candidates:\n        return "others"\n\n    counts = Counter(candidates)\n    total = sum(counts.values())\n    most_common = counts.most_common(1)[0]\n    \n    # Rule: representative enough (70%+)\n    if most_common[1] / total >= 0.7:\n        name = most_common[0]\n    else:\n        # Construct name from top words in this cluster\'s paths\n        # Use simple word frequency on the candidates\n        words = []\n        for c in candidates:\n            words.extend(re.findall(r\'\\w+\', c.lower()))\n        \n        # Filter stop words (basic list)\n        stop_words = {\'and\', \'or\', \'the\', \'of\', \'in\', \'for\', \'with\', \'products\', \'supplies\', \'accessories\'}\n        words = [w for w in words if w not in stop_words and len(w) > 2]\n        \n        word_counts = Counter(words)\n        top_words = [w for w, c in word_counts.most_common(3)]\n        \n        # Ensure distinct from parent\n        if parent_name:\n            parent_words = set(re.findall(r\'\\w+\', parent_name.lower()))\n            top_words = [w for w in top_words if w not in parent_words]\n            \n        if not top_words:\n            name = most_common[0] # Fallback\n        else:\n            name = " | ".join(top_words[:3]).title()\n\n    # Clean up name length (max 5 words)\n    name_words = name.split()\n    if len(name_words) > 5:\n        name = " ".join(name_words[:5])\n        \n    # Rule: Sibling distinctness (< 30% overlap) is hard to enforce strictly during generation without context of siblings.\n    # We will assume clustering separates them enough.\n    \n    return name\n\ndef cluster_recursive(indices, current_depth, parent_name=""):\n    if current_depth > 5:\n        return\n\n    current_df = df.iloc[indices]\n    \n    # Determine K (number of clusters)\n    n_samples = len(indices)\n    \n    if n_samples < 10: # Too small to split further\n        # Just assign the parent name or a leaf name to all\n        name = get_cluster_name(current_df, current_depth, parent_name)\n        df.loc[indices, f\'unified_level_{current_depth}\'] = name\n        # Propagate down if needed (or leave None, but task implies full 5 levels)\n        # Let\'s fill remaining levels with the same name to ensure 5-level structure\n        for d in range(current_depth + 1, 6):\n             df.loc[indices, f\'unified_level_{d}\'] = name\n        return\n\n    if current_depth == 1:\n        n_clusters = 15 # Target 10-20\n    else:\n        # Target 3-20, scale with size\n        n_clusters = min(20, max(3, int(n_samples / 50)))\n        # If still too many samples, cap at 20. If too few, min 3.\n        # But if n_samples is really small (e.g. 20), 3 clusters is fine.\n    \n    # Vectorize\n    try:\n        # Use the full path for context\n        tfidf_matrix = vectorizer.fit_transform(current_df[\'clean_path\'])\n        \n        # If n_samples < n_clusters, adjust\n        real_k = min(n_clusters, n_samples)\n        if real_k < 2:\n             name = get_cluster_name(current_df, current_depth, parent_name)\n             df.loc[indices, f\'unified_level_{current_depth}\'] = name\n             for d in range(current_depth + 1, 6):\n                 df.loc[indices, f\'unified_level_{d}\'] = name\n             return\n\n        kmeans = MiniBatchKMeans(n_clusters=real_k, random_state=42, n_init=3)\n        labels = kmeans.fit_predict(tfidf_matrix)\n        \n        # Process each cluster\n        for label in range(real_k):\n            cluster_indices = indices[labels == label]\n            sub_df = df.iloc[cluster_indices]\n            \n            name = get_cluster_name(sub_df, current_depth, parent_name)\n            \n            # Check overlap with parent\n            # (Simple check: if name is same as parent, try to append something or pick 2nd best)\n            if name.lower() == parent_name.lower():\n                name = name + " Sub"\n                \n            df.loc[cluster_indices, f\'unified_level_{current_depth}\'] = name\n            \n            # Recurse\n            cluster_recursive(cluster_indices, current_depth + 1, name)\n            \n    except ValueError as e:\n        # Fallback if vocabulary is empty or other error\n        name = get_cluster_name(current_df, current_depth, parent_name)\n        df.loc[indices, f\'unified_level_{current_depth}\'] = name\n        for d in range(current_depth + 1, 6):\n             df.loc[indices, f\'unified_level_{d}\'] = name\n\nprint("Starting clustering...")\ncluster_recursive(df.index, 1)\nprint("Clustering complete.")\n\n# 4. Output\nimport os\nos.makedirs(\'/root/output/\', exist_ok=True)\n\n# Full Taxonomy\nout_cols = [\'source\', \'category_path\', \'depth\'] + [f\'unified_level_{i}\' for i in range(1, 6)]\n# Calculate depth of original path just for info\ndf[\'depth\'] = df[\'category_path\'].apply(lambda x: len(x.split(\'>\')))\n\ndf[out_cols].to_csv(\'/root/output/unified_taxonomy_full.csv\', index=False)\n\n# Hierarchy\nhierarchy_cols = [f\'unified_level_{i}\' for i in range(1, 6)]\nhierarchy_df = df[hierarchy_cols].drop_duplicates().sort_values(by=hierarchy_cols)\nhierarchy_df.to_csv(\'/root/output/unified_taxonomy_hierarchy.csv\', index=False)\n\nprint("Files saved to /root/output/")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
