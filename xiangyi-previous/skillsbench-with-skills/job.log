Sending keys: ['cat > /root/analyze_fraud.py << \'EOF\'\nimport openpyxl\nimport csv\nimport re\nimport json\nfrom difflib import SequenceMatcher\n\n# Load vendors\nvendors = {}\nvendor_names = {}\nwb = openpyxl.load_workbook(\'/root/vendors.xlsx\')\nws = wb.active\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    vendor_id, name, iban = row\n    vendors[vendor_id] = {\'name\': name, \'iban\': iban}\n    vendor_names[name.lower()] = vendor_id\n\nprint(f"Loaded {len(vendors)} vendors")\n\n# Load purchase orders\npos = {}\nwith open(\'/root/purchase_orders.csv\', \'r\') as f:\n    reader = csv.DictReader(f)\n    for row in reader:\n        pos[row[\'po_number\']] = {\n            \'vendor_id\': row[\'vendor_id\'],\n            \'amount\': float(row[\'amount\'])\n        }\n\nprint(f"Loaded {len(pos)} purchase orders")\n\n# Parse invoices from text\nwith open(\'/root/invoices.txt\', \'r\') as f:\n    content = f.read()\n\n# Split by invoice pages\ninvoice_pattern = r\'Invoice Page (\\d+)\\s+From:\\s*(.+?)\\s+Total\\s*\\$([\\d,.]+)\\s+Payment IBAN:\\s*(\\S+)\\s+PO Number:\\s*(\\S+)\'\nmatches = re.findall(invoice_pattern, content)\n\nprint(f"Found {len(matches)} invoices")\n\ndef fuzzy_match_vendor(name):\n    """Try to match vendor name with fuzzy matching"""\n    name_lower = name.lower().strip()\n    \n    # Exact match first\n    if name_lower in vendor_names:\n        return vendor_names[name_lower]\n    \n    # Fuzzy match\n    best_match = None\n    best_ratio = 0\n    for vname, vid in vendor_names.items():\n        ratio = SequenceMatcher(None, name_lower, vname).ratio()\n        if ratio > best_ratio:\n            best_ratio = ratio\n            best_match = vid\n    \n    # Threshold for fuzzy match (0.85 should catch minor typos)\n    if best_ratio >= 0.85:\n        return best_match\n    return None\n\nfraud_cases = []\n\nfor match in matches:\n    page_num = int(match[0])\n    vendor_name = match[1].strip()\n    amount = float(match[2].replace(\',\', \'\'))\n    iban = match[3].strip()\n    po_number_raw = match[4].strip()\n    \n    # Determine if PO exists in database\n    po_exists = po_number_raw in pos\n    \n    reason = None\n    \n    # Check 1: Unknown Vendor\n    vendor_id = fuzzy_match_vendor(vendor_name)\n    if vendor_id is None:\n        reason = "Unknown Vendor"\n    \n    # Check 2: IBAN Mismatch\n    if reason is None and vendor_id:\n        expected_iban = vendors[vendor_id][\'iban\']\n        if iban != expected_iban:\n            reason = "IBAN Mismatch"\n    \n    # Check 3: Invalid PO\n    if reason is None:\n        if not po_exists:\n            reason = "Invalid PO"\n    \n    # Check 4: Amount Mismatch\n    if reason is None and po_exists:\n        expected_amount = pos[po_number_raw][\'amount\']\n        if abs(amount - expected_amount) > 0.01:\n            reason = "Amount Mismatch"\n    \n    # Check 5: Vendor Mismatch\n    if reason is None and po_exists and vendor_id:\n        expected_vendor_id = pos[po_number_raw][\'vendor_id\']\n        if vendor_id != expected_vendor_id:\n            reason = "Vendor Mismatch"\n    \n    if reason:\n        # Set po_number to null if PO doesn\'t exist in database\n        po_number_output = po_number_raw if po_exists else None\n        \n        fraud_cases.append({\n            "invoice_page_number": page_num,\n            "vendor_name": vendor_name,\n            "invoice_amount": amount,\n            "iban": iban,\n            "po_number": po_number_output,\n            "reason": reason\n        })\n        print(f"Page {page_num}: {reason} - {vendor_name} (PO: {po_number_output})")\n\nprint(f"\\nTotal fraud cases: {len(fraud_cases)}")\n\n# Save to JSON\nwith open(\'/root/fraud_report.json\', \'w\') as f:\n    json.dump(fraud_cases, f, indent=2)\n\nprint("Saved to /root/fraud_report.json")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
