Sending keys: ['cat > /root/export_meshes.py << \'EOF\'\nimport math\nfrom pathlib import Path\nfrom geometry_utils import *\n\noutput_base = Path(\'/root/output\')\npart_meshes_dir = output_base / \'part_meshes\'\nlinks_dir = output_base / \'links\'\n\npart_meshes_dir.mkdir(parents=True, exist_ok=True)\nlinks_dir.mkdir(parents=True, exist_ok=True)\n\n# Store all meshes for each part to create combined links\npart_data = {}\n\ndef add_mesh_to_part(part_name, mesh_name, vertices, faces):\n    if part_name not in part_data:\n        part_data[part_name] = []\n    part_data[part_name].append((vertices, faces))\n    write_obj(part_meshes_dir / part_name / f\'{mesh_name}.obj\', vertices, faces)\n\n# SUPPORT STRUCTURE\nprint("Creating support_structure meshes...")\n\n# Base platform\nvertices, faces = create_box_geometry(20, 2.0, 25)\nvertices = apply_transform(vertices, (0, 1.0, 0))\nadd_mesh_to_part(\'support_structure\', \'base_platform\', vertices, faces)\n\n# Support legs\nleg_params = [\n    (\'support_leg_front_left\', (-7.5, 2.0, 12.5), (0, 35, 2.5)),\n    (\'support_leg_front_right\', (7.5, 2.0, 12.5), (0, 35, 2.5)),\n    (\'support_leg_back_left\', (-7.5, 2.0, -12.5), (0, 35, -2.5)),\n    (\'support_leg_back_right\', (7.5, 2.0, -12.5), (0, 35, -2.5)),\n]\n\nfor leg_name, p1, p2 in leg_params:\n    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\n    length = math.sqrt(dx*dx + dy*dy + dz*dz)\n    vertices, faces = create_cylinder_geometry(0.8, length, 16)\n    mid = (p1[0] + dx/2, p1[1] + dy/2, p1[2] + dz/2)\n    vertices = apply_transform(vertices, mid)\n    add_mesh_to_part(\'support_structure\', leg_name, vertices, faces)\n\n# Cross braces\ncross_brace_params = [\n    (\'cross_brace_front\', (-7.5, 17.5, 12.5), (7.5, 17.5, 12.5)),\n    (\'cross_brace_back\', (-7.5, 17.5, -12.5), (7.5, 17.5, -12.5)),\n    (\'cross_brace_left\', (-7.5, 17.5, 12.5), (-7.5, 17.5, -12.5)),\n    (\'cross_brace_right\', (7.5, 17.5, 12.5), (7.5, 17.5, -12.5)),\n]\n\nfor brace_name, p1, p2 in cross_brace_params:\n    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\n    length = math.sqrt(dx*dx + dy*dy + dz*dz)\n    vertices, faces = create_cylinder_geometry(0.6, length, 16)\n    mid = (p1[0] + dx/2, p1[1] + dy/2, p1[2] + dz/2)\n    vertices = apply_transform(vertices, mid)\n    add_mesh_to_part(\'support_structure\', brace_name, vertices, faces)\n\n# Axle housing\nvertices, faces = create_box_geometry(7.5, 2, 7)\nvertices = apply_transform(vertices, (0, 35, 0))\nadd_mesh_to_part(\'support_structure\', \'axle_housing\', vertices, faces)\n\nprint(f"Created {len(part_data[\'support_structure\'])} meshes for support_structure")\n\n# WHEEL STRUCTURE\nprint("Creating wheel_structure meshes...")\n\n# Central hub\nvertices, faces = create_cylinder_geometry(2, 4, 32)\nvertices = apply_transform(vertices, (0, 35, 0), rotation_x=math.pi/2)\nadd_mesh_to_part(\'wheel_structure\', \'central_hub\', vertices, faces)\n\n# Outer rim\nvertices, faces = create_torus_geometry(30, 1.0, 16, 100)\nvertices = apply_transform(vertices, (0, 35, 0), rotation_z=math.pi/2)\nadd_mesh_to_part(\'wheel_structure\', \'outer_rim\', vertices, faces)\n\n# Spokes\nprint("Creating spokes...")\nfor i in range(32):\n    angle = (i / 32) * 2 * math.pi\n    spoke_y = math.sin(angle) * 30\n    spoke_z = math.cos(angle) * 30\n    \n    # Front spoke\n    p1 = (2, 0, 0)\n    p2 = (0.5, spoke_y, spoke_z)\n    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\n    length = math.sqrt(dx*dx + dy*dy + dz*dz)\n    vertices, faces = create_cylinder_geometry(0.2, length, 8)\n    mid = (p1[0] + dx/2 + 0, p1[1] + dy/2 + 35, p1[2] + dz/2 + 0)\n    vertices = apply_transform(vertices, mid)\n    add_mesh_to_part(\'wheel_structure\', f\'spoke_front_{i}\', vertices, faces)\n    \n    # Back spoke\n    p1 = (-2, 0, 0)\n    p2 = (-0.5, spoke_y, spoke_z)\n    dx, dy, dz = p2[0] - p1[0], p2[1] - p1[1], p2[2] - p1[2]\n    length = math.sqrt(dx*dx + dy*dy + dz*dz)\n    vertices, faces = create_cylinder_geometry(0.2, length, 8)\n    mid = (p1[0] + dx/2 + 0, p1[1] + dy/2 + 35, p1[2] + dz/2 + 0)\n    vertices = apply_transform(vertices, mid)\n    add_mesh_to_part(\'wheel_structure\', f\'spoke_back_{i}\', vertices, faces)\n\nprint("Creating cabins...")\nfor i in range(16):\n    angle = (i / 16) * 2 * math.pi\n    pivot_y = math.sin(angle) * 30 + 35\n    pivot_z = math.cos(angle) * 30\n    \n    # Cabin arm\n    p1 = (0, 0, 0)\n    p2 = (0, -1.5, 0)\n    vertices, faces = create_cylinder_geometry(0.1, 1.5, 8)\n    mid = (0, pivot_y - 0.75, pivot_z)\n    vertices = apply_transform(vertices, mid)\n    add_mesh_to_part(\'wheel_structure\', f\'cabin_arm_{i}\', vertices, faces)\n    \n    # Cabin body\n    vertices, faces = create_cylinder_geometry(1.25, 2.5, 8)\n    vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 1.25, pivot_z))\n    add_mesh_to_part(\'wheel_structure\', f\'cabin_body_{i}\', vertices, faces)\n    \n    # Cabin roof\n    vertices, faces = create_cone_geometry(1.375, 0.5, 8)\n    vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 2.5 + 1.25, pivot_z))\n    add_mesh_to_part(\'wheel_structure\', f\'cabin_roof_{i}\', vertices, faces)\n    \n    # Cabin floor\n    vertices, faces = create_cylinder_geometry(1.25, 0.1, 8)\n    vertices = apply_transform(vertices, (0, pivot_y - 1.5 - 2.5, pivot_z))\n    add_mesh_to_part(\'wheel_structure\', f\'cabin_floor_{i}\', vertices, faces)\n\nprint(f"Created {len(part_data[\'wheel_structure\'])} meshes for wheel_structure")\n\n# Create combined OBJ files for each part (links)\nprint("Creating combined part files...")\nfor part_name, meshes in part_data.items():\n    all_vertices = []\n    all_faces = []\n    vertex_offset = 0\n    \n    for vertices, faces in meshes:\n        all_vertices.extend(vertices)\n        for face in faces:\n            all_faces.append((face[0] + vertex_offset, face[1] + vertex_offset, face[2] + vertex_offset))\n        vertex_offset += len(vertices)\n    \n    write_obj(links_dir / f\'{part_name}.obj\', all_vertices, all_faces)\n\nprint("\\nMesh export complete!")\nprint(f"Part meshes saved to: {part_meshes_dir}")\nprint(f"Part links saved to: {links_dir}")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
