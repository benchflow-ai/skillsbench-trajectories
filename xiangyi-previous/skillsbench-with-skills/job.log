Sending keys: ['cat > /root/fraud_detection_fixed.py << \'EOF\'\nimport pandas as pd\nimport pdfplumber\nimport json\nimport re\nfrom difflib import SequenceMatcher\n\ndef normalize_vendor_name(name):\n    """Normalize vendor name for comparison"""\n    # Convert to lowercase and normalize whitespace\n    normalized = \' \'.join(name.lower().split())\n    \n    # Apply common variations\n    replacements = [\n        (\'limited\', \'ltd\'),\n        (\'incorporated\', \'inc\'),\n        (\'corporation\', \'corp\'),\n        (\'company\', \'co\'),\n    ]\n    \n    # Create variations\n    variations = [normalized]\n    for full, abbr in replacements:\n        if full in normalized:\n            variations.append(normalized.replace(full, abbr))\n        if abbr in normalized:\n            variations.append(normalized.replace(abbr, full))\n    \n    return variations\n\ndef find_vendor_by_name(vendor_name, vendors_df):\n    """Find vendor by fuzzy matching name, return vendor row or None"""\n    # First try exact match (case-insensitive)\n    for idx, row in vendors_df.iterrows():\n        if vendor_name.lower().strip() == row[\'name\'].lower().strip():\n            return row\n    \n    # Then try normalized variations\n    invoice_variations = normalize_vendor_name(vendor_name)\n    \n    for idx, row in vendors_df.iterrows():\n        vendor_variations = normalize_vendor_name(row[\'name\'])\n        \n        # Check if any variation matches\n        for inv_var in invoice_variations:\n            for vend_var in vendor_variations:\n                if inv_var == vend_var:\n                    return row\n                # Also check high similarity for typos\n                ratio = SequenceMatcher(None, inv_var, vend_var).ratio()\n                if ratio >= 0.95:  # Very high threshold for safety\n                    return row\n    \n    return None\n\ndef extract_invoices_from_pdf(pdf_path):\n    """Extract invoice data from PDF"""\n    invoices = []\n    \n    with pdfplumber.open(pdf_path) as pdf:\n        for page_num, page in enumerate(pdf.pages, start=1):\n            text = page.extract_text()\n            \n            # Parse invoice fields\n            vendor_match = re.search(r\'From:\\s*(.+)\', text)\n            amount_match = re.search(r\'Total\\s+\\$([\\d,]+\\.\\d{2})\', text)\n            iban_match = re.search(r\'Payment IBAN:\\s*(.+)\', text)\n            po_match = re.search(r\'PO Number:\\s*(.+)\', text)\n            \n            if vendor_match and amount_match and iban_match:\n                vendor_name = vendor_match.group(1).strip()\n                amount = float(amount_match.group(1).replace(\',\', \'\'))\n                iban = iban_match.group(1).strip()\n                po_number = po_match.group(1).strip() if po_match else None\n                \n                invoices.append({\n                    \'page_number\': page_num,\n                    \'vendor_name\': vendor_name,\n                    \'amount\': amount,\n                    \'iban\': iban,\n                    \'po_number\': po_number\n                })\n    \n    return invoices\n\ndef detect_fraud(invoices, vendors_df, pos_df):\n    """Detect fraudulent invoices based on criteria"""\n    fraudulent = []\n    \n    for invoice in invoices:\n        fraud_reason = None\n        \n        # Criterion 1: Unknown Vendor\n        vendor = find_vendor_by_name(invoice[\'vendor_name\'], vendors_df)\n        if vendor is None:\n            fraud_reason = "Unknown Vendor"\n        \n        # Criterion 2: IBAN Mismatch (only if vendor exists)\n        elif invoice[\'iban\'] != vendor[\'iban\']:\n            fraud_reason = "IBAN Mismatch"\n        \n        # Check PO-related criteria only if we have a PO number\n        elif invoice[\'po_number\'] is not None:\n            po = pos_df[pos_df[\'po_number\'] == invoice[\'po_number\']]\n            \n            # Criterion 3: Invalid PO\n            if po.empty:\n                fraud_reason = "Invalid PO"\n            else:\n                po_row = po.iloc[0]\n                \n                # Criterion 4: Amount Mismatch\n                if abs(invoice[\'amount\'] - po_row[\'amount\']) > 0.01:\n                    fraud_reason = "Amount Mismatch"\n                \n                # Criterion 5: Vendor Mismatch\n                elif vendor[\'id\'] != po_row[\'vendor_id\']:\n                    fraud_reason = "Vendor Mismatch"\n        \n        # Add to fraudulent list if any criterion matched\n        if fraud_reason:\n            fraudulent.append({\n                \'invoice_page_number\': invoice[\'page_number\'],\n                \'vendor_name\': invoice[\'vendor_name\'],\n                \'invoice_amount\': invoice[\'amount\'],\n                \'iban\': invoice[\'iban\'],\n                \'po_number\': invoice[\'po_number\'],\n                \'reason\': fraud_reason\n            })\n    \n    return fraudulent\n\n# Main execution\nif __name__ == \'__main__\':\n    # Load data\n    vendors_df = pd.read_excel(\'/root/vendors.xlsx\')\n    pos_df = pd.read_csv(\'/root/purchase_orders.csv\')\n    \n    # Extract invoices\n    print("Extracting invoices from PDF...")\n    invoices = extract_invoices_from_pdf(\'/root/invoices.pdf\')\n    print(f"Extracted {len(invoices)} invoices")\n    \n    # Detect fraud\n    print("Detecting fraud...")\n    fraudulent_invoices = detect_fraud(invoices, vendors_df, pos_df)\n    print(f"Found {len(fraudulent_invoices)} fraudulent invoices")\n    \n    # Save report\n    with open(\'/root/fraud_report.json\', \'w\') as f:\n        json.dump(fraudulent_invoices, f, indent=2)\n    \n    print("Fraud report saved to /root/fraud_report.json")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
