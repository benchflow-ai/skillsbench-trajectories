Sending keys: ['cat << \'EOF\' > /root/calculate_mass.py\nimport struct\nimport collections\n\ndef solve():\n    with open(\'/root/scan_data.stl\', \'rb\') as f:\n        header = f.read(80)\n        num_triangles_raw = f.read(4)\n        if not num_triangles_raw:\n            return\n        num_triangles = struct.unpack(\'<I\', num_triangles_raw)[0]\n        \n        triangles = []\n        for i in range(num_triangles):\n            data = f.read(50)\n            if len(data) < 50:\n                break\n            # Normal (3 floats), V1, V2, V3 (each 3 floats), Attribute (1 uint16)\n            parts = struct.unpack(\'<ffffffffffffH\', data)\n            normal = parts[0:3]\n            v1 = parts[3:6]\n            v2 = parts[6:9]\n            v3 = parts[9:12]\n            attr = parts[12]\n            triangles.append({\'v1\': v1, \'v2\': v2, \'v3\': v3, \'attr\': attr, \'id\': i})\n\n    # Build connectivity graph\n    # Use vertices as keys to find triangles sharing them\n    vertex_to_triangles = collections.defaultdict(list)\n    for i, tri in enumerate(triangles):\n        for v in [tri[\'v1\'], tri[\'v2\'], tri[\'v3\']]:\n            vertex_to_triangles[tuple(v)].append(i)\n\n    adj = collections.defaultdict(set)\n    for tri_indices in vertex_to_triangles.values():\n        for i in tri_indices:\n            for j in tri_indices:\n                if i != j:\n                    adj[i].add(j)\n\n    # Find connected components\n    visited = [False] * num_triangles\n    components = []\n    for i in range(num_triangles):\n        if not visited[i]:\n            comp = []\n            stack = [i]\n            visited[i] = True\n            while stack:\n                u = stack.pop()\n                comp.append(u)\n                for v in adj[u]:\n                    if not visited[v]:\n                        visited[v] = True\n                        stack.append(v)\n            components.append(comp)\n\n    # Identify the largest component (by number of triangles)\n    largest_comp_indices = max(components, key=len)\n    \n    # Calculate volume of the largest component\n    # Volume = sum of signed volume of tetrahedra (origin to triangle)\n    # Volume = (1/6) * |sum(v1 . (v2 x v3))|\n    total_volume = 0.0\n    material_ids = []\n    for idx in largest_comp_indices:\n        tri = triangles[idx]\n        v1, v2, v3 = tri[\'v1\'], tri[\'v2\'], tri[\'v3\']\n        # Signed volume of tetrahedron formed by origin and triangle\n        # cross product v2 x v3\n        cp_x = v2[1] * v3[2] - v2[2] * v3[1]\n        cp_y = v2[2] * v3[0] - v2[0] * v3[2]\n        cp_z = v2[0] * v3[1] - v2[1] * v3[0]\n        # dot product v1 . (v2 x v3)\n        vol = (v1[0] * cp_x + v1[1] * cp_y + v1[2] * cp_z) / 6.0\n        total_volume += vol\n        material_ids.append(tri[\'attr\'])\n\n    total_volume = abs(total_volume)\n    # Assuming the most frequent material ID in the component is the correct one\n    material_id = collections.Counter(material_ids).most_common(1)[0][0]\n\n    # Density table\n    densities = {\n        1: 0.10,\n        10: 7.85,\n        25: 2.70,\n        42: 5.55,\n        99: 11.34\n    }\n    \n    density = densities.get(material_id, 0.0)\n    # Assuming STL units are in cm. If they were mm, we\'d need to divide volume by 1000.\n    # Given the task description, let\'s check if the volume seems reasonable for cm.\n    # If the mass is huge or tiny, we might need to reconsider.\n    # Usually, STL is in mm. Let\'s assume mm and see. \n    # Wait, the note says \'Ensure volume is in cm^3 and density is in g/cm^3\'.\n    # If the STL is in mm, Vol_cm3 = Vol_mm3 / 1000.\n    # Let\'s look at the coordinates.\n    \n    # For now, let\'s assume the coordinates are already in cm.\n    # If the results are expected in g, and the density is g/cm^3, then mass = volume * density.\n    \n    mass = total_volume * density\n\n    import json\n    result = {\n        "main_part_mass": round(mass, 2),\n        "material_id": material_id\n    }\n    print(json.dumps(result, indent=1))\n\nsolve()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
