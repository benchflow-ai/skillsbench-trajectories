Sending keys: ["cat << 'EOF' > convert.js\nimport * as THREE from 'three';\nimport { createScene } from './data/object.js';\nimport fs from 'fs';\nimport path from 'path';\n\nfunction getGeometryData(mesh) {\n    const geometry = mesh.geometry;\n    mesh.updateMatrix();\n    const matrix = mesh.matrix;\n    \n    const vertices = [];\n    const indices = [];\n    \n    const posAttr = geometry.attributes.position;\n    const v = new THREE.Vector3();\n    \n    for (let i = 0; i < posAttr.count; i++) {\n        v.fromBufferAttribute(posAttr, i);\n        v.applyMatrix4(matrix);\n        vertices.push(v.x, v.y, v.z);\n    }\n    \n    if (geometry.index) {\n        for (let i = 0; i < geometry.index.count; i++) {\n            indices.push(geometry.index.getX(i));\n        }\n    } else {\n        for (let i = 0; i < posAttr.count; i++) {\n            indices.push(i);\n        }\n    }\n    \n    return { vertices, indices, name: mesh.name };\n}\n\nfunction savePart(group) {\n    const partName = group.name;\n    const meshes = group.children.filter(c => c.isMesh);\n    if (meshes.length === 0) return;\n\n    const partDir = path.join('/root/output/part_meshes', partName);\n    if (!fs.existsSync(partDir)) fs.mkdirSync(partDir, { recursive: true });\n    \n    let linkVertices = [];\n    let linkIndices = [];\n    let vertexOffset = 0;\n\n    meshes.forEach(mesh => {\n        const data = getGeometryData(mesh);\n        \n        // Save individual mesh\n        let meshObj = `o ${data.name}\\n`;\n        for (let i = 0; i < data.vertices.length; i += 3) {\n            meshObj += `v ${data.vertices[i]} ${data.vertices[i+1]} ${data.vertices[i+2]}\\n`;\n        }\n        for (let i = 0; i < data.indices.length; i += 3) {\n            meshObj += `f ${data.indices[i] + 1} ${data.indices[i+1] + 1} ${data.indices[i+2] + 1}\\n`;\n        }\n        fs.writeFileSync(path.join(partDir, mesh.name + '.obj'), meshObj);\n\n        // Accumulate for link\n        linkVertices.push(...data.vertices);\n        for (let i = 0; i < data.indices.length; i++) {\n            linkIndices.push(data.indices[i] + vertexOffset);\n        }\n        vertexOffset += data.vertices.length / 3;\n    });\n\n    // Save link mesh\n    let linkObj = `o ${partName}\\n`;\n    for (let i = 0; i < linkVertices.length; i += 3) {\n        linkObj += `v ${linkVertices[i]} ${linkVertices[i+1]} ${linkVertices[i+2]}\\n`;\n    }\n    for (let i = 0; i < linkIndices.length; i += 3) {\n        linkObj += `f ${linkIndices[i] + 1} ${linkIndices[i+1] + 1} ${linkIndices[i+2] + 1}\\n`;\n    }\n    fs.writeFileSync(path.join('/root/output/links', partName + '.obj'), linkObj);\n}\n\ntry {\n    const root = createScene();\n    \n    function traverse(node) {\n        if (node.isGroup) {\n            savePart(node);\n        }\n        node.children.forEach(child => {\n            if (child.isGroup) traverse(child);\n        });\n    }\n\n    traverse(root);\n    console.log('Conversion complete.');\n} catch (error) {\n    console.error('Error during conversion:', error);\n    process.exit(1);\n}\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
