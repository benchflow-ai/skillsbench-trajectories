Sending keys: ['python3 - <<\'PY\'\nimport os, re\nfrom PIL import Image\nimport pytesseract\nfrom datetime import datetime\nimport openpyxl\n\nimg_dir = \'/app/workspace/dataset/img\'\nfiles = sorted([f for f in os.listdir(img_dir) if f.lower().endswith((\'.png\',\'.jpg\',\'.jpeg\',\'.tif\',\'.tiff\'))])\n\npat1 = re.compile(r\'(\\d{4})[\\-/\\.](\\d{1,2})[\\-/\\.](\\d{1,2})\')\npat2 = re.compile(r\'(\\d{1,2})[\\-/\\.](\\d{1,2})[\\-/\\.](\\d{2,4})\')\n\npriority_keywords = [\n    \'GRAND TOTAL\',\n    \'TOTAL RM\', \'TOTAL: RM\',\n    \'TOTAL AMOUNT\',\n    \'TOTAL\', \'AMOUNT\', \'TOTAL DUE\', \'AMOUNT DUE\', \'BALANCE DUE\', \'NETT TOTAL\', \'NET TOTAL\'\n]\nexclude_keywords = [\'SUBTOTAL\',\'SUB TOTAL\',\'TAX\',\'GST\',\'SST\',\'DISCOUNT\',\'CHANGE\',\'CASH TENDERED\']\n\nnum_pat = re.compile(r\'\\b\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})\\b|\\b\\d+\\.\\d{2}\\b\')\n\ndef extract_date(text):\n    for m in pat1.finditer(text):\n        y,mn,d = m.group(1), m.group(2), m.group(3)\n        try:\n            dt = datetime(int(y), int(mn), int(d))\n            return dt.strftime(\'%Y-%m-%d\')\n        except Exception:\n            continue\n    for m in pat2.finditer(text):\n        d,mn,y = m.group(1), m.group(2), m.group(3)\n        if len(y)==2:\n            y = \'20\'+y\n        try:\n            dt = datetime(int(y), int(mn), int(d))\n            return dt.strftime(\'%Y-%m-%d\')\n        except Exception:\n            continue\n    return None\n\n\ndef extract_total(lines):\n    up_lines = [ln.upper() for ln in lines]\n    def find_num(ln):\n        nums = num_pat.findall(ln)\n        if nums:\n            return nums[-1]\n        return None\n    for key in priority_keywords:\n        for i,ln in enumerate(up_lines):\n            if key in ln:\n                if any(ex in ln for ex in exclude_keywords):\n                    continue\n                num = find_num(ln)\n                if num:\n                    return num\n                if i+1 < len(up_lines):\n                    num = find_num(up_lines[i+1])\n                    if num:\n                        return num\n    for ln in reversed(up_lines):\n        if any(ex in ln for ex in exclude_keywords):\n            continue\n        num = find_num(ln)\n        if num:\n            return num\n    return None\n\nrows=[]\nfor f in files:\n    path = os.path.join(img_dir,f)\n    img = Image.open(path)\n    text = pytesseract.image_to_string(img)\n    lines = [ln.strip() for ln in text.splitlines() if ln.strip()]\n    date = extract_date(text)\n    total = extract_total(lines)\n    if total:\n        total = total.replace(\',\',\'\')\n        try:\n            total = f"{float(total):.2f}"\n        except Exception:\n            total = None\n    rows.append((f, date, total))\n\n# write excel\nwb = openpyxl.Workbook()\nws = wb.active\nws.title = \'results\'\nws.append([\'filename\',\'date\',\'total_amount\'])\nfor row in rows:\n    ws.append(list(row))\noutput = \'/app/workspace/stat_ocr.xlsx\'\nwb.save(output)\nprint(\'wrote\', output)\nPY\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
