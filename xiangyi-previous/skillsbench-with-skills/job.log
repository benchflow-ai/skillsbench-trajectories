Sending keys: ['python3 << \'ENDSCRIPT\'\nimport pandas as pd\nimport json\n\nmes = pd.read_csv(\'/app/data/mes_log.csv\')\n\n# From handbook product matrix:\n# 8-zone ovens (8Z_IR+Conv, 8Z_Convection): STD LENGTH CM/MIN = 60-80, so min = 60\n# 10-zone ovens (10Z_Convection): STD LENGTH CM/MIN = 70-100, so min = 70\n\n# Mapping oven model to minimum speed\noven_min_speed = {\n    \'8Z_IR+Conv\': 60.0,\n    \'8Z_Convection\': 60.0,\n    \'10Z_Convection\': 70.0\n}\n\nresults = []\n\nfor _, row in mes.iterrows():\n    run_id = row[\'run_id\']\n    oven_model = row[\'oven_model\']\n    actual_speed = row[\'conveyor_speed_cm_min\']\n    \n    min_speed = oven_min_speed.get(oven_model)\n    \n    if min_speed is None:\n        meets = False\n    else:\n        meets = actual_speed >= min_speed\n    \n    results.append({\n        \'run_id\': run_id,\n        \'required_min_speed_cm_min\': min_speed,\n        \'actual_speed_cm_min\': round(actual_speed, 2),\n        \'meets\': meets\n    })\n\n# Sort by run_id\nresults = sorted(results, key=lambda x: x[\'run_id\'])\n\nprint(json.dumps(results[:15], indent=2))\n\n# Count meets/doesn\'t meet\nmeets_count = sum(1 for r in results if r[\'meets\'])\nprint(f"\\nMeets requirement: {meets_count}, Doesn\'t meet: {len(results) - meets_count}")\n\n# Save to file\nwith open(\'/app/output/q04.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint("\\nSaved to /app/output/q04.json")\nENDSCRIPT\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
