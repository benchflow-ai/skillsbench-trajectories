Sending keys: ['cat << \'EOF\' > solution.py\nimport os\nimport re\nimport pytesseract\nfrom PIL import Image, ImageOps, ImageEnhance\nfrom openpyxl import Workbook\nfrom datetime import datetime\n\ndef preprocess_image(img):\n    # Convert to grayscale\n    img = img.convert(\'L\')\n    # Increase contrast\n    enhancer = ImageEnhance.Contrast(img)\n    img = enhancer.enhance(2.0)\n    return img\n\ndef extract_date(text):\n    # Look for dates in various formats\n    # DD-MM-YYYY, DD/MM/YYYY, YYYY-MM-DD, YYYY/MM/DD, DD.MM.YYYY\n    patterns = [\n        r\'(\\d{1,2})[-/.](\\d{1,2})[-/.](\\d{4})\',\n        r\'(\\d{4})[-/.](\\d{1,2})[-/.](\\d{1,2})\'\n    ]\n    for pattern in patterns:\n        matches = re.finditer(pattern, text)\n        for match in matches:\n            g = match.groups()\n            try:\n                if len(g[0]) == 4:\n                    y, m, d = int(g[0]), int(g[1]), int(g[2])\n                else:\n                    d, m, y = int(g[0]), int(g[1]), int(g[2])\n                \n                # Basic validation\n                if 1 <= m <= 12 and 1 <= d <= 31 and 1900 <= y <= 2100:\n                    return f"{y:04d}-{m:02d}-{d:02d}"\n            except ValueError:\n                continue\n    return None\n\ndef extract_total_amount(text):\n    lines = text.split(\'\\n\')\n    lines = [line.strip() for line in lines if line.strip()]\n    \n    keywords_priority = [\n        r\'GRAND\\s*TOTAL\',\n        r\'TOTAL\\s*RM\',\n        r\'TOTAL:\\s*RM\',\n        r\'TOTAL\\s*AMOUNT\',\n        r\'TOTAL\', r\'AMOUNT\', r\'TOTAL\\s*DUE\', r\'AMOUNT\\s*DUE\', r\'BALANCE\\s*DUE\', r\'NETT\\s*TOTAL\', r\'NET\\s*TOTAL\'\n    ]\n    \n    exclusion_keywords = [\'SUBTOTAL\', \'SUB TOTAL\', \'TAX\', \'GST\', \'SST\', \'DISCOUNT\', \'CHANGE\', \'CASH TENDERED\']\n    \n    def get_amount_from_line(line):\n        # Look for something like 1,234.56 or 1234.56 or 1234 . 56\n        # Sometimes OCR puts spaces around the dot\n        match = re.findall(r\'\\d{1,3}(?:[ ,]\\d{3})*[ .]+\\d{2}\', line)\n        if match:\n            # Take the last one, clean it\n            amt_str = match[-1]\n            amt_str = amt_str.replace(\',\', \'\').replace(\' \', \'\')\n            # If there are multiple dots, take the last one\n            if amt_str.count(\'.\') > 1:\n                parts = amt_str.split(\'.\')\n                amt_str = "".join(parts[:-1]) + "." + parts[-1]\n            return amt_str\n        return None\n\n    for kw_pattern in keywords_priority:\n        for i, line in enumerate(lines):\n            if re.search(kw_pattern, line, re.IGNORECASE):\n                # Check exclusion\n                skip = False\n                for ex in exclusion_keywords:\n                    if re.search(ex, line, re.IGNORECASE):\n                        # If the keyword is \'TOTAL\' but line contains \'SUBTOTAL\', skip if kw is \'TOTAL\'\n                        if kw_pattern in [r\'TOTAL\', r\'AMOUNT\']:\n                            skip = True\n                            break\n                if skip: continue\n\n                amount = get_amount_from_line(line)\n                if amount:\n                    return amount\n                # Fallback to next line\n                if i + 1 < len(lines):\n                    amount = get_amount_from_line(lines[i+1])\n                    if amount:\n                        return amount\n    \n    # Fallback: just look for the largest amount at the end of the text?\n    # No, stick to the keywords first.\n    return None\n\nimg_dir = \'/app/workspace/dataset/img\'\nfiles = sorted([f for f in os.listdir(img_dir) if f.endswith(\'.jpg\')])\n\nresults = []\nfor filename in files:\n    img_path = os.path.join(img_dir, filename)\n    try:\n        img = Image.open(img_path)\n        text = pytesseract.image_to_string(img)\n        date = extract_date(text)\n        amount = extract_total_amount(text)\n        \n        # If not found, try with preprocessed image\n        if not date or not amount:\n            text_p = pytesseract.image_to_string(preprocess_image(img))\n            if not date: date = extract_date(text_p)\n            if not amount: amount = extract_total_amount(text_p)\n\n        if amount:\n            try:\n                amount = "{:.2f}".format(float(amount))\n            except:\n                amount = None\n        results.append((filename, date, amount))\n        print(f"{filename}: {date}, {amount}")\n    except Exception as e:\n        print(f"Error processing {filename}: {e}")\n        results.append((filename, None, None))\n\nwb = Workbook()\nws = wb.active\nws.title = "results"\nws.append(["filename", "date", "total_amount"])\nfor res in results:\n    ws.append(res)\n\nwb.save(\'/app/workspace/stat_ocr.xlsx\')\nEOF\npython3 solution.py\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
