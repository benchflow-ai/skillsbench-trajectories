Sending keys: ['python3 << \'EOF\'\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\nimport statistics\n\nwb = openpyxl.load_workbook(\'/root/gdp.xlsx\')\ndata_sheet = wb[\'Data\']\ntask_sheet = wb[\'Task\']\n\ndef get_data_value(series_code, year):\n    """Simulate INDEX/MATCH: find value in Data sheet"""\n    for row in range(1, 100):\n        if data_sheet.cell(row, 2).value == series_code:\n            for col in range(1, 20):\n                if data_sheet.cell(4, col).value == year:\n                    return data_sheet.cell(row, col).value\n    return None\n\nprint("=== Calculating and Populating All Values ===")\n\n# Years are 2019, 2020, 2021, 2022, 2023 (columns H-L)\nyears = [2019, 2020, 2021, 2022, 2023]\n\n# Populate Exports data (rows 12-17)\nprint("\\nPopulating Exports data...")\nexports_data = {}  # Store for later use\nfor row in range(12, 18):\n    series_code = task_sheet.cell(row, 4).value\n    exports_data[row] = {}\n    for col_idx, col in enumerate(range(8, 13)):\n        year = years[col_idx]\n        value = get_data_value(series_code, year)\n        col_letter = get_column_letter(col)\n        # Keep the formula, don\'t overwrite it\n        # task_sheet[f"{col_letter}{row}"].value = value\n        exports_data[row][col] = value\n        print(f"  {col_letter}{row}: {value}")\n\n# Populate Imports data (rows 19-24)\nprint("\\nPopulating Imports data...")\nimports_data = {}\nfor row in range(19, 25):\n    series_code = task_sheet.cell(row, 4).value\n    imports_data[row] = {}\n    for col_idx, col in enumerate(range(8, 13)):\n        year = years[col_idx]\n        value = get_data_value(series_code, year)\n        col_letter = get_column_letter(col)\n        imports_data[row][col] = value\n        print(f"  {col_letter}{row}: {value}")\n\n# Populate GDP data (rows 26-31)\nprint("\\nPopulating GDP data...")\ngdp_data = {}\nfor row in range(26, 32):\n    series_code = task_sheet.cell(row, 4).value\n    gdp_data[row] = {}\n    for col_idx, col in enumerate(range(8, 13)):\n        year = years[col_idx]\n        value = get_data_value(series_code, year)\n        col_letter = get_column_letter(col)\n        gdp_data[row][col] = value\n        print(f"  {col_letter}{row}: {value}")\n\n# Calculate Net Exports % of GDP (rows 35-40)\nprint("\\nCalculating Net Exports % of GDP...")\nnet_exports_data = {}\nfor row in range(35, 41):\n    exports_row = row - 23\n    imports_row = row - 16\n    gdp_row = row - 9\n    net_exports_data[row] = {}\n    \n    for col in range(8, 13):\n        exp = exports_data[exports_row].get(col)\n        imp = imports_data[imports_row].get(col)\n        gdp = gdp_data[gdp_row].get(col)\n        \n        if exp is not None and imp is not None and gdp is not None:\n            net_exp_pct = (exp - imp) / gdp * 100\n            net_exports_data[row][col] = net_exp_pct\n            col_letter = get_column_letter(col)\n            print(f"  {col_letter}{row}: ({exp:.2f} - {imp:.2f}) / {gdp:.2f} * 100 = {net_exp_pct:.4f}")\n\n# Calculate statistics for each year\nprint("\\nCalculating statistics...")\nstats = {}\nfor col in range(8, 13):\n    col_letter = get_column_letter(col)\n    values = [net_exports_data[row][col] for row in range(35, 41)]\n    stats[col] = {\n        \'min\': min(values),\n        \'max\': max(values),\n        \'median\': statistics.median(values),\n        \'mean\': statistics.mean(values),\n        \'p25\': sorted(values)[int(len(values)*0.25)],\n        \'p75\': sorted(values)[int(len(values)*0.75)]\n    }\n    print(f"\\n{col_letter} (Year {years[col-8]}):")\n    print(f"  Min: {stats[col][\'min\']:.4f}")\n    print(f"  Max: {stats[col][\'max\']:.4f}")\n    print(f"  Median: {stats[col][\'median\']:.4f}")\n    print(f"  Mean: {stats[col][\'mean\']:.4f}")\n    print(f"  25th percentile: {stats[col][\'p25\']:.4f}")\n    print(f"  75th percentile: {stats[col][\'p75\']:.4f}")\n\n# Calculate weighted mean for each year\nprint("\\nCalculating weighted mean...")\nweighted_means = {}\nfor col in range(8, 13):\n    col_letter = get_column_letter(col)\n    numerator = sum(net_exports_data[row][col] * gdp_data[row+9][col] for row in range(35, 41))\n    denominator = sum(gdp_data[row][col] for row in range(26, 32))\n    weighted_mean = numerator / denominator\n    weighted_means[col] = weighted_mean\n    print(f"  {col_letter}50 (Year {years[col-8]}): {weighted_mean:.6f}")\n\nwb.close()\nprint("\\nAll calculations complete!")\nEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
