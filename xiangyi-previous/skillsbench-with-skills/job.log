Sending keys: ['cat << \'EOF\' > /root/calculate_mass.py\nimport struct\nimport collections\nimport json\n\ndef solve():\n    with open(\'/root/scan_data.stl\', \'rb\') as f:\n        f.read(84)\n        triangles = []\n        while True:\n            data = f.read(50)\n            if len(data) < 50: break\n            parts = struct.unpack(\'<ffffffffffffH\', data)\n            v1, v2, v3 = parts[3:6], parts[6:9], parts[9:12]\n            triangles.append({\'v1\': v1, \'v2\': v2, \'v3\': v3, \'attr\': parts[12]})\n\n    vertex_to_triangles = collections.defaultdict(list)\n    for i, tri in enumerate(triangles):\n        for v in [tri[\'v1\'], tri[\'v2\'], tri[\'v3\']]:\n            vertex_to_triangles[tuple(v)].append(i)\n    adj = collections.defaultdict(set)\n    for tri_indices in vertex_to_triangles.values():\n        for i in tri_indices: \n            for j in tri_indices: \n                if i != j: adj[i].add(j)\n    visited = [False] * len(triangles)\n    components = []\n    for i in range(len(triangles)):\n        if not visited[i]:\n            comp = []; stack = [i]; visited[i] = True\n            while stack:\n                u = stack.pop(); comp.append(u)\n                for v in adj[u]:\n                    if not visited[v]: visited[v] = True; stack.append(v)\n            components.append(comp)\n\n    largest_comp_indices = max(components, key=len)\n    total_volume_mm3 = 0.0\n    material_ids = []\n    for idx in largest_comp_indices:\n        tri = triangles[idx]\n        v1, v2, v3 = tri[\'v1\'], tri[\'v2\'], tri[\'v3\']\n        total_volume_mm3 += (v1[0]*(v2[1]*v3[2]-v2[2]*v3[1]) + v1[1]*(v2[2]*v3[0]-v2[0]*v3[2]) + v1[2]*(v2[0]*v3[1]-v2[1]*v3[0])) / 6.0\n        material_ids.append(tri[\'attr\'])\n\n    total_volume_cm3 = abs(total_volume_mm3) / 1000.0\n    material_id = collections.Counter(material_ids).most_common(1)[0][0]\n    densities = {1: 0.10, 10: 7.85, 25: 2.70, 42: 5.55, 99: 11.34}\n    mass = total_volume_cm3 * densities[material_id]\n\n    result = {\n        "main_part_mass": mass,\n        "material_id": material_id\n    }\n    with open(\'/root/mass_report.json\', \'w\') as f:\n        json.dump(result, f, indent=1)\n    print(json.dumps(result, indent=1))\nsolve()\nEOF\npython3 /root/calculate_mass.py\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
