Sending keys: ['cat >> /root/Tokenizer.scala << \'EOF\'\n\nclass WhitespaceTokenizer(\n  lowercase: Boolean = false,\n  minLength: Int = 0,\n  maxLength: Option[Int] = None,\n  stripPunctuation: Boolean = false\n) {\n  private val punctuation: Set[Char] = ".,!?;:\'\\"()[]{}".toSet\n\n  private def processToken(word: String): Option[String] = {\n    var processed = word\n    if (stripPunctuation) {\n      processed = processed.dropWhile(punctuation).reverse.dropWhile(punctuation).reverse\n    }\n    if (lowercase) processed = processed.toLowerCase\n    if (processed.length < minLength) return None\n    processed = maxLength.filter(_ < processed.length).fold(processed)(processed.take)\n    if (processed.isEmpty) None else Some(processed)\n  }\n\n  def tokenize(text: String): List[Token] = {\n    text.split("\\\\s+").filter(_.nonEmpty).zipWithIndex.flatMap { case (word, i) =>\n      processToken(word).map { processed =>\n        Token(processed, TokenType.String, Map("position" -> i, "original" -> word))\n      }\n    }.toList\n  }\n\n  def tokenizeToStrings(text: String): List[String] = tokenize(text).map(_.value)\n\n  def tokenizeWithPositions(text: String): List[(String, Int, Int)] = {\n    val result = mutable.ListBuffer[(String, Int, Int)]()\n    var currentPos = 0\n    for (word <- text.split("\\\\s+").filter(_.nonEmpty)) {\n      val start = text.indexOf(word, currentPos)\n      val end = start + word.length\n      processToken(word).foreach(p => result += ((p, start, end)))\n      currentPos = end\n    }\n    result.toList\n  }\n\n  def countTokens(text: String): Int = tokenize(text).length\n}\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
