Sending keys: ['cat > /app/analysis_part3.py << \'EOF\'\nimport pandas as pd\nimport numpy as np\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\nprint("=" * 60)\nprint("STEP 3: FEATURE ENGINEERING")\nprint("=" * 60)\n\nsurvey_df = pd.read_pickle(\'/app/output/survey_clean.pkl\')\nsurvey_fe = pd.DataFrame()\nsurvey_fe[\'Survey ResponseID\'] = survey_df[\'Survey ResponseID\']\n\n# Age encoding\nage_map = {\'18 - 24 years\': 1, \'25 - 34 years\': 2, \'35 - 44 years\': 3,\n           \'45 - 54 years\': 4, \'55 - 64 years\': 5, \'65 and older\': 6}\nsurvey_fe[\'age_group\'] = survey_df[\'Q-demos-age\'].map(age_map).fillna(0).astype(int)\n\n# Income encoding\nincome_map = {\'Less than $25,000\': 1, \'$25,000 - $49,999\': 2, \'$50,000 - $74,999\': 3,\n              \'$75,000 - $99,999\': 4, \'$100,000 - $149,999\': 5, \'$150,000 or more\': 6}\nsurvey_fe[\'income_level\'] = survey_df[\'Q-demos-income\'].map(income_map).fillna(0).astype(int)\n\n# Education encoding\nedu_map = {\'Some high school or less\': 1, \'High school diploma or GED\': 2,\n           \'Some college, no degree\': 3, \'Associate degree\': 4,\n           "Bachelor\'s degree": 5,\n           \'Graduate or professional degree (MA, MS, MBA, PhD, JD, MD, DDS, etc)\': 6}\nsurvey_fe[\'education_level\'] = survey_df[\'Q-demos-education\'].map(edu_map).fillna(0).astype(int)\n\n# Gender\nsurvey_fe[\'is_female\'] = (survey_df[\'Q-demos-gender\'].str.lower().str.contains(\'female\', na=False)).astype(int)\nsurvey_fe[\'is_male\'] = (survey_df[\'Q-demos-gender\'].str.lower() == \'male\').astype(int)\n\n# Hispanic\nsurvey_fe[\'is_hispanic\'] = (survey_df[\'Q-demos-hispanic\'].str.lower() == \'yes\').astype(int)\n\n# Race dummies\nfor race in [\'White\', \'Black\', \'Asian\', \'Other\']:\n    survey_fe[f\'race_{race.lower()}\'] = survey_df[\'Q-demos-race\'].str.contains(race, case=False, na=False).astype(int)\n\n# Sexual orientation\nsurvey_fe[\'is_lgbtq\'] = survey_df[\'Q-sexual-orientation\'].str.contains(\'LGBTQ\', case=False, na=False).astype(int)\nsurvey_fe[\'is_heterosexual\'] = survey_df[\'Q-sexual-orientation\'].str.contains(\'straight|heterosexual\', case=False, na=False).astype(int)\n\nprint(f"Feature engineered data shape: {survey_fe.shape}")\nprint(f"Features: {list(survey_fe.columns)}")\nsurvey_fe.to_csv(\'/app/output/survey_feature_engineered.csv\', index=False)\nprint("Saved: survey_feature_engineered.csv")\nsurvey_fe.to_pickle(\'/app/output/survey_fe.pkl\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
