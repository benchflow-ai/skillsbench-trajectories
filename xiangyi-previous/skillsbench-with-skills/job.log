Sending keys: ['cat > /app/solution.py << \'EOF\'\nimport re\nimport json\n\ndef parse_script(text: str):\n    """Parse dialogue script into graph structure with nodes and edges."""\n    nodes = []\n    edges = []\n    node_ids = set()\n    \n    # Split into sections by [NodeId]\n    sections = re.split(r\'\\n(?=\\[)\', text.strip())\n    \n    for section in sections:\n        if not section.strip():\n            continue\n            \n        lines = section.strip().split(\'\\n\')\n        if not lines:\n            continue\n            \n        # Parse header [NodeId]\n        header_match = re.match(r\'\\[([^\\]]+)\\]\', lines[0])\n        if not header_match:\n            continue\n            \n        node_id = header_match.group(1)\n        node_ids.add(node_id)\n        \n        # Parse content lines\n        content_lines = [l.strip() for l in lines[1:] if l.strip()]\n        \n        if not content_lines:\n            # Empty node\n            nodes.append({\n                "id": node_id,\n                "text": "",\n                "speaker": "",\n                "type": "line"\n            })\n            continue\n        \n        # Check if it\'s a choice node (starts with numbered options)\n        first_line = content_lines[0]\n        is_choice_node = bool(re.match(r\'^\\d+\\.\', first_line))\n        \n        if is_choice_node:\n            # Choice node - collect all choices\n            choice_texts = []\n            for line in content_lines:\n                choice_match = re.match(r\'^\\d+\\.\\s*(.+?)\\s*->\\s*(\\S+)\\s*$\', line)\n                if choice_match:\n                    choice_text = choice_match.group(1).strip()\n                    target = choice_match.group(2).strip()\n                    choice_texts.append(choice_text)\n                    edges.append({\n                        "from": node_id,\n                        "to": target,\n                        "text": choice_text\n                    })\n            \n            nodes.append({\n                "id": node_id,\n                "text": "\\n".join(choice_texts),\n                "speaker": "",\n                "type": "choice"\n            })\n        else:\n            # Line node - Speaker: text -> target\n            # Combine all content lines\n            full_content = \' \'.join(content_lines)\n            \n            # Parse Speaker: text -> target\n            line_match = re.match(r\'^([^:]+):\\s*(.+?)\\s*->\\s*(\\S+)\\s*$\', full_content)\n            if line_match:\n                speaker = line_match.group(1).strip()\n                text_content = line_match.group(2).strip()\n                target = line_match.group(3).strip()\n                \n                nodes.append({\n                    "id": node_id,\n                    "text": text_content,\n                    "speaker": speaker,\n                    "type": "line"\n                })\n                \n                edges.append({\n                    "from": node_id,\n                    "to": target,\n                    "text": ""\n                })\n            else:\n                # Fallback - just store the text\n                nodes.append({\n                    "id": node_id,\n                    "text": full_content,\n                    "speaker": "",\n                    "type": "line"\n                })\n    \n    # Add End node if referenced but not defined\n    edge_targets = {e["to"] for e in edges}\n    if "End" in edge_targets and "End" not in node_ids:\n        nodes.append({\n            "id": "End",\n            "text": "",\n            "speaker": "",\n            "type": "line"\n        })\n        node_ids.add("End")\n    \n    return {"nodes": nodes, "edges": edges}\n\n\ndef generate_dot(graph):\n    """Generate DOT format visualization."""\n    dot_lines = ["digraph dialogue {"]\n    dot_lines.append("    rankdir=TB;")\n    dot_lines.append("    node [shape=box];")\n    \n    # Add nodes\n    for node in graph["nodes"]:\n        node_id = node["id"]\n        label = node_id\n        if node["speaker"]:\n            label = f"{node[\'speaker\']}: {node[\'text\'][:30]}..."\n        elif node["text"]:\n            label = node["text"][:40]\n        if node["type"] == "choice":\n            label = f"[CHOICE] {node_id}"\n        # Escape quotes in label\n        label = label.replace(\'"\', \'\\\\"\').replace(\'\\n\', \' \')\n        shape = "diamond" if node["type"] == "choice" else "box"\n        dot_lines.append(f\'    "{node_id}" [label="{label}" shape={shape}];\')\n    \n    # Add edges\n    for edge in graph["edges"]:\n        edge_label = edge["text"][:20] if edge["text"] else ""\n        edge_label = edge_label.replace(\'"\', \'\\\\"\')\n        if edge_label:\n            dot_lines.append(f\'    "{edge["from"]}" -> "{edge["to"]}" [label="{edge_label}"];\')\n        else:\n            dot_lines.append(f\'    "{edge["from"]}" -> "{edge["to"]}";\')\n    \n    dot_lines.append("}")\n    return "\\n".join(dot_lines)\n\n\ndef validate_graph(graph):\n    """Validate graph constraints."""\n    node_ids = {n["id"] for n in graph["nodes"]}\n    edge_targets = {e["to"] for e in graph["edges"]}\n    \n    # Check all edge targets exist (except special cases)\n    missing = edge_targets - node_ids\n    if missing:\n        print(f"Warning: Missing target nodes: {missing}")\n    \n    # Check reachability from first node\n    if graph["nodes"]:\n        first_node = graph["nodes"][0]["id"]\n        reachable = set()\n        to_visit = [first_node]\n        while to_visit:\n            current = to_visit.pop()\n            if current in reachable:\n                continue\n            reachable.add(current)\n            for edge in graph["edges"]:\n                if edge["from"] == current and edge["to"] not in reachable:\n                    to_visit.append(edge["to"])\n        \n        unreachable = node_ids - reachable\n        if unreachable:\n            print(f"Warning: Unreachable nodes: {unreachable}")\n    \n    return True\n\n\nif __name__ == "__main__":\n    # Read input\n    with open("/app/script.txt", "r") as f:\n        script_content = f.read()\n    \n    # Parse\n    graph = parse_script(script_content)\n    \n    # Validate\n    validate_graph(graph)\n    \n    # Write JSON output\n    with open("/app/dialogue.json", "w") as f:\n        json.dump(graph, f, indent=2)\n    \n    # Write DOT output\n    dot_content = generate_dot(graph)\n    with open("/app/dialogue.dot", "w") as f:\n        f.write(dot_content)\n    \n    print(f"Parsed {len(graph[\'nodes\'])} nodes and {len(graph[\'edges\'])} edges")\n    print("Output written to /app/dialogue.json and /app/dialogue.dot")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
