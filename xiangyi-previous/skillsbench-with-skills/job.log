let endHour = parseInt(timeMatch[4]);\n    const endMin = timeMatch[5] ? parseInt(timeMatch[5]) : 0;\n    const endPeriod = timeMatch[6].toLowerCase();\n    \n    if (startPeriod === 'pm' && startHour !== 12) startHour += 12;\n    if (startPeriod === 'am' && startHour === 12) startHour = 0;\n    if (endPeriod === 'pm' && endHour !== 12) endHour += 12;\n    if (endPeriod === 'am' && endHour === 12) endHour = 0;\n    \n    constraints.timeStart = { hour: startHour, minute: startMin };\n    constraints.timeEnd = { hour: endHour, minute: endMin };\n  }\n  \n  return constraints;\n}\n\nfunction formatTime(date) {\n  let hours = date.getHours();\n  const minutes = date.getMinutes();\n  const ampm = hours >= 12 ? 'PM' : 'AM';\n  hours = hours % 12 || 12;\n  const minutesStr = minutes.toString().padStart(2, '0');\n  return `${hours.toString().padStart(2, '0')}:${minutesStr} ${ampm}`;\n}\n\nfunction formatDate(date) {\n  const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];\n  const months = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December'];\n  \n  const dayName = days[date.getDay()];\n  const month = months[date.getMonth()];\n  const day = date.getDate().toString().padStart(2, '0');\n  const year = date.getFullYear();\n  \n  return `${dayName}, ${month} ${day}, ${year}`;\n}\n\nfunction createEmailMessage(to, subject, body) {\n  const headers = [\n    `To: ${to}`,\n    `Subject: ${subject}`,\n    'Content-Type: text/plain; charset=utf-8',\n    ''\n  ];\n  \n  const message = headers.join('\\r\\n') + body;\n  return Buffer.from(message)\n    .toString('base64')\n    .replace(/\\+/g, '-')\n    .replace(/\\//g, '_')\n    .replace(/=+$/, '');\n}\n\nasync function sendEmail(to, subject, body) {\n  try {\n    const encodedMessage = createEmailMessage(to, subject, body);\n    const result = await gmail.users.messages.send({\n      userId: 'me',\n      requestBody: {\n        raw: encodedMessage\n      }\n    });\n    return result.data.id;\n  } catch (error) {\n    console.error('Error sending email:', error.message);\n    return null;\n  }\n}\n\nasync function main() {\n  const requests = JSON.parse(fs.readFileSync('/root/test_input.json', 'utf-8'));\n  const results = { sent_results: [] };\n  \n  for (const request of requests) {\n    const { email_text, from_email } = request;\n    \n    console.log(`\\nProcessing request from ${from_email}`);\n    \n    const constraints = parseMeetingRequest(email_text);\n    console.log('Constraints:', JSON.stringify(constraints, null, 2));\n    \n    if (constraints.dates && constraints.dates.length > 0 && constraints.timeStart) {\n      const startDate = constraints.dates[0];\n      const startTime = new Date(startDate);\n      startTime.setHours(constraints.timeStart.hour, constraints.timeStart.minute, 0, 0);\n      \n      const endTime = new Date(startTime);\n      const durationHours = constraints.durationHours || 1;\n      endTime.setHours(startTime.getHours() + Math.floor(durationHours));\n      endTime.setMinutes(startTime.getMinutes() + (durationHours % 1) * 60);\n      \n      const timeRange = `${formatTime(startTime)} - ${formatTime(endTime)}`;\n      \n      const emailBody = `Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: ${formatDate(startTime)}\\nTime: ${timeRange}\\nDuration: ${durationHours} hour(s)\\n\\nIf this time doesn't work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench`;\n      \n      console.log('\\nSending email...');\n      const messageId = await sendEmail(from_email, 'Re: Meeting Request', emailBody);\n      \n      if (messageId) {\n        console.log(`Email sent successfully. Message ID: ${messageId}`);\n        results.sent_results.push({ messageId });\n      } else {\n        console.log('Failed to send email');\n      }\n    } else {\n      console.log('Could not parse meeting constraints');\n    }\n  }\n  \n  fs.writeFileSync('/root/results.json', JSON.stringify(results, null, 2));\n  console.log('\\nResults saved to /root/results.json');\n  console.log(JSON.stringify(results, null, 2));\n}\n\nmain().catch(console.error);\nEOF\n"] min_timeout_sec: 0.5 max_timeout_sec: 180.0
