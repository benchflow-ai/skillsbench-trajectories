Calculate required width - estimate based on character count\n    # Use a generous width to ensure single line\n    # We\'ll use almost full slide width with some margin\n    new_width = slide_width - Inches(0.5)  # Leave 0.25" margin on each side\n    \n    # Center horizontally\n    new_left = (slide_width - new_width) / 2\n    \n    # Position at bottom center\n    new_top = slide_height - bottom_margin - box_height\n    \n    # Update shape position and size\n    shape.left = int(new_left)\n    shape.top = int(new_top)\n    shape.width = int(new_width)\n    shape.height = int(box_height)\n    \n    # Format the text\n    for para in shape.text_frame.paragraphs:\n        para.alignment = PP_ALIGN.CENTER\n        for run in para.runs:\n            run.font.name = font_name\n            run.font.size = font_size\n            run.font.color.rgb = font_color\n            run.font.bold = False\n        \n        # Also set paragraph-level font properties in case there are no runs\n        if para.font:\n            para.font.name = font_name\n            para.font.size = font_size\n            para.font.color.rgb = font_color\n            para.font.bold = False\n\nprint("\\nFormatted all dangling paper titles")\n\n# Create a new Reference slide at the end\n# Use a blank layout or title and content layout\nslide_layouts = prs.slide_layouts\n\n# Find a suitable layout (Title and Content or similar)\n# Layout index 1 is typically "Title and Content"\nlayout = None\nfor sl in slide_layouts:\n    if \'Title and Content\' in sl.name or \'title and content\' in sl.name.lower():\n        layout = sl\n        break\nif layout is None:\n    # Try to get layout index 1 (usually Title and Content)\n    layout = slide_layouts[1] if len(slide_layouts) > 1 else slide_layouts[0]\n\nprint(f"Using layout: {layout.name}")\n\n# Add new slide\nref_slide = prs.slides.add_slide(layout)\n\n# Set the title and find content placeholder\ntitle_set = False\ncontent_shape = None\n\nfor shape in ref_slide.shapes:\n    if not shape.has_text_frame:\n        continue\n    if hasattr(shape, \'placeholder_format\') and shape.placeholder_format is not None:\n        ph_type = shape.placeholder_format.type\n        print(f"  Found placeholder: {shape.name}, type={ph_type}")\n        \n        # Check for title placeholder\n        if ph_type == PP_PLACEHOLDER.TITLE or ph_type == PP_PLACEHOLDER.CENTER_TITLE:\n            shape.text_frame.paragraphs[0].text = "Reference"\n            title_set = True\n            print("Set Reference title")\n        # Check for body/content placeholder\n        elif ph_type == PP_PLACEHOLDER.BODY or ph_type == PP_PLACEHOLDER.OBJECT:\n            content_shape = shape\n\nif content_shape:\n    tf = content_shape.text_frame\n    tf.clear()  # Clear existing content\n    \n    for i, title in enumerate(unique_titles):\n        if i == 0:\n            p = tf.paragraphs[0]\n        else:\n            p = tf.add_paragraph()\n        p.text = f"{i + 1}. {title}"\n        p.level = 0\n    \n    print(f"Added {len(unique_titles)} references to the slide")\nelse:\n    print("Warning: Could not find content placeholder, creating text box")\n    # Create a text box for references\n    left = Inches(0.5)\n    top = Inches(1.5)\n    width = slide_width - Inches(1)\n    height = Inches(5)\n    \n    txBox = ref_slide.shapes.add_textbox(left, top, width, height)\n    tf = txBox.text_frame\n    tf.word_wrap = True\n    \n    for i, title in enumerate(unique_titles):\n        if i == 0:\n            p = tf.paragraphs[0]\n        else:\n            p = tf.add_paragraph()\n        p.text = f"{i + 1}. {title}"\n    \n    print(f"Added {len(unique_titles)} references in text box")\n\n# Save the presentation\noutput_path = \'/root/Awesome-Agent-Papers_processed.pptx\'\nprs.save(output_path)\nprint(f"\\nSaved processed presentation to: {output_path}")\nENDSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
