Sending keys: ['python3 << \'EOF\'\nimport struct\nimport json\nimport math\nfrom collections import defaultdict\n\n# Read binary STL file\nwith open(\'/root/scan_data.stl\', \'rb\') as f:\n    data = f.read()\n\nnum_triangles = struct.unpack(\'<I\', data[80:84])[0]\n\n# Parse all triangles\ntriangles = []\noffset = 84\nfor i in range(num_triangles):\n    normal = struct.unpack(\'<3f\', data[offset:offset+12])\n    v1 = struct.unpack(\'<3f\', data[offset+12:offset+24])\n    v2 = struct.unpack(\'<3f\', data[offset+24:offset+36])\n    v3 = struct.unpack(\'<3f\', data[offset+36:offset+48])\n    attr = struct.unpack(\'<H\', data[offset+48:offset+50])[0]\n    triangles.append({\'vertices\': [v1, v2, v3], \'material_id\': attr, \'normal\': normal})\n    offset += 50\n\n# Get only material 42 triangles (the main part)\nmain_triangles = [t for t in triangles if t[\'material_id\'] == 42]\nprint(f"Main part triangles: {len(main_triangles)}")\n\n# Calculate signed volume\ndef signed_volume_of_triangle(v1, v2, v3):\n    return (v1[0]*(v2[1]*v3[2] - v2[2]*v3[1]) + \n            v1[1]*(v2[2]*v3[0] - v2[0]*v3[2]) + \n            v1[2]*(v2[0]*v3[1] - v2[1]*v3[0])) / 6.0\n\ntotal_volume = 0.0\nfor t in main_triangles:\n    v1, v2, v3 = t[\'vertices\']\n    total_volume += signed_volume_of_triangle(v1, v2, v3)\n\nvolume = abs(total_volume)\nprint(f"Volume: {volume} cm³")\nprint(f"Expected cylinder volume (r=10, h=20): {math.pi * 100 * 20}")\n\n# Mass calculation\ndensity = 5.55  # Unobtanium\nmass = volume * density\nprint(f"Mass: {mass} g")\nprint(f"Rounded: {round(mass, 2)} g")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
