Sending keys: ['cat << \'EOF\' > optimize_dbscan.py\nimport pandas as pd\nimport numpy as np\nfrom sklearn.cluster import DBSCAN\nfrom scipy.spatial.distance import cdist\nfrom multiprocessing import Pool\n\ndef load_data():\n    citsci = pd.read_csv(\'/root/data/citsci_train.csv\', usecols=[\'file_rad\', \'x\', \'y\'])\n    expert = pd.read_csv(\'/root/data/expert_train.csv\', usecols=[\'file_rad\', \'x\', \'y\'])\n    return citsci, expert\n\ndef greedy_match(cluster_centroids, expert_points, max_dist=100):\n    if len(cluster_centroids) == 0 or len(expert_points) == 0:\n        return 0, []\n    dists = cdist(cluster_centroids, expert_points, metric=\'euclidean\')\n    matched_expert_indices = set()\n    matched_cluster_indices = set()\n    matches = []\n    flat_dists = []\n    for i in range(len(cluster_centroids)):\n        for j in range(len(expert_points)):\n            if dists[i, j] <= max_dist:\n                flat_dists.append((dists[i, j], i, j))\n    flat_dists.sort()\n    for d, i, j in flat_dists:\n        if i not in matched_cluster_indices and j not in matched_expert_indices:\n            matched_cluster_indices.add(i)\n            matched_expert_indices.add(j)\n            matches.append(d)\n    return len(matches), matches\n\ndef evaluate_image(citsci_points, expert_points, min_samples, epsilon, shape_weight):\n    if len(citsci_points) == 0:\n        return 0.0, np.nan\n    # Scaled coordinates for custom DBSCAN distance metric\n    # d(a, b) = sqrt((w * dx)^2 + ((2 - w) * dy)^2)\n    scaled_citsci = citsci_points.copy()\n    scaled_citsci[:, 0] *= shape_weight\n    scaled_citsci[:, 1] *= (2 - shape_weight)\n    \n    db = DBSCAN(eps=epsilon, min_samples=min_samples, metric=\'euclidean\').fit(scaled_citsci)\n    labels = db.labels_\n    unique_labels = set(labels) - {-1}\n    cluster_centroids = []\n    for label in unique_labels:\n        cluster_centroids.append(citsci_points[labels == label].mean(axis=0))\n    cluster_centroids = np.array(cluster_centroids)\n    num_matches, matches = greedy_match(cluster_centroids, expert_points)\n    precision = num_matches / len(cluster_centroids) if len(cluster_centroids) > 0 else 0\n    recall = num_matches / len(expert_points) if len(expert_points) > 0 else 0\n    f1 = 2 * precision * recall / (precision + recall) if (precision + recall) > 0 else 0\n    delta = np.mean(matches) if len(matches) > 0 else np.nan\n    return f1, delta\n\ndef run_search(params):\n    ms, eps, sw, citsci_grouped, expert_grouped, all_expert_files = params\n    f1_scores = []\n    deltas = []\n    for file_rad in all_expert_files:\n        c_pts = citsci_grouped.get(file_rad, np.empty((0, 2)))\n        e_pts = expert_grouped.get(file_rad, np.empty((0, 2)))\n        f1, delta = evaluate_image(c_pts, e_pts, ms, eps, sw)\n        f1_scores.append(f1)\n        if not np.isnan(delta):\n            deltas.append(delta)\n    return (np.mean(f1_scores), np.mean(deltas) if deltas else np.nan, ms, eps, sw)\n\nif __name__ == \'__main__\':\n    citsci, expert = load_data()\n    citsci_grouped = {n: g[[\'x\', \'y\']].values for n, g in citsci.groupby(\'file_rad\')}\n    expert_grouped = {n: g[[\'x\', \'y\']].values for n, g in expert.groupby(\'file_rad\')}\n    all_expert_files = sorted(expert[\'file_rad\'].unique())\n    param_grid = [(ms, eps, round(sw, 1), citsci_grouped, expert_grouped, all_expert_files)\n                  for ms in range(3, 10)\n                  for eps in range(4, 25, 2)\n                  for sw in np.arange(0.9, 1.95, 0.1)]\n    with Pool() as pool:\n        results = pool.map(run_search, param_grid)\n    filtered = [r for r in results if r[0] > 0.5]\n    if filtered:\n        costs = np.array([(r[0], r[1]) for r in filtered])\n        is_efficient = np.ones(costs.shape[0], dtype=bool)\n        for i, c in enumerate(costs):\n            if is_efficient[i]:\n                dominated = ((costs[:, 0] >= c[0]) & (costs[:, 1] <= c[1])) & ((costs[:, 0] > c[0]) | (costs[:, 1] < c[1]))\n                if np.any(dominated): is_efficient[i] = False\n        pareto = [filtered[i] for i in range(len(filtered)) if is_efficient[i]]\n        pareto.sort(key=lambda x: (-x[0], x[1]))\n        with open(\'/root/pareto_frontier.csv\', \'w\') as f:\n            f.write("F1,delta,min_samples,epsilon,shape_weight\\n")\n            for r in pareto:\n                f.write(f"{r[0]:.5f},{r[1]:.5f},{r[2]},{r[3]},{r[4]:.1f}\\n")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
