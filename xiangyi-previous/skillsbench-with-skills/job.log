Sending keys: ['cat << \'EOF\' > /root/process_taxonomy.py\nimport pandas as pd\nimport re\nfrom collections import Counter\nimport numpy as np\n\ndef clean_name(name):\n    if not name: return ""\n    name = name.lower().replace(\'&\', \'and\').replace(\',\', \' \')\n    name = re.sub(r\'[^a-z0-9\\s]\', \' \', name)\n    words = name.split()\n    return words[:5]\n\ndef format_name(words):\n    return " | ".join(words)\n\ndef get_overlap(w1, w2):\n    if not w1 or not w2: return 0\n    intersection = set(w1).intersection(set(w2))\n    return len(intersection) / min(len(w1), len(w2))\n\n# Loading data\nfiles = {\n    \'amazon\': \'/root/data/amazon_product_categories.csv\',\n    \'facebook\': \'/root/data/fb_product_categories.csv\',\n    \'google\': \'/root/data/google_shopping_product_categories.csv\'\n}\n\nall_paths = []\nfor source, path in files.items():\n    df = pd.read_csv(path)\n    for cat_path in df[\'category_path\'].dropna().unique():\n        all_paths.append({\'source\': source, \'path\': cat_path, \'parts\': [p.strip() for p in cat_path.split(\'>\') if p.strip()]})\n\n# L1 Mapping\nl1_mapping = {\n    \'apparel | accessories | fashion\': [\'clothing\', \'apparel\', \'shoes\', \'jewelry\', \'watches\', \'fashion\', \'accessories\', \'luggage\', \'bags\', \'eyewear\'],\n    \'electronics | computers | tech\': [\'electronics\', \'computers\', \'software\', \'camera\', \'phones\', \'video games\', \'audio\', \'mobile\'],\n    \'home | garden | kitchen\': [\'home\', \'kitchen\', \'garden\', \'furniture\', \'patio\', \'appliances\', \'decor\', \'bedding\', \'bath\'],\n    \'beauty | personal | care\': [\'beauty\', \'personal care\', \'fragrance\', \'makeup\', \'hair care\', \'skin care\'],\n    \'health | wellness | medical\': [\'health\', \'wellness\', \'medical\', \'vitamins\', \'supplements\', \'first aid\'],\n    \'sports | outdoors | fitness\': [\'sports\', \'outdoors\', \'fitness\', \'recreation\', \'exercise\', \'cycling\', \'camping\'],\n    \'toys | games | hobbies\': [\'toys\', \'games\', \'hobbies\', \'collectibles\', \'puzzles\', \'dolls\'],\n    \'arts | crafts | diy\': [\'arts\', \'crafts\', \'diy\', \'sewing\', \'painting\', \'scrapbooking\'],\n    \'automotive | vehicles | parts\': [\'automotive\', \'vehicles\', \'parts\', \'tires\', \'car care\'],\n    \'food | beverage | grocery\': [\'food\', \'beverage\', \'grocery\', \'gourmet\', \'drinks\', \'cooking\'],\n    \'pet | supplies | animals\': [\'pet\', \'animals\', \'animal\', \'dog\', \'cat\', \'bird\', \'fish\'],\n    \'office | business | industrial\': [\'office\', \'business\', \'industrial\', \'scientific\', \'supplies\', \'stationery\'],\n    \'media | books | entertainment\': [\'books\', \'movies\', \'music\', \'media\', \'instruments\', \'dvds\'],\n    \'baby | kids | maternity\': [\'baby\', \'kids\', \'maternity\', \'children\', \'toddler\', \'nursery\'],\n    \'tools | hardware | building\': [\'tools\', \'hardware\', \'building\', \'electrical\', \'plumbing\', \'construction\']\n}\n\ndef assign_l1(parts):\n    full_path = " ".join(parts).lower()\n    for l1, keywords in l1_mapping.items():\n        if any(kw in full_path for kw in keywords):\n            return l1\n    return \'general | miscellaneous | other\'\n\nfor item in all_paths:\n    item[\'l1\'] = assign_l1(item[\'parts\'])\n\n# Function to group children into 3-20 groups\ndef group_children(children_list, level_idx):\n    # children_list is a list of (original_parts, source, original_path)\n    if not children_list:\n        return {}\n    \n    # Extract the name at level_idx if available\n    groups = {}\n    for parts, source, path in children_list:\n        name_parts = clean_name(parts[level_idx]) if level_idx < len(parts) else ["general"]\n        name = " ".join(name_parts)\n        if name not in groups:\n            groups[name] = []\n        groups[name].append((parts, source, path))\n    \n    if 3 <= len(groups) <= 20:\n        return groups\n    \n    if len(groups) < 3:\n        # Too few groups, try to split by the next level if available\n        new_groups = {}\n        for name, items in groups.items():\n            if level_idx + 1 < max(len(it[0]) for it in items):\n                subgroups = group_children(items, level_idx + 1)\n                for subname, subitems in subgroups.items():\n                    combined_name = f"{name} {subname}"\n                    new_groups[combined_name] = subitems\n            else:\n                new_groups[name] = items\n        if 3 <= len(new_groups) <= 20:\n            return new_groups\n        groups = new_groups # Keep whatever we got\n\n    if len(groups) > 20:\n        # Too many groups, cluster them by common words\n        sorted_groups = sorted(groups.items(), key=lambda x: len(x[1]), reverse=True)\n        top_groups = sorted_groups[:19]\n        others = []\n        for _, items in sorted_groups[19:]:\n            others.extend(items)\n        \n        final_groups = {name: items for name, items in top_groups}\n        if others:\n            final_groups[\'other | miscellaneous\'] = others\n        return final_groups\n    \n    return groups\n\n# Recursive building of the taxonomy\nresults = []\n\nl1_groups = {}\nfor item in all_paths:\n    l1 = item[\'l1\']\n    if l1 not in l1_groups:\n        l1_groups[l1] = []\n    l1_groups[l1].append((item[\'parts\'], item[\'source\'], item[\'path\']))\n\nfor l1_name, l1_items in l1_groups.items():\n    l2_groups = group_children(l1_items, 1)\n    for l2_name, l2_items in l2_groups.items():\n        l3_groups = group_children(l2_items, 2)\n        for l3_name, l3_items in l3_groups.items():\n            l4_groups = group_children(l3_items, 3)\n            for l4_name, l4_items in l4_groups.items():\n                l5_groups = group_children(l4_items, 4)\n                for l5_name, l5_items in l5_groups.items():\n                    for parts, source, path in l5_items:\n                        results.append({\n                            \'source\': source,\n                            \'category_path\': path,\n                            \'depth\': min(len(parts), 5),\n                            \'unified_level_1\': l1_name,\n                            \'unified_level_2\': format_name(clean_name(l2_name)),\n                            \'unified_level_3\': format_name(clean_name(l3_name)),\n                            \'unified_level_4\': format_name(clean_name(l4_name)),\n                            \'unified_level_5\': format_name(clean_name(l5_name))\n                        })\n\n# Final cleaning and overlap check\ndef fix_overlap(row):\n    levels = [row[f\'unified_level_{i}\'] for i in range(1, 6)]\n    new_levels = [levels[0]]\n    for i in range(1, 5):\n        curr = set(levels[i].split(" | "))\n        prev = set(new_levels[i-1].split(" | "))\n        if not curr.difference(prev):\n            # Full overlap, add a suffix\n            new_levels.append(levels[i] + " | sub")\n        else:\n            # Remove overlapping words\n            diff = [w for w in levels[i].split(" | ") if w not in prev]\n            if not diff:\n                 new_levels.append(levels[i] + " | sub")\n            else:\n                 new_levels.append(" | ".join(diff[:5]))\n    return new_levels\n\nfinal_rows = []\nfor r in results:\n    fixed = fix_overlap(r)\n    for i in range(5):\n        r[f\'unified_level_{i+1}\'] = fixed[i]\n    final_rows.append(r)\n\ndf_final = pd.DataFrame(final_rows)\ndf_final.to_csv(\'/root/output/unified_taxonomy_full.csv\', index=False)\ndf_hierarchy = df_final[[\'unified_level_1\', \'unified_level_2\', \'unified_level_3\', \'unified_level_4\', \'unified_level_5\']].drop_duplicates()\ndf_hierarchy.to_csv(\'/root/output/unified_taxonomy_hierarchy.csv\', index=False)\nprint("Processing complete.")\nEOF\npython3 /root/process_taxonomy.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
