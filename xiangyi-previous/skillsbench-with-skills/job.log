if needed\n        station_st_copy = station_st.copy()\n        for tr in station_st_copy:\n            if tr.stats.sampling_rate != 100.0:\n                tr.resample(100.0)\n        \n        # Get 3-component data (try different channel naming conventions)\n        z_tr = None\n        n_tr = None\n        e_tr = None\n        \n        for tr in station_st_copy:\n            ch = tr.stats.channel\n            if ch[-1] == \'Z\':\n                z_tr = tr\n            elif ch[-1] == \'N\':\n                n_tr = tr\n            elif ch[-1] == \'E\':\n                e_tr = tr\n        \n        if z_tr is None:\n            print(f"  No Z component for {station_id}, skipping")\n            continue\n            \n        # Use Z component for picking (most reliable)\n        data = z_tr.data\n        \n        # Normalize\n        data = data.astype(np.float32)\n        data = (data - np.mean(data)) / (np.std(data) + 1e-10)\n        \n        # Pad or trim to appropriate length\n        # PhaseNet expects 3001 samples (30 seconds at 100 Hz)\n        target_len = 3001\n        if len(data) < target_len:\n            data = np.pad(data, (0, target_len - len(data)), \'constant\')\n        \n        # Process in windows\n        window_size = 3001\n        step_size = 1500  # 50% overlap\n        \n        for i in range(0, len(data) - window_size + 1, step_size):\n            window_data = data[i:i+window_size]\n            \n            # Create 3-channel input (duplicate Z if N/E not available)\n            if n_tr is not None and e_tr is not None:\n                n_data = n_tr.data[i:i+window_size].astype(np.float32)\n                e_data = e_tr.data[i:i+window_size].astype(np.float32)\n                n_data = (n_data - np.mean(n_data)) / (np.std(n_data) + 1e-10)\n                e_data = (e_data - np.mean(e_data)) / (np.std(e_data) + 1e-10)\n                input_data = np.array([window_data, n_data, e_data])\n            else:\n                input_data = np.array([window_data, window_data, window_data])\n            \n            # Add batch dimension\n            input_data = input_data[np.newaxis, :, :]\n            \n            # Run model\n            predictions = model.annotate(input_data)\n            \n            # Extract P and S picks (using threshold)\n            p_prob = predictions[0, 1, :]  # P wave probability\n            s_prob = predictions[0, 2, :]  # S wave probability\n            \n            threshold = 0.5\n            \n            # Find peaks in P probability\n            p_peaks = []\n            for j in range(1, len(p_prob) - 1):\n                if p_prob[j] > threshold and p_prob[j] > p_prob[j-1] and p_prob[j] > p_prob[j+1]:\n                    p_peaks.append((j, p_prob[j]))\n            \n            # Find peaks in S probability\n            s_peaks = []\n            for j in range(1, len(s_prob) - 1):\n                if s_prob[j] > threshold and s_prob[j] > s_prob[j-1] and s_prob[j] > s_prob[j+1]:\n                    s_peaks.append((j, s_prob[j]))\n            \n            # Convert to absolute time\n            window_start_time = z_tr.stats.starttime + (i / z_tr.stats.sampling_rate)\n            \n            for peak_idx, prob in p_peaks:\n                pick_time = window_start_time + (peak_idx / 100.0)  # 100 Hz\n                all_picks.append({\n                    \'station\': station_id,\n                    \'time\': pick_time,\n                    \'phase\': \'P\',\n                    \'probability\': prob\n                })\n            \n            for peak_idx, prob in s_peaks:\n                pick_time = window_start_time + (peak_idx / 100.0)\n                all_picks.append({\n                    \'station\': station_id,\n                    \'time\': pick_time,\n                    \'phase\': \'S\',\n                    \'probability\': prob\n                })\n        \n    except Exception as e:\n        print(f"  Error processing {station_id}: {e}")\n        continue\n\nprint(f"\\nTotal picks: {len(all_picks)}")\npicks_df = pd.DataFrame(all_picks)\nprint(f"P picks: {len(picks_df[picks_df[\'phase\'] == \'P\'])}")\nprint(f"S picks: {len(picks_df[picks_df[\'phase\'] == \'S\'])}")\n\nif len(all_picks) == 0:\n    print("No picks found!")\n    # Create empty results file\n    pd.DataFrame({\'time\': []}).to_csv(\'/root/results.csv\', index=False)\n    exit(0)\n\n# Event association using origin time clustering\nprint("\\nAssociating picks to events...")\n\n# For each pick, estimate origin time by back-projecting\n# Assume source at mean station location initially\nmean_lat = np.mean([s[\'latitude\'] for s in station_lookup.values()])\nmean_lon = np.mean([s[\'longitude\'] for s in station_lookup.values()])\n\nvp = 6.0  # km/s\nvs = vp / 1.75  # km/s\n\n# Calculate origin times\norigin_times = []\nfor pick in all_picks:\n    station_id = pick[\'station\']\n    if station_id not in station_lookup:\n        continue\n    \n    station_info = station_lookup[station_id]\n    \n    # Calculate distance (simple approximation)\n    lat_diff = station_info[\'latitude\'] - mean_lat\n    lon_diff = station_info[\'longitude\'] - mean_lon\n    distance_deg = np.sqrt(lat_diff**2 + lon_diff**2)\n    distance_km = distance_deg * 111.0  # rough conversion\n    \n    # Estimate travel time\n    if pick[\'phase\'] == \'P\':\n        travel_time = distance_km / vp\n    else:  # S wave\n        travel_time = distance_km / vs\n    \n    # Origin time = pick time - travel time\n    origin_time = pick[\'time\'] - travel_time\n    origin_times.append(origin_time.timestamp)\n\n# Cluster origin times using DBSCAN\norigin_times_array = np.array(origin_times).reshape(-1, 1)\n\n# Use 5 second tolerance for clustering\ndbscan = DBSCAN(eps=5.0, min_samples=3)\ncluster_labels = dbscan.fit_predict(origin_times_array)\n\nprint(f"Found {len(set(cluster_labels)) - (1 if -1 in cluster_labels else 0)} event clusters")\n\n# Extract unique events\nevents = []\nfor cluster_id in set(cluster_labels):\n    if cluster_id == -1:  # noise\n        continue\n    \n    cluster_mask = cluster_labels == cluster_id\n    cluster_origin_times = origin_times_array[cluster_mask]\n    \n    # Use median origin time for this event\n    event_time = np.median(cluster_origin_times)\n    events.append({\n        \'time\': datetime.utcfromtimestamp(event_time).isoformat(),\n        \'num_picks\': np.sum(cluster_mask)\n    })\n\n# Sort by time\nevents_df = pd.DataFrame(events)\nevents_df = events_df.sort_values(\'time\')\n\nprint(f"\\nFinal event count: {len(events_df)}")\nprint(events_df.head(10))\n\n# Save results\nevents_df.to_csv(\'/root/results.csv\', index=False)\nprint("\\nResults saved to /root/results.csv")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
