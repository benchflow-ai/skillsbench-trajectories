Sending keys: ['python3 << \'EOF\'\nimport re\n\n# Read domain01\nwith open(\'/app/airport/domain01.pddl\', \'r\') as f:\n    content = f.read()\n\n# Extract all move action names\nmove_actions = re.findall(r\'\\(:action\\s+(move_[^\\s]+)\', content)\n\nprint(f"Found {len(move_actions)} move actions\\n")\n\n# Parse action names more carefully\n# Format: move_seg_PP_0_60_seg_PPDOOR_0_40_north_north_medium\ntransitions = {}\n\nfor action in move_actions:\n    # Remove \'move_\' prefix\n    action_parts = action[5:]\n    \n    # Split by underscores and find the pattern\n    # We need to find: seg_<name>_<number> then seg_<name>_<number>\n    match = re.match(r\'(seg_[a-z0-9]+)_(seg_[a-z0-9]+)_\', action_parts)\n    if match:\n        from_seg = match.group(1)\n        to_seg = match.group(2)\n        \n        if from_seg not in transitions:\n            transitions[from_seg] = []\n        transitions[from_seg].append((to_seg, action))\n\nprint("Transition graph:")\nfor from_seg in sorted(transitions.keys()):\n    print(f"{from_seg}:")\n    for to_seg, action in transitions[from_seg]:\n        print(f"  -> {to_seg}")\n\n# Now find path from seg_rw_0_400 to seg_pp_0_60 using BFS\nfrom collections import deque\n\ndef find_path(start, goal, graph):\n    queue = deque([(start, [start])])\n    visited = {start}\n    \n    while queue:\n        current, path = queue.popleft()\n        \n        if current == goal:\n            return path\n        \n        if current in graph:\n            for next_seg, action in graph[current]:\n                if next_seg not in visited:\n                    visited.add(next_seg)\n                    queue.append((next_seg, path + [next_seg]))\n    \n    return None\n\npath = find_path(\'seg_rw_0_400\', \'seg_pp_0_60\', transitions)\nprint(f"\\nPath from seg_rw_0_400 to seg_pp_0_60: {path}")\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
