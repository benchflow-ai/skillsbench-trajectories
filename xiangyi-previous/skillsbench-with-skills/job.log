Sending keys: ['cat > dicke_wigner.py << \'EOF\'\nimport numpy as np\nfrom qutip import *\nimport sys\n\n# Force unbuffered output\ndef log(msg):\n    print(msg, flush=True)\n\n# Parameters\nN = 4\nomega_0 = 1.0\nomega_c = 1.0\ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\n\n# Wigner grid\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\n# Dicke subspace: j = N/2\nj = N / 2.0\ndim_spin = int(2 * j + 1)\n\nlog(f"N={N}, j={j}, dim_cavity={n_max}, dim_spin={dim_spin}")\nlog(f"Total dimension: {n_max * dim_spin}")\n\n# Operators\na = tensor(destroy(n_max), qeye(dim_spin))\nJz = tensor(qeye(n_max), jmat(j, \'z\'))\nJp = tensor(qeye(n_max), jmat(j, \'+\'))\nJm = tensor(qeye(n_max), jmat(j, \'-\'))\n\n# Hamiltonian\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\nlog("Hamiltonian created")\n\ndef get_c_ops(case):\n    c_ops = [np.sqrt(kappa) * a]  # Cavity loss always present\n    \n    if case == 1:  # Local dephasing + local pumping\n        c_ops.append(np.sqrt(0.01) * Jz)\n        c_ops.append(np.sqrt(0.1) * Jp)\n    elif case == 2:  # Local dephasing + local emission\n        c_ops.append(np.sqrt(0.01) * Jz)\n        c_ops.append(np.sqrt(0.1) * Jm)\n    elif case == 3:  # Local dephasing + local emission + collective pumping\n        c_ops.append(np.sqrt(0.01) * Jz)\n        c_ops.append(np.sqrt(0.1) * Jm)\n        c_ops.append(np.sqrt(0.1) * Jp)\n    elif case == 4:  # Local dephasing + local emission + collective emission\n        c_ops.append(np.sqrt(0.01) * Jz)\n        c_ops.append(np.sqrt(0.1) * Jm)\n        c_ops.append(np.sqrt(0.1) * Jm)\n    return c_ops\n\nfor case in [1, 2, 3, 4]:\n    log(f"\\n=== Case {case} ===")\n    c_ops = get_c_ops(case)\n    log(f"Collapse ops: {len(c_ops)}")\n    \n    log("Finding steady state...")\n    # Try power method first, then direct if it fails\n    try:\n        rho_ss = steadystate(H, c_ops, method=\'power\', mtol=1e-8, maxiter=10000)\n    except Exception as e:\n        log(f"Power method failed: {e}")\n        log("Trying direct method...")\n        rho_ss = steadystate(H, c_ops, method=\'direct\')\n    \n    log(f"Trace: {rho_ss.tr().real:.6f}")\n    \n    log("Tracing out spins...")\n    rho_cav = ptrace(rho_ss, 0)\n    \n    a_c = destroy(n_max)\n    n_mean = expect(a_c.dag() * a_c, rho_cav).real\n    log(f"Mean photon: {n_mean:.4f}")\n    \n    log("Computing Wigner...")\n    W = wigner(rho_cav, xvec, pvec)\n    log(f"Wigner range: [{W.min():.4f}, {W.max():.4f}]")\n    \n    fname = f"{case}.csv"\n    np.savetxt(fname, W, delimiter=\',\')\n    log(f"Saved {fname}")\n\nlog("\\nDone!")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
