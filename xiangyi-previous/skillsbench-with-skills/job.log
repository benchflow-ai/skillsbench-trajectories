Sending keys: ['cat << \'EOF\' > update_excel.py\nimport openpyxl\nfrom openpyxl.utils import get_column_letter\n\nwb = openpyxl.load_workbook(\'protein_expression.xlsx\')\ntask = wb[\'Task\']\n\n# 1. Pull expression data into C11:L20\nfor r in range(11, 21): # Rows 11-20 for 10 proteins\n    for c in range(3, 13): # Columns C-L (3-12) for 10 samples\n        protein_id_cell = f"$A{r}"\n        sample_name_cell = f"{get_column_letter(c)}$10"\n        # INDEX(Data!$A:$AZ, MATCH($A11, Data!$A:$A, 0), MATCH(C$10, Data!$1:$1, 0))\n        formula = f"=INDEX(Data!$A:$AZ, MATCH({protein_id_cell}, Data!$A:$A, 0), MATCH({sample_name_cell}, Data!$1:$1, 0))"\n        task.cell(row=r, column=c).value = formula\n\n# 2. Group statistics in rows 24-27, columns B-K (2-11)\n# Row 24: Mean Control\n# Row 25: SD Control\n# Row 26: Mean Treated\n# Row 27: SD Treated\n# Based on Row 9: Control is C-G (3-7), Treated is H-L (8-12)\nfor i in range(10): # 10 proteins\n    protein_row = 11 + i\n    stat_col = 2 + i # B, C, D, ...\n    \n    # Mean Control\n    task.cell(row=24, column=stat_col).value = f"=AVERAGE(C{protein_row}:G{protein_row})"\n    # SD Control\n    task.cell(row=25, column=stat_col).value = f"=STDEV(C{protein_row}:G{protein_row})"\n    # Mean Treated\n    task.cell(row=26, column=stat_col).value = f"=AVERAGE(H{protein_row}:L{protein_row})"\n    # SD Treated\n    task.cell(row=27, column=stat_col).value = f"=STDEV(H{protein_row}:L{protein_row})"\n\n# 3. Fold change calculations in columns C and D, rows 32-41\nfor i in range(10):\n    protein_row = 32 + i\n    stat_col_letter = get_column_letter(2 + i) # Stats for protein i are in this column (B, C, ...)\n    \n    # Log2 Fold Change = Treated Mean - Control Mean\n    # Treated Mean is in row 26, Control Mean is in row 24\n    task.cell(row=protein_row, column=3).value = f"={stat_col_letter}26-{stat_col_letter}24"\n    # Fold Change = 2^(Log2 Fold Change)\n    task.cell(row=protein_row, column=4).value = f"=2^C{protein_row}"\n\nwb.save(\'protein_expression.xlsx\')\nEOF\npython3 update_excel.py\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
