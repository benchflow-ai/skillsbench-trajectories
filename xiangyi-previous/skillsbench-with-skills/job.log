Sending keys: ['python - <<\'PY\'\nimport json, math\nfrom pulp import LpProblem, LpMinimize, LpVariable, lpSum, PULP_CBC_CMD, value, LpStatus\n\nwith open(\'network.json\') as f:\n    data=json.load(f)\n\nbase = data[\'baseMVA\']\nbus = data[\'bus\']\ngen = data[\'gen\']\nbranch = data[\'branch\']\ngencost = data[\'gencost\']\nreserve_cap = data[\'reserve_capacity\']\nRreq = data[\'reserve_requirement\']\n\nn_bus = len(bus)\nn_gen = len(gen)\n\n# map bus number to index\nbus_id_to_idx = {int(b[0]): i for i,b in enumerate(bus)}\n\n# gens by bus\ngens_by_bus = [[] for _ in range(n_bus)]\nfor i,g in enumerate(gen):\n    bidx = bus_id_to_idx[int(g[0])]\n    gens_by_bus[bidx].append(i)\n\n# slack bus\nslack = None\nfor i,b in enumerate(bus):\n    if int(b[1]) == 3:\n        slack = i\n        break\nif slack is None:\n    slack = 0\n\nprob = LpProblem(\'dcopf\', LpMinimize)\n\n# variables\ntheta = [LpVariable(f"theta_{i}", lowBound=None, upBound=None) for i in range(n_bus)]\nprob += theta[slack] == 0\n\nPg = []\nR = []\nfor i,g in enumerate(gen):\n    status = int(g[7])\n    if status == 1:\n        pg = LpVariable(f"Pg_{i}", lowBound=g[9], upBound=g[8])\n        r = LpVariable(f"R_{i}", lowBound=0, upBound=reserve_cap[i])\n        # capacity coupling\n        prob += r <= g[8] - pg\n    else:\n        pg = LpVariable(f"Pg_{i}", lowBound=0, upBound=0)\n        r = LpVariable(f"R_{i}", lowBound=0, upBound=0)\n    Pg.append(pg)\n    R.append(r)\n\n# reserve requirement\nprob += lpSum(R) >= Rreq\n\n# branch flows\nflows_by_bus = [[] for _ in range(n_bus)]\nflow_vars = [None]*len(branch)\nfor k,br in enumerate(branch):\n    status = int(br[10])\n    if status == 0:\n        continue\n    f = bus_id_to_idx[int(br[0])]\n    t = bus_id_to_idx[int(br[1])]\n    x = br[3]\n    if x == 0:\n        x = 1e-4\n    tap = br[8]\n    if tap == 0:\n        tap = 1.0\n    shift = br[9]*math.pi/180.0\n    B = base/(x*tap)\n    F = LpVariable(f"F_{k}", lowBound=None, upBound=None)\n    # flow-angle relationship\n    prob += F == B*(theta[f] - theta[t] - shift)\n    rateA = br[5]\n    if rateA and rateA > 0:\n        prob += F <= rateA\n        prob += F >= -rateA\n    flow_vars[k] = F\n    flows_by_bus[f].append((F,1))\n    flows_by_bus[t].append((F,-1))\n\n# power balance\nfor i,b in enumerate(bus):\n    Pd = b[2]\n    prob += lpSum(Pg[j] for j in gens_by_bus[i]) - Pd == lpSum(sign*F for F,sign in flows_by_bus[i])\n\n# objective: linear cost\ncost_terms = []\nfor i,row in enumerate(gencost):\n    c2 = row[4]\n    c1 = row[5]\n    c0 = row[6]\n    cost_terms.append(c1*Pg[i] + c0)\nprob += lpSum(cost_terms)\n\n# solve\nsolver = PULP_CBC_CMD(msg=False)\nstatus = prob.solve(solver)\nprint(\'Status\', LpStatus[status])\n\n# collect results\nPg_val = [value(v) for v in Pg]\nR_val = [value(v) for v in R]\n\n# totals\nload = sum(b[2] for b in bus)\ngeneration = sum(Pg_val)\nreserve = sum(R_val)\n# cost\ncost = sum(gencost[i][5]*Pg_val[i] + gencost[i][6] for i in range(n_gen))\n\n# line loading\nloaded = []\nfor k,br in enumerate(branch):\n    status = int(br[10])\n    if status == 0:\n        continue\n    rateA = br[5]\n    if rateA and rateA > 0:\n        F = value(flow_vars[k])\n        loading = abs(F)/rateA*100.0\n        loaded.append((loading, int(br[0]), int(br[1])))\nloaded.sort(reverse=True)\nmost_loaded = [{\'from\': f, \'to\': t, \'loading_pct\': round(l,3)} for l,f,t in loaded[:3]]\n\n# operating margin\noperating_margin = 0.0\nfor i,g in enumerate(gen):\n    if int(g[7]) != 1:\n        continue\n    operating_margin += g[8] - Pg_val[i] - R_val[i]\n\n# generator dispatch list\ndispatch = []\nfor i,g in enumerate(gen):\n    dispatch.append({\n        \'id\': i+1,\n        \'bus\': int(g[0]),\n        \'output_MW\': float(Pg_val[i]),\n        \'reserve_MW\': float(R_val[i]),\n        \'pmax_MW\': float(g[8])\n    })\n\nreport = {\n    \'generator_dispatch\': dispatch,\n    \'totals\': {\n        \'cost_dollars_per_hour\': float(cost),\n        \'load_MW\': float(load),\n        \'generation_MW\': float(generation),\n        \'reserve_MW\': float(reserve)\n    },\n    \'most_loaded_lines\': most_loaded,\n    \'operating_margin_MW\': float(operating_margin)\n}\n\nwith open(\'report.json\',\'w\') as f:\n    json.dump(report, f, indent=2)\n\nprint(\'report.json written\')\nPY\n'] min_timeout_sec: 30.0 max_timeout_sec: 180.0
