tion_{orient.replace(" ", "_").replace(",", "").replace("(", "").replace(")", "")}\'\n    survey_fe[col_name] = (survey_fe[\'Q-sexual-orientation\'] == orient).astype(int)\n    feature_cols.append(col_name)\n\n# State\nfor state in survey_fe[\'Q-demos-state\'].dropna().unique():\n    col_name = f\'state_{state.replace(" ", "_")}\'\n    survey_fe[col_name] = (survey_fe[\'Q-demos-state\'] == state).astype(int)\n    feature_cols.append(col_name)\n\n# Household size\nfor hh_size in survey_fe[\'Q-amazon-use-howmany\'].dropna().unique():\n    col_name = f\'hh_size_{hh_size.replace(" ", "_").replace("!", "").replace("(", "").replace(")", "")}\'\n    survey_fe[col_name] = (survey_fe[\'Q-amazon-use-howmany\'] == hh_size).astype(int)\n    feature_cols.append(col_name)\n\n# Household members\nfor hh_mem in survey_fe[\'Q-amazon-use-hh-size\'].dropna().unique():\n    col_name = f\'hh_members_{str(hh_mem).replace(" ", "_").replace("!", "").replace("(", "").replace(")", "")}\'\n    survey_fe[col_name] = (survey_fe[\'Q-amazon-use-hh-size\'] == hh_mem).astype(int)\n    feature_cols.append(col_name)\n\n# Purchase frequency\nfor freq in survey_fe[\'Q-amazon-use-how-oft\'].dropna().unique():\n    col_name = f\'purchase_freq_{freq.replace(" ", "_")}\'\n    survey_fe[col_name] = (survey_fe[\'Q-amazon-use-how-oft\'] == freq).astype(int)\n    feature_cols.append(col_name)\n\n# Substance use and health\nfor col in [\'Q-substance-use-cigarettes\', \'Q-substance-use-marijuana\', \'Q-substance-use-alcohol\', \n            \'Q-personal-diabetes\', \'Q-personal-wheelchair\']:\n    for val in survey_fe[col].dropna().unique():\n        col_name = f\'{col.replace("Q-", "").replace("-", "_")}_{val}\'\n        survey_fe[col_name] = (survey_fe[col] == val).astype(int)\n        feature_cols.append(col_name)\n\n# Save feature engineered survey\nsurvey_fe_output = survey_fe[[\'Survey ResponseID\'] + feature_cols]\nsurvey_fe_output.to_csv(\'/app/output/survey_feature_engineered.csv\', index=False)\nprint(