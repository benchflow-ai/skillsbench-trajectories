Sending keys: ['cat > dicke_model.py << \'EOF\'\nimport numpy as np\nfrom qutip import *\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# System parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0  # Transition frequency\nomega_c = 1.0  # Cavity frequency\ng = 2.0 / np.sqrt(N)  # Coupling strength\nkappa = 1.0  # Cavity loss rate\nn_max = 16  # Photon number cutoff\n\n# Wigner function grid parameters\ngrid_points = 1000\nx_range = 6.0\np_range = 6.0\n\nprint("Initializing Dicke model simulation...")\nprint(f"Parameters: N={N}, omega_0={omega_0}, omega_c={omega_c}, g={g:.4f}, kappa={kappa}, n_max={n_max}")\n\n# Create operators\na = destroy(n_max)  # Cavity annihilation operator\nN_cav = num(n_max)  # Cavity number operator\nI_cav = qeye(n_max)  # Cavity identity\nI_spin = qeye(2)  # Single spin identity\n\n# Single spin operators\njz = 0.5 * sigmaz()\njp = (sigmax() + 1j*sigmay()) / 2.0  # J+ = (sigma_x + i*sigma_y)/2\njm = (sigmax() - 1j*sigmay()) / 2.0  # J- = (sigma_x - i*sigma_y)/2\n\nprint("Building collective spin operators...")\n\n# Build collective operators by summing over all spins\n# Start with first spin and add others\nops_list = [I_spin for _ in range(N)]\nops_list[0] = jz\nJz = tensor(I_cav, tensor(ops_list))\n\nops_list = [I_spin for _ in range(N)]\nops_list[0] = jp\nJp = tensor(I_cav, tensor(ops_list))\n\nops_list = [I_spin for _ in range(N)]\nops_list[0] = jm\nJm = tensor(I_cav, tensor(ops_list))\n\n# Add remaining spins\nfor i in range(1, N):\n    ops_list = [I_spin for _ in range(N)]\n    ops_list[i] = jz\n    Jz = Jz + tensor(I_cav, tensor(ops_list))\n    \n    ops_list = [I_spin for _ in range(N)]\n    ops_list[i] = jp\n    Jp = Jp + tensor(I_cav, tensor(ops_list))\n    \n    ops_list = [I_spin for _ in range(N)]\n    ops_list[i] = jm\n    Jm = Jm + tensor(I_cav, tensor(ops_list))\n\nprint("Collective operators built.")\n\n# Cavity operators in full Hilbert space\na_full = tensor(a, qeye(2**N))\na_dag = a_full.dag()\n\nprint("Hamiltonian construction...")\n\n# Hamiltonian: H = omega_0 * Jz + omega_c * a^dag*a + g*(a^dag + a)*(J+ + J-)\nH = omega_0 * Jz + omega_c * tensor(N_cav, qeye(2**N)) + g * (a_full + a_dag) * (Jp + Jm)\n\nprint("Hamiltonian constructed.")\nprint(f"Hilbert space dimension: {H.dims}")\nprint("\\nSolving for steady states in 4 different loss cases...")\n\n# ============================================================================\n# Case 1: Local dephasing & local pumping\n# ============================================================================\nprint("\\nCase 1: Local dephasing (gamma_phi=0.01) & local pumping (gamma_up=0.1)")\ngamma_phi_1 = 0.01\ngamma_up_1 = 0.1\n\nc_ops_1 = [np.sqrt(kappa) * a_full]  # Cavity loss\n\n# Local dephasing and pumping for each spin\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    \n    # Dephasing: sigma_z\n    ops[i] = sigmaz()\n    c_dephase = np.sqrt(gamma_phi_1) * tensor(I_cav, tensor(ops))\n    c_ops_1.append(c_dephase)\n    \n    # Pumping: |down><down| = (I - sigma_z)/2\n    ops[i] = (I_spin - sigmaz()) / 2.0\n    c_pump = np.sqrt(gamma_up_1) * tensor(I_cav, tensor(ops))\n    c_ops_1.append(c_pump)\n\nprint(f"Number of collapse operators: {len(c_ops_1)}")\nrho_ss_1 = steadystate(H, c_ops_1, method=\'direct\')\nprint("Steady state found for Case 1.")\n\n# ============================================================================\n# Case 2: Local dephasing & local emission\n# ============================================================================\nprint("\\nCase 2: Local dephasing (gamma_phi=0.01) & local emission (gamma_down=0.1)")\ngamma_phi_2 = 0.01\ngamma_down_2 = 0.1\n\nc_ops_2 = [np.sqrt(kappa) * a_full]  # Cavity loss\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    \n    # Dephasing: sigma_z\n    ops[i] = sigmaz()\n    c_dephase = np.sqrt(gamma_phi_2) * tensor(I_cav, tensor(ops))\n    c_ops_2.append(c_dephase)\n    \n    # Emission: sigma_minus = J_minus\n    ops[i] = jm\n    c_emit = np.sqrt(gamma_down_2) * tensor(I_cav, tensor(ops))\n    c_ops_2.append(c_emit)\n\nprint(f"Number of collapse operators: {len(c_ops_2)}")\nrho_ss_2 = steadystate(H, c_ops_2, method=\'direct\')\nprint("Steady state found for Case 2.")\n\n# ============================================================================\n# Case 3: Local dephasing & local emission & collective pumping\n# ============================================================================\nprint("\\nCase 3: Local dephasing & local emission & collective pumping")\ngamma_phi_3 = 0.01\ngamma_down_3 = 0.1\ngamma_coll_up_3 = 0.1\n\nc_ops_3 = [np.sqrt(kappa) * a_full]  # Cavity loss\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    \n    # Dephasing: sigma_z\n    ops[i] = sigmaz()\n    c_dephase = np.sqrt(gamma_phi_3) * tensor(I_cav, tensor(ops))\n    c_ops_3.append(c_dephase)\n    \n    # Emission: sigma_minus\n    ops[i] = jm\n    c_emit = np.sqrt(gamma_down_3) * tensor(I_cav, tensor(ops))\n    c_ops_3.append(c_emit)\n\n# Collective pumping: J_plus\nc_ops_3.append(np.sqrt(gamma_coll_up_3) * Jp)\n\nprint(f"Number of collapse operators: {len(c_ops_3)}")\nrho_ss_3 = steadystate(H, c_ops_3, method=\'direct\')\nprint("Steady state found for Case 3.")\n\n# ============================================================================\n# Case 4: Local dephasing & local emission & collective emission\n# ============================================================================\nprint("\\nCase 4: Local dephasing & local emission & collective emission")\ngamma_phi_4 = 0.01\ngamma_down_4 = 0.1\ngamma_coll_down_4 = 0.1\n\nc_ops_4 = [np.sqrt(kappa) * a_full]  # Cavity loss\n\nfor i in range(N):\n    ops = [I_spin for _ in range(N)]\n    \n    # Dephasing: sigma_z\n    ops[i] = sigmaz()\n    c_dephase = np.sqrt(gamma_phi_4) * tensor(I_cav, tensor(ops))\n    c_ops_4.append(c_dephase)\n    \n    # Emission: sigma_minus\n    ops[i] = jm\n    c_emit = np.sqrt(gamma_down_4) * tensor(I_cav, tensor(ops))\n    c_ops_4.append(c_emit)\n\n# Collective emission: J_minus\nc_ops_4.append(np.sqrt(gamma_coll_down_4) * Jm)\n\nprint(f"Number of collapse operators: {len(c_ops_4)}")\nrho_ss_4 = steadystate(H, c_ops_4, method=\'direct\')\nprint("Steady state found for Case 4.")\n\nprint("\\nTracing out spin degrees of freedom...")\n\n# Trace out spins to get cavity density matrices\nrho_cav_1 = ptrace(rho_ss_1, 0)  # Keep only cavity mode (index 0)\nrho_cav_2 = ptrace(rho_ss_2, 0)\nrho_cav_3 = ptrace(rho_ss_3, 0)\nrho_cav_4 = ptrace(rho_ss_4, 0)\n\nprint("Cavity states extracted.")\nprint(f"Cavity state dimensions: {rho_cav_1.dims}")\n\nprint("\\nCalculating Wigner functions...")\n\n# Create grid for Wigner function\nxvec = np.linspace(-x_range, x_range, grid_points)\npvec = np.linspace(-p_range, p_range, grid_points)\n\nprint(f"Grid: {grid_points} x {grid_points} points from -{x_range} to {x_range}")\n\n# Calculate Wigner functions\nprint("Calculating W1...")\nW1 = wigner(rho_cav_1, xvec, pvec)\nprint("Calculating W2...")\nW2 = wigner(rho_cav_2, xvec, pvec)\nprint("Calculating W3...")\nW3 = wigner(rho_cav_3, xvec, pvec)\nprint("Calculating W4...")\nW4 = wigner(rho_cav_4, xvec, pvec)\n\nprint("Wigner functions calculated.")\n\nprint("\\nSaving results to CSV files...")\n\n# Save Wigner functions as CSV\nnp.savetxt(\'1.csv\', W1, delimiter=\',\')\nnp.savetxt(\'2.csv\', W2, delimiter=\',\')\nnp.savetxt(\'3.csv\', W3, delimiter=\',\')\nnp.savetxt(\'4.csv\', W4, delimiter=\',\')\n\nprint("Results saved:")\nprint("  1.csv - Case 1: Local dephasing & local pumping")\nprint("  2.csv - Case 2: Local dephasing & local emission")\nprint("  3.csv - Case 3: Local dephasing & local emission & collective pumping")\nprint("  4.csv - Case 4: Local dephasing & local emission & collective emission")\n\nprint("\\nSimulation complete!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
