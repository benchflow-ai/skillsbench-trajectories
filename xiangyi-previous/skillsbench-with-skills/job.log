Sending keys: ['cat << \'EOF\' > /app/solution.py\nimport json\nimport re\nimport os\n\ndef parse_script(text: str):\n    nodes = []\n    edges = []\n    \n    # Split the text into blocks based on [NodeID]\n    node_blocks = []\n    current_node_id = None\n    current_content = []\n    \n    for line in text.splitlines():\n        line_stripped = line.strip()\n        if not line_stripped:\n            continue\n        match = re.match(r\'^\\[(.*?)\\]$\', line_stripped)\n        if match:\n            if current_node_id:\n                node_blocks.append((current_node_id, current_content))\n            current_node_id = match.group(1)\n            current_content = []\n        else:\n            current_content.append(line_stripped)\n    if current_node_id:\n        node_blocks.append((current_node_id, current_content))\n\n    node_dict = {}\n\n    for node_id, lines in node_blocks:\n        node = {\n            "id": node_id,\n            "text": "",\n            "speaker": "",\n            "type": "line"\n        }\n        \n        is_choice = any(re.match(r\'^\\d+\\.\', l) for l in lines)\n        \n        if is_choice:\n            node["type"] = "choice"\n            for l in lines:\n                if \'->\' in l:\n                    parts = l.split(\'->\')\n                    choice_part = parts[0].strip()\n                    target = parts[1].strip()\n                    edges.append({"from": node_id, "to": target, "text": choice_part})\n        else:\n            node["type"] = "line"\n            if lines:\n                line_content = lines[0]\n                if \'->\' in line_content:\n                    parts = line_content.split(\'->\')\n                    speaker_text = parts[0].strip()\n                    target = parts[1].strip()\n                    \n                    if \':\' in speaker_text:\n                        s_parts = speaker_text.split(\':\', 1)\n                        node["speaker"] = s_parts[0].strip()\n                        node["text"] = s_parts[1].strip()\n                    else:\n                        node["text"] = speaker_text\n                    \n                    if target:\n                        edges.append({"from": node_id, "to": target, "text": ""})\n                else:\n                    if \':\' in line_content:\n                        s_parts = line_content.split(\':\', 1)\n                        node["speaker"] = s_parts[0].strip()\n                        node["text"] = s_parts[1].strip()\n                    else:\n                        node["text"] = line_content\n        \n        nodes.append(node)\n        node_dict[node_id] = node\n\n    # Ensure all mentioned targets exist as nodes\n    existing_ids = set(node_dict.keys())\n    all_targets = set(edge["to"] for edge in edges if edge["to"])\n    for target in all_targets:\n        if target not in existing_ids:\n            new_node = {\n                "id": target,\n                "text": "",\n                "speaker": "",\n                "type": "line"\n            }\n            nodes.append(new_node)\n            existing_ids.add(target)\n            \n    return {"nodes": nodes, "edges": edges}\n\ndef main():\n    if not os.path.exists(\'/app/script.txt\'):\n        return\n    with open(\'/app/script.txt\', \'r\') as f:\n        text = f.read()\n    \n    graph = parse_script(text)\n    \n    with open(\'/app/dialogue.json\', \'w\') as f:\n        json.dump(graph, f, indent=2)\n        \n    with open(\'/app/dialogue.dot\', \'w\') as f:\n        f.write(\'digraph dialogue {\\n\')\n        for node in graph[\'nodes\']:\n            if node[\'speaker\'] and node[\'text\']:\n                label = f"{node[\'speaker\']}: {node[\'text\']}"\n            elif node[\'text\']:\n                label = node[\'text\']\n            else:\n                label = node[\'id\']\n            label = label.replace(\'"\', \'\\\\"\')\n            f.write(f\'  "{node["id"]}" [label="{label}", shape=box];\\n\')\n        \n        for edge in graph[\'edges\']:\n            edge_text = edge[\'text\'].replace(\'"\', \'\\\\"\')\n            f.write(f\'  "{edge["from"]}" -> "{edge["to"]}" [label="{edge_text}"];\\n\')\n        f.write(\'}\\n\')\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
