Sending keys: ['cat > dicke_wigner.py << \'ENDSCRIPT\'\nimport numpy as np\nfrom qutip import *\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\nprint("Starting Dicke model simulation...", flush=True)\n\n# Parameters\nN = 4\nomega_0 = 1.0\nomega_c = 1.0\ng = 2.0 / np.sqrt(N)\nkappa = 1.0\nn_max = 16\n\n# Wigner grid\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\n# Dicke subspace\nj = N / 2.0\ndim_spin = int(2 * j + 1)\n\nprint(f"Parameters: N={N}, j={j}, n_max={n_max}, dim_spin={dim_spin}", flush=True)\nprint(f"Total Hilbert space: {n_max * dim_spin}", flush=True)\n\n# Create operators\na = tensor(destroy(n_max), qeye(dim_spin))\nJz = tensor(qeye(n_max), jmat(j, \'z\'))\nJp = tensor(qeye(n_max), jmat(j, \'+\'))\nJm = tensor(qeye(n_max), jmat(j, \'-\'))\n\n# Hamiltonian\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\nprint("Hamiltonian created", flush=True)\n\ndef get_c_ops(case):\n    """Get collapse operators for each case."""\n    c_ops = [np.sqrt(kappa) * a]  # Cavity loss\n    \n    gamma_phi = 0.01\n    gamma_up = 0.1\n    gamma_down = 0.1\n    gamma_coll = 0.1\n    \n    if case == 1:  # Local dephasing + local pumping\n        c_ops.append(np.sqrt(gamma_phi) * Jz)\n        c_ops.append(np.sqrt(gamma_up) * Jp)\n    elif case == 2:  # Local dephasing + local emission\n        c_ops.append(np.sqrt(gamma_phi) * Jz)\n        c_ops.append(np.sqrt(gamma_down) * Jm)\n    elif case == 3:  # Local dephasing + local emission + collective pumping\n        c_ops.append(np.sqrt(gamma_phi) * Jz)\n        c_ops.append(np.sqrt(gamma_down) * Jm)\n        c_ops.append(np.sqrt(gamma_coll) * Jp)\n    elif case == 4:  # Local dephasing + local emission + collective emission\n        c_ops.append(np.sqrt(gamma_phi) * Jz)\n        c_ops.append(np.sqrt(gamma_down) * Jm)\n        c_ops.append(np.sqrt(gamma_coll) * Jm)\n    \n    return c_ops\n\ndef find_steady_state(H, c_ops):\n    """Try multiple methods to find steady state."""\n    methods = [\n        (\'eigen\', {}),\n        (\'power\', {\'mtol\': 1e-6, \'maxiter\': 20000}),\n        (\'direct\', {\'solver\': \'scipy\'}),\n        (\'svd\', {}),\n    ]\n    \n    for method, kwargs in methods:\n        try:\n            print(f"  Trying {method}...", flush=True)\n            rho = steadystate(H, c_ops, method=method, **kwargs)\n            tr = rho.tr().real\n            if abs(tr - 1.0) < 0.01:\n                print(f"  Success with {method}, trace={tr:.6f}", flush=True)\n                return rho\n        except Exception as e:\n            print(f"  {method} failed: {str(e)[:50]}", flush=True)\n    \n    raise RuntimeError("All methods failed")\n\nfor case in [1, 2, 3, 4]:\n    print(f"\\n=== Case {case} ===", flush=True)\n    c_ops = get_c_ops(case)\n    print(f"Collapse operators: {len(c_ops)}", flush=True)\n    \n    print("Finding steady state...", flush=True)\n    rho_ss = find_steady_state(H, c_ops)\n    \n    print("Tracing out spins...", flush=True)\n    rho_cav = ptrace(rho_ss, 0)\n    \n    a_c = destroy(n_max)\n    n_mean = expect(a_c.dag() * a_c, rho_cav).real\n    print(f"Mean photon number: {n_mean:.4f}", flush=True)\n    \n    print("Computing Wigner function...", flush=True)\n    W = wigner(rho_cav, xvec, pvec)\n    print(f"Wigner range: [{W.min():.4f}, {W.max():.4f}]", flush=True)\n    \n    fname = f"{case}.csv"\n    np.savetxt(fname, W, delimiter=\',\')\n    print(f"Saved to {fname}", flush=True)\n\nprint("\\nAll cases completed!", flush=True)\nENDSCRIPT\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
