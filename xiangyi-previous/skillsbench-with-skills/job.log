Sending keys: ['cat << \'EOF\' > check_folded_v2.py\nimport numpy as np\nimport lightkurve as lk\n\ndata = np.loadtxt(\'/root/data/tess_lc.txt\')\nmask = (data[:, 2] == 0)\nlc = lk.LightCurve(time=data[mask, 0], flux=data[mask, 1], flux_err=data[mask, 3])\nlc = lc.remove_outliers(sigma=5)\ncadence = np.median(np.diff(lc.time.value))\n\nflat = lc.flatten(window_length=int(0.5/cadence)|1)\npg = flat.to_periodogram(method=\'bls\', minimum_period=0.5, maximum_period=15, frequency_factor=200)\n\n# Get top 3 peaks and their t0\nindices = np.argsort(pg.power)[::-1]\n\nfor i in range(5):\n    idx = indices[i]\n    p = pg.period[idx].value\n    t0 = pg.transit_time_at_max_power[idx].value\n    dur = pg.duration_at_max_power[idx].value\n    \n    # Filter out close periods\n    if i > 0 and np.any(np.abs(pg.period[indices[:i]].value - p) < 0.01):\n        continue\n\n    folded = flat.fold(period=p, epoch_time=t0)\n    in_transit = np.abs(folded.time.value) < (dur / 2.0)\n    depth = 1.0 - np.median(folded.flux[in_transit])\n    std = np.std(folded.flux[~in_transit])\n    snr = depth / (std / np.sqrt(np.sum(in_transit)))\n    print(f"P: {p:.5f}, t0: {t0:.5f}, dur: {dur:.3f}, SNR: {snr:.2f}, Depth: {depth:.5f}")\n\nEOF\npython3 check_folded_v2.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
