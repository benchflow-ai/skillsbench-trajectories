for m in range(num_machines)}\n    \n    horizon = 100 \n    \n    for j in range(num_jobs):\n        for o in range(len(jobs[j])):\n            op_data = jobs[j][o]\n            suffix = f\'_{j}_{o}\'\n            \n            start_var = model.NewIntVar(0, horizon, \'start\' + suffix)\n            end_var = model.NewIntVar(0, horizon, \'end\' + suffix)\n            mach_var = model.NewIntVar(0, num_machines - 1, \'mach\' + suffix)\n            \n            local_selected = []\n            \n            for alt_idx, alt in enumerate(op_data):\n                m_id = alt[\'machine\']\n                dur = alt[\'duration\']\n                \n                is_selected = model.NewBoolVar(f\'sel{suffix}_{m_id}\')\n                local_selected.append(is_selected)\n                \n                interval = model.NewOptionalIntervalVar(\n                    start_var, dur, end_var, is_selected, f\'interval{suffix}_{m_id}\'\n                )\n                machine_intervals[m_id].append(interval)\n                \n                model.Add(mach_var == m_id).OnlyEnforceIf(is_selected)\n                \n            model.Add(sum(local_selected) == 1)\n            \n            task_vars[(j, o)] = {\n                \'start\': start_var,\n                \'end\': end_var,\n                \'machine\': mach_var,\n                \'selected\': local_selected,\n                \'alts\': op_data\n            }\n\n    # Precedence\n    for j in range(num_jobs):\n        for o in range(len(jobs[j]) - 1):\n            model.Add(task_vars[(j, o)][\'end\'] <= task_vars[(j, o+1)][\'start\'])\n            \n    # No Overlap\n    for m in range(num_machines):\n        model.AddNoOverlap(machine_intervals[m])\n            \n    # Downtime Constraints\n    for j in range(num_jobs):\n        for o in range(len(jobs[j])):\n            if (j, o) in frozen_tasks:\n                continue\n                \n            t_var = task_vars[(j, o)]\n            \n            for alt_idx, alt in enumerate(t_var[\'alts\']):\n                m = alt[\'machine\']\n                is_selected = t_var[\'selected\'][alt_idx]\n                \n                relevant_dts = [dt for dt in downtimes if dt[\'machine\'] == m]\n                \n                for dt in relevant_dts:\n                    b_before = model.NewBoolVar(f\'before_dt_{j}_{o}_{m}_{dt["start"]}\')\n                    b_after = model.NewBoolVar(f\'after_dt_{j}_{o}_{m}_{dt["start"]}\')\n                    \n                    model.Add(t_var[\'end\'] <= dt[\'start\']).OnlyEnforceIf(b_before)\n                    model.Add(t_var[\'start\'] >= dt[\'end\']).OnlyEnforceIf(b_after)\n                    \n                    model.Add(b_before + b_after >= 1).OnlyEnforceIf(is_selected)\n\n    # Freeze Constraints\n    for (j, o), task in frozen_tasks.items():\n        t_var = task_vars[(j, o)]\n        model.Add(t_var[\'start\'] == task[\'start\'])\n        model.Add(t_var[\'machine\'] == task[\'machine\'])\n\n    # Budgets\n    machine_changes = []\n    for j in range(num_jobs):\n        for o in range(len(jobs[j])):\n            base_m = baseline_map[(j, o)][\'machine\']\n            curr_m = task_vars[(j, o)][\'machine\']\n            \n            is_diff = model.NewBoolVar(f\'diff_m_{j}_{o}\')\n            model.Add(curr_m != base_m).OnlyEnforceIf(is_diff)\n            model.Add(curr_m == base_m).OnlyEnforceIf(is_diff.Not())\n            machine_changes.append(is_diff)\n    \n    model.Add(sum(machine_changes) <= policy[\'change_budget\'][\'max_machine_changes\'])\n    \n    shifts = []\n    for j in range(num_jobs):\n        for o in range(len(jobs[j])):\n            base_s = baseline_map[(j, o)][\'start\']\n            curr_s = task_vars[(j, o)][\'start\']\n            \n            shift = model.NewIntVar(0, horizon, f\'shift_{j}_{o}\')\n            model.Add(shift >= curr_s - base_s)\n            model.Add(shift >= base_s - curr_s)\n            shifts.append(shift)\n    \n    model.Add(sum(shifts) <= policy[\'change_budget\'][\'max_total_start_shift_L1\'])\n    \n    # Makespan\n    makespan = model.NewIntVar(0, horizon, \'makespan\')\n    for j in range(num_jobs):\n        last_op_idx = len(jobs[j]) - 1\n        model.Add(makespan >= task_vars[(j, last_op_idx)][\'end\'])\n        \n    max_makespan = int(baseline[\'makespan\'] * policy[\'guards\'][\'max_makespan_ratio\'])\n    model.Add(makespan <= max_makespan)\n    \n    model.Minimize(makespan)\n    \n    solver = cp_model.CpSolver()\n    status = solver.Solve(model)\n    \n    if status in [cp_model.OPTIMAL, cp_model.FEASIBLE]:\n        res_makespan = solver.Value(makespan)\n        schedule = []\n        for j in range(num_jobs):\n            for o in range(len(jobs[j])):\n                t_var = task_vars[(j, o)]\n                s = solver.Value(t_var[\'start\'])\n                e = solver.Value(t_var[\'end\'])\n                m = solver.Value(t_var[\'machine\'])\n                dur = e - s\n                schedule.append({\n                    "job": j,\n                    "op": o,\n                    "machine": m,\n                    "start": s,\n                    "end": e,\n                    "dur": dur\n                })\n        \n        output = {\n            "status": "OPTIMAL" if status == cp_model.OPTIMAL else "FEASIBLE",\n            "makespan": res_makespan,\n            "schedule": schedule\n        }\n        \n        with open(\'/app/output/solution.json\', \'w\') as f:\n            json.dump(output, f, indent=2)\n            \n        keys = ["job", "op", "machine", "start", "end", "dur"]\n        with open(\'/app/output/schedule.csv\', \'w\', newline=\'\') as f:\n            writer = csv.DictWriter(f, fieldnames=keys)\n            writer.writeheader()\n            for row in schedule:\n                writer.writerow(row)\n        \n        print("Solved successfully.")\n    else:\n        print("No solution found.")\n\nif __name__ == \'__main__\':\n    solve()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
