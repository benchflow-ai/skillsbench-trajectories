ct = False\n        for ds, de in sorted(downtime[machine]):\n            if start < de and end > ds:\n                start = de\n                conflict = True\n                break\n        if not conflict:\n            return start\n    return start\n\n# Load data\njobs, num_machines = parse_instance(\'/app/data/instance.txt\')\ndowntime = parse_downtime(\'/app/data/downtime.csv\')\npolicy = parse_policy(\'/app/data/policy.json\')\nbaseline = parse_baseline(\'/app/data/baseline_solution.json\')\n\nbaseline_ops = {}\nfor op in baseline[\'schedule\']:\n    baseline_ops[(op[\'job\'], op[\'op\'])] = op\n\nfreeze_until = policy[\'freeze\'][\'freeze_until\']\nmax_machine_changes = policy[\'change_budget\'][\'max_machine_changes\']\nmax_start_shift = policy[\'change_budget\'][\'max_total_start_shift_L1\']\nmax_makespan_ratio = policy[\'guards\'][\'max_makespan_ratio\']\n\n# Build schedule using list scheduling with downtime avoidance\n# Track: machine availability, job operation completion times\n\ndef schedule_jobs(jobs, downtime, baseline_ops, freeze_until, num_machines):\n    machine_available = [0] * num_machines\n    job_op_end = {j: 0 for j in range(len(jobs))}  # end time of last completed op for each job\n    \n    schedule = []\n    machine_changes = 0\n    total_start_shift = 0\n    \n    # Process operations in order: for each job, ops must be sequential\n    # We\'ll use a priority queue approach: always schedule the earliest available operation\n    \n    pending = []  # (job, op_idx)\n    for j in range(len(jobs)):\n        pending.append((j, 0))\n    \n    scheduled_ops = set()\n    \n    while pending:\n        # Find the operation that can start earliest\n        best = None\n        best_start = float(\'inf\')\n        best_machine = None\n        best_duration = None\n        \n        for j, op_idx in pending:\n            if (j, op_idx) in scheduled_ops:\n                continue\n                \n            # Check if previous op is done\n    