Sending keys: ["cat <<EOF > /app/detect_anomalies.py\nimport pandas as pd\nimport numpy as np\nimport os\n\n# Paths\npurchase_path = '/app/output/amazon-purchases-2019-2020-filtered.csv'\noutput_dir = '/app/output/'\n\nprint('Loading data...')\ndf = pd.read_csv(purchase_path)\ndf['Order Date'] = pd.to_datetime(df['Order Date'])\n\n# Define periods\nbaseline_start = '2020-01-01'\nbaseline_end = '2020-02-29'\ntreatment_start = '2020-03-01'\ntreatment_end = '2020-03-31'\n\n# Filter data for relevant periods\nbaseline_data = df[(df['Order Date'] >= baseline_start) & (df['Order Date'] <= baseline_end)]\ntreatment_data = df[(df['Order Date'] >= treatment_start) & (df['Order Date'] <= treatment_end)]\n\n# Calculate daily sales per category\n# We need average daily spend. \n# 1. Sum spend per category per day.\n# 2. Average those daily sums over the period.\n\ndef get_avg_daily_sales(data, start_date, end_date):\n    if data.empty:\n        return pd.Series(dtype=float)\n    daily = data.groupby(['Category', 'Order Date'])['Total Spend'].sum().reset_index()\n    # Ensure we account for days with 0 sales if necessary, but usually we just average over the days in the range.\n    # To be precise, we should divide total sales in period by number of days in period.\n    total_sales = data.groupby('Category')['Total Spend'].sum()\n    n_days = (pd.to_datetime(end_date) - pd.to_datetime(start_date)).days + 1\n    return total_sales / n_days\n\nbaseline_avg = get_avg_daily_sales(baseline_data, baseline_start, baseline_end)\ntreatment_avg = get_avg_daily_sales(treatment_data, treatment_start, treatment_end)\n\n# Combine\nresults = pd.DataFrame({'Baseline_Avg': baseline_avg, 'Treatment_Avg': treatment_avg})\nresults = results.fillna(0)\n\n# Calculate Anomaly Index\n# Formula: ((Treatment - Baseline) / Baseline) * 100\n# Handle division by zero\nresults['Anomaly_Index'] = 0.0\nmask = results['Baseline_Avg'] > 0\nresults.loc[mask, 'Anomaly_Index'] = ((results.loc[mask, 'Treatment_Avg'] - results.loc[mask, 'Baseline_Avg']) / results.loc[mask, 'Baseline_Avg']) * 100\n\n# Handle cases where Baseline is 0 but Treatment > 0 (infinite surge -> 100)\nresults.loc[(results['Baseline_Avg'] == 0) & (results['Treatment_Avg'] > 0), 'Anomaly_Index'] = 100.0\n# Handle cases where both are 0\nresults.loc[(results['Baseline_Avg'] == 0) & (results['Treatment_Avg'] == 0), 'Anomaly_Index'] = 0.0\n\n# Clamp to -100, 100\nresults['Anomaly_Index'] = results['Anomaly_Index'].clip(-100, 100)\n\n# Reset index to make Category a column\nresults = results.reset_index().rename(columns={'index': 'Category'})\n\n# Save\noutput_path = os.path.join(output_dir, 'category_anomaly_index.csv')\nresults[['Category', 'Anomaly_Index']].to_csv(output_path, index=False)\n\nprint(f'Anomaly detection complete. Saved to {output_path}')\nprint('Top 5 Surges:')\nprint(results.sort_values('Anomaly_Index', ascending=False).head(5))\nprint('Top 5 Slumps:')\nprint(results.sort_values('Anomaly_Index', ascending=True).head(5))\nEOF\n"] min_timeout_sec: 0.1 max_timeout_sec: 180.0
