Sending keys: ['cat > /root/process_video_v3.py << \'EOF\'\nimport speech_recognition as sr\nimport json\nimport subprocess\nimport os\nfrom pydub import AudioSegment\nfrom pydub.utils import mediainfo\nimport re\n\n# Filler words to detect\nFILLER_WORDS = [\n    \'um\', \'uh\', \'hum\', \'hmm\', \'mhm\',\n    \'like\',\n    \'you know\',\n    \'i mean\',\n    \'yeah\',\n    \'so\',\n    \'kind of\',\n    \'basically\',\n    \'i guess\',\n    \'well\',\n    \'okay\'\n]\n\ndef extract_audio(video_path, audio_path):\n    """Extract audio from video"""\n    print("Extracting audio from video...")\n    cmd = [\n        \'ffmpeg\',\n        \'-i\', video_path,\n        \'-q:a\', \'9\',\n        \'-n\',\n        audio_path\n    ]\n    result = subprocess.run(cmd, capture_output=True)\n    if result.returncode == 0:\n        print(f"Audio extracted to {audio_path}")\n    else:\n        print(f"Error extracting audio: {result.stderr.decode()}")\n\ndef transcribe_audio_chunks(audio_path, chunk_duration=30000):\n    """Transcribe audio in chunks using SpeechRecognition"""\n    print("Loading audio file...")\n    audio = AudioSegment.from_file(audio_path)\n    \n    recognizer = sr.Recognizer()\n    full_text = ""\n    segments = []\n    \n    # Split audio into chunks\n    num_chunks = (len(audio) + chunk_duration - 1) // chunk_duration\n    print(f"Transcribing {num_chunks} chunks...")\n    \n    for i in range(num_chunks):\n        start = i * chunk_duration\n        end = min((i + 1) * chunk_duration, len(audio))\n        chunk = audio[start:end]\n        \n        # Export chunk to wav\n        chunk_path = f"/tmp/chunk_{i}.wav"\n        chunk.export(chunk_path, format="wav")\n        \n        try:\n            with sr.AudioFile(chunk_path) as source:\n                audio_data = recognizer.record(source)\n                text = recognizer.recognize_google(audio_data)\n                \n                start_time = start / 1000.0\n                end_time = end / 1000.0\n                \n                segments.append({\n                    \'text\': text,\n                    \'start\': start_time,\n                    \'end\': end_time\n                })\n                \n                full_text += " " + text\n                print(f"Chunk {i+1}/{num_chunks}: {text[:50]}...")\n        except sr.UnknownValueError:\n            print(f"Chunk {i+1}/{num_chunks}: [Could not understand audio]")\n        except sr.RequestError as e:\n            print(f"Chunk {i+1}/{num_chunks}: Error - {e}")\n        finally:\n            os.remove(chunk_path)\n    \n    return {\'segments\': segments, \'text\': full_text}\n\ndef detect_filler_words(result):\n    """Detect filler words from transcription result"""\n    annotations = []\n    seen = set()\n    \n    # Process segments to find filler words\n    for segment in result[\'segments\']:\n        text = segment[\'text\'].lower().strip()\n        start_time = segment[\'start\']\n        end_time = segment[\'end\']\n        \n        # Check each filler word\n        for filler in FILLER_WORDS:\n            # Use word boundaries for better matching\n            pattern = r\'\\b\' + re.escape(filler) + r\'\\b\'\n            matches = re.finditer(pattern, text)\n            \n            for match in matches:\n                # Estimate timestamp based on character position\n                char_pos = match.start()\n                text_length = len(text)\n                if text_length > 0:\n                    relative_pos = char_pos / text_length\n                    timestamp = start_time + (relative_pos * (end_time - start_time))\n                else:\n                    timestamp = start_time\n                \n                # Avoid duplicates\n                key = (filler, round(timestamp, 1))\n                if key not in seen:\n                    annotations.append({\n                        "word": filler,\n                        "timestamp": round(timestamp, 1)\n                    })\n                    seen.add(key)\n    \n    return annotations\n\ndef extract_and_stitch_clips(video_path, annotations, output_path):\n    """Extract clips at filler word timestamps and stitch them"""\n    if not annotations:\n        print("No filler words found!")\n        # Create empty video\n        cmd = [\'ffmpeg\', \'-f\', \'lavfi\', \'-i\', \'color=c=black:s=1280x720:d=1\', \n               \'-f\', \'lavfi\', \'-i\', \'anullsrc=r=44100:cl=mono:d=1\',\n               \'-c:v\', \'libx264\', \'-preset\', \'ultrafast\', \'-c:a\', \'aac\', \'-y\', output_path]\n        subprocess.run(cmd, capture_output=True)\n        return\n    \n    print(f"Extracting {len(annotations)} clips...")\n    \n    # Create a temporary directory for clips\n    clips_dir = "/tmp/filler_clips"\n    os.makedirs(clips_dir, exist_ok=True)\n    \n    clip_files = []\n    \n    # Extract each clip (0.5 seconds around each filler word)\n    for i, annotation in enumerate(annotations):\n        timestamp = annotation[\'timestamp\']\n        start = max(0, timestamp - 0.25)\n        duration = 0.5\n        \n        clip_path = f"{clips_dir}/clip_{i:04d}.mp4"\n        \n        cmd = [\n            \'ffmpeg\',\n            \'-i\', video_path,\n            \'-ss\', str(start),\n            \'-t\', str(duration),\n            \'-c:v\', \'libx264\',\n            \'-preset\', \'ultrafast\',\n            \'-c:a\', \'aac\',\n            \'-y\',\n            clip_path\n        ]\n        \n        result = subprocess.run(cmd, capture_output=True)\n        if result.returncode == 0:\n            clip_files.append(clip_path)\n        else:\n            print(f"Warning: Failed to extract clip {i}")\n    \n    if not clip_files:\n        print("No clips extracted!")\n        return\n    \n    # Create concat file for ffmpeg\n    concat_file = "/tmp/concat.txt"\n    with open(concat_file, \'w\') as f:\n        for clip_file in clip_files:\n            f.write(f"file \'{clip_file}\'\\n")\n    \n    print(f"Stitching {len(clip_files)} clips...")\n    \n    # Concat clips\n    cmd = [\n        \'ffmpeg\',\n        \'-f\', \'concat\',\n        \'-safe\', \'0\',\n        \'-i\', concat_file,\n        \'-c:v\', \'libx264\',\n        \'-preset\', \'ultrafast\',\n        \'-c:a\', \'aac\',\n        \'-y\',\n        output_path\n    ]\n    \n    result = subprocess.run(cmd, capture_output=True)\n    if result.returncode != 0:\n        print(f"Error stitching clips: {result.stderr.decode()}")\n    \n    # Clean up\n    for clip_file in clip_files:\n        try:\n            os.remove(clip_file)\n        except:\n            pass\n    try:\n        os.remove(concat_file)\n        os.rmdir(clips_dir)\n    except:\n        pass\n    \n    print(f"Output video saved to {output_path}")\n\ndef main():\n    input_video = "/root/input.mp4"\n    audio_file = "/tmp/audio.mp3"\n    output_json = "/root/annotations.json"\n    output_video = "/root/output.mp4"\n    \n    # Extract audio\n    extract_audio(input_video, audio_file)\n    \n    # Transcribe\n    result = transcribe_audio_chunks(audio_file)\n    \n    # Detect filler words\n    annotations = detect_filler_words(result)\n    \n    # Save annotations\n    with open(output_json, \'w\') as f:\n        json.dump(annotations, f, indent=2)\n    \n    print(f"Saved {len(annotations)} annotations to {output_json}")\n    print(f"Annotations: {annotations}")\n    \n    # Extract and stitch clips\n    extract_and_stitch_clips(input_video, annotations, output_video)\n    \n    # Clean up audio\n    try:\n        os.remove(audio_file)\n    except:\n        pass\n    \n    print("Done!")\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
