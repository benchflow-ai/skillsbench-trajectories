Sending keys: ['cat << \'EOF\' > solution.py\nimport requests\nimport csv\nimport io\nimport pandas as pd\n\n# 1. Load station IDs\nwith open(\'/root/data/michigan_stations.txt\', \'r\') as f:\n    station_ids = [line.strip() for line in f if line.strip()]\n\n# 2. Download NWS thresholds\nnws_url = "https://water.noaa.gov/resources/downloads/reports/nwps_all_gauges_report.csv"\nprint("Downloading NWS thresholds...")\nresponse = requests.get(nws_url)\ncontent = response.text\nreader = csv.reader(io.StringIO(content))\nheaders = next(reader)\ndata = [row[:43] for row in reader]  # Truncate to 43 columns per SKILL.md\nnws_df = pd.DataFrame(data, columns=headers)\n\n# 3. Filter NWS thresholds for our stations\nnws_df[\'flood stage\'] = pd.to_numeric(nws_df[\'flood stage\'], errors=\'coerce\')\nthresholds = {}\nfor _, row in nws_df.iterrows():\n    usgs_id = str(row[\'usgs id\']).strip().zfill(8)\n    if usgs_id in station_ids:\n        if not pd.isna(row[\'flood stage\']) and row[\'flood stage\'] != -9999:\n            thresholds[usgs_id] = row[\'flood stage\']\n\nprint(f"Found thresholds for {len(thresholds)} out of {len(station_ids)} stations.")\n\n# 4. Fetch USGS data and detect floods\nflood_results = []\nstart_date = \'2025-04-01\'\nend_date = \'2025-04-07\'\n\nfor usgs_id in station_ids:\n    if usgs_id not in thresholds:\n        continue\n    \n    threshold = thresholds[usgs_id]\n    # Fetch daily values (dv) for gage height (00065)\n    # We want daily maximum (statCd=00001)\n    usgs_url = f"https://waterservices.usgs.gov/nwis/dv/?format=json&sites={usgs_id}&startDT={start_date}&endDT={end_date}&parameterCd=00065&statCd=00001"\n    \n    try:\n        r = requests.get(usgs_url)\n        if r.status_code != 200:\n            continue\n        \n        data = r.json()\n        time_series = data.get(\'value\', {}).get(\'timeSeries\', [])\n        if not time_series:\n            continue\n        \n        values = time_series[0].get(\'values\', [{}])[0].get(\'value\', [])\n        \n        flood_days = 0\n        for entry in values:\n            val = float(entry[\'value\'])\n            if val >= threshold:\n                flood_days += 1\n        \n        if flood_days > 0:\n            flood_results.append({\'station_id\': usgs_id, \'flood_days\': flood_days})\n            print(f"Station {usgs_id}: {flood_days} flood days")\n            \n    except Exception as e:\n        print(f"Error processing {usgs_id}: {e}")\n\n# 5. Save results\nwith open(\'/root/output/flood_results.csv\', \'w\', newline=\'\') as f:\n    writer = csv.writer(f)\n    writer.writerow([\'station_id\', \'flood_days\'])\n    for result in flood_results:\n        writer.writerow([result[\'station_id\'], result[\'flood_days\']])\n\nprint("Done!")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
