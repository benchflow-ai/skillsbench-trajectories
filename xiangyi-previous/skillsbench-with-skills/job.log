Sending keys: ['cat << \'EOF\' > harmonize.py\nimport pandas as pd\nimport numpy as np\n\n# Load data\n# We know the first row is header\ndf = pd.read_csv(\'/root/environment/data/ckd_lab_data.csv\')\n\n# Cleaning function\ndef clean_value(x):\n    if pd.isna(x):\n        return np.nan\n    if isinstance(x, (int, float)):\n        return float(x)\n    x = str(x).strip()\n    if x == \'\':\n        return np.nan\n    # Replace comma with dot\n    x = x.replace(\',\', \'.\')\n    try:\n        return float(x)\n    except:\n        return np.nan\n\n# Apply cleaning\nfor col in df.columns:\n    if col != \'patient_id\':\n        df[col] = df[col].apply(clean_value)\n\n# Drop rows with missing values\ndf = df.dropna()\n\n# Harmonization Rules\n# Feature: (Threshold, Operation, Factor)\n# Operation: \'div\' means if value > threshold, divide by factor\n# Operation: \'mul\' means if value < threshold, multiply by factor\n\nrules = {\n    \'Serum_Creatinine\': (20, \'div\', 88.4),\n    \'BUN\': (10, \'mul\', 2.8),\n    \'Total_Bilirubin\': (5, \'div\', 17.1),\n    \'Direct_Bilirubin\': (5, \'div\', 17.1),\n    \'Albumin_Serum\': (10, \'div\', 10.0),\n    \'Total_Protein\': (15, \'div\', 10.0),\n    \'Glucose\': (30, \'mul\', 18.0182),\n    \'Uric_Acid\': (20, \'div\', 59.48),\n    \'Serum_Iron\': (40, \'mul\', 5.58),\n    \'Total_Cholesterol\': (15, \'mul\', 38.67),\n    \'LDL_Cholesterol\': (15, \'mul\', 38.67),\n    \'HDL_Cholesterol\': (15, \'mul\', 38.67),\n    \'Non_HDL_Cholesterol\': (15, \'mul\', 38.67),\n    \'Triglycerides\': (10, \'mul\', 88.57),\n    \'Lactate\': (10, \'mul\', 9.008),\n    \'pO2_Arterial\': (20, \'mul\', 7.5006),\n    \'pCO2_Arterial\': (10, \'mul\', 7.5006),\n    \'Troponin_I\': (100, \'div\', 1000.0),\n    \'Troponin_T\': (100, \'div\', 1000.0),\n    \'Magnesium\': (1.2, \'mul\', 2.43), # Assuming mmol/L < 1.2 -> mg/dL\n    \'Phosphate\': (2.0, \'mul\', 3.097), # Assuming mmol/L < 2.0 -> mg/dL\n    \'Calcium\': (4.0, \'mul\', 4.0), # Assuming mmol/L < 4.0 -> mg/dL (approx factor 4)\n}\n\n# Apply rules\nfor col, (threshold, op, factor) in rules.items():\n    if col in df.columns:\n        if op == \'div\':\n            df[col] = df[col].apply(lambda x: x / factor if x > threshold else x)\n        elif op == \'mul\':\n            df[col] = df[col].apply(lambda x: x * factor if x < threshold else x)\n\n# Round to 2 decimal places\nfor col in df.columns:\n    if col != \'patient_id\':\n        df[col] = df[col].round(2)\n\n# Save output\ndf.to_csv(\'/root/ckd_lab_data_harmonized.csv\', index=False, float_format=\'%.2f\')\nprint("Harmonization complete. Saved to /root/ckd_lab_data_harmonized.csv")\nEOF\npython3 harmonize.py\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
