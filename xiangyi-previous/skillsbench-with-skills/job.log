Glucose: mg/dL. If < 20, likely mmol/L.\n    if row[\'Glucose\'] < 25: row[\'Glucose\'] *= 18.0\n    \n    # Uric_Acid: mg/dL. If > 20, likely umol/L (or it\'s just very high mg/dL, but 1189 is definitely umol/L)\n    if row[\'Uric_Acid\'] > 50: row[\'Uric_Acid\'] /= 16.8\n\n    # Cholesterol features: mg/dL. If < 15, likely mmol/L.\n    for col in [\'Total_Cholesterol\', \'LDL_Cholesterol\', \'HDL_Cholesterol\', \'Triglycerides\', \'Non_HDL_Cholesterol\']:\n        if row[col] < 15: \n            if \'Triglycerides\' in col:\n                row[col] *= 88.5\n            else:\n                row[col] *= 38.6\n\n    # Bilirubin: mg/dL. If > 5, likely umol/L.\n    if row[\'Total_Bilirubin\'] > 5: row[\'Total_Bilirubin\'] /= 17.1\n    if row[\'Direct_Bilirubin\'] > 5: row[\'Direct_Bilirubin\'] /= 17.1\n\n    # Iron: ug/dL. If < 5, likely umol/L.\n    if row[\'Serum_Iron\'] < 10: row[\'Serum_Iron\'] *= 5.59\n    \n    return row\n\ndf = df.apply(harmonize, axis=1)\n\n# Round to 2 decimal places and format as X.XX\nfor col in df.columns:\n    if col != \'patient_id\':\n        df[col] = df[col].apply(lambda x: "{:.2f}".format(x))\n\ndf.to_csv(\'/root/ckd_lab_data_harmonized.csv\', index=False)\nEOF\npython3 process_data.py\nhead -n 5 /root/ckd_lab_data_harmonized.csv\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
