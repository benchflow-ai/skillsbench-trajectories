Sending keys: ['cat >> solve_acopf.py << \'EOF\'\n\n# Calculate branch flows and find most loaded\nV_sol = Vm_sol * np.exp(1j * Va_sol)\nbranch_data = []\n\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    \n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    \n    Sf = ((Ys + Ysh/2) / (tr * np.conj(tr))) * V_sol[f] * np.conj(V_sol[f]) - (Ys / np.conj(tr)) * V_sol[f] * np.conj(V_sol[t])\n    St = (Ys + Ysh/2) * V_sol[t] * np.conj(V_sol[t]) - (Ys / tr) * V_sol[t] * np.conj(V_sol[f])\n    \n    Sf_MVA = np.abs(Sf) * baseMVA\n    St_MVA = np.abs(St) * baseMVA\n    limit_MVA = rate_a[i] * baseMVA if rate_a[i] > 0 else 9999.0\n    \n    loading_pct = (max(Sf_MVA, St_MVA) / limit_MVA * 100) if limit_MVA > 0 else 0\n    \n    branch_data.append({\n        \'from_bus\': int(fbus[i] + 1),\n        \'to_bus\': int(tbus[i] + 1),\n        \'loading_pct\': loading_pct,\n        \'flow_from_MVA\': Sf_MVA,\n        \'flow_to_MVA\': St_MVA,\n        \'limit_MVA\': limit_MVA\n    })\n\nbranch_data.sort(key=lambda x: x[\'loading_pct\'], reverse=True)\nmost_loaded = branch_data[:10]\n\nprint(f"\\nMost loaded branch: {most_loaded[0][\'loading_pct\']:.2f}%")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
