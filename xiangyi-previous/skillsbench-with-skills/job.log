Sending keys: ['cat > /root/analyze_video.py << \'EOF\'\nimport cv2\nimport numpy as np\nimport json\nfrom scipy import sparse\n\ndef extract_frames(video_path, target_fps=6):\n    """Extract frames at target FPS."""\n    cap = cv2.VideoCapture(video_path)\n    original_fps = cap.get(cv2.CAP_PROP_FPS)\n    frame_interval = int(round(original_fps / target_fps))\n    \n    frames = []\n    frame_idx = 0\n    \n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n        if frame_idx % frame_interval == 0:\n            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n            frames.append(gray)\n        frame_idx += 1\n    \n    cap.release()\n    print(f"Extracted {len(frames)} frames at {target_fps} FPS (interval: {frame_interval})")\n    return frames\n\ndef compute_optical_flow(prev_frame, curr_frame):\n    """Compute dense optical flow using Farneback method."""\n    flow = cv2.calcOpticalFlowFarneback(\n        prev_frame, curr_frame, None,\n        pyr_scale=0.5, levels=3, winsize=15,\n        iterations=3, poly_n=5, poly_sigma=1.2, flags=0\n    )\n    return flow\n\ndef estimate_homography(prev_frame, curr_frame):\n    """Estimate homography between frames using feature matching."""\n    orb = cv2.ORB_create(nfeatures=1000)\n    kp1, des1 = orb.detectAndCompute(prev_frame, None)\n    kp2, des2 = orb.detectAndCompute(curr_frame, None)\n    \n    if des1 is None or des2 is None or len(kp1) < 4 or len(kp2) < 4:\n        return None, None\n    \n    bf = cv2.BFMatcher(cv2.NORM_HAMMING, crossCheck=True)\n    matches = bf.match(des1, des2)\n    \n    if len(matches) < 4:\n        return None, None\n    \n    matches = sorted(matches, key=lambda x: x.distance)\n    \n    src_pts = np.float32([kp1[m.queryIdx].pt for m in matches]).reshape(-1, 1, 2)\n    dst_pts = np.float32([kp2[m.trainIdx].pt for m in matches]).reshape(-1, 1, 2)\n    \n    H, mask = cv2.findHomography(src_pts, dst_pts, cv2.RANSAC, 5.0)\n    \n    return H, mask\n\ndef classify_camera_motion(flow, H, h, w):\n    """Classify camera motion based on optical flow and homography."""\n    labels = []\n    \n    # Compute mean flow\n    flow_x = flow[:, :, 0]\n    flow_y = flow[:, :, 1]\n    mean_flow_x = np.mean(flow_x)\n    mean_flow_y = np.mean(flow_y)\n    \n    # Compute flow magnitude\n    magnitude = np.sqrt(flow_x**2 + flow_y**2)\n    mean_magnitude = np.mean(magnitude)\n    \n    # Thresholds\n    motion_threshold = 1.5  # pixels\n    \n    if mean_magnitude < motion_threshold:\n        return ["Stay"]\n    \n    # Analyze flow pattern for different motion types\n    # Pan: horizontal translation (negative flow_x = camera moving right = Pan Right)\n    # Tilt: vertical translation (negative flow_y = camera moving up = Tilt Up)\n    # Dolly: radial flow (in = Dolly In, out = Dolly Out)\n    # Roll: rotational flow around center\n    \n    # Check for pan (horizontal motion)\n    if abs(mean_flow_x) > motion_threshold:\n        if mean_flow_x < 0:\n            labels.append("Pan Right")\n        else:\n            labels.append("Pan Left")\n    \n    # Check for tilt (vertical motion)\n    if abs(mean_flow_y) > motion_threshold:\n        if mean_flow_y < 0:\n            labels.append("Tilt Down")\n        else:\n            labels.append("Tilt Up")\n    \n    # Check for dolly (zoom) - radial flow pattern\n    cy, cx = h // 2, w // 2\n    y_coords, x_coords = np.mgrid[0:h, 0:w]\n    \n    # Vector from center to each pixel\n    dx = x_coords - cx\n    dy = y_coords - cy\n    \n    # Normalize\n    dist = np.sqrt(dx**2 + dy**2) + 1e-6\n    dx_norm = dx / dist\n    dy_norm = dy / dist\n    \n    # Radial component of flow (positive = outward = dolly in, camera approaching)\n    radial_flow = flow_x * dx_norm + flow_y * dy_norm\n    mean_radial = np.mean(radial_flow)\n    \n    if abs(mean_radial) > motion_threshold * 0.5:\n        if mean_radial > 0:  # Flow going outward = objects getting bigger = Dolly In\n            labels.append("Dolly In")\n        else:\n            labels.append("Dolly Out")\n    \n    # Check for roll - tangential flow pattern\n    tangent_flow = -flow_x * dy_norm + flow_y * dx_norm\n    mean_tangent = np.mean(tangent_flow)\n    \n    if abs(mean_tangent) > motion_threshold * 0.5:\n        if mean_tangent > 0:\n            labels.append("Roll Left")\n        else:\n            labels.append("Roll Right")\n    \n    if not labels:\n        labels = ["Stay"]\n    \n    return labels\n\ndef detect_dynamic_objects(flow, H, prev_frame, curr_frame):\n    """Detect dynamic objects by finding regions inconsistent with global motion."""\n    h, w = prev_frame.shape\n    \n    if H is None:\n        # Fall back to mean flow subtraction\n        mean_flow = np.mean(flow, axis=(0, 1))\n        residual_flow = flow - mean_flow\n    else:\n        # Warp previous frame using homography and compare\n        y_coords, x_coords = np.mgrid[0:h, 0:w].astype(np.float32)\n        \n        # Compute expected flow from homography\n        ones = np.ones((h, w), dtype=np.float32)\n        pts = np.stack([x_coords, y_coords, ones], axis=-1)\n        \n        # Apply homography\n        H_inv = np.linalg.inv(H) if H is not None else np.eye(3)\n        warped_pts = np.einsum(\'ij,...j->...i\', H, pts)\n        warped_pts = warped_pts[..., :2] / (warped_pts[..., 2:3] + 1e-6)\n        \n        expected_flow = warped_pts - np.stack([x_coords, y_coords], axis=-1)\n        residual_flow = flow - expected_flow\n    \n    # Compute residual magnitude\n    residual_mag = np.sqrt(residual_flow[:, :, 0]**2 + residual_flow[:, :, 1]**2)\n    \n    # Threshold to get dynamic mask\n    threshold = np.percentile(residual_mag, 85)  # Top 15% as potential dynamic\n    threshold = max(threshold, 2.0)  # Minimum threshold\n    \n    dynamic_mask = residual_mag > threshold\n    \n    # Clean up mask with morphological operations\n    kernel = cv2.getStructuringElement(cv2.MORPH_ELLIPSE, (5, 5))\n    dynamic_mask = cv2.morphologyEx(dynamic_mask.astype(np.uint8), cv2.MORPH_OPEN, kernel)\n    dynamic_mask = cv2.morphologyEx(dynamic_mask, cv2.MORPH_CLOSE, kernel)\n    \n    return dynamic_mask.astype(bool)\n\ndef main():\n    video_path = "/root/input.mp4"\n    \n    # Extract frames\n    frames = extract_frames(video_path, target_fps=6)\n    \n    if len(frames) < 2:\n        print("Not enough frames")\n        return\n    \n    h, w = frames[0].shape\n    print(f"Frame size: {w}x{h}")\n    \n    # Analyze motion and detect dynamic objects\n    motion_labels = {}\n    masks_data = {"shape": [h, w]}\n    \n    for i in range(len(frames) - 1):\n        prev_frame = frames[i]\n        curr_frame = frames[i + 1]\n        \n        # Compute optical flow\n        flow = compute_optical_flow(prev_frame, curr_frame)\n        \n        # Estimate homography\n        H, inlier_mask = estimate_homography(prev_frame, curr_frame)\n        \n        # Classify camera motion\n        labels = classify_camera_motion(flow, H, h, w)\n        motion_labels[f"{i}->{i+1}"] = labels\n        print(f"Frame {i}->{i+1}: {labels}")\n        \n        # Detect dynamic objects\n        dynamic_mask = detect_dynamic_objects(flow, H, prev_frame, curr_frame)\n        \n        # Store mask in CSR format\n        csr = sparse.csr_matrix(dynamic_mask)\n        masks_data[f"f_{i}_data"] = csr.data\n        masks_data[f"f_{i}_indices"] = csr.indices\n        masks_data[f"f_{i}_indptr"] = csr.indptr\n    \n    # Handle last frame (use same mask as previous)\n    last_idx = len(frames) - 1\n    if last_idx > 0:\n        masks_data[f"f_{last_idx}_data"] = masks_data[f"f_{last_idx-1}_data"]\n        masks_data[f"f_{last_idx}_indices"] = masks_data[f"f_{last_idx-1}_indices"]\n        masks_data[f"f_{last_idx}_indptr"] = masks_data[f"f_{last_idx-1}_indptr"]\n    \n    # Save results\n    with open("/root/pred_instructions.json", "w") as f:\n        json.dump(motion_labels, f, indent=2)\n    print(f"Saved motion labels to /root/pred_instructions.json")\n    \n    np.savez("/root/pred_dyn_masks.npz", **masks_data)\n    print(f"Saved dynamic masks to /root/pred_dyn_masks.npz")\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
