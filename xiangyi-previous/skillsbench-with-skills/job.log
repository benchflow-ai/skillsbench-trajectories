Sending keys: ['cat <<EOF > /root/output/js/visualization.js\nd3.csv("data/stock-descriptions.csv").then(data => {\n    const width = 600;\n    const height = 600;\n\n    // Process data\n    data.forEach(d => {\n        d.marketCap = d.marketCap ? +d.marketCap : null;\n    });\n\n    const sectors = Array.from(new Set(data.map(d => d.sector)));\n    const color = d3.scaleOrdinal().domain(sectors).range(d3.schemeCategory10);\n\n    const sizeScale = d3.scaleSqrt()\n        .domain([0, d3.max(data, d => d.marketCap || 0)])\n        .range([10, 60]);\n\n    const nodes = data.map(d => ({\n        ...d,\n        radius: d.marketCap ? sizeScale(d.marketCap) : 20\n    }));\n\n    const simulation = d3.forceSimulation(nodes)\n        .force("x", d3.forceX(width / 2).strength(0.05))\n        .force("y", d3.forceY(height / 2).strength(0.05))\n        .force("collide", d3.forceCollide(d => d.radius + 2))\n        .force("sectorX", d3.forceX(d => {\n            const idx = sectors.indexOf(d.sector);\n            return (idx % 3 + 1) * (width / 4);\n        }).strength(0.1))\n        .force("sectorY", d3.forceY(d => {\n            const idx = sectors.indexOf(d.sector);\n            return (Math.floor(idx / 3) + 1) * (height / 4);\n        }).strength(0.1));\n\n    const svg = d3.select("#bubble-chart")\n        .append("svg")\n        .attr("width", width)\n        .attr("height", height);\n\n    const tooltip = d3.select("body").append("div").attr("class", "tooltip");\n\n    const bubbles = svg.selectAll(".bubble-group")\n        .data(nodes)\n        .enter()\n        .append("g")\n        .attr("class", "bubble-group")\n        .on("mouseover", (event, d) => {\n            if (d.sector !== "ETF" && d.marketCap) {\n                tooltip.style("display", "block")\n                    .html("<strong>" + d.ticker + "</strong><br>" + d["full name"] + "<br>" + d.sector);\n            }\n        })\n        .on("mousemove", (event) => {\n            tooltip.style("left", (event.pageX + 10) + "px")\n                .style("top", (event.pageY + 10) + "px");\n        })\n        .on("mouseout", () => tooltip.style("display", "none"))\n        .on("click", (event, d) => {\n            highlightRow(d.ticker);\n            highlightBubble(d.ticker);\n        });\n\n    bubbles.append("circle")\n        .attr("class", "bubble")\n        .attr("r", d => d.radius)\n        .attr("fill", d => color(d.sector))\n        .attr("stroke", "#999");\n\n    bubbles.append("text")\n        .attr("text-anchor", "middle")\n        .attr("dy", ".3em")\n        .style("font-size", d => Math.min(d.radius / 2, 12) + "px")\n        .style("pointer-events", "none")\n        .text(d => d.ticker);\n\n    simulation.on("tick", () => {\n        bubbles.attr("transform", d => \\`translate(\\${d.x},\\${d.y})\\`);\n    });\n\n    // Legend\n    const legend = d3.select("#legend");\n    sectors.forEach(sector => {\n        const item = legend.append("div").attr("class", "legend-item");\n        item.append("div").attr("class", "legend-color").style("background-color", color(sector));\n        item.append("span").text(sector);\n    });\n\n    // Table\n    const tableBody = d3.select("#stock-table tbody");\n    const rows = tableBody.selectAll("tr")\n        .data(data)\n        .enter()\n        .append("tr")\n        .attr("id", d => "row-" + d.ticker)\n        .on("click", (event, d) => {\n            highlightRow(d.ticker);\n            highlightBubble(d.ticker);\n        });\n\n    rows.append("td").text(d => d.ticker);\n    rows.append("td").text(d => d["full name"]);\n    rows.append("td").text(d => d.sector);\n    rows.append("td").text(d => formatMarketCap(d.marketCap));\n\n    function formatMarketCap(val) {\n        if (!val) return "N/A";\n        if (val >= 1e12) return (val / 1e12).toFixed(2) + "T";\n        if (val >= 1e9) return (val / 1e9).toFixed(2) + "B";\n        if (val >= 1e6) return (val / 1e6).toFixed(2) + "M";\n        return val.toLocaleString();\n    }\n\n    function highlightRow(ticker) {\n        d3.selectAll("tr").classed("highlight", false);\n        const row = d3.select("#row-" + ticker);\n        row.classed("highlight", true);\n        row.node().scrollIntoView({ behavior: "smooth", block: "center" });\n    }\n\n    function highlightBubble(ticker) {\n        d3.selectAll("circle").style("stroke", "#999").style("stroke-width", "1px");\n        d3.selectAll(".bubble-group").filter(d => d.ticker === ticker)\n            .select("circle")\n            .style("stroke", "black")\n            .style("stroke-width", "3px");\n    }\n});\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
