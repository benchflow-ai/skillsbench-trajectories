)\n            return ' '.join(text_parts)\n        except Exception:\n            return ''\n    return ''\n\nfiles = sorted(glob.glob('*.pdf') + glob.glob('*.docx') + glob.glob('*.pptx'))\nresults = {}\nambiguous = []\nfor f in files:\n    t = extract_text(f).lower()\n    scores = {cat:0 for cat in keywords}\n    for cat, keys in keywords.items():\n        for k in keys:\n            if k in t:\n                scores[cat] += t.count(k)\n    # pick highest score\n    best = max(scores, key=scores.get)\n    best_score = scores[best]\n    results[f]= (best, scores)\n    if best_score == 0:\n        ambiguous.append(f)\n\nfrom collections import Counter\nprint('Counts:', Counter([v[0] for v in results.values()]))\nprint('Zero-score files:', len(ambiguous))\nfor f in ambiguous[:10]:\n    print(' ',f)\n\n# show sample of potential misclassifications: where music score >0 but not classified as music, etc.\nfor cat in keywords:\n    pass\n\n# show top 5 files where music score >0 but classified other\nprint('\\nMusic-related but not classified as music_history:')\nfor f,(best,scores) in results.items():\n    if scores['music_history']>0 and best!='music_history':\n        print(f, best, scores)\n\nprint('\\nDNA-related but not classified as DNA:')\nfor f,(best,scores) in results.items():\n    if scores['DNA']>0 and best!='DNA':\n        print(f, best, scores)\n\nprint('\\nTrapped-ion/QC-related but not classified as trapped_ion_and_qc:')\nfor f,(best,scores) in results.items():\n    if scores['trapped_ion_and_qc']>0 and best!='trapped_ion_and_qc':\n        print(f, best, scores)\n\nprint('\\nLLM-related but not classified as LLM:')\nfor f,(best,scores) in results.items():\n    if scores['LLM']>0 and best!='LLM':\n        print(f, best, scores)\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
