Sending keys: ['cat > /root/event_association.py << \'EOFPYTHON\'\nimport obspy\nfrom obspy import read, UTCDateTime\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime\nimport seisbench.models\nfrom collections import defaultdict\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Constants\nVP = 6.0  # km/s\nVS = VP / 1.75  # km/s\n\nprint("Loading data...")\nst = read(\'/root/data/wave.mseed\')\nstations_df = pd.read_csv(\'/root/data/stations.csv\')\n\n# Create station location lookup\nstation_locs = {}\nfor _, row in stations_df.iterrows():\n    key = f"{row[\'network\']}.{row[\'station\']}"\n    if key not in station_locs:\n        station_locs[key] = {\n            \'lon\': row[\'longitude\'],\n            \'lat\': row[\'latitude\'],\n            \'elev\': row[\'elevation_m\']\n        }\n\nprint(f"Found {len(station_locs)} unique stations")\n\n# Load PhaseNet model\nprint("Loading PhaseNet model...")\nmodel = seisbench.models.PhaseNet.from_pretrained("original")\n\n# Get Z channel traces\nz_traces = [tr for tr in st if tr.stats.channel.endswith(\'Z\')]\nz_stream = obspy.Stream(traces=z_traces)\n\nprint(f"Running phase picking on {len(z_stream)} traces...")\nannotations = model.annotate(z_stream)\n\n# Extract picks with higher threshold to reduce noise\nthreshold = 0.5\nprint(f"Extracting picks (threshold={threshold})...")\np_picks = model.picks_from_annotations(annotations, threshold, phase=\'P\')\ns_picks = model.picks_from_annotations(annotations, threshold, phase=\'S\')\n\nprint(f"Found {len(p_picks)} P picks and {len(s_picks)} S picks")\n\n# Organize picks by station\nall_picks = []\nfor pick in p_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split(\'.\')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'P\',\n            \'time\': pick_time,\n            \'time_float\': float(pick_time),\n            \'trace_id\': trace_id\n        })\n\nfor pick in s_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split(\'.\')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'S\',\n            \'time\': pick_time,\n            \'time_float\': float(pick_time),\n            \'trace_id\': trace_id\n        })\n\nprint(f"Total picks: {len(all_picks)}")\n\n# Group picks by station and phase\npicks_by_station = defaultdict(lambda: {\'P\': [], \'S\': []})\nfor pick in all_picks:\n    key = f"{pick[\'network\']}.{pick[\'station\']}"\n    picks_by_station[key][pick[\'phase\']].append(pick)\n\nprint(f"Picks organized at {len(picks_by_station)} stations")\n\n# Get all unique P times (potential event times)\nall_p_times = set()\nfor station, phases in picks_by_station.items():\n    for p_pick in phases[\'P\']:\n        all_p_times.add(p_pick[\'time_float\'])\n\nall_p_times = sorted(list(all_p_times))\nprint(f"Found {len(all_p_times)} unique P arrival times")\n\n# For each P time, try to find an event\nevents = []\n\nfor p_time_float in all_p_times:\n    p_time = UTCDateTime(p_time_float)\n    # For this potential event time, find all picks that could belong to it\n    event_picks = {\'P\': {}, \'S\': {}}\n    \n    for station, phases in picks_by_station.items():\n        # Find P pick close to p_time\n        for p_pick in phases[\'P\']:\n            if abs(p_pick[\'time_float\'] - p_time_float) < 0.5:  # Within 0.5 seconds\n                event_picks[\'P\'][station] = p_pick\n                break\n        \n        # Find S pick after the P pick\n        if station in event_picks[\'P\']:\n            p_pick_time = event_picks[\'P\'][station][\'time_float\']\n            for s_pick in phases[\'S\']:\n                s_time = s_pick[\'time_float\']\n                if s_time > p_pick_time and abs(s_time - p_pick_time - 3.0) < 1.5:\n                    event_picks[\'S\'][station] = s_pick\n                    break\n    \n    # Only keep events with picks at multiple stations\n    num_stations = len(event_picks[\'P\'])\n    if num_stations >= 3:  # At least 3 stations\n        events.append({\n            \'time\': p_time,\n            \'time_float\': p_time_float,\n            \'num_stations\': num_stations,\n            \'picks\': event_picks\n        })\n\nprint(f"\\nFound {len(events)} potential events")\nprint("Sample events:")\nfor event in events[:10]:\n    print(f"  Time: {event[\'time\']}, Stations: {event[\'num_stations\']}")\n\n# Remove duplicate events (within 2 seconds)\nfinal_events = []\nused = set()\n\nfor i, event in enumerate(events):\n    if i in used:\n        continue\n    \n    final_events.append(event)\n    \n    # Mark similar events as used\n    for j in range(i+1, len(events)):\n        if j not in used:\n            if abs(event[\'time_float\'] - events[j][\'time_float\']) < 2.0:\n                used.add(j)\n\nprint(f"\\nAfter deduplication: {len(final_events)} events")\n\n# Write results to CSV\nresults = []\nfor event in final_events:\n    iso_time = event[\'time\'].isoformat().replace(\'Z\', \'\')\n    results.append({\'time\': iso_time})\n\nresults_df = pd.DataFrame(results)\nresults_df.to_csv(\'/root/results.csv\', index=False)\nprint(f"\\nWrote {len(results_df)} events to /root/results.csv")\nprint("\\nFirst few events:")\nprint(results_df.head(10))\n\nEOFPYTHON\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
