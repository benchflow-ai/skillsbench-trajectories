Sending keys: ['cat > /tmp/q2_solution.py << \'EOFSCRIPT\'\nimport pandas as pd\nimport json\nimport numpy as np\n\nthermo = pd.read_csv(\'/app/data/thermocouples.csv\')\nmes = pd.read_csv(\'/app/data/mes_log.csv\')\n\nq2_results = []\n\nfor run_id in sorted(thermo[\'run_id\'].unique()):\n    # Get liquidus temp for this run\n    run_mes = mes[mes[\'run_id\'] == run_id]\n    if len(run_mes) == 0:\n        continue\n    \n    liquidus = run_mes[\'solder_liquidus_c\'].values[0]\n    \n    run_thermo = thermo[thermo[\'run_id\'] == run_id]\n    \n    for tc_id in run_thermo[\'tc_id\'].unique():\n        tc_data = run_thermo[run_thermo[\'tc_id\'] == tc_id].sort_values(\'time_s\')\n        \n        # Find time above liquidus\n        above_liq = tc_data[tc_data[\'temp_c\'] >= liquidus]\n        \n        if len(above_liq) < 2:\n            tal_s = 0\n        else:\n            times = above_liq[\'time_s\'].values\n            tal_s = float(times[-1] - times[0])\n        \n        q2_results.append({\n            \'run_id\': run_id,\n            \'tc_id\': tc_id,\n            \'tal_s\': round(tal_s, 2),\n            \'required_min_tal_s\': 30.0,\n            \'required_max_tal_s\': 60.0,\n            \'status\': \'compliant\' if 30 <= tal_s <= 60 else \'non-compliant\'\n        })\n\nq2_results_sorted = sorted(q2_results, key=lambda x: (x[\'run_id\'], x[\'tc_id\']))\n\nwith open(\'/app/output/q02.json\', \'w\') as f:\n    json.dump(q2_results_sorted, f, indent=2)\n\nprint(f"Q2: Done - {len(q2_results_sorted)} records")\nEOFSCRIPT\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
