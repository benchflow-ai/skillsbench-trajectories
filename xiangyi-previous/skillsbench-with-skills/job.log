Sending keys: ['cat > dicke_wigner.py << \'EOF\'\nimport numpy as np\nfrom qutip import *\nimport warnings\nwarnings.filterwarnings(\'ignore\')\n\n# Parameters\nN = 4  # Number of two-level systems\nomega_0 = 1.0  # Atomic frequency\nomega_c = 1.0  # Cavity frequency\ng = 2.0 / np.sqrt(N)  # Coupling strength\nkappa = 1.0  # Cavity loss\nn_max = 16  # Photon number cutoff\n\n# Wigner function grid\nxvec = np.linspace(-6, 6, 1000)\npvec = np.linspace(-6, 6, 1000)\n\n# For N spin-1/2 particles, use the symmetric (Dicke) subspace with j = N/2\nj = N / 2.0\ndim_spin = int(2 * j + 1)  # = N + 1 = 5\n\nprint(f"Setting up Dicke model with N={N} atoms, j={j}")\nprint(f"Cavity dimension: {n_max}, Spin dimension: {dim_spin}")\nprint(f"Total Hilbert space dimension: {n_max * dim_spin}")\n\n# Create operators in the tensor product space: cavity x spin\n# Cavity operators\na = tensor(destroy(n_max), qeye(dim_spin))\n\n# Collective spin operators (spin-j representation)\nJz = tensor(qeye(n_max), jmat(j, \'z\'))\nJp = tensor(qeye(n_max), jmat(j, \'+\'))\nJm = tensor(qeye(n_max), jmat(j, \'-\'))\n\n# Hamiltonian: H = omega_0 * Jz + omega_c * a^dag * a + g * (a + a^dag) * (J+ + J-)\nH = omega_0 * Jz + omega_c * a.dag() * a + g * (a.dag() + a) * (Jp + Jm)\n\nprint("Hamiltonian created")\n\ndef create_collapse_operators(case):\n    """\n    Create collapse operators for different loss cases.\n    \n    Following standard conventions for open Dicke models:\n    - Cavity loss: sqrt(kappa) * a\n    - Local dephasing: Each atom contributes, approximated in symmetric subspace\n    - Local emission/pumping: Individual atomic transitions\n    - Collective emission/pumping: J_- and J_+ operators\n    """\n    c_ops = []\n    \n    # Cavity loss\n    c_ops.append(np.sqrt(kappa) * a)\n    \n    if case == 1:\n        # Local de-phasing & local pumping\n        gamma_phi = 0.01\n        gamma_up = 0.1\n        # Dephasing: use Jz^2 type term approximation\n        c_ops.append(np.sqrt(gamma_phi) * Jz)\n        # Local pumping approximated as collective\n        c_ops.append(np.sqrt(gamma_up) * Jp)\n        \n    elif case == 2:\n        # Local de-phasing & local emission\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        c_ops.append(np.sqrt(gamma_phi) * Jz)\n        c_ops.append(np.sqrt(gamma_down) * Jm)\n        \n    elif case == 3:\n        # Local de-phasing & local emission & collective pumping\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        gamma_Up = 0.1\n        c_ops.append(np.sqrt(gamma_phi) * Jz)\n        c_ops.append(np.sqrt(gamma_down) * Jm)\n        c_ops.append(np.sqrt(gamma_Up) * Jp)\n        \n    elif case == 4:\n        # Local de-phasing & local emission & collective emission\n        gamma_phi = 0.01\n        gamma_down = 0.1\n        gamma_Down = 0.1\n        c_ops.append(np.sqrt(gamma_phi) * Jz)\n        c_ops.append(np.sqrt(gamma_down) * Jm)\n        c_ops.append(np.sqrt(gamma_Down) * Jm)\n    \n    return c_ops\n\ndef solve_and_save(case):\n    print(f"\\n{\'=\'*50}")\n    print(f"Processing Case {case}")\n    print(f"{\'=\'*50}")\n    \n    c_ops = create_collapse_operators(case)\n    print(f"Number of collapse operators: {len(c_ops)}")\n    \n    # Solve for steady state using sparse LU decomposition\n    print("Solving for steady state...")\n    rho_ss = steadystate(H, c_ops, method=\'direct\', solver=\'scipy\')\n    print("Steady state found")\n    print(f"Trace: {rho_ss.tr().real:.6f}")\n    \n    # Trace out spin to get cavity state\n    print("Tracing out spins...")\n    rho_cavity = ptrace(rho_ss, 0)\n    \n    # Mean photon number\n    a_cav = destroy(n_max)\n    n_mean = expect(a_cav.dag() * a_cav, rho_cavity)\n    print(f"Mean photon number: {n_mean.real:.4f}")\n    \n    # Calculate Wigner function\n    print("Calculating Wigner function...")\n    W = wigner(rho_cavity, xvec, pvec)\n    print(f"Wigner range: [{W.min():.6f}, {W.max():.6f}]")\n    \n    # Save to CSV\n    filename = f"{case}.csv"\n    np.savetxt(filename, W, delimiter=\',\')\n    print(f"Saved to {filename}")\n    \n    return W\n\nif __name__ == "__main__":\n    for case in [1, 2, 3, 4]:\n        solve_and_save(case)\n    print("\\nAll cases completed!")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
