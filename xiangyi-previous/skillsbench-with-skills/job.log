n(p_picks)} P picks and {len(s_picks)} S picks")\n\n# Organize picks by station\nall_picks = []\nfor pick in p_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split(\'.\')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'P\',\n            \'time\': pick_time,\n            \'time_float\': float(pick_time),\n            \'trace_id\': trace_id\n        })\n\nfor pick in s_picks:\n    trace_id = pick.trace_id\n    parts = trace_id.split(\'.\')\n    if len(parts) >= 2:\n        network, station = parts[0], parts[1]\n        pick_time = pick.peak_time\n        if not isinstance(pick_time, UTCDateTime):\n            pick_time = UTCDateTime(pick_time)\n        all_picks.append({\n            \'network\': network,\n            \'station\': station,\n            \'phase\': \'S\',\n            \'time\': pick_time,\n            \'time_float\': float(pick_time),\n            \'trace_id\': trace_id\n        })\n\nprint(f"Total picks: {len(all_picks)}")\n\n# Group picks by station and phase\npicks_by_station = defaultdict(lambda: {\'P\': [], \'S\': []})\nfor pick in all_picks:\n    key = f"{pick[\'network\']}.{pick[\'station\']}"\n    picks_by_station[key][pick[\'phase\']].append(pick)\n\nprint(f"Picks organized at {len(picks_by_station)} stations")\n\n# Create feature vectors for clustering: (time, station_index)\n# Use P pick times as primary feature\nfeatures = []\nfeature_to_pick = {}\nstation_list = list(picks_by_station.keys())\n\nfor station_idx, station in enumerate(station_list):\n    for p_pick in picks_by_station[station][\'P\']:\n        features.append([p_pick[\'time_float\'], station_idx])\n        feature_to_pick[len(features)-1] = (station, p_pick)\n\nfeatures = np.array(features)\nprint(f"Created {len(features)} feature vectors")\n\n# Cluster picks: picks are close in time and from different stations\nif len(features) > 0:\n    # Normalize features for clustering\n    features_norm = features.copy()\n    features_norm[:, 0] = (features[:, 0] - features[:, 0].min()) / (features[:, 0].max() - features[:, 0].min())\n    features_norm[:, 1] = features_norm[:, 1] / len(station_list)\n    \n    # DBSCAN clustering\n    clustering = DBSCAN(eps=0.05, min_samples=3).fit(features_norm)\n    labels = clustering.labels_\n    \n    # Group by cluster\n    clusters = defaultdict(list)\n    for idx, label in enumerate(labels):\n        if label >= 0:  # Ignore noise points (label == -1)\n            clusters[label].append(idx)\n    \n    print(f"Found {len(clusters)} clusters")\n    \n    # Extract events from clusters\n    events = []\n    for cluster_id, feature_indices in clusters.items():\n        if len(feature_indices) >= 3:  # At least 3 stations\n            # Get picks for this cluster\n            cluster_picks = []\n            unique_stations = set()\n            for feat_idx in feature_indices:\n                station, pick = feature_to_pick[feat_idx]\n                cluster_picks.append(pick)\n                unique_stations.add(station)\n            \n            if len(unique_stations) >= 3:\n                # Use median P time as event time\n                times = [p[\'time_float\'] for p in cluster_picks]\n                event_time = UTCDateTime(np.median(times))\n                \n                events.append({\n                    \'time\': event_time,\n                    \'time_float\': float(event_time),\n                    \'num_stations\': len(unique_stations),\n                    \'picks\': cluster_picks\n                })\n    \n    print(f"Found {len(events)} events from clustering")\n    \n    # Sort by time\n    events = sorted(events, key=lambda x: x[\'time_float\'])\n    \n    # Write results to CSV\n    results