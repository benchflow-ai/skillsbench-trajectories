Sending keys: ['cat > /app/solve.py << \'EOF\'\nimport json\nimport csv\nfrom copy import deepcopy\n\n# Parse instance.txt\ndef parse_instance(filename):\n    with open(filename, \'r\') as f:\n        lines = [l.strip() for l in f.readlines() if l.strip()]\n    \n    jobs = []\n    i = 0\n    while i < len(lines):\n        num_ops = int(lines[i])\n        i += 1\n        ops = []\n        for _ in range(num_ops):\n            parts = list(map(int, lines[i].split()))\n            i += 1\n            num_alts = parts[0]\n            alternatives = []\n            idx = 1\n            for _ in range(num_alts):\n                machine = parts[idx]\n                duration = parts[idx + 1]\n                alternatives.append((machine, duration))\n                idx += 2\n            ops.append(alternatives)\n        jobs.append(ops)\n    return jobs\n\n# Parse downtime.csv\ndef parse_downtime(filename):\n    downtime = {}  # machine -> list of (start, end)\n    with open(filename, \'r\') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            m = int(row[\'machine\'])\n            s = int(row[\'start\'])\n            e = int(row[\'end\'])\n            if m not in downtime:\n                downtime[m] = []\n            downtime[m].append((s, e))\n    return downtime\n\n# Parse policy.json\ndef parse_policy(filename):\n    with open(filename, \'r\') as f:\n        return json.load(f)\n\n# Parse baseline solution\ndef parse_baseline(filename):\n    with open(filename, \'r\') as f:\n        return json.load(f)\n\n# Check if time range overlaps with downtime\ndef overlaps_downtime(machine, start, end, downtime):\n    if machine not in downtime:\n        return False\n    for ds, de in downtime[machine]:\n        if start < de and end > ds:\n            return True\n    return False\n\n# Get next available start time avoiding downtime\ndef get_available_start(machine, earliest, duration, downtime):\n    start = earliest\n    if machine not in downtime:\n        return start\n    \n    # Try to find a slot that doesn\'t overlap with any downtime\n    for _ in range(100):  # max iterations\n        end = start + duration\n        conflict = False\n        for ds, de in downtime[machine]:\n            if start < de and end > ds:\n                # Conflict - move start to after this downtime\n                start = de\n                conflict = True\n                break\n        if not conflict:\n            return start\n    return start\n\njobs = parse_instance(\'/app/data/instance.txt\')\ndowntime = parse_downtime(\'/app/data/downtime.csv\')\npolicy = parse_policy(\'/app/data/policy.json\')\nbaseline = parse_baseline(\'/app/data/baseline_solution.json\')\n\nprint(f"Jobs: {len(jobs)}")\nfor j, ops in enumerate(jobs):\n    print(f"  Job {j}: {ops}")\nprint(f"Downtime: {downtime}")\nprint(f"Policy: {policy}")\nprint(f"Baseline makespan: {baseline[\'makespan\']}")\n\n# Create baseline lookup\nbaseline_ops = {}\nfor op in baseline[\'schedule\']:\n    baseline_ops[(op[\'job\'], op[\'op\'])] = op\n\nfreeze_until = policy[\'freeze\'][\'freeze_until\']\nmax_machine_changes = policy[\'change_budget\'][\'max_machine_changes\']\nmax_start_shift = policy[\'change_budget\'][\'max_total_start_shift_L1\']\nmax_makespan = baseline[\'makespan\'] * policy[\'guards\'][\'max_makespan_ratio\']\n\nprint(f"\\nFreeze until: {freeze_until}")\nprint(f"Max machine changes: {max_machine_changes}")\nprint(f"Max start shift L1: {max_start_shift}")\nprint(f"Max makespan: {max_makespan}")\n\n# Identify frozen operations\nfrozen = set()\nfor key, op in baseline_ops.items():\n    if op[\'start\'] < freeze_until:\n        frozen.add(key)\n        print(f"Frozen: Job {key[0]} Op {key[1]} - machine {op[\'machine\']}, {op[\'start\']}-{op[\'end\']}")\n\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
