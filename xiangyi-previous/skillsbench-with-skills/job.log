name\', \'department\', \'job_title\', \'salary\', \'years\', \'location\', \'score\']\n\nfor emp_id in sorted(pdf_employees.keys()):\n    if emp_id in excel_employees:\n        pdf_data = pdf_employees[emp_id]\n        excel_data = excel_employees[emp_id]\n        for field in field_names:\n            pdf_val = pdf_data[field]\n            excel_val = excel_data[field]\n            if pdf_val != excel_val:\n                modified_employees.append({\n                    \'id\': emp_id,\n                    \'field\': field.replace(\'_\', \' \').title(),\n                    \'old_value\': pdf_val,\n                    \'new_value\': excel_val\n                })\n\n# Create report\nreport = {\n    \'deleted_employees\': deleted_employees,\n    \'modified_employees\': modified_employees\n}\n\n# Write to file\nwith open(\'/root/diff_report.json\', \'w\') as f:\n    json.dump(report, f, indent=2)\n\nprint(f"Deleted employees: {len(deleted_employees)}")\nprint(f"Modified employees: {len(modified_employees)}")\nprint(f"Report written to /root/diff_report.json")\nprint(f"\\nDeleted: {deleted_employees[:5]}..." if len(deleted_employees) > 5 else f"Deleted: {deleted_employees}")\nprint(f"\\nFirst 5 modifications:")\nfor mod in modified_employees[:5]:\n    print(f"  {mod}")\n\nEOF\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
