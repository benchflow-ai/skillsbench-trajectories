Sending keys: ['cat << \'EOF\' > solution.py\nimport json\nimport numpy as np\nfrom hvac_simulator import HVACSimulator\n\ndef main():\n    # Initialize\n    sim = HVACSimulator()\n    dt = sim.get_dt()\n    T_ambient = sim.get_ambient_temp()\n\n    # --- Step 1: Calibration ---\n    print("Running calibration...")\n    sim.reset()\n    # Run with 50% power for 60 seconds to ensure good data\n    calib_power = 50.0\n    calib_duration = 60.0\n    calib_data = sim.run_open_loop(calib_power, calib_duration)\n    \n    with open("calibration_log.json", "w") as f:\n        json.dump({\n            "phase": "calibration",\n            "heater_power_test": calib_power,\n            "data": calib_data\n        }, f, indent=2)\n\n    # --- Step 2: Parameter Estimation ---\n    print("Estimating parameters...")\n    temps = np.array([d["temperature"] for d in calib_data])\n    powers = np.array([d["heater_power"] for d in calib_data])\n    \n    # Model: T[k+1] - T_amb = A*(T[k] - T_amb) + B*u[k]\n    # y = T[k+1] - T_amb\n    # x1 = T[k] - T_amb\n    # x2 = u[k]\n    \n    y = temps[1:] - T_ambient\n    x1 = temps[:-1] - T_ambient\n    x2 = powers[:-1]\n    X = np.column_stack((x1, x2))\n    \n    coeffs, residuals, rank, s = np.linalg.lstsq(X, y, rcond=None)\n    A, B = coeffs\n    \n    # Derived parameters\n    # A = 1 - dt/tau  -> tau = dt / (1 - A)\n    # B = K * dt / tau -> K = B * tau / dt = B / (1 - A)\n    \n    tau_est = dt / (1.0 - A)\n    K_est = B / (1.0 - A)\n    \n    # R-squared calculation\n    y_pred = X @ coeffs\n    ss_res = np.sum((y - y_pred)**2)\n    ss_tot = np.sum((y - np.mean(y))**2)\n    r_squared = 1 - (ss_res / ss_tot)\n    \n    est_params = {\n        "K": float(K_est),\n        "tau": float(tau_est),\n        "r_squared": float(r_squared),\n        "fitting_error": float(np.sqrt(ss_res / len(y)))\n    }\n    \n    with open("estimated_params.json", "w") as f:\n        json.dump(est_params, f, indent=2)\n    \n    print(f"Estimated K: {K_est:.4f}, tau: {tau_est:.4f}")\n\n    # --- Step 3: Gain Tuning ---\n    print("Tuning gains...")\n    # IMC Tuning for First Order Process\n    # Target settling time < 120s. \n    # Settling time approx 4 * lambda.\n    # We choose lambda = 25.0s (settling ~100s)\n    lambda_val = 25.0\n    \n    # PI Gains\n    # Kp = tau / (K * lambda)\n    # Ki = 1 / (K * lambda)\n    Kp = tau_est / (K_est * lambda_val)\n    Ki = 1.0 / (K_est * lambda_val)\n    Kd = 0.0\n    \n    tuned_gains = {\n        "Kp": float(Kp),\n        "Ki": float(Ki),\n        "Kd": float(Kd),\n        "lambda": float(lambda_val)\n    }\n    \n    with open("tuned_gains.json", "w") as f:\n        json.dump(tuned_gains, f, indent=2)\n        \n    print(f"Gains: Kp={Kp:.4f}, Ki={Ki:.4f}")\n\n    # --- Step 4: Closed-loop Control ---\n    print("Running control...")\n    sim.reset()\n    setpoint = 22.0\n    duration = 160.0\n    steps = int(duration / dt)\n    \n    control_data = []\n    integral = 0.0\n    prev_error = 0.0\n    \n    # Get initial state\n    # Note: simulator reset returns initial temp but doesn\'t give full dict\n    # We need to manually construct the first log or just start loop\n    # Let\'s get initial reading properly\n    current_temp = sim._get_measurement() # accessing internal for initial reading consistent with reset\n    # Actually sim.reset() returns the temp.\n    current_temp = sim.reset()\n    \n    for i in range(steps):\n        # Current time\n        t = i * dt\n        \n        error = setpoint - current_temp\n        \n        # PI Control\n        # Proportional\n        P = Kp * error\n        \n        # Integral with anti-windup clamping logic\n        # We calculate tentative integral term\n        integral_tentative = integral + error * dt\n        I = Ki * integral_tentative\n        \n        # Derivative (on error)\n        if i == 0:\n            D = 0.0\n        else:\n            D = Kd * (error - prev_error) / dt\n            \n        u = P + I + D\n        \n        # Actuator saturation\n        u_clamped = np.clip(u, 0.0, 100.0)\n        \n        # Back-calculation / Clamping for integrator\n        # If output is saturated, do not update integral if error is driving it further into saturation\n        # Simple method: only update integral if not saturated OR if error helps desaturate\n        if (u_clamped == u):\n            integral = integral_tentative\n        else:\n            # Saturated. Check sign.\n            # If u > 100 and error < 0 (trying to reduce), allow integration\n            # If u < 0 and error > 0 (trying to increase), allow integration\n            # Otherwise keep old integral\n            if (u > 100 and error < 0) or (u < 0 and error > 0):\n                integral = integral_tentative\n        \n        # Apply to plant\n        res = sim.step(u_clamped)\n        current_temp = res["temperature"]\n        \n        log_entry = {\n            "time": res["time"],\n            "temperature": res["temperature"],\n            "setpoint": setpoint,\n            "heater_power": res["heater_power"],\n            "error": round(error, 4)\n        }\n        control_data.append(log_entry)\n        prev_error = error\n        \n    with open("control_log.json", "w") as f:\n        json.dump({\n            "phase": "control",\n            "setpoint": setpoint,\n            "data": control_data\n        }, f, indent=2)\n\n    # --- Step 5: Metrics ---\n    temps_ctrl = [d["temperature"] for d in control_data]\n    times_ctrl = [d["time"] for d in control_data]\n    \n    max_temp = max(temps_ctrl)\n    final_temp = temps_ctrl[-1]\n    steady_state_error = abs(final_temp - setpoint)\n    \n    # Overshoot\n    # (Max - Setpoint) / (Setpoint - Initial)\n    # Initial is approx 18.0\n    initial_temp_ctrl = control_data[0]["temperature"]\n    step_size = setpoint - initial_temp_ctrl\n    overshoot_val = max(0.0, max_temp - setpoint)\n    overshoot_pct = overshoot_val / step_size if step_size > 0 else 0.0\n    \n    # Rise time (10% to 90%)\n    low_bound = initial_temp_ctrl + 0.1 * step_size\n    high_bound = initial_temp_ctrl + 0.9 * step_size\n    t_10 = next((d["time"] for d in control_data if d["temperature"] >= low_bound), None)\n    t_90 = next((d["time"] for d in control_data if d["temperature"] >= high_bound), None)\n    rise_time = (t_90 - t_10) if (t_10 is not None and t_90 is not None) else 0.0\n    \n    # Settling time\n    # Time after which error stays within 0.5C\n    settling_time = 0.0\n    for d in reversed(control_data):\n        if abs(d["temperature"] - setpoint) > 0.5:\n            # Found the last point outside band\n            # Settling time is the time of the NEXT point (or this point?)\n            # Usually defined as time to enter and stay.\n            # So if this point is at T, and it\'s outside, the settling time is > T.\n            settling_time = d["time"]\n            break\n    \n    metrics = {\n        "rise_time": round(rise_time, 2),\n        "overshoot": round(overshoot_pct, 4),\n        "settling_time": round(settling_time, 2),\n        "steady_state_error": round(steady_state_error, 4),\n        "max_temp": round(max_temp, 2)\n    }\n    \n    with open("metrics.json", "w") as f:\n        json.dump(metrics, f, indent=2)\n    \n    print("Metrics:", metrics)\n\nif __name__ == "__main__":\n    main()\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
