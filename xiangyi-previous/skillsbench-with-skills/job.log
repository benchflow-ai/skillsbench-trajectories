Sending keys: ['cat > /app/video/count_pedestrians.py << \'EOF\'\nimport cv2\nimport numpy as np\nfrom openpyxl import Workbook\nimport os\nfrom pathlib import Path\n\ndef detect_pedestrians_in_video(video_path):\n    """\n    Detect unique pedestrians in a video using HOG detector and centroid tracking.\n    """\n    cap = cv2.VideoCapture(video_path)\n    \n    if not cap.isOpened():\n        print(f"Error: Cannot open video {video_path}")\n        return 0\n    \n    # Initialize HOG descriptor for pedestrian detection\n    hog = cv2.HOGDescriptor()\n    hog.setSVMDetector(cv2.HOGDescriptor_getDefaultPeopleDetector())\n    \n    # Dictionary to store tracked pedestrians: {id: [centroid_history]}\n    tracked_pedestrians = {}\n    next_id = 0\n    \n    # Parameters for tracking\n    max_distance = 50  # Maximum distance to consider same person\n    min_frames_threshold = 3  # Minimum frames a person must appear in\n    \n    frame_count = 0\n    \n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n        \n        frame_count += 1\n        \n        # Resize frame for faster processing (optional)\n        # frame = cv2.resize(frame, (640, 480))\n        \n        # Detect pedestrians\n        detections, weights = hog.detectMultiScale(frame, winStride=(8, 8), padding=(16, 16), scale=1.05)\n        \n        # Calculate centroids of detections\n        current_centroids = []\n        for (x, y, w, h) in detections:\n            cx = x + w // 2\n            cy = y + h // 2\n            current_centroids.append((cx, cy))\n        \n        # Match detections with existing tracks\n        matched_ids = set()\n        \n        for centroid in current_centroids:\n            matched = False\n            \n            # Find closest tracked pedestrian\n            min_dist = max_distance\n            closest_id = None\n            \n            for ped_id, history in tracked_pedestrians.items():\n                if ped_id in matched_ids:\n                    continue\n                \n                last_centroid = history[-1]\n                dist = np.sqrt((centroid[0] - last_centroid[0])**2 + (centroid[1] - last_centroid[1])**2)\n                \n                if dist < min_dist:\n                    min_dist = dist\n                    closest_id = ped_id\n                    matched = True\n            \n            if matched and closest_id is not None:\n                tracked_pedestrians[closest_id].append(centroid)\n                matched_ids.add(closest_id)\n            else:\n                # New pedestrian detected\n                tracked_pedestrians[next_id] = [centroid]\n                next_id += 1\n        \n        # Remove old tracks that haven\'t been updated\n        ids_to_remove = []\n        for ped_id in tracked_pedestrians.keys():\n            if ped_id not in matched_ids and len(tracked_pedestrians[ped_id]) > 0:\n                # Track is inactive, but keep it for potential re-matching\n                pass\n    \n    cap.release()\n    \n    # Count unique pedestrians (those that appeared in at least min_frames_threshold frames)\n    unique_count = sum(1 for history in tracked_pedestrians.values() if len(history) >= min_frames_threshold)\n    \n    # If no pedestrians met the threshold, count all detected unique pedestrians\n    if unique_count == 0:\n        unique_count = len(tracked_pedestrians)\n    \n    return unique_count\n\ndef main():\n    video_dir = \'/app/video\'\n    \n    # Get all video files\n    video_files = []\n    for file in sorted(os.listdir(video_dir)):\n        if file.lower().endswith((\'.mp4\', \'.avi\', \'.mov\', \'.mkv\')):\n            video_files.append(file)\n    \n    # Create workbook\n    wb = Workbook()\n    ws = wb.active\n    ws.title = \'results\'\n    \n    # Add header\n    ws[\'A1\'] = \'filename\'\n    ws[\'B1\'] = \'number\'\n    \n    # Process each video\n    for idx, video_file in enumerate(video_files, start=2):\n        video_path = os.path.join(video_dir, video_file)\n        print(f"Processing {video_file}...")\n        \n        count = detect_pedestrians_in_video(video_path)\n        \n        ws[f\'A{idx}\'] = video_file\n        ws[f\'B{idx}\'] = count\n        \n        print(f"  Found {count} unique pedestrians")\n    \n    # Save workbook\n    output_file = os.path.join(video_dir, \'count.xlsx\')\n    wb.save(output_file)\n    print(f"\\nResults saved to {output_file}")\n\nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
