Sending keys: ['python3 << \'EOF\'\nimport struct\nimport json\nfrom collections import defaultdict\n\n# Read the binary STL file\nwith open(\'/root/scan_data.stl\', \'rb\') as f:\n    # Read header (80 bytes)\n    header = f.read(80)\n    \n    # Read number of triangles (4 bytes, little-endian unsigned int)\n    num_triangles_bytes = f.read(4)\n    num_triangles = struct.unpack(\'<I\', num_triangles_bytes)[0]\n    print(f"Number of triangles: {num_triangles}")\n    \n    # Dictionary to store triangles by material ID\n    triangles_by_material = defaultdict(list)\n    \n    # Parse each triangle\n    for i in range(num_triangles):\n        # Each triangle record is 50 bytes:\n        # 12 bytes: normal vector (3 floats)\n        # 36 bytes: 3 vertices (9 floats)\n        # 2 bytes: attribute byte count (Material ID)\n        \n        normal = struct.unpack(\'<fff\', f.read(12))\n        v1 = struct.unpack(\'<fff\', f.read(12))\n        v2 = struct.unpack(\'<fff\', f.read(12))\n        v3 = struct.unpack(\'<fff\', f.read(12))\n        material_id_bytes = f.read(2)\n        material_id = struct.unpack(\'<H\', material_id_bytes)[0]  # unsigned short\n        \n        triangles_by_material[material_id].append({\n            \'normal\': normal,\n            \'v1\': v1,\n            \'v2\': v2,\n            \'v3\': v3\n        })\n    \n    print(f"\\nMaterial IDs found: {sorted(triangles_by_material.keys())}")\n    print(f"Triangle counts by material:")\n    for mat_id in sorted(triangles_by_material.keys()):\n        print(f"  Material {mat_id}: {len(triangles_by_material[mat_id])} triangles")\n    \n    # Material density table\n    density_table = {\n        1: 0.10,\n        10: 7.85,\n        25: 2.70,\n        42: 5.55,\n        99: 11.34\n    }\n    \n    # Filter out debris and unknown materials - keep only valid materials\n    valid_materials = {mat_id: triangles_by_material[mat_id] \n                      for mat_id in triangles_by_material.keys() \n                      if mat_id in density_table and mat_id != 1}  # Exclude debris (ID 1)\n    \n    print(f"\\nValid materials (excluding debris): {sorted(valid_materials.keys())}")\n    print(f"Triangle counts for valid materials:")\n    for mat_id in sorted(valid_materials.keys()):\n        print(f"  Material {mat_id}: {len(valid_materials[mat_id])} triangles")\n    \n    # Find the largest connected component (most triangles among valid materials)\n    if not valid_materials:\n        print("ERROR: No valid materials found!")\n    else:\n        largest_material_id = max(valid_materials.keys(), \n                                  key=lambda x: len(valid_materials[x]))\n        largest_triangles = valid_materials[largest_material_id]\n        \n        print(f"\\nLargest valid component: Material ID {largest_material_id} with {len(largest_triangles)} triangles")\n        \n        # Calculate volume using divergence theorem\n        def cross_product(a, b):\n            return (\n                a[1]*b[2] - a[2]*b[1],\n                a[2]*b[0] - a[0]*b[2],\n                a[0]*b[1] - a[1]*b[0]\n            )\n        \n        def dot_product(a, b):\n            return a[0]*b[0] + a[1]*b[1] + a[2]*b[2]\n        \n        volume_sum = 0.0\n        for tri in largest_triangles:\n            v1 = tri[\'v1\']\n            v2 = tri[\'v2\']\n            v3 = tri[\'v3\']\n            \n            # Calculate v2 - v1 and v3 - v1\n            edge1 = (v2[0]-v1[0], v2[1]-v1[1], v2[2]-v1[2])\n            edge2 = (v3[0]-v1[0], v3[1]-v1[1], v3[2]-v1[2])\n            \n            # Calculate cross product\n            cross = cross_product(edge1, edge2)\n            \n            # Calculate dot product with v1\n            dot = dot_product(v1, cross)\n            \n            volume_sum += dot\n        \n        # Volume in cubic units (assuming STL is in mm, convert to cm³)\n        volume_mm3 = abs(volume_sum) / 6.0\n        volume_cm3 = volume_mm3 / 1000.0  # Convert mm³ to cm³\n        \n        print(f"\\nVolume (mm³): {volume_mm3}")\n        print(f"Volume (cm³): {volume_cm3}")\n        \n        # Get density for the largest material\n        density = density_table[largest_material_id]\n        print(f"Density for Material {largest_material_id}: {density} g/cm³")\n        \n        # Calculate mass\n        mass = volume_cm3 * density\n        print(f"\\nMass: {mass} g")\n        \n        # Save to JSON\n        result = {\n            "main_part_mass": round(mass, 2),\n            "material_id": largest_material_id\n        }\n        \n        with open(\'/root/mass_report.json\', \'w\') as out:\n            json.dump(result, out, indent=2)\n        \n        print(f"\\nResult saved to /root/mass_report.json")\n        print(json.dumps(result, indent=2))\n\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
