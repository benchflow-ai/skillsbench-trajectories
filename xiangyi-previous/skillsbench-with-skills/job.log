Sending keys: ['python3 << \'ENDSCRIPT\'\nimport pandas as pd\nimport numpy as np\nimport json\n\n# Load data\nmes = pd.read_csv(\'/app/data/mes_log.csv\')\ntc = pd.read_csv(\'/app/data/thermocouples.csv\')\n\n# Handbook specifications:\n# TAL (wetting time): 30-60 seconds\n# Use largest_mass thermocouple\n# Liquidus temperature from MES log (solder_liquidus_c)\n\nTAL_MIN = 30.0  # seconds\nTAL_MAX = 60.0  # seconds\n\n# Create run to liquidus mapping\nrun_liquidus = dict(zip(mes[\'run_id\'], mes[\'solder_liquidus_c\']))\n\n# Filter for largest_mass thermocouple\ntc_largest = tc[tc[\'tc_location\'] == \'largest_mass\'].copy()\n\ndef calculate_tal(run_data, liquidus_temp):\n    """Calculate Time Above Liquidus"""\n    run_data = run_data.sort_values(\'time_s\')\n    \n    # Find time points where temperature is above liquidus\n    above_liquidus = run_data[run_data[\'temp_c\'] > liquidus_temp]\n    \n    if len(above_liquidus) < 2:\n        return None, 0.0\n    \n    # Calculate total time above liquidus\n    # Each data point represents a 10-second interval\n    times = above_liquidus[\'time_s\'].values\n    \n    # TAL is the time span from first to last point above liquidus\n    # But we need to count actual time spent above liquidus\n    # Since data is at 10-second intervals, count number of intervals\n    tal = times[-1] - times[0]\n    \n    # Add the last interval (10 seconds) since the last point is also above liquidus\n    # Actually, let\'s count the number of points and multiply by interval\n    # But more accurate: use the time span\n    \n    tc_id = run_data[\'tc_id\'].iloc[0]\n    return tc_id, round(float(tal), 2)\n\n# Calculate for each run\nresults = []\n\nfor run_id in sorted(tc_largest[\'run_id\'].unique()):\n    run_data = tc_largest[tc_largest[\'run_id\'] == run_id]\n    liquidus = run_liquidus.get(run_id)\n    \n    if liquidus is None:\n        continue\n    \n    tc_id, tal = calculate_tal(run_data, liquidus)\n    \n    if tc_id is not None:\n        status = \'compliant\' if TAL_MIN <= tal <= TAL_MAX else \'non-compliant\'\n        results.append({\n            \'run_id\': run_id,\n            \'tc_id\': tc_id,\n            \'tal_s\': tal,\n            \'required_min_tal_s\': TAL_MIN,\n            \'required_max_tal_s\': TAL_MAX,\n            \'status\': status\n        })\n\n# Sort by run_id\nresults = sorted(results, key=lambda x: x[\'run_id\'])\n\nprint(json.dumps(results[:10], indent=2))\nprint(f"\\n... and {len(results)-10} more runs")\n\n# Count compliance\ncompliant = sum(1 for r in results if r[\'status\'] == \'compliant\')\nprint(f"\\nCompliant: {compliant}, Non-compliant: {len(results) - compliant}")\n\n# Save to file\nwith open(\'/app/output/q02.json\', \'w\') as f:\n    json.dump(results, f, indent=2)\n\nprint("\\nSaved to /app/output/q02.json")\nENDSCRIPT\n'] min_timeout_sec: 5.0 max_timeout_sec: 180.0
