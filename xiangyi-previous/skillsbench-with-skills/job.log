   \n        # Step 3-5: PO checks\n        if po_number:\n            po = pos_df[pos_df[\'po_number\'] == po_number]\n            if po.empty:\n                print(f"3. Invalid PO: YES - STOP")\n            else:\n                print(f"3. Invalid PO: NO")\n                po_row = po.iloc[0]\n                print(f"   PO: {po_row[\'po_number\']} - Vendor {po_row[\'vendor_id\']} - Amount {po_row[\'amount\']}")\n                \n                # Amount mismatch\n                if abs(amount - po_row[\'amount\']) > 0.01:\n                    print(f"4. Amount Mismatch: YES - STOP")\n                    print(f"   Invoice: {amount}, PO: {po_row[\'amount\']}, Diff: {abs(amount - po_row[\'amount\'])}")\n                else:\n                    print(f"4. Amount Mismatch: NO")\n                    \n                    # Vendor mismatch\n                    if vendor[\'id\'] != po_row[\'vendor_id\']:\n                        print(f"5. Vendor Mismatch: YES - STOP")\n                        print(f"   Invoice Vendor: {vendor[\'id\']}, PO Vendor: {po_row[\'vendor_id\']}")\n                    else:\n                        print(f"5. Vendor Mismatch: NO")\n                        print(f"   LEGITIMATE INVOICE")\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
