Sending keys: ['cat > /root/output/js/visualization.js << \'ENDOFFILE\'\n// Stock Visualization Dashboard\n\n// Dimensions\nconst width = 600;\nconst height = 550;\nconst margin = { top: 20, right: 20, bottom: 20, left: 20 };\n\n// Format market cap for display\nfunction formatMarketCap(value) {\n    if (!value || isNaN(value)) return \'N/A\';\n    const num = parseFloat(value);\n    if (num >= 1e12) return (num / 1e12).toFixed(2) + \'T\';\n    if (num >= 1e9) return (num / 1e9).toFixed(2) + \'B\';\n    if (num >= 1e6) return (num / 1e6).toFixed(2) + \'M\';\n    return num.toFixed(2);\n}\n\n// Color scale for sectors\nconst sectorColors = d3.scaleOrdinal(d3.schemeTableau10);\n\n// Global state\nlet selectedTicker = null;\nlet stockData = [];\n\n// Load and process data\nd3.csv(\'data/stock-descriptions.csv\').then(data => {\n    // Process the data\n    stockData = data.map(d => ({\n        ticker: d.ticker,\n        sector: d.sector || \'ETF\',\n        name: d[\'full name\'],\n        marketCap: parseFloat(d.marketCap) || 0,\n        country: d.country,\n        website: d.website,\n        isETF: d.sector === \'ETF\' || !d.sector || d.sector === \'\'\n    }));\n\n    // Get unique sectors for coloring\n    const sectors = [...new Set(stockData.map(d => d.sector))].sort();\n    sectorColors.domain(sectors);\n\n    // Create visualizations\n    createBubbleChart(stockData, sectors);\n    createDataTable(stockData);\n    createLegend(sectors);\n});\n\nfunction createBubbleChart(data, sectors) {\n    const svg = d3.select(\'#bubble-chart\')\n        .append(\'svg\')\n        .attr(\'width\', width)\n        .attr(\'height\', height);\n\n    const chartArea = svg.append(\'g\')\n        .attr(\'transform\', `translate(${margin.left}, ${margin.top})`);\n\n    const innerWidth = width - margin.left - margin.right;\n    const innerHeight = height - margin.top - margin.bottom;\n\n    // Scale for bubble size based on market cap\n    const maxMarketCap = d3.max(data, d => d.marketCap) || 1;\n    const radiusScale = d3.scaleSqrt()\n        .domain([0, maxMarketCap])\n        .range([8, 45]);\n\n    // Calculate sector centers for clustering\n    const sectorCenters = {};\n    const numSectors = sectors.length;\n    const cols = Math.ceil(Math.sqrt(numSectors));\n    const rows = Math.ceil(numSectors / cols);\n    const cellWidth = innerWidth / cols;\n    const cellHeight = innerHeight / rows;\n\n    sectors.forEach((sector, i) => {\n        const col = i % cols;\n        const row = Math.floor(i / cols);\n        sectorCenters[sector] = {\n            x: cellWidth * (col + 0.5),\n            y: cellHeight * (row + 0.5)\n        };\n    });\n\n    // Create nodes with initial positions\n    const nodes = data.map(d => ({\n        ...d,\n        radius: d.isETF ? 12 : radiusScale(d.marketCap),\n        x: sectorCenters[d.sector]?.x + (Math.random() - 0.5) * 50 || innerWidth / 2,\n        y: sectorCenters[d.sector]?.y + (Math.random() - 0.5) * 50 || innerHeight / 2\n    }));\n\n    // Create force simulation\n    const simulation = d3.forceSimulation(nodes)\n        .force(\'x\', d3.forceX(d => sectorCenters[d.sector]?.x || innerWidth / 2).strength(0.3))\n        .force(\'y\', d3.forceY(d => sectorCenters[d.sector]?.y || innerHeight / 2).strength(0.3))\n        .force(\'collide\', d3.forceCollide(d => d.radius + 2).strength(1))\n        .force(\'center\', d3.forceCenter(innerWidth / 2, innerHeight / 2).strength(0.05));\n\n    // Create bubble groups\n    const bubbleGroups = chartArea.selectAll(\'.bubble-group\')\n        .data(nodes)\n        .enter()\n        .append(\'g\')\n        .attr(\'class\', \'bubble-group\');\n\n    // Create bubbles\n    const bubbles = bubbleGroups.append(\'circle\')\n        .attr(\'class\', \'bubble\')\n        .attr(\'r\', d => d.radius)\n        .attr(\'fill\', d => sectorColors(d.sector))\n        .attr(\'stroke\', \'#fff\')\n        .attr(\'stroke-width\', 1.5)\n        .attr(\'data-ticker\', d => d.ticker);\n\n    // Add labels\n    const labels = bubbleGroups.append(\'text\')\n        .attr(\'class\', \'bubble-label\')\n        .text(d => d.ticker)\n        .style(\'font-size\', d => Math.min(d.radius * 0.6, 12) + \'px\');\n\n    // Tooltip\n    const tooltip = d3.select(\'#tooltip\');\n\n    // Bubble interactions\n    bubbles\n        .on(\'mouseover\', function(event, d) {\n            if (!d.isETF) {\n                tooltip\n                    .html(`<strong>${d.ticker}</strong>\n                           <div>${d.name}</div>\n                           <div>Sector: ${d.sector}</div>\n                           <div>Market Cap: ${formatMarketCap(d.marketCap)}</div>`)\n                    .style(\'left\', (event.pageX + 15) + \'px\')\n                    .style(\'top\', (event.pageY - 10) + \'px\')\n                    .classed(\'visible\', true);\n            }\n        })\n        .on(\'mousemove\', function(event, d) {\n            if (!d.isETF) {\n                tooltip\n                    .style(\'left\', (event.pageX + 15) + \'px\')\n                    .style(\'top\', (event.pageY - 10) + \'px\');\n            }\n        })\n        .on(\'mouseout\', function() {\n            tooltip.classed(\'visible\', false);\n        })\n        .on(\'click\', function(event, d) {\n            selectStock(d.ticker);\n        });\n\n    // Update positions on simulation tick\n    simulation.on(\'tick\', () => {\n        bubbleGroups.attr(\'transform\', d => {\n            // Keep bubbles within bounds\n            d.x = Math.max(d.radius, Math.min(innerWidth - d.radius, d.x));\n            d.y = Math.max(d.radius, Math.min(innerHeight - d.radius, d.y));\n            return `translate(${d.x}, ${d.y})`;\n        });\n    });\n\n    // Run simulation\n    simulation.alpha(1).restart();\n}\n\nfunction createDataTable(data) {\n    const tableContainer = d3.select(\'#data-table\');\n\n    const table = tableContainer.append(\'table\');\n\n    // Header\n    const thead = table.append(\'thead\');\n    thead.append(\'tr\')\n        .selectAll(\'th\')\n        .data([\'Ticker\', \'Company Name\', \'Sector\', \'Market Cap\'])\n        .enter()\n        .append(\'th\')\n        .text(d => d);\n\n    // Body\n    const tbody = table.append(\'tbody\');\n\n    const rows = tbody.selectAll(\'tr\')\n        .data(data)\n        .enter()\n        .append(\'tr\')\n        .attr(\'data-ticker\', d => d.ticker)\n        .on(\'click\', function(event, d) {\n            selectStock(d.ticker);\n        });\n\n    rows.append(\'td\').text(d => d.ticker);\n    rows.append(\'td\').text(d => d.name);\n    rows.append(\'td\').text(d => d.sector);\n    rows.append(\'td\').text(d => formatMarketCap(d.marketCap));\n}\n\nfunction createLegend(sectors) {\n    const legend = d3.select(\'#legend\');\n\n    sectors.forEach(sector => {\n        const item = legend.append(\'div\')\n            .attr(\'class\', \'legend-item\');\n\n        item.append(\'div\')\n            .attr(\'class\', \'legend-color\')\n            .style(\'background-color\', sectorColors(sector));\n\n        item.append(\'span\')\n            .text(sector);\n    });\n}\n\nfunction selectStock(ticker) {\n    // Toggle selection\n    if (selectedTicker === ticker) {\n        selectedTicker = null;\n    } else {\n        selectedTicker = ticker;\n    }\n\n    // Update bubble selection\n    d3.selectAll(\'.bubble\')\n        .classed(\'selected\', d => d.ticker === selectedTicker);\n\n    // Update table selection\n    d3.selectAll(\'#data-table tbody tr\')\n        .classed(\'selected\', function() {\n            return d3.select(this).attr(\'data-ticker\') === selectedTicker;\n        });\n\n    // Scroll to selected row in table\n    if (selectedTicker) {\n        const selectedRow = document.querySelector(`#data-table tr[data-ticker="${selectedTicker}"]`);\n        if (selectedRow) {\n            selectedRow.scrollIntoView({ behavior: \'smooth\', block: \'center\' });\n        }\n    }\n}\nENDOFFILE\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
