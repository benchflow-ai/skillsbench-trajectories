Sending keys: ['cat > process_offer_letter_v2.py << \'EOF\'\nimport json\nfrom docx import Document\nimport re\n\n# Load employee data\nwith open(\'employee_data.json\', \'r\') as f:\n    data = json.load(f)\n\n# Load the template\ndoc = Document(\'offer_letter_template.docx\')\n\ndef process_paragraph(paragraph, data):\n    """Process a paragraph to replace placeholders"""\n    # Get full text\n    full_text = paragraph.text\n    \n    # Handle conditional sections\n    if data.get(\'RELOCATION_PACKAGE\', \'\').lower() == \'yes\':\n        full_text = re.sub(r\'\\{\\{IF_RELOCATION\\}\\}\', \'\', full_text)\n        full_text = re.sub(r\'\\{\\{END_IF_RELOCATION\\}\\}\', \'\', full_text)\n    else:\n        full_text = re.sub(r\'\\{\\{IF_RELOCATION\\}\\}.*?\\{\\{END_IF_RELOCATION\\}\\}\', \'\', full_text, flags=re.DOTALL)\n    \n    # Replace placeholders\n    for key, value in data.items():\n        placeholder = \'{{\' + key + \'}}\'\n        full_text = full_text.replace(placeholder, str(value))\n    \n    # If text changed, update the paragraph\n    if full_text != paragraph.text:\n        # Clear existing runs and add new text\n        for run in paragraph.runs:\n            run.text = \'\'\n        if paragraph.runs:\n            paragraph.runs[0].text = full_text\n        else:\n            paragraph.add_run(full_text)\n\n# Process all paragraphs\nfor paragraph in doc.paragraphs:\n    process_paragraph(paragraph, data)\n\n# Process tables\nfor table in doc.tables:\n    for row in table.rows:\n        for cell in row.cells:\n            for paragraph in cell.paragraphs:\n                process_paragraph(paragraph, data)\n\n# Save the filled document\ndoc.save(\'/root/offer_letter_filled.docx\')\nprint(\'Offer letter created successfully at /root/offer_letter_filled.docx\')\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
