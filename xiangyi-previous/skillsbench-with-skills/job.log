Sending keys: ['cat <<EOF > solve_task.py\nimport pandas as pd\nimport numpy as np\nimport json\n\n# Load Data\nmes = pd.read_csv(\'/app/data/mes_log.csv\')\ntcs = pd.read_csv(\'/app/data/thermocouples.csv\')\ndefects = pd.read_csv(\'/app/data/test_defects.csv\')\n\n# Helper to save JSON\ndef save_json(data, filename):\n    with open(f\'/app/output/{filename}\', \'w\') as f:\n        json.dump(data, f, indent=2)\n\n# --- Q1: Preheat Ramp Rate ---\n# Definition: Preheat 100-150C. Limit < 2.0 C/s. Critical TC: smallest_mass (fastest heating).\n\nramp_limit = 2.0\nviolating_runs_q1 = []\nmax_ramp_by_run = {}\n\nfor run_id in mes[\'run_id\'].unique():\n    run_tcs = tcs[tcs[\'run_id\'] == run_id]\n    if run_tcs.empty:\n        continue\n    \n    # Select representative TC: smallest_mass for thermal shock\n    tc_data = run_tcs[run_tcs[\'tc_location\'] == \'smallest_mass\']\n    if tc_data.empty:\n        # Fallback if smallest_mass not present (though expected)\n        tc_data = run_tcs[run_tcs[\'tc_location\'] == \'largest_mass\']\n        if tc_data.empty:\n             tc_data = run_tcs # Use whatever is there\n             \n    # Iterate over unique TCs in this selection (should be 1 usually)\n    # If multiple TCs have smallest_mass, pick the one with highest max ramp?\n    # Or just process the first one? Let\'s process each and take the worst case (max ramp).\n    \n    max_ramp_run = -1.0\n    selected_tc_id = None\n    \n    for tc_id in tc_data[\'tc_id\'].unique():\n        df_tc = tc_data[tc_data[\'tc_id\'] == tc_id].sort_values(\'time_s\')\n        \n        # Filter for Preheat region 100 <= T <= 150\n        # We need to find the segments where T is in range.\n        # Calculate derivative between points.\n        \n        times = df_tc[\'time_s\'].values\n        temps = df_tc[\'temp_c\'].values\n        \n        # Calculate instantaneous ramp rates\n        # We only consider ramp rates where the interval is within the preheat zone?\n        # Or the temperature is within the zone?\n        # "during preheat".\n        \n        ramps = []\n        for i in range(len(times) - 1):\n            t1, t2 = times[i], times[i+1]\n            temp1, temp2 = temps[i], temps[i+1]\n            \n            # Check if this segment is in preheat\n            # We assume preheat is the phase where temp is rising from ambient to soak/reflow.\n            # The handbook says "preheat section... temperatures generally between 100C to 150C".\n            # So we check if the segment overlaps with 100-150 range?\n            # Or strictly if both points are in range? \n            # If one point is 90 and next is 110, the ramp applies.\n            # Let\'s consider any segment where the average temp is in 100-150 or either point is in range.\n            # To be safe and strict: Check if the segment contributes to the rise in the 100-150 range.\n            \n            if (temp1 >= 100 and temp1 <= 150) or (temp2 >= 100 and temp2 <= 150):\n                 if t2 > t1:\n                     rate = (temp2 - temp1) / (t2 - t1)\n                     ramps.append(rate)\n        \n        if ramps:\n            max_r = max(ramps)\n            if max_r > max_ramp_run:\n                max_ramp_run = max_r\n                selected_tc_id = tc_id\n    \n    if selected_tc_id:\n        max_ramp_by_run[run_id] = {\n            "tc_id": selected_tc_id,\n            "max_preheat_ramp_c_per_s": round(max_ramp_run, 2)\n        }\n        if max_ramp_run > ramp_limit:\n            violating_runs_q1.append(run_id)\n\n# Sort\nviolating_runs_q1.sort()\n# Sort dict by key\nmax_ramp_by_run = dict(sorted(max_ramp_by_run.items()))\n\nq1_output = {\n  "ramp_rate_limit_c_per_s": ramp_limit,\n  "violating_runs": violating_runs_q1,\n  "max_ramp_by_run": max_ramp_by_run\n}\nsave_json(q1_output, \'q01.json\')\n\n\n# --- Q2: TAL ---\n# TAL Window: 30-60s. TC: largest_mass (coldest, hardest to reflow).\n# Threshold: Liquidus.\n\nq2_output = []\n\nfor index, row in mes.iterrows():\n    run_id = row[\'run_id\']\n    liquidus = row[\'solder_liquidus_c\']\n    \n    run_tcs = tcs[tcs[\'run_id\'] == run_id]\n    if run_tcs.empty:\n        continue\n        \n    # Select largest_mass\n    tc_data = run_tcs[run_tcs[\'tc_location\'] == \'largest_mass\']\n    if tc_data.empty:\n        tc_data = run_tcs # Fallback\n    \n    # If multiple largest_mass, which one? The one with MINIMUM TAL (worst case for wetting)?\n    # Or the one with MAXIMUM TAL (worst case for brittle)?\n    # Handbook says "ensure quality reflow... wetting time is normally 30 to 60".\n    # If TAL < 30 -> non-compliant (didn\'t wet).\n    # If TAL > 60 -> non-compliant (brittle).\n    # So we need to check if ANY largest_mass TC is out of spec? Or the representative one?\n    # "Select the most representative thermocouple value".\n    # Usually, largest mass is the critical one for MIN TAL.\n    # Let\'s pick the specific TC that has the lowest Peak Temp (coldest) as the representative for largest_mass?\n    # Or just process all largest_mass TCs and report the one that fails? \n    # The output format expects one entry per run (implied by "tc_id": "").\n    # Let\'s calculate TAL for all largest_mass TCs and pick the one that is most critical.\n    # Most critical = furthest from center of window? Or min TAL?\n    # Let\'s pick the one with Min TAL as it\'s the "coldest" spot.\n    \n    selected_tc = None\n    min_tal = float(\'inf\')\n    \n    # First, calculate TAL for all candidates\n    candidates = []\n    for tc_id in tc_data[\'tc_id\'].unique():\n        df_tc = tc_data[tc_data[\'tc_id\'] == tc_id].sort_values(\'time_s\')\n        times = df_tc[\'time_s\'].values\n        temps = df_tc[\'temp_c\'].values\n        \n        # Calculate time above liquidus\n        # Simple integration: sum of time intervals where avg temp > liquidus\n        tal = 0.0\n        for i in range(len(times) - 1):\n            t1, t2 = times[i], times[i+1]\n            temp1, temp2 = temps[i], temps[i+1]\n            \n            # Check intersection\n            if temp1 > liquidus and temp2 > liquidus:\n                tal += (t2 - t1)\n            elif temp1 <= liquidus and temp2 <= liquidus:\n                continue\n            else:\n                # Linear interpolation\n                # T(t) = m*t + c\n                # Find t where T = liquidus\n                slope = (temp2 - temp1) / (t2 - t1)\n                if slope != 0:\n                    t_cross = t1 + (liquidus - temp1) / slope\n                    if temp1 > liquidus:\n                         tal += (t_cross - t1)\n                    else:\n                         tal += (t2 - t_cross)\n        \n        candidates.append({\'tc_id\': tc_id, \'tal\': tal})\n    \n    # Select representative.\n    # If any is < 30, pick that (failure).\n    # If all > 60, pick that (failure).\n    # If multiple fails, pick worst.\n    # If all pass, pick any (maybe min TAL).\n    \n    best_candidate = candidates[0]\n    # Logic: Prioritize showing non-compliance.\n    # Check for < 30\n    low_fails = [c for c in candidates if c[\'tal\'] < 30]\n    high_fails = [c for c in candidates if c[\'tal\'] > 60]\n    \n    if low_fails:\n        best_candidate = min(low_fails, key=lambda x: x[\'tal\']) # Worst low fail\n    elif high_fails:\n        best_candidate = max(high_fails, key=lambda x: x[\'tal\']) # Worst high fail\n    else:\n        # All compliant, pick min TAL (closest to limit?)\n        best_candidate = min(candidates, key=lambda x: x[\'tal\'])\n        \n    status = "compliant"\n    if best_candidate[\'tal\'] < 30 or best_candidate[\'tal\'] > 60:\n        status = "non-compliant"\n        \n    q2_output.append({\n        "run_id": run_id,\n        "tc_id": best_candidate[\'tc_id\'],\n        "tal_s": round(best_candidate[\'tal\'], 2),\n        "required_min_tal_s": 30.0,\n        "required_max_tal_s": 60.0,\n        "status": status\n    })\n\nq2_output.sort(key=lambda x: x[\'run_id\'])\nsave_json(q2_output, \'q02.json\')\n\n\n# --- Q3: Peak Temp ---\n# Min Peak = Liquidus + 20. TC: largest_mass.\n\nfailing_runs_q3 = []\nmin_peak_by_run = {}\n\nfor index, row in mes.iterrows():\n    run_id = row[\'run_id\']\n    liquidus = row[\'solder_liquidus_c\']\n    required_peak = liquidus + 20.0\n    \n    run_tcs = tcs[tcs[\'run_id\'] == run_id]\n    if run_tcs.empty:\n        failing_runs_q3.append(run_id)\n        continue\n        \n    tc_data = run_tcs[run_tcs[\'tc_location\'] == \'largest_mass\']\n    if tc_data.empty:\n        tc_data = run_tcs\n        \n    # Find the TC with the LOWEST peak temp (worst case for min peak req)\n    worst_peak = float(\'inf\')\n    selected_tc = None\n    \n    for tc_id in tc_data[\'tc_id\'].unique():\n        peak = tc_data[tc_data[\'tc_id\'] == tc_id][\'temp_c\'].max()\n        if peak < worst_peak:\n            worst_peak = peak\n            selected_tc = tc_id\n            \n    min_peak_by_run[run_id] = {\n        "tc_id": selected_tc,\n        "peak_temp_c": round(worst_peak, 2),\n        "required_min_peak_c": round(required_peak, 2)\n    }\n    \n    if worst_peak < required_peak:\n        failing_runs_q3.append(run_id)\n\nfailing_runs_q3.sort()\nmin_peak_by_run = dict(sorted(min_peak_by_run.items()))\n\nq3_output = {\n  "failing_runs": failing_runs_q3,\n  "min_peak_by_run": min_peak_by_run\n}\nsave_json(q3_output, \'q03.json\')\n\n\n# --- Q4: Conveyor Speed ---\n# Req Speed = Boards/Min * Length / LoadFactor\n\nq4_output = []\n\nfor index, row in mes.iterrows():\n    run_id = row[\'run_id\']\n    bpm = row[\'boards_per_min\']\n    length = row[\'board_length_cm\']\n    lf = row[\'loading_factor\']\n    actual_speed = row[\'conveyor_speed_cm_min\']\n    \n    if lf > 0:\n        req_speed = (bpm * length) / lf\n    else:\n        req_speed = 0 # Should not happen\n        \n    meets = actual_speed >= (req_speed - 0.01) # Tolerance?\n    \n    q4_output.append({\n        "run_id": run_id,\n        "required_min_speed_cm_min": round(req_speed, 2),\n        "actual_speed_cm_min": round(actual_speed, 2),\n        "meets": meets\n    })\n\nq4_output.sort(key=lambda x: x[\'run_id\'])\nsave_json(q4_output, \'q04.json\')\n\n\n# --- Q5: Best Run ---\n# Best run per board_family.\n# Criteria: Pass all checks (Q1, Q2, Q3, Q4). Then Efficiency (Speed?)\n# Also Quality (Defects).\n\n# 1. Identify failing runs\nfailed_runs = set()\nfailed_runs.update(violating_runs_q1)\nfailed_runs.update([r[\'run_id\'] for r in q2_output if r[\'status\'] == \'non-compliant\'])\nfailed_runs.update(failing_runs_q3)\nfailed_runs.update([r[\'run_id\'] for r in q4_output if not r[\'meets\']])\n\n# 2. Defect counts\n# Sum defects per run\ndefect_counts = defects.groupby(\'run_id\')[\'count\'].sum().to_dict()\n\n# 3. Group by family\nfamilies = mes[\'board_family\'].unique()\nq5_output = []\n\nfor family in families:\n    family_runs = mes[mes[\'board_family\'] == family]\n    \n    # Candidates\n    candidates = []\n    for idx, row in family_runs.iterrows():\n        rid = row[\'run_id\']\n        is_compliant = rid not in failed_runs\n        d_count = defect_counts.get(rid, 0)\n        speed = row[\'conveyor_speed_cm_min\']\n        \n        candidates.append({\n            \'run_id\': rid,\n            \'compliant\': is_compliant,\n            \'defects\': d_count,\n            \'speed\': speed\n        })\n    \n    # Sort candidates\n    # Priority: 1. Compliant (True > False)\n    #           2. Defects (Low > High)\n    #           3. Speed (High > Low)\n    \n    candidates.sort(key=lambda x: (x[\'compliant\'], -x[\'defects\'], x[\'speed\']), reverse=True)\n    \n    if candidates:\n        best_run = candidates[0][\'run_id\']\n        runner_ups = [c[\'run_id\'] for c in candidates[1:]]\n        runner_ups.sort() # List others\n        \n        q5_output.append({\n            "board_family": family,\n            "best_run_id": best_run,\n            "runner_up_run_ids": runner_ups\n        })\n\nq5_output.sort(key=lambda x: x[\'board_family\'])\nsave_json(q5_output, \'q05.json\')\n\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
