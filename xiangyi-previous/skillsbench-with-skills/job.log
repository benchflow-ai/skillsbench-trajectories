Sending keys: ['cat << \'EOF\' > optimize.py\nimport json\nimport itertools\n\ndef get_dist(p1, p2, width, height):\n    x1, y1 = p1[\'x\'], p1[\'y\']\n    x2, y2 = p2[\'x\'], p2[\'y\']\n    def to_cube(x, y):\n        q = x - (y + (y & 1)) // 2\n        r = y\n        s = -q - r\n        return q, r, s\n    q1, r1, s1 = to_cube(x1, y1)\n    best_dist = 999\n    for offset in [-width, 0, width]:\n        q2, r2, s2 = to_cube(x2 + offset, y2)\n        dist = (abs(q1 - q2) + abs(r1 - r2) + abs(s1 - s2)) // 2\n        if dist < best_dist: best_dist = dist\n    return best_dist\n\nwith open(\'map_data.json\') as f:\n    map_data = json.load(f)\nwidth = map_data[\'width\']\nheight = map_data[\'height\']\nplots = { (p[\'x\'], p[\'y\']): p for p in map_data[\'plots\'] }\n\ndef get_neighbors(x, y):\n    neighbors = []\n    if y % 2 == 0:\n        coords = [(x-1, y), (x+1, y), (x, y-1), (x+1, y-1), (x, y+1), (x+1, y+1)]\n    else:\n        coords = [(x-1, y), (x+1, y), (x-1, y-1), (x, y-1), (x-1, y+1), (x, y+1)]\n    for nx, ny in coords:\n        if 0 <= ny < height:\n            neighbors.append(plots[(nx % width, ny)])\n    return neighbors\n\ndef is_adjacent_to_river(p):\n    if p.get(\'river\'):\n        if p[\'river\'].get(\'NE\') or p[\'river\'].get(\'W\') or p[\'river\'].get(\'NW\'):\n            return True\n    x, y = p[\'x\'], p[\'y\']\n    # E neighbor\n    ne = plots[((x + 1) % width, y)]\n    if ne.get(\'river\') and ne[\'river\'].get(\'W\'): return True\n    # SE neighbor\n    if y % 2 == 0: nse = plots[((x + 1) % width, y - 1)] if y > 0 else None\n    else: nse = plots[(x, y - 1)] if y > 0 else None\n    if nse and nse.get(\'river\') and nse[\'river\'].get(\'NW\'): return True\n    # SW neighbor\n    if y % 2 == 0: nsw = plots[(x, y - 1)] if y > 0 else None\n    else: nsw = plots[((x - 1) % width, y - 1)] if y > 0 else None\n    if nsw and nsw.get(\'river\') and nsw[\'river\'].get(\'NE\'): return True\n    return False\n\ndef calc_bonus(type, p, placements):\n    neighbors = get_neighbors(p[\'x\'], p[\'y\'])\n    bonus = 0\n    if type == \'CAMPUS\':\n        for n in neighbors:\n            if \'MOUNTAIN\' in n[\'terrain\']: bonus += 1\n            if n.get(\'feature\') == \'FEATURE_REEF\': bonus += 2\n            if n.get(\'feature\') == \'FEATURE_GEOTHERMAL_FISSURE\': bonus += 2\n            if n.get(\'feature\') == \'FEATURE_JUNGLE\': bonus += 0.5\n    elif type == \'COMMERCIAL_HUB\':\n        if is_adjacent_to_river(p): bonus += 2\n    elif type == \'HOLY_SITE\':\n        for n in neighbors:\n            if \'MOUNTAIN\' in n[\'terrain\']: bonus += 1\n            if n.get(\'feature\') == \'FEATURE_FOREST\': bonus += 0.5\n    elif type == \'INDUSTRIAL_ZONE\':\n        pass\n    \n    districts = sum(1 for n in neighbors if (n[\'x\'], n[\'y\']) in placements)\n    bonus += districts // 2\n    return int(bonus)\n\nbest_total = -1\nbest_res = {}\ntypes = [\'CAMPUS\', \'COMMERCIAL_HUB\', \'INDUSTRIAL_ZONE\', \'HOLY_SITE\', \'THEATER_SQUARE\']\n\nfor city_x in range(width):\n    for city_y in range(height):\n        cc_plot = plots[(city_x, city_y)]\n        if \'MOUNTAIN\' in cc_plot[\'terrain\'] or \'OCEAN\' in cc_plot[\'terrain\'] or \'COAST\' in cc_plot[\'terrain\'] or cc_plot.get(\'feature\') == \'FEATURE_ICE\':\n            continue\n        \n        city_center = (city_x, city_y)\n        nearby = [p for p in map_data[\'plots\'] if get_dist(cc_plot, p, width, height) <= 3 and (p[\'x\'], p[\'y\']) != city_center and \'MOUNTAIN\' not in p[\'terrain\'] and \'OCEAN\' not in p[\'terrain\'] and \'COAST\' not in p[\'terrain\'] and p.get(\'feature\') != \'FEATURE_ICE\']\n        \n        for combo in itertools.combinations(types, 3):\n            type_spots = []\n            for t in combo:\n                ts = sorted(nearby, key=lambda p: calc_bonus(t, p, {city_center: \'CITY_CENTER\'}), reverse=True)[:3]\n                type_spots.append([(t, p) for p in ts])\n            \n            for d1, d2, d3 in itertools.product(*type_spots):\n                if d1[1][\'id\'] == d2[1][\'id\'] or d1[1][\'id\'] == d3[1][\'id\'] or d2[1][\'id\'] == d3[1][\'id\']:\n                    continue\n                \n                placements = {city_center: \'CITY_CENTER\', (d1[1][\'x\'], d1[1][\'y\']): d1[0], (d2[1][\'x\'], d2[1][\'y\']): d2[0], (d3[1][\'x\'], d3[1][\'y\']): d3[0]}\n                b1 = calc_bonus(d1[0], d1[1], placements)\n                b2 = calc_bonus(d2[0], d2[1], placements)\n                b3 = calc_bonus(d3[0], d3[1], placements)\n                total = b1 + b2 + b3\n                \n                if total > best_total:\n                    best_total = total\n                    best_res = {\n                        "city_center": [city_x, city_y],\n                        "placements": {\n                            d1[0]: [d1[1][\'x\'], d1[1][\'y\']],\n                            d2[0]: [d2[1][\'x\'], d2[1][\'y\']],\n                            d3[0]: [d3[1][\'x\'], d3[1][\'y\']]\n                        },\n                        "adjacency_bonuses": {\n                            d1[0]: b1,\n                            d2[0]: b2,\n                            d3[0]: b3\n                        },\n                        "total_adjacency": total\n                    }\n\nprint(json.dumps(best_res))\nEOF\npython3 optimize.py\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
