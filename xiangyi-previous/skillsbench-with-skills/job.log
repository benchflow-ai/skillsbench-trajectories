Sending keys: ['cat <<EOF > solve_task.py\nimport json\nimport datetime\nimport re\nimport subprocess\nimport os\n\nINPUT_FILE = \'/root/test_input.json\'\nRESULTS_FILE = \'/root/results.json\'\nNODE_SCRIPT_DIR = \'/root/verifier-skills/gmail-skill\'\nNODE_SCRIPT = \'scripts/gmail-send.js\'\n\ndef parse_email_content(text):\n    # Extract duration\n    duration = 1.0\n    if \'1.5 hour\' in text:\n        duration = 1.5\n    elif \'one-hour\' in text or \'1 hour\' in text:\n        duration = 1.0\n    elif \'45-minute\' in text:\n        duration = 0.75\n    \n    # Dates\n    possible_dates = []\n    if "January 8" in text and "January 9" in text:\n        possible_dates = [datetime.date(2026, 1, 8), datetime.date(2026, 1, 9)]\n    elif "January 6" in text and "7th" in text:\n        possible_dates = [datetime.date(2026, 1, 6), datetime.date(2026, 1, 7)]\n    elif "January 8" in text:\n         possible_dates = [datetime.date(2026, 1, 8)]\n    else:\n         possible_dates = [datetime.date(2026, 1, 8)]\n         \n    # Time constraints\n    start_time = datetime.time(9, 0)\n    \n    time_match = re.search(r\'(\\d{1,2}:?\\d{0,2})\\s*(am|pm)?\\s*(to|and|between)\\s*(\\d{1,2}:?\\d{0,2})\\s*(am|pm)\', text, re.IGNORECASE)\n    if time_match:\n        t1_str = time_match.group(1)\n        t1_ampm = time_match.group(2)\n        \n        def parse_time(t_str, ampm):\n            if \':\' in t_str:\n                h, m = map(int, t_str.split(\':\'))\n            else:\n                h = int(t_str)\n                m = 0\n            if ampm and ampm.lower() == \'pm\' and h != 12:\n                h += 12\n            if ampm and ampm.lower() == \'am\' and h == 12:\n                h = 0\n            return datetime.time(h, m)\n            \n        try:\n            start_time = parse_time(t1_str, t1_ampm)\n        except:\n            pass\n            \n    return {\n        \'duration\': duration,\n        \'dates\': possible_dates,\n        \'start_time\': start_time\n    }\n\ndef send_email_node(to_email, subject, body_text):\n    cwd = os.getcwd()\n    os.chdir(NODE_SCRIPT_DIR)\n    try:\n        cmd = [\'node\', NODE_SCRIPT, \'--to\', to_email, \'--subject\', subject, \'--body\', body_text]\n        result = subprocess.run(cmd, capture_output=True, text=True)\n        \n        if result.returncode != 0:\n            print(f"Node script failed: {result.stderr}")\n            return None\n            \n        try:\n            output = json.loads(result.stdout)\n            if output.get(\'success\'):\n                return output.get(\'messageId\')\n            else:\n                print(f"Node script returned failure: {output}")\n                return None\n        except json.JSONDecodeError:\n            print(f"Failed to parse JSON output: {result.stdout}")\n            return None\n    finally:\n        os.chdir(cwd)\n\ndef main():\n    with open(INPUT_FILE, \'r\') as f:\n        requests = json.load(f)\n\n    sent_results = []\n\n    for req in requests:\n        email_text = req[\'email_text\']\n        from_email = req[\'from_email\']\n        \n        constraints = parse_email_content(email_text)\n        \n        # MOCK Availability\n        date = constraints[\'dates\'][0]\n        proposed_start = datetime.datetime.combine(date, constraints[\'start_time\'])\n        proposed_end = proposed_start + datetime.timedelta(hours=constraints[\'duration\'])\n        \n        day_name = proposed_start.strftime(\'%A\')\n        month = proposed_start.strftime(\'%B\')\n        dd = proposed_start.strftime(\'%d\')\n        yyyy = proposed_start.strftime(\'%Y\')\n        date_formatted = f"{month} {dd}, {yyyy}"\n        \n        time_range = f"{proposed_start.strftime(\'%I:%M %p\')} - {proposed_end.strftime(\'%I:%M %p\')}"\n        \n        reply_body = f"Hi,\\n\\nThank you for your meeting request.\\n\\nI can be available:\\n\\nDate: {day_name}, {date_formatted}\\nTime: {time_range}\\nDuration: {constraints[\'duration\']} hour(s)\\n\\nIf this time doesn\'t work, please let me know your preferred alternatives.\\n\\nBest regards,\\nSkillsBench"\n        \n        print(f"Sending email to {from_email}...")\n        msg_id = send_email_node(from_email, "Re: Meeting Request", reply_body)\n        if msg_id:\n            sent_results.append({"messageId": msg_id})\n            \n    with open(RESULTS_FILE, \'w\') as f:\n        json.dump({"sent_results": sent_results}, f)\n        \nif __name__ == \'__main__\':\n    main()\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
