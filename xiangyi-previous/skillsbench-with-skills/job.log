Sending keys: ["python3 - <<'PY'\nimport os, numpy as np\nfrom glob import glob\n\ndef sta_lta(a, nsta, nlta):\n    a2 = a**2\n    sta = np.convolve(a2, np.ones(nsta), 'same')\n    lta = np.convolve(a2, np.ones(nlta), 'same') + 1e-12\n    return sta/(lta+1e-12)\n\nrows=[]\nfor fn in sorted(glob('/root/data/*.npz')):\n    d=np.load(fn, allow_pickle=True)\n    data=d['data']\n    dt=float(d['dt'])\n    chans = d['channels']\n    if isinstance(chans, np.ndarray):\n        chans = str(chans.tolist())\n    chans = str(chans)\n    ch_list=[c.strip() for c in chans.split(',')]\n    z_idx=None\n    for i,c in enumerate(ch_list):\n        if 'Z' in c.upper():\n            z_idx=i; break\n    if z_idx is None: z_idx=2 if data.shape[1]>2 else 0\n    h_idx=[i for i in range(data.shape[1]) if i!=z_idx]\n    if not h_idx: h_idx=[z_idx]\n    z=data[:,z_idx]; h=np.sqrt(np.sum(data[:,h_idx]**2, axis=1)) if len(h_idx)>1 else np.abs(data[:,h_idx[0]])\n    z=z-np.mean(z); h=h-np.mean(h)\n    nsta=max(1,int(0.2/dt)); nlta=max(nsta+1,int(2.0/dt))\n    ratio_p=sta_lta(np.abs(z), nsta, nlta)\n    ratio_s=sta_lta(np.abs(h), nsta, nlta)\n    thr_p=3.0; thr_s=3.0\n    idx_p=np.where(ratio_p>thr_p)[0]\n    p_pick=None\n    if idx_p.size>0:\n        p_pick=int(idx_p[0]); rows.append((os.path.basename(fn),'P',p_pick))\n    start=int(p_pick+0.5/dt) if p_pick is not None else int(1.0/dt)\n    idx_s=np.where(ratio_s>thr_s)[0]\n    idx_s=idx_s[idx_s>=start]\n    if idx_s.size>0:\n        s_pick=int(idx_s[0]); rows.append((os.path.basename(fn),'S',s_pick))\n\nimport csv\nout='/root/results.csv'\nwith open(out,'w',newline='') as f:\n    w=csv.writer(f)\n    w.writerow(['file_name','phase','pick_idx'])\n    for r in rows:\n        w.writerow(r)\nprint('wrote',out,'rows',len(rows))\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
