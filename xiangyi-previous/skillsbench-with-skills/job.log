wer() or code == 'GEO':\n                    georgia_growth = growth_values[code]\n                    print(f'Found Georgia Growth data under code: {code}')\n                    break\n            \n            if georgia_gdp:\n                print(f'Sample GDP data: {dict(list(georgia_gdp.items())[:5])}')\n            if georgia_growth:\n                print(f'Sample Growth data: {dict(list(georgia_growth.items())[:5])}')\n                \nexcept Exception as e:\n    print(f'Error: {e}')\n    import traceback\n    traceback.print_exc()\n\nEOF\n"] min_timeout_sec: 10.0 max_timeout_sec: 180.0
