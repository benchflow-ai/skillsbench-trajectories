reatment\']:\n            user_cat_period = purchases_top[\n                (purchases_top[\'Survey ResponseID\'] == user) &\n                (purchases_top[\'Category\'] == category) &\n                (purchases_top[\'Period\'] == period)\n            ]\n            has_purchase = 1 if len(user_cat_period) > 0 else 0\n            extensive_data.append({\n                \'Survey ResponseID\': user,\n                \'Category\': category,\n                \'Period\': period,\n                \'Has_Purchase\': has_purchase\n            })\n\nextensive_df = pd.DataFrame(extensive_data)\nextensive_df.to_csv(\'/app/output/user_category_period_aggregated_extensive.csv\', index=False)\nprint(f"Extensive margin data created: {extensive_df.shape}")\n\n# Step 5: DiD Causal Analysis\nprint("\\nStep 5: Performing DiD causal analysis...")\n\nfrom scipy import stats\nimport statsmodels.api as sm\n\n# Merge intensive data with features\nintensive_merged = intensive_df.merge(survey_fe, on=\'Survey ResponseID\', how=\'left\')\n\n# Merge extensive data with features\nextensive_merged = extensive_df.merge(survey_fe, on=\'Survey ResponseID\', how=\'left\')\n\n# Function to perform univariate DiD for intensive margin\ndef univariate_did_intensive(data, category, feature):\n    cat_data = data[data[\'Category\'] == category].copy()\n    \n    # Check if feature has variation\n    if cat_data[feature].nunique() < 2:\n        return None\n    \n    # Create treatment and post indicators\n    cat_data[\'post\'] = (cat_data[\'Period\'] == \'treatment\').astype(int)\n    cat_data[\'treated\'] = cat_data[feature]\n    cat_data[\'did_interaction\'] = cat_data[\'post\'] * cat_data[\'treated\']\n    \n    # Remove rows with missing values\n    cat_data = cat_data[[\'Total_Spend\', \'post\', \'treated\', \'did_interaction\']].dropna()\n    \n    if len(cat_data) < 10:\n        return None\n    \n    try:\n        # Run regression: Y = b0 + b1*post + b2*treated + b3*(post*treated)\n        X = cat_data[[\'post\', \'treated\', \'did_interaction\']]\n        X = sm.add_constant(X)\n        y = cat_data[\'Total_Spend\']\n        \n        model = sm.OLS(y, X).fit()\n        \n        # DiD estimate is the coefficient on the interaction term\n        did_estimate = model.params[\'did_interaction\']\n        p_value = model.pvalues[\'did_interaction\']\n        \n        return {\n            \'feature\': feature,\n            \'did_estimate\': round(float(did_estimate), 2),\n            \'p_value\': round(float(p_value), 4),\n            \'method\': \'Univariate DiD\'\n        }\n    except:\n        return None\n\n# Function to perform multivariate heterogeneous DiD for extensive margin\ndef multivariate_did_extensive(data, category, features):\n    cat_data = data[data[\'Category\'] == category].copy()\n    cat_data[\'post\'] = (cat_data[\'Period\'] == \'treatment\').astype(int)\n    \n    results = []\n    \n    for feature in features:\n        if cat_data[feature].nunique() < 2:\n            continue\n        \n        cat_data[\'treated\'] = cat_data[feature]\n        cat_data[\'did_interaction\'] = cat_data[\'post\'] * cat_data[\'treated\']\n        \n        # Prepare data\n        analysis_data = cat_data[[\'Has_Purchase\', \'post\', \'treated\', \'did_interaction\']].dropna()\n        \n        if len(analysis_data) < 10:\n            continue\n        \n        try:\n            X = analysis_data[[\'post\', \'treated\', \'did_interaction\']]\n            X = sm.add_constant(X)\n            y = analysis_data[\'Has_Purchase\']\n            \n            model = sm.OLS(y, X).fit()\n            \n            did_estimate = model.params[\'did_interaction\']\n            p_value = model.pvalues[\'did_interaction\']\n            \n            results.append({\n                \'feature\': feature,\n                \'did_estimate\': round(float(did_estimate), 4),\n                \'p_value\': round(float(p_value), 4),\n                \'method\': \'Multivariate Heterogeneous DiD\'\n            })\n        except:\n            continue\n    \n    return results\nENDOFFILE\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
