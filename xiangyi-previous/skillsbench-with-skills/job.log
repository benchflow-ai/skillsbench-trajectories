Sending keys: ['cat >> /root/Tokenizer.scala << \'EOF\'\n\n// ============================================================================\n// Tokenizer Implementations\n// ============================================================================\n\ntrait BaseTokenizer[T] {\n  def tokenize(value: T): Token\n\n  def tokenizeBatch(values: Iterable[T]): Seq[Token] = {\n    values.map(tokenize).toSeq\n  }\n}\n\nclass StringTokenizer(\n  lowercase: Boolean = false,\n  uppercase: Boolean = false,\n  stripWhitespace: Boolean = true,\n  maxLength: Option[Int] = None,\n  prefix: String = "",\n  suffix: String = ""\n) extends BaseTokenizer[String] {\n\n  def tokenize(value: String): Token = {\n    var processed = value\n\n    if (stripWhitespace) {\n      processed = processed.trim\n    }\n\n    if (lowercase) {\n      processed = processed.toLowerCase\n    }\n\n    if (uppercase) {\n      processed = processed.toUpperCase\n    }\n\n    maxLength.foreach { max =>\n      if (processed.length > max) {\n        processed = processed.take(max)\n      }\n    }\n\n    processed = prefix + processed + suffix\n\n    val metadata = Map(\n      "original_length" -> value.length,\n      "processed_length" -> processed.length\n    )\n\n    Token(processed, TokenType.String, metadata)\n  }\n}\n\nclass NumericTokenizer(\n  precision: Option[Int] = None,\n  useScientific: Boolean = false,\n  prefix: String = "",\n  suffix: String = ""\n) extends BaseTokenizer[Any] {\n\n  def tokenize(value: Any): Token = {\n    val numValue: BigDecimal = value match {\n      case i: Int => BigDecimal(i)\n      case l: Long => BigDecimal(l)\n      case f: Float => BigDecimal(f.toDouble)\n      case d: Double => BigDecimal(d)\n      case bd: BigDecimal => bd\n      case _ => throw new IllegalArgumentException(s"Unsupported numeric type: ${value.getClass}")\n    }\n\n    val formatted = precision match {\n      case Some(p) => numValue.setScale(p, BigDecimal.RoundingMode.HALF_UP).toString\n      case None => numValue.toString\n    }\n\n    val processed = prefix + formatted + suffix\n\n    val metadata = Map(\n      "original_value" -> value,\n      "numeric_type" -> value.getClass.getSimpleName\n    )\n\n    Token(processed, TokenType.Numeric, metadata)\n  }\n}\n\nclass TemporalTokenizer(\n  dateFormat: String = "yyyy-MM-dd",\n  datetimeFormat: String = "yyyy-MM-dd\'T\'HH:mm:ss"\n) extends BaseTokenizer[Any] {\n\n  private val dateFormatter = DateTimeFormatter.ofPattern(dateFormat)\n  private val datetimeFormatter = DateTimeFormatter.ofPattern(datetimeFormat)\n\n  def tokenize(value: Any): Token = {\n    val (formatted, temporalType) = value match {\n      case d: LocalDate =>\n        (d.format(dateFormatter), "date")\n      case dt: LocalDateTime =>\n        (dt.format(datetimeFormatter), "datetime")\n      case _ =>\n        throw new IllegalArgumentException(s"Unsupported temporal type: ${value.getClass}")\n    }\n\n    val metadata = Map(\n      "temporal_type" -> temporalType,\n      "format" -> (if (temporalType == "date") dateFormat else datetimeFormat)\n    )\n\n    Token(formatted, TokenType.Temporal, metadata)\n  }\n}\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
