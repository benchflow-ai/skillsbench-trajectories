Sending keys: ['cat >> solve_ed.py << \'EOF\'\n\n# Set Qg proportional to Pg within limits\nQg = np.zeros(n_gen)\nfor i in range(n_gen):\n    if gen_status[i] and Pg[i] > 0:\n        # Assume power factor of 0.95\n        Qg[i] = Pg[i] * 0.33  # tan(acos(0.95))\n        Qg[i] = np.clip(Qg[i], Qmin[i], Qmax[i])\n\n# Parse branch data\nfbus = branches[:, 0].astype(int) - 1\ntbus = branches[:, 1].astype(int) - 1\nR = branches[:, 2]\nX = branches[:, 3]\nB = branches[:, 4]\nrate_a = branches[:, 5]\ntap = branches[:, 7]\nshift = branches[:, 8] * np.pi / 180\nbr_status = branches[:, 10].astype(int)\n\ntap[tap == 0] = 1.0\n\n# Build Ybus\nprint("Building admittance matrix...")\nYbus = np.zeros((n_bus, n_bus), dtype=complex)\nfor i in range(n_branch):\n    if br_status[i] == 0:\n        continue\n    f = fbus[i]\n    t = tbus[i]\n    Ys = 1.0 / (R[i] + 1j * X[i])\n    Ysh = 1j * B[i]\n    tr = tap[i] * np.exp(1j * shift[i])\n    Ybus[f, f] += (Ys + Ysh/2) / (tr * np.conj(tr))\n    Ybus[t, t] += Ys + Ysh/2\n    Ybus[f, t] += -Ys / np.conj(tr)\n    Ybus[t, f] += -Ys / tr\n\nfor i in range(n_bus):\n    Ybus[i, i] += Gs[i] + 1j * Bs[i]\n\n# Convert to per-unit\nPd_pu = Pd / baseMVA\nQd_pu = Qd / baseMVA\nPg_pu = Pg / baseMVA\nQg_pu = Qg / baseMVA\nVa_rad = Va * np.pi / 180\n\nprint("Calculating power flows...")\nV = Vm * np.exp(1j * Va_rad)\nS_calc = V * np.conj(Ybus @ V)\nP_calc = S_calc.real\nQ_calc = S_calc.imag\n\n# Net injections\nP_inj = np.zeros(n_bus)\nQ_inj = np.zeros(n_bus)\nfor i in range(n_gen):\n    if gen_status[i]:\n        P_inj[gen_bus[i]] += Pg_pu[i]\n        Q_inj[gen_bus[i]] += Qg_pu[i]\n\ndP = P_inj - Pd_pu - P_calc\ndQ = Q_inj - Qd_pu - Q_calc\n\nmax_p_mis = np.max(np.abs(dP)) * baseMVA\nmax_q_mis = np.max(np.abs(dQ)) * baseMVA\nprint(f"Max P mismatch: {max_p_mis:.6f} MW")\nprint(f"Max Q mismatch: {max_q_mis:.6f} MVAr")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
