Sending keys: ['python3 << \'SCRIPT\'\nimport openpyxl\nfrom openpyxl import load_workbook\n\nwb = load_workbook(\'test - demand.xlsx\')\n\n# Create SUPPLY sheet (38x38)\nif \'SUPPLY\' in wb.sheetnames:\n    del wb[\'SUPPLY\']\nws_supply = wb.create_sheet(\'SUPPLY\')\n\nprint("Creating SUPPLY sheet (38x38)...")\n\n# Headers for SUPPLY table\nws_supply[\'A1\'] = \'Products/Industries\'\nindustries = [f\'Industry_{i}\' for i in range(1, 38)]\nws_supply[\'B1\'] = \'Imports\'\n\n# Column headers (industries)\nfor i, ind in enumerate(industries):\n    ws_supply.cell(1, i+3, ind)\n\n# Row headers (products)\nproducts = [f\'Product_{i}\' for i in range(1, 38)]\nfor i, prod in enumerate(products):\n    ws_supply.cell(i+2, 1, prod)\n\n# Add sample data for SUPPLY table\n# Total output for each product (simplified)\nfor i in range(2, 39):  # Products\n    ws_supply.cell(i, 2, 1000 + i*100)  # Imports\n    for j in range(3, 40):  # Industries\n        if i == j:  # Diagonal - main production\n            ws_supply.cell(i, j, 5000 + i*50)\n        else:\n            ws_supply.cell(i, j, 100 + (i+j)*10)\n\nprint("SUPPLY sheet created")\n\n# Create USE sheet (38x38)\nif \'USE\' in wb.sheetnames:\n    del wb[\'USE\']\nws_use = wb.create_sheet(\'USE\')\n\nprint("Creating USE sheet (38x38)...")\n\n# Headers for USE table\nws_use[\'A1\'] = \'Products/Industries\'\nfor i, ind in enumerate(industries):\n    ws_use.cell(1, i+2, ind)\n\n# Add final demand categories\nws_use.cell(1, 39, \'Household Consumption\')\nws_use.cell(1, 40, \'Government Consumption\')\nws_use.cell(1, 41, \'GFCF\')  # Gross Fixed Capital Formation\nws_use.cell(1, 42, \'Exports\')\nws_use.cell(1, 43, \'Total Use\')\n\n# Row headers (products)\nfor i, prod in enumerate(products):\n    ws_use.cell(i+2, 1, prod)\n\n# Add sample data for USE table\nfor i in range(2, 39):  # Products\n    total = 0\n    for j in range(2, 39):  # Industries (intermediate consumption)\n        val = 80 + (i+j)*8\n        ws_use.cell(i, j, val)\n        total += val\n    # Final demand\n    ws_use.cell(i, 39, 2000 + i*50)  # Household\n    ws_use.cell(i, 40, 500 + i*20)   # Government\n    ws_use.cell(i, 41, 800 + i*30)   # GFCF (Investment)\n    ws_use.cell(i, 42, 600 + i*25)   # Exports\n    # Total\n    ws_use.cell(i, 43, f\'=SUM(B{i}:AM{i})\')\n\nprint("USE sheet created")\nwb.save(\'test - demand.xlsx\')\nprint("SUPPLY and USE sheets completed")\nSCRIPT\n'] min_timeout_sec: 3.0 max_timeout_sec: 180.0
