\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                return f"{year}-{month}-{day}"\n        \n        # Pattern: DD/MM/YY or DD-MM-YY\n        match = re.search(r\'(\\d{1,2})[/\\-\\.](\\d{1,2})[/\\-\\.](\\d{2})(?!\\d)\', line)\n        if match:\n            day, month, year = match.groups()\n            day = day.zfill(2)\n            month = month.zfill(2)\n            # Fix common OCR errors\n            if int(month) > 12:\n                month_fixed = month.replace(\'6\', \'0\').replace(\'5\', \'0\')\n                if 1 <= int(month_fixed) <= 12:\n                    month = month_fixed\n            year = \'20\' + year if int(year) < 50 else \'19\' + year\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                return f"{year}-{month}-{day}"\n        \n        # Pattern: DDMMYYYY (no separator, like 2032018 for 20/3/2018)\n        match = re.search(r\'(\\d{1,2})(\\d{1,2})(\\d{4})\', line)\n        if match:\n            # Try to parse as DMMYYYY or DDMYYYY or DDMMYYYY\n            full = match.group(0)\n            if len(full) == 7:  # DMMYYYY like 2032018\n                day = full[0:1]\n                month = full[1:2]\n                year = full[2:]\n                if month == \'0\':  # Try DDMYYYY\n                    day = full[0:2]\n                    month = full[2:3]\n                    year = full[3:]\n            elif len(full) == 8:  # DDMMYYYY\n                day = full[0:2]\n                month = full[2:4]\n                year = full[4:]\n            else:\n                continue\n            day = day.zfill(2)\n            month = month.zfill(2)\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31 and len(year) == 4:\n                return f"{year}-{month}-{day}"\n        \n        # Pattern: DD MMM YYYY or DD-MMM-YYYY\n        match = re.search(r\'(\\d{1,2})[\\s\\-\\./]*(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-\\./]*(\\d{4})\', line, re.IGNORECASE)\n        if match:\n            day, month_str, year = match.groups()\n            day = day.zfill(2)\n            month = month_map[month_str.lower()[:3]]\n            return f"{year}-{month}-{day}"\n        \n        # Pattern: MMM DD, YYYY\n        match = re.search(r\'(Jan|Feb|Mar|Apr|May|Jun|Jul|Aug|Sep|Oct|Nov|Dec)[a-z]*[\\s\\-\\./]*(\\d{1,2})[,\\s]+(\\d{4})\', line, re.IGNORECASE)\n        if match:\n            month_str, day, year = match.groups()\n            day = day.zfill(2)\n            month = month_map[month_str.lower()[:3]]\n            return f"{year}-{month}-{day}"\n    \n    # Second pass: look for date-like patterns with OCR errors\n    for line in lines:\n        # Look for patterns like "7B 02/18" which might be date\n        match = re.search(r\'(\\d{1,2})[A-Za-z]?\\s+(\\d{1,2})[/\\-](\\d{2})(?!\\d)\', line)\n        if match:\n            day, month, year = match.groups()\n            day = day.zfill(2)\n            month = month.zfill(2)\n            year = \'20\' + year if int(year) < 50 else \'19\' + year\n            if 1 <= int(month) <= 12 and 1 <= int(day) <= 31:\n                return f"{year}-{month}-{day}"\n    \n    return None\n\ndef extract_total_amount(text):\n    """Extract total amount from OCR text based on priority keywords."""\n    lines = text.split(\'\\n\')\n    \n    exclusion_keywords = [\'SUBTOTAL\', \'SUB TOTAL\', \'SUB-TOTAL\', \'TAX\', \'GST\', \'SST\', \'DISCOUNT\', \'CHANGE\', \'CASH TENDERED\', \'EXCL\']\n    \n    # Priority keyword patterns (from most to least specific)\n    priority_patterns = [\n        (r\'GRAND\\s*TOTAL\', 1),\n        (r\'TOTAL\\s*:?\\s*RM\', 2),\n        (r\'TOTAL\\s*AMOUNT\', 3),\n        (r\'TOTAL\\s*DUE\', 4),\n        (r\'AMOUNT\\s*DUE\', 4),\n        (r\'BALANCE\\s*DUE\', 4),\n        (r\'NETT\\s*TOTAL\', 4),\n        (r\'NET\\s*TOTAL\', 4),\n        (r\'TOTAL\\s*ROUNDED\', 5),\n        (r\'TOTAL\\s*RM\', 5),\n        (r\'TOTAL\\s*INCL\', 5),\n        (r\'TOTAL\\s*AFTER\', 5),\n        (r\'(?<!SUB)\\s*TOTAL(?!\\s*QTY|\\s*QUANTITY|\\s*ITEM|\\s*SAVING)\', 6),\n        (r\'AMOUNT\', 7),\n    ]\n    \n    def extract_amount_from_line(line):\n        """Extract monetary value from a line."""\n        # Fix common OCR errors\n        line_fixed = line.replace(\'u\', \'0\').replace(\'U\', \'0\')\n        line_fixed = line_fixed.replace(\',\', \'\')  # Remove comma separators first\n        \n        # Match numbers with decimal point and exactly 2 decimal places\n        matches = re.findall(r\'(\\d+\\.\\d{2})(?!\\d)\', line_fixed)\n        if matches:\n            # Return the last match (usually the amount is at the end)\n            return matches[-1]\n        \n        # Try original line with comma handling\n        matches = re.findall(r\'([\\d,]+\\.\\d{2})(?!\\d)\', line)\n        if matches:\n            amount = matches[-1].replace(\',\', \'\')\n            return amount\n        \n        return None\n    \n    def should_exclude(line):\n        """Check if line contains exclusion keywords."""\n        upper_line = line.upper()\n        for kw in exclusion_keywords:\n            if kw in upper_line:\n                return True\n        return False\n    \n    # Try each priority pattern in order\n    for pattern, priority in priority_patterns:\n        for i, line in enumerate(lines):\n            if should_exclude(line):\n                continue\n            upper_line = line.upper()\n            if re.search(pattern, upper_line, re.IGNORECASE):\n                # Try to extract amount from this line\n                amount = extract_amount_from_line(line)\n                if amount:\n                    return amount\n                # Fallback: check the next line\n                if i + 1 < len(lines):\n                    next_line = lines[i + 1]\n                    if not should_exclude(next_line):\n                        amount = extract_amount_from_line(next_line)\n                        if amount:\n                            return amount\n    \n    return None\n\ndef main():\n    img_dir = \'/app/workspace/dataset/img\'\n    output_file = \'/app/workspace/stat_ocr.xlsx\'\n    \n    # Get all jpg files sorted by filename\n    files = sorted([f for f in os.listdir(img_dir) if f.lower().endswith((\'.jpg\', \'.jpeg\', \'.png\'))])\n    \n    results = []\n    \n    for filename in files:\n        image_path = os.path.join(img_dir, filename)\n        print(f"Processing {filename}...")\n        \n        text = extract_text(image_path)\n        \n        date = extract_date(text)\n        total_amount = extract_total_amount(text)\n        \n        print(f"  Date: {date}")\n        print(f"  Total: {total_amount}")\n        \n        results.append({\n            \'filename\': filename,\n            \'date\': date,\n            \'total_amount\': total_amount\n        })\n    \n    # Create Excel file\n    wb = Workbook()\n    ws = wb.active\n    ws.title = \'results\'\n    \n    # Write header\n    ws[\'A1\'] = \'filename\'\n    ws[\'B1\'] = \'date\'\n    ws[\'C1\'] = \'total_amount\'\n    \n    # Write data\n    for i, result in enumerate(results, start=2):\n        ws[f\'A{i}\'] = result[\'filename\']\n        ws[f\'B{i}\'] = result[\'date\']\n        ws[f\'C{i}\'] = result[\'total_amount\']\n    \n    wb.save(output_file)\n    print(f"\\nResults saved to {output_file}")\n\nif __name__ == \'__main__\':\n    main()\nENDOFSCRIPT\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
