            s_time = None\n        \n        # Store picks\n        key = (trace.stats.network, trace.stats.station, trace.stats.channel)\n        picks[key] = []\n        if p_time is not None:\n            picks[key].append((p_time, \'P\'))\n        if s_time is not None:\n            picks[key].append((s_time, \'S\'))\n    except Exception as e:\n        print(f"Error processing trace {trace.stats.network}.{trace.stats.station}.{trace.stats.channel}: {e}")\n        continue\n\nprint(f"\\nExtracted picks from {len(picks)} channels")\n\n# Event association\n# Group picks by similar P-wave arrival times (within 5 seconds)\nevents = []\nvp = 6.0  # km/s\nvs = vp / 1.75  # km/s\n\n# Get unique P-wave picks\np_picks = []\nfor key, pick_list in picks.items():\n    for pick_time, phase in pick_list:\n        if phase == \'P\':\n            p_picks.append((pick_time, key))\n\np_picks.sort(key=lambda x: x[0])\n\n# Cluster picks into events\nif p_picks:\n    current_event_time = p_picks[0][0]\n    current_event_picks = [p_picks[0]]\n    \n    for pick_time, key in p_picks[1:]:\n        if (pick_time - current_event_time) < 5:  # 5 second window\n            current_event_picks.append((pick_time, key))\n        else:\n            # Save current event\n            if len(current_event_picks) >= 3:  # Need at least 3 stations\n                event_time = np.median([p[0].timestamp for p in current_event_picks])\n                events.append(datetime.utcfromtimestamp(event_time))\n            \n            # Start new event\n            current_event_time = pick_time\n            current_event_picks = [(pick_time, key)]\n    \n    # Don\'t forget last event\n    if len(current_event_picks) >= 3:\n        event_time = np.median([p[0].timestamp for p in current_event_picks])\n        events.append(datetime.utcfromtimestamp(event_time))\n\nprint(f"\\nIdentified {len(events)} earthquake events")\n\n# Write results\nresults_df = pd.DataFrame({\'time\': [e.isoformat() for e in events]})\nresults_df.to_csv(\'/root/results.csv\', index=False)\nprint(f"Results written to /root/results.csv")\nprint(results_df.head())\nEOF\n'] min_timeout_sec: 1.0 max_timeout_sec: 180.0
