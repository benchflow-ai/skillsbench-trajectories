egory\'])[\'Total_Price\'].sum().reset_index()\n\nhistory_daily = get_daily_category_sales(history_df)\nbaseline_daily = get_daily_category_sales(baseline_df)\ntreatment_daily = get_daily_category_sales(treatment_df)\n\nprint(f"\\nDaily category sales calculated")\nprint(f"History unique categories: {history_daily[\'Category\'].nunique()}")\nprint(f"Baseline unique categories: {baseline_daily[\'Category\'].nunique()}")\nprint(f"Treatment unique categories: {treatment_daily[\'Category\'].nunique()}")\n\n# Calculate anomaly index for each category\nanomaly_results = []\n\nfor category in treatment_daily[\'Category\'].unique():\n    # Get historical data for this category\n    hist_cat = history_daily[history_daily[\'Category\'] == category][\'Total_Price\'].values\n    \n    # Get baseline data for this category\n    base_cat = baseline_daily[baseline_daily[\'Category\'] == category][\'Total_Price\'].values\n    \n    # Get treatment data for this category\n    treat_cat = treatment_daily[treatment_daily[\'Category\'] == category][\'Total_Price\'].values\n    \n    if len(hist_cat) == 0 or len(treat_cat) == 0:\n        continue\n    \n    # Calculate expected spending based on historical trend\n    hist_mean = np.mean(hist_cat)\n    hist_std = np.std(hist_cat)\n    \n    # Calculate actual treatment mean\n    treat_mean = np.mean(treat_cat)\n    \n    # Calculate baseline mean\n    base_mean = np.mean(base_cat) if len(base_cat) > 0 else hist_mean\n    \n    # Calculate anomaly index (-100 to 100)\n    # Compare treatment to historical baseline\n    if hist_std == 0:\n        if treat_mean > hist_mean:\n            anomaly_index = 50\n        elif treat_mean < hist_mean:\n            anomaly_index = -50\n        else:\n            anomaly_index = 0\n    else:\n        # Standardized deviation\n        z_score = (treat_mean - hist_mean) / hist_std\n        # Scale to -100 to 100 range\n        anomaly_index = np.clip(z_score * 20, -100, 100)\n    \n    anomaly_results.append({\n        \'Category\': category,\n        \'Anomaly_Index\': anomaly_index,\n        \'Hist_Mean\': hist_mean,\n        \'Base_Mean\': base_mean,\n        \'Treat_Mean\': treat_mean,\n        \'Hist_Std\': hist_std,\n        \'Treat_N_Days\': len(treat_cat)\n    })\n\nanomaly_df = pd.DataFrame(anomaly_results)\nanomaly_df = anomaly_df.sort_values(\'Anomaly_Index\', ascending=False).reset_index(drop=True)\n\nprint(f"\\nAnomalies calculated for {len(anomaly_df)} categories")\nprint(f"\\nTop 10 surge categories:")\nprint(anomaly_df.head(10)[[\'Category\', \'Anomaly_Index\', \'Treat_Mean\']].to_string())\nprint(f"\\nTop 10 slump categories:")\nprint(anomaly_df.tail(10)[[\'Category\', \'Anomaly_Index\', \'Treat_Mean\']].to_string())\n\n# Save anomaly index\nanomaly_df[[\'Category\', \'Anomaly_Index\']].to_csv(\'/app/output/category_anomaly_index.csv\', index=False)\nprint("\\nAnomaly index saved.")\n\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
