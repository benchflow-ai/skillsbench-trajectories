Sending keys: ['python3 << \'EOF\'\nimport json\nimport subprocess\nfrom datetime import datetime\nfrom collections import defaultdict\nimport os\n\nrepo = "cli/cli"\napi_base = "https://api.github.com/repos"\n\nstart_date = "2024-12-01T00:00:00Z"\nend_date = "2024-12-31T23:59:59Z"\n\n# Try to get GitHub token from environment\ntoken = os.environ.get(\'GITHUB_TOKEN\', \'\')\nheaders = []\nif token:\n    headers = [\'-H\', f\'Authorization: token {token}\']\n\ndef run_curl(url):\n    """Run curl command with timeout"""\n    cmd = [\'curl\', \'-s\', \'--max-time\', \'10\'] + headers + [url]\n    try:\n        result = subprocess.run(cmd, capture_output=True, text=True, timeout=15)\n        if result.stdout.strip():\n            return json.loads(result.stdout)\n    except Exception as e:\n        print(f"Error fetching {url}: {e}")\n    return None\n\nprint("Fetching PRs created in December 2024...")\npr_query = f"{api_base}/{repo}/pulls?state=all&sort=created&direction=desc&per_page=100"\nall_prs = []\npage = 1\nwhile page <= 5:  # Limit to 5 pages to avoid timeout\n    page_url = f"{pr_query}&page={page}"\n    print(f"  Fetching PR page {page}...")\n    prs = run_curl(page_url)\n    if not prs:\n        break\n    if isinstance(prs, dict) and \'message\' in prs:\n        print(f"  API Error: {prs[\'message\']}")\n        break\n    if not isinstance(prs, list) or len(prs) == 0:\n        break\n    \n    # Filter PRs created in December 2024\n    for pr in prs:\n        created = datetime.fromisoformat(pr[\'created_at\'].replace(\'Z\', \'+00:00\'))\n        if created.year == 2024 and created.month == 12:\n            all_prs.append(pr)\n    \n    if len(prs) < 100:\n        break\n    page += 1\n\nprint(f"Found {len(all_prs)} PRs created in December 2024")\n\nmerged_prs = [pr for pr in all_prs if pr[\'merged_at\'] is not None]\nclosed_prs = [pr for pr in all_prs if pr[\'state\'] == \'closed\' and pr[\'merged_at\'] is None]\n\nprint(f"  Merged: {len(merged_prs)}, Closed: {len(closed_prs)}")\n\nmerge_times = []\nfor pr in merged_prs:\n    created = datetime.fromisoformat(pr[\'created_at\'].replace(\'Z\', \'+00:00\'))\n    merged = datetime.fromisoformat(pr[\'merged_at\'].replace(\'Z\', \'+00:00\'))\n    days = (merged - created).days + (merged - created).seconds / 86400\n    merge_times.append(days)\n\navg_merge_days = round(sum(merge_times) / len(merge_times), 1) if merge_times else 0.0\nprint(f"  Average merge time: {avg_merge_days} days")\n\ncontributor_count = defaultdict(int)\nfor pr in all_prs:\n    contributor = pr[\'user\'][\'login\']\n    contributor_count[contributor] += 1\n\ntop_contributor = max(contributor_count, key=contributor_count.get) if contributor_count else ""\nprint(f"  Top contributor: {top_contributor} ({contributor_count[top_contributor]} PRs)")\n\nprint("\\nFetching issues created in December 2024...")\nissue_query = f"{api_base}/{repo}/issues?state=all&sort=created&direction=desc&per_page=100"\nall_issues = []\npage = 1\nwhile page <= 5:\n    page_url = f"{issue_query}&page={page}"\n    print(f"  Fetching issue page {page}...")\n    issues = run_curl(page_url)\n    if not issues:\n        break\n    if isinstance(issues, dict) and \'message\' in issues:\n        print(f"  API Error: {issues[\'message\']}")\n        break\n    if not isinstance(issues, list) or len(issues) == 0:\n        break\n    \n    for issue in issues:\n        created = datetime.fromisoformat(issue[\'created_at\'].replace(\'Z\', \'+00:00\'))\n        if created.year == 2024 and created.month == 12:\n            all_issues.append(issue)\n    \n    if len(issues) < 100:\n        break\n    page += 1\n\nprint(f"Found {len(all_issues)} issues created in December 2024")\n\nbug_issues = []\nfor issue in all_issues:\n    labels = issue.get(\'labels\', [])\n    has_bug_label = any(\'bug\' in label[\'name\'].lower() for label in labels)\n    if has_bug_label:\n        bug_issues.append(issue)\n\nprint(f"  Bug reports: {len(bug_issues)}")\n\nresolved_bugs = [issue for issue in bug_issues if issue[\'state\'] == \'closed\']\nprint(f"  Resolved bugs: {len(resolved_bugs)}")\n\nreport = {\n    "pr": {\n        "total": len(all_prs),\n        "merged": len(merged_prs),\n        "closed": len(closed_prs),\n        "avg_merge_days": avg_merge_days,\n        "top_contributor": top_contributor\n    },\n    "issue": {\n        "total": len(all_issues),\n        "bug": len(bug_issues),\n        "resolved_bugs": len(resolved_bugs)\n    }\n}\n\nprint("\\nReport:")\nprint(json.dumps(report, indent=2))\n\nwith open(\'/app/report.json\', \'w\') as f:\n    json.dump(report, f, indent=2)\n\nprint("\\nReport saved to /app/report.json")\nEOF\n'] min_timeout_sec: 10.0 max_timeout_sec: 180.0
