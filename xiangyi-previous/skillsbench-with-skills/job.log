Sending keys: ['cat > run_calibration.py << \'EOF\'\n#!/usr/bin/env python3\nimport json\nimport sys\nsys.path.insert(0, \'/root\')\nfrom hvac_simulator import HVACSimulator\n\n# Initialize simulator\nsim = HVACSimulator()\n\n# Get initial reading\ninitial_temp = sim.reset()\nprint(f"Initial temperature: {initial_temp:.2f}C")\nprint(f"Setpoint: {sim.get_setpoint()}C")\nprint(f"Ambient: {sim.get_ambient_temp()}C")\nprint(f"Safety limits: {sim.get_safety_limits()}")\nprint(f"Timestep: {sim.get_dt()}s")\n\n# Calibration parameters\ntest_power = 50.0  # 50% heater power for step test\ncalibration_duration = 35.0  # 35 seconds of data\n\n# Collect calibration data\ndata = []\n# Record initial state\ndata.append({"time": 0.0, "temperature": round(initial_temp, 4), "heater_power": 0.0})\n\n# Run step response test\nsteps = int(calibration_duration / sim.get_dt())\nfor i in range(steps):\n    result = sim.step(test_power)\n    data.append({\n        "time": result["time"],\n        "temperature": result["temperature"],\n        "heater_power": result["heater_power"]\n    })\n\n# Save calibration log\ncalibration_log = {\n    "phase": "calibration",\n    "heater_power_test": test_power,\n    "data": data\n}\n\nwith open("calibration_log.json", "w") as f:\n    json.dump(calibration_log, f, indent=2)\n\nprint(f"\\nCalibration complete: {len(data)} data points collected over {calibration_duration}s")\nprint(f"Saved to calibration_log.json")\nprint(f"\\nFirst 5 data points:")\nfor d in data[:5]:\n    print(f"  t={d[\'time\']:.1f}s: T={d[\'temperature\']:.2f}C, P={d[\'heater_power\']:.0f}%")\nprint(f"\\nLast 5 data points:")\nfor d in data[-5:]:\n    print(f"  t={d[\'time\']:.1f}s: T={d[\'temperature\']:.2f}C, P={d[\'heater_power\']:.0f}%")\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
