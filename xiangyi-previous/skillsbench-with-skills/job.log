Sending keys: ['cat > /app/normalize_v3.py << \'EOF\'\nimport csv\nimport json\nimport re\nfrom difflib import SequenceMatcher\nimport os\n\n# Load codebooks\ndef load_codebooks():\n    codebooks = {}\n    for product in [\'P1_POWER\', \'P2_CTRL\', \'P3_RF\']:\n        codebooks[product] = {}\n        with open(f\'/app/data/codebook_{product}.csv\', \'r\', encoding=\'utf-8\') as f:\n            reader = csv.DictReader(f)\n            for row in reader:\n                code = row[\'code\']\n                codebooks[product][code] = {\n                    \'standard_label\': row[\'standard_label\'],\n                    \'category_lv1\': row[\'category_lv1\'],\n                    \'category_lv2\': row[\'category_lv2\'],\n                    \'station_scope\': row[\'station_scope\'],\n                    \'keywords\': [k.strip() for k in row[\'keywords_examples\'].split(\',\')]\n                }\n    return codebooks\n\n# Improved segmentation - split on major delimiters only\ndef segment_text(text):\n    # First split on major delimiters\n    segments = re.split(r\'[，,；;/\\\\|、]+\', text)\n    segments = [s.strip() for s in segments if s.strip()]\n    \n    # Further split on \'and\' keywords but keep phrases together\n    final_segments = []\n    for seg in segments:\n        # If segment is very long, try to split on \'and\' patterns\n        if len(seg) > 30:\n            # Split on \' and \' or \' & \' but keep context\n            subsegments = re.split(r\'\\s+and\\s+|\\s+&\\s+\', seg, flags=re.IGNORECASE)\n            if len(subsegments) > 1:\n                final_segments.extend([s.strip() for s in subsegments if s.strip()])\n            else:\n                final_segments.append(seg)\n        else:\n            final_segments.append(seg)\n    \n    return final_segments\n\n# Calculate similarity score\ndef similarity_score(s1, s2):\n    return SequenceMatcher(None, s1.lower(), s2.lower()).ratio()\n\n# Match segment to codebook\ndef match_segment(segment, codebook, station):\n    best_match = None\n    best_score = 0\n    best_code = \'UNKNOWN\'\n    match_type = \'none\'\n    \n    segment_lower = segment.lower()\n    \n    for code, entry in codebook.items():\n        # Check if station is in scope\n        if station not in entry[\'station_scope\']:\n            continue\n        \n        # Keyword matching with partial match support\n        keyword_score = 0\n        for keyword in entry[\'keywords\']:\n            keyword_lower = keyword.lower()\n            # Exact keyword match\n            if keyword_lower == segment_lower:\n                keyword_score = 1.0\n                break\n            # Substring match - check if keyword is in segment or vice versa\n            elif keyword_lower in segment_lower or segment_lower in keyword_lower:\n                # Calculate match quality based on overlap\n                if keyword_lower in segment_lower:\n                    overlap_ratio = len(keyword_lower) / len(segment_lower)\n                else:\n                    overlap_ratio = len(segment_lower) / len(keyword_lower)\n                keyword_score = max(keyword_score, overlap_ratio * 0.9)\n        \n        # Similarity matching with label\n        label_sim = similarity_score(segment, entry[\'standard_label\'])\n        \n        # Combined score\n        if keyword_score > 0:\n            combined_score = keyword_score * 0.75 + label_sim * 0.25\n            current_match_type = \'keyword\'\n        else:\n            combined_score = label_sim * 0.4\n            current_match_type = \'similarity\'\n        \n        if combined_score > best_score:\n            best_score = combined_score\n            best_match = entry\n            best_code = code\n            match_type = current_match_type\n    \n    # If no good match found, return UNKNOWN\n    if best_score < 0.4:\n        return {\n            \'code\': \'UNKNOWN\',\n            \'label\': \'\',\n            \'confidence\': 0.0,\n            \'match_type\': \'none\'\n        }\n    \n    return {\n        \'code\': best_code,\n        \'label\': best_match[\'standard_label\'],\n        \'confidence\': min(best_score, 1.0),\n        \'match_type\': match_type\n    }\n\n# Generate rationale\ndef generate_rationale(match, segment):\n    if match[\'code\'] == \'UNKNOWN\':\n        return f\'No matching codebook entry found for "{segment}". Manual review recommended.\'\n    elif match[\'match_type\'] == \'keyword\':\n        return f\'Matched via keyword matching. Confidence: {round(match["confidence"], 3)}\'\n    else:\n        return f\'Matched via similarity analysis. Confidence: {round(match["confidence"], 3)}\'\n\n# Main processing\ndef process_logs():\n    codebooks = load_codebooks()\n    results = {\'records\': []}\n    \n    with open(\'/app/data/test_center_logs.csv\', \'r\', encoding=\'utf-8\') as f:\n        reader = csv.DictReader(f)\n        for row in reader:\n            record_id = row[\'record_id\'].strip()\n            product_id = row[\'product_id\'].strip()\n            station = row[\'station\'].strip()\n            engineer_id = row[\'engineer_id\'].strip()\n            raw_reason = row[\'raw_reason_text\'].strip()\n            \n            if not record_id or not product_id or not raw_reason:\n                continue\n            \n            # Get the appropriate codebook\n            if product_id not in codebooks:\n                continue\n            \n            product_codebook = codebooks[product_id]\n            \n            # Segment the raw reason text\n            segments = segment_text(raw_reason)\n            \n            normalized = []\n            segment_idx = 1\n            for segment in segments:\n                if not segment or len(segment) < 2:\n                    continue\n                \n                match = match_segment(segment, product_codebook, station)\n                \n                normalized.append({\n                    \'segment_id\': f\'{record_id}-S{segment_idx}\',\n                    \'span_text\': segment,\n                    \'pred_code\': match[\'code\'],\n                    \'pred_label\': match[\'label\'],\n                    \'confidence\': round(match[\'confidence\'], 3),\n                    \'rationale\': generate_rationale(match, segment)\n                })\n                segment_idx += 1\n            \n            if normalized:\n                results[\'records\'].append({\n                    \'record_id\': record_id,\n                    \'product_id\': product_id,\n                    \'station\': station,\n                    \'engineer_id\': engineer_id,\n                    \'raw_reason_text\': raw_reason,\n                    \'normalized\': normalized\n                })\n    \n    return results\n\n# Create output directory\nos.makedirs(\'/app/output\', exist_ok=True)\n\n# Process and save\nresults = process_logs()\nwith open(\'/app/output/solution.json\', \'w\', encoding=\'utf-8\') as f:\n    json.dump(results, f, ensure_ascii=False, indent=2)\n\nprint(f\'Processed {len(results["records"])} records\')\nEOF\n'] min_timeout_sec: 0.5 max_timeout_sec: 180.0
