oat)):\n        if \'2024:\' in year_str:\n            in_2024_quarters = True\n            pfi_2024_quarters.append(value)\n        elif in_2024_quarters and is_quarterly(year_str):\n            pfi_2024_quarters.append(value)\n        elif year_str[-1] == \'.\' and len(year_str) <= 5:\n            try:\n                year = int(year_str[:-1])\n                pfi_annual[year] = value\n                in_2024_quarters = False\n            except:\n                pass\n\n# Create annual series from 1973 to 2024\nyears = list(range(1973, 2024))\npce_values = [pce_annual[y] for y in years]\npfi_values = [pfi_annual[y] for y in years]\n\n# Add 2024 as average of available quarters\npce_2024_avg = np.mean(pce_2024_quarters)\npfi_2024_avg = np.mean(pfi_2024_quarters)\npce_values.append(pce_2024_avg)\npfi_values.append(pfi_2024_avg)\nyears.append(2024)\n\n# Create DataFrame\ndf_annual = pd.DataFrame({\n    \'Year\': years,\n    \'PCE_nominal\': pce_values,\n    \'PFI_nominal\': pfi_values\n})\n\n# Merge with CPI\ndf_annual = df_annual.merge(df_cpi, left_on=\'Year\', right_on=\'Year\', how=\'left\')\n\n# Deflate to real values (2024 dollars)\ndf_annual[\'PCE_real\'] = df_annual[\'PCE_nominal\'] / df_annual[\'CPI_2024\']\ndf_annual[\'PFI_real\'] = df_annual[\'PFI_nominal\'] / df_annual[\'CPI_2024\']\n\n# Take natural logarithm\ndf_annual[\'log_PCE\'] = np.log(df_annual[\'PCE_real\'])\ndf_annual[\'log_PFI\'] = np.log(df_annual[\'PFI_real\'])\n\nprint("Data prepared:")\nprint(df_annual[[\'Year\', \'PCE_real\', \'PFI_real\', \'log_PCE\', \'log_PFI\']].head())\nprint(df_annual[[\'Year\', \'PCE_real\', \'PFI_real\', \'log_PCE\', \'log_PFI\']].tail())\n\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
