[?2004l [?2004h> def to_csr(mask):
[?2004l[?2004h>     # mask is HxW binary (0 or 255 or 0/1)
[?2004l[?2004h>     # Returns data, indices, indptr
[?2004l[?2004h>     rows, cols = mask.shape
[?2004l[?2004h>     data = []
[?2004l[?2004h>     indices = []
[?2004l[?2004h>     indptr = [0]
[?2004l[?2004h>     
[?2004l[?2004h>     # Iterate over rows to build CSR
[?2004l[?2004h>     for r in range(rows):
[?2004l[?2004h>         # Find column indices where mask is True (non-zero)
[?2004l[?2004h>         row_idxs = np.where(mask[r] > 0)[0]
[?2004l[?2004h>         if len(row_idxs) > 0:
[?2004l[?2004h>             indices.extend(row_idxs)
[?2004l[?2004h>             data.extend([True] * len(row_idxs))
[?2004l[?2004h>         indptr.append(len(data))
[?2004l[?2004h>         
[?2004l[?2004h>     return np.array(data, dtype=bool), np.array(indices, dtype=np.int32), np.array(indptr, dtype=np.int32)
[?2004l[?2004h> 
[?2004l[?2004h> def analyze_motion(M, w, h):
[?2004l[?2004h>     # M is 2x3 affine matrix
[?2004l[?2004h>     # [a b tx]
[?2004l[?2004h>     # [c d ty]
[?2004l[?2004h>     tx = M[0, 2]
[?2004l[?2004h>     ty = M[1, 2]
[?2004l[?2004h>     a = M[0, 0]
[?2004l[?2004h>     b = M[0, 1]
[?2004l[?2004h>     c = M[1, 0]
[?2004l[?2004h>     d = M[1, 1]
[?2004l[?2004h>     
[?2004l[?2004h>     scale_x = math.sqrt(a*a + c*c)
[?2004l[?2004h>     scale_y = math.sqrt(b*b + d*d)
[?2004l[?2004h>     scale = (scale_x + scale_y) / 2.0
[?2004l[?2004h>     
[?2004l[?2004h>     rotation = math.atan2(c, a) # radians
[?2004l[?2004h>     rot_deg = math.degrees(rotation)
[?2004l[?2004h>     
[?2004l[?2004h>     labels = []
[?2004l[?2004h>     
[?2004l[?2004h>     # Thresholds
[?2004l[?2004h>     TRANS_THRESH = w * 0.005 # 0.5% of width
[?2004l[?2004h>     SCALE_THRESH = 0.005 # 0.5% change
[?2004l[?2004h>     ROT_THRESH = 0.5 # degrees
[?2004l[?2004h>     
[?2004l[?2004h>     # Translation
[?2004l[?2004h>     if tx < -TRANS_THRESH: labels.append("Pan Right")
[?2004l[?2004h>     elif tx > TRANS_THRESH: labels.append("Pan Left")
[?2004l[?2004h>     
[?2004l[?2004h>     if ty < -TRANS_THRESH: labels.append("Tilt Down")
[?2004l[?2004h>     elif ty > TRANS_THRESH: labels.append("Tilt Up")
[?2004l[?2004h>     
[?2004l[?2004h>     # Scale
[?2004l[?2004h>     if scale > 1.0 + SCALE_THRESH: labels.append("Dolly In")
[?2004l[?2004h>     elif scale < 1.0 - SCALE_THRESH: labels.append("Dolly Out")
[?2004l[?2004h>     
[?2004l[?2004h>     # Rotation
[?2004l[?2004h>     # CW rotation of camera -> CCW rotation of image -> positive angle
[?2004l[?2004h>     if rot_deg > ROT_THRESH: labels.append("Roll Right")
[?2004l[?2004h>     elif rot_deg < -ROT_THRESH: labels.append("Roll Left")
[?2004l[?2004h>     
[?2004l[?2004h>     if not labels:
[?2004l[?2004h>         labels.append("Stay")
[?2004l[?2004h>         
[?2004l[?2004h>     return labels
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     video_path = '/root/input.mp4'
[?2004l[?2004h>     cap = cv2.VideoCapture(video_path)
[?2004l[?2004h>     
[?2004l[?2004h>     if not cap.isOpened():
[?2004l[?2004h>         print("Error opening video")
[?2004l[?2004h>         return
[?2004l[?2004h>         
[?2004l[?2004h>     orig_fps = cap.get(cv2.CAP_PROP_FPS)
[?2004l[?2004h>     target_fps = 6
[?2004l[?2004h>     skip_step = max(1, int(round(orig_fps / target_fps)))
[?2004l[?2004h>     
[?2004l[?2004h>     instructions = {}
[?2004l[?2004h>     masks_storage = {}
[?2004l[?2004h>     
[?2004l[?2004h>     prev_gray = None
[?2004l[?2004h>     prev_frame = None
[?2004l[?2004h>     sample_idx = 0
[?2004l[?2004h>     frame_count = 0
[?2004l[?2004h>     
[?2004l[?2004h>     feature_params = dict(maxCorners=200, qualityLevel=0.01, minDistance=30, blockSize=3)
[?2004l[?2004h>     lk_params = dict(winSize=(21, 21), maxLevel=3, criteria=(cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 10, 0.03))
[?2004l[?2004h>     
[?2004l[?2004h>     # Get shape from first frame
[?2004l[?2004h>     ret, frame = cap.read()
[?2004l[?2004h>     if not ret: return
[?2004l[?2004h>     H, W = frame.shape[:2]
[?2004l[?2004h>     masks_storage['shape'] = np.array([H, W])
[?2004l[?2004h>     
[?2004l[?2004h>     # Reset to start
[?2004l[?2004h>     cap.set(cv2.CAP_PROP_POS_FRAMES, 0)
[?2004l[?2004h>     
[?2004l[?2004h>     while True:
[?2004l[?2004h>         ret, frame = cap.read()
[?2004l[?2004h>         if not ret:
[?2004l[?2004h>             break
[?2004l[?2004h>             
[?2004l[?2004h>         if frame_count % skip_step == 0:
[?2004l[?2004h>             curr_gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
[?2004l[?2004h>             
[?2004l[?2004h>             # Initialize mask for this frame (default empty)
[?2004l[?2004h>             # We will overwrite if we can compute motion
[?2004l[?2004h>             curr_mask = np.zeros((H, W), dtype=np.uint8)
[?2004l[?2004h>             
[?2004l[?2004h>             if prev_gray is not None:
[?2004l[?2004h>                 # Calculate Optical Flow
[?2004l[?2004h>                 p0 = cv2.goodFeaturesToTrack(prev_gray, mask=None, **feature_params)
[?2004l[?2004h>                 if p0 is not None:
[?2004l[?2004h>                     p1, st, err = cv2.calcOpticalFlowPyrLK(prev_gray, curr_gray, p0, None, **lk_params)
[?2004l[?2004h>                     
[?2004l[?2004h>                     # Select good points
[?2004l[?2004h>                     if p1 is not None:
[?2004l[?2004h>                         good_new = p1[st==1]
[?2004l[?2004h>                         good_old = p0[st==1]
[?2004l[?2004h>                         
[?2004l[?2004h>                         if len(good_new) > 4:
[?2004l[?2004h>                             M, inliers = cv2.estimateAffinePartial2D(good_old, good_new)
[?2004l[?2004h>                             
[?2004l[?2004h>                             if M is not None:
[?2004l[?2004h>                                 # Analyze Motion
[?2004l[?2004h>                                 labels = analyze_motion(M, W, H)
[?2004l[?2004h>                                 instructions[f"{sample_idx-1}->{sample_idx}"] = labels
[?2004l[?2004h>                                 
[?2004l[?2004h>                                 # Dynamic Object Detection
[?2004l[?2004h>                                 # Warp prev to curr
[?2004l[?2004h>                                 warped_prev = cv2.warpAffine(prev_gray, M, (W, H))
[?2004l[?2004h>                                 diff = cv2.absdiff(curr_gray, warped_prev)
[?2004l[?2004h>                                 
[?2004l[?2004h>                                 # Threshold and clean
[?2004l[?2004h>                                 _, mask_bin = cv2.threshold(diff, 30, 255, cv2.THRESH_BINARY)
[?2004l[?2004h>                                 kernel = np.ones((5,5), np.uint8)
[?2004l[?2004h>                                 mask_bin = cv2.morphologyEx(mask_bin, cv2.MORPH_OPEN, kernel)
[?2004l[?2004h>                                 mask_bin = cv2.morphologyEx(mask_bin, cv2.MORPH_CLOSE, kernel)
[?2004l[?2004h>                                 curr_mask = mask_bin
[?2004l[?2004h>                             else:
[?2004l[?2004h>                                 instructions[f"{sample_idx-1}->{sample_idx}"] = ["Stay"]
[?2004l[?2004h>                         else:
[?2004l[?2004h>                              instructions[f"{sample_idx-1}->{sample_idx}"] = ["Stay"]
[?2004l[?2004h>                     else:
[?2004l[?2004h>                          instructions[f"{sample_idx-1}->{sample_idx}"] = ["Stay"]
[?2004l[?2004h>                 else:
[?2004l[?2004h>                      instructions[f"{sample_idx-1}->{sample_idx}"] = ["Stay"]
[?2004l[?2004h>             
[?2004l[?2004h>             # Save mask for current sample
[?2004l[?2004h>             data, indices, indptr = to_csr(curr_mask)
[?2004l[?2004h>             masks_storage[f"f_{sample_idx}_data"] = data
[?2004l[?2004h>             masks_storage[f"f_{sample_idx}_indices"] = indices
[?2004l[?2004h>             masks_storage[f"f_{sample_idx}_indptr"] = indptr
[?2004l[?2004h>             
[?2004l[?2004h>             prev_gray = curr_gray
[?2004l[?2004h>             sample_idx += 1
[?2004l[?2004h>             
[?2004l[?2004h>         frame_count += 1
[?2004l[?2004h>         
[?2004l[?2004h>     cap.release()
[?2004l[?2004h>     
[?2004l[?2004h>     # Save outputs
[?2004l[?2004h>     with open('/root/pred_instructions.json', 'w') as f:
[?2004l[?2004h>         json.dump(instructions, f, indent=2)
[?2004l[?2004h>         
