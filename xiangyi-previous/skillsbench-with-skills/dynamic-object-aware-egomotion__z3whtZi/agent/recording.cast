[14.896508, "o", "\u001b[01;31m\u001b[Knumpy\u001b[m\u001b[K                  2.2.6\r\n\u001b[01;31m\u001b[Kopencv\u001b[m\u001b[K-python-headless 4.12.0.88\r\n"]
[14.923871, "o", "\u001b[?2004hroot@03de40e0b039:~# "]
[88.926219, "i", "cat << 'EOF' > /root/analyze.py\nimport cv2\nimport numpy as np\nimport json\nimport math\n\ndef to_csr(mask):\n    # mask is HxW binary (0 or 255 or 0/1)\n    # Returns data, indices, indptr\n    rows, cols = mask.shape\n    data = []\n    indices = []\n    indptr = [0]\n    \n    # Iterate over rows to build CSR\n    for r in range(rows):\n        # Find column indices where mask is True (non-zero)\n        row_idxs = np.where(mask[r] > 0)[0]\n        if len(row_idxs) > 0:\n            indices.extend(row_idxs)\n            data.extend([True] * len(row_idxs))\n        indptr.append(len(data))\n        \n    return np.array(data, dtype=bool), np.array(indices, dtype=np.int32), np.array(indptr, dtype=np.int32)\n\ndef analyze_motion(M, w, h):\n    # M is 2x3 affine matrix\n    # [a b tx]\n    # [c d ty]\n    tx = M[0, 2]\n    ty = M[1, 2]\n    a = M[0, 0]\n    b = M[0, 1]\n    c = M[1, 0]\n    d = M[1, 1]\n    \n    scale_x = math.sqrt(a*a + c*c)\n    scale_y = math.sqrt(b*b + d*d)\n    scale = (scale_x + scale_y) / 2.0\n    \n    rotation = math.atan2(c, a) # radians\n    rot_deg = math.degrees(rotation)\n    \n    labels = []\n    \n    # Thresholds\n    TRANS_THRESH = w * 0.005 # 0.5% of width\n    SCALE_THRESH = 0.005 # 0.5% change\n    ROT_THRESH = 0.5 # degrees\n    \n    # Translation\n    if tx < -TRANS_THRESH: labels.append(\"Pan Right\")\n    elif tx > TRANS_THRESH: labels.append(\"Pan Left\")\n    \n    if ty < -TRANS_THRESH: labels.append(\"Tilt Down\")\n    elif ty > TRANS_THRESH: labels.append(\"Tilt Up\")\n    \n    # Scale\n    if scale > 1.0 + SCALE_THRESH: labels.append(\"Dolly In\")\n    elif scale < 1.0 - SCALE_THRESH: labels.append(\"Dolly Out\")\n    \n    # Rotation\n    # CW rotation of camera -> CCW rotation of image -> positive angle\n    if rot_deg > ROT_THRESH: labels.append(\"Roll Right\")\n    elif rot_deg < -ROT_THRESH: labels.append(\"Roll Left\")\n    \n    if not labels:\n        labels.append(\"Stay\")\n        \n    return labels\n\ndef main():\n    video_path = '/root/input.mp4'\n    cap = cv2.VideoCapture(video_path)\n    \n    if not cap.isOpened():\n        print(\"Error opening video\")\n        return\n        \n    orig_fps = cap.get(cv2.CAP_PROP_FPS)\n    target_fps = 6\n    skip_step = max(1, int(round(orig_fps / target_fps)))\n    \n    instructions = {}\n    masks_storage = {}\n    \n    prev_gray = None\n    prev_frame = None\n    sample_idx = 0\n    frame_count = 0\n    \n    feature_params = dict(maxCorners=200, qualityLevel=0.01, minDistance=30, blockSize=3)\n    lk_params = dict(winSize=(21, 21), maxLevel=3, criteria=(cv2.TERM_CRITERIA_EPS | cv2.TERM_CRITERIA_COUNT, 10, 0.03))\n    \n    # Get shape from first frame\n    ret, frame = cap.read()\n    if not ret: return\n    H, W = frame.shape[:2]\n    masks_storage['shape'] = np.array([H, W])\n    \n    # Reset to start\n    cap.set(cv2.CAP_PROP_POS_FRAMES, 0)\n    \n    while True:\n        ret, frame = cap.read()\n        if not ret:\n            break\n            \n        if frame_count % skip_step == 0:\n            curr_gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\n            \n            # Initialize mask for this frame (default empty)\n            # We will overwrite if we can compute motion\n            curr_mask = np.zeros((H, W), dtype=np.uint8)\n            \n            if prev_gray is not None:\n                # Calculate Optical Flow\n                p0 = cv2.goodFeaturesToTrack(prev_gray, mask=None, **feature_params)\n                if p0 is not None:\n                    p1, st, err = cv2.calcOpticalFlowPyrLK(prev_gray, curr_gray, p0, None, **lk_params)\n                    \n                    # Select good points\n                    if p1 is not None:\n                        good_new = p1[st==1]\n                        good_old = p0[st==1]\n                        \n                        if len(good_new) > 4:\n                            M, inliers = cv2.estimateAffinePartial2D(good_old, good_new)\n                            \n                            if M is not None:\n                                # Analyze Motion\n                                labels = analyze_motion(M, W, H)\n                                instructions[f\"{samp"]
[88.926378, "i", "le_idx-1}->{sample_idx}\"] = labels\n                                \n                                # Dynamic Object Detection\n                                # Warp prev to curr\n                                warped_prev = cv2.warpAffine(prev_gray, M, (W, H))\n                                diff = cv2.absdiff(curr_gray, warped_prev)\n                                \n                                # Threshold and clean\n                                _, mask_bin = cv2.threshold(diff, 30, 255, cv2.THRESH_BINARY)\n                                kernel = np.ones((5,5), np.uint8)\n                                mask_bin = cv2.morphologyEx(mask_bin, cv2.MORPH_OPEN, kernel)\n                                mask_bin = cv2.morphologyEx(mask_bin, cv2.MORPH_CLOSE, kernel)\n                                curr_mask = mask_bin\n                            else:\n                                instructions[f\"{sample_idx-1}->{sample_idx}\"] = [\"Stay\"]\n                        else:\n                             instructions[f\"{sample_idx-1}->{sample_idx}\"] = [\"Stay\"]\n                    else:\n                         instructions[f\"{sample_idx-1}->{sample_idx}\"] = [\"Stay\"]\n                else:\n                     instructions[f\"{sample_idx-1}->{sample_idx}\"] = [\"Stay\"]\n            \n            # Save mask for current sample\n            data, indices, indptr = to_csr(curr_mask)\n            masks_storage[f\"f_{sample_idx}_data\"] = data\n            masks_storage[f\"f_{sample_idx}_indices\"] = indices\n            masks_storage[f\"f_{sample_idx}_indptr\"] = indptr\n            \n            prev_gray = curr_gray\n            sample_idx += 1\n            \n        frame_count += 1\n        \n    cap.release()\n    \n    # Save outputs\n    with open('/root/pred_instructions.json', 'w') as f:\n        json.dump(instructions, f, indent=2)\n        \n    np.savez('/root/pred_dyn_masks.npz', **masks_storage)\n    print(\"Analysis complete.\")\n\nif __name__ == \"__main__\":\n    main()\nEOF\n"]
