[88.935552, "o", "\u001b[?2004h> "]
[88.935602, "o", "    cap.set(cv2.CAP_PROP_POS_FRAMES, 0)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.935639, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h>     while True:\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.935681, "o", "> "]
[88.935724, "o", "        ret, frame = cap.read()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.935748, "o", "        if not ret:\r\n\u001b[?2004l\r"]
[88.935791, "o", "\u001b[?2004h> "]
[88.935816, "o", "            break\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.935882, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.935922, "o", "        if frame_count % skip_step == 0:\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.935974, "o", "> "]
[88.936033, "o", "            curr_gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.936056, "o", ">             \r\n\u001b[?2004l\r"]
[88.936099, "o", "\u001b[?2004h> "]
[88.936175, "o", "            # Initialize mask for this frame (default empty)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.936224, "o", "> "]
[88.936274, "o", "            # We will overwrite if we can compute motion\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.936324, "o", "> "]
[88.936376, "o", "            curr_mask = np.zeros((H, W), dtype=np.uint8)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.936435, "o", "> "]
[88.936471, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.936516, "o", "            if prev_gray is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.936587, "o", "                # Calculate Optical Flow\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.93663, "o", "> "]
[88.936727, "o", "                p0 = cv2.goodFeaturesToTrack(prev_gray, mask=None, **feature_params)\r\n\u001b[?2004l\r"]
[88.936777, "o", "\u001b[?2004h> "]
[88.936812, "o", "                if p0 is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.936967, "o", "                    p1, st, err = cv2.calcOpticalFlowPyrLK(prev_gray, curr_gray, p0, None, **lk_params)\r\n\u001b[?2004l\r"]
[88.936993, "o", "\u001b[?2004h> "]
[88.937041, "o", "                    \r\n\u001b[?2004l\r"]
[88.937107, "o", "\u001b[?2004h> "]
[88.937144, "o", "                    # Select good points\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.93719, "o", "                    if p1 is not None:\r\n\u001b[?2004l\r"]
[88.937234, "o", "\u001b[?2004h> "]
[88.937279, "o", "                        good_new = p1[st==1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.937323, "o", "> "]
[88.937375, "o", "                        good_old = p0[st==1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.937412, "o", "                        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.937486, "o", "                        if len(good_new) > 4:\r\n\u001b[?2004l\r"]
[88.93753, "o", "\u001b[?2004h> "]
[88.937642, "o", "                            M, inliers = cv2.estimateAffinePartial2D(good_old, good_new)\r\n\u001b[?2004l\r"]
[88.937688, "o", "\u001b[?2004h> "]
[88.937739, "o", "                            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.93779, "o", "                            if M is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.937836, "o", "> "]
[88.937881, "o", "                                # Analyze Motion\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.937926, "o", "> "]
[88.937998, "o", "                                labels = analyze_motion(M, W, H)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.938041, "o", "> "]
[88.938149, "o", "                                instructions[f\"{sample_idx-1}->{sample_idx}\"] = labels\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.938205, "o", "                                \r\n\u001b[?2004l\r"]
[88.938252, "o", "\u001b[?2004h> "]
[88.938313, "o", "                                # Dynamic Object Detection\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.938361, "o", "> "]
[88.938402, "o", "                                # Warp prev to curr\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.938452, "o", "> "]
[88.93855, "o", "                                warped_prev = cv2.warpAffine(prev_gray, M, (W, H))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.938676, "o", "                                diff = cv2.absdiff(curr_gray, warped_prev)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.93873, "o", "                                \r\n\u001b[?2004l\r"]
[88.938773, "o", "\u001b[?2004h> "]
[88.938827, "o", "                                # Threshold and clean\r\n\u001b[?2004l\r"]
[88.938872, "o", "\u001b[?2004h> "]
[88.938986, "o", "                                _, mask_bin = cv2.threshold(diff, 30, 255, cv2.THRESH_BINARY)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.93903, "o", "> "]
[88.939101, "o", "                                kernel = np.ones((5,5), np.uint8)\r\n\u001b[?2004l\r"]
[88.939145, "o", "\u001b[?2004h> "]
[88.939253, "o", "                                mask_bin = cv2.morphologyEx(mask_bin, cv2.MORPH_OPEN, kernel)\r\n\u001b[?2004l\r"]
[88.939299, "o", "\u001b[?2004h> "]
[88.939409, "o", "                                mask_bin = cv2.morphologyEx(mask_bin, cv2.MORPH_CLOSE, kernel)\r\n\u001b[?2004l\r"]
[88.939455, "o", "\u001b[?2004h> "]
[88.939505, "o", "                                curr_mask = mask_bin\r\n\u001b[?2004l\r"]
[88.939553, "o", "\u001b[?2004h> "]
[88.9396, "o", "                            else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.939722, "o", "                                instructions[f\"{sample_idx-1}->{sample_idx}\"] = [\"Stay\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.939767, "o", "> "]
[88.939812, "o", "                        else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.93993, "o", "                             instructions[f\"{sample_idx-1}->{sample_idx}\"] = [\"Stay\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.939974, "o", "> "]
[88.940024, "o", "                    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.940123, "o", "                         instructions[f\"{sample_idx-1}->{sample_idx}\"] = [\"Stay\"]\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.940166, "o", "> "]
[88.940211, "o", "                else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.940303, "o", "                     instructions[f\"{sample_idx-1}->{sample_idx}\"] = [\"Stay\"]\r\n\u001b[?2004l\r"]
[88.940328, "o", "\u001b[?2004h> "]
[88.940377, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.940434, "o", "            # Save mask for current sample\r\n\u001b[?2004l\r"]
[88.940478, "o", "\u001b[?2004h> "]
[88.940532, "o", "            data, indices, indptr = to_csr(curr_mask)\r\n\u001b[?2004l\r"]
[88.940577, "o", "\u001b[?2004h> "]
[88.940658, "o", "            masks_storage[f\"f_{sample_idx}_data\"] = data\r\n\u001b[?2004l\r"]
[88.940703, "o", "\u001b[?2004h> "]
[88.940769, "o", "            masks_storage[f\"f_{sample_idx}_indices\"] = indices\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.940812, "o", "> "]
[88.940875, "o", "            masks_storage[f\"f_{sample_idx}_indptr\"] = indptr\r\n\u001b[?2004l\r"]
[88.940918, "o", "\u001b[?2004h> "]
[88.940962, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.941007, "o", "            prev_gray = curr_gray\r\n\u001b[?2004l\r"]
[88.941052, "o", "\u001b[?2004h> "]
[88.941099, "o", "            sample_idx += 1\r\n\u001b[?2004l\r\u001b[?2004h>             \r\n\u001b[?2004l\r"]
[88.941143, "o", "\u001b[?2004h> "]
[88.941187, "o", "        frame_count += 1\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[88.941232, "o", "\u001b[?2004h>     cap.release()\r\n\u001b[?2004l\r"]
[88.941274, "o", "\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.941318, "o", "    # Save outputs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.941397, "o", "    with open('/root/pred_instructions.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.941441, "o", "> "]
[88.941483, "o", "        json.dump(instructions, f, indent=2)\r\n\u001b[?2004l\r"]
[88.941507, "o", "\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[88.941569, "o", "\u001b[?2004h> "]
[88.941619, "o", "    np.savez('/root/pred_dyn_masks.npz', **masks_storage)\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.941671, "o", "> "]
[88.941708, "o", "    print(\"Analysis complete.\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[88.941752, "o", "\u001b[?2004h> "]
[88.941779, "o", "if __name__ == \"__main__\":\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.94182, "o", "    main()\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.941879, "o", "> EOF\r\n\u001b[?2004l\r"]
[88.942926, "o", "\u001b[?2004hroot@03de40e0b039:~# "]
[89.075394, "i", "python3 /root/analyze.py\n"]
[89.075602, "o", "python3 /root/analyze.py\r\n\u001b[?2004l\r"]
[91.072425, "o", "Analysis complete.\r\n"]
[91.109182, "o", "\u001b[?2004hroot@03de40e0b039:~# "]
[103.729299, "i", "ls -lh /root/pred_instructions.json /root/pred_dyn_masks.npz\n"]
[103.729542, "o", "ls -lh /root/pred_instructions.json /root/pred_dyn_masks.npz\r\n\u001b[?2004l\r"]
[103.731099, "o", "-rw-r--r-- 1 root root  15M Jan 26 11:18 /root/pred_dyn_masks.npz\r\n-rw-r--r-- 1 root root 1.1K Jan 26 11:18 /root/pred_instructions.json\r\n"]
[103.731296, "o", "\u001b[?2004hroot@03de40e0b039:~# "]
[103.871186, "i", "head -n 20 /root/pred_instructions.json\n"]
[103.871399, "o", "head -n 20 /root/pred_instructions.json\r\n\u001b[?2004l\r"]
[103.872279, "o", "{\r\n  \"0->1\": [\r\n    \"Pan Right\",\r\n    \"Tilt Down\",\r\n    \"Dolly In\"\r\n  ],\r\n  \"1->2\": [\r\n    \"Pan Right\",\r\n    \"Tilt Down\",\r\n    \"Dolly In\"\r\n  ],\r\n  \"2->3\": [\r\n    \"Pan Right\",\r\n    \"Tilt Down\",\r\n    \"Dolly In\"\r\n  ],\r\n  \"3->4\": [\r\n    \"Pan Right\",\r\n    \"Tilt Down\",\r\n    \"Dolly In\"\r\n"]
[103.872448, "o", "\u001b[?2004hroot@03de40e0b039:~# "]
