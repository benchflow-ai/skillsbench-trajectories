[117.091392, "i", "python3 << 'EOF'\nimport json\nwith open('/app/output/causal_analysis_report.json', 'r') as f:\n    report = json.load(f)\nprint(\"Report Structure:\")\nprint(f\"Metadata: {report['metadata']}\")\nprint(f\"\\nSurge categories: {len(report['surge_categories'])}\")\nif report['surge_categories']:\n    print(f\"First surge category: {report['surge_categories'][0]['category']}\")\n    print(f\"  Anomaly Index: {report['surge_categories'][0]['anomaly_index']}\")\n    print(f\"  Intensive margin drivers: {len(report['surge_categories'][0]['intensive_margin'])}\")\n    print(f\"  Extensive margin drivers: {len(report['surge_categories'][0]['extensive_margin'])}\")\nprint(f\"\\nSlump categories: {len(report['slump_categories'])}\")\nif report['slump_categories']:\n    print(f\"First slump category: {report['slump_categories'][0]['category']}\")\n    print(f\"  Anomaly Index: {report['slump_categories'][0]['anomaly_index']}\")\nprint(f\"\\nSummary: {report['summary']}\")\nEOF\n"]
