[104.412653, "i", "cat > /app/analysis_part4.py << 'PART1'\nimport pandas as pd\nimport numpy as np\nfrom scipy import stats\nfrom sklearn.linear_model import LinearRegression\nimport json\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"STEP 5: CAUSAL ANALYSIS - DIFFERENCE-IN-DIFFERENCES\")\nprint(\"=\"*80)\n\nsurvey_eng = pd.read_csv('/app/output/survey_feature_engineered.csv')\nintensive_df = pd.read_csv('/app/output/user_category_period_aggregated_intensive.csv')\nextensive_df = pd.read_csv('/app/output/user_category_period_aggregated_extensive.csv')\nanomaly_df = pd.read_csv('/app/output/category_anomaly_index.csv')\n\ntop_surge = anomaly_df.nlargest(10, 'Anomaly_Index')\ntop_slump = anomaly_df.nsmallest(10, 'Anomaly_Index')\n\nprint(f\"Analyzing {len(top_surge)} surge and {len(top_slump)} slump categories\")\n\nintensive_merged = intensive_df.merge(survey_eng, on='Survey ResponseID', how='left')\nextensive_merged = extensive_df.merge(survey_eng, on='Survey ResponseID', how='left')\n\nfeature_cols = [col for col in survey_eng.columns if col != 'Survey ResponseID']\nprint(f\"Analyzing {len(feature_cols)} demographic features\")\n\ndef perform_did_analysis(data, outcome_col, features):\n    results = []\n    for feature in features:\n        if data[feature].std() == 0:\n            continue\n        data_copy = data.copy()\n        data_copy['Treatment'] = (data_copy['Period'] == 'Treatment').astype(int)\n        data_copy['Feature_x_Treatment'] = data_copy[feature] * data_copy['Treatment']\n        reg_data = data_copy[['Treatment', feature, 'Feature_x_Treatment', outcome_col]].dropna()\n        if len(reg_data) < 10:\n            continue\n        try:\n            X = reg_data[['Treatment', feature, 'Feature_x_Treatment']].values\n            y = reg_data[outcome_col].values\n            X_with_const = np.column_stack([np.ones(len(X)), X])\n            model = LinearRegression(fit_intercept=False)\n            model.fit(X_with_const, y)\n            did_estimate = model.coef_[3]\n            y_pred = model.predict(X_with_const)\n            residuals = y - y_pred\n            rss = np.sum(residuals**2)\n            mse = rss / (len(y) - 4)\n            X_T_X_inv = np.linalg.inv(X_with_const.T @ X_with_const)\n            se_did = np.sqrt(mse * X_T_X_inv[3, 3])\n            t_stat = did_estimate / se_did if se_did > 0 else 0\n            p_value = 2 * (1 - stats.t.cdf(abs(t_stat), len(y) - 4))\n            results.append({\n                'feature': feature,\n                'did_estimate': float(did_estimate),\n                'p_value': float(p_value),\n                'method': 'Univariate DiD' if outcome_col == 'Total_Spend' else 'Multivariate Heterogeneous DiD'\n            })\n        except:\n            continue\n    return results\n\nprint(\"\\nPerforming DiD analysis...\")\nintensive_surge_results = perform_did_analysis(\n    intensive_merged[intensive_merged['Category'].isin(top_surge['Category'].values)],\n    'Total_Spend', feature_cols\n)\nintensive_slump_results = perform_did_analysis(\n    intensive_merged[intensive_merged['Category'].isin(top_slump['Category'].values)],\n    'Total_Spend', feature_cols\n)\nextensive_surge_results = perform_did_analysis(\n    extensive_merged[extensive_merged['Category'].isin(top_surge['Category'].values)],\n    'Has_Purchase', feature_cols\n)\nextensive_slump_results = perform_did_analysis(\n    extensive_merged[extensive_merged['Category'].isin(top_slump['Category'].values)],\n    'Has_Purchase', feature_cols\n)\n\nintensive_surge_sorted = sorted(intensive_surge_results, key=lambda x: x['did_estimate'], reverse=True)\nintensive_slump_sorted = sorted(intensive_slump_results, key=lambda x: x['did_estimate'])\nextensive_surge_sorted = sorted(extensive_surge_results, key=lambda x: x['did_estimate'], reverse=True)\nextensive_slump_sorted = sorted(extensive_slump_results, key=lambda x: x['did_estimate'])\n\nprint(f\"Intensive surge: {len(intensive_surge_sorted)} features\")\nprint(f\"Intensive slump: {len(intensive_slump_sorted)} features\")\nprint(f\"Extensive surge: {len(extensive_surge_sorted)} features\")\nprint(f\"Extensive slump: {len(extensive_slump_s"]
[104.41272, "i", "orted)} features\")\n\nPART1\n"]
