[139.008585, "i", "python3 << 'EOF'\nimport os\nimport json\nimport pandas as pd\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"FINAL VERIFICATION OF ALL OUTPUT FILES\")\nprint(\"=\"*80)\n\nrequired_files = [\n    'survey_cleaned.csv',\n    'amazon-purchases-2019-2020-filtered.csv',\n    'category_anomaly_index.csv',\n    'survey_feature_engineered.csv',\n    'user_category_period_aggregated_intensive.csv',\n    'user_category_period_aggregated_extensive.csv',\n    'causal_analysis_report.json'\n]\n\noutput_dir = '/app/output/'\nall_exist = True\n\nfor fname in required_files:\n    fpath = os.path.join(output_dir, fname)\n    if os.path.exists(fpath):\n        size = os.path.getsize(fpath)\n        print(f\"✓ {fname:50s} ({size:,} bytes)\")\n    else:\n        print(f\"✗ {fname:50s} MISSING\")\n        all_exist = False\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"FILE STRUCTURE VERIFICATION\")\nprint(\"=\"*80)\n\n# Check survey_cleaned.csv\ndf = pd.read_csv('/app/output/survey_cleaned.csv')\nprint(f\"\\nsurvey_cleaned.csv:\")\nprint(f\"  Rows: {len(df)}, Columns: {len(df.columns)}\")\nprint(f\"  Columns: {', '.join(df.columns[:5])}...\")\n\n# Check amazon-purchases-2019-2020-filtered.csv\ndf = pd.read_csv('/app/output/amazon-purchases-2019-2020-filtered.csv')\nprint(f\"\\namazon-purchases-2019-2020-filtered.csv:\")\nprint(f\"  Rows: {len(df)}, Columns: {len(df.columns)}\")\nprint(f\"  Columns: {', '.join(df.columns)}\")\n\n# Check category_anomaly_index.csv\ndf = pd.read_csv('/app/output/category_anomaly_index.csv')\nprint(f\"\\ncategory_anomaly_index.csv:\")\nprint(f\"  Rows: {len(df)}, Columns: {len(df.columns)}\")\nprint(f\"  Columns: {', '.join(df.columns)}\")\nprint(f\"  Anomaly Index Range: [{df['Anomaly_Index'].min():.2f}, {df['Anomaly_Index'].max():.2f}]\")\n\n# Check survey_feature_engineered.csv\ndf = pd.read_csv('/app/output/survey_feature_engineered.csv')\nprint(f\"\\nsurvey_feature_engineered.csv:\")\nprint(f\"  Rows: {len(df)}, Columns: {len(df.columns)}\")\nprint(f\"  Features: {len(df.columns) - 1}\")\nprint(f\"  Sample features: {', '.join(df.columns[1:6])}...\")\n\n# Check user_category_period_aggregated_intensive.csv\ndf = pd.read_csv('/app/output/user_category_period_aggregated_intensive.csv')\nprint(f\"\\nuser_category_period_aggregated_intensive.csv:\")\nprint(f\"  Rows: {len(df)}, Columns: {len(df.columns)}\")\nprint(f\"  Columns: {', '.join(df.columns)}\")\nprint(f\"  Periods: {df['Period'].unique().tolist()}\")\n\n# Check user_category_period_aggregated_extensive.csv\ndf = pd.read_csv('/app/output/user_category_period_aggregated_extensive.csv')\nprint(f\"\\nuser_category_period_aggregated_extensive.csv:\")\nprint(f\"  Rows: {len(df)}, Columns: {len(df.columns)}\")\nprint(f\"  Columns: {', '.join(df.columns)}\")\nprint(f\"  Has_Purchase values: {df['Has_Purchase'].unique().tolist()}\")\n\n# Check causal_analysis_report.json\nwith open('/app/output/causal_analysis_report.json', 'r') as f:\n    report = json.load(f)\nprint(f\"\\ncausal_analysis_report.json:\")\nprint(f\"  Surge Categories: {len(report['surge_categories'])}\")\nprint(f\"  Slump Categories: {len(report['slump_categories'])}\")\nprint(f\"  Total Features Analyzed: {report['metadata']['total_features_analyzed']}\")\nprint(f\"  Baseline Period: {report['metadata']['baseline_start']} to {report['metadata']['baseline_end']}\")\nprint(f\"  Treatment Period: {report['metadata']['treatment_start']} to {report['metadata']['treatment_end']}\")\n\nprint(\"\\n\" + \"=\"*80)\nif all_exist:\n    print(\"✓ ALL REQUIRED FILES SUCCESSFULLY GENERATED\")\nelse:\n    print(\"✗ SOME FILES ARE MISSING\")\nprint(\"=\"*80)\n\nEOF\n"]
