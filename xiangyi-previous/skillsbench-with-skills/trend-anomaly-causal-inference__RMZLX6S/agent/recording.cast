[104.924168, "i", "cat >> /app/analysis_part4.py << 'PART2'\nreport = {\n    \"metadata\": {\n        \"baseline_start\": \"01-01-2020\",\n        \"baseline_end\": \"02-29-2020\",\n        \"treatment_start\": \"03-01-2020\",\n        \"treatment_end\": \"03-31-2020\",\n        \"total_features_analyzed\": len(feature_cols)\n    },\n    \"surge_categories\": [],\n    \"slump_categories\": [],\n    \"summary\": {\n        \"surge\": {\n            \"total_categories\": len(top_surge),\n            \"total_intensive_drivers\": len(intensive_surge_sorted),\n            \"total_extensive_drivers\": len(extensive_surge_sorted)\n        },\n        \"slump\": {\n            \"total_categories\": len(top_slump),\n            \"total_intensive_drivers\": len(intensive_slump_sorted),\n            \"total_extensive_drivers\": len(extensive_slump_sorted)\n        }\n    }\n}\n\nfor idx, row in top_surge.iterrows():\n    category = row['Category']\n    cat_data = intensive_merged[intensive_merged['Category'] == category]\n    baseline_data = cat_data[cat_data['Period'] == 'Baseline']['Total_Spend']\n    treatment_data = cat_data[cat_data['Period'] == 'Treatment']['Total_Spend']\n    cat_extensive = extensive_merged[extensive_merged['Category'] == category]\n    baseline_purchase = cat_extensive[cat_extensive['Period'] == 'Baseline']['Has_Purchase']\n    treatment_purchase = cat_extensive[cat_extensive['Period'] == 'Treatment']['Has_Purchase']\n    \n    surge_entry = {\n        \"category\": category,\n        \"anomaly_index\": float(row['Anomaly_Index']),\n        \"baseline_avg_spend\": float(baseline_data.mean()) if len(baseline_data) > 0 else 0,\n        \"treatment_avg_spend\": float(treatment_data.mean()) if len(treatment_data) > 0 else 0,\n        \"n_purchasers_baseline\": int((baseline_purchase > 0).sum()),\n        \"n_purchasers_treatment\": int((treatment_purchase > 0).sum()),\n        \"baseline_purchase_rate\": float(baseline_purchase.mean()) if len(baseline_purchase) > 0 else 0,\n        \"treatment_purchase_rate\": float(treatment_purchase.mean()) if len(treatment_purchase) > 0 else 0,\n        \"n_at_risk\": len(cat_extensive['Survey ResponseID'].unique()),\n        \"intensive_margin\": intensive_surge_sorted[:3],\n        \"extensive_margin\": extensive_surge_sorted[:3]\n    }\n    report[\"surge_categories\"].append(surge_entry)\n\nfor idx, row in top_slump.iterrows():\n    category = row['Category']\n    cat_data = intensive_merged[intensive_merged['Category'] == category]\n    baseline_data = cat_data[cat_data['Period'] == 'Baseline']['Total_Spend']\n    treatment_data = cat_data[cat_data['Period'] == 'Treatment']['Total_Spend']\n    cat_extensive = extensive_merged[extensive_merged['Category'] == category]\n    baseline_purchase = cat_extensive[cat_extensive['Period'] == 'Baseline']['Has_Purchase']\n    treatment_purchase = cat_extensive[cat_extensive['Period'] == 'Treatment']['Has_Purchase']\n    \n    slump_entry = {\n        \"category\": category,\n        \"anomaly_index\": float(row['Anomaly_Index']),\n        \"baseline_avg_spend\": float(baseline_data.mean()) if len(baseline_data) > 0 else 0,\n        \"treatment_avg_spend\": float(treatment_data.mean()) if len(treatment_data) > 0 else 0,\n        \"n_purchasers_baseline\": int((baseline_purchase > 0).sum()),\n        \"n_purchasers_treatment\": int((treatment_purchase > 0).sum()),\n        \"baseline_purchase_rate\": float(baseline_purchase.mean()) if len(baseline_purchase) > 0 else 0,\n        \"treatment_purchase_rate\": float(treatment_purchase.mean()) if len(treatment_purchase) > 0 else 0,\n        \"n_at_risk\": len(cat_extensive['Survey ResponseID'].unique()),\n        \"intensive_margin\": intensive_slump_sorted[:3],\n        \"extensive_margin\": extensive_slump_sorted[:3]\n    }\n    report[\"slump_categories\"].append(slump_entry)\n\nwith open('/app/output/causal_analysis_report.json', 'w') as f:\n    json.dump(report, f, indent=2)\n\nprint(\"\\nReport saved successfully!\")\nPART2\n"]
