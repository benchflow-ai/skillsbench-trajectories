[61.073349, "i", "cat > /app/analysis_part3.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime\nimport json\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"STEP 3: FEATURE ENGINEERING FROM DEMOGRAPHIC DATA\")\nprint(\"=\"*80)\n\n# Load data\nsurvey_df = pd.read_csv('/app/output/survey_cleaned.csv')\nanomaly_df = pd.read_csv('/app/output/category_anomaly_index.csv')\npurchase_df = pd.read_csv('/app/output/amazon-purchases-2019-2020-filtered.csv')\npurchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'])\n\n# Feature engineering on survey data\nprint(\"\\nEngineering demographic features...\")\n\n# Create a copy for feature engineering\nsurvey_eng = survey_df.copy()\n\n# Binary features from yes/no questions\nfor col in ['Q-substance-use-cigarettes', 'Q-substance-use-marijuana', 'Q-substance-use-alcohol',\n            'Q-personal-diabetes', 'Q-personal-wheelchair']:\n    if col in survey_eng.columns:\n        survey_eng[f'{col}_Yes'] = (survey_eng[col] == 'Yes').astype(int)\n        survey_eng[f'{col}_No'] = (survey_eng[col] == 'No').astype(int)\n        survey_eng[f'{col}_Unknown'] = (survey_eng[col] == 'Unknown').astype(int)\n\n# Age group encoding\nif 'Q-demos-age' in survey_eng.columns:\n    age_mapping = {\n        '18 - 24 years': 1,\n        '25 - 34 years': 2,\n        '35 - 44 years': 3,\n        '45 - 54 years': 4,\n        '55 - 64 years': 5,\n        '65 - 74 years': 6,\n        '75 - 84 years': 7,\n        '85 or older': 8,\n        'Unknown': 0\n    }\n    survey_eng['Age_Group_Numeric'] = survey_eng['Q-demos-age'].map(age_mapping).fillna(0)\n    survey_eng['Age_18_24'] = (survey_eng['Q-demos-age'] == '18 - 24 years').astype(int)\n    survey_eng['Age_25_34'] = (survey_eng['Q-demos-age'] == '25 - 34 years').astype(int)\n    survey_eng['Age_35_44'] = (survey_eng['Q-demos-age'] == '35 - 44 years').astype(int)\n    survey_eng['Age_45_54'] = (survey_eng['Q-demos-age'] == '45 - 54 years').astype(int)\n    survey_eng['Age_55_64'] = (survey_eng['Q-demos-age'] == '55 - 64 years').astype(int)\n    survey_eng['Age_65plus'] = (survey_eng['Q-demos-age'].isin(['65 - 74 years', '75 - 84 years', '85 or older'])).astype(int)\n\n# Income encoding\nif 'Q-demos-income' in survey_eng.columns:\n    income_mapping = {\n        'Less than $25,000': 1,\n        '$25,000 - $49,999': 2,\n        '$50,000 - $74,999': 3,\n        '$75,000 - $99,999': 4,\n        '$100,000 - $149,999': 5,\n        '$150,000 or more': 6,\n        'Unknown': 0\n    }\n    survey_eng['Income_Numeric'] = survey_eng['Q-demos-income'].map(income_mapping).fillna(0)\n    survey_eng['Income_Low'] = (survey_eng['Q-demos-income'].isin(['Less than $25,000', '$25,000 - $49,999'])).astype(int)\n    survey_eng['Income_Mid'] = (survey_eng['Q-demos-income'].isin(['$50,000 - $74,999', '$75,000 - $99,999'])).astype(int)\n    survey_eng['Income_High'] = (survey_eng['Q-demos-income'].isin(['$100,000 - $149,999', '$150,000 or more'])).astype(int)\n\n# Education encoding\nif 'Q-demos-education' in survey_eng.columns:\n    survey_eng['Has_Bachelor'] = (survey_eng['Q-demos-education'].str.contains(\"Bachelor's\", na=False)).astype(int)\n    survey_eng['Has_Graduate'] = (survey_eng['Q-demos-education'].str.contains('Graduate|professional', na=False)).astype(int)\n    survey_eng['Has_HighSchool'] = (survey_eng['Q-demos-education'].str.contains('High school', na=False)).astype(int)\n\n# Gender encoding\nif 'Q-demos-gender' in survey_eng.columns:\n    survey_eng['Gender_Female'] = (survey_eng['Q-demos-gender'] == 'Female').astype(int)\n    survey_eng['Gender_Male'] = (survey_eng['Q-demos-gender'] == 'Male').astype(int)\n\n# Hispanic ethnicity\nif 'Q-demos-hispanic' in survey_eng.columns:\n    survey_eng['Is_Hispanic'] = (survey_eng['Q-demos-hispanic'] == 'Yes').astype(int)\n\n# Race encoding\nif 'Q-demos-race' in survey_eng.columns:\n    survey_eng['Race_White'] = (survey_eng['Q-demos-race'] == 'White or Caucasian').astype(int)\n    survey_eng['Race_Black'] = (survey_eng['Q-demos-race'] == 'Black or African American').astype(int)\n    survey_eng['Race_Asian'] = (survey_eng['Q-demos-race'] == 'Asian').astype(int)\n "]
[61.073542, "i", "   survey_eng['Race_Other'] = (~survey_eng['Q-demos-race'].isin(['White or Caucasian', 'Black or African American', 'Asian', 'Unknown'])).astype(int)\n\n# Sexual orientation\nif 'Q-sexual-orientation' in survey_eng.columns:\n    survey_eng['Is_LGBTQ'] = (survey_eng['Q-sexual-orientation'] == 'LGBTQ+').astype(int)\n\n# Amazon usage frequency\nif 'Q-amazon-use-how-oft' in survey_eng.columns:\n    freq_mapping = {\n        'Less than 5 times per month': 1,\n        '5 - 10 times per month': 2,\n        'More than 10 times per month': 3,\n        'Unknown': 0\n    }\n    survey_eng['Amazon_Frequency'] = survey_eng['Q-amazon-use-how-oft'].map(freq_mapping).fillna(0)\n    survey_eng['Amazon_HighFreq'] = (survey_eng['Q-amazon-use-how-oft'] == 'More than 10 times per month').astype(int)\n\n# Household size\nif 'Q-amazon-use-hh-size' in survey_eng.columns:\n    survey_eng['HH_Size_Numeric'] = pd.to_numeric(\n        survey_eng['Q-amazon-use-hh-size'].str.extract('(\\d+)', expand=False),\n        errors='coerce'\n    ).fillna(1)\n    survey_eng['HH_Size_Large'] = (survey_eng['HH_Size_Numeric'] >= 3).astype(int)\n\n# Select engineered features for output\nengineered_features = ['Survey ResponseID']\nfor col in survey_eng.columns:\n    if col.startswith(('Age_', 'Income_', 'Has_', 'Gender_', 'Is_', 'Race_', 'Amazon_', 'HH_', 'Q-substance-use', 'Q-personal-')) and col != 'Survey ResponseID':\n        if '_Yes' in col or '_No' in col or '_Unknown' in col or '_Numeric' in col or col.startswith('Age_') or col.startswith('Income_') or col.startswith('Has_') or col.startswith('Gender_') or col.startswith('Is_') or col.startswith('Race_') or col.startswith('Amazon_') or col.startswith('HH_'):\n            engineered_features.append(col)\n\nsurvey_eng_output = survey_eng[engineered_features].copy()\nsurvey_eng_output.to_csv('/app/output/survey_feature_engineered.csv', index=False)\nprint(f\"Engineered {len(engineered_features)-1} features from survey data\")\nprint(f\"Sample engineered features: {engineered_features[1:10]}\")\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"STEP 4: PREPARE DATA FOR DID ANALYSIS\")\nprint(\"=\"*80)\n\n# Get top 10 surge and slump categories\ntop_surge = anomaly_df.nlargest(10, 'Anomaly_Index')['Category'].tolist()\ntop_slump = anomaly_df.nsmallest(10, 'Anomaly_Index')['Category'].tolist()\n\nprint(f\"\\nTop 10 Surge Categories: {top_surge}\")\nprint(f\"Top 10 Slump Categories: {top_slump}\")\n\n# Filter purchase data for top categories\ntop_categories = top_surge + top_slump\npurchase_top = purchase_df[purchase_df['Category'].isin(top_categories)].copy()\n\n# Add period indicator\npurchase_top['Period'] = 'Baseline'\npurchase_top.loc[purchase_top['Order Date'] >= '2020-03-01', 'Period'] = 'Treatment'\n\n# Filter to relevant periods only\npurchase_top = purchase_top[\n    ((purchase_top['Order Date'] >= '2020-01-01') & (purchase_top['Order Date'] <= '2020-02-29')) |\n    ((purchase_top['Order Date'] >= '2020-03-01') & (purchase_top['Order Date'] <= '2020-03-31'))\n].copy()\n\nprint(f\"\\nPurchases in top categories during baseline+treatment: {len(purchase_top)}\")\n\n# INTENSIVE MARGIN: Total spend by user-category-period\nintensive_data = purchase_top.groupby(['Survey ResponseID', 'Category', 'Period']).agg({\n    'Total_Price': 'sum'\n}).reset_index()\nintensive_data.columns = ['Survey ResponseID', 'Category', 'Period', 'Total_Spend']\n\n# Ensure all user-category-period combinations exist (fill with 0 for non-purchases)\nusers = intensive_data['Survey ResponseID'].unique()\ncategories = intensive_data['Category'].unique()\nperiods = ['Baseline', 'Treatment']\n\nfull_intensive = pd.DataFrame(\n    [(u, c, p) for u in users for c in categories for p in periods],\n    columns=['Survey ResponseID', 'Category', 'Period']\n)\nintensive_data = full_intensive.merge(\n    intensive_data,\n    on=['Survey ResponseID', 'Category', 'Period'],\n    how='left'\n).fillna(0)\n\nintensive_data.to_csv('/app/output/user_category_period_aggregated_intensive.csv', index=False)\nprint(f\"Intensive margin data saved: {len(intensive_data)} rows\")\n\n# EXTENSIVE MARGIN: Has purchase indicator by user-category-period\nextensive_data = purchase_top.gro"]
[61.073669, "i", "upby(['Survey ResponseID', 'Category', 'Period']).size().reset_index(name='Purchase_Count')\nextensive_data['Has_Purchase'] = (extensive_data['Purchase_Count'] > 0).astype(int)\nextensive_data = extensive_data[['Survey ResponseID', 'Category', 'Period', 'Has_Purchase']]\n\n# Ensure all user-category-period combinations exist\nextensive_data = full_intensive.merge(\n    extensive_data,\n    on=['Survey ResponseID', 'Category', 'Period'],\n    how='left'\n).fillna(0)\nextensive_data['Has_Purchase'] = extensive_data['Has_Purchase'].astype(int)\n\nextensive_data.to_csv('/app/output/user_category_period_aggregated_extensive.csv', index=False)\nprint(f\"Extensive margin data saved: {len(extensive_data)} rows\")\n\nprint(\"\\nData preparation complete.\")\n\nEOF\n"]
