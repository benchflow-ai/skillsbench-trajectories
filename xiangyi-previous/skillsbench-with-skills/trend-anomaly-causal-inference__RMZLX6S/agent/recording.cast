[33.926656, "i", "cat > /app/analysis_part2.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport json\nfrom scipy import stats\nfrom sklearn.linear_model import LinearRegression\nfrom sklearn.preprocessing import StandardScaler\nimport warnings\nwarnings.filterwarnings('ignore')\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"STEP 2: ANOMALY DETECTION IN CATEGORY TRENDS\")\nprint(\"=\"*80)\n\n# Load cleaned data\nsurvey_df = pd.read_csv('/app/output/survey_cleaned.csv')\npurchase_df = pd.read_csv('/app/output/amazon-purchases-2019-2020-filtered.csv')\npurchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'])\n\n# Extract year-month for grouping\npurchase_df['Year'] = purchase_df['Order Date'].dt.year\npurchase_df['Month'] = purchase_df['Order Date'].dt.month\npurchase_df['Date'] = purchase_df['Order Date'].dt.date\n\n# Define periods\nbaseline_start = pd.Timestamp('2020-01-01')\nbaseline_end = pd.Timestamp('2020-02-29')\ntreatment_start = pd.Timestamp('2020-03-01')\ntreatment_end = pd.Timestamp('2020-03-31')\nhistory_start = pd.Timestamp('2019-01-01')\nhistory_end = pd.Timestamp('2019-12-31')\n\n# Get historical data (2019) for baseline modeling\nhistory_df = purchase_df[(purchase_df['Order Date'] >= history_start) & (purchase_df['Order Date'] <= history_end)]\nbaseline_df = purchase_df[(purchase_df['Order Date'] >= baseline_start) & (purchase_df['Order Date'] <= baseline_end)]\ntreatment_df = purchase_df[(purchase_df['Order Date'] >= treatment_start) & (purchase_df['Order Date'] <= treatment_end)]\n\nprint(f\"Historical data (2019): {len(history_df)} transactions\")\nprint(f\"Baseline data (Jan-Feb 2020): {len(baseline_df)} transactions\")\nprint(f\"Treatment data (Mar 2020): {len(treatment_df)} transactions\")\n\n# Calculate daily sales by category for each period\ndef get_daily_category_sales(df):\n    \"\"\"Get daily total sales by category\"\"\"\n    return df.groupby(['Date', 'Category'])['Total_Price'].sum().reset_index()\n\nhistory_daily = get_daily_category_sales(history_df)\nbaseline_daily = get_daily_category_sales(baseline_df)\ntreatment_daily = get_daily_category_sales(treatment_df)\n\nprint(f\"\\nDaily category sales calculated\")\nprint(f\"History unique categories: {history_daily['Category'].nunique()}\")\nprint(f\"Baseline unique categories: {baseline_daily['Category'].nunique()}\")\nprint(f\"Treatment unique categories: {treatment_daily['Category'].nunique()}\")\n\n# Calculate anomaly index for each category\nanomaly_results = []\n\nfor category in treatment_daily['Category'].unique():\n    # Get historical data for this category\n    hist_cat = history_daily[history_daily['Category'] == category]['Total_Price'].values\n    \n    # Get baseline data for this category\n    base_cat = baseline_daily[baseline_daily['Category'] == category]['Total_Price'].values\n    \n    # Get treatment data for this category\n    treat_cat = treatment_daily[treatment_daily['Category'] == category]['Total_Price'].values\n    \n    if len(hist_cat) == 0 or len(treat_cat) == 0:\n        continue\n    \n    # Calculate expected spending based on historical trend\n    hist_mean = np.mean(hist_cat)\n    hist_std = np.std(hist_cat)\n    \n    # Calculate actual treatment mean\n    treat_mean = np.mean(treat_cat)\n    \n    # Calculate baseline mean\n    base_mean = np.mean(base_cat) if len(base_cat) > 0 else hist_mean\n    \n    # Calculate anomaly index (-100 to 100)\n    # Compare treatment to historical baseline\n    if hist_std == 0:\n        if treat_mean > hist_mean:\n            anomaly_index = 50\n        elif treat_mean < hist_mean:\n            anomaly_index = -50\n        else:\n            anomaly_index = 0\n    else:\n        # Standardized deviation\n        z_score = (treat_mean - hist_mean) / hist_std\n        # Scale to -100 to 100 range\n        anomaly_index = np.clip(z_score * 20, -100, 100)\n    \n    anomaly_results.append({\n        'Category': category,\n        'Anomaly_Index': anomaly_index,\n        'Hist_Mean': hist_mean,\n        'Base_Mean': base_mean,\n        'Treat_Mean': treat_mean,\n        'Hist_Std': hist_std,\n        'Treat_N_Days': len(treat_cat)\n    })\n\nanomaly_df = pd.DataFrame(anoma"]
[33.92673, "i", "ly_results)\nanomaly_df = anomaly_df.sort_values('Anomaly_Index', ascending=False).reset_index(drop=True)\n\nprint(f\"\\nAnomalies calculated for {len(anomaly_df)} categories\")\nprint(f\"\\nTop 10 surge categories:\")\nprint(anomaly_df.head(10)[['Category', 'Anomaly_Index', 'Treat_Mean']].to_string())\nprint(f\"\\nTop 10 slump categories:\")\nprint(anomaly_df.tail(10)[['Category', 'Anomaly_Index', 'Treat_Mean']].to_string())\n\n# Save anomaly index\nanomaly_df[['Category', 'Anomaly_Index']].to_csv('/app/output/category_anomaly_index.csv', index=False)\nprint(\"\\nAnomaly index saved.\")\n\nEOF\n"]
