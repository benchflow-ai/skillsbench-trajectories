[126.524421, "i", "python3 << 'EOF'\nimport json\nwith open('/app/output/causal_analysis_report.json', 'r') as f:\n    report = json.load(f)\n\nprint(\"=\"*80)\nprint(\"SAMPLE SURGE CATEGORY ENTRY\")\nprint(\"=\"*80)\nsurge = report['surge_categories'][0]\nprint(f\"Category: {surge['category']}\")\nprint(f\"Anomaly Index: {surge['anomaly_index']}\")\nprint(f\"Baseline Avg Spend: ${surge['baseline_avg_spend']:.2f}\")\nprint(f\"Treatment Avg Spend: ${surge['treatment_avg_spend']:.2f}\")\nprint(f\"Baseline Purchasers: {surge['n_purchasers_baseline']}\")\nprint(f\"Treatment Purchasers: {surge['n_purchasers_treatment']}\")\nprint(f\"Baseline Purchase Rate: {surge['baseline_purchase_rate']:.4f}\")\nprint(f\"Treatment Purchase Rate: {surge['treatment_purchase_rate']:.4f}\")\nprint(f\"At Risk Population: {surge['n_at_risk']}\")\nprint(f\"\\nIntensive Margin Top Drivers:\")\nfor i, driver in enumerate(surge['intensive_margin'][:3], 1):\n    print(f\"  {i}. {driver['feature']}: DID={driver['did_estimate']:.6f}, p={driver['p_value']:.4f}\")\nprint(f\"\\nExtensive Margin Top Drivers:\")\nfor i, driver in enumerate(surge['extensive_margin'][:3], 1):\n    print(f\"  {i}. {driver['feature']}: DID={driver['did_estimate']:.6f}, p={driver['p_value']:.4f}\")\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"SAMPLE SLUMP CATEGORY ENTRY\")\nprint(\"=\"*80)\nslump = report['slump_categories'][0]\nprint(f\"Category: {slump['category']}\")\nprint(f\"Anomaly Index: {slump['anomaly_index']}\")\nprint(f\"Baseline Avg Spend: ${slump['baseline_avg_spend']:.2f}\")\nprint(f\"Treatment Avg Spend: ${slump['treatment_avg_spend']:.2f}\")\nprint(f\"Baseline Purchasers: {slump['n_purchasers_baseline']}\")\nprint(f\"Treatment Purchasers: {slump['n_purchasers_treatment']}\")\nprint(f\"\\nIntensive Margin Top Drivers:\")\nfor i, driver in enumerate(slump['intensive_margin'][:3], 1):\n    print(f\"  {i}. {driver['feature']}: DID={driver['did_estimate']:.6f}, p={driver['p_value']:.4f}\")\nprint(f\"\\nExtensive Margin Top Drivers:\")\nfor i, driver in enumerate(slump['extensive_margin'][:3], 1):\n    print(f\"  {i}. {driver['feature']}: DID={driver['did_estimate']:.6f}, p={driver['p_value']:.4f}\")\n\nprint(\"\\n\" + \"=\"*80)\nprint(\"REPORT SUMMARY\")\nprint(\"=\"*80)\nprint(f\"Total Features Analyzed: {report['metadata']['total_features_analyzed']}\")\nprint(f\"Surge Categories: {report['summary']['surge']['total_categories']}\")\nprint(f\"  - Intensive Margin Drivers: {report['summary']['surge']['total_intensive_drivers']}\")\nprint(f\"  - Extensive Margin Drivers: {report['summary']['surge']['total_extensive_drivers']}\")\nprint(f\"Slump Categories: {report['summary']['slump']['total_categories']}\")\nprint(f\"  - Intensive Margin Drivers: {report['summary']['slump']['total_intensive_drivers']}\")\nprint(f\"  - Extensive Margin Drivers: {report['summary']['slump']['total_extensive_drivers']}\")\nprint(f\"\\nBaseline Period: {report['metadata']['baseline_start']} to {report['metadata']['baseline_end']}\")\nprint(f\"Treatment Period: {report['metadata']['treatment_start']} to {report['metadata']['treatment_end']}\")\n\nEOF\n"]
