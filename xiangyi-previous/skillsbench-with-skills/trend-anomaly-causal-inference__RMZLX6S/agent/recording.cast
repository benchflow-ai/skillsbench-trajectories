[16.758886, "i", "cat > /app/analysis.py << 'EOF'\nimport pandas as pd\nimport numpy as np\nfrom datetime import datetime, timedelta\nimport json\nfrom scipy import stats\nfrom sklearn.preprocessing import StandardScaler\nimport warnings\nwarnings.filterwarnings('ignore')\n\n# ============================================================================\n# STEP 1: LOAD AND CLEAN DATA\n# ============================================================================\n\nprint(\"Loading datasets...\")\nsurvey_df = pd.read_csv('/app/data/survey_dirty.csv')\npurchase_df = pd.read_csv('/app/data/amazon-purchases-2019-2020_dirty.csv')\n\nprint(f\"Survey shape before cleaning: {survey_df.shape}\")\nprint(f\"Purchase shape before cleaning: {purchase_df.shape}\")\n\n# Clean survey data\nprint(\"\\nCleaning survey data...\")\n# Remove duplicates based on Survey ResponseID\nsurvey_df = survey_df.drop_duplicates(subset=['Survey ResponseID'], keep='first')\nprint(f\"Survey shape after removing duplicates: {survey_df.shape}\")\n\n# Remove rows with all NaN values\nsurvey_df = survey_df.dropna(how='all')\n\n# Fill missing values in categorical columns with 'Unknown'\nfor col in survey_df.columns:\n    if survey_df[col].dtype == 'object':\n        survey_df[col] = survey_df[col].fillna('Unknown')\n\nprint(f\"Survey cleaned shape: {survey_df.shape}\")\n\n# Clean purchase data\nprint(\"\\nCleaning purchase data...\")\n# Remove duplicates\npurchase_df = purchase_df.drop_duplicates()\nprint(f\"Purchase shape after removing duplicates: {purchase_df.shape}\")\n\n# Remove rows with missing Survey ResponseID or Order Date\npurchase_df = purchase_df.dropna(subset=['Survey ResponseID', 'Order Date'])\nprint(f\"Purchase shape after removing missing IDs/dates: {purchase_df.shape}\")\n\n# Remove rows with missing Category or Purchase Price\npurchase_df = purchase_df.dropna(subset=['Category', 'Purchase Price Per Unit'])\nprint(f\"Purchase shape after removing missing category/price: {purchase_df.shape}\")\n\n# Remove rows with empty Category\npurchase_df = purchase_df[purchase_df['Category'].str.strip() != '']\nprint(f\"Purchase shape after removing empty categories: {purchase_df.shape}\")\n\n# Convert Order Date to datetime\npurchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'], errors='coerce')\npurchase_df = purchase_df.dropna(subset=['Order Date'])\n\n# Convert numeric columns\npurchase_df['Purchase Price Per Unit'] = pd.to_numeric(purchase_df['Purchase Price Per Unit'], errors='coerce')\npurchase_df['Quantity'] = pd.to_numeric(purchase_df['Quantity'], errors='coerce')\npurchase_df = purchase_df.dropna(subset=['Purchase Price Per Unit', 'Quantity'])\n\n# Calculate total price\npurchase_df['Total_Price'] = purchase_df['Purchase Price Per Unit'] * purchase_df['Quantity']\n\n# Remove negative prices\npurchase_df = purchase_df[purchase_df['Total_Price'] >= 0]\nprint(f\"Final purchase shape: {purchase_df.shape}\")\n\n# Filter to 2019-2020 data only\npurchase_df = purchase_df[(purchase_df['Order Date'] >= '2019-01-01') & (purchase_df['Order Date'] <= '2020-12-31')]\nprint(f\"Purchase shape after date filtering: {purchase_df.shape}\")\n\n# Save cleaned data\nsurvey_df.to_csv('/app/output/survey_cleaned.csv', index=False)\npurchase_df.to_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', index=False)\n\nprint(\"\\nCleaned data saved.\")\n\nEOF\n"]
