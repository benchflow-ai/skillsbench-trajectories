[16.764177, "o", "purchase_df['Quantity'] = pd.to_numeric(purchase_df['Quantity'], errors='coerce')\r\n\u001b[?2004l\r\u001b[?2004h"]
[16.764242, "o", "> "]
[16.764319, "o", "purchase_df = purchase_df.dropna(subset=['Purchase Price Per Unit', 'Quantity'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.764355, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.764427, "o", "# Calculate total price\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.764564, "o", "purchase_df['Total_Price'] = purchase_df['Purchase Price Per Unit'] * purchase_df['Quantity']\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[16.764627, "o", "\u001b[?2004h> "]
[16.764693, "o", "# Remove negative prices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.764765, "o", "purchase_df = purchase_df[purchase_df['Total_Price'] >= 0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.764838, "o", "print(f\"Final purchase shape: {purchase_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.764878, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.764977, "o", "# Filter to 2019-2020 data only\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.765136, "o", "purchase_df = purchase_df[(purchase_df['Order Date'] >= '2019-01-01') & (purchase_df['Order Date'] <= '2020-12-31')]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.765247, "o", "print(f\"Purchase shape after date filtering: {purchase_df.shape}\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[16.765276, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[16.76539, "o", "# Save cleaned data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[16.765433, "o", "survey_df.to_csv('/app/output/survey_cleaned.csv', index=False)\r\n\u001b[?2004l\r\u001b[?2004h"]
