[?2004l[?2004h> print(f"Purchase shape before cleaning: {purchase_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Clean survey data
[?2004l[?2004h> print("\nCleaning survey data...")
[?2004l[?2004h> # Remove duplicates based on Survey ResponseID
[?2004l[?2004h> survey_df = survey_df.drop_duplicates(subset=['Survey ResponseID'], keep='first')
[?2004l[?2004h> print(f"Survey shape after removing duplicates: {survey_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Remove rows with all NaN values
[?2004l[?2004h> survey_df = survey_df.dropna(how='all')
[?2004l[?2004h> 
[?2004l[?2004h> # Fill missing values in categorical columns with 'Unknown'
[?2004l[?2004h> for col in survey_df.columns:
[?2004l[?2004h>     if survey_df[col].dtype == 'object':
[?2004l[?2004h>         survey_df[col] = survey_df[col].fillna('Unknown')
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Survey cleaned shape: {survey_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Clean purchase data
[?2004l[?2004h> print("\nCleaning purchase data...")
[?2004l[?2004h> # Remove duplicates
[?2004l[?2004h> purchase_df = purchase_df.drop_duplicates()
[?2004l[?2004h> print(f"Purchase shape after removing duplicates: {purchase_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Remove rows with missing Survey ResponseID or Order Date
[?2004l[?2004h> purchase_df = purchase_df.dropna(subset=['Survey ResponseID', 'Order Date'])
[?2004l[?2004h> print(f"Purchase shape after removing missing IDs/dates: {purchase_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Remove rows with missing Category or Purchase Price
[?2004l[?2004h> purchase_df = purchase_df.dropna(subset=['Category', 'Purchase Price Per Unit'])
[?2004l[?2004h> print(f"Purchase shape after removing missing category/price: {purchase_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Remove rows with empty Category
[?2004l[?2004h> purchase_df = purchase_df[purchase_df['Category'].str.strip() != '']
[?2004l[?2004h> print(f"Purchase shape after removing empty categories: {purchase_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Convert Order Date to datetime
[?2004l[?2004h> purchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'], errors='coerce')
[?2004l[?2004h> purchase_df = purchase_df.dropna(subset=['Order Date'])
[?2004l[?2004h> 
[?2004l[?2004h> # Convert numeric columns
[?2004l[?2004h> purchase_df['Purchase Price Per Unit'] = pd.to_numeric(purchase_df['Purchase Price Per Unit'], errors='coerce')
[?2004l[?2004h> purchase_df['Quantity'] = pd.to_numeric(purchase_df['Quantity'], errors='coerce')
[?2004l[?2004h> purchase_df = purchase_df.dropna(subset=['Purchase Price Per Unit', 'Quantity'])
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate total price
[?2004l[?2004h> purchase_df['Total_Price'] = purchase_df['Purchase Price Per Unit'] * purchase_df['Quantity']
[?2004l[?2004h> 
[?2004l[?2004h> # Remove negative prices
[?2004l[?2004h> purchase_df = purchase_df[purchase_df['Total_Price'] >= 0]
[?2004l[?2004h> print(f"Final purchase shape: {purchase_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Filter to 2019-2020 data only
[?2004l[?2004h> purchase_df = purchase_df[(purchase_df['Order Date'] >= '2019-01-01') & (purchase_df['Order Date'] <= '2020-12-31')]
[?2004l[?2004h> print(f"Purchase shape after date filtering: {purchase_df.shape}")
[?2004l[?2004h> 
[?2004l[?2004h> # Save cleaned data
[?2004l[?2004h> survey_df.to_csv('/app/output/survey_cleaned.csv', index=False)
[?2004l[?2004h> purchase_df.to_csv('/app/output/amazon-purchases-2019-2020-filtered.csv', index=False)
[?2004l[?2004h> 
[?2004l[?2004h> print("\nCleaned data saved.")
