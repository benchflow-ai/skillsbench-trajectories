[?2004l[?2004h> feature_cols = [col for col in survey_eng.columns if col != 'Survey ResponseID']
[?2004l[?2004h> print(f"Analyzing {len(feature_cols)} demographic features")
[?2004l[?2004h> 
[?2004l[?2004h> def perform_did_analysis(data, outcome_col, features):
[?2004l[?2004h>     results = []
[?2004l[?2004h>     for feature in features:
[?2004l[?2004h>         if data[feature].std() == 0:
[?2004l[?2004h>             continue
[?2004l[?2004h>         data_copy = data.copy()
[?2004l[?2004h>         data_copy['Treatment'] = (data_copy['Period'] == 'Treatment').astype(int)
[?2004l[?2004h>         data_copy['Feature_x_Treatment'] = data_copy[feature] * data_copy['Treatment']
[?2004l[?2004h>         reg_data = data_copy[['Treatment', feature, 'Feature_x_Treatment', outcome_col]].dropna()
[?2004l[?2004h>         if len(reg_data) < 10:
[?2004l[?2004h>             continue
[?2004l[?2004h>         try:
[?2004l[?2004h>             X = reg_data[['Treatment', feature, 'Feature_x_Treatment']].values
[?2004l[?2004h>             y = reg_data[outcome_col].values
[?2004l[?2004h>             X_with_const = np.column_stack([np.ones(len(X)), X])
[?2004l[?2004h>             model = LinearRegression(fit_intercept=False)
[?2004l[?2004h>             model.fit(X_with_const, y)
[?2004l[?2004h>             did_estimate = model.coef_[3]
[?2004l[?2004h>             y_pred = model.predict(X_with_const)
[?2004l[?2004h>             residuals = y - y_pred
[?2004l[?2004h>             rss = np.sum(residuals**2)
[?2004l[?2004h>             mse = rss / (len(y) - 4)
[?2004l[?2004h>             X_T_X_inv = np.linalg.inv(X_with_const.T @ X_with_const)
[?2004l[?2004h>             se_did = np.sqrt(mse * X_T_X_inv[3, 3])
[?2004l[?2004h>             t_stat = did_estimate / se_did if se_did > 0 else 0
[?2004l[?2004h>             p_value = 2 * (1 - stats.t.cdf(abs(t_stat), len(y) - 4))
[?2004l[?2004h>             results.append({
[?2004l[?2004h>                 'feature': feature,
[?2004l[?2004h>                 'did_estimate': float(did_estimate),
[?2004l[?2004h>                 'p_value': float(p_value),
[?2004l[?2004h>                 'method': 'Univariate DiD' if outcome_col == 'Total_Spend' else 'Multivariate Heterogeneous DiD'
[?2004l[?2004h>             })
[?2004l[?2004h>         except:
[?2004l[?2004h>             continue
[?2004l[?2004h>     return results
[?2004l[?2004h> 
[?2004l[?2004h> print("\nPerforming DiD analysis...")
