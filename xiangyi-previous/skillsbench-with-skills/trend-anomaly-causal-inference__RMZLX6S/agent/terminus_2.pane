[?2004liduals = y - y_pred
            rss = np.sum(residuals**2)
            mse = rss / (len(y) - 4)
            X_T_X_inv = np.linalg.inv(X_with_const.T @ X_with_const)
            se_did = np.sqrt(mse * X_T_X_inv[3, 3])
            t_stat = did_estimate / se_did if se_did > 0 else 0
            p_value = 2 * (1 - stats.t.cdf(abs(t_stat), len(y) - 4))
            results.append({
                'feature': feature,
                'did_estimate': float(did_estimate),
                'p_value': float(p_value),
                'method': 'Univariate DiD' if outcome_col == 'Total_Spend' else 'Multivariate Heterogeneous DiD'
            })
        except:
            continue
    return results

print("\nPerforming DiD analysis...")
