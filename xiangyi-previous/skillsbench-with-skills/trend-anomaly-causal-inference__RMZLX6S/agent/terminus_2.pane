    'Has_Purchase', feature_cols
)

intensive_surge_sorted = sorted(intensive_surge_results, key=lambda x: x['did_estimate'], reverse=True)
intensive_slump_sorted = sorted(intensive_slump_results, key=lambda x: x['did_estimate'])
extensive_surge_sorted = sorted(extensive_surge_results, key=lambda x: x['did_estimate'], reverse=True)
