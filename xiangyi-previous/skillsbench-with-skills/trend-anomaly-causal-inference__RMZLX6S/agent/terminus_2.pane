[?2004hroot@6e82d151a17a:/app# cat > /app/analysis_part2.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004lI[?2004h> import numpy as np
[?2004l[?2004h> from datetime import datetime, timedelta
[?2004l[?2004h> import json
[?2004l[?2004h> from scipy import stats
[?2004l[?2004h> from sklearn.linear_model import LinearRegression
[?2004l[?2004h> from sklearn.preprocessing import StandardScaler
[?2004l[?2004h> import warnings
[?2004l[?2004h> warnings.filterwarnings('ignore')
[?2004l[?2004h> 
[?2004l[?2004h> print("\n" + "="*80)
[?2004l[?2004h> print("STEP 2: ANOMALY DETECTION IN CATEGORY TRENDS")
[?2004l[?2004h> print("="*80)
[?2004lat_[?2004h> 
[?2004l[?2004h> # Load cleaned data
[?2004l[?2004h> survey_df = pd.read_csv('/app/output/survey_cleaned.csv')
[?2004l[?2004h> purchase_df = pd.read_csv('/app/output/amazon-purchases-2019-2020-filtered.csv')
[?2004lAnom[?2004h> purchase_df['Order Date'] = pd.to_datetime(purchase_df['Order Date'])
[?2004l[?2004h> 
[?2004l[?2004h> # Extract year-month for grouping
[?2004l[?2004h> purchase_df['Year'] = purchase_df['Order Date'].dt.year
[?2004l[?2004h> purchase_df['Month'] = purchase_df['Order Date'].dt.month
[?2004l[?2004h> purchase_df['Date'] = purchase_df['Order Date'].dt.date
[?2004l[?2004h> 
[?2004l[?2004h> # Define periods
[?2004l[?2004h> baseline_start = pd.Timestamp('2020-01-01')
[?2004l[?2004h> baseline_end = pd.Timestamp('2020-02-29')
[?2004l[?2004h> treatment_start = pd.Timestamp('2020-03-01')
[?2004l[?2004h> treatment_end = pd.Timestamp('2020-03-31')
[?2004l[?2004h> history_start = pd.Timestamp('2019-01-01')
[?2004l[?2004h> history_end = pd.Timestamp('2019-12-31')
[?2004l[?2004h> 
[?2004l[?2004h> # Get historical data (2019) for baseline modeling
[?2004l[?2004h> history_df = purchase_df[(purchase_df['Order Date'] >= history_start) & (purchase_df['Order Date'] <= history_end)]
[?2004l[?2004h> baseline_df = purchase_df[(purchase_df['Order Date'] >= baseline_start) & (purchase_df['Order Date'] <= baseline_end)]
[?2004l[?2004h> treatment_df = purchase_df[(purchase_df['Order Date'] >= treatment_start) & (purchase_df['Order Date'] <= treatment_end)]
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Historical data (2019): {len(history_df)} transactions")
[?2004l[?2004h> print(f"Baseline data (Jan-Feb 2020): {len(baseline_df)} transactions")
[?2004l[?2004h> print(f"Treatment data (Mar 2020): {len(treatment_df)} transactions")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate daily sales by category for each period
[?2004l[?2004h> def get_daily_category_sales(df):
[?2004l[?2004h>     """Get daily total sales by category"""
[?2004l[?2004h>     return df.groupby(['Date', 'Category'])['Total_Price'].sum().reset_index()
[?2004l[?2004h> 
[?2004l[?2004h> history_daily = get_daily_category_sales(history_df)
[?2004l[?2004h> baseline_daily = get_daily_category_sales(baseline_df)
[?2004l[?2004h> treatment_daily = get_daily_category_sales(treatment_df)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nDaily category sales calculated")
[?2004l[?2004h> print(f"History unique categories: {history_daily['Category'].nunique()}")
[?2004l[?2004h> print(f"Baseline unique categories: {baseline_daily['Category'].nunique()}")
[?2004l[?2004h> print(f"Treatment unique categories: {treatment_daily['Category'].nunique()}")
[?2004l[?2004h> 
[?2004l[?2004h> # Calculate anomaly index for each category
[?2004l[?2004h> anomaly_results = []
[?2004l[?2004h> 
[?2004l[?2004h> for category in treatment_daily['Category'].unique():
[?2004l[?2004h>     # Get historical data for this category
[?2004l[?2004h>     hist_cat = history_daily[history_daily['Category'] == category]['Total_Price'].values
[?2004l[?2004h>     
[?2004l[?2004h>     # Get baseline data for this category
[?2004l[?2004h>     base_cat = baseline_daily[baseline_daily['Category'] == category]['Total_Price'].values
[?2004l[?2004h>     
[?2004l[?2004h>     # Get treatment data for this category
[?2004l[?2004h>     treat_cat = treatment_daily[treatment_daily['Category'] == category]['Total_Price'].values
[?2004l[?2004h>     
[?2004l[?2004h>     if len(hist_cat) == 0 or len(treat_cat) == 0:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate expected spending based on historical trend
[?2004l[?2004h>     hist_mean = np.mean(hist_cat)
[?2004l[?2004h>     hist_std = np.std(hist_cat)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate actual treatment mean
[?2004l[?2004h>     treat_mean = np.mean(treat_cat)
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate baseline mean
[?2004l[?2004h>     base_mean = np.mean(base_cat) if len(base_cat) > 0 else hist_mean
[?2004l[?2004h>     
[?2004l[?2004h>     # Calculate anomaly index (-100 to 100)
[?2004l[?2004h>     # Compare treatment to historical baseline
[?2004l[?2004h>     if hist_std == 0:
[?2004l[?2004h>         if treat_mean > hist_mean:
[?2004l[?2004h>             anomaly_index = 50
[?2004l[?2004h>         elif treat_mean < hist_mean:
[?2004l[?2004h>             anomaly_index = -50
[?2004l[?2004h>         else:
[?2004l[?2004h>             anomaly_index = 0
[?2004l[?2004h>     else:
[?2004l[?2004h>         # Standardized deviation
[?2004l[?2004h>         z_score = (treat_mean - hist_mean) / hist_std
[?2004l[?2004h>         # Scale to -100 to 100 range
[?2004l[?2004h>         anomaly_index = np.clip(z_score * 20, -100, 100)
[?2004l[?2004h>     
[?2004l[?2004h>     anomaly_results.append({
[?2004l[?2004h>         'Category': category,
[?2004l[?2004h>         'Anomaly_Index': anomaly_index,
[?2004l[?2004h>         'Hist_Mean': hist_mean,
[?2004l[?2004h>         'Base_Mean': base_mean,
[?2004l[?2004h>         'Treat_Mean': treat_mean,
[?2004l[?2004h>         'Hist_Std': hist_std,
[?2004l[?2004h>         'Treat_N_Days': len(treat_cat)
