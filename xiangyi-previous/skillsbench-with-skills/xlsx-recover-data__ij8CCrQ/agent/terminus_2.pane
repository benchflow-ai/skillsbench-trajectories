[?2004l[?2004h> # compute missing values
[?2004l[?2004h> # 2016 total
[?2004l[?2004h> total2016=sum(v for k,v in budgets[2016].items() if k!='Total' and v is not None)
[?2004l[?2004h> # 2019 space operations
[?2004l[?2004h> space_ops_2019=budgets[2019]['Total']-sum(v for k,v in budgets[2019].items() if k not in ('Space Operations','Total'))
[?2004l[?2004h> # 2020 science
[?2004l[?2004h> science_2020=budgets[2020]['Total']-sum(v for k,v in budgets[2020].items() if k not in ('Science','Total'))
[?2004l[?2004h> # 2023 aeronautics
[?2004l[?2004h> aero_2023=budgets[2023]['Total']-sum(v for k,v in budgets[2023].items() if k not in ('Aeronautics','Total'))
[?2004l[?2004h> # 2021 exploration from yoy 8.94% (given)
[?2004l[?2004h> expl_2021=budgets[2020]['Exploration']*(1+0.0894)
[?2004l[?2004h> # 2021 total from yoy total 3.43%
[?2004l[?2004h> total_2021=budgets[2020]['Total']*(1+0.0343)
[?2004l[?2004h> 
[?2004l[?2004h> # missing yoy
[?2004l[?2004h> space_tech_2019=(budgets[2019]['Space Technology']-budgets[2018]['Space Technology'])/budgets[2018]['Space Technology']*100
[?2004l[?2004h> science_yoy_2021=(budgets[2021]['Science']-science_2020)/science_2020*100
[?2004l[?2004h> space_ops_yoy_2021=(budgets[2021]['Space Operations']-budgets[2020]['Space Operations'])/budgets[2020]['Space Operations']*100
[?2004l[?2004h> 
