[79.879201, "o", "> ws_share=wb['Directorate Shares (%)']"]
[79.879238, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.879262, "o", "> "]
[79.879457, "o", "headers_sh=[cell.value for cell in ws_share[3]][1:]"]
[79.879493, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.879526, "o", "shares={}\r\n\u001b[?2004l\r"]
[79.879548, "o", "\u001b[?2004h"]
[79.879713, "o", "> "]
[79.879836, "o", "for row in ws_share.iter_rows(min_row=4, values_only=True):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.879935, "o", "    if row[0] is None: continue\r\n\u001b[?2004l\r"]
[79.880043, "o", "\u001b[?2004h>     year=row[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.880188, "o", "    vals=[None if v=='???' else v for v in row[1:]]\r\n\u001b[?2004l\r"]
[79.880274, "o", "\u001b[?2004h> "]
[79.880443, "o", "    shares[year]=dict(zip(headers_sh,vals))\r\n\u001b[?2004l\r"]
[79.880532, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> for year in budgets:\r\n\u001b[?2004l\r"]
[79.880568, "o", "\u001b[?2004h> "]
[79.88068, "o", "    total=budgets[year]['Total']\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.880708, "o", "> "]
[79.880785, "o", "    for k in headers_sh:\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.880813, "o", "> "]
[79.881187, "o", "        if shares[year].get(k) is None and budgets[year].get(k) is not None and total is not None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.881387, "o", "            share=budgets[year][k]/total*100\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.881473, "o", "> "]
[79.881575, "o", "            print('Share',year,k, round(share,2))\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.881625, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.88173, "o", "# Growth analysis computations\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.881827, "o", "ws_g=wb['Growth Analysis']\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.881865, "o", "> "]
[79.881975, "o", "headers_g=[cell.value for cell in ws_g[3]][1:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.882, "o", "> "]
[79.882144, "o", "rows=list(ws_g.iter_rows(min_row=4, values_only=True))\r\n\u001b[?2004l\r"]
[79.882239, "o", "\u001b[?2004h> "]
[79.88227, "o", "# create mapping for metrics\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.88234, "o", "metrics={}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.882396, "o", "for row in rows:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.882452, "o", "    metric=row[0]\r\n\u001b[?2004l\r"]
[79.882485, "o", "\u001b[?2004h> "]
[79.882662, "o", "    vals=[None if v=='???' else v for v in row[1:]]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.88282, "o", "    metrics[metric]=dict(zip(headers_g,vals))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.882961, "o", "# compute missing in growth analysis\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.883084, "o", "# CAGR for Exploration\r\n\u001b[?2004l\r\u001b[?2004h> import math\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.883251, "o", "if metrics['5-Year CAGR (%)']['Exploration'] is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.88331, "o", "    b2019=budgets[2019]['Exploration']"]
[79.883673, "o", "\r\n"]
[79.8837, "o", "\u001b[?2004l\r"]
[79.883769, "o", "\u001b[?2004h> "]
[79.883872, "o", "    b2024=budgets[2024]['Exploration']\r\n\u001b[?2004l\r"]
[79.883898, "o", "\u001b[?2004h> "]
[79.884002, "o", "    cagr=(b2024/b2019)**(1/5)-1\r\n\u001b[?2004l\r"]
[79.88405, "o", "\u001b[?2004h> "]
[79.884136, "o", "    print('CAGR Exploration', round(cagr*100,2))\r\n\u001b[?2004l\r"]
[79.884163, "o", "\u001b[?2004h> "]
[79.884231, "o", "# FY2019 budget for Exploration\r\n\u001b[?2004l\r"]
[79.884262, "o", "\u001b[?2004h> "]
[79.88439, "o", "if metrics['FY2019 Budget ($M)']['Exploration'] is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.88442, "o", "> "]
[79.884538, "o", "    print('FY2019 Exploration', budgets[2019]['Exploration'])\r\n\u001b[?2004l\r"]
[79.884564, "o", "\u001b[?2004h> "]
[79.884623, "o", "# 5-year change for Science\r\n\u001b[?2004l\r"]
[79.884649, "o", "\u001b[?2004h> "]
[79.884756, "o", "if metrics['5-Year Change ($M)']['Science'] is None:\r\n\u001b[?2004l\r"]
[79.884779, "o", "\u001b[?2004h> "]
[79.884903, "o", "    change=budgets[2024]['Science']-budgets[2019]['Science']\r\n\u001b[?2004l\r"]
[79.88493, "o", "\u001b[?2004h> "]
[79.885009, "o", "    print('5-year change Science', change)\r\n\u001b[?2004l\r"]
[79.885038, "o", "\u001b[?2004h"]
[79.88514, "o", "> "]
[79.885225, "o", "# Avg Annual Budget for Science\r\n\u001b[?2004l\r"]
[79.885257, "o", "\u001b[?2004h> "]
[79.885386, "o", "if metrics['Avg Annual Budget ($M)']['Science'] is None:\r\n\u001b[?2004l\r"]
[79.88541, "o", "\u001b[?2004h> "]
[79.885481, "o", "    # average 2019-2024 inclusive\r\n\u001b[?2004l\r"]
[79.885506, "o", "\u001b[?2004h> "]
[79.885645, "o", "    avg=sum(budgets[y]['Science'] for y in range(2019,2025))/6\r\n\u001b[?2004l\r"]
[79.885669, "o", "\u001b[?2004h> "]
[79.885758, "o", "    print('Avg annual Science', round(avg,1))\r\n\u001b[?2004l\r"]
[79.885788, "o", "\u001b[?2004h"]
[79.886108, "o", "> "]
