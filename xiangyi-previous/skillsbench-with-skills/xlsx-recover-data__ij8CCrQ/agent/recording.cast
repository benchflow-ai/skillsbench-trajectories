[79.875237, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[79.8753, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[79.875415, "o", "# compute missing in YoY and Shares"]
[79.87548, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.875574, "o", "ws_yoy=wb['YoY Changes (%)']"]
