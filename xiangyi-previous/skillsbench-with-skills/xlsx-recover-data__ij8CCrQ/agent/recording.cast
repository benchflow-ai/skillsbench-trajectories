[196.235065, "i", "python3 - <<'PY'\nimport openpyxl\nwb=openpyxl.load_workbook('nasa_budget_incomplete.xlsx')\n\n# values computed\nvalues_budget = {\n    (2016,'Total'):19285,\n    (2019,'Space Operations'):4639,\n    (2020,'Science'):7139,\n    (2021,'Exploration'):6555,\n    (2021,'Total'):23285,\n    (2023,'Aeronautics'):936\n}\nvalues_yoy = {\n    (2019,'Space Technology'):21.97,\n    (2021,'Science'):2.27,\n    (2021,'Space Operations'):-0.08\n}\nvalues_share = {\n    (2016,'Space Operations'):26.08,\n    (2021,'Science'):31.35\n}\nvalues_growth = {\n    ('5-Year CAGR (%)','Exploration'):8.58,\n    ('FY2019 Budget ($M)','Exploration'):5047,\n    ('5-Year Change ($M)','Science'):1534,\n    ('Avg Annual Budget ($M)','Science'):7610.3\n}\n\n# update Budget by Directorate\nws=wb['Budget by Directorate']\nheaders=[cell.value for cell in ws[3]]\ncol_idx={h:i+1 for i,h in enumerate(headers)}\nfor row in ws.iter_rows(min_row=4):\n    year=row[0].value\n    if year in [y for y,_ in values_budget.keys()]:\n        for (yr,col),val in values_budget.items():\n            if yr==year:\n                ws.cell(row=row[0].row, column=col_idx[col]).value = val\n\n# update YoY Changes\nws=wb['YoY Changes (%)']\nheaders=[cell.value for cell in ws[3]]\ncol_idx={h:i+1 for i,h in enumerate(headers)}\nfor row in ws.iter_rows(min_row=4):\n    year=row[0].value\n    if year in [y for y,_ in values_yoy.keys()]:\n        for (yr,col),val in values_yoy.items():\n            if yr==year:\n                ws.cell(row=row[0].row, column=col_idx[col]).value = val\n\n# update Directorate Shares\nws=wb['Directorate Shares (%)']\nheaders=[cell.value for cell in ws[3]]\ncol_idx={h:i+1 for i,h in enumerate(headers)}\nfor row in ws.iter_rows(min_row=4):\n    year=row[0].value\n    if year in [y for y,_ in values_share.keys()]:\n        for (yr,col),val in values_share.items():\n            if yr==year:\n                ws.cell(row=row[0].row, column=col_idx[col]).value = val\n\n# update Growth Analysis\nws=wb['Growth Analysis']\nheaders=[cell.value for cell in ws[3]]\ncol_idx={h:i+1 for i,h in enumerate(headers)}\nfor row in ws.iter_rows(min_row=4):\n    metric=row[0].value\n    if metric in [m for m,_ in values_growth.keys()]:\n        for (m,col),val in values_growth.items():\n            if m==metric:\n                ws.cell(row=row[0].row, column=col_idx[col]).value = val\n\n# save\nwb.save('nasa_budget_recovered.xlsx')\n\n# verify no ???\nwb2=openpyxl.load_workbook('nasa_budget_recovered.xlsx', data_only=True)\nfound=False\nfor ws in wb2.worksheets:\n    for row in ws.iter_rows(values_only=True):\n        if any(v=='???' for v in row):\n            found=True\n            print('Found ??? in', ws.title, row)\nif not found:\n    print('No ??? remaining')\nPY\n"]
