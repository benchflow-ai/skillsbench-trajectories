[80.080393, "o", "\u001b[?2004hroot@6e95b6d27db4:~# "]
[138.989001, "i", "python3 - <<'PY'\nimport openpyxl, math\nwb=openpyxl.load_workbook('nasa_budget_incomplete.xlsx', data_only=True)\nws=wb['Budget by Directorate']\nheaders=[cell.value for cell in ws[3]][1:]\nbudgets={}\nfor row in ws.iter_rows(min_row=4, values_only=True):\n    if row[0] is None: continue\n    year=row[0]\n    vals=[None if v=='???' else v for v in row[1:]]\n    budgets[year]=dict(zip(headers,vals))\n\n# compute missing values\n# 2016 total\n total2016=sum(v for k,v in budgets[2016].items() if k!='Total' and v is not None)\n# 2019 space operations\nspace_ops_2019=budgets[2019]['Total']-sum(v for k,v in budgets[2019].items() if k not in ('Space Operations','Total'))\n# 2020 science\nscience_2020=budgets[2020]['Total']-sum(v for k,v in budgets[2020].items() if k not in ('Science','Total'))\n# 2023 aeronautics\naero_2023=budgets[2023]['Total']-sum(v for k,v in budgets[2023].items() if k not in ('Aeronautics','Total'))\n# 2021 exploration from yoy 8.94% (given)\nexpl_2021=budgets[2020]['Exploration']*(1+0.0894)\n# 2021 total from yoy total 3.43%\ntotal_2021=budgets[2020]['Total']*(1+0.0343)\n\n# missing yoy\nspace_tech_2019=(budgets[2019]['Space Technology']-budgets[2018]['Space Technology'])/budgets[2018]['Space Technology']*100\nscience_yoy_2021=(budgets[2021]['Science']-science_2020)/science_2020*100\nspace_ops_yoy_2021=(budgets[2021]['Space Operations']-budgets[2020]['Space Operations'])/budgets[2020]['Space Operations']*100\n\n# shares missing\nshare_2016_space_ops=budgets[2016]['Space Operations']/total2016*100\nshare_2021_science=budgets[2021]['Science']/total_2021*100\n\n# growth analysis values\ncagr=(budgets[2024]['Exploration']/budgets[2019]['Exploration'])**(1/5)-1\navg_science=(budgets[2019]['Science']+science_2020+budgets[2021]['Science']+budgets[2022]['Science']+budgets[2023]['Science']+budgets[2024]['Science'])/6\n\n# print rounded values\nr2=lambda x: round(x+1e-9,2)\nprint('total2016', total2016)\nprint('space_ops_2019', space_ops_2019)\nprint('science_2020', science_2020)\nprint('expl_2021', round(expl_2021))\nprint('total_2021', round(total_2021))\nprint('aero_2023', aero_2023)\nprint('yoy space tech 2019', r2(space_tech_2019))\nprint('yoy science 2021', r2(science_yoy_2021))\nprint('yoy space ops 2021', r2(space_ops_yoy_2021))\nprint('share 2016 space ops', r2(share_2016_space_ops))\nprint('share 2021 science', r2(share_2021_science))\nprint('cagr exploration', r2(cagr*100))\nprint('avg science', round(avg_science,1))\nprint('5-year change science', budgets[2024]['Science']-budgets[2019]['Science'])\nprint('FY2019 Exploration', budgets[2019]['Exploration'])\nPY\n"]
