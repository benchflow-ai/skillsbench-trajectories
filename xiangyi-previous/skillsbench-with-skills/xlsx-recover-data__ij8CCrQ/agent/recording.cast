[79.875763, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[79.875907, "o", "headers_yoy=[cell.value for cell in ws_yoy[3]][1:]"]
[79.876054, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> yoy={}\r\n\u001b[?2004l\r"]
[79.876131, "o", "\u001b[?2004h> "]
[79.876221, "o", "for row in ws_yoy.iter_rows(min_row=4, values_only=True):\r\n\u001b[?2004l\r"]
[79.876306, "o", "\u001b[?2004h> "]
[79.876409, "o", "    if row[0] is None: continue\r\n\u001b[?2004l\r"]
[79.87651, "o", "\u001b[?2004h>     year=row[0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.876663, "o", "    vals=[None if v=='???' else v for v in row[1:]]\r\n\u001b[?2004l\r"]
[79.876758, "o", "\u001b[?2004h>     yoy[year]=dict(zip(headers_yoy,vals))"]
[79.87689, "o", "\r\n\u001b[?2004l\r"]
[79.876997, "o", "\u001b[?2004h"]
[79.877088, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.877185, "o", "# compute yoy missing using budgets\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.877245, "o", "for year in sorted(budgets.keys()):\r\n\u001b[?2004l\r"]
[79.877278, "o", "\u001b[?2004h> "]
[79.877373, "o", "    if year==min(budgets.keys()):\r\n\u001b[?2004l\r"]
[79.877405, "o", "\u001b[?2004h> "]
[79.877473, "o", "        continue\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.87756, "o", "    prev=budgets[year-1]\r\n\u001b[?2004l\r"]
[79.877591, "o", "\u001b[?2004h> "]
[79.877745, "o", "    cur=budgets[year]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.877909, "o", "    for k in headers_yoy:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.877975, "o", "        if yoy.get(year,{}).get(k) is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.878068, "o", "            if prev[k] is not None and cur[k] is not None:\r\n\u001b[?2004l\r"]
[79.878091, "o", "\u001b[?2004h> "]
[79.878249, "o", "                pct=(cur[k]-prev[k])/prev[k]*100\r\n\u001b[?2004l\r"]
[79.878274, "o", "\u001b[?2004h> "]
[79.878408, "o", "                print('YoY',year,k, round(pct,2))\r\n\u001b[?2004l\r"]
[79.878441, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[79.878471, "o", "\u001b[?2004h"]
[79.87885, "o", "> "]
