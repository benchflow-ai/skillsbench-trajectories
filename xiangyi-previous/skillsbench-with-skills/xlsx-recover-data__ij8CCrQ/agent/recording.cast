[40.912137, "i", "python3 - <<'PY'\nimport openpyxl, math\nwb=openpyxl.load_workbook('nasa_budget_incomplete.xlsx', data_only=True)\nws=wb['Budget by Directorate']\n# Extract header from row3\nheaders=[cell.value for cell in ws[3]][1:]\n# data: year -> dict of directorate\nbudgets={}\nfor row in ws.iter_rows(min_row=4, values_only=True):\n    if row[0] is None: continue\n    year=row[0]\n    budgets[year]=dict(zip(headers,row[1:]))\n\nprint('Years',budgets.keys())\nprint('2016 row',budgets[2016])\n# compute missing values\n# 2016 Total missing\n\ndef sum_row(d):\n    return sum(v for k,v in d.items() if k!='Total' and isinstance(v,(int,float)))\n\n# compute 2016 total from components\nfor year in budgets:\n    if budgets[year].get('Total')=='???' or budgets[year].get('Total') is None:\n        total=sum(v for k,v in budgets[year].items() if k!='Total')\n        print('computed total',year,total)\n\n# find missing in components using total\nfor year,d in budgets.items():\n    # find missing component\n    for k,v in d.items():\n        if v=='???':\n            # compute from total if possible\n            if k!='Total':\n                total=d['Total']\n                s=sum(v2 for k2,v2 in d.items() if k2 not in (k,'Total'))\n                print('missing',year,k,'=', total - s)\nPY\n"]
