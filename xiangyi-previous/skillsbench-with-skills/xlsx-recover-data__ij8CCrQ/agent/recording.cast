[79.863591, "i", "python3 - <<'PY'\nimport openpyxl, math\nwb=openpyxl.load_workbook('nasa_budget_incomplete.xlsx', data_only=True)\n# Parse Budget by Directorate\nws=wb['Budget by Directorate']\nheaders=[cell.value for cell in ws[3]][1:]\nbudgets={}\nfor row in ws.iter_rows(min_row=4, values_only=True):\n    if row[0] is None: continue\n    year=row[0]\n    vals=[]\n    for v in row[1:]:\n        if v=='???':\n            vals.append(None)\n        else:\n            vals.append(v)\n    budgets[year]=dict(zip(headers,vals))\n\n# compute missing totals and components\nfor year,d in budgets.items():\n    # missing total\n    if d.get('Total') is None:\n        total=sum(v for k,v in d.items() if k!='Total' and v is not None)\n        print('Total',year,total)\n    # missing components\n    for k,v in d.items():\n        if v is None and k!='Total':\n            total=d['Total']\n            s=sum(v2 for k2,v2 in d.items() if k2 not in (k,'Total') and v2 is not None)\n            if total is not None:\n                print('Missing',year,k, total - s)\n\n# compute missing in YoY and Shares\nws_yoy=wb['YoY Changes (%)']\n# gather yoy data\nheaders_yoy=[cell.value for cell in ws_yoy[3]][1:]\nyoy={}\nfor row in ws_yoy.iter_rows(min_row=4, values_only=True):\n    if row[0] is None: continue\n    year=row[0]\n    vals=[None if v=='???' else v for v in row[1:]]\n    yoy[year]=dict(zip(headers_yoy,vals))\n\n# compute yoy missing using budgets\nfor year in sorted(budgets.keys()):\n    if year==min(budgets.keys()):\n        continue\n    prev=budgets[year-1]\n    cur=budgets[year]\n    for k in headers_yoy:\n        if yoy.get(year,{}).get(k) is None:\n            if prev[k] is not None and cur[k] is not None:\n                pct=(cur[k]-prev[k])/prev[k]*100\n                print('YoY',year,k, round(pct,2))\n\n# parse shares\nws_share=wb['Directorate Shares (%)']\nheaders_sh=[cell.value for cell in ws_share[3]][1:]\nshares={}\nfor row in ws_share.iter_rows(min_row=4, values_only=True):\n    if row[0] is None: continue\n    year=row[0]\n    vals=[None if v=='???' else v for v in row[1:]]\n    shares[y"]
[79.863866, "o", "python3 - <<'PY'"]
[79.864061, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[79.864106, "i", "ear]=dict(zip(headers_sh,vals))\n\nfor year in budgets:\n    total=budgets[year]['Total']\n    for k in headers_sh:\n        if shares[year].get(k) is None and budgets[year].get(k) is not None and total is not None:\n            share=budgets[year][k]/total*100\n            print('Share',year,k, round(share,2))\n\n# Growth analysis computations\nws_g=wb['Growth Analysis']\nheaders_g=[cell.value for cell in ws_g[3]][1:]\nrows=list(ws_g.iter_rows(min_row=4, values_only=True))\n# create mapping for metrics\nmetrics={}\nfor row in rows:\n    metric=row[0]\n    vals=[None if v=='???' else v for v in row[1:]]\n    metrics[metric]=dict(zip(headers_g,vals))\n\n# compute missing in growth analysis\n# CAGR for Exploration\nimport math\nif metrics['5-Year CAGR (%)']['Exploration'] is None:\n    b2019=budgets[2019]['Exploration']\n    b2024=budgets[2024]['Exploration']\n    cagr=(b2024/b2019)**(1/5)-1\n    print('CAGR Exploration', round(cagr*100,2))\n# FY2019 budget for Exploration\nif metrics['FY2019 Budget ($M)']['Exploration'] is None:\n    print('FY2019 Exploration', budgets[2019]['Exploration'])\n# 5-year change for Science\nif metrics['5-Year Change ($M)']['Science'] is None:\n    change=budgets[2024]['Science']-budgets[2019]['Science']\n    print('5-year change Science', change)\n# Avg Annual Budget for Science\nif metrics['Avg Annual Budget ($M)']['Science'] is None:\n    # average 2019-2024 inclusive\n    avg=sum(budgets[y]['Science'] for y in range(2019,2025))/6\n    print('Avg annual Science', round(avg,1))\nPY\n"]
