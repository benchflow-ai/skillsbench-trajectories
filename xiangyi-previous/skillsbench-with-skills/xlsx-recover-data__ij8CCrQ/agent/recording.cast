[80.057165, "o", "YoY 2019 Space Technology 21.97\r\nYoY 2021 Space Operations -0.08\r\n"]
[80.057471, "o", "CAGR Exploration 8.58\r\nFY2019 Exploration 5047\r\n5-year change Science 1534\r\n"]
