[576.439407, "i", "cat > patch_fix.diff <<EOF\n--- common/src/main/java/com/google/auto/common/Visibility.java\n+++ common/src/main/java/com/google/auto/common/Visibility.java\n@@ -39,7 +39,7 @@\n   public static  Visibility ofElement(Element element) {\n     checkNotNull(element);\n     // packages don't have modifiers, but they're obviously \"public\"\n-    if (element.getKind().equals(PACKAGE)) {\n+    if (element.getKind().equals(PACKAGE) || element.getKind().name().equals(\"MODULE\")) {\n       return PUBLIC;\n     }\n     Set<Modifier> modifiers = element.getModifiers();\nEOF\n"]
