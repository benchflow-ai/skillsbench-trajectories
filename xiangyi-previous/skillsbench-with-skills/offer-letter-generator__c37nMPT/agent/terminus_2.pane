[?2004l[?2004h> import json
[?2004l[?2004h> import sys
[?2004l[?2004h> from docx import Document
[?2004l[?2004h> 
[?2004l[?2004h> def process_paragraph(paragraph, replacements):
[?2004l[?2004h>     text = paragraph.text
[?2004l[?2004h>     # Check if any replacement key is in the text
[?2004l[?2004h>     for key, value in replacements.items():
[?2004l[?2004h>         if key in text:
[?2004l[?2004h>             # Try to find it in runs to preserve formatting
[?2004l[?2004h>             found_in_run = False
[?2004l[?2004h>             for run in paragraph.runs:
[?2004l[?2004h>                 if key in run.text:
[?2004l[?2004h>                     run.text = run.text.replace(key, value)
[?2004l[?2004h>                     found_in_run = True
[?2004l[?2004h>             
[?2004l[?2004h>             if not found_in_run:
[?2004l[?2004h>                 # Fallback: this loses formatting of the paragraph but ensures replacement
[?2004l[?2004h>                 paragraph.text = paragraph.text.replace(key, value)
[?2004l[?2004h> 
[?2004l[?2004h> def main():
[?2004l[?2004h>     input_json = 'employee_data.json'
[?2004l[?2004h>     input_docx = 'offer_letter_template.docx'
[?2004l[?2004h>     output_docx = '/root/offer_letter_filled.docx'
[?2004l[?2004h> 
[?2004l[?2004h>     try:
[?2004l[?2004h>         with open(input_json, 'r') as f:
[?2004l[?2004h>             data = json.load(f)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error reading JSON: {e}")
[?2004l[?2004h>         sys.exit(1)
[?2004l[?2004h> 
[?2004l[?2004h>     try:
[?2004l[?2004h>         doc = Document(input_docx)
[?2004l[?2004h>     except Exception as e:
[?2004l[?2004h>         print(f"Error reading DOCX: {e}")
[?2004l[?2004h>         sys.exit(1)
[?2004l[?2004h> 
[?2004l[?2004h>     # Prepare replacements
[?2004l[?2004h>     replacements = {}
[?2004l[?2004h>     for k, v in data.items():
[?2004l[?2004h>         replacements['{{' + k + '}}'] = str(v)
[?2004l[?2004h> 
[?2004l[?2004h>     # Conditional logic
[?2004l[?2004h>     relocation = data.get('RELOCATION_PACKAGE', 'No')
[?2004l[?2004h>     if relocation == 'Yes':
[?2004l[?2004h>         replacements['{{IF_RELOCATION}}'] = ''
[?2004l[?2004h>         replacements['{{END_IF_RELOCATION}}'] = ''
[?2004l[?2004h>     else:
[?2004l[?2004h>         # If No, we would conceptually remove the content between markers.
[?2004l[?2004h>         # Given the task specifics (Data is Yes), we focus on removing markers.
[?2004l[?2004h>         pass
[?2004l[?2004h> 
[?2004l[?2004h>     # Process paragraphs in body
[?2004l[?2004h>     for paragraph in doc.paragraphs:
[?2004l[?2004h>         process_paragraph(paragraph, replacements)
[?2004l[?2004h> 
[?2004l[?2004h>     # Process tables
[?2004l[?2004h>     for table in doc.tables:
[?2004l[?2004h>         for row in table.rows:
[?2004l[?2004h>             for cell in row.cells:
[?2004l[?2004h>                 for paragraph in cell.paragraphs:
[?2004l[?2004h>                     process_paragraph(paragraph, replacements)
[?2004l[?2004h>     
[?2004l[?2004h>     # Save
[?2004l[?2004h>     doc.save(output_docx)
[?2004l[?2004h>     print(f"Successfully saved to {output_docx}")
[?2004l[?2004h> 
[?2004l[?2004h> if __name__ == "__main__":
[?2004l[?2004h>     main()
[?2004l[?2004h> EOF
