[98.001435, "i", "cat << 'EOF' > verify_offer.py\nfrom docx import Document\nimport sys\n\ndef check_document():\n    doc = Document('/root/offer_letter_filled.docx')\n    full_text = []\n    for para in doc.paragraphs:\n        full_text.append(para.text)\n    for table in doc.tables:\n        for row in table.rows:\n            for cell in row.cells:\n                for para in cell.paragraphs:\n                    full_text.append(para.text)\n    \n    content = '\\n'.join(full_text)\n    \n    # Check for remaining placeholders\n    if '{{' in content or '}}' in content:\n        print(\"FAILED: Found remaining placeholders {{...}}\")\n        # Print a snippet to see what remains\n        start = content.find('{{')\n        print(f\"Snippet: {content[start:start+50]}\")\n        sys.exit(1)\n        \n    # Check for relocation markers\n    if 'IF_RELOCATION' in content:\n        print(\"FAILED: Found relocation markers\")\n        sys.exit(1)\n        \n    # Check for relocation data (since it was Yes)\n    # We know the amount is 15,000 from the json\n    if '15,000' not in content:\n        print(\"WARNING: Did not find relocation amount 15,000 in text\")\n    \n    print(\"VERIFICATION SUCCESS: No placeholders found, markers removed.\")\n\nif __name__ == \"__main__\":\n    check_document()\nEOF\n"]
