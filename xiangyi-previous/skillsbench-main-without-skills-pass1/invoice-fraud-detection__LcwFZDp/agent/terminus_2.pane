[?2004hroot@aa3ad1938ba1:~# cat > /root/detect_fraud.py << 'EOF'
[?2004l[?2004h> import pdfplumber
[?2004l[?2004h> import openpyxl
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import json
[?2004l[?2004h> import re
[?2004l[?2004h> from thefuzz import fuzz
[?2004l[?2004h> 
[?2004l[?2004h> # Load vendors
[?2004l[?2004h> wb = openpyxl.load_workbook('/root/vendors.xlsx')
[?2004l[?2004h> ws = wb.active
[?2004l[?2004h> vendors = {}
[?2004l[?2004h> for row in ws.iter_rows(min_row=2, values_only=True):
[?2004l[?2004h>     vendor_id, name, iban = row
[?2004l[?2004h>     vendors[name] = {'id': vendor_id, 'iban': iban}
[?2004l[?2004h> print(f"Loaded {len(vendors)} vendors")
[?2004l[?2004h> 
[?2004l[?2004h> # Load purchase orders
[?2004l[?2004h> po_df = pd.read_csv('/root/purchase_orders.csv')
[?2004l[?2004h> pos = {}
[?2004l[?2004h> for _, row in po_df.iterrows():
[?2004l[?2004h>     pos[row['po_number']] = {'vendor_id': row['vendor_id'], 'amount': float(row['amount'])}
[?2004l[?2004h> print(f"Loaded {len(pos)} purchase orders")
[?2004l[?2004h> 
[?2004l[?2004h> # Function to find vendor with fuzzy matching
[?2004l[?2004h> def find_vendor(invoice_vendor_name):
[?2004l[?2004h>     # Try exact match first
[?2004l[?2004h>     if invoice_vendor_name in vendors:
[?2004l[?2004h>         return invoice_vendor_name, vendors[invoice_vendor_name]
[?2004l[?2004h>     
[?2004l[?2004h>     # Fuzzy match
[?2004l[?2004h>     best_match = None
[?2004l[?2004h>     best_score = 0
[?2004l[?2004h>     for vendor_name in vendors:
[?2004l[?2004h>         score = fuzz.ratio(invoice_vendor_name.lower(), vendor_name.lower())
[?2004l[?2004h>         # Also try partial ratio for Ltd vs Limited type variations
[?2004l[?2004h>         partial_score = fuzz.partial_ratio(invoice_vendor_name.lower(), vendor_name.lower())
[?2004l[?2004h>         max_score = max(score, partial_score)
[?2004l[?2004h>         if max_score > best_score:
[?2004l[?2004h>             best_score = max_score
[?2004l[?2004h>             best_match = vendor_name
[?2004l[?2004h>     
[?2004l[?2004h>     if best_score >= 80:  # Threshold for fuzzy match
[?2004l[?2004h>         return best_match, vendors[best_match]
[?2004l[?2004h>     return None, None
[?2004l[?2004h> 
[?2004l[?2004h> # Extract invoices from PDF
[?2004l[?2004h> pdf = pdfplumber.open('/root/invoices.pdf')
[?2004l[?2004h> fraud_report = []
[?2004l[?2004h> 
[?2004l[?2004h> for page_num, page in enumerate(pdf.pages, 1):
[?2004l[?2004h>     text = page.extract_text()
[?2004l[?2004h>     if not text:
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     # Parse invoice fields
[?2004l[?2004h>     vendor_match = re.search(r'From:\s*(.+)', text)
[?2004l[?2004h>     amount_match = re.search(r'Total\s*\$([\d,]+\.?\d*)', text)
[?2004l[?2004h>     iban_match = re.search(r'Payment IBAN:\s*(\S+)', text)
[?2004l[?2004h>     po_match = re.search(r'PO Number:\s*(\S+)', text)
[?2004l[?2004h>     
[?2004l[?2004h>     if not all([vendor_match, amount_match, iban_match]):
[?2004l[?2004h>         print(f"Page {page_num}: Could not parse all fields")
[?2004l[?2004h>         continue
[?2004l[?2004h>     
[?2004l[?2004h>     invoice_vendor = vendor_match.group(1).strip()
[?2004l[?2004h>     invoice_amount = float(amount_match.group(1).replace(',', ''))
[?2004l[?2004h>     invoice_iban = iban_match.group(1).strip()
[?2004l[?2004h>     invoice_po = po_match.group(1).strip() if po_match else None
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for fraud
[?2004l[?2004h>     reason = None
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. Unknown Vendor
[?2004l[?2004h>     matched_vendor_name, vendor_info = find_vendor(invoice_vendor)
[?2004l[?2004h>     if vendor_info is None:
[?2004l[?2004h>         reason = "Unknown Vendor"
[?2004l[?2004h>     
[?2004l[?2004h>     # 2. IBAN Mismatch
[?2004l[?2004h>     elif invoice_iban != vendor_info['iban']:
[?2004l[?2004h>         reason = "IBAN Mismatch"
[?2004l[?2004h>     
[?2004l[?2004h>     # 3. Invalid PO
[?2004l[?2004h>     elif invoice_po is None or invoice_po not in pos:
[?2004l[?2004h>         reason = "Invalid PO"
[?2004l[?2004h>     
[?2004l[?2004h>     else:
[?2004l[?2004h>         po_info = pos[invoice_po]
[?2004l[?2004h>         # 4. Amount Mismatch
[?2004l[?2004h>         if abs(po_info['amount'] - invoice_amount) > 0.01:
[?2004l[?2004h>             reason = "Amount Mismatch"
[?2004l[?2004h>         # 5. Vendor Mismatch
[?2004l[?2004h>         elif po_info['vendor_id'] != vendor_info['id']:
[?2004l[?2004h>             reason = "Vendor Mismatch"
[?2004l[?2004h>     
[?2004l[?2004h>     if reason:
[?2004l[?2004h>         fraud_report.append({
[?2004l[?2004h>             "invoice_page_number": page_num,
[?2004l[?2004h>             "vendor_name": invoice_vendor,
[?2004l[?2004h>             "invoice_amount": invoice_amount,
[?2004l[?2004h>             "iban": invoice_iban,
[?2004l[?2004h>             "po_number": invoice_po if invoice_po and invoice_po in pos else (invoice_po if reason == "Invalid PO" else invoice_po),
[?2004l[?2004h>             "reason": reason
[?2004l[?2004h>         })
[?2004l[?2004h>         print(f"Page {page_num}: {reason} - {invoice_vendor}")
[?2004l[?2004h> 
[?2004l[?2004h> # Handle po_number for Invalid PO case - keep the PO even if invalid, set to null only if missing
[?2004l[?2004h> for item in fraud_report:
[?2004l[?2004h>     if item['reason'] == 'Invalid PO' and item['po_number'] and item['po_number'] not in pos:
[?2004l[?2004h>         # Keep the invalid PO number as-is
[?2004l[?2004h>         pass
[?2004l[?2004h>     elif item['po_number'] == '' or item['po_number'] is None:
[?2004l[?2004h>         item['po_number'] = None
[?2004l[?2004h> 
[?2004l[?2004h> # Save report
[?2004l[?2004h> with open('/root/fraud_report.json', 'w') as f:
[?2004l[?2004h>     json.dump(fraud_report, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"\nTotal fraudulent invoices: {len(fraud_report)}")
[?2004l[?2004h> print("Report saved to /root/fraud_report.json")
[?2004l[?2004h> EOF
