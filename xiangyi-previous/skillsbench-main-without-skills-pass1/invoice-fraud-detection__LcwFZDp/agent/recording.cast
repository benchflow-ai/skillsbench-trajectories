[59.119182, "o", "        # Keep the invalid PO number as-is\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.119252, "o", "        pass\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.119317, "o", "    elif item['po_number'] == '' or item['po_number'] is None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.119386, "o", ">         item['po_number'] = None\r\n\u001b[?2004l\r"]
[59.119455, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> # Save report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.11954, "o", "with open('/root/fraud_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.119602, "o", "> "]
[59.119668, "o", "    json.dump(fraud_report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.119743, "o", "print(f\"\\nTotal fraudulent invoices: {len(fraud_report)}\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[59.119822, "o", "> "]
[59.119891, "o", "print(\"Report saved to /root/fraud_report.json\")\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
