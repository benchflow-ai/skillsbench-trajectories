[34.618722, "o", "\u001b[?2004hroot@aa3ad1938ba1:~# "]
[59.111431, "i", "cat > /root/detect_fraud.py << 'EOF'\nimport pdfplumber\nimport openpyxl\nimport pandas as pd\nimport json\nimport re\nfrom thefuzz import fuzz\n\n# Load vendors\nwb = openpyxl.load_workbook('/root/vendors.xlsx')\nws = wb.active\nvendors = {}\nfor row in ws.iter_rows(min_row=2, values_only=True):\n    vendor_id, name, iban = row\n    vendors[name] = {'id': vendor_id, 'iban': iban}\nprint(f\"Loaded {len(vendors)} vendors\")\n\n# Load purchase orders\npo_df = pd.read_csv('/root/purchase_orders.csv')\npos = {}\nfor _, row in po_df.iterrows():\n    pos[row['po_number']] = {'vendor_id': row['vendor_id'], 'amount': float(row['amount'])}\nprint(f\"Loaded {len(pos)} purchase orders\")\n\n# Function to find vendor with fuzzy matching\ndef find_vendor(invoice_vendor_name):\n    # Try exact match first\n    if invoice_vendor_name in vendors:\n        return invoice_vendor_name, vendors[invoice_vendor_name]\n    \n    # Fuzzy match\n    best_match = None\n    best_score = 0\n    for vendor_name in vendors:\n        score = fuzz.ratio(invoice_vendor_name.lower(), vendor_name.lower())\n        # Also try partial ratio for Ltd vs Limited type variations\n        partial_score = fuzz.partial_ratio(invoice_vendor_name.lower(), vendor_name.lower())\n        max_score = max(score, partial_score)\n        if max_score > best_score:\n            best_score = max_score\n            best_match = vendor_name\n    \n    if best_score >= 80:  # Threshold for fuzzy match\n        return best_match, vendors[best_match]\n    return None, None\n\n# Extract invoices from PDF\npdf = pdfplumber.open('/root/invoices.pdf')\nfraud_report = []\n\nfor page_num, page in enumerate(pdf.pages, 1):\n    text = page.extract_text()\n    if not text:\n        continue\n    \n    # Parse invoice fields\n    vendor_match = re.search(r'From:\\s*(.+)', text)\n    amount_match = re.search(r'Total\\s*\\$([\\d,]+\\.?\\d*)', text)\n    iban_match = re.search(r'Payment IBAN:\\s*(\\S+)', text)\n    po_match = re.search(r'PO Number:\\s*(\\S+)', text)\n    \n    if not all([vendor_match, amount_match, iban_match]):\n        print(f\"Page {page_num}: Could not parse all fields\")\n        continue\n    \n    invoice_vendor = vendor_match.group(1).strip()\n    invoice_amount = float(amount_match.group(1).replace(',', ''))\n    invoice_iban = iban_match.group(1).strip()\n    invoice_po = po_match.group(1).strip() if po_match else None\n    \n    # Check for fraud\n    reason = None\n    \n    # 1. Unknown Vendor\n    matched_vendor_name, vendor_info = find_vendor(invoice_vendor)\n    if vendor_info is None:\n        reason = \"Unknown Vendor\"\n    \n    # 2. IBAN Mismatch\n    elif invoice_iban != vendor_info['iban']:\n        reason = \"IBAN Mismatch\"\n    \n    # 3. Invalid PO\n    elif invoice_po is None or invoice_po not in pos:\n        reason = \"Invalid PO\"\n    \n    else:\n        po_info = pos[invoice_po]\n        # 4. Amount Mismatch\n        if abs(po_info['amount'] - invoice_amount) > 0.01:\n            reason = \"Amount Mismatch\"\n        # 5. Vendor Mismatch\n        elif po_info['vendor_id'] != vendor_info['id']:\n            reason = \"Vendor Mismatch\"\n    \n    if reason:\n        fraud_report.append({\n            \"invoice_page_number\": page_num,\n            \"vendor_name\": invoice_vendor,\n            \"invoice_amount\": invoice_amount,\n            \"iban\": invoice_iban,\n            \"po_number\": invoice_po if invoice_po and invoice_po in pos else (invoice_po if reason == \"Invalid PO\" else invoice_po),\n            \"reason\": reason\n        })\n        print(f\"Page {page_num}: {reason} - {invoice_vendor}\")\n\n# Handle po_number for Invalid PO case - keep the PO even if invalid, set to null only if missing\nfor item in fraud_report:\n    if item['reason'] == 'Invalid PO' and item['po_number'] and item['po_number'] not in pos:\n        # Keep the invalid PO number as-is\n        pass\n    elif item['po_number'] == '' or item['po_number'] is None:\n        item['po_number'] = None\n\n# Save report\nwith open('/root/fraud_report.json', 'w') as f:\n    json.dump(fraud_report, f, indent=2)\n\nprint(f\"\\nTotal fraudulent invoices: {len(fraud_report)}\")\nprint(\"Report saved to /root/fraud_report.json\")\nEOF\n"]
