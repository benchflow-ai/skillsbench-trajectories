[?2004hroot@90f7af5308de:~# cat << 'EOF' > analyze_invoices.py
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import pdfplumber
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> from rapidfuzz import process, fuzz
[?2004lm[?2004h> 
[?2004lo[?2004h> def solve():
[?2004l[?2004h>     # Load data
[?2004l[?2004h>     vendors_df = pd.read_excel('vendors.xlsx')
[?2004l[?2004h>     po_df = pd.read_csv('purchase_orders.csv')
[?2004l[?2004h> 
[?2004l[?2004h>     # Convert vendors to a list of dicts for easier access
[?2004l[?2004h>     vendors = vendors_df.to_dict('records')
[?2004l[?2004h>     vendor_names = [v['name'] for v in vendors]
[?2004l[?2004h>     
[?2004lr[?2004h>     # Convert POs to a dict for faster lookup
[?2004l[?2004h>     pos = {row['po_number']: row for _, row in po_df.iterrows()}
[?2004l[?2004h> 
[?2004l[?2004h>     results = []
[?2004l[?2004h> 
[?2004l[?2004h>     with pdfplumber.open('invoices.pdf') as pdf:
[?2004l[?2004h>         for i, page in enumerate(pdf.pages):
[?2004l[?2004h>             text = page.extract_text()
[?2004l[?2004h>             page_num = i + 1
[?2004l[?2004h>             
[?2004l[?2004h>             # Extract fields
[?2004l[?2004h>             vendor_name_match = re.search(r'From: (.*)', text)
[?2004l[?2004h>             amount_match = re.search(r'Total \$(.*)', text)
[?2004l[?2004h>             iban_match = re.search(r'Payment IBAN: (.*)', text)
[?2004l[?2004h>             po_number_match = re.search(r'PO Number: (.*)', text)
[?2004l[?2004h> 
[?2004l[?2004h>             if not vendor_name_match or not amount_match or not iban_match or not po_number_match:
[?2004l[?2004h>                 # This shouldn't happen based on the sample, but good to handle
[?2004l[?2004h>                 continue
[?2004l[?2004h> 
[?2004l[?2004h>             extracted_vendor_name = vendor_name_match.group(1).strip()
[?2004l[?2004h>             extracted_amount = float(amount_match.group(1).strip())
[?2004l[?2004h>             extracted_iban = iban_match.group(1).strip()
[?2004l[?2004h>             extracted_po_number = po_number_match.group(1).strip()
[?2004l[?2004h> 
[?2004l[?2004h>             # 1. Unknown Vendor (Fuzzy Matching)
[?2004l[?2004h>             # Use extractOne to find the best match
[?2004l[?2004h>             match = process.extractOne(extracted_vendor_name, vendor_names, scorer=fuzz.token_sort_ratio)
[?2004l[?2004h>             
[?2004l[?2004h>             # Threshold for fuzzy matching. Let's use 80 as a reasonable threshold for "minor typos".
[?2004l[?2004h>             if match and match[1] >= 80:
[?2004l[?2004h>                 matched_vendor = next(v for v in vendors if v['name'] == match[0])
[?2004l[?2004h>                 matched_vendor_id = matched_vendor['id']
[?2004l[?2004h>                 authorized_iban = matched_vendor['iban']
[?2004l[?2004h>             else:
[?2004l[?2004h>                 results.append({
[?2004l[?2004h>                     "invoice_page_number": page_num,
[?2004l[?2004h>                     "vendor_name": extracted_vendor_name,
[?2004l[?2004h>                     "invoice_amount": extracted_amount,
[?2004l[?2004h>                     "iban": extracted_iban,
[?2004l[?2004h>                     "po_number": None if extracted_po_number == 'None' else extracted_po_number,
[?2004l[?2004h>                     "reason": "Unknown Vendor"
[?2004l[?2004h>                 })
[?2004l[?2004h>                 continue
[?2004l[?2004h> 
[?2004l[?2004h>             # 2. IBAN Mismatch
[?2004l[?2004h>             if extracted_iban != authorized_iban:
[?2004l[?2004h>                 results.append({
[?2004l[?2004h>                     "invoice_page_number": page_num,
[?2004l[?2004h>                     "vendor_name": extracted_vendor_name,
[?2004l[?2004h>                     "invoice_amount": extracted_amount,
[?2004l[?2004h>                     "iban": extracted_iban,
[?2004l[?2004h>                     "po_number": extracted_po_number,
[?2004l[?2004h>                     "reason": "IBAN Mismatch"
[?2004l[?2004h>                 })
[?2004l[?2004h>                 continue
[?2004l[?2004h> 
[?2004l[?2004h>             # 3. Invalid PO
[?2004l[?2004h>             if extracted_po_number not in pos:
[?2004l[?2004h>                 results.append({
[?2004l[?2004h>                     "invoice_page_number": page_num,
[?2004l[?2004h>                     "vendor_name": extracted_vendor_name,
[?2004l[?2004h>                     "invoice_amount": extracted_amount,
[?2004l[?2004h>                     "iban": extracted_iban,
[?2004l[?2004h>                     "po_number": extracted_po_number,
[?2004l[?2004h>                     "reason": "Invalid PO"
[?2004l[?2004h>                 })
[?2004l[?2004h>                 continue
[?2004l[?2004h>             
[?2004l[?2004h>             po_data = pos[extracted_po_number]
[?2004l[?2004h> 
[?2004l[?2004h>             # 4. Amount Mismatch
[?2004l[?2004h>             if abs(extracted_amount - po_data['amount']) > 0.01:
[?2004l[?2004h>                 results.append({
[?2004l[?2004h>                     "invoice_page_number": page_num,
[?2004l[?2004h>                     "vendor_name": extracted_vendor_name,
[?2004l[?2004h>                     "invoice_amount": extracted_amount,
[?2004l[?2004h>                     "iban": extracted_iban,
[?2004l[?2004h>                     "po_number": extracted_po_number,
[?2004l[?2004h>                     "reason": "Amount Mismatch"
[?2004l[?2004h>                 })
[?2004l[?2004h>                 continue
[?2004l[?2004h> 
[?2004l[?2004h>             # 5. Vendor Mismatch
[?2004l[?2004h>             if po_data['vendor_id'] != matched_vendor_id:
[?2004l[?2004h>                 results.append({
[?2004l[?2004h>                     "invoice_page_number": page_num,
[?2004l[?2004h>                     "vendor_name": extracted_vendor_name,
[?2004l[?2004h>                     "invoice_amount": extracted_amount,
[?2004l[?2004h>                     "iban": extracted_iban,
[?2004l[?2004h>                     "po_number": extracted_po_number,
[?2004l[?2004h>                     "reason": "Vendor Mismatch"
[?2004l[?2004h>                 })
[?2004l[?2004h>                 continue
[?2004l[?2004h> 
[?2004l[?2004h>     with open('fraud_report.json', 'w') as f:
[?2004l[?2004h>         json.dump(results, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> solve()
[?2004l[?2004h> EOF
