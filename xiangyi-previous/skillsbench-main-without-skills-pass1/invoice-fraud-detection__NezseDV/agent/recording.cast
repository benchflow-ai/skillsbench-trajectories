[26.726295, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.72636, "o", "            # 3. Invalid PO\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.726423, "o", "            if extracted_po_number not in pos:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.726502, "o", "                results.append({\r\n\u001b[?2004l\r"]
[26.726567, "o", "\u001b[?2004h>                     \"invoice_page_number\": page_num,\r\n\u001b[?2004l\r"]
[26.726642, "o", "\u001b[?2004h> "]
[26.726714, "o", "                    \"vendor_name\": extracted_vendor_name,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.726774, "o", "                    \"invoice_amount\": extracted_amount,\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.726836, "o", "> "]
[26.726894, "o", "                    \"iban\": extracted_iban,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.726974, "o", "                    \"po_number\": extracted_po_number,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.72703, "o", "                    \"reason\": \"Invalid PO\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.727097, "o", ">                 })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727137, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.727225, "o", ">             \r\n"]
[26.727281, "o", "\u001b[?2004l\r\u001b[?2004h>             po_data = pos[extracted_po_number]\r\n\u001b[?2004l\r"]
[26.727318, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727392, "o", "            # 4. Amount Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.72751, "o", "            if abs(extracted_amount - po_data['amount']) > 0.01:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.72757, "o", "                results.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.727649, "o", "> "]
[26.72772, "o", "                    \"invoice_page_number\": page_num,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727784, "o", "                    \"vendor_name\": extracted_vendor_name,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727873, "o", "                    \"invoice_amount\": extracted_amount,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.727949, "o", "                    \"iban\": extracted_iban,\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.727985, "o", "> "]
[26.728067, "o", "                    \"po_number\": extracted_po_number,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728136, "o", "                    \"reason\": \"Amount Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.728197, "o", ">                 })\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728237, "o", "                continue\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.728323, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.72839, "o", "            # 5. Vendor Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728466, "o", "            if po_data['vendor_id'] != matched_vendor_id:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728508, "o", "                results.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.728597, "o", "> "]
[26.728663, "o", "                    \"invoice_page_number\": page_num,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728734, "o", "                    \"vendor_name\": extracted_vendor_name,\r\n\u001b[?2004l\r"]
[26.728792, "o", "\u001b[?2004h> "]
[26.728864, "o", "                    \"invoice_amount\": extracted_amount,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728928, "o", "                    \"iban\": extracted_iban,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.728993, "o", "                    \"po_number\": extracted_po_number,\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.729029, "o", "> "]
[26.729142, "o", "                    \"reason\": \"Vendor Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h>                 })\r\n\u001b[?2004l\r"]
[26.729202, "o", "\u001b[?2004h>                 continue\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[26.729273, "o", "\u001b[?2004h> "]
[26.729331, "o", "    with open('fraud_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.72938, "o", "        json.dump(results, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.729449, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> solve()\r\n\u001b[?2004l\r\u001b[?2004h> "]
