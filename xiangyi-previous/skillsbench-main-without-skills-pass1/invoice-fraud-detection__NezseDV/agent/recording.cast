[26.718921, "i", "cat << 'EOF' > analyze_invoices.py\nimport pandas as pd\nimport pdfplumber\nimport re\nimport json\nfrom rapidfuzz import process, fuzz\n\ndef solve():\n    # Load data\n    vendors_df = pd.read_excel('vendors.xlsx')\n    po_df = pd.read_csv('purchase_orders.csv')\n\n    # Convert vendors to a list of dicts for easier access\n    vendors = vendors_df.to_dict('records')\n    vendor_names = [v['name'] for v in vendors]\n    \n    # Convert POs to a dict for faster lookup\n    pos = {row['po_number']: row for _, row in po_df.iterrows()}\n\n    results = []\n\n    with pdfplumber.open('invoices.pdf') as pdf:\n        for i, page in enumerate(pdf.pages):\n            text = page.extract_text()\n            page_num = i + 1\n            \n            # Extract fields\n            vendor_name_match = re.search(r'From: (.*)', text)\n            amount_match = re.search(r'Total \\$(.*)', text)\n            iban_match = re.search(r'Payment IBAN: (.*)', text)\n            po_number_match = re.search(r'PO Number: (.*)', text)\n\n            if not vendor_name_match or not amount_match or not iban_match or not po_number_match:\n                # This shouldn't happen based on the sample, but good to handle\n                continue\n\n            extracted_vendor_name = vendor_name_match.group(1).strip()\n            extracted_amount = float(amount_match.group(1).strip())\n            extracted_iban = iban_match.group(1).strip()\n            extracted_po_number = po_number_match.group(1).strip()\n\n            # 1. Unknown Vendor (Fuzzy Matching)\n            # Use extractOne to find the best match\n            match = process.extractOne(extracted_vendor_name, vendor_names, scorer=fuzz.token_sort_ratio)\n            \n            # Threshold for fuzzy matching. Let's use 80 as a reasonable threshold for \"minor typos\".\n            if match and match[1] >= 80:\n                matched_vendor = next(v for v in vendors if v['name'] == match[0])\n                matched_vendor_id = matched_vendor['id']\n                authorized_iban = matched_vendor['iban']\n            else:\n                results.append({\n                    \"invoice_page_number\": page_num,\n                    \"vendor_name\": extracted_vendor_name,\n                    \"invoice_amount\": extracted_amount,\n                    \"iban\": extracted_iban,\n                    \"po_number\": None if extracted_po_number == 'None' else extracted_po_number,\n                    \"reason\": \"Unknown Vendor\"\n                })\n                continue\n\n            # 2. IBAN Mismatch\n            if extracted_iban != authorized_iban:\n                results.append({\n                    \"invoice_page_number\": page_num,\n                    \"vendor_name\": extracted_vendor_name,\n                    \"invoice_amount\": extracted_amount,\n                    \"iban\": extracted_iban,\n                    \"po_number\": extracted_po_number,\n                    \"reason\": \"IBAN Mismatch\"\n                })\n                continue\n\n            # 3. Invalid PO\n            if extracted_po_number not in pos:\n                results.append({\n                    \"invoice_page_number\": page_num,\n                    \"vendor_name\": extracted_vendor_name,\n                    \"invoice_amount\": extracted_amount,\n                    \"iban\": extracted_iban,\n                    \"po_number\": extracted_po_number,\n                    \"reason\": \"Invalid PO\"\n                })\n                continue\n            \n            po_data = pos[extracted_po_number]\n\n            # 4. Amount Mismatch\n            if abs(extracted_amount - po_data['amount']) > 0.01:\n                results.append({\n                    \"invoice_page_number\": page_num,\n                    \"vendor_name\": extracted_vendor_name,\n                    \"invoice_amount\": extracted_amount,\n                    \"iban\": extracted_iban,\n                    \"po_number\": extracted_po_number,\n                    \"reason\": \"Amount Mismatch\"\n                })\n                continue\n\n            # 5. Vendor Mismatch\n            if po_data['vendor_id'] != matched_vendor_id:\n                results.append({\n           "]
[26.719104, "i", "         \"invoice_page_number\": page_num,\n                    \"vendor_name\": extracted_vendor_name,\n                    \"invoice_amount\": extracted_amount,\n                    \"iban\": extracted_iban,\n                    \"po_number\": extracted_po_number,\n                    \"reason\": \"Vendor Mismatch\"\n                })\n                continue\n\n    with open('fraud_report.json', 'w') as f:\n        json.dump(results, f, indent=2)\n\nsolve()\nEOF\npython3 analyze_invoices.py\n"]
