[49.926984, "i", "cat << 'EOF' > check_mismatch.py\nimport pandas as pd\nimport pdfplumber\nimport re\nfrom rapidfuzz import process, fuzz\n\nvendors_df = pd.read_excel('vendors.xlsx')\npo_df = pd.read_csv('purchase_orders.csv')\nvendors = vendors_df.to_dict('records')\nvendor_names = [v['name'] for v in vendors]\npos = {row['po_number']: row for _, row in po_df.iterrows()}\n\nwith pdfplumber.open('invoices.pdf') as pdf:\n    for i, page in enumerate(pdf.pages):\n        text = page.extract_text()\n        page_num = i + 1\n        vendor_name_match = re.search(r'From: (.*)', text)\n        amount_match = re.search(r'Total \\$(.*)', text)\n        iban_match = re.search(r'Payment IBAN: (.*)', text)\n        po_number_match = re.search(r'PO Number: (.*)', text)\n        \n        if not vendor_name_match or not amount_match or not iban_match or not po_number_match:\n            print(f\"Page {page_num}: Missing fields\")\n            continue\n\n        ext_vendor = vendor_name_match.group(1).strip()\n        ext_po = po_number_match.group(1).strip()\n        \n        match = process.extractOne(ext_vendor, vendor_names, scorer=fuzz.token_sort_ratio)\n        if match and match[1] >= 80:\n            matched_vendor = next(v for v in vendors if v['name'] == match[0])\n            if ext_po in pos:\n                po_data = pos[ext_po]\n                if po_data['vendor_id'] != matched_vendor['id']:\n                    print(f\"Page {page_num}: Vendor Mismatch! Invoice Vendor: {matched_vendor['id']}, PO Vendor: {po_data['vendor_id']}\")\nEOF\npython3 check_mismatch.py\n"]
[49.927215, "o", "cat << 'EOF' > check_mismatch.py\r\n\u001b[?2004l\r"]
