Sending keys: ["python3 - <<'PY'\nimport pandas as pd, pdfplumber, re, difflib, json\nvendors = pd.read_excel('/root/vendors.xlsx')\nvendor_names = vendors['name'].tolist()\nvendor_map = {row['name']: row for _,row in vendors.iterrows()}\npo_df = pd.read_csv('/root/purchase_orders.csv')\npo_map = {row['po_number']: row for _,row in po_df.iterrows()}\n\ndef match_vendor(name):\n    if name in vendor_map:\n        return vendor_map[name], name\n    matches = difflib.get_close_matches(name, vendor_names, n=1, cutoff=0.8)\n    if matches:\n        m = matches[0]\n        return vendor_map[m], m\n    return None, None\n\nresults=[]\nwith pdfplumber.open('/root/invoices.pdf') as p:\n    for i,page in enumerate(p.pages,1):\n        text = page.extract_text() or ''\n        vendor = amount = iban = po = None\n        for line in text.splitlines():\n            m = re.search(r'^From:\\s*(.*)', line)\n            if m: vendor = m.group(1).strip()\n            m = re.search(r'^Total\\s*\\$([0-9,]+\\.\\d{2})', line)\n            if m: amount = float(m.group(1).replace(',',''))\n            m = re.search(r'^Payment IBAN:\\s*(.*)', line)\n            if m: iban = m.group(1).strip()\n            m = re.search(r'^PO Number:\\s*(.*)', line)\n            if m: po = m.group(1).strip()\n        po_val = po if po not in (None,'') else None\n        vendor_match, matched_name = match_vendor(vendor) if vendor else (None,None)\n        reason = None\n        if vendor_match is None:\n            reason = 'Unknown Vendor'\n        else:\n            if iban != vendor_match['iban']:\n                reason = 'IBAN Mismatch'\n            else:\n                if po_val is None or po_val not in po_map:\n                    reason = 'Invalid PO'\n                else:\n                    po_row = po_map[po_val]\n                    if abs(amount - po_row['amount']) > 0.01:\n                        reason = 'Amount Mismatch'\n                    else:\n                        if po_row['vendor_id'] != vendor_match['id']:\n                            reason = 'Vendor Mismatch'\n        if reason:\n            results.append({\n                'invoice_page_number': i,\n                'vendor_name': vendor,\n                'invoice_amount': round(amount,2) if amount is not None else None,\n                'iban': iban,\n                'po_number': po_val,\n                'reason': reason\n            })\n\nwith open('/root/fraud_report.json','w') as f:\n    json.dump(results, f, indent=2)\nprint('wrote', len(results), 'records')\nPY\n"] min_timeout_sec: 1.0 max_timeout_sec: 180.0
