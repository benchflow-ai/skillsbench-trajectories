C29\'] = \'Gold Price Volatility (%)\'\nws_answer[\'D29\'] = \'Total Reserves (Million USD)\'\nws_answer[\'E29\'] = \'RaR (%)\'\n\n# Replicate STEP 2 data to STEP 3 (11 countries total)\nfor i in range(11):\n    row = 30 + i\n    step2_row = 12 + i\n    \n    ws_answer[f\'A{row}\'] = f\'=A{step2_row}\'\n    ws_answer[f\'B{row}\'] = f\'=B{step2_row}\'\n    ws_answer[f\'C{row}\'] = \'=B6\'  # 12-month volatility\n    \n    # INDEX/MATCH to find Total Reserves\n    ws_answer[f\'D{row}\'] = f\'=IFERROR(INDEX(\\\'Total Reserves\\\'!B:B,MATCH(A{row},\\\'Total Reserves\\\'!A:A,0)),"")\'\n    \n    # RaR = (Gold Reserves Value / Total Reserves) * Gold Price Volatility\n    ws_answer[f\'E{row}\'] = f\'=IFERROR(IF(D{row}="","",B{row}/D{row}*C{row}),"")\'\n\n# Save the workbook\nwb.save(\'/root/output/rar_result.xlsx\')\nprint("Answer sheet structure completed!")\nprint("\\nSummary:")\nprint("- STEP 1: Gold price analysis with 3-month and 12-month volatility")\nprint("- STEP 2: 10 countries from Value sheet + South Korea from Volume sheet")\nprint("- STEP 3: All 11 countries with Total Reserves lookup and RaR calculation")\nprint("\\nFile saved to /root/output/rar_result.xlsx")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
