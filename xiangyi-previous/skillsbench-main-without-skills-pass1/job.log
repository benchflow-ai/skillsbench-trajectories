Sending keys: ['cat > /root/detect_fraud.py << \'EOF\'\nimport pandas as pd\nimport re\nimport json\nfrom difflib import SequenceMatcher\nimport subprocess\n\n# Extract text from PDF\nresult = subprocess.run([\'pdftotext\', \'/root/invoices.pdf\', \'-\'], \n                       capture_output=True, text=True)\npdf_text = result.stdout\n\n# Parse invoices from PDF\ninvoices = []\npattern = r\'Invoice Page (\\d+)\\s+From: (.+?)\\s+Total \\$([\\d.]+)\\s+Payment IBAN: (.+?)\\s+PO Number: (.+?)(?=\\n|$)\'\nmatches = re.findall(pattern, pdf_text, re.MULTILINE)\n\nfor match in matches:\n    page_num, vendor, amount, iban, po = match\n    invoices.append({\n        \'page\': int(page_num),\n        \'vendor_name\': vendor.strip(),\n        \'amount\': float(amount),\n        \'iban\': iban.strip(),\n        \'po_number\': po.strip()\n    })\n\n# Load vendors and purchase orders\nvendors_df = pd.read_excel(\'/root/vendors.xlsx\')\npurchase_orders_df = pd.read_csv(\'/root/purchase_orders.csv\')\n\n# Create lookup dictionaries\nvendors_by_name = {row[\'name\']: {\'id\': row[\'id\'], \'iban\': row[\'iban\']} \n                   for _, row in vendors_df.iterrows()}\npos_dict = {row[\'po_number\']: {\'vendor_id\': row[\'vendor_id\'], \'amount\': row[\'amount\']} \n            for _, row in purchase_orders_df.iterrows()}\n\ndef fuzzy_match_vendor(invoice_vendor, vendors_dict, threshold=0.85):\n    """Find best matching vendor using fuzzy string matching"""\n    best_match = None\n    best_ratio = 0\n    \n    for vendor_name in vendors_dict.keys():\n        ratio = SequenceMatcher(None, invoice_vendor.lower(), vendor_name.lower()).ratio()\n        if ratio > best_ratio:\n            best_ratio = ratio\n            best_match = vendor_name\n    \n    if best_ratio >= threshold:\n        return best_match, vendors_dict[best_match]\n    return None, None\n\n# Detect fraud\nfraud_cases = []\n\nfor inv in invoices:\n    vendor_name = inv[\'vendor_name\']\n    amount = inv[\'amount\']\n    iban = inv[\'iban\']\n    po_number = inv[\'po_number\']\n    page = inv[\'page\']\n    \n    # Check for valid PO format (not PO-INVALID or missing)\n    po_is_valid_format = po_number and not po_number.startswith(\'PO-INVALID\')\n    po_number_for_report = po_number if po_is_valid_format else None\n    \n    fraud_reason = None\n    \n    # 1. Unknown Vendor (with fuzzy matching)\n    matched_vendor_name, vendor_info = fuzzy_match_vendor(vendor_name, vendors_by_name)\n    \n    if not matched_vendor_name:\n        fraud_reason = "Unknown Vendor"\n    # 2. IBAN Mismatch\n    elif vendor_info[\'iban\'] != iban:\n        fraud_reason = "IBAN Mismatch"\n    # 3. Invalid PO (check if PO exists in purchase orders)\n    elif po_number not in pos_dict:\n        fraud_reason = "Invalid PO"\n    else:\n        po_info = pos_dict[po_number]\n        # 4. Amount Mismatch (exceeds 0.01 difference)\n        if abs(po_info[\'amount\'] - amount) > 0.01:\n            fraud_reason = "Amount Mismatch"\n        # 5. Vendor Mismatch\n        elif po_info[\'vendor_id\'] != vendor_info[\'id\']:\n            fraud_reason = "Vendor Mismatch"\n    \n    # Add to fraud report if flagged\n    if fraud_reason:\n        fraud_cases.append({\n            "invoice_page_number": page,\n            "vendor_name": vendor_name,\n            "invoice_amount": amount,\n            "iban": iban,\n            "po_number": po_number_for_report,\n            "reason": fraud_reason\n        })\n\n# Save fraud report\nwith open(\'/root/fraud_report.json\', \'w\') as f:\n    json.dump(fraud_cases, f, indent=2)\n\nprint(f"Fraud detection complete. Found {len(fraud_cases)} fraudulent invoices.")\nEOF\n'] min_timeout_sec: 0.1 max_timeout_sec: 180.0
