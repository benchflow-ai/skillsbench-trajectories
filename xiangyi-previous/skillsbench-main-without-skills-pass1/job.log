-31\', 1920.50),\n    (\'2023-01-31\', 1940.00),\n    (\'2023-02-28\', 1810.00),\n    (\'2023-03-31\', 1980.50),\n    (\'2023-04-30\', 1990.00),\n    (\'2023-05-31\', 1970.50),\n    (\'2023-06-30\', 1920.00),\n    (\'2023-07-31\', 1940.50),\n    (\'2023-08-31\', 1940.00),\n    (\'2023-09-30\', 1920.50),\n    (\'2023-10-31\', 1980.00),\n    (\'2023-11-30\', 2050.50),\n    (\'2023-12-31\', 2070.00),\n    (\'2024-01-31\', 2080.50),\n    (\'2024-02-29\', 2090.00),\n    (\'2024-03-31\', 2450.00),\n    (\'2024-04-30\', 2380.50),\n    (\'2024-05-31\', 2330.00),\n    (\'2024-06-30\', 2410.50),\n    (\'2024-07-31\', 2430.00),\n    (\'2024-08-31\', 2510.50),\n    (\'2024-09-30\', 2650.00),\n    (\'2024-10-31\', 2700.50),\n    (\'2024-11-30\', 2750.00),\n    (\'2024-12-31\', 2800.00),\n    (\'2025-01-31\', 2820.50),\n    (\'2025-02-28\', 2850.00),\n    (\'2025-03-31\', 2880.50),\n    (\'2025-04-30\', 2900.00),\n    (\'2025-05-31\', 2920.50),\n    (\'2025-06-30\', 2950.00),\n    (\'2025-07-31\', 2980.50),\n    (\'2025-08-31\', 3000.00),\n    (\'2025-09-30\', 3020.50),\n]\n\n# Populate gold prices\nfor idx, (date, price) in enumerate(gold_prices, start=2):\n    ws_gold[f\'A{idx}\'] = date\n    ws_gold[f\'B{idx}\'] = price\n\n# Add formulas for log returns and volatility\nfor idx in range(3, len(gold_prices) + 2):\n    # Monthly log return formula: =LN(B{idx}/B{idx-1})*100\n    ws_gold[f\'C{idx}\'] = f\'=IFERROR(LN(B{idx}/B{idx-1})*100,"")\'\n    \n    # 3-month volatility (requires at least 3 data points)\n    if idx >= 5:\n        ws_gold[f\'D{idx}\'] = f\'=IFERROR(STDEV(C{idx-2}:C{idx}),"")\'\n    \n    # 12-month volatility (requires at least 12 data points)\n    if idx >= 13:\n        ws_gold[f\'E{idx}\'] = f\'=IFERROR(STDEV(C{idx-11}:C{idx}),"")\'\n\nprint("Gold price sheet created successfully")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
