fs = cost[4:4+ncost]\n        gen_cost[gen_id] = coeffs\n    else:\n        gen_cost[gen_id] = [0, 0, 0]  # default\n\nprint(f'Loaded network with {len(bus_data)} buses, {len(gen_data)} generators, {len(branch_data)} branches')\nprint(f'Generator cost example (gen 1): {gen_cost[1]}')\n\nEOPYTHON\n"] min_timeout_sec: 2.0 max_timeout_sec: 180.0
