Sending keys: ['cat << \'EOF\' > solve_opf.py\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize\n\ndef solve():\n    with open(\'network.json\', \'r\') as f:\n        data = json.load(f)\n\n    baseMVA = data[\'baseMVA\']\n    buses = data[\'bus\']\n    gens = data[\'gen\']\n    branches = data[\'branch\']\n    gencosts = data[\'gencost\']\n\n    num_buses = len(buses)\n    num_gens = len(gens)\n    num_branches = len(branches)\n\n    bus_idx_map = {int(b[0]): i for i, b in enumerate(buses)}\n\n    # Variables: \n    # Vm: num_buses\n    # Va: num_buses\n    # Pg: num_gens\n    # Qg: num_gens\n    # Total vars: 2*num_buses + 2*num_gens\n\n    # Initial guess\n    x0 = np.zeros(2 * num_buses + 2 * num_gens)\n    bounds = []\n\n    # Vm and Va\n    for i in range(num_buses):\n        x0[i] = buses[i][7] # VM\n        x0[num_buses + i] = np.radians(buses[i][8]) # VA\n        bounds.append((buses[i][12], buses[i][11])) # VMIN, VMAX\n    for i in range(num_buses):\n        bounds.append((-np.pi, np.pi)) # VA\n\n    # Pg and Qg\n    for i in range(num_gens):\n        x0[2*num_buses + i] = gens[i][1] / baseMVA # PG\n        x0[2*num_buses + num_gens + i] = gens[i][2] / baseMVA # QG\n        bounds.append((gens[i][9] / baseMVA, gens[i][8] / baseMVA)) # PMIN, PMAX\n        bounds.append((gens[i][4] / baseMVA, gens[i][3] / baseMVA)) # QMIN, QMAX\n\n    # Reference bus constraint\n    ref_buses = [i for i, b in enumerate(buses) if b[1] == 3]\n    \n    def objective(x):\n        total_cost = 0\n        for i in range(num_gens):\n            pg = x[2*num_buses + i] * baseMVA\n            cost_coeffs = gencosts[i][4:]\n            # Assuming polynomial cost: c2*Pg^2 + c1*Pg + c0\n            if gencosts[i][3] == 3:\n                total_cost += cost_coeffs[0] * pg**2 + cost_coeffs[1] * pg + cost_coeffs[2]\n            elif gencosts[i][3] == 2:\n                total_cost += cost_coeffs[0] * pg + cost_coeffs[1]\n        return total_cost\n\n    def constraints(x):\n        Vm = x[:num_buses]\n        Va = x[num_buses:2*num_buses]\n        Pg = x[2*num_buses:2*num_buses + num_gens]\n        Qg = x[2*num_buses + num_gens:]\n\n        V = Vm * np.exp(1j * Va)\n        \n        # Power balance\n        P_gen = np.zeros(num_buses)\n        Q_gen = np.zeros(num_buses)\n        for i in range(num_gens):\n            bus_idx = bus_idx_map[int(gens[i][0])]\n            P_gen[bus_idx] += Pg[i]\n            Q_gen[bus_idx] += Qg[i]\n\n        P_load = np.array([b[2] for b in buses]) / baseMVA\n        Q_load = np.array([b[3] for b in buses]) / baseMVA\n        Gs = np.array([b[4] for b in buses]) / baseMVA\n        Bs = np.array([b[5] for b in buses]) / baseMVA\n\n        # Ybus construction (simplified for constraints)\n        # But it\'s better to compute P_inj and Q_inj directly\n        \n        res = []\n        \n        # Reference bus angle\n        for rb in ref_buses:\n            res.append(Va[rb])\n\n        # Branch flows and power balance\n        P_inj = np.zeros(num_buses)\n        Q_inj = np.zeros(num_buses)\n        \n        # Bus shunt injections\n        P_inj -= Gs * Vm**2\n        Q_inj += Bs * Vm**2\n\n        branch_flows_from = []\n        branch_flows_to = []\n\n        for br in branches:\n            f_idx = bus_idx_map[int(br[0])]\n            t_idx = bus_idx_map[int(br[1])]\n            r = br[2]\n            x_br = br[3]\n            b_br = br[4]\n            tap = br[8] if br[8] != 0 else 1.0\n            shift = np.radians(br[9])\n            \n            Y = 1.0 / (r + 1j * x_br)\n            T = tap * np.exp(1j * shift)\n            \n            # From side\n            S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\n            # To side\n            S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\n            \n            P_inj[f_idx] -= S_from.real\n            Q_inj[f_idx] -= S_from.imag\n            P_inj[t_idx] -= S_to.real\n            Q_inj[t_idx] -= S_to.imag\n            \n            branch_flows_from.append(np.abs(S_from))\n            branch_flows_to.append(np.abs(S_to))\n\n        for i in range(num_buses):\n            res.append(P_gen[i] - P_load[i] + P_inj[i])\n            res.append(Q_gen[i] - Q_load[i] + Q_inj[i])\n\n        # Branch flow limits\n        for i, br in enumerate(branches):\n            limit = br[5] / baseMVA\n            if limit > 0:\n                res.append(limit - branch_flows_from[i])\n                res.append(limit - branch_flows_to[i])\n        \n        return np.array(res)\n\n    # For minimize, we need separate eq and ineq constraints\n    def eq_constraints(x):\n        Vm = x[:num_buses]\n        Va = x[num_buses:2*num_buses]\n        Pg = x[2*num_buses:2*num_buses + num_gens]\n        Qg = x[2*num_buses + num_gens:]\n        V = Vm * np.exp(1j * Va)\n        P_gen = np.zeros(num_buses)\n        Q_gen = np.zeros(num_buses)\n        for i in range(num_gens):\n            bus_idx = bus_idx_map[int(gens[i][0])]\n            P_gen[bus_idx] += Pg[i]\n            Q_gen[bus_idx] += Qg[i]\n        P_load = np.array([b[2] for b in buses]) / baseMVA\n        Q_load = np.array([b[3] for b in buses]) / baseMVA\n        Gs = np.array([b[4] for b in buses]) / baseMVA\n        Bs = np.array([b[5] for b in buses]) / baseMVA\n        P_inj = -Gs * Vm**2\n        Q_inj = Bs * Vm**2\n        for br in branches:\n            f_idx = bus_idx_map[int(br[0])]\n            t_idx = bus_idx_map[int(br[1])]\n            r, x_br, b_br = br[2], br[3], br[4]\n            tap = br[8] if br[8] != 0 else 1.0\n            shift = np.radians(br[9])\n            Y = 1.0 / (r + 1j * x_br)\n            T = tap * np.exp(1j * shift)\n            S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\n            S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\n            P_inj[f_idx] -= S_from.real\n            Q_inj[f_idx] -= S_from.imag\n            P_inj[t_idx] -= S_to.real\n            Q_inj[t_idx] -= S_to.imag\n        res = []\n        for rb in ref_buses:\n            res.append(Va[rb])\n        for i in range(num_buses):\n            res.append(P_gen[i] - P_load[i] + P_inj[i])\n            res.append(Q_gen[i] - Q_load[i] + Q_inj[i])\n        return np.array(res)\n\n    def ineq_constraints(x):\n        Vm = x[:num_buses]\n        Va = x[num_buses:2*num_buses]\n        V = Vm * np.exp(1j * Va)\n        res = []\n        for br in branches:\n            f_idx = bus_idx_map[int(br[0])]\n            t_idx = bus_idx_map[int(br[1])]\n            r, x_br, b_br = br[2], br[3], br[4]\n            tap = br[8] if br[8] != 0 else 1.0\n            shift = np.radians(br[9])\n            Y = 1.0 / (r + 1j * x_br)\n            T = tap * np.exp(1j * shift)\n            S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\n            S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\n            limit = br[5] / baseMVA\n            if limit > 0:\n                res.append(limit - np.abs(S_from))\n                res.append(limit - np.abs(S_to))\n        return np.array(res)\n\n    cons = [{\'type\': \'eq\', \'fun\': eq_constraints}, {\'type\': \'ineq\', \'fun\': ineq_constraints}]\n    \n    res = minimize(objective, x0, method=\'SLSQP\', bounds=bounds, constraints=cons, options={\'maxiter\': 1000, \'disp\': True})\n    \n    # Output report\n    x = res.x\n    Vm = x[:num_buses]\n    Va = x[num_buses:2*num_buses]\n    Pg = x[2*num_buses:2*num_buses + num_gens]\n    Qg = x[2*num_buses + num_gens:]\n    V = Vm * np.exp(1j * Va)\n\n    report = {\n        "summary": {\n            "total_cost_per_hour": res.fun,\n            "total_load_MW": sum(b[2] for b in buses),\n            "total_load_MVAr": sum(b[3] for b in buses),\n            "total_generation_MW": float(np.sum(Pg) * baseMVA),\n            "total_generation_MVAr": float(np.sum(Qg) * baseMVA),\n            "total_losses_MW": float((np.sum(Pg) - sum(b[2] for b in buses) / baseMVA - sum(b[4] for b in buses) * Vm**2 / baseMVA) * baseMVA), # simplified\n            "solver_status": "optimal" if res.success else "failed"\n        },\n        "generators": [],\n        "buses": [],\n        "most_loaded_branches": [],\n        "feasibility_check": {}\n    }\n    \n    # Fix total_losses_MW\n    total_p_inj = 0\n    for i in range(num_buses):\n        total_p_inj += (b[2]/baseMVA + b[4]/baseMVA * Vm[i]**2)\n    # This is not quite right. Losses = Total Gen - Total Load - Total Shunt. \n    # Let\'s re-calculate accurately.\n    total_load_P = sum(b[2] for b in buses)\n    total_gen_P = np.sum(Pg) * baseMVA\n    # Losses = total_gen_P - total_load_P - total_shunt_P\n    total_shunt_P = np.sum(np.array([b[4] for b in buses]) * Vm**2)\n    report["summary"]["total_losses_MW"] = float(total_gen_P - total_load_P - total_shunt_P)\n\n    for i in range(num_gens):\n        report["generators"].append({\n            "id": i + 1,\n            "bus": int(gens[i][0]),\n            "pg_MW": float(Pg[i] * baseMVA),\n            "qg_MVAr": float(Qg[i] * baseMVA),\n            "pmin_MW": gens[i][9],\n            "pmax_MW": gens[i][8],\n            "qmin_MVAr": gens[i][4],\n            "qmax_MVAr": gens[i][3]\n        })\n    \n    for i in range(num_buses):\n        report["buses"].append({\n            "id": int(buses[i][0]),\n            "vm_pu": float(Vm[i]),\n            "va_deg": float(np.degrees(Va[i])),\n            "vmin_pu": buses[i][12],\n            "vmax_pu": buses[i][11]\n        })\n\n    branch_info = []\n    for i, br in enumerate(branches):\n        f_idx = bus_idx_map[int(br[0])]\n        t_idx = bus_idx_map[int(br[1])]\n        r, x_br, b_br = br[2], br[3], br[4]\n        tap = br[8] if br[8] != 0 else 1.0\n        shift = np.radians(br[9])\n        Y = 1.0 / (r + 1j * x_br)\n        T = tap * np.exp(1j * shift)\n        S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\n        S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\n        \n        limit = br[5]\n        loading = max(np.abs(S_from), np.abs(S_to)) * baseMVA\n        pct = (loading / limit * 100) if limit > 0 else 0\n        \n        branch_info.append({\n            "from_bus": int(br[0]),\n            "to_bus": int(br[1]),\n            "loading_pct": float(pct),\n            "flow_from_MVA": float(np.abs(S_from) * baseMVA),\n            "flow_to_MVA": float(np.abs(S_to) * baseMVA),\n            "limit_MVA": float(limit)\n        })\n    \n    branch_info.sort(key=lambda x: x[\'loading_pct\'], reverse=True)\n    report["most_loaded_branches"] = branch_info[:5]\n\n    # Feasibility check\n    eq_vals = eq_constraints(x)\n    # eq_vals contains ref_bus_angle, then P_mismatch, Q_mismatch for each bus\n    p_mismatches = []\n    q_mismatches = []\n    idx = len(ref_buses)\n    for i in range(num_buses):\n        p_mismatches.append(abs(eq_vals[idx]))\n        q_mismatches.append(abs(eq_vals[idx+1]))\n        idx += 2\n    \n    report["feasibility_check"] = {\n        "max_p_mismatch_MW": float(max(p_mismatches) * baseMVA),\n        "max_q_mismatch_MVAr": float(max(q_mismatches) * baseMVA),\n        "max_voltage_violation_pu": float(max(0, np.max(Vm - np.array([b[11] for b in buses])), np.max(np.array([b[12] for b in buses]) - Vm))),\n        "max_branch_overload_MVA": float(max([0] + [b[\'flow_from_MVA\'] - b[\'limit_MVA\'] for b in branch_info if b[\'limit_MVA\'] > 0] + [b[\'flow_to_MVA\'] - b[\'limit_MVA\'] for b in branch_info if b[\'limit_MVA\'] > 0]))\n    }\n\n    with open(\'report.json\', \'w\') as f:\n        json.dump(report, f, indent=2)\n\nsolve()\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
