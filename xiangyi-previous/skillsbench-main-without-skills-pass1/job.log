lume_countries, start=12+len(value_countries)):\n    ws_answer[f\'A{idx}\'] = f\'=Volume!A{vol_row}\'\n    # Calculate value: Volume * Average Gold Price (Jan-Sep 2025)\n    # Average of rows 65-71 (Jan-Sep 2025)\n    ws_answer[f\'B{idx}\'] = f\'=Volume!B{vol_row}*AVERAGE(Gold price!B65:B71)\'\n\n# Gold Price Exposure (row 13 in STEP 2 area - which would be row 13 from start of STEP 2)\nstep2_end_row = 12 + len(value_countries) + len(volume_countries)\nws_answer[f\'A{step2_end_row+1}\'] = \'Gold Price Exposure (%)\'\nws_answer[f\'B{step2_end_row+1}\'] = f\'=B4\'  # Use 3-month volatility\n\n# ===== STEP 3 SECTION =====\nstep3_start = step2_end_row + 3\nws_answer[f\'A{step3_start}\'] = \'STEP 3: Risk Analysis with Total Reserves\'\nws_answer[f\'A{step3_start}\'].font = Font(bold=True, size=12)\n\nws_answer[f\'A{step3_start+2}\'] = \'Country\'\nws_answer[f\'B{step3_start+2}\'] = \'Gold Reserves Value (Million USD)\'\nws_answer[f\'C{step3_start+2}\'] = \'Gold Price Volatility (%)\'\nws_answer[f\'D{step3_start+2}\'] = \'Total Reserves (Million USD)\'\nws_answer[f\'E{step3_start+2}\'] = \'RaR (%)\'\n\n# Replicate STEP 2 data to STEP 3 and add Total Reserves lookup\nfor idx in range(len(value_countries) + len(volume_countries)):\n    row_offset = step3_start + 3 + idx\n    step2_row = 12 + idx\n    \n    ws_answer[f\'A{row_offset}\'] = f\'=A{step2_row}\'\n    ws_answer[f\'B{row_offset}\'] = f\'=B{step2_row}\'\n    ws_answer[f\'C{row_offset}\'] = f\'=B6\'  # Use 12-month volatility\n    \n    # Use INDEX/MATCH to find Total Reserves\n    ws_answer[f\'D{row_offset}\'] = f\'=IFERROR(INDEX(Total Reserves!B:B,MATCH(A{row_offset},Total Reserves!A:A,0)),"")\'\n    \n    # RaR = (Gold Reserves Value / Total Reserves) * Gold Price Volatility\n    ws_answer[f\'E{row_offset}\'] = f\'=IFERROR((B{row_offset}/D{row_offset})*C{row_offset},"")\'\n\nwb.save(\'/root/output/rar_result.xlsx\')\nprint("Answer sheet created successfully")\nprint(f"File saved to /root/output/rar_result.xlsx")\nEOF\n'] min_timeout_sec: 2.0 max_timeout_sec: 180.0
