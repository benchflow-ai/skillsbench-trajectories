[20.505697, "i", "python3 - <<'PY'\nimport pandas as pd\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/test-rar.xlsx', data_only=False)\nfor name in ['Gold price','Answer','Value','Volume','Total Reserves']:\n    ws = wb[name]\n    print('---',name,'---')\n    # print first 5 rows and columns\n    data = []\n    for r in ws.iter_rows(min_row=1, max_row=6, max_col=10, values_only=True):\n        data.append(r)\n    for row in data:\n        print(row)\nPY\n"]
