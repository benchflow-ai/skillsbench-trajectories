[44.400615, "i", "python3 - <<'PY'\nimport openpyxl\nwb = openpyxl.load_workbook('/root/data/test-rar.xlsx', data_only=False)\nws = wb['Answer']\nprint('Answer sheet:')\nfor r in range(1,25):\n    row = [ws.cell(r,c).value for c in range(1,12)]\n    print(r, row)\n\nws2 = wb['Gold price']\nprint('\\nGold price last rows:')\nfor r in range(ws2.max_row-5, ws2.max_row+1):\n    row = [ws2.cell(r,c).value for c in range(1,6)]\n    print(r,row)\nPY\n"]
