[26.312078, "i", "python3 << 'EOF'\nimport openpyxl\nimport pandas as pd\n\n# Load vendors from Excel\nwb = openpyxl.load_workbook('/root/vendors.xlsx')\nws = wb.active\n\nprint(\"=== Vendors Data ===\")\nvendors = {}\nfor row_idx, row in enumerate(ws.iter_rows(values_only=True), 1):\n    if row_idx == 1:\n        print(f\"Headers: {row}\")\n    else:\n        if row[0] is not None:\n            vendor_id = row[0]\n            vendor_name = row[1]\n            iban = row[2]\n            vendors[vendor_name] = {'id': vendor_id, 'iban': iban}\n            if row_idx <= 10 or row_idx > len(list(ws.iter_rows())):\n                print(f\"Row {row_idx}: ID={vendor_id}, Name={vendor_name}, IBAN={iban}\")\n\nprint(f\"\\nTotal vendors: {len(vendors)}\")\n\n# Load purchase orders from CSV\nprint(\"\\n=== Purchase Orders Data ===\")\npos_df = pd.read_csv('/root/purchase_orders.csv')\nprint(pos_df.head(10))\nprint(f\"\\nTotal POs: {len(pos_df)}\")\nEOF\n"]
[26.312376, "o", "python3 << 'EOF'\r\n\u001b[?2004l\r"]
