[52.637484, "i", "python3 << 'EOF'\nimport pdfplumber\nimport openpyxl\nimport pandas as pd\nimport json\nimport re\nfrom difflib import SequenceMatcher\n\ndef fuzzy_match(name, vendor_list, threshold=0.8):\n    \"\"\"Find best fuzzy match for vendor name\"\"\"\n    best_match = None\n    best_score = 0\n    \n    name_normalized = name.lower().strip()\n    \n    for vendor in vendor_list:\n        vendor_normalized = vendor.lower().strip()\n        \n        # Remove common variations\n        name_norm2 = name_normalized.replace(' ltd', '').replace(' limited', '').replace(' inc', '').replace(' inc.', '').replace(' corp', '').replace(' corporation', '')\n        vendor_norm2 = vendor_normalized.replace(' ltd', '').replace(' limited', '').replace(' inc', '').replace(' inc.', '').replace(' corp', '').replace(' corporation', '')\n        \n        # Try exact match first\n        if name_normalized == vendor_normalized:\n            return vendor, 1.0\n        \n        # Try normalized match\n        if name_norm2 == vendor_norm2:\n            return vendor, 0.95\n        \n        # Try sequence matching\n        ratio = SequenceMatcher(None, name_normalized, vendor_normalized).ratio()\n        if ratio > best_score:\n            best_score = ratio\n            best_match = vendor\n    \n    if best_score >= threshold:\n        return best_match, best_score\n    return None, best_score\n\n# Load vendors\nwb = openpyxl.load_workbook('/root/vendors.xlsx')\nws = wb.active\nvendors = {}\nvendor_list = []\nfor row_idx, row in enumerate(ws.iter_rows(values_only=True), 1):\n    if row_idx > 1 and row[0] is not None:\n        vendor_id = row[0]\n        vendor_name = row[1]\n        iban = row[2]\n        vendors[vendor_name] = {'id': vendor_id, 'iban': iban}\n        vendor_list.append(vendor_name)\n\n# Load purchase orders\npos_df = pd.read_csv('/root/purchase_orders.csv')\npos_dict = {}\nfor _, row in pos_df.iterrows():\n    po_num = row['po_number']\n    pos_dict[po_num] = {\n        'vendor_id': row['vendor_id'],\n        'amount': float(row['amount'])\n    }\n\n# Extract invoices from PDF\ninvoices = []\nwith pdfplumber.open('/root/invoices.pdf') as pdf:\n    for page_num, page in enumerate(pdf.pages, 1):\n        text = page.extract_text()\n        \n        vendor_match = re.search(r'From:\\s*(.+?)\\n', text)\n        vendor_name = vendor_match.group(1).strip() if vendor_match else None\n        \n        amount_match = re.search(r'Total\\s*\\$([\\d,]+\\.\\d{2})', text)\n        amount = float(amount_match.group(1).replace(',', '')) if amount_match else None\n        \n        iban_match = re.search(r'Payment IBAN:\\s*([A-Z0-9_]+)', text)\n        iban = iban_match.group(1).strip() if iban_match else None\n        \n        po_match = re.search(r'PO Number:\\s*(PO-[A-Z0-9]+)', text)\n        po_number = po_match.group(1).strip() if po_match else None\n        \n        invoices.append({\n            'page': page_num,\n            'vendor_name': vendor_name,\n            'amount': amount,\n            'iban': iban,\n            'po_number': po_number\n        })\n\n# Perform fraud detection\nfraud_report = []\n\nfor invoice in invoices:\n    page = invoice['page']\n    vendor_name = invoice['vendor_name']\n    amount = invoice['amount']\n    iban = invoice['iban']\n    po_number = invoice['po_number']\n    \n    reason = None\n    matched_vendor = None\n    \n    # Criterion 1: Unknown Vendor\n    if vendor_name in vendors:\n        matched_vendor = vendor_name\n    else:\n        matched_vendor, score = fuzzy_match(vendor_name, vendor_list)\n    \n    if matched_vendor is None:\n        reason = \"Unknown Vendor\"\n    else:\n        # Criterion 2: IBAN Mismatch\n        expected_iban = vendors[matched_vendor]['iban']\n        if iban != expected_iban:\n            reason = \"IBAN Mismatch\"\n        else:\n            # Criterion 3: Invalid PO\n            if po_number not in pos_dict:\n                reason = \"Invalid PO\"\n            else:\n                # Criterion 4: Amount Mismatch\n                po_amount = pos_dict[po_number]['amount']\n                if abs(amount - po_amount) > 0.01:\n                    reason = \"Amount Mismatch\"\n                else:\n        "]
[52.637566, "i", "            # Criterion 5: Vendor Mismatch\n                    po_vendor_id = pos_dict[po_number]['vendor_id']\n                    invoice_vendor_id = vendors[matched_vendor]['id']\n                    if po_vendor_id != invoice_vendor_id:\n                        reason = \"Vendor Mismatch\"\n    \n    if reason:\n        fraud_report.append({\n            \"invoice_page_number\": page,\n            \"vendor_name\": vendor_name,\n            \"invoice_amount\": amount,\n            \"iban\": iban,\n            \"po_number\": po_number if po_number in pos_dict else None,\n            \"reason\": reason\n        })\n\n# Save fraud report\nwith open('/root/fraud_report.json', 'w') as f:\n    json.dump(fraud_report, f, indent=2)\n\nprint(f\"Fraud report generated with {len(fraud_report)} fraudulent invoices\")\nprint(\"\\nFirst 10 fraudulent invoices:\")\nfor item in fraud_report[:10]:\n    print(f\"Page {item['invoice_page_number']}: {item['vendor_name']} - {item['reason']}\")\nEOF\n"]
