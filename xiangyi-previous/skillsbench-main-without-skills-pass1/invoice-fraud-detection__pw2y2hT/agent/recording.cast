[72.794687, "i", "python3 << 'EOF'\nimport json\n\nwith open('/root/fraud_report.json', 'r') as f:\n    data = json.load(f)\n\nprint(f'Total fraudulent invoices: {len(data)}')\nprint('\\nFirst 5 entries:')\nfor entry in data[:5]:\n    print(f\"Page {entry['invoice_page_number']}: {entry['vendor_name']} - {entry['reason']}\")\n\nprint('\\nLast 5 entries:')\nfor entry in data[-5:]:\n    print(f\"Page {entry['invoice_page_number']}: {entry['vendor_name']} - {entry['reason']}\")\n\nprint('\\nFraud reasons breakdown:')\nreasons = {}\nfor entry in data:\n    reason = entry['reason']\n    reasons[reason] = reasons.get(reason, 0) + 1\n\nfor reason, count in sorted(reasons.items()):\n    print(f\"  {reason}: {count}\")\nEOF\n"]
