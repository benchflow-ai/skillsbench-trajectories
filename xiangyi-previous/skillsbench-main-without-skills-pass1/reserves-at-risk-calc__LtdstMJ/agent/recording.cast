[112.597611, "i", "cat <<EOF > find_2025.py\nimport pandas as pd\n\nfile_path = 'data/test-rar.xlsx'\n\nfor sheet in ['Value', 'Volume', 'Total Reserves']:\n    try:\n        # Read first column to find dates\n        df = pd.read_excel(file_path, sheet_name=sheet)\n        # Assuming the first column contains dates or years. Let's look at the first few columns.\n        print(f\"\\n--- {sheet} Head ---\")\n        print(df.iloc[:15, :5])\n        \n        # Search for 2025 in the first column\n        # The previous output showed the first column (index 0) having years.\n        # Let's try to convert first column to string and search\n        first_col = df.iloc[:, 0].astype(str)\n        rows_2025 = df[first_col.str.contains('2025', na=False)]\n        if not rows_2025.empty:\n            print(f\"\\nFound 2025 data in {sheet} at indices:\")\n            print(rows_2025.index.tolist())\n            print(rows_2025.iloc[:, :5])\n        else:\n            print(f\"\\nNo '2025' found in first column of {sheet}\")\n            \n    except Exception as e:\n        print(f\"Error reading {sheet}: {e}\")\nEOF\npython3 find_2025.py\n"]
