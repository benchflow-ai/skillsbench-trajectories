[111.418236, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.styles import Font, PatternFill, Alignment, Border, Side\n\n# Load the workbook\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nws_answer = wb['Answer']\nws_gold = wb['Gold price']\nws_value = wb['Value']\nws_volume = wb['Volume']\nws_reserves = wb['Total Reserves']\n\n# Clear and rebuild Answer sheet with proper structure\nfor row in ws_answer.iter_rows():\n    for cell in row:\n        cell.value = None\n\n# ===== STEP 1 =====\nws_answer['A1'] = 'STEP 1: Gold Price Analysis'\nws_answer['A1'].font = Font(bold=True, size=12)\n\nws_answer['A3'] = 'Latest Gold Price (USD/oz):'\nws_answer['B3'] = '=B70'\n\nws_answer['A4'] = 'Latest 3-Month Volatility (%):'\nws_answer['B4'] = '=D70'\n\nws_answer['A5'] = '3-Month Annualized Volatility (%):'\nws_answer['B5'] = '=B4*SQRT(12)'\n\nws_answer['A6'] = 'Latest 12-Month Volatility (%):'\nws_answer['B6'] = '=E70'\n\n# ===== STEP 2 =====\nws_answer['A9'] = 'STEP 2: Gold Reserves Value Analysis'\nws_answer['A9'].font = Font(bold=True, size=12)\n\nws_answer['A11'] = 'Country'\nws_answer['B11'] = 'Gold Reserves Value (Million USD)'\n\n# Add Value sheet countries (rows 12-21 for 10 countries)\nfor i in range(10):\n    row = 12 + i\n    ws_answer[f'A{row}'] = f'=Value!A{i+2}'\n    ws_answer[f'B{row}'] = f'=Value!B{i+2}'\n\n# Add South Korea from Volume sheet (row 22)\nws_answer['A22'] = '=Volume!A12'  # South Korea is row 12 in Volume\nws_answer['B22'] = f'=Volume!B12*AVERAGE(Gold price!B65:B71)'\n\n# Gold Price Exposure (row 24)\nws_answer['A24'] = 'Gold Price Exposure (%)'\nws_answer['B24'] = '=B4'  # 3-month volatility\n\n# ===== STEP 3 =====\nws_answer['A27'] = 'STEP 3: Risk Analysis with Total Reserves'\nws_answer['A27'].font = Font(bold=True, size=12)\n\nws_answer['A29'] = 'Country'\nws_answer['B29'] = 'Gold Reserves Value (Million USD)'\nws_answer['C29'] = 'Gold Price Volatility (%)'\nws_answer['D29'] = 'Total Reserves (Million USD)'\nws_answer['E29'] = 'RaR (%)'\n\n# Replicate STEP 2 data to STEP 3 (11 countries total)\nfor i in range(11):\n    row = 30 + i\n    step2_row = 12 + i\n    \n    ws_answer[f'A{row}'] = f'=A{step2_row}'\n    ws_answer[f'B{row}'] = f'=B{step2_row}'\n    ws_answer[f'C{row}'] = '=B6'  # 12-month volatility\n    \n    # INDEX/MATCH to find Total Reserves\n    ws_answer[f'D{row}'] = f'=IFERROR(INDEX(\\'Total Reserves\\'!B:B,MATCH(A{row},\\'Total Reserves\\'!A:A,0)),\"\")'\n    \n    # RaR = (Gold Reserves Value / Total Reserves) * Gold Price Volatility\n    ws_answer[f'E{row}'] = f'=IFERROR(IF(D{row}=\"\",\"\",B{row}/D{row}*C{row}),\"\")'\n\n# Save the workbook\nwb.save('/root/output/rar_result.xlsx')\nprint(\"Answer sheet structure completed!\")\nprint(\"\\nSummary:\")\nprint(\"- STEP 1: Gold price analysis with 3-month and 12-month volatility\")\nprint(\"- STEP 2: 10 countries from Value sheet + South Korea from Volume sheet\")\nprint(\"- STEP 3: All 11 countries with Total Reserves lookup and RaR calculation\")\nprint(\"\\nFile saved to /root/output/rar_result.xlsx\")\nEOF\n"]
