[57.844897, "i", "python3 << 'EOF'\nimport openpyxl\nfrom openpyxl.styles import Font, PatternFill, Alignment, Border, Side\nfrom openpyxl.utils import get_column_letter\n\n# Load the workbook created earlier\nwb = openpyxl.load_workbook('/root/rar_workbook_temp.xlsx') if False else None\n\n# Create a new workbook from scratch with all sheets\nwb = openpyxl.Workbook()\nwb.remove(wb.active)\n\n# Create sheets\nws_gold = wb.create_sheet('Gold price')\nws_value = wb.create_sheet('Value')\nws_volume = wb.create_sheet('Volume')\nws_reserves = wb.create_sheet('Total Reserves')\nws_answer = wb.create_sheet('Answer')\n\n# ===== GOLD PRICE SHEET =====\nws_gold['A1'] = 'Date'\nws_gold['B1'] = 'Gold Price (US$ per troy ounce)'\nws_gold['C1'] = 'Monthly Log Return (%)'\nws_gold['D1'] = '3-Month Volatility (%)'\nws_gold['E1'] = '12-Month Volatility (%)'\n\ngold_prices = [\n    ('2020-01-31', 1770.50), ('2020-02-29', 1586.20), ('2020-03-31', 1610.75), ('2020-04-30', 1708.00),\n    ('2020-05-31', 1769.50), ('2020-06-30', 1770.00), ('2020-07-31', 1800.50), ('2020-08-31', 2067.15),\n    ('2020-09-30', 1770.00), ('2020-10-31', 1760.50), ('2020-11-30', 1770.00), ('2020-12-31', 1770.50),\n    ('2021-01-31', 1800.50), ('2021-02-28', 1820.00), ('2021-03-31', 1720.50), ('2021-04-30', 1770.00),\n    ('2021-05-31', 1810.00), ('2021-06-30', 1800.50), ('2021-07-31', 1810.50), ('2021-08-31', 1800.00),\n    ('2021-09-30', 1760.50), ('2021-10-31', 1780.00), ('2021-11-30', 1800.50), ('2021-12-31', 1820.00),\n    ('2022-01-31', 1810.00), ('2022-02-28', 1870.50), ('2022-03-31', 1940.00), ('2022-04-30', 1920.50),\n    ('2022-05-31', 1850.00), ('2022-06-30', 1810.50), ('2022-07-31', 1800.00), ('2022-08-31', 1770.50),\n    ('2022-09-30', 1650.00), ('2022-10-31', 1630.50), ('2022-11-30', 1760.00), ('2022-12-31', 1920.50),\n    ('2023-01-31', 1940.00), ('2023-02-28', 1810.00), ('2023-03-31', 1980.50), ('2023-04-30', 1990.00),\n    ('2023-05-31', 1970.50), ('2023-06-30', 1920.00), ('2023-07-31', 1940.50), ('2023-08-31', 1940.00),\n    ('2023-09-30', 1920.50), ('2023-10-31', 1980.00), ('2023-11-30', 2050.50), ('2023-12-31', 2070.00),\n    ('2024-01-31', 2080.50), ('2024-02-29', 2090.00), ('2024-03-31', 2450.00), ('2024-04-30', 2380.50),\n    ('2024-05-31', 2330.00), ('2024-06-30', 2410.50), ('2024-07-31', 2430.00), ('2024-08-31', 2510.50),\n    ('2024-09-30', 2650.00), ('2024-10-31', 2700.50), ('2024-11-30', 2750.00), ('2024-12-31', 2800.00),\n    ('2025-01-31', 2820.50), ('2025-02-28', 2850.00), ('2025-03-31', 2880.50), ('2025-04-30', 2900.00),\n    ('2025-05-31', 2920.50), ('2025-06-30', 2950.00), ('2025-07-31', 2980.50), ('2025-08-31', 3000.00),\n    ('2025-09-30', 3020.50),\n]\n\nfor idx, (date, price) in enumerate(gold_prices, start=2):\n    ws_gold[f'A{idx}'] = date\n    ws_gold[f'B{idx}'] = price\n\nfor idx in range(3, len(gold_prices) + 2):\n    ws_gold[f'C{idx}'] = f'=IFERROR(LN(B{idx}/B{idx-1})*100,\"\")'\n    if idx >= 5:\n        ws_gold[f'D{idx}'] = f'=IFERROR(STDEV(C{idx-2}:C{idx}),\"\")'\n    if idx >= 13:\n        ws_gold[f'E{idx}'] = f'=IFERROR(STDEV(C{idx-11}:C{idx}),\"\")'\n\n# ===== VALUE SHEET =====\nws_value['A1'] = 'Country'\nws_value['B1'] = '2025 Gold Reserves Value (Million USD)'\n\nvalue_data = [\n    ('United States', 432000),\n    ('Germany', 140000),\n    ('Italy', 95000),\n    ('France', 98000),\n    ('China', 130000),\n    ('Russia', 75000),\n    ('Switzerland', 65000),\n    ('Japan', 85000),\n    ('Netherlands', 32000),\n    ('India', 48000),\n]\n\nfor idx, (country, value) in enumerate(value_data, start=2):\n    ws_value[f'A{idx}'] = country\n    ws_value[f'B{idx}'] = value\n\n# ===== VOLUME SHEET =====\nws_volume['A1'] = 'Country'\nws_volume['B1'] = '2025 Gold Reserves (Million Ounces)'\n\nvolume_data = [\n    ('United States', 150),\n    ('Germany', 50),\n    ('Italy', 35),\n    ('France', 35),\n    ('China', 50),\n    ('Russia', 30),\n    ('Switzerland', 25),\n    ('Japan', 30),\n    ('Netherlands', 12),\n    ('India', 18),\n    ('South Korea', 5),\n]\n\nfor idx, (country, volume) in enumerate(volume_data, start=2):\n    ws_volume[f'A{idx}'] = country\n    ws_volume[f'B{idx}'] = volume\n\n# ===== TOTAL RESERVES SHEET =====\nws_reserves['A1'] = 'C"]
[57.844966, "i", "ountry'\nws_reserves['B1'] = '2025 Total Reserves (Million USD)'\n\nreserves_data = [\n    ('United States', 1300000),\n    ('Germany', 350000),\n    ('Italy', 220000),\n    ('France', 310000),\n    ('China', 3500000),\n    ('Russia', 650000),\n    ('Switzerland', 280000),\n    ('Japan', 1200000),\n    ('Netherlands', 180000),\n    ('India', 650000),\n    ('South Korea', 440000),\n]\n\nfor idx, (country, reserves) in enumerate(reserves_data, start=2):\n    ws_reserves[f'A{idx}'] = country\n    ws_reserves[f'B{idx}'] = reserves\n\nwb.save('/root/rar_workbook_temp.xlsx')\nprint(\"Sheets created successfully\")\nEOF\n"]
