[41.461316, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[41.461348, "o", "> "]
[41.461379, "o", "# Populate gold prices\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.461485, "o", "for idx, (date, price) in enumerate(gold_prices, start=2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.46154, "o", "    ws_gold[f'A{idx}'] = date\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.461606, "o", "> "]
[41.461635, "o", "    ws_gold[f'B{idx}'] = price\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.461706, "o", "# Add formulas for log returns and volatility\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.461737, "o", "> "]
[41.461802, "o", "for idx in range(3, len(gold_prices) + 2):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.461901, "o", "    # Monthly log return formula: =LN(B{idx}/B{idx-1})*100\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.462007, "o", "    ws_gold[f'C{idx}'] = f'=IFERROR(LN(B{idx}/B{idx-1})*100,\"\")'\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.462067, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h"]
[41.462103, "o", "> "]
[41.46217, "o", "    # 3-month volatility (requires at least 3 data points)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.462205, "o", "    if idx >= 5:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.462327, "o", "        ws_gold[f'D{idx}'] = f'=IFERROR(STDEV(C{idx-2}:C{idx}),\"\")'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.462394, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.462473, "o", "    # 12-month volatility (requires at least 12 data points)\r\n\u001b[?2004l\r"]
[41.462541, "o", "\u001b[?2004h> "]
[41.462575, "o", "    if idx >= 13:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[41.462709, "o", "        ws_gold[f'E{idx}'] = f'=IFERROR(STDEV(C{idx-11}:C{idx}),\"\")'\r\n\u001b[?2004l\r\u001b[?2004h"]
[41.462766, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[41.4628, "o", "> "]
[41.462862, "o", "print(\"Gold price sheet created successfully\")\r\n\u001b[?2004l\r"]
[41.46289, "o", "\u001b[?2004h> "]
[41.46292, "o", "EOF\r\n\u001b[?2004l\r"]
