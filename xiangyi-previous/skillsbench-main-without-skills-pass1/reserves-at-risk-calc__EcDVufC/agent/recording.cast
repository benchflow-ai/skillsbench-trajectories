[73.830135, "o", "ws_answer[f'C{step3_start+2}'] = 'Gold Price Volatility (%)'\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.830166, "o", "> "]
[73.830254, "o", "ws_answer[f'D{step3_start+2}'] = 'Total Reserves (Million USD)'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.830331, "o", "ws_answer[f'E{step3_start+2}'] = 'RaR (%)'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[73.830388, "o", "\u001b[?2004h> "]
[73.830462, "o", "# Replicate STEP 2 data to STEP 3 and add Total Reserves lookup\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.83058, "o", "for idx in range(len(value_countries) + len(volume_countries)):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.830639, "o", "    row_offset = step3_start + 3 + idx\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.830667, "o", "> "]
[73.830699, "o", "    step2_row = 12 + idx\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.830726, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.830838, "o", "    ws_answer[f'A{row_offset}'] = f'=A{step2_row}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.830904, "o", "    ws_answer[f'B{row_offset}'] = f'=B{step2_row}'\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.830936, "o", "> "]
[73.831027, "o", "    ws_answer[f'C{row_offset}'] = f'=B6'  # Use 12-month volatility\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.831091, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.831189, "o", "    # Use INDEX/MATCH to find Total Reserves\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.831329, "o", "    ws_answer[f'D{row_offset}'] = f'=IFERROR(INDEX(Total Reserves!B:B,MATCH(A{row_offset},Total Reserves!A:A,0)),\"\")'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.831381, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.831475, "o", "    # RaR = (Gold Reserves Value / Total Reserves) * Gold Price Volatility\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.831624, "o", "    ws_answer[f'E{row_offset}'] = f'=IFERROR((B{row_offset}/D{row_offset})*C{row_offset},\"\")'\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.831679, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.83173, "o", "wb.save('/root/output/rar_result.xlsx')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[73.831805, "o", "print(\"Answer sheet created successfully\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.831835, "o", "> "]
[73.831931, "o", "print(f\"File saved to /root/output/rar_result.xlsx\")\r\n\u001b[?2004l\r\u001b[?2004h"]
[73.831987, "o", "> EOF\r\n\u001b[?2004l\r"]
[75.426552, "o", "Answer sheet created successfully\r\nFile saved to /root/output/rar_result.xlsx\r\n"]
