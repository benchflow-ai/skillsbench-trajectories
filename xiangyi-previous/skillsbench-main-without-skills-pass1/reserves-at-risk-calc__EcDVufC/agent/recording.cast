[86.285554, "i", "python3 << 'EOF'\nimport openpyxl\n\n# Load and verify the final workbook\nwb = openpyxl.load_workbook('/root/output/rar_result.xlsx')\nprint(\"Sheets in workbook:\")\nfor sheet_name in wb.sheetnames:\n    print(f\"  - {sheet_name}\")\n\n# Verify Answer sheet structure\nws_answer = wb['Answer']\nprint(\"\\nAnswer Sheet Content:\")\nfor row in range(1, 15):\n    cell_a = ws_answer[f'A{row}'].value\n    cell_b = ws_answer[f'B{row}'].value\n    if cell_a or cell_b:\n        print(f\"  Row {row}: A={cell_a}, B={cell_b}\")\n\n# Verify Gold price sheet\nws_gold = wb['Gold price']\nprint(\"\\nGold Price Sheet - Last few rows:\")\nfor row in range(69, 72):\n    date = ws_gold[f'A{row}'].value\n    price = ws_gold[f'B{row}'].value\n    log_ret = ws_gold[f'C{row}'].value\n    vol3m = ws_gold[f'D{row}'].value\n    vol12m = ws_gold[f'E{row}'].value\n    print(f\"  Row {row}: Date={date}, Price={price}, LogRet={log_ret}, Vol3M={vol3m}, Vol12M={vol12m}\")\n\nprint(\"\\nWorkbook verification complete!\")\nEOF\n"]
