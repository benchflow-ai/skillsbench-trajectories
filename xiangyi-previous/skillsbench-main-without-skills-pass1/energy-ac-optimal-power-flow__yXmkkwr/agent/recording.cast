[78.090368, "i", "cat << 'EOF' > solve_opf.py\nimport json\nimport numpy as np\nfrom scipy.optimize import minimize\n\ndef solve():\n    with open('network.json', 'r') as f:\n        data = json.load(f)\n\n    baseMVA = data['baseMVA']\n    buses = data['bus']\n    gens = data['gen']\n    branches = data['branch']\n    gencosts = data['gencost']\n\n    num_buses = len(buses)\n    num_gens = len(gens)\n    num_branches = len(branches)\n\n    bus_idx_map = {int(b[0]): i for i, b in enumerate(buses)}\n\n    # Variables: \n    # Vm: num_buses\n    # Va: num_buses\n    # Pg: num_gens\n    # Qg: num_gens\n    # Total vars: 2*num_buses + 2*num_gens\n\n    # Initial guess\n    x0 = np.zeros(2 * num_buses + 2 * num_gens)\n    bounds = []\n\n    # Vm and Va\n    for i in range(num_buses):\n        x0[i] = buses[i][7] # VM\n        x0[num_buses + i] = np.radians(buses[i][8]) # VA\n        bounds.append((buses[i][12], buses[i][11])) # VMIN, VMAX\n    for i in range(num_buses):\n        bounds.append((-np.pi, np.pi)) # VA\n\n    # Pg and Qg\n    for i in range(num_gens):\n        x0[2*num_buses + i] = gens[i][1] / baseMVA # PG\n        x0[2*num_buses + num_gens + i] = gens[i][2] / baseMVA # QG\n        bounds.append((gens[i][9] / baseMVA, gens[i][8] / baseMVA)) # PMIN, PMAX\n        bounds.append((gens[i][4] / baseMVA, gens[i][3] / baseMVA)) # QMIN, QMAX\n\n    # Reference bus constraint\n    ref_buses = [i for i, b in enumerate(buses) if b[1] == 3]\n    \n    def objective(x):\n        total_cost = 0\n        for i in range(num_gens):\n            pg = x[2*num_buses + i] * baseMVA\n            cost_coeffs = gencosts[i][4:]\n            # Assuming polynomial cost: c2*Pg^2 + c1*Pg + c0\n            if gencosts[i][3] == 3:\n                total_cost += cost_coeffs[0] * pg**2 + cost_coeffs[1] * pg + cost_coeffs[2]\n            elif gencosts[i][3] == 2:\n                total_cost += cost_coeffs[0] * pg + cost_coeffs[1]\n        return total_cost\n\n    def constraints(x):\n        Vm = x[:num_buses]\n        Va = x[num_buses:2*num_buses]\n        Pg = x[2*num_buses:2*num_buses + num_gens]\n        Qg = x[2*num_buses + num_gens:]\n\n        V = Vm * np.exp(1j * Va)\n        \n        # Power balance\n        P_gen = np.zeros(num_buses)\n        Q_gen = np.zeros(num_buses)\n        for i in range(num_gens):\n            bus_idx = bus_idx_map[int(gens[i][0])]\n            P_gen[bus_idx] += Pg[i]\n            Q_gen[bus_idx] += Qg[i]\n\n        P_load = np.array([b[2] for b in buses]) / baseMVA\n        Q_load = np.array([b[3] for b in buses]) / baseMVA\n        Gs = np.array([b[4] for b in buses]) / baseMVA\n        Bs = np.array([b[5] for b in buses]) / baseMVA\n\n        # Ybus construction (simplified for constraints)\n        # But it's better to compute P_inj and Q_inj directly\n        \n        res = []\n        \n        # Reference bus angle\n        for rb in ref_buses:\n            res.append(Va[rb])\n\n        # Branch flows and power balance\n        P_inj = np.zeros(num_buses)\n        Q_inj = np.zeros(num_buses)\n        \n        # Bus shunt injections\n        P_inj -= Gs * Vm**2\n        Q_inj += Bs * Vm**2\n\n        branch_flows_from = []\n        branch_flows_to = []\n\n        for br in branches:\n            f_idx = bus_idx_map[int(br[0])]\n            t_idx = bus_idx_map[int(br[1])]\n            r = br[2]\n            x_br = br[3]\n            b_br = br[4]\n            tap = br[8] if br[8] != 0 else 1.0\n            shift = np.radians(br[9])\n            \n            Y = 1.0 / (r + 1j * x_br)\n            T = tap * np.exp(1j * shift)\n            \n            # From side\n            S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\n            # To side\n            S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\n            \n            P_inj[f_idx] -= S_from.real\n            Q_inj[f_idx] -= S_from.imag\n            P_inj[t_idx] -= S_to.real\n            Q_inj[t_idx] -= S_to.imag\n            \n            branch_flows_from.append(np.abs(S_from))\n            branch_flows_to.append("]
[78.090587, "i", "np.abs(S_to))\n\n        for i in range(num_buses):\n            res.append(P_gen[i] - P_load[i] + P_inj[i])\n            res.append(Q_gen[i] - Q_load[i] + Q_inj[i])\n\n        # Branch flow limits\n        for i, br in enumerate(branches):\n            limit = br[5] / baseMVA\n            if limit > 0:\n                res.append(limit - branch_flows_from[i])\n                res.append(limit - branch_flows_to[i])\n        \n        return np.array(res)\n\n    # For minimize, we need separate eq and ineq constraints\n    def eq_constraints(x):\n        Vm = x[:num_buses]\n        Va = x[num_buses:2*num_buses]\n        Pg = x[2*num_buses:2*num_buses + num_gens]\n        Qg = x[2*num_buses + num_gens:]\n        V = Vm * np.exp(1j * Va)\n        P_gen = np.zeros(num_buses)\n        Q_gen = np.zeros(num_buses)\n        for i in range(num_gens):\n            bus_idx = bus_idx_map[int(gens[i][0])]\n            P_gen[bus_idx] += Pg[i]\n            Q_gen[bus_idx] += Qg[i]\n        P_load = np.array([b[2] for b in buses]) / baseMVA\n        Q_load = np.array([b[3] for b in buses]) / baseMVA\n        Gs = np.array([b[4] for b in buses]) / baseMVA\n        Bs = np.array([b[5] for b in buses]) / baseMVA\n        P_inj = -Gs * Vm**2\n        Q_inj = Bs * Vm**2\n        for br in branches:\n            f_idx = bus_idx_map[int(br[0])]\n            t_idx = bus_idx_map[int(br[1])]\n            r, x_br, b_br = br[2], br[3], br[4]\n            tap = br[8] if br[8] != 0 else 1.0\n            shift = np.radians(br[9])\n            Y = 1.0 / (r + 1j * x_br)\n            T = tap * np.exp(1j * shift)\n            S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\n            S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\n            P_inj[f_idx] -= S_from.real\n            Q_inj[f_idx] -= S_from.imag\n            P_inj[t_idx] -= S_to.real\n            Q_inj[t_idx] -= S_to.imag\n        res = []\n        for rb in ref_buses:\n            res.append(Va[rb])\n        for i in range(num_buses):\n            res.append(P_gen[i] - P_load[i] + P_inj[i])\n            res.append(Q_gen[i] - Q_load[i] + Q_inj[i])\n        return np.array(res)\n\n    def ineq_constraints(x):\n        Vm = x[:num_buses]\n        Va = x[num_buses:2*num_buses]\n        V = Vm * np.exp(1j * Va)\n        res = []\n        for br in branches:\n            f_idx = bus_idx_map[int(br[0])]\n            t_idx = bus_idx_map[int(br[1])]\n            r, x_br, b_br = br[2], br[3], br[4]\n            tap = br[8] if br[8] != 0 else 1.0\n            shift = np.radians(br[9])\n            Y = 1.0 / (r + 1j * x_br)\n            T = tap * np.exp(1j * shift)\n            S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\n            S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\n            limit = br[5] / baseMVA\n            if limit > 0:\n                res.append(limit - np.abs(S_from))\n                res.append(limit - np.abs(S_to))\n        return np.array(res)\n\n    cons = [{'type': 'eq', 'fun': eq_constraints}, {'type': 'ineq', 'fun': ineq_constraints}]\n    \n    res = minimize(objective, x0, method='SLSQP', bounds=bounds, constraints=cons, options={'maxiter': 1000, 'disp': True})\n    \n    # Output report\n    x = res.x\n    Vm = x[:num_buses]\n    Va = x[num_buses:2*num_buses]\n    Pg = x[2*num_buses:2*num_buses + num_gens]\n    Qg = x[2*num_buses + num_gens:]\n    V = Vm * np.exp(1j * Va)\n\n    report = {\n        \"summary\": {\n            \"total_cost_per_hour\": res.fun,\n            \"total_load_MW\": sum(b[2] for b in buses),\n            \"total_load_MVAr\": sum(b[3] for b in buses),\n            \"total_generation_MW\": float(np.sum(Pg) * baseMVA),\n            \"total_generation_MVAr\": float(np.sum(Qg) * baseMVA),\n            \"total_losses_MW\": float((np.sum(Pg) - sum(b[2] for b in buses) / baseMVA - sum(b[4] for b in buses) * Vm**2 "]
[78.09069, "i", "/ baseMVA) * baseMVA), # simplified\n            \"solver_status\": \"optimal\" if res.success else \"failed\"\n        },\n        \"generators\": [],\n        \"buses\": [],\n        \"most_loaded_branches\": [],\n        \"feasibility_check\": {}\n    }\n    \n    # Fix total_losses_MW\n    total_p_inj = 0\n    for i in range(num_buses):\n        total_p_inj += (b[2]/baseMVA + b[4]/baseMVA * Vm[i]**2)\n    # This is not quite right. Losses = Total Gen - Total Load - Total Shunt. \n    # Let's re-calculate accurately.\n    total_load_P = sum(b[2] for b in buses)\n    total_gen_P = np.sum(Pg) * baseMVA\n    # Losses = total_gen_P - total_load_P - total_shunt_P\n    total_shunt_P = np.sum(np.array([b[4] for b in buses]) * Vm**2)\n    report[\"summary\"][\"total_losses_MW\"] = float(total_gen_P - total_load_P - total_shunt_P)\n\n    for i in range(num_gens):\n        report[\"generators\"].append({\n            \"id\": i + 1,\n            \"bus\": int(gens[i][0]),\n            \"pg_MW\": float(Pg[i] * baseMVA),\n            \"qg_MVAr\": float(Qg[i] * baseMVA),\n            \"pmin_MW\": gens[i][9],\n            \"pmax_MW\": gens[i][8],\n            \"qmin_MVAr\": gens[i][4],\n            \"qmax_MVAr\": gens[i][3]\n        })\n    \n    for i in range(num_buses):\n        report[\"buses\"].append({\n            \"id\": int(buses[i][0]),\n            \"vm_pu\": float(Vm[i]),\n            \"va_deg\": float(np.degrees(Va[i])),\n            \"vmin_pu\": buses[i][12],\n            \"vmax_pu\": buses[i][11]\n        })\n\n    branch_info = []\n    for i, br in enumerate(branches):\n        f_idx = bus_idx_map[int(br[0])]\n        t_idx = bus_idx_map[int(br[1])]\n        r, x_br, b_br = br[2], br[3], br[4]\n        tap = br[8] if br[8] != 0 else 1.0\n        shift = np.radians(br[9])\n        Y = 1.0 / (r + 1j * x_br)\n        T = tap * np.exp(1j * shift)\n        S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\n        S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\n        \n        limit = br[5]\n        loading = max(np.abs(S_from), np.abs(S_to)) * baseMVA\n        pct = (loading / limit * 100) if limit > 0 else 0\n        \n        branch_info.append({\n            \"from_bus\": int(br[0]),\n            \"to_bus\": int(br[1]),\n            \"loading_pct\": float(pct),\n            \"flow_from_MVA\": float(np.abs(S_from) * baseMVA),\n            \"flow_to_MVA\": float(np.abs(S_to) * baseMVA),\n            \"limit_MVA\": float(limit)\n        })\n    \n    branch_info.sort(key=lambda x: x['loading_pct'], reverse=True)\n    report[\"most_loaded_branches\"] = branch_info[:5]\n\n    # Feasibility check\n    eq_vals = eq_constraints(x)\n    # eq_vals contains ref_bus_angle, then P_mismatch, Q_mismatch for each bus\n    p_mismatches = []\n    q_mismatches = []\n    idx = len(ref_buses)\n    for i in range(num_buses):\n        p_mismatches.append(abs(eq_vals[idx]))\n        q_mismatches.append(abs(eq_vals[idx+1]))\n        idx += 2\n    \n    report[\"feasibility_check\"] = {\n        \"max_p_mismatch_MW\": float(max(p_mismatches) * baseMVA),\n        \"max_q_mismatch_MVAr\": float(max(q_mismatches) * baseMVA),\n        \"max_voltage_violation_pu\": float(max(0, np.max(Vm - np.array([b[11] for b in buses])), np.max(np.array([b[12] for b in buses]) - Vm))),\n        \"max_branch_overload_MVA\": float(max([0] + [b['flow_from_MVA'] - b['limit_MVA'] for b in branch_info if b['limit_MVA'] > 0] + [b['flow_to_MVA'] - b['limit_MVA'] for b in branch_info if b['limit_MVA'] > 0]))\n    }\n\n    with open('report.json', 'w') as f:\n        json.dump(report, f, indent=2)\n\nsolve()\nEOF\n"]
[78.090917, "o", "cat << 'EOF' > solve_opf.py\r\n\u001b[?2004l\r"]
[78.091, "o", "\u001b[?2004h> "]
[78.091103, "o", "import json\r\n\u001b[?2004l\r"]
[78.091184, "o", "\u001b[?2004h> import numpy as np\r\n"]
[78.0913, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[78.091435, "o", "from scipy.optimize import minimize\r\n\u001b[?2004l\r"]
[78.09151, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.091583, "o", "def solve():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.091778, "o", "    with open('network.json', 'r') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.091943, "o", "        data = json.load(f)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.092012, "o", "h\u001b[?2004h> "]
[78.092125, "o", "    baseMVA = data['baseMVA']\r\n\u001b[?2004l\r"]
[78.092193, "o", "\u001b[?2004h> "]
[78.092265, "o", "    buses = data['bus']\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.092335, "o", "> "]
[78.092404, "o", "    gens = data['gen']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.092512, "o", "    branches = data['branch']\r\n\u001b[?2004l\r"]
[78.092582, "o", "\u001b[?2004h> "]
[78.092664, "o", "    gencosts = data['gencost']\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.092731, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.092839, "o", "    num_buses = len(buses)\r\n\u001b[?2004l\r"]
[78.092907, "o", "\u001b[?2004h> "]
[78.092979, "o", "    num_gens = len(gens)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.093111, "o", "    num_branches = len(branches)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r[\u001b[?2004h"]
[78.093193, "o", "> "]
[78.093344, "o", "    bus_idx_map = {int(b[0]): i for i, b in enumerate(buses)}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r "]
[78.093456, "o", "\u001b[?2004h> "]
[78.09353, "o", "    # Variables: \r\n\u001b[?2004l\r\u001b[?2004h>     # Vm: num_buses\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.093622, "o", "    # Va: num_buses\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.093687, "o", "> "]
[78.093847, "o", "    # Pg: num_gens\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.093928, "o", ">     # Qg: num_gens\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.094007, "o", "    # Total vars: 2*num_buses + 2*num_gens\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[78.094072, "o", "    # Initial guess\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.094125, "o", "> "]
[78.094223, "o", "    x0 = np.zeros(2 * num_buses + 2 * num_gens)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.094284, "o", "    bounds = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.094341, "o", " \u001b[?2004h> "]
[78.094391, "o", "    # Vm and Va\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.09446, "o", "    for i in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.094517, "o", "> "]
[78.094571, "o", "        x0[i] = buses[i][7] # VM\r\n\u001b[?2004l\r"]
[78.094626, "o", "\u001b[?2004h> "]
[78.09477, "o", "        x0[num_buses + i] = np.radians(buses[i][8]) # VA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.094969, "o", "        bounds.append((buses[i][12], buses[i][11])) # VMIN, VMAX\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.095054, "o", "    for i in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.095112, "o", "> "]
[78.095189, "o", "        bounds.append((-np.pi, np.pi)) # VA\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.095244, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.095299, "o", "    # Pg and Qg\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.095375, "o", "    for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.095565, "o", "        x0[2*num_buses + i] = gens[i][1] / baseMVA # PG\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.09575, "o", "        x0[2*num_buses + num_gens + i] = gens[i][2] / baseMVA # QG\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.095994, "o", "        bounds.append((gens[i][9] / baseMVA, gens[i][8] / baseMVA)) # PMIN, PMAX\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.096218, "o", "        bounds.append((gens[i][4] / baseMVA, gens[i][3] / baseMVA)) # QMIN, QMAX\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rr\u001b[?2004h"]
[78.096299, "o", "> "]
[78.096361, "o", "    # Reference bus constraint\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.096552, "o", "    ref_buses = [i for i, b in enumerate(buses) if b[1] == 3]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.096622, "o", "    def objective(x):\r\n\u001b[?2004l\r[8\u001b[?2004h> "]
[78.096684, "o", "        total_cost = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.09676, "o", "        for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.096915, "o", "            pg = x[2*num_buses + i] * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.097047, "o", "            cost_coeffs = gencosts[i][4:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.097246, "o", "            # Assuming polynomial cost: c2*Pg^2 + c1*Pg + c0\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.097304, "o", "> "]
[78.097358, "o", "            if gencosts[i][3] == 3:\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.097409, "o", "> "]
[78.097634, "o", "                total_cost += cost_coeffs[0] * pg**2 + cost_coeffs[1] * pg + cost_coeffs[2]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.097733, "o", "            elif gencosts[i][3] == 2:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.097946, "o", "                total_cost += cost_coeffs[0] * pg + cost_coeffs[1]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.098011, "o", "        return total_cost\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.098071, "o", "o\u001b[?2004h> "]
[78.098128, "o", "    def constraints(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.0982, "o", "        Vm = x[:num_buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.09826, "o", "> "]
[78.098319, "o", "        Va = x[num_buses:2*num_buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.098371, "o", "> "]
[78.098475, "o", "        Pg = x[2*num_buses:2*num_buses + num_gens]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.098536, "o", "> "]
[78.098613, "o", "        Qg = x[2*num_buses + num_gens:]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.098666, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[78.098724, "o", "        V = Vm * np.exp(1j * Va)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.098776, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.098856, "o", "        # Power balance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.098987, "o", "        P_gen = np.zeros(num_buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.099086, "o", "        Q_gen = np.zeros(num_buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.099196, "o", "        for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.099359, "o", "            bus_idx = bus_idx_map[int(gens[i][0])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.099451, "o", "            P_gen[bus_idx] += Pg[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.099515, "o", "> "]
[78.099576, "o", "            Q_gen[bus_idx] += Qg[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.099646, "o", "> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[78.099786, "o", "        P_load = np.array([b[2] for b in buses]) / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.099961, "o", "        Q_load = np.array([b[3] for b in buses]) / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.100126, "o", "        Gs = np.array([b[4] for b in buses]) / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.100287, "o", "        Bs = np.array([b[5] for b in buses]) / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r[\u001b[?2004h"]
[78.100347, "o", "> "]
[78.100467, "o", "        # Ybus construction (simplified for constraints)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.100657, "o", "        # But it's better to compute P_inj and Q_inj directly\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.100718, "o", "        \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.10077, "o", "        res = []\r\n\u001b[?2004l\r\u001b[?2004h>         "]
[78.100826, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.100889, "o", "        # Reference bus angle\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.100981, "o", "        for rb in ref_buses:\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.10104, "o", "> "]
[78.101096, "o", "            res.append(Va[rb])\r\n\u001b[?2004l\ru\u001b[?2004h> \r\n\u001b[?2004l\rg\u001b[?2004h> "]
[78.101289, "o", "        # Branch flows and power balance\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.101352, "o", "        P_inj = np.zeros(num_buses)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.101411, "o", "> "]
[78.101462, "o", "        Q_inj = np.zeros(num_buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.101512, "o", "        \r\n\u001b[?2004l\r-\u001b[?2004h> "]
[78.101615, "o", "        # Bus shunt injections\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.101679, "o", "> "]
[78.10174, "o", "        P_inj -= Gs * Vm**2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.101798, "o", "        Q_inj += Bs * Vm**2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rb"]
[78.101854, "o", "\u001b[?2004h> "]
[78.101913, "o", "        branch_flows_from = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.101966, "o", "> "]
[78.102021, "o", "        branch_flows_to = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r."]
[78.102075, "o", "\u001b[?2004h> "]
[78.102134, "o", "        for br in branches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.102268, "o", "            f_idx = bus_idx_map[int(br[0])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.102399, "o", "            t_idx = bus_idx_map[int(br[1])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.102466, "o", "            r = br[2]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.102524, "o", "> "]
[78.102581, "o", "            x_br = br[3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.102646, "o", "            b_br = br[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.102793, "o", "            tap = br[8] if br[8] != 0 else 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.102896, "o", "            shift = np.radians(br[9])\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.102952, "o", ">             \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.103077, "o", "            Y = 1.0 / (r + 1j * x_br)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.103209, "o", "            T = tap * np.exp(1j * shift)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.103265, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.103327, "o", "            # From side\r\n\u001b[?2004l\r"]
[78.103378, "o", "\u001b[?2004h> "]
[78.103766, "o", "            S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.103858, "o", "            # To side\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.103924, "o", "> "]
[78.104247, "o", "            S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.104347, "o", "            \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.104416, "o", "            P_inj[f_idx] -= S_from.real\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.104528, "o", "            Q_inj[f_idx] -= S_from.imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.104643, "o", "            P_inj[t_idx] -= S_to.real\r\n\u001b[?2004l\ru\u001b[?2004h> "]
[78.104783, "o", "            Q_inj[t_idx] -= S_to.imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.104849, "o", "            \r\n\u001b[?2004l\rl\u001b[?2004h> "]
[78.104945, "o", "            branch_flows_from.append(np.abs(S_from))\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.105, "o", "> "]
[78.105091, "o", "            branch_flows_to.append(np.abs(S_to))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.105143, "o", "a\u001b[?2004h> "]
[78.105219, "o", "        for i in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.105279, "o", "> "]
[78.105416, "o", "            res.append(P_gen[i] - P_load[i] + P_inj[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.105582, "o", "            res.append(Q_gen[i] - Q_load[i] + Q_inj[i])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h"]
[78.105649, "o", "> "]
[78.105718, "o", "        # Branch flow limits\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.105809, "o", "        for i, br in enumerate(branches):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.105936, "o", "            limit = br[5] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.106008, "o", "            if limit > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.106197, "o", "                res.append(limit - branch_flows_from[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.106352, "o", "                res.append(limit - branch_flows_to[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.106392, "o", "        \r\n\u001b[?2004l\rss\u001b[?2004h> "]
[78.106538, "o", "        return np.array(res)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> "]
[78.106711, "o", "    # For minimize, we need separate eq and ineq constraints\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.106778, "o", "    def eq_constraints(x):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.10683, "o", "> "]
[78.106881, "o", "        Vm = x[:num_buses]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.107009, "o", "        Va = x[num_buses:2*num_buses]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.107157, "o", "        Pg = x[2*num_buses:2*num_buses + num_gens]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.10728, "o", "        Qg = x[2*num_buses + num_gens:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.107376, "o", "        V = Vm * np.exp(1j * Va)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.107509, "o", "        P_gen = np.zeros(num_buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.107614, "o", "        Q_gen = np.zeros(num_buses)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.107677, "o", "> "]
[78.107733, "o", "        for i in range(num_gens):\r\n\u001b[?2004l\r:\u001b[?2004h> "]
[78.107886, "o", "            bus_idx = bus_idx_map[int(gens[i][0])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.107986, "o", "            P_gen[bus_idx] += Pg[i]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.108046, "o", "> "]
[78.108107, "o", "            Q_gen[bus_idx] += Qg[i]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.108292, "o", "        P_load = np.array([b[2] for b in buses]) / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.108461, "o", "        Q_load = np.array([b[3] for b in buses]) / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.108638, "o", "        Gs = np.array([b[4] for b in buses]) / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.108787, "o", "        Bs = np.array([b[5] for b in buses]) / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.108862, "o", "        P_inj = -Gs * Vm**2\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.10892, "o", "> "]
[78.108971, "o", "        Q_inj = Bs * Vm**2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.109046, "o", "        for br in branches:\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.109099, "o", "> "]
[78.109203, "o", "            f_idx = bus_idx_map[int(br[0])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.10935, "o", "            t_idx = bus_idx_map[int(br[1])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.109496, "o", "            r, x_br, b_br = br[2], br[3], br[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.10964, "o", "            tap = br[8] if br[8] != 0 else 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.109745, "o", "            shift = np.radians(br[9])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.109878, "o", "            Y = 1.0 / (r + 1j * x_br)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.110007, "o", "            T = tap * np.exp(1j * shift)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.11042, "o", "            S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.110827, "o", "            S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.110952, "o", "            P_inj[f_idx] -= S_from.real\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.111049, "o", "            Q_inj[f_idx] -= S_from.imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.11117, "o", "            P_inj[t_idx] -= S_to.real\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.111288, "o", "            Q_inj[t_idx] -= S_to.imag\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.111324, "o", "        res = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.111449, "o", ">         for rb in ref_buses:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.111537, "o", "            res.append(Va[rb])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.111667, "o", "        for i in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.111824, "o", "            res.append(P_gen[i] - P_load[i] + P_inj[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.111994, "o", "            res.append(Q_gen[i] - Q_load[i] + Q_inj[i])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.112068, "o", "        return np.array(res)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.112133, "o", "> \r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[78.112193, "o", "    def ineq_constraints(x):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.11227, "o", "        Vm = x[:num_buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.112326, "o", "> "]
[78.112387, "o", "        Va = x[num_buses:2*num_buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.112443, "o", "> "]
[78.112499, "o", "        V = Vm * np.exp(1j * Va)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.112562, "o", "        res = []\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.112624, "o", "> "]
[78.112684, "o", "        for br in branches:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.112814, "o", "            f_idx = bus_idx_map[int(br[0])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.112942, "o", "            t_idx = bus_idx_map[int(br[1])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.113094, "o", "            r, x_br, b_br = br[2], br[3], br[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.113256, "o", "            tap = br[8] if br[8] != 0 else 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.113353, "o", "            shift = np.radians(br[9])\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.113409, "o", "> "]
[78.113462, "o", "            Y = 1.0 / (r + 1j * x_br)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.113511, "o", "> "]
[78.113595, "o", "            T = tap * np.exp(1j * shift)\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.113645, "o", "> "]
[78.114037, "o", "            S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.114428, "o", "            S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.11452, "o", "            limit = br[5] / baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.114614, "o", "            if limit > 0:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.114768, "o", "                res.append(limit - np.abs(S_from))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.114905, "o", "                res.append(limit - np.abs(S_to))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.114985, "o", "        return np.array(res)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.115036, "o", "m\u001b[?2004h> "]
[78.115289, "o", "    cons = [{'type': 'eq', 'fun': eq_constraints}, {'type': 'ineq', 'fun': ineq_constraints}]\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[78.115369, "o", "\u001b[?2004h> "]
[78.11566, "o", "    res = minimize(objective, x0, method='SLSQP', bounds=bounds, constraints=cons, options={'maxiter': 1000, 'disp': True})\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[78.115742, "o", "\u001b[?2004h> "]
[78.115806, "o", "    # Output report\r\n\u001b[?2004l\r\u001b[?2004h>     x = res.x\r\n\u001b[?2004l\r"]
[78.115869, "o", "\u001b[?2004h> "]
[78.115931, "o", "    Vm = x[:num_buses]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.11599, "o", "    Va = x[num_buses:2*num_buses]\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.11605, "o", "> "]
[78.116151, "o", "    Pg = x[2*num_buses:2*num_buses + num_gens]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.116265, "o", "    Qg = x[2*num_buses + num_gens:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.116334, "o", "    V = Vm * np.exp(1j * Va)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[78.11639, "o", "\u001b[?2004l\r\u001b[?2004h>     report = {\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.116449, "o", ">         \"summary\": {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.116531, "o", "            \"total_cost_per_hour\": res.fun,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.116634, "o", "            \"total_load_MW\": sum(b[2] for b in buses),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.116732, "o", "            \"total_load_MVAr\": sum(b[3] for b in buses),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.116857, "o", "            \"total_generation_MW\": float(np.sum(Pg) * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.116957, "o", "            \"total_generation_MVAr\": float(np.sum(Qg) * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.117016, "o", "> "]
[78.117335, "o", "            \"total_losses_MW\": float((np.sum(Pg) - sum(b[2] for b in buses) / baseMVA - sum(b[4] for b in buses) * Vm**2 / baseMVA) * baseMVA), # simplified\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.117408, "o", "            \"solver_status\": \"optimal\" if res.success else \"failed\"\r\n\u001b[?2004l\r\u001b[?2004h>         },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.117466, "o", "        \"generators\": [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.117528, "o", "        \"buses\": [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.117605, "o", "        \"most_loaded_branches\": [],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.11766, "o", "        \"feasibility_check\": {}\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.117714, "o", ">     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.117771, "o", "    # Fix total_losses_MW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.117827, "o", "    total_p_inj = 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.117886, "o", "    for i in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.117982, "o", "        total_p_inj += (b[2]/baseMVA + b[4]/baseMVA * Vm[i]**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.118123, "o", "    # This is not quite right. Losses = Total Gen - Total Load - Total Shunt. \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.118185, "o", "    # Let's re-calculate accurately.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.118266, "o", "    total_load_P = sum(b[2] for b in buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.118345, "o", "    total_gen_P = np.sum(Pg) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.118448, "o", "    # Losses = total_gen_P - total_load_P - total_shunt_P\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.118581, "o", "    total_shunt_P = np.sum(np.array([b[4] for b in buses]) * Vm**2)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.118734, "o", "    report[\"summary\"][\"total_losses_MW\"] = float(total_gen_P - total_load_P - total_shunt_P)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[78.118799, "o", ">     for i in range(num_gens):\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.118858, "o", ">         report[\"generators\"].append({\r\n\u001b[?2004l\r"]
[78.118916, "o", "\u001b[?2004h>             \"id\": i + 1,\r\n\u001b[?2004l\r"]
[78.118974, "o", "\u001b[?2004h> "]
[78.119033, "o", "            \"bus\": int(gens[i][0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119091, "o", "            \"pg_MW\": float(Pg[i] * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119171, "o", "            \"qg_MVAr\": float(Qg[i] * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119239, "o", "            \"pmin_MW\": gens[i][9],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119312, "o", "            \"pmax_MW\": gens[i][8],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119386, "o", "            \"qmin_MVAr\": gens[i][4],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119454, "o", "            \"qmax_MVAr\": gens[i][3]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119508, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[78.11956, "o", "\u001b[?2004h> "]
[78.119616, "o", "    for i in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119674, "o", "        report[\"buses\"].append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119733, "o", "            \"id\": int(buses[i][0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119794, "o", "            \"vm_pu\": float(Vm[i]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.119886, "o", "            \"va_deg\": float(np.degrees(Va[i])),\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.119947, "o", "> "]
[78.120004, "o", "            \"vmin_pu\": buses[i][12],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.120058, "o", "            \"vmax_pu\": buses[i][11]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.120117, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.120174, "o", "    branch_info = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.120233, "o", "    for i, br in enumerate(branches):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.120296, "o", "        f_idx = bus_idx_map[int(br[0])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.120373, "o", "        t_idx = bus_idx_map[int(br[1])]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.12046, "o", "        r, x_br, b_br = br[2], br[3], br[4]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.120544, "o", "        tap = br[8] if br[8] != 0 else 1.0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.120619, "o", "        shift = np.radians(br[9])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.12068, "o", "        Y = 1.0 / (r + 1j * x_br)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.120759, "o", "        T = tap * np.exp(1j * shift)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.121003, "o", "        S_from = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[f_idx])**2 / np.abs(T)**2) - Y.conjugate() * (V[f_idx] * V[t_idx].conjugate() / T)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.121237, "o", "        S_to = (Y + 1j * b_br / 2).conjugate() * (np.abs(V[t_idx])**2) - Y.conjugate() * (V[f_idx].conjugate() * V[t_idx] / T.conjugate())\r\n\u001b[?2004l\r\u001b[?2004h>         \r\n\u001b[?2004l\r"]
[78.121357, "o", "\u001b[?2004h> "]
[78.121426, "o", "        limit = br[5]\r\n\u001b[?2004l\r\u001b[?2004h>         loading = max(np.abs(S_from), np.abs(S_to)) * baseMVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.121514, "o", "        pct = (loading / limit * 100) if limit > 0 else 0\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.121576, "o", ">         \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.121645, "o", "        branch_info.append({\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.121705, "o", "            \"from_bus\": int(br[0]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.121815, "o", "            \"to_bus\": int(br[1]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.121876, "o", "            \"loading_pct\": float(pct),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.121935, "o", "            \"flow_from_MVA\": float(np.abs(S_from) * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122035, "o", "            \"flow_to_MVA\": float(np.abs(S_to) * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122105, "o", "            \"limit_MVA\": float(limit)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122162, "o", "        })\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122303, "o", "    branch_info.sort(key=lambda x: x['loading_pct'], reverse=True)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122383, "o", "    report[\"most_loaded_branches\"] = branch_info[:5]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[78.122433, "o", "\u001b[?2004h> "]
[78.122487, "o", "    # Feasibility check\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122547, "o", "    eq_vals = eq_constraints(x)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122676, "o", "    # eq_vals contains ref_bus_angle, then P_mismatch, Q_mismatch for each bus\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122739, "o", "    p_mismatches = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122797, "o", "    q_mismatches = []\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122847, "o", "    idx = len(ref_buses)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.1229, "o", "    for i in range(num_buses):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.122971, "o", "        p_mismatches.append(abs(eq_vals[idx]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.123065, "o", "        q_mismatches.append(abs(eq_vals[idx+1]))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.123118, "o", "        idx += 2\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r"]
[78.123173, "o", "\u001b[?2004h> "]
[78.123227, "o", "    report[\"feasibility_check\"] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.12332, "o", "        \"max_p_mismatch_MW\": float(max(p_mismatches) * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.123456, "o", "        \"max_q_mismatch_MVAr\": float(max(q_mismatches) * baseMVA),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.123694, "o", "        \"max_voltage_violation_pu\": float(max(0, np.max(Vm - np.array([b[11] for b in buses])), np.max(np.array([b[12] for b in buses]) - Vm))),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.12402, "o", "        \"max_branch_overload_MVA\": float(max([0] + [b['flow_from_MVA'] - b['limit_MVA'] for b in branch_info if b['limit_MVA'] > 0] + [b['flow_to_MVA'] - b['limit_MVA'] for b in branch_info if b['limit_MVA'] > 0]))\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[78.124131, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.124204, "o", "    with open('report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[78.124293, "o", "        json.dump(report, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> solve()\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.124358, "o", "> EOF\r\n\u001b[?2004l\r"]
[78.192256, "o", "\u001b[?2004hroot@e8ebeebcc061:~# "]
[80.281201, "i", "python3 solve_opf.py\n"]
[80.281416, "o", "python3 solve_opf.py\r\n\u001b[?2004l\r"]
[166.668266, "i", "\u0003"]
[166.761468, "o", "^C"]
