[32.190458, "o", "> "]
[32.190562, "o", "# Parse generator data\r\n\u001b[?2004l\r\u001b[?2004h> gen_data = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.190613, "o", "for i, gen in enumerate(network_data['gen']):\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.19065, "o", "> "]
[32.190685, "o", "    gen_id = i + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.190772, "o", "    gen_data[gen_id] = {\r\n\u001b[?2004l\r\u001b[?2004h>         'bus': int(gen[0]),\r\n\u001b[?2004l\r"]
[32.190811, "o", "\u001b[?2004h> "]
[32.190891, "o", "        'pg': gen[1],  # MW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.190941, "o", "        'qg': gen[2],  # MVAr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.191048, "o", "        'qmax': gen[3],  # MVAr\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.191114, "o", "> "]
[32.191192, "o", "        'qmin': gen[4],  # MVAr\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.191279, "o", "        'vg': gen[5],  # voltage setpoint\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.191343, "o", "> "]
[32.191379, "o", "        'pmax': gen[8],  # MW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.191458, "o", "        'pmin': gen[9],  # MW\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.191553, "o", "        'status': int(gen[7]),  # 1=in-service\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[32.191587, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[32.191619, "o", "> "]
[32.191659, "o", "# Parse branch data\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.191692, "o", "branch_data = {}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.191856, "o", "for i, branch in enumerate(network_data['branch']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.191894, "o", "    branch_id = i + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.19193, "o", "    branch_data[branch_id] = {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.192044, "o", "        'fbus': int(branch[0]),\r\n\u001b[?2004l\r\u001b[?2004h>         'tbus': int(branch[1]),\r\n\u001b[?2004l\r"]
[32.192078, "o", "\u001b[?2004h> "]
[32.192112, "o", "        'r': branch[2],  # pu\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.192153, "o", "> "]
[32.192279, "o", "        'x': branch[3],  # pu\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.192334, "o", "        'b': branch[4],  # pu\r\n\u001b[?2004l\r\u001b[?2004h>         'rate_a': branch[5],  # MVA\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.19239, "o", "        'tap': branch[8],  # transformer tap\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.192426, "o", "> "]
[32.192497, "o", "        'shift': branch[9],  # phase shift degrees\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.192572, "o", "        'status': int(branch[10]),  # 1=in-service\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.192608, "o", "> "]
[32.192678, "o", "        'angmin': branch[11],  # degrees\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.192722, "o", "        'angmax': branch[12],  # degrees\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.192756, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[32.19282, "o", "\u001b[?2004h> # Parse generator cost data\r\n\u001b[?2004l\r"]
[32.192857, "o", "\u001b[?2004h> gen_cost = {}\r\n\u001b[?2004l\r"]
[32.192892, "o", "\u001b[?2004h> "]
[32.192975, "o", "for i, cost in enumerate(network_data['gencost']):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.193012, "o", "    gen_id = i + 1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.193082, "o", "    if int(cost[0]) == 2:  # polynomial\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.193119, "o", "> "]
[32.193151, "o", "        ncost = int(cost[3])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.193208, "o", "        coeffs = cost[4:4+ncost]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.193286, "o", "        gen_cost[gen_id] = coeffs\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.193323, "o", "    else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.193395, "o", "        gen_cost[gen_id] = [0, 0, 0]  # default\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.19343, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.193601, "o", "print(f'Loaded network with {len(bus_data)} buses, {len(gen_data)} generators, {len(branch_data)} branches')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.19369, "o", "print(f'Generator cost example (gen 1): {gen_cost[1]}')\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.193727, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[32.193761, "o", "> EOPYTHON\r\n\u001b[?2004l\r"]
