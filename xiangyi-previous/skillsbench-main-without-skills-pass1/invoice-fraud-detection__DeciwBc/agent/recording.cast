[63.67743, "o", "    matched_vendor_name, vendor_info = fuzzy_match_vendor(vendor_name, vendors_by_name)\r\n\u001b[?2004l\r\u001b[?2004h>     \r\n\u001b[?2004l\r\u001b[?2004h>     if not matched_vendor_name:\r\n\u001b[?2004l\r\u001b[?2004h>         fraud_reason = \"Unknown Vendor\"\r\n\u001b[?2004l\r\u001b[?2004h>     # 2. IBAN Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.677458, "o", "    elif vendor_info['iban'] != iban:\r\n\u001b[?2004l\r"]
[63.677532, "o", "\u001b[?2004h>         fraud_reason = \"IBAN Mismatch\"\r\n\u001b[?2004l\r"]
[63.677584, "o", "\u001b[?2004h> "]
[63.67765, "o", "    # 3. Invalid PO (check if PO exists in purchase orders)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.677713, "o", "    elif po_number not in pos_dict:\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.677758, "o", "> "]
[63.677804, "o", "        fraud_reason = \"Invalid PO\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.67785, "o", ">     else:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.677902, "o", "        po_info = pos_dict[po_number]\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.677951, "o", "> "]
[63.677993, "o", "        # 4. Amount Mismatch (exceeds 0.01 difference)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.678037, "o", "> "]
[63.678079, "o", "        if abs(po_info['amount'] - amount) > 0.01:\r\n\u001b[?2004l\r"]
[63.678124, "o", "\u001b[?2004h> "]
[63.678166, "o", "            fraud_reason = \"Amount Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.678213, "o", "> "]
[63.678266, "o", "        # 5. Vendor Mismatch\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.678335, "o", "        elif po_info['vendor_id'] != vendor_info['id']:\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.678389, "o", "> "]
[63.67843, "o", "            fraud_reason = \"Vendor Mismatch\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.678478, "o", "    \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.678533, "o", "    # Add to fraud report if flagged\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.678576, "o", "    if fraud_reason:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.678625, "o", "        fraud_cases.append({\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.67867, "o", "> "]
[63.678716, "o", "            \"invoice_page_number\": page,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.678786, "o", "            \"vendor_name\": vendor_name,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.678831, "o", "> "]
[63.678905, "o", "            \"invoice_amount\": amount,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.678962, "o", "            \"iban\": iban,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.679013, "o", "            \"po_number\": po_number_for_report,\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.679059, "o", "> "]
[63.679111, "o", "            \"reason\": fraud_reason\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.679161, "o", ">         })\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.67921, "o", "# Save fraud report\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.679274, "o", "with open('/root/fraud_report.json', 'w') as f:\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.679322, "o", "> "]
[63.679371, "o", "    json.dump(fraud_cases, f, indent=2)\r\n\u001b[?2004l\r\u001b[?2004h"]
[63.679442, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.679527, "o", "print(f\"Fraud detection complete. Found {len(fraud_cases)} fraudulent invoices.\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[63.67958, "o", "EOF\r\n\u001b[?2004l\r"]
[63.681379, "o", "\u001b[?2004hroot@d691de8f355e:~# "]
