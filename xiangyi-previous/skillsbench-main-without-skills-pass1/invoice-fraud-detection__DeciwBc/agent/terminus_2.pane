[?2004hroot@d691de8f355e:~# cat > /root/detect_fraud.py << 'EOF'
[?2004l[?2004h> import pandas as pd
[?2004l[?2004h> import re
[?2004l[?2004h> import json
[?2004l[?2004h> from difflib import SequenceMatcher
[?2004l[?2004h> import subprocess
[?2004l[?2004h> 
[?2004l[?2004h> # Extract text from PDF
[?2004l[?2004h> result = subprocess.run(['pdftotext', '/root/invoices.pdf', '-'], 
[?2004l[?2004h>                        capture_output=True, text=True)
[?2004l[?2004h> pdf_text = result.stdout
[?2004l[?2004h> 
[?2004l[?2004h> # Parse invoices from PDF
[?2004l[?2004h> invoices = []
[?2004l[?2004h> pattern = r'Invoice Page (\d+)\s+From: (.+?)\s+Total \$([\d.]+)\s+Payment IBAN: (.+?)\s+PO Number: (.+?)(?=\n|$)'
[?2004l[?2004h> matches = re.findall(pattern, pdf_text, re.MULTILINE)
[?2004l[?2004h> 
[?2004l[?2004h> for match in matches:
[?2004l[?2004h>     page_num, vendor, amount, iban, po = match
[?2004l[?2004h>     invoices.append({
[?2004l[?2004h>         'page': int(page_num),
[?2004l[?2004h>         'vendor_name': vendor.strip(),
[?2004l[?2004h>         'amount': float(amount),
[?2004l[?2004h>         'iban': iban.strip(),
[?2004l[?2004h>         'po_number': po.strip()
[?2004l[?2004h>     })
[?2004l[?2004h> 
[?2004l[?2004h> # Load vendors and purchase orders
[?2004l[?2004h> vendors_df = pd.read_excel('/root/vendors.xlsx')
[?2004l[?2004h> purchase_orders_df = pd.read_csv('/root/purchase_orders.csv')
[?2004l[?2004h> 
[?2004l[?2004h> # Create lookup dictionaries
[?2004l[?2004h> vendors_by_name = {row['name']: {'id': row['id'], 'iban': row['iban']} 
[?2004l[?2004h>                    for _, row in vendors_df.iterrows()}
[?2004l[?2004h> pos_dict = {row['po_number']: {'vendor_id': row['vendor_id'], 'amount': row['amount']} 
[?2004l[?2004h>             for _, row in purchase_orders_df.iterrows()}
[?2004l[?2004h> 
[?2004l[?2004h> def fuzzy_match_vendor(invoice_vendor, vendors_dict, threshold=0.85):
[?2004l[?2004h>     """Find best matching vendor using fuzzy string matching"""
[?2004l[?2004h>     best_match = None
[?2004l[?2004h>     best_ratio = 0
[?2004l[?2004h>     
[?2004l[?2004h>     for vendor_name in vendors_dict.keys():
[?2004l[?2004h>         ratio = SequenceMatcher(None, invoice_vendor.lower(), vendor_name.lower()).ratio()
[?2004l[?2004h>         if ratio > best_ratio:
[?2004l[?2004h>             best_ratio = ratio
[?2004l[?2004h>             best_match = vendor_name
[?2004l[?2004h>     
[?2004l[?2004h>     if best_ratio >= threshold:
[?2004l[?2004h>         return best_match, vendors_dict[best_match]
[?2004l[?2004h>     return None, None
[?2004l[?2004h> 
[?2004l[?2004h> # Detect fraud
[?2004l[?2004h> fraud_cases = []
[?2004l[?2004h> 
[?2004l[?2004h> for inv in invoices:
[?2004l[?2004h>     vendor_name = inv['vendor_name']
[?2004l[?2004h>     amount = inv['amount']
[?2004l[?2004h>     iban = inv['iban']
[?2004l[?2004h>     po_number = inv['po_number']
[?2004l[?2004h>     page = inv['page']
[?2004l[?2004h>     
[?2004l[?2004h>     # Check for valid PO format (not PO-INVALID or missing)
[?2004l[?2004h>     po_is_valid_format = po_number and not po_number.startswith('PO-INVALID')
[?2004l[?2004h>     po_number_for_report = po_number if po_is_valid_format else None
[?2004l[?2004h>     
[?2004l[?2004h>     fraud_reason = None
[?2004l[?2004h>     
[?2004l[?2004h>     # 1. Unknown Vendor (with fuzzy matching)
[?2004l[?2004h>     matched_vendor_name, vendor_info = fuzzy_match_vendor(vendor_name, vendors_by_name)
[?2004l[?2004h>     
[?2004l[?2004h>     if not matched_vendor_name:
[?2004l[?2004h>         fraud_reason = "Unknown Vendor"
[?2004l[?2004h>     # 2. IBAN Mismatch
[?2004l[?2004h>     elif vendor_info['iban'] != iban:
[?2004l[?2004h>         fraud_reason = "IBAN Mismatch"
[?2004l[?2004h>     # 3. Invalid PO (check if PO exists in purchase orders)
[?2004l[?2004h>     elif po_number not in pos_dict:
[?2004l[?2004h>         fraud_reason = "Invalid PO"
[?2004l[?2004h>     else:
[?2004l[?2004h>         po_info = pos_dict[po_number]
[?2004l[?2004h>         # 4. Amount Mismatch (exceeds 0.01 difference)
[?2004l[?2004h>         if abs(po_info['amount'] - amount) > 0.01:
[?2004l[?2004h>             fraud_reason = "Amount Mismatch"
[?2004l[?2004h>         # 5. Vendor Mismatch
[?2004l[?2004h>         elif po_info['vendor_id'] != vendor_info['id']:
[?2004l[?2004h>             fraud_reason = "Vendor Mismatch"
[?2004l[?2004h>     
[?2004l[?2004h>     # Add to fraud report if flagged
[?2004l[?2004h>     if fraud_reason:
[?2004l[?2004h>         fraud_cases.append({
[?2004l[?2004h>             "invoice_page_number": page,
[?2004l[?2004h>             "vendor_name": vendor_name,
[?2004l[?2004h>             "invoice_amount": amount,
[?2004l[?2004h>             "iban": iban,
[?2004l[?2004h>             "po_number": po_number_for_report,
[?2004l[?2004h>             "reason": fraud_reason
[?2004l[?2004h>         })
[?2004l[?2004h> 
[?2004l[?2004h> # Save fraud report
[?2004l[?2004h> with open('/root/fraud_report.json', 'w') as f:
[?2004l[?2004h>     json.dump(fraud_cases, f, indent=2)
[?2004l[?2004h> 
[?2004l[?2004h> print(f"Fraud detection complete. Found {len(fraud_cases)} fraudulent invoices.")
