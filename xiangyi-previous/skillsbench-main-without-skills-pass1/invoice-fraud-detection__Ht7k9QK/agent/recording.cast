[152.629691, "i", "cat <<'EOF' > analyze_fraud.py\nimport pandas as pd\nimport pdfplumber\nimport re\nimport json\nfrom rapidfuzz import process, fuzz\n\n# Load Data\nvendors = pd.read_excel('/root/vendors.xlsx')\npos = pd.read_csv('/root/purchase_orders.csv')\n\n# Preprocess Data\nvendor_names = vendors['name'].tolist()\nvendor_lookup = vendors.set_index('name').to_dict('index')\npo_lookup = pos.set_index('po_number').to_dict('index')\n\nfraud_report = []\n\nwith pdfplumber.open('/root/invoices.pdf') as pdf:\n    for i, page in enumerate(pdf.pages):\n        page_num = i + 1\n        text = page.extract_text()\n        if not text:\n            continue\n            \n        # Extract fields\n        vendor_match = re.search(r\"From:\\s*(.+)\", text)\n        amount_match = re.search(r\"Total\\s*\\$?([\\d\\.]+)\", text)\n        iban_match = re.search(r\"Payment IBAN:\\s*(\\S+)\", text)\n        po_match = re.search(r\"PO Number:\\s*(\\S+)\", text)\n        \n        vendor_raw = vendor_match.group(1).strip() if vendor_match else \"\"\n        try:\n            amount_raw = float(amount_match.group(1)) if amount_match else 0.0\n        except ValueError:\n            amount_raw = 0.0\n        iban_raw = iban_match.group(1).strip() if iban_match else \"\"\n        po_raw = po_match.group(1).strip() if po_match else None\n        \n        reason = None\n        matched_vendor_info = None\n        \n        # 1. Unknown Vendor\n        best_match = process.extractOne(vendor_raw, vendor_names, scorer=fuzz.WRatio)\n        \n        if best_match and best_match[1] >= 85:\n            matched_name = best_match[0]\n            matched_vendor_info = vendor_lookup[matched_name]\n        else:\n            reason = \"Unknown Vendor\"\n            \n        # 2. IBAN Mismatch\n        if not reason:\n            if iban_raw != matched_vendor_info['iban']:\n                reason = \"IBAN Mismatch\"\n                \n        # 3. Invalid PO\n        if not reason:\n            if not po_raw or po_raw not in po_lookup:\n                reason = \"Invalid PO\"\n                \n        # 4. Amount Mismatch\n        if not reason:\n            po_data = po_lookup[po_raw]\n            if abs(po_data['amount'] - amount_raw) > 0.01:\n                reason = \"Amount Mismatch\"\n                \n        # 5. Vendor Mismatch\n        if not reason:\n            po_data = po_lookup[po_raw]\n            if po_data['vendor_id'] != matched_vendor_info['id']:\n                reason = \"Vendor Mismatch\"\n        \n        if reason:\n            fraud_report.append({\n                \"invoice_page_number\": page_num,\n                \"vendor_name\": vendor_raw,\n                \"invoice_amount\": amount_raw,\n                \"iban\": iban_raw,\n                \"po_number\": po_raw,\n                \"reason\": reason\n            })\n\nwith open('/root/fraud_report.json', 'w') as f:\n    json.dump(fraud_report, f, indent=2)\n\nprint(f\"Processed {len(pdf.pages)} pages. Found {len(fraud_report)} fraudulent invoices.\")\nEOF\npython3 analyze_fraud.py\n"]
