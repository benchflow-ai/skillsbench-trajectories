[18.831204, "i", "cat <<EOF > inspect_data.py\nimport pandas as pd\nimport pdfplumber\n\nprint(\"--- VENDORS ---\")\ntry:\n    df_vendors = pd.read_excel('/root/vendors.xlsx')\n    print(df_vendors.head())\n    print(df_vendors.columns.tolist())\nexcept Exception as e:\n    print(e)\n\nprint(\"\\n--- POs ---\")\ntry:\n    df_pos = pd.read_csv('/root/purchase_orders.csv')\n    print(df_pos.head())\n    print(df_pos.columns.tolist())\nexcept Exception as e:\n    print(e)\n\nprint(\"\\n--- PDF PAGE 1 ---\")\ntry:\n    with pdfplumber.open('/root/invoices.pdf') as pdf:\n        if len(pdf.pages) > 0:\n            print(pdf.pages[0].extract_text())\nexcept Exception as e:\n    print(e)\nEOF\npython3 inspect_data.py\n"]
