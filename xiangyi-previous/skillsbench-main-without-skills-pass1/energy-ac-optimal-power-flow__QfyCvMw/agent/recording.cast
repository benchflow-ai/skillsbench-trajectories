[125.282069, "i", "venv/bin/python - <<'PY'\nimport json\nimport numpy as np\nfrom pypower.api import runopf, ppoption\nwith open('network.json') as f:\n    data=json.load(f)\nppc={\n    'baseMVA': data['baseMVA'],\n    'bus': np.array(data['bus'], dtype=float),\n    'gen': np.array(data['gen'], dtype=float),\n    'branch': np.array(data['branch'], dtype=float),\n    'gencost': np.array(data['gencost'], dtype=float)\n}\nppopt=ppoption(VERBOSE=0, OUT_ALL=0)\nres=runopf(ppc, ppopt)\nprint('success', res['success'])\nprint('f', res['f'])\nprint('gen shape', res['gen'].shape)\nprint('bus shape', res['bus'].shape)\nprint('branch shape', res['branch'].shape)\nPY\n"]
