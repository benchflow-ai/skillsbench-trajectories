+   * Returns true if test mode is enabled.
+   */
+  public static boolean isTestMode()
+  {
+    return testMode;
+  }
+
+  /**
+   * Resets the static state. This should only be used for testing.
+   */
+  public static void reset()
+  {
+    SERVER_CONFIG = null;
+    testMode = false;
+  }
