# Custom exfil detection rule
# Detects HTTP POST to /telemetry/v2/report with X-TLM-Mode: exfil
# and suspicious body containing blob= with Base64 (≥80 chars) and sig= with 64 hex chars

alert http any any -> any any (msg:"Suspicious Exfil Telemetry Detected"; \
    sid:1000001; rev:1; \
    pcre:"/x-tlm-mode.*exfil/si"; \
    pcre:"/POST \/telemetry\/v2\/report/i"; \
    content:"&blob="; \
    pcre:"/[A-Za-z0-9+\/=]{80,}/"; \
    content:"sig="; \
    pcre:"/[A-Fa-f0-9]{64}/"; \
    classtype:trojan-activity;)

