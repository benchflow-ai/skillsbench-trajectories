package org.apache.druid.query.filter;

import com.fasterxml.jackson.core.JsonParser;
import com.fasterxml.jackson.databind.DeserializationContext;
import com.fasterxml.jackson.databind.JsonDeserializer;
import com.fasterxml.jackson.databind.JsonMappingException;
import com.fasterxml.jackson.databind.JsonNode;
import com.fasterxml.jackson.databind.ObjectMapper;
import com.fasterxml.jackson.databind.node.ObjectNode;
import com.google.common.base.Preconditions;
import org.apache.druid.java.util.common.StringUtils;
import org.apache.druid.js.JavaScriptConfig;
import org.apache.druid.query.extraction.ExtractionFn;

import java.io.IOException;

/**
 * Custom deserializer for {@link JavaScriptDimFilter} that properly handles the injected
 * {@link JavaScriptConfig} and ignores any user-provided config field to prevent
 * security bypass via malicious JSON payloads.
 */
public class JavaScriptDimFilterDeserializer extends JsonDeserializer<JavaScriptDimFilter>
{
  @Override
  public JavaScriptDimFilter deserialize(JsonParser jp, DeserializationContext ctxt)
      throws IOException
  {
    ObjectMapper mapper = (ObjectMapper) jp.getCodec();
    ObjectNode root = mapper.readTree(jp);

    String dimension = null;
    String function = null;
    ExtractionFn extractionFn = null;
    FilterTuning filterTuning = null;

    // Extract known fields
    if (root.has("dimension")) {
      dimension = root.get("dimension").asText();
    }
    if (root.has("function")) {
      function = root.get("function").asText();
    }
    if (root.has("extractionFn")) {
      extractionFn = mapper.treeToValue(root.get("extractionFn"), ExtractionFn.class);
    }
    if (root.has("filterTuning")) {
      filterTuning = mapper.treeToValue(root.get("filterTuning"), FilterTuning.class);
    }

    // Get the JavaScriptConfig from injectable values (Guice-injected), NOT from the JSON
    // This prevents bypass via malicious JSON with an empty key or user-provided config
    JavaScriptConfig config;
    try {
      config = ctxt.readValue(jp, JavaScriptConfig.class);
    } catch (JsonMappingException e) {
      // Config was not provided in JSON, use injectable value
      config = ctxt.getInjectableValues().getValue("druid.javascript");
      if (config == null) {
        throw new IOException("JavaScriptConfig could not be resolved", e);
      }
    }

    Preconditions.checkArgument(dimension != null, "dimension must not be null");
    Preconditions.checkArgument(function != null, "function must not be null");

    return new JavaScriptDimFilter(dimension, function, extractionFn, filterTuning, config);
  }
}
