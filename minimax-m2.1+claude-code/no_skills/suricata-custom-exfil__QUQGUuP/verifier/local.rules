# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.
#
# Detects data exfiltration in HTTP telemetry traffic:
# - HTTP POST request to /telemetry/v2/report
# - Header X-TLM-Mode: exfil
# - Body contains blob= with Base64 value >= 80 chars
# - Body contains sig= with exactly 64 hex chars

alert http any any -> any any (msg:"Custom Exfil Pattern Detected"; sid:1000001; rev:1;
    http.method; content:"POST";
    http.uri; content:"/telemetry/v2/report"; endswith;
    http.header; content:"x-tlm-mode|3a| exfil"; nocase;
    file.data; content:"blob=";
    file.data; isdataat:80,relative;
    file.data; pcre:"/sig=[0-9a-fA-F]{64}(&|$)/";
    classtype:trojan-activity; priority:1;)
