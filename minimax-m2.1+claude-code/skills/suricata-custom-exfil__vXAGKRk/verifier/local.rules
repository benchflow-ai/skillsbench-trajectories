# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.

alert http any any -> any any (msg:"HTTP POST telemetry exfil detected"; flow:to_server,established; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; http.header; content:"X-TLM-Mode|3a 20|exfil"; nocase; pkt_data; content:"blob="; http_client_body; pcre:"/blob=[a-zA-Z0-9+\/=\s]{80,}.*sig=[a-fA-F0-9]{64}/s"; sid:1000001; rev:1; classtype:trojan-activity;)

