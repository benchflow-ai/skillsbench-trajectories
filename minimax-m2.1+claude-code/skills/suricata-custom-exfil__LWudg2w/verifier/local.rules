# Write your rule(s) here.
# Requirement: raise exactly sid:1000001 for the custom exfil pattern.
alert tcp any any -> any any (flow:to_server,established; http.method; content:"POST"; http.uri; content:"/telemetry/v2/report"; http.header; content:"x-tlm-mode: exfil"; file_data; content:"blob="; content:"sig="; pcre:"/blob=[^&]{80,}/"; pcre:"/sig=[a-fA-F0-9]{64}/"; sid:1000001; rev:1;)
