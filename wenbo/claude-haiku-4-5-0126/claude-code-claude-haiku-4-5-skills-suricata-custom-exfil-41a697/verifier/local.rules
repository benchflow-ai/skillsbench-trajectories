# Custom data exfiltration detection via HTTP telemetry
alert http any any -> any any (msg:"Data exfiltration via telemetry"; sid:1000001; rev:1; flow:established,to_server; content:"POST"; content:"/telemetry/v2/report"; content:"X-TLM-Mode|3a| exfil"; nocase; pcre:"/blob=[A-Za-z0-9+\/]{80,}.*sig=[0-9a-fA-F]{64}/"; classtype:policy-violation; priority:1;)
