+  /**
+   * Validates that a JavaScript function doesn't contain dangerous patterns that could be used
+   * for arbitrary code execution. This prevents access to Java classes that could be exploited.
+   */
+  private static void validateJavaScriptFunction(String function, String functionType)
+  {
+    if (function == null) {
+      return;
+    }
+
+    // Normalize the function for checking (remove comments, whitespace variations)
+    String normalizedFunction = function.toLowerCase().replaceAll("\\s+", " ").trim();
+
+    // List of dangerous patterns that indicate potential code execution
+    // This includes patterns that would allow access to Java classes and methods
+    String[] dangerousPatterns = {
+      "java.lang.runtime",
+      "java.lang.system",
+      "java.io.file",
+      "java.io.filereader",
+      "java.io.filewriter",
+      "java.net.socket",
+      "java.net.url",
+      "java.net.httpurlconnection",
+      "java.net.mailto",
+      "java.nio.file.files",
+      "java.nio.file.path",
+      "java.class",
+      "java.class.forname",
+      "packages.",
+      "javascript",
+      "getclass()",
+      "getclass().forname",
+      "exec(",
+      "eval(",
+      "load(",
+      "loadfunction("
+    };
+
+    for (String pattern : dangerousPatterns) {
+      if (normalizedFunction.contains(pattern)) {
+        throw new IllegalStateException(
+            "JavaScript function [" + functionType + "] contains disallowed pattern: " + pattern +
+            ". JavaScript aggregators do not allow access to Java classes or dangerous methods for security reasons."
+        );
+      }
+    }
+  }
 }
